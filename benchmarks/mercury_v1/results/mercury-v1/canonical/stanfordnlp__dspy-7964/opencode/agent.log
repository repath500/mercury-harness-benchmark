{"type":"tool_use","timestamp":1788420360375,"sessionID":"ses_f99d7a776ffe69blEyxQoKXLA0","part":{"type":"tool","tool":"read","callID":"call_1f938dfb33874632b59ee527","state":{"status":"completed","input":{"filePath":"/testbed/dspy/predict/best_of_n.py"},"output":"<path>/testbed/dspy/predict/best_of_n.py</path>\n<type>file</type>\n<content>\n1: import dspy\n2: \n3: from .predict import Module\n4: from typing import Callable, Optional\n5: \n6: \n7: class BestOfN(Module):\n8:     def __init__(\n9:         self,\n10:         module,\n11:         N: int,\n12:         reward_fn: Callable,\n13:         threshold: float,\n14:         fail_count: Optional[int] = None,\n15:     ):\n16:         \"\"\"\n17:         Runs a module up to `N` times with different temperatures and returns the best prediction or the first prediction that passes the `threshold`.\n18: \n19:         This module runs the provided module multiple times with varying temperature settings and selects\n20:         either the first prediction that exceeds the specified threshold or the one with the highest reward.\n21:         If no prediction meets the threshold, it automatically raises an exception based on the fail_count parameter.\n22: \n23:         Args:\n24:             module: The module to run.\n25:             N: The number of times to run the module.\n26:             reward_fn: The reward function.\n27:             threshold: The threshold for the reward function.\n28:             fail_count: The maximum number of failed attempts to tolerate. If not provided, defaults to N,\n29:                         meaning all N attempts must fail before an exception is raised.\n30: \n31:         Example:\n32:             >>> import dspy\n33:             >>> qa = dspy.ChainOfThought(\"question -> answer\")\n34:             >>> def one_word_answer(args, pred):\n35:             >>>     return 1.0 if len(pred.answer) == 1 else 0.0\n36:             >>> best_of_3 = dspy.BestOfN(module=qa, N=3, reward_fn=one_word_answer, threshold=1.0)\n37:             >>> best_of_3(question=\"What is the capital of Belgium?\").answer\n38:             >>> # Brussels\n39:         \"\"\"\n40:         self.module = module\n41:         self.reward_fn = lambda *args: reward_fn(\n42:             *args)  # to prevent this from becoming a parameter\n43:         self.threshold = threshold\n44:         self.N = N\n45:         self.fail_count = fail_count or N  # default to N if fail_count is not provided\n46: \n47:     def forward(self, **kwargs):\n48:         lm = self.module.get_lm() or dspy.settings.lm\n49:         temps = [lm.kwargs['temperature']\n50:                  ] + [0.5 + i * (0.5 / self.N) for i in range(self.N)]\n51:         temps = list(dict.fromkeys(temps))[:self.N]\n52:         best_pred, best_trace, best_reward = None, None, -float(\"inf\")\n53:         failure_count = 0\n54: \n55:         for t in temps:\n56:             lm_ = lm.copy(temperature=t)\n57:             mod = self.module.deepcopy()\n58:             mod.set_lm(lm_)\n59: \n60:             try:\n61:                 with dspy.context(trace=[]):\n62:                     pred = mod(**kwargs)\n63:                     trace = dspy.settings.trace.copy()\n64: \n65:                     # NOTE: Not including the trace of reward_fn.\n66:                     reward = self.reward_fn(kwargs, pred)\n67: \n68:                 if reward > best_reward:\n69:                     best_reward, best_pred, best_trace = reward, pred, trace\n70: \n71:                 if self.threshold is not None and reward >= self.threshold:\n72:                     break\n73: \n74:             except Exception as e:\n75:                 failure_count += 1\n76:                 print(f\"Attempt failed with temperature {t}: {e}\")\n77:                 if failure_count >= self.fail_count:\n78:                     raise e\n79: \n80:         dspy.settings.trace.extend(best_trace)\n81:         return best_pred\n\n(End of file - total 81 lines)\n</content>","metadata":{"preview":"import dspy\n\nfrom .predict import Module\nfrom typing import Callable, Optional\n\n\nclass BestOfN(Module):\n    def __init__(\n        self,\n        module,\n        N: int,\n        reward_fn: Callable,\n        threshold: float,\n        fail_count: Optional[int] = None,\n    ):\n        \"\"\"\n        Runs a module up to `N` times with different temperatures and returns the best prediction or the first prediction that passes the `threshold`.\n\n        This module runs the provided module multiple times with varying temperature settings and selects\n        either the first prediction that exceeds the specified threshold or the one with the highest reward.","truncated":false,"loaded":[],"display":{"type":"file","path":"/testbed/dspy/predict/best_of_n.py","text":"import dspy\n\nfrom .predict import Module\nfrom typing import Callable, Optional\n\n\nclass BestOfN(Module):\n    def __init__(\n        self,\n        module,\n        N: int,\n        reward_fn: Callable,\n        threshold: float,\n        fail_count: Optional[int] = None,\n    ):\n        \"\"\"\n        Runs a module up to `N` times with different temperatures and returns the best prediction or the first prediction that passes the `threshold`.\n\n        This module runs the provided module multiple times with varying temperature settings and selects\n        either the first prediction that exceeds the specified threshold or the one with the highest reward.\n        If no prediction meets the threshold, it automatically raises an exception based on the fail_count parameter.\n\n        Args:\n            module: The module to run.\n            N: The number of times to run the module.\n            reward_fn: The reward function.\n            threshold: The threshold for the reward function.\n            fail_count: The maximum number of failed attempts to tolerate. If not provided, defaults to N,\n                        meaning all N attempts must fail before an exception is raised.\n\n        Example:\n            >>> import dspy\n            >>> qa = dspy.ChainOfThought(\"question -> answer\")\n            >>> def one_word_answer(args, pred):\n            >>>     return 1.0 if len(pred.answer) == 1 else 0.0\n            >>> best_of_3 = dspy.BestOfN(module=qa, N=3, reward_fn=one_word_answer, threshold=1.0)\n            >>> best_of_3(question=\"What is the capital of Belgium?\").answer\n            >>> # Brussels\n        \"\"\"\n        self.module = module\n        self.reward_fn = lambda *args: reward_fn(\n            *args)  # to prevent this from becoming a parameter\n        self.threshold = threshold\n        self.N = N\n        self.fail_count = fail_count or N  # default to N if fail_count is not provided\n\n    def forward(self, **kwargs):\n        lm = self.module.get_lm() or dspy.settings.lm\n        temps = [lm.kwargs['temperature']\n                 ] + [0.5 + i * (0.5 / self.N) for i in range(self.N)]\n        temps = list(dict.fromkeys(temps))[:self.N]\n        best_pred, best_trace, best_reward = None, None, -float(\"inf\")\n        failure_count = 0\n\n        for t in temps:\n            lm_ = lm.copy(temperature=t)\n            mod = self.module.deepcopy()\n            mod.set_lm(lm_)\n\n            try:\n                with dspy.context(trace=[]):\n                    pred = mod(**kwargs)\n                    trace = dspy.settings.trace.copy()\n\n                    # NOTE: Not including the trace of reward_fn.\n                    reward = self.reward_fn(kwargs, pred)\n\n                if reward > best_reward:\n                    best_reward, best_pred, best_trace = reward, pred, trace\n\n                if self.threshold is not None and reward >= self.threshold:\n                    break\n\n            except Exception as e:\n                failure_count += 1\n                print(f\"Attempt failed with temperature {t}: {e}\")\n                if failure_count >= self.fail_count:\n                    raise e\n\n        dspy.settings.trace.extend(best_trace)\n        return best_pred","lineStart":1,"lineEnd":81,"totalLines":81,"truncated":false}},"title":"dspy/predict/best_of_n.py","time":{"start":1788420360351,"end":1788420360370}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_06629087e001ccRuj9bdrqTtES","sessionID":"ses_f99d7a776ffe69blEyxQoKXLA0","messageID":"msg_066290587001kv314he5jiCeoB"}}
