{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_868fefa000574f81b4b994e8","type":"tool_result","content":"1\timport dspy\n2\t\n3\tfrom .predict import Module\n4\tfrom typing import Callable\n5\t\n6\t\n7\tclass BestOfN(Module):\n8\t    def __init__(self, module, N: int, reward_fn: Callable, threshold: float):\n9\t        \"\"\"\n10\t        Runs a module up to `N` times with different temperatures and returns the best prediction or the first prediction that passes the `threshold`.\n11\t\n12\t        Args:\n13\t            module: The module to run.\n14\t            N: The number of times to run the module.\n15\t            reward_fn: The reward function.\n16\t            threshold: The threshold for the reward function.\n17\t\n18\t        Example:\n19\t            >>> import dspy\n20\t            >>> qa = dspy.ChainOfThought(\"question -> answer\")\n21\t            >>> def one_word_answer(args, pred):\n22\t            >>>     return 1.0 if len(pred.answer) == 1 else 0.0\n23\t            >>> best_of_3 = dspy.BestOfN(module=qa, N=3, reward_fn=one_word_answer, threshold=1.0)\n24\t            >>> best_of_3(question=\"What is the capital of Belgium?\").answer\n25\t            >>> # Brussels\n26\t        \"\"\"\n27\t        self.module = module\n28\t        self.reward_fn = lambda *args: reward_fn(\n29\t            *args)  # to prevent this from becoming a parameter\n30\t        self.threshold = threshold\n31\t        self.N = N\n32\t\n33\t    def forward(self, **kwargs):\n34\t        lm = self.module.get_lm() or dspy.settings.lm\n35\t        temps = [lm.kwargs['temperature']\n36\t                 ] + [0.5 + i * (0.5 / self.N) for i in range(self.N)]\n37\t        temps = list(dict.fromkeys(temps))[:self.N]\n38\t        best_pred, best_trace, best_reward = None, None, -float(\"inf\")\n39\t\n40\t        for t in temps:\n41\t            lm_ = lm.copy(temperature=t)\n42\t            mod = self.module.deepcopy()\n43\t            mod.set_lm(lm_)\n44\t\n45\t            try:\n46\t                with dspy.context(trace=[]):\n47\t                    pred = mod(**kwargs)\n48\t                    trace = dspy.settings.trace.copy()\n49\t\n50\t                    # NOTE: Not including the trace of reward_fn.\n51\t                    reward = self.reward_fn(kwargs, pred)\n52\t\n53\t                if reward > best_reward:\n54\t                    best_reward, best_pred, best_trace = reward, pred, trace\n55\t\n56\t                if self.threshold is not None and reward >= self.threshold:\n57\t                    break\n58\t\n59\t            except Exception as e:\n60\t                print(f\"Attempt failed with temperature {t}: {e}\")\n61\t\n62\t        dspy.settings.trace.extend(best_trace)\n63\t        return best_pred\n64\t"}]},"parent_tool_use_id":null,"session_id":"364137a1-f195-460d-97ff-8fca511628ad","uuid":"68a2cf81-3a2a-469d-9c5f-cf67120d8042","timestamp":"2026-09-03T07:17:22.039Z","tool_use_result":{"type":"text","file":{"filePath":"/testbed/dspy/predict/best_of_n.py","content":"import dspy\n\nfrom .predict import Module\nfrom typing import Callable\n\n\nclass BestOfN(Module):\n    def __init__(self, module, N: int, reward_fn: Callable, threshold: float):\n        \"\"\"\n        Runs a module up to `N` times with different temperatures and returns the best prediction or the first prediction that passes the `threshold`.\n\n        Args:\n            module: The module to run.\n            N: The number of times to run the module.\n            reward_fn: The reward function.\n            threshold: The threshold for the reward function.\n\n        Example:\n            >>> import dspy\n            >>> qa = dspy.ChainOfThought(\"question -> answer\")\n            >>> def one_word_answer(args, pred):\n            >>>     return 1.0 if len(pred.answer) == 1 else 0.0\n            >>> best_of_3 = dspy.BestOfN(module=qa, N=3, reward_fn=one_word_answer, threshold=1.0)\n            >>> best_of_3(question=\"What is the capital of Belgium?\").answer\n            >>> # Brussels\n        \"\"\"\n        self.module = module\n        self.reward_fn = lambda *args: reward_fn(\n            *args)  # to prevent this from becoming a parameter\n        self.threshold = threshold\n        self.N = N\n\n    def forward(self, **kwargs):\n        lm = self.module.get_lm() or dspy.settings.lm\n        temps = [lm.kwargs['temperature']\n                 ] + [0.5 + i * (0.5 / self.N) for i in range(self.N)]\n        temps = list(dict.fromkeys(temps))[:self.N]\n        best_pred, best_trace, best_reward = None, None, -float(\"inf\")\n\n        for t in temps:\n            lm_ = lm.copy(temperature=t)\n            mod = self.module.deepcopy()\n            mod.set_lm(lm_)\n\n            try:\n                with dspy.context(trace=[]):\n                    pred = mod(**kwargs)\n                    trace = dspy.settings.trace.copy()\n\n                    # NOTE: Not including the trace of reward_fn.\n                    reward = self.reward_fn(kwargs, pred)\n\n                if reward > best_reward:\n                    best_reward, best_pred, best_trace = reward, pred, trace\n\n                if self.threshold is not None and reward >= self.threshold:\n                    break\n\n            except Exception as e:\n                print(f\"Attempt failed with temperature {t}: {e}\")\n\n        dspy.settings.trace.extend(best_trace)\n        return best_pred\n","numLines":64,"startLine":1,"totalLines":64}}}
