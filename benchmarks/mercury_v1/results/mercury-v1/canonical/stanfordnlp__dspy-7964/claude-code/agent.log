re.\n            threshold: The minimum reward threshold. If None, all successful attempts are compared.\n            fail_count: Optional[int]: Maximum number of failed attempts to tolerate. If None, defaults to N-1.\n                When exceeded, an exception is raised immediately with details about the failed attempt."}}],"model":"inception/mercury-2.5-preview","stop_reason":null,"stop_details":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0,"output_tokens_details":null,"cache_creation_input_tokens":null,"cache_read_input_tokens":null,"cache_creation":null,"inference_geo":null,"server_tool_use":null,"service_tier":null,"speed":"standard"},"provider":"Inception","context_management":null},"parent_tool_use_id":null,"session_id":"364137a1-f195-460d-97ff-8fca511628ad","uuid":"4bc4a664-8bec-4e48-a587-96860ac3c19f","timestamp":"2026-09-03T07:18:50.841Z","request_id":"gen-1788419928-stWb5jWBf8RYlexh4Be7"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_5877a23ef2c14102a71b6668","type":"tool_result","content":"The file /testbed/dspy/predict/best_of_n.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"364137a1-f195-460d-97ff-8fca511628ad","uuid":"ced30870-9034-41b0-9a49-40a2b5999029","timestamp":"2026-09-03T07:18:50.849Z","tool_use_result":{"filePath":"/testbed/dspy/predict/best_of_n.py","oldString":"        \"\"\"\n        Runs a module up to `N` times with different temperatures and returns the best prediction or the first prediction that passes the `threshold`.\n\n        This module provides configurable failure tolerance through the `fail_count` parameter, allowing you to control\n how many failed attempts are tolerated before raising an exception. When `fail_count` is not provided, it defaults to `N`, meaning all attempts can fail before an error is raised.\n\n        Args:\n            module: The module to run.\n            N: The number of times to run the module.\n            reward_fn: A callable that takes (args, pred) and returns a float score.\n            threshold: The minimum reward threshold. If None, all successful attempts are compared.\n            fail_count: Optional[int]: Maximum number of failed attempts to tolerate. If None, defaults to N.\n                When exceeded, an exception is raised immediately with details about the failed attempt.","newString":"        \"\"\"\n        Runs a module up to `N` times with different temperatures and returns the best prediction or the first prediction that passes the `threshold`.\n\n        This module provides configurable failure tolerance through the `fail_count` parameter, allowing you to control how many failed attempts are tolerated before raising an exception. When `fail_count` is not provided, it defaults to `N-1`, meaning the exception is raised only when all attempts fail.\n\n        Args:\n            module: The module to run.\n            N: The number of times to run the module.\n            reward_fn: A callable that takes (args, pred) and returns a float score.\n            threshold: The minimum reward threshold. If None, all successful attempts are compared.\n            fail_count: Optional[int]: Maximum number of failed attempts to tolerate. If None, defaults to N-1.\n                When exceeded, an exception is raised immediately with details about the failed attempt.","originalFile":"import inspect\nfrom typing import Callable, Optional\n\nimport dspy\n\nfrom .predict import Module\n\n\nclass BestOfN(Module):\n    def __init__(\n        self,\n        module,\n        N: int,\n        reward_fn: Callable,\n        threshold: float,\n        fail_count: Optional[int] = None,\n    ):\n        \"\"\"\n        Runs a module up to `N` times with different temperatures and returns the best prediction or the first prediction that passes the `threshold`.\n\n        This module provides configurable failure tolerance through the `fail_count` parameter, allowing you to control\n how many failed attempts are tolerated before raising an exception. When `fail_count` is not provided, it defaults to `N`, meaning all attempts can fail before an error is raised.\n\n        Args:\n            module: The module to run.\n            N: The number of times to run the module.\n            reward_fn: A callable that takes (args, pred) and returns a float score.\n            threshold: The minimum reward threshold. If None, all successful attempts are compared.\n            fail_count: Optional[int]: Maximum number of failed attempts to tolerate. If None, defaults to N.\n                When exceeded, an exception is raised immediately with details about the failed attempt.\n\n        Example:\n            >>> import dspy\n            >>> qa = dspy.ChainOfThought(\"question -> answer\")\n            >>> def one_word_answer(args, pred):\n            >>>     return 1.0 if len(pred.answer) == 1 else 0.0\n            >>> best_of_3 = dspy.BestOfN(module=qa, N=3, reward_fn=one_word_answer, threshold=1.0)\n            >>> best_of_3(question=\"What is the capital of Belgium?\").answer\n            >>> # Brussels\n\n        Example with fail_count:\n            >>> best_of_3_strict = dspy.BestOfN(\n            ...     module=qa, N=3, reward_fn=one_word_answer, threshold=1.0, fail_count=1\n            ... )\n            >>> # Only 1 failure is tolerated before raising an exception\n        \"\"\"\n        self.module = module\n        self.reward_fn = lambda *args: reward_fn(\n            *args)  # to prevent this from becoming a parameter\n        self.threshold = threshold\n        self.N = N\n        self.fail_count = fail_count if fail_count is not None else N - 1  # default to N-1 to raise only when all attempts fail\n\n    def forward(self, **kwargs):\n        lm = self.module.get_lm() or dspy.settings.lm\n        temps = [lm.kwargs['temperature']] + [0.5 + i * (0.5 / self.N) for i in range(self.N)]\n        temps = list(dict.fromkeys(temps))[:self.N]\n        best_pred, best_trace, best_reward = None, None, -float(\"inf\")\n\n        # Track remaining failures we can tolerate\n        failures_remaining = self.fail_count\n\n        for idx, t in enumerate(temps):\n            lm_ = lm.copy(temperature=t)\n            mod = self.module.deepcopy()\n            mod.set_lm(lm_)\n\n            try:\n                with dspy.context(trace=[]):\n                    pred = mod(**kwargs)\n                    trace = dspy.settings.trace.copy()\n\n                    # NOTE: Not including the trace of reward_fn.\n                    reward = self.reward_fn(kwargs, pred)\n\n                if reward > best_reward:\n                    best_reward, best_pred, best_trace = reward, pred, trace\n\n                if self.threshold is not None and reward >= self.threshold:\n                    break\n\n            except Exception as e:\n                print(f\"BestOfN: Attempt {idx + 1} failed with temperature {t}: {e}\")\n                failures_remaining -= 1\n                if failures_remaining < 0:\n                    raise e\n\n        dspy.settings.trace.extend(best_trace)\n        return best_pred\n","structuredPatch":[{"oldStart":18,"oldLines":15,"newStart":18,"newLines":14,"lines":["         \"\"\"","         Runs a module up to `N` times with different temperatures and returns the best prediction or the first prediction that passes the `threshold`."," ","-        This module provides configurable failure tolerance through the `fail_count` parameter, allowing you to control","- how many failed attempts are tolerated before raising an exception. When `fail_count` is not provided, it defaults to `N`, meaning all attempts can fail before an error is raised.","+        This module provides configurable failure tolerance through the `fail_count` parameter, allowing you to control how many failed attempts are tolerated before raising an exception. When `fail_count` is not provided, it defaults to `N-1`, meaning the exception is raised only when all attempts fail."," ","         Args:","             module: The module to run.","             N: The number of times to run the module.","             reward_fn: A callable that takes (args, pred) and returns a float score.","             threshold: The minimum reward threshold. If None, all successful attempts are compared.","-            fail_count: Optional[int]: Maximum number of failed attempts to tolerate. If None, defaults to N.","+            fail_count: Optional[int]: Maximum number of failed attempts to tolerate. If None, defaults to N-1.","                 When exceeded, an exception is raised immediately with details about the failed attempt."," ","         Example:"]}],"userModified":false,"replaceAll":false}}
