+    def test_custom_final_answer_tool_is_respected(self):
+        """Test that a custom final_answer tool is not overridden by the default."""
+        from smolagents.default_tools import FinalAnswerTool
+
+        class CustomFinalAnswerTool(FinalAnswerTool):
+            name = "final_answer"
+            description = "Custom final answer tool"
+            inputs = {"answer": {"type": "any", "description": "The final answer"}}
+            output_type = "any"
+
+            def forward(self, answer):
+                return f"custom:{answer}"
+
+        custom_tool = CustomFinalAnswerTool()
+
+        # Test CodeAgent respects custom final_answer
+        agent1 = CodeAgent(tools=[custom_tool], model=fake_code_model)
+        assert "final_answer" in agent1.tools
+        assert agent1.tools["final_answer"] is custom_tool
+        assert agent1.tools["final_answer"].forward("test") == "custom:test"
+
+        # Test ToolCallingAgent respects custom final_answer
+        agent2 = ToolCallingAgent(tools=[custom_tool], model=fake_code_model)
+        assert agent2.tools["final_answer"] is custom_tool
+        assert agent2.tools["final_answer"].forward("test") == "custom:test"
+
