_answer\n+        agent1 = CodeAgent(tools=[custom_tool], model=fake_code_model)\n+        assert \"final_answer\" in agent1.tools\n+        assert agent1.tools[\"final_answer\"] is custom_tool\n+        assert agent1.tools[\"final_answer\"].forward(\"test\") == \"custom:test\"\n+\n+        # Test ToolCallingAgent respects custom final_answer\n+        agent2 = ToolCallingAgent(tools=[custom_tool], model=fake_code_model)\n+        assert agent2.tools[\"final_answer\"] is custom_tool\n+        assert agent2.tools[\"final_answer\"].forward(\"test\") == \"custom:test\"\n+\n     def test_function_persistence_across_steps(self):\n         agent = CodeAgent(\n             tools=[],\n","metadata":{"output":"diff --git a/src/smolagents/agents.py b/src/smolagents/agents.py\nindex 1a42b9e..4d7cc6c 100644\n--- a/src/smolagents/agents.py\n+++ b/src/smolagents/agents.py\n@@ -252,7 +252,8 @@ class MultiStepAgent:\n                     if name != \"python_interpreter\" or self.__class__.__name__ == \"ToolCallingAgent\"\n                 }\n             )\n-        self.tools[\"final_answer\"] = FinalAnswerTool()\n+        if \"final_answer\" not in self.tools:\n+            self.tools[\"final_answer\"] = FinalAnswerTool()\n \n     def _validate_tools_and_managed_agents(self, tools, managed_agents):\n         tool_and_managed_agent_names = [tool.name for tool in tools]\ndiff --git a/tests/test_agents.py b/tests/test_agents.py\nindex f466413..946c7a1 100644\n--- a/tests/test_agents.py\n+++ b/tests/test_agents.py\n@@ -465,6 +465,32 @@ class AgentTests(unittest.TestCase):\n         agent = ToolCallingAgent(tools=[], model=fake_code_model, add_base_tools=True)\n         assert len(agent.tools) == 4  # added final_answer tool + search + visit_webpage\n \n+    def test_custom_final_answer_tool_is_respected(self):\n+        \"\"\"Test that a custom final_answer tool is not overridden by the default.\"\"\"\n+        from smolagents.default_tools import FinalAnswerTool\n+\n+        class CustomFinalAnswerTool(FinalAnswerTool):\n+            name = \"final_answer\"\n+            description = \"Custom final answer tool\"\n+            inputs = {\"answer\": {\"type\": \"any\", \"description\": \"The final answer\"}}\n+            output_type = \"any\"\n+\n+            def forward(self, answer):\n+                return f\"custom:{answer}\"\n+\n+        custom_tool = CustomFinalAnswerTool()\n+\n+        # Test CodeAgent respects custom final_answer\n+        agent1 = CodeAgent(tools=[custom_tool], model=fake_code_model)\n+        assert \"final_answer\" in agent1.tools\n+        assert agent1.tools[\"final_answer\"] is custom_tool\n+        assert agent1.tools[\"final_answer\"].forward(\"test\") == \"custom:test\"\n+\n+        # Test ToolCallingAgent respects custom final_answer\n+        agent2 = ToolCallingAgent(tools=[custom_tool], model=fake_code_model)\n+        assert agent2.tools[\"final_answer\"] is custom_tool\n+        assert agent2.tools[\"final_answer\"].forward(\"test\") == \"custom:test\"\n+\n     def test_function_persistence_across_steps(self):\n         agent = CodeAgent(\n             tools=[],\n","exit":0,"truncated":false},"title":"cd /testbed && git diff","time":{"start":1788416022054,"end":1788416022079}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_065e6d61e0014kotybZct3bN2t","sessionID":"ses_f9a1bca88ffeOI6XQW9XGrhSp9","messageID":"msg_065e6d254001VKC9DE5spwOwUE"}}
