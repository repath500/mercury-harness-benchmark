diff --git a/tests/test_loaders.py b/tests/test_loaders.py
index 466dc28..7eef5a3 100644
--- a/tests/test_loaders.py
+++ b/tests/test_loaders.py
@@ -37,3 +37,51 @@ def test_loaders_raise_on_syntax_error(file_factory, filename, silent):
     settings = Dynaconf()
     with pytest.raises(Exception):
         settings.load_file(path=filepath, silent=silent)
+
+
+def test_load_file_env_false_bypasses_environment_filtering(file_factory):
+    """env=False bypasses environment filtering and loads all top-level variables."""
+    # Create file with environment sections
+    filepath = file_factory(
+        "test_env.toml",
+        """
+# Top level variables (should be loaded with env=False)
+APP_NAME = "MyApp"
+DEBUG = true
+
+[development]
+DB_HOST = "localhost"
+DB_PORT = 5432
+
+[production]
+DB_HOST = "prod.example.com"
+DB_PORT = 5433
+"""
+    )
+
+    # Load with environments enabled but env=False
+    settings = Dynaconf(environments=True)
+    settings.load_file(path=filepath, env=False)
+
+    # Top-level variables should be loaded
+    assert settings.get("APP_NAME") == "MyApp"
+    assert settings.get("DEBUG") is True
+
+
+def test_load_file_env_false_with_nonenv_file(file_factory):
+    """env=False works with files that have no environment sections."""
+    filepath = file_factory(
+        "simple.toml",
+        """
+API_KEY = "secret123"
+API_URL = "https://api.example.com"
+TIMEOUT = 30
+"""
+    )
+
+    settings = Dynaconf(environments=True)
+    settings.load_file(path=filepath, env=False)
+
+    assert settings.get("API_KEY") == "secret123"
+    assert settings.get("API_URL") == "https://api.example.com"
+    assert settings.get("TIMEOUT") == 30
