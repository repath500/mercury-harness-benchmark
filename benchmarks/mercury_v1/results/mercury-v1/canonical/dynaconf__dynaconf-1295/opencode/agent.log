timestamp=2026-09-03T07:13:58.797Z level=INFO run=eca2a69f message=evaluated permission=bash pattern="python -c \"\nfrom dynaconf import Dynaconf\nfrom dynaconf.loaders import toml_loader\nimport tempfile\nimport os\n\n# Test: load_file with env=False bypasses environment filtering\nprint('Testing load_file(env=False) feature...')\n\n# Create a test config file with environment sections\nconfig_content = '''\n[default]\napi_url = \\\"default_url\\\"\n\n[development]\napi_url = \\\"dev_url\\\"\ndebug = true\n\n[production]\napi_url = \\\"prod_url\\\"\ndebug = false\n'''\n\nwith tempfile.NamedTemporaryFile(mode='w', suffix='.toml', delete=False) as f:\n    f.write(config_content)\n    config_file = f.name\n\ntry:\n    # Test 1: Normal loading (only current env)\n    settings = Dynaconf(environments=True, ENVIRONMENTS_FOR_DYNACONF=True, ENV_FOR_DYNACONF='development')\n    settings.load_file(config_file)\n    \n    assert settings.get('api_url') == 'dev_url', f'Expected dev_url, got {settings.get(\\\"api_url\\\")}'\n    assert settings.get('debug') == True, f'Expected True, got {settings.get(\\\"debug\\\")}'\n    print('✓ Normal env-aware loading works')\n    \n    # Test 2: env=False loads all sections\n    settings2 = Dynaconf(environments=True, ENVIRONMENTS_FOR_DYNACONF=True, ENV_FOR_DYNACONF='production')\n    settings2.load_file(config_file, env=False)\n    \n    # When env=False, all sections are loaded, not just production\n    assert settings2.get('api_url') is None, f'Expected None when env=False, got {settings2.get(\\\"api_url\\\")}'\n    assert settings2.get('DEVELOPMENT.api_url') == 'dev_url', f'Expected dev_url, got {settings2.get(\\\"DEVELOPMENT.api_url\\\")}'\n    assert settings2.get('PRODUCTION.api_url') == 'prod_url', f'Expected prod_url, got {settings2.get(\\\"PRODUCTION.api_url\\\")}'\n    print('✓ env=False loads all sections without filtering')\n    \n    # Test 3: Works even when ENVIRONMENTS_FOR_DYNACONF is False\n    settings3 = Dynaconf(environments=False, ENVIRONMENTS_FOR_DYNACONF=False)\n    settings3.load_file(config_file, env=False)\n    \n    assert settings3.get('DEVELOPMENT.api_url') == 'dev_url', f'Expected dev_url, got {settings3.get(\\\"DEVELOPMENT.api_url\\\")}'\n    print('✓ env=False works with ENVIRONMENTS_FOR_DYNACONF=False')\n    \n    print()\n    print('All tests passed! env=False feature is working correctly.')\nfinally:\n    os.unlink(config_file)\n\"" action.permission=* action.action=allow action.pattern=*
