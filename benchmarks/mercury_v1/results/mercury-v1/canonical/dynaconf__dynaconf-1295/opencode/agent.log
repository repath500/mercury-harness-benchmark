licitly requested or if ENVIRONMENTS is disabled\n+if self._envless or self.obj.get(\"ENVIRONMENTS_FOR_DYNACONF\") is False:\n     self._envless_load(source_data, silent, key)\n else:\n     self._load_all_envs(source_data, silent, key)\n \n","additions":2,"deletions":1},"truncated":false},"title":"dynaconf/loaders/base.py","time":{"start":1788419589146,"end":1788419589156}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_0661d44110013fGYgKph8L2XX2","sessionID":"ses_f99e39b61ffeVhyL6wKpvNfEvS","messageID":"msg_0661d40920018Sw1AUatIuWstv"}}
{"type":"step_finish","timestamp":1788419589245,"sessionID":"ses_f99e39b61ffeVhyL6wKpvNfEvS","part":{"id":"prt_0661d4478001qmEbc9eT1DHuv9","reason":"tool-calls","snapshot":"4b825dc642cb6eb9a060e54bf8d69288fbee4904","messageID":"msg_0661d40920018Sw1AUatIuWstv","sessionID":"ses_f99e39b61ffeVhyL6wKpvNfEvS","type":"step-finish","tokens":{"total":28110,"input":27879,"output":31,"reasoning":200,"cache":{"write":0,"read":0}},"cost":0.00114981}}
