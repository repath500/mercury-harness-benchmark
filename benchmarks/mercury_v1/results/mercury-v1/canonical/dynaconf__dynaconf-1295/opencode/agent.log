timestamp=2026-09-03T07:13:23.693Z level=INFO run=eca2a69f message=evaluated permission=bash pattern="python -c \"\nfrom dynaconf import Dynaconf\nfrom dynaconf.loaders.base import BaseLoader\nimport tempfile\nimport os\n\n# Monkey patch BaseLoader to see what's happening\noriginal_init = BaseLoader.__init__\ndef patched_init(self, obj, env, identifier, extensions, file_reader, string_reader, opener_params=None, validate=False):\n    print(f'BaseLoader.__init__: env={env!r}, env==\\\"_envless\\\"={env == \\\"_envless\\\"}')\n    original_init(self, obj, env, identifier, extensions, file_reader, string_reader, opener_params, validate)\n\nBaseLoader.__init__ = patched_init\n\n# Create a test config file with environment sections\nconfig_content = '''\n[default]\nvalue_default = \\\"default_value\\\"\n\n[development]\nvalue_dev = \\\"dev_value\\\"\n\n[production]\nvalue_prod = \\\"prod_value\\\"\n\n# Top level variables\ntop_level = \\\"top_value\\\"\n'''\n\nwith tempfile.NamedTemporaryFile(mode='w', suffix='.toml', delete=False) as f:\n    f.write(config_content)\n    config_file = f.name\n\ntry:\n    print('=== Test 1: env=False should bypass environment sections ===')\n    settings = Dynaconf(environments=True, ENVIRONMENTS_FOR_DYNACONF=True)\n    settings.load_file(config_file, env=False)\n    \n    print(f'PRODUCTION value: {settings.get(\\\"PRODUCTION\\\")}')\nfinally:\n    os.unlink(config_file)\n\"" action.permission=* action.action=allow action.pattern=*
