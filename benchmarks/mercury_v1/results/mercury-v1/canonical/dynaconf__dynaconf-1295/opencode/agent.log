timestamp=2026-09-03T07:14:18.722Z level=INFO run=eca2a69f message=evaluated permission=bash pattern="python -c \"\nfrom dynaconf import Dynaconf\nimport tempfile\nimport os\n\nprint('=== Comprehensive test of load_file(env=False) ===')\nprint()\n\n# Create a test config file with environment sections\nconfig_content = '''\n[default]\ndb_host = \\\"default_host\\\"\ndb_port = 5432\n\n[development]\ndb_host = \\\"localhost\\\"\ndebug = true\napi_url = \\\"http://dev.local/api\\\"\n\n[production]\ndb_host = \\\"prod.db.example.com\\\"\ndebug = false\napi_url = \\\"http://api.example.com\\\"\n'''\n\nwith tempfile.NamedTemporaryFile(mode='w', suffix='.toml', delete=False) as f:\n    f.write(config_content)\n    config_file = f.name\n\ntry:\n    print('1. Without env=False (environment-aware loading):')\n    settings = Dynaconf(\n        environments=True,\n        ENVIRONMENTS_FOR_DYNACONF=True,\n        ENV_FOR_DYNACONF='development'\n    )\n    settings.load_file(config_file)\n    print(f'   db_host: {settings.db_host}')\n    print(f'   debug: {settings.debug}')\n    print()\n    \n    print('2. With env=False (environment-agnostic loading):')\n    settings2 = Dynaconf(\n        environments=True,\n        ENVIRONMENTS_FOR_DYNACONF=True,\n        ENV_FOR_DYNACONF='production'  # This is ignored with env=False\n    )\n    settings2.load_file(config_file, env=False)\n    print(f'   DEVELOPMENT.db_host: {settings2.DEVELOPMENT.db_host}')\n    print(f'   PRODUCTION.db_host: {settings2.PRODUCTION.db_host}')\n    print(f'   DEVELOPMENT.debug: {settings2.DEVELOPMENT.debug}')\n    print(f'   PRODUCTION.debug: {settings2.PRODUCTION.debug}')\n    print()\n    \n    print('3. Works with ENVIRONMENTS_FOR_DYNACONF=False:')\n    settings3 = Dynaconf(\n        environments=False,\n        ENVIRONMENTS_FOR_DYNACONF=False\n    )\n    settings3.load_file(config_file, env=False)\n    print(f'   DEVELOPMENT.db_host: {settings3.DEVELOPMENT.db_host}')\n    print(f'   PRODUCTION.db_host: {settings3.PRODUCTION.db_host}')\n    print()\n    \n    print('✓ All tests passed! The env=False feature works correctly.')\n    \nfinally:\n    os.unlink(config_file)\n\"" action.permission=* action.action=allow action.pattern=*
