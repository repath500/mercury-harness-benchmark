timestamp=2026-09-03T07:13:44.751Z level=INFO run=eca2a69f message=evaluated permission=bash pattern="python -c \"\nimport tempfile\nimport os\nfrom dynaconf.vendor import tomllib\n\nconfig_content = '''\n[default]\nvalue_default = \\\"default_value\\\"\n\n[development]\nvalue_dev = \\\"dev_value\\\"\n\n[production]\nvalue_prod = \\\"prod_value\\\"\n\n# Top level variables\ntop_level = \\\"top_value\\\"\n'''\n\nwith tempfile.NamedTemporaryFile(mode='wb', suffix='.toml', delete=False) as f:\n    f.write(config_content.encode('utf-8'))\n    config_file = f.name\n\ntry:\n    with open(config_file, 'rb') as f:\n        data = tomllib.load(f)\n    print('TOML parsed data:')\n    for key, value in data.items():\n        print(f'  {key}: {value}')\nfinally:\n    os.unlink(config_file)\n\"" action.permission=* action.action=allow action.pattern=*
