timestamp=2026-09-03T07:13:35.332Z level=INFO run=eca2a69f message=evaluated permission=bash pattern="python -c \"\nfrom dynaconf import Dynaconf\nfrom dynaconf.loaders import toml_loader\nfrom dynaconf.loaders.base import BaseLoader\nimport tempfile\nimport os\n\n# Monkey patch both to see what's happening\noriginal_load = toml_loader.load\ndef patched_load(*args, **kwargs):\n    print(f'toml_loader.load called with env={kwargs.get(\\\"env\\\")!r}, file={kwargs.get(\\\"filename\\\")!r}')\n    return original_load(*args, **kwargs)\n\ntoml_loader.load = patched_load\n\n# Create a test config file with environment sections\nconfig_content = '''\n[default]\nvalue_default = \\\"default_value\\\"\n\n[development]\nvalue_dev = \\\"dev_value\\\"\n\n[production]\nvalue_prod = \\\"prod_value\\\"\n\n# Top level variables\ntop_level = \\\"top_value\\\"\n'''\n\nwith tempfile.NamedTemporaryFile(mode='w', suffix='.toml', delete=False) as f:\n    f.write(config_content)\n    config_file = f.name\n\ntry:\n    print('=== Test: env=False should bypass environment sections ===')\n    print(f'Config file: {config_file}')\n    settings = Dynaconf(environments=True, ENVIRONMENTS_FOR_DYNACONF=True)\n    settings.load_file(config_file, env=False)\n    \n    print(f'PRODUCTION value: {settings.get(\\\"PRODUCTION\\\")}')\n    print(f'Value from top_level (should be top_value): {settings.get(\\\"top_level\\\")}')\nfinally:\n    os.unlink(config_file)\n\"" action.permission=* action.action=allow action.pattern=*
