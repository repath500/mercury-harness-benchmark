key in all_keys:\n50:         if not obj.exists(key):\n51:             value = defaults.get(key, default_settings_values.get(key))\n52:             obj.set(\n53:                 key,\n54:                 value,\n55:                 loader_identifier=\"default_settings\",\n56:                 validate=False,\n57:             )\n58: \n59:     # LOAD ENVVAR OVERRIDES\n60: \n61:     # start dotenv to get default env vars from there\n62:     # check overrides in env vars\n63:     if obj.get(\"load_dotenv\") is True:\n64:         default_settings.start_dotenv(obj)\n65: \n66:     # Deal with cases where a custom ENV_SWITCHER_IS_PROVIDED\n67:     # Example: Flask and Django Extensions\n68:     env_switcher = defaults.get(\n69:         \"ENV_SWITCHER_FOR_DYNACONF\", \"ENV_FOR_DYNACONF\"\n70:     )\n71: \n72:     for key in all_keys:\n73:         if key not in default_settings_values.keys():\n74:             continue\n75: \n76:         env_value = obj.get_environ(\n77:             env_switcher if key == \"ENV_FOR_DYNACONF\" else key,\n78:             default=\"_not_found\",\n79:         )\n80: \n81:         if env_value != \"_not_found\":\n82:             obj.set(\n83:                 key,\n84:                 env_value,\n85:                 tomlfy=True,\n86:                 loader_identifier=\"envvars_first_load\",\n87:             )\n88: \n89: \n90: def execute_instance_hooks(\n91:     obj: Settings, hook_type: str, hook_functions: list[Callable]\n92: ):\n93:     \"\"\"Execute hooks provided by Setting instance\"\"\"\n94:     hook_source = \"instance\"\n95:     for hook_func in hook_functions:\n96:         _run_hook_function(obj, hook_type, hook_func, hook_source)\n97: \n98: \n99: def execute_module_hooks(\n100:     hook, obj, env=None, silent=True, key=None, modules=None, files=None\n101: ):\n102:     \"\"\"Execute dynaconf_hooks from module or filepath.\"\"\"\n103:     if hook not in [\"post\"]:\n104:         raise ValueError(f\"hook {hook} not supported yet.\")\n105: \n106:     # try to load hooks using python module __name__\n107:     modules = modules or obj._loaded_py_modules\n108:     for loaded_module in modules:\n109:         hook_module_name = \".\".join(\n110:             loaded_module.split(\".\")[:-1] + [\"dynaconf_hooks\"]\n111:         )\n112:         try:\n113:             hook_module = importlib.import_module(hook_module_name)\n114:         except (ImportError, TypeError):\n115:             # There was no hook on the same path as a python module\n116:             continue\n117:         else:\n118:             _run_hook_module(\n119:                 hook_type=hook,\n120:                 hook_module=hook_module,\n121:                 obj=obj,\n122:                 key=key,\n123:             )\n124: \n125:     # Try to load from python filename path\n126:     files = files or obj._loaded_files\n127:     for loaded_file in files:\n128:         hook_file = os.path.join(\n129:             os.path.dirname(loaded_file), \"dynaconf_hooks.py\"\n130:         )\n131:         if not os.path.exists(hook_file):\n132:             # Return early if file doesn't exist.\n133:             # Faster than attempting to import.\n134:             continue\n135:         hook_module = py_loader.import_from_filename(\n136:             obj, hook_file, silent=silent\n137:         )\n138:         _run_hook_module(\n139:             hook_type=hook,\n140:             hook_module=hook_module,\n141:             obj=obj,\n142:             key=key,\n143:         )\n144: \n145: \n146: # alias\n147: execute_hooks = execute_module_hooks\n148: \n149: \n150: def _get_unique_hook_id(hook_func, hook_source):\n151:     \"\"\"get unique identifier for a hook function.\n152:     in most of cases this will be the function name@source_file\n153:     however, if the function is a lambda, it will be a hash of the code object.\n154:     because lambda functions are not hashable itself and we can't rely on its id.\n155:     \"\"\"\n156:     hook_unique_id = hook_func.__name__\n157:     if hook_unique_id == \"<lambda>\":\n158:         frame_info = getattr(hook_func, \"__code__\", None)\n159:         if frame_info:\n160:             hook_unique_id = f\"lambda_{hash(frame_info.co_code)}\"\n161:         else:\n162:             hook_unique_id = f\"lambda_{id(hook_func)}\"\n163:     return f\"{hook_unique_id}@{hook_source}\"\n164: \n165: \n166: def _run_hook_module(hook_type, hook_module, obj, key=\"\"):\n167:     \"\"\"\n168:     Run a hook function from hook_module.\n169: \n170:     Given a @hook_type, a @hook_module and a settings @obj, load the function\n171:     and execute it if found.\n172:     \"\"\"\n173: \n174:     # check errors\n175:     if hook_module and getattr(hook_module, \"_error\", False):\n176:         if not isinstance(hook_module._error, FileNotFoundError):\n177:             raise hook_module._error\n178: \n179:     # execute hook\n180:     hook_source = hook_module.__file__\n181:     hook_func = getattr(hook_module, hook_type, None)\n182:     if hook_func:\n183:         identifier = _get_unique_hook_id(hook_func, hook_source)\n184:         if hook_type not in obj._loaded_hooks.get(identifier, {}):\n185:             _run_hook_function(obj, hook_type, hook_func, hook_source, key)\n186: \n187: \n188: def _run_hook_function(\n189:     obj: Settings,\n190:     hook_type: str,\n191:     hook_func: Callable,\n192:     hook_source: str = \"default\",\n193:     key: str = \"\",\n194: ):\n195:     \"\"\"\n196:     Run a hook function:\n197: \n198:     It execute @hook_func, update the results into settings @obj and\n199:     add it to _loaded_hook registry ([@hook_source][@hook_type])\n200:     \"\"\"\n201:     # if the function has a _dynaconf_hook_source attribute set\n202:     # hook_source to it\n203:     hook_source = getattr(hook_func, \"_dynaconf_hook_source\", hook_source)\n204: \n205:     # optional settings argument\n206:     try:\n207:         hook_dict = hook_func(obj.dynaconf.clone())\n208:     except TypeError:\n209:         hook_dict = hook_func()\n210: \n211:     # mark as called so executors such as `load_file` can avoid calling it again\n212:     with suppress(AttributeError, TypeError):\n213:         # callable may not be writable, the caveat is that it will be called again in case of reload\n214:         # however, this must not be a problem since the function should be idempotent\n215:         # and documentation warns about this behavior.\n216:         hook_func._called = True\n217: \n218:     identifier = _get_unique_hook_id(hook_func, hook_source)\n219: \n220:     if hook_dict:\n221:         # update obj settings\n222:         merge = hook_dict.pop(\n223:             \"dynaconf_merge\", hook_dict.pop(\"DYNACONF_MERGE\", False)\n224:         )\n225:         if key and key in hook_dict:\n226:             obj.set(\n227:                 key,\n228:                 hook_dict[key],\n229:                 tomlfy=False,\n230:                 merge=merge,\n231:                 loader_identifier=identifier,\n232:             )\n233:         elif not key:\n234:             obj.update(\n235:                 hook_dict,\n236:                 tomlfy=False,\n237:                 merge=merge,\n238:                 loader_identifier=identifier,\n239:             )\n240: \n241:     # add to registry\n242:     obj._loaded_hooks[identifier][hook_type] = hook_dict\n243: \n244: \n245: def settings_loader(\n246:     obj,\n247:     settings_module=None,\n248:     env=None,\n249:     silent=True,\n250:     key=None,\n251:     filename=None,\n252:     validate=False,\n253:     identifier=\"settings_loader\",\n254: ):\n255:     \"\"\"Loads from defined settings module\n256: \n257:     :param obj: A dynaconf instance\n258:     :param settings_module: A path or a list of paths e.g settings.toml\n259:     :param env: Env to look for data defaults: development\n260:     :param silent: Boolean to raise loading errors\n261:     :param key: Load a single key if provided\n262:     :param filename: optional filename to override the settings_module\n263:     :param validate: Validate the loaded data\n264:     :param identifier: Loader identifier\n265:     \"\"\"\n266:     if filename is None:\n267:         settings_module = settings_module or obj.settings_module\n268:         if not settings_module:  # pragma: no cover\n269:             return\n270:         files = ensure_a_list(settings_module)\n271:     else:\n272:         files = ensure_a_list(filename)\n273: \n274:     files.extend(ensure_a_list(obj.get(\"SECRETS_FOR_DYNACONF\", None)))\n275: \n276:     found_files = []\n277:     modules_names = []\n278:     for item in files:\n279:         item = str(item)  # Ensure str in case of LocalPath/Path is passed.\n280:         p_root = obj._root_path or (\n281:             os.path.dirname(found_files[0]) if found_files else None\n282:         )\n283:         if has_magic(item):\n284:             # handle possible globs inside files list\n285:             # like [\"path/*.yaml\", \"path/ABC?.yaml\"]\n286:             globedfiles = glob(item, root_dir=p_root)\n287:             for globedfile in globedfiles:\n288:                 # use object.find_file logic to handle skip files\n289:                 found = obj.find_file(globedfile, project_root=p_root)\n290:                 if found:\n291:                     found_files.append(found)\n292:         elif item.endswith(ct.ALL_EXTENSIONS + (\".py\",)):\n293:             found = obj.find_file(item, project_root=p_root)\n294:             if found:\n295:                 found_files.append(found)\n296:         else:\n297:             # a bare python module name w/o extension\n298:             modules_names.append(item)\n299: \n300:     enabled_core_loaders = [\n301:         item.upper() for item in obj.get(\"CORE_LOADERS_FOR_DYNACONF\") or []\n302:     ]\n303: \n304:     # add `.local.` to found_files list to search for local files.\n305:     found_files.extend(\n306:         [\n307:             get_local_filename(item)\n308:             for item in found_files\n309:             if \".local.\" not in str(item)\n310:         ]\n311:     )\n312: \n313:     for mod_file in modules_names + found_files:\n314:         # can be set to multiple files settings.py,settings.yaml,...\n315: \n316:         # Cascade all loaders\n317:         loaders = [\n318:             {\"ext\": ct.YAML_EXTENSIONS, \"name\": \"YAML\", \"loader\": yaml_loader},\n319:             {\"ext\": ct.TOML_EXTENSIONS, \"name\": \"TOML\", \"loader\": toml_loader},\n320:             {\"ext\": ct.INI_EXTENSIONS, \"name\": \"INI\", \"loader\": ini_loader},\n321:             {\"ext\": ct.JSON_EXTENSIONS, \"name\": \"JSON\", \"loader\": json_loader},\n322:         ]\n323: \n324:         for loader in loaders:\n325:             if loader[\"name\"] not in enabled_core_loaders:\n326:                 continue\n327: \n328:             if mod_file.endswith(loader[\"ext\"]):\n329:                 if isinstance(identifier, str):\n330:                     # ensure it is always loader name\n331:                     identifier = loader[\"name\"].lower()\n332:                 loader[\"loader\"].load(\n333:                     obj,\n334:                     filename=mod_file,\n335:                     env=env,\n336:                     silent=silent,\n337:                     key=key,\n338:                     validate=validate,\n339:                     identifier=identifier,\n340:                 )\n341:                 continue\n342: \n343:         if mod_file.endswith(ct.ALL_EXTENSIONS):\n344:             continue\n345: \n346:         if \"PY\" not in enabled_core_loaders:\n347:             # pyloader is disabled\n348:             continue\n349: \n350:         # must be Python file or module\n351:         # load from default defined module settings.py or .secrets.py if exists\n352:         py_loader.load(\n353:             obj, mod_file, key=key, validate=validate, identifier=identifier\n354:         )\n355: \n356:         # load from the current env e.g: development_settings.py\n357:         # counting on the case where env is a comma separated string\n358:         env = env or obj.current_env\n359:         if env and isinstance(env, str):\n360:             for env_name in env.split(\",\"):\n361:                 load_from_env_named_file(\n362:                     obj, env_name, key, validate, identifier, mod_file\n363:                 )\n364: \n365: \n366: def load_from_env_named_file(obj, env, key, validate, identifier, mod_file):\n367:     \"\"\"Load from env named file e.g: development_settings.py\"\"\"\n368:     if mod_file.endswith(\".py\"):\n369:         if \".secrets.py\" == mod_file:\n370:             tmpl = \".{0}_{1}{2}\"\n371:             mod_file = \"secrets.py\"\n372:         else:\n373:             tmpl = \"{0}_{1}{2}\"\n374: \n375:         dirname = os.path.dirname(mod_file)\n376:         filename, extension = os.path.splitext(os.path.basename(mod_file))\n377:         new_filename = tmpl.format(env.lower(), filename, extension)\n378:         env_mod_file = os.path.join(dirname, new_filename)\n379:         global_filename = tmpl.format(\"global\", filename, extension)\n380:         global_mod_file = os.path.join(dirname, global_filename)\n381:     else:\n382:         parts = mod_file.rsplit(\".\", 1)\n383:         if len(parts) > 1:\n384:             head, tail = parts\n385:         else:\n386:             head, tail = None, parts[0]\n387:         tail = env_mod_file = f\"{env.lower()}_{tail}\"\n388: \n389:         if head:\n390:             env_mod_file = f\"{head}.{tail}\"\n391:             global_mod_file = f\"{head}.global_{tail}\"\n392:         else:\n393:             env_mod_file = tail\n394:             global_mod_file = f\"global_{tail}\"\n395: \n396:     source_metadata = SourceMetadata(\n397:         loader=\"py\",\n398:         identifier=identifier,\n399:         env=env,\n400:     )\n401:     py_loader.load(\n402:         obj,\n403:         env_mod_file,\n404:         identifier=source_metadata,\n405:         silent=True,\n406:         key=key,\n407:         validate=validate,\n408:     )\n409: \n410:     # load from global_settings.py\n411:     py_loader.load(\n412:         obj,\n413:         global_mod_file,\n414:         identifier=\"py_global\",\n415:         silent=True,\n416:         key=key,\n417:         validate=validate,\n418:     )\n419: \n420: \n421: def enable_external_loaders(obj):\n422:     \"\"\"Enable external service loaders like `VAULT_` and `REDIS_`\n423:     looks forenv variables like `REDIS_ENABLED_FOR_DYNACONF`\n424:     \"\"\"\n425:     for name, loader in ct.EXTERNAL_LOADERS.items():\n426:         enabled = getattr(obj, f\"{name.upper()}_ENABLED_FOR_DYNACONF\", False)\n427:         if (\n428:             enabled\n429:             and enabled not in false_values\n430:             and loader not in obj.LOADERS_FOR_DYNACONF\n431:         ):  # noqa\n432:             obj.LOADERS_FOR_DYNACONF.insert(0, loader)\n433: \n434: \n435: def write(filename, data, env=None, merge=False):\n436:     \"\"\"Writes `data` to `filename` infers format by file extension.\"\"\"\n437:     loader_name = f\"{filename.rpartition('.')[-1]}_loader\"\n438:     loader = globals().get(loader_name)\n439:     if not loader:\n440:         raise OSError(f\"{loader_name} cannot be found.\")\n441: \n442:     data = DynaBox(data, box_settings={}).to_dict()\n443:     if loader is not py_loader and env and env not in data:\n444:         data = {env: data}\n445: \n446:     loader.write(filename, data, merge=merge)\n\n(End of file - total 446 lines)\n</content>","metadata":{"preview":"from __future__ import annotations\n\nimport importlib\nimport os\nfrom contextlib import suppress\nfrom typing import Callable\nfrom typing import TYPE_CHECKING\n\nfrom dynaconf import constants as ct\nfrom dynaconf import default_settings\nfrom dynaconf.loaders import ini_loader\nfrom dynaconf.loaders import json_loader\nfrom dynaconf.loaders import py_loader\nfro