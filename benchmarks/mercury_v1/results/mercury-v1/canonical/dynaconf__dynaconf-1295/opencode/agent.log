timestamp=2026-09-03T07:13:49.142Z level=INFO run=eca2a69f message=evaluated permission=bash pattern="python -c \"\nfrom dynaconf import Dynaconf\nimport tempfile\nimport os\n\n# Test: file with top-level variables (outside sections)\nconfig_content = '''\n# Top level variables (outside any section)\ntop_level = \\\"top_value\\\"\n\n[production]\nvalue_prod = \\\"prod_value\\\"\n'''\n\nwith tempfile.NamedTemporaryFile(mode='w', suffix='.toml', delete=False) as f:\n    f.write(config_content)\n    config_file = f.name\n\ntry:\n    print('=== Test: env=False loads all sections ===')\n    settings = Dynaconf(environments=True, ENVIRONMENTS_FOR_DYNACONF=True)\n    settings.load_file(config_file, env=False)\n    \n    print(f'top_level: {settings.get(\\\"top_level\\\")}')\n    print(f'PRODUCTION (should have value_prod): {settings.get(\\\"PRODUCTION\\\")}')\n    print(f'production (lowercase): {settings.get(\\\"production\\\")}')\n    \n    print()\n    print('=== All loaded keys ===')\n    for k in sorted(settings.keys()):\n        if not k.startswith('_') and 'production' in k.lower():\n            print(f'  {k} = {settings.get(k)}')\nfinally:\n    os.unlink(config_file)\n\"" action.permission=* action.action=allow action.pattern=*
