{"type":"tool_use","timestamp":1788419578384,"sessionID":"ses_f99e39b61ffeVhyL6wKpvNfEvS","part":{"type":"tool","tool":"read","callID":"call_987aa72a388740da83470138","state":{"status":"completed","input":{"filePath":"/testbed/dynaconf/loaders/base.py"},"output":"<path>/testbed/dynaconf/loaders/base.py</path>\n<type>file</type>\n<content>\n1: from __future__ import annotations\n2: \n3: import warnings\n4: from typing import NamedTuple\n5: \n6: from dynaconf.utils import build_env_list\n7: from dynaconf.utils import ensure_a_list\n8: from dynaconf.utils import upperfy\n9: from dynaconf.utils.functional import empty\n10: \n11: \n12: class BaseLoader:\n13:     \"\"\"Base loader for dynaconf source files.\n14: \n15:     :param obj: {[LazySettings]} -- [Dynaconf settings]\n16:     :param env: {[string]} -- [the current env to be loaded defaults to\n17:       [development]]\n18:     :param identifier: {[string]} -- [identifier ini, yaml, json, py, toml]\n19:     :param extensions: {[list]} -- [List of extensions with dots ['.a', '.b']]\n20:     :param file_reader: {[callable]} -- [reads file return dict]\n21:     :param string_reader: {[callable]} -- [reads string return dict]\n22:     \"\"\"\n23: \n24:     def __init__(\n25:         self,\n26:         obj,\n27:         env,\n28:         identifier,\n29:         extensions,\n30:         file_reader,\n31:         string_reader,\n32:         opener_params=None,\n33:         validate=False,\n34:     ):\n35:         \"\"\"Instantiates a loader for different sources\"\"\"\n36:         self.obj = obj\n37:         self.env = env or obj.current_env\n38:         self.identifier = identifier\n39:         self.extensions = extensions\n40:         self.file_reader = file_reader\n41:         self.string_reader = string_reader\n42:         self.opener_params = opener_params or {\n43:             \"mode\": \"r\",\n44:             \"encoding\": obj.get(\"ENCODING_FOR_DYNACONF\", \"utf-8\"),\n45:         }\n46:         self.validate = validate\n47: \n48:     @staticmethod\n49:     def warn_not_installed(obj, identifier):  # pragma: no cover\n50:         if identifier not in obj._not_installed_warnings:\n51:             warnings.warn(\n52:                 f\"{identifier} support is not installed in your environment. \"\n53:                 f\"`pip install dynaconf[{identifier}]`\"\n54:             )\n55:         obj._not_installed_warnings.append(identifier)\n56: \n57:     def load(self, filename=None, key=None, silent=True, merge=empty):\n58:         \"\"\"\n59:         Reads and loads in to `self.obj` a single key or all keys from source\n60: \n61:         :param filename: Optional filename to load\n62:         :param key: if provided load a single key\n63:         :param silent: if load errors should be silenced\n64:         \"\"\"\n65: \n66:         filename = filename or self.obj.get(self.identifier.upper())\n67:         if not filename:\n68:             return\n69: \n70:         if not isinstance(filename, (list, tuple)):\n71:             split_files = ensure_a_list(filename)\n72:             if all([f.endswith(self.extensions) for f in split_files]):  # noqa\n73:                 files = split_files  # it is a ['file.ext', ...]\n74:             else:  # it is a single config as string\n75:                 files = [filename]\n76:         else:  # it is already a list/tuple\n77:             files = filename\n78: \n79:         source_data = self.get_source_data(files)\n80: \n81:         if self.obj.get(\"ENVIRONMENTS_FOR_DYNACONF\") is False:\n82:             self._envless_load(source_data, silent, key)\n83:         else:\n84:             self._load_all_envs(source_data, silent, key)\n85: \n86:     def get_source_data(self, files):\n87:         \"\"\"Reads each file and returns source data for each file\n88:         {\"path/to/file.ext\": {\"key\": \"value\"}}\n89:         \"\"\"\n90:         data = {}\n91:         for source_file in files:\n92:             if source_file.endswith(self.extensions):\n93:                 try:\n94:                     with open(source_file, **self.opener_params) as open_file:\n95:                         content = self.file_reader(open_file)\n96:                         self.obj._loaded_files.append(source_file)\n97:                         if content:\n98:                             data[source_file] = content\n99:                 except OSError as e:\n100:                     if \".local.\" not in source_file:\n101:                         warnings.warn(\n102:                             f\"{self.identifier}_loader: {source_file} \"\n103:                             f\":{str(e)}\"\n104:                         )\n105:             else:\n106:                 # for tests it is possible to pass string\n107:                 content = self.string_reader(source_file)\n108:                 if content:\n109:                     data[source_file] = content\n110:         return data\n111: \n112:     def _envless_load(self, source_data, silent=True, key=None):\n113:         \"\"\"Load all the keys from each file without env separation\"\"\"\n114:         for file_name, file_data in source_data.items():\n115:             # is there a `dynaconf_merge` on top level of file?\n116:             file_merge = file_data.get(\"dynaconf_merge\", empty)\n117: \n118:             # set source metadata\n119:             source_metadata = SourceMetadata(\n120:                 self.identifier, file_name, \"default\"\n121:             )\n122: \n123:             self._set_data_to_obj(\n124:                 file_data,\n125:                 source_metadata,\n126:                 file_merge=file_merge,\n127:                 key=key,\n128:             )\n129: \n130:     def _load_all_envs(self, source_data, silent=True, key=None):\n131:         \"\"\"\n132:         Load configs from files separating by each environment\n133:         source_data should have format:\n134:             {\n135:                 \"path/to/src\": {\n136:                     \"env\": {...},\n137:                     \"env2\": {...}\n138:                 }\n139:             }\n140:         \"\"\"\n141:         for file_name, file_data in source_data.items():\n142:             # env name is checked in lower\n143:             file_data = {k.lower(): value for k, value in file_data.items()}\n144: \n145:             # is there a `dynaconf_merge` on top level of file?\n146:             file_merge = file_data.get(\"dynaconf_merge\", empty)\n147: \n148:             # is there a flag disabling dotted lookup on file?\n149:             file_dotted_lookup = file_data.get(\"dynaconf_dotted_lookup\")\n150: \n151:             for env in build_env_list(self.obj, self.env):\n152:                 env = env.lower()  # lower for better comparison\n153:                 # print(self.env, file_data)\n154: \n155:                 # set source metadata\n156:                 source_metadata = SourceMetadata(\n157:                     self.identifier, file_name, env\n158:                 )\n159: \n160:                 try:\n161:                     data = file_data[env] or {}\n162:                 except KeyError:\n163:                     if silent:\n164:                         continue\n165:                     raise\n166: \n167:                 if not data:\n168:                     continue\n169: \n170:                 self._set_data_to_obj(\n171:                     data,\n172:                     source_metadata,\n173:                     file_merge,\n174:                     key,\n175:                     file_dotted_lookup=file_dotted_lookup,\n176:                 )\n177: \n178:     def _set_data_to_obj(\n179:         self,\n180:         data,\n181:         identifier: SourceMetadata,\n182:         file_merge=empty,\n183:         key=False,\n184:         file_dotted_lookup=None,\n185:     ):\n186:         \"\"\"Calls settings.set to add the keys\"\"\"\n187:         # data 1st level keys should be transformed to upper case.\n188:         data = {upperfy(k): v for k, v in data.items()}\n189:         if key:\n190:             key = upperfy(key)\n191: \n192:         if self.obj.filter_strategy:\n193:             data = self.obj.filter_strategy(data)\n194: \n195:         # is there a `dynaconf_merge` inside an `[env]`?\n196:         env_scope_merge = data.pop(\"DYNACONF_MERGE\", None)\n197:         if env_scope_merge is not None:\n198:             file_merge = env_scope_merge\n199: \n200:         # If not passed or passed as None,\n201:         # look for inner [env] value, or default settings.\n202:         if file_dotted_lookup is None:\n203:             file_dotted_lookup = data.pop(\n204:                 \"DYNACONF_DOTTED_LOOKUP\",\n205:                 self.obj.get(\"DOTTED_LOOKUP_FOR_DYNACONF\"),\n206:             )\n207: \n208:         if not key:\n209:             self.obj.update(\n210:                 data,\n211:                 loader_identifier=identifier,\n212:                 merge=file_merge,\n213:                 dotted_lookup=file_dotted_lookup,\n214:                 validate=self.validate,\n215:             )\n216:         elif key in data:\n217:             self.obj.set(\n218:                 key,\n219:                 data.get(key),\n220:                 loader_identifier=identifier,\n221:                 merge=file_merge,\n222:                 dotted_lookup=file_dotted_lookup,\n223:                 validate=self.validate,\n224:             )\n225: \n226: \n227: class SourceMetadata(NamedTuple):\n228:     \"\"\"\n229:     Useful metadata about some loaded source (file, envvar, etc).\n230: \n231:     Serve as a unique identifier for data from a specific env\n232:     and a specific source (file, envvar, validationd default, etc)\n233: \n234:     Examples:\n235:         SourceMetadata(loader=\"envvar\", identifier=\"os\", env=\"global\")\n236:         SourceMetadata(loader=\"yaml\", identifier=\"path/to/file.yml\", env=\"dev\")\n237:     \"\"\"\n238: \n239:     loader: str\n240:     identifier: str\n241:     env: str = \"global\"\n242:     merged: bool = False\n\n(End of file - total 242 lines)\n</content>","metadata":{"preview":"from __future__ import annotations\n\nimport warnings\nfrom typing import NamedTuple\n\nfrom dynaconf.utils import build_env_list\nfrom dynaconf.utils import ensure_a_list\nfrom dynaconf.utils import upperfy\nfrom dynaconf.utils.functional import empty\n\n\nclass BaseLoader:\n    \"\"\"Base loader for dynaconf source files.\n\n    :param obj: {[LazySettings]} -- [Dynaconf settings]\n    :param env: {[string]} -- [the current env to be loaded defaults to\n      [development]]\n    :param identifier: {[string]} -- [identifier ini, yaml, json, py, toml]\n    :param extensions: {[list]} -- [List of extensions with dots ['.a', '.b']]\n    :param file_reader: {[callable]} -- [reads file return dict]","truncated":false,"loaded":[],"display":{"type":"file","path":"/testbed/dynaconf/loaders/base.py","text":"from __future__ import annotations\n\nimport warnings\nfrom typing import NamedTuple\n\nfrom dynaconf.utils import build_env_list\nfrom dynaconf.utils import ensure_a_list\nfrom dynaconf.utils import upperfy\nfrom dynaconf.utils.functional import empty\n\n\nclass BaseLoader:\n    \"\"\"Base loader for dynaconf source files.\n\n    :param obj: {[LazySettings]} -- [Dynaconf settings]\n    :param env: {[string]} -- [the current env to be loaded defaults to\n      [development]]\n    :param identifier: {[string]} -- [identifier ini, yaml, json, py, toml]\n    :param extensions: {[list]} -- [List of extensions with dots ['.a', '.b']]\n    :param file_reader: {[callable]} -- [reads file return dict]\n    :param string_reader: {[callable]} -- [reads string return dict]\n    \"\"\"\n\n    def __init__(\n        self,\n        obj,\n        env,\n        identifier,\n        extensions,\n        file_reader,\n        string_reader,\n        opener_params=None,\n        validate=False,\n    ):\n        \"\"\"Instantiates a loader for different sources\"\"\"\n        self.obj = obj\n        self.env = env or obj.current_env\n        self.identifier = identifier\n        self.extensions = extensions\n        self.file_reader = file_reader\n        self.string_reader = string_reader\n        self.opener_params = opener_params or {\n            \"mode\": \"r\",\n            \"encoding\": obj.get(\"ENCODING_FOR_DYNACONF\", \"utf-8\"),\n        }\n        self.validate = validate\n\n    @staticmethod\n    def warn_not_installed(obj, identifier):  # pragma: no cover\n        if identifier not in obj._not_installed_warnings:\n            warnings.warn(\n                f\"{identifier} support is not installed in your environment. \"\n                f\"`pip install dynaconf[{identifier}]`\"\n            )\n        obj._not_installed_warnings.append(identifier)\n\n    def load(self, filename=None, key=None, silent=True, merge=empty):\n        \"\"\"\n        Reads and loads in to `self.obj` a single key or all keys from source\n\n        :param filename: Optional filename to load\n        :param key: if provided load a single key\n        :param silent: if load errors should be silenced\n        \"\"\"\n\n        filename = filename or self.obj.get(self.identifier.upper())\n        if not filename:\n            return\n\n        if not isinstance(filename, (list, tuple)):\n            split_files = ensure_a_list(filename)\n            if all([f.endswith(self.extensions) for f in split_files]):  # noqa\n                files = split_files  # it is a ['file.ext', ...]\n            else:  # it is a single config as string\n                files = [filename]\n        else:  # it is already a list/tuple\n            files = filename\n\n        source_data = self.get_source_data(files)\n\n        if self.obj.get(\"ENVIRONMENTS_FOR_DYNACONF\") is False:\n            self._envless_load(source_data, silent, key)\n        else:\n            self._load_all_envs(source_data, silent, key)\n\n    def get_source_data(self, files):\n        \"\"\"Reads each file and returns source data for each file\n        {\"path/to/file.ext\": {\"key\": \"value\"}}\n        \"\"\"\n        data = {}\n        for source_file in files:\n            if source_file.endswith(self.extensions):\n                try:\n                    with open(source_file, **self.opener_params) as open_file:\n                        content = self.file_reader(open_file)\n                        self.obj._loaded_files.append(source_file)\n                        if content:\n                            data[source_file] = content\n                except OSError as e:\n                    if \".local.\" not in source_file:\n                        warnings.warn(\n                            f\"{self.identifier}_loader: {source_file} \"\n                            f\":{str(e)}\"\n                        )\n            else:\n                # for tests it is possible to pass string\n                content = self.string_reader(source_file)\n                if content:\n                    data[source_file] = content\n        return data\n\n    def _envless_load(self, source_data, silent=True, key=None):\n        \"\"\"Load all the keys from each file without env separation\"\"\"\n        for file_name, file_data in source_data.items():\n            # is there a `dynaconf_merge` on top level of file?\n            file_merge = file_data.get(\"dynaconf_merge\", empty)\n\n            # set source metadata\n            source_metadata = SourceMetadata(\n                self.identifier, file_name, \"default\"\n            )\n\n            self._set_data_to_obj(\n                file_data,\n                source_metadata,\n                file_merge=file_merge,\n                key=key,\n            )\n\n    def _load_all_envs(self, source_data, silent=True, key=None):\n        \"\"\"\n        Load configs from files separating by each environment\n        source_data should have format:\n            {\n                \"path/to/src\": {\n                    \"env\": {...},\n                    \"env2\": {...}\n                }\n            }\n        \"\"\"\n        for file_name, file_data in source_data.items():\n            # env name is checked in lower\n            file_data = {k.lower(): value for k, value in file_data.items()}\n\n            # is there a `dynaconf_merge` on top level of file?\n            file_merge = file_data.get(\"dynaconf_merge\", empty)\n\n            # is there a flag disabling dotted lookup on file?\n            file_dotted_lookup = file_data.get(\"dynaconf_dotted_lookup\")\n\n            for env in build_env_list(self.obj, self.env):\n                env = env.lower()  # lower for better comparison\n                # print(self.env, file_data)\n\n                # set source metadata\n                source_metadata = SourceMetadata(\n                    self.identifier, file_name, env\n                )\n\n                try:\n                    data = file_data[env] or {}\n                except KeyError:\n                    if silent:\n                        continue\n                    raise\n\n                if not data:\n                    continue\n\n                self._set_data_to_obj(\n                    data,\n                    source_metadata,\n                    file_merge,\n                    key,\n                    file_dotted_lookup=file_dotted_lookup,\n                )\n\n    def _set_data_to_obj(\n        self,\n        data,\n        identifier: SourceMetadata,\n        file_merge=empty,\n        key=False,\n        file_dotted_lookup=None,\n    ):\n        \"\"\"Calls settings.set to add the keys\"\"\"\n        # data 1st level keys should be transformed to upper case.\n        data = {upperfy(k): v for k, v in data.items()}\n        if key:\n            key = upperfy(key)\n\n        if self.obj.filter_strategy:\n            data = self.obj.filter_strategy(data)\n\n        # is there a `dynaconf_merge` inside an `[env]`?\n        env_scope_merge = data.pop(\"DYNACONF_MERGE\", None)\n        if env_scope_merge is not None:\n            file_merge = env_scope_merge\n\n        # If not passed or passed as None,\n        # look for inner [env] value, or default settings.\n        if file_dotted_lookup is None:\n            file_dotted_lookup = data.pop(\n                \"DYNACONF_DOTTED_LOOKUP\",\n                self.obj.get(\"DOTTED_LOOKUP_FOR_DYNACONF\"),\n            )\n\n        if not key:\n            self.obj.update(\n                data,\n                loader_identifier=identifier,\n                merge=file_merge,\n                dotted_lookup=file_dotted_lookup,\n                validate=self.validate,\n            )\n        elif key in data:\n            self.obj.set(\n                key,\n                data.get(key),\n                loader_identifier=identifier,\n                merge=file_merge,\n                dotted_lookup=file_dotted_lookup,\n                validate=self.validate,\n            )\n\n\nclass SourceMetadata(NamedTuple):\n    \"\"\"\n    Useful metadata about some loaded source (file, envvar, etc).\n\n    Serve as a unique identifier for data from a specific env\n    and a specific source (file, envvar, validationd default, etc)\n\n    Examples:\n        SourceMetadata(loader=\"envvar\", identifier=\"os\", env=\"global\")\n        SourceMetadata(loader=\"yaml\", identifier=\"path/to/file.yml\", env=\"dev\")\n    \"\"\"\n\n    loader: str\n    identifier: str\n    env: str = \"global\"\n    merged: bool = False","lineStart":1,"lineEnd":242,"totalLines":242,"truncated":false}},"title":"dynaconf/loaders/base.py","time":{"start":1788419578347,"end":1788419578380}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_0661d19da001VBZdZQ6xJykDrL","sessionID":"ses_f99e39b61ffeVhyL6wKpvNfEvS","messageID":"msg_0661d15cf001eEIboTxxWxy1CY"}}
