timestamp=2026-09-03T07:13:42.445Z level=INFO run=eca2a69f message=evaluated permission=bash pattern="python -c \"\nfrom dynaconf import Dynaconf\nfrom dynaconf.loaders.base import BaseLoader\nfrom dynaconf.utils.functional import empty\nimport tempfile\nimport os\n\n# Monkey patch _envless_load to see if it's being called\noriginal_envless_load = BaseLoader._envless_load\ndef patched_envless_load(self, source_data, silent=True, key=None):\n    print(f'_envless_load called with source_data keys: {list(source_data.keys())}')\n    return original_envless_load(self, source_data, silent, key)\n\nBaseLoader._envless_load = patched_envless_load\n\n# Monkey patch _load_all_envs to see if it's being called\noriginal_load_all_envs = BaseLoader._load_all_envs\ndef patched_load_all_envs(self, source_data, silent=True, key=None):\n    print(f'_load_all_envs called with source_data keys: {list(source_data.keys())}')\n    return original_load_all_envs(self, source_data, silent, key)\n\nBaseLoader._load_all_envs = patched_load_all_envs\n\n# Create a test config file with environment sections\nconfig_content = '''\n[default]\nvalue_default = \\\"default_value\\\"\n\n[development]\nvalue_dev = \\\"dev_value\\\"\n\n[production]\nvalue_prod = \\\"prod_value\\\"\n\n# Top level variables\ntop_level = \\\"top_value\\\"\n'''\n\nwith tempfile.NamedTemporaryFile(mode='w', suffix='.toml', delete=False) as f:\n    f.write(config_content)\n    config_file = f.name\n\ntry:\n    print('=== Test: env=False should call _envless_load ===')\n    settings = Dynaconf(environments=True, ENVIRONMENTS_FOR_DYNACONF=True)\n    settings.load_file(config_file, env=False)\nfinally:\n    os.unlink(config_file)\n\"" action.permission=* action.action=allow action.pattern=*
