timestamp=2026-09-03T07:13:13.602Z level=INFO run=eca2a69f message=evaluated permission=bash pattern="python -c \"\nfrom dynaconf import Dynaconf\nimport tempfile\nimport os\n\n# Create a test config file with environment sections\nconfig_content = '''\n[default]\nvalue_default = \\\"default_value\\\"\n\n[development]\nvalue_dev = \\\"dev_value\\\"\n\n[production]\nvalue_prod = \\\"prod_value\\\"\n\n# Top level variables\ntop_level = \\\"top_value\\\"\n'''\n\nwith tempfile.NamedTemporaryFile(mode='w', suffix='.toml', delete=False) as f:\n    f.write(config_content)\n    config_file = f.name\n\ntry:\n    # Test with env=False\n    settings = Dynaconf(environments=True, ENVIRONMENTS_FOR_DYNACONF=True)\n    settings.load_file(config_file, env=False)\n    \n    print('=== Testing env=False (env-agnostic loading) ===')\n    print(f'top_level = {settings.get(\\\"top_level\\\")}')\n    print(f'value_default = {settings.get(\\\"value_default\\\")}')\n    print(f'value_dev = {settings.get(\\\"value_dev\\\")}')\n    print(f'value_prod = {settings.get(\\\"value_prod\\\")}')\n    \n    print()\n    print('=== All keys in settings (should include top level and all env vars) ===')\n    keys = [k for k in settings.keys() if not k.startswith('_')]\n    for key in sorted(keys):\n        print(f'  {key} = {settings.get(key)}')\n    \n    print()\n    print('SUCCESS: env=False loads all top-level variables')\nfinally:\n    os.unlink(config_file)\n\"" action.permission=* action.action=allow action.pattern=*
