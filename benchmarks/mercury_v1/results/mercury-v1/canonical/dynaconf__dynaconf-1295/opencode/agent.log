timestamp=2026-09-03T07:13:50.804Z level=INFO run=eca2a69f message=evaluated permission=bash pattern="python -c \"\nfrom dynaconf import Dynaconf\nimport tempfile\nimport os\n\n# Test: file with different env sections\nconfig_content = '''\n[default]\ndb_host = \\\"default_host\\\"\n\n[development]\ndb_host = \\\"dev_host\\\"\ndebug = true\n\n[production]\ndb_host = \\\"prod_host\\\"\ndebug = false\n'''\n\nwith tempfile.NamedTemporaryFile(mode='w', suffix='.toml', delete=False) as f:\n    f.write(config_content)\n    config_file = f.name\n\ntry:\n    print('=== Test 1: Without env=False (env-aware loading) ===')\n    settings1 = Dynaconf(environments=True, ENVIRONMENTS_FOR_DYNACONF=True)\n    settings1.load_file(config_file)  # Default env=DEVELOPMENT\n    \n    print(f'db_host (should be dev_host): {settings1.get(\\\"db_host\\\")}')\n    print(f'debug (should be true): {settings1.get(\\\"debug\\\")}')\n    \n    print()\n    print('=== Test 2: With env=False (env-agnostic loading) ===')\n    settings2 = Dynaconf(environments=True, ENVIRONMENTS_FOR_DYNACONF=True)\n    settings2.load_file(config_file, env=False)  # Load all sections\n    \n    print(f'db_host (should be default_host): {settings2.get(\\\"db_host\\\")}')\n    print(f'debug (should be None/first section): {settings2.get(\\\"debug\\\")}')\n    print(f'DEVELOPMENT.db_host: {settings2.get(\\\"DEVELOPMENT.db_host\\\")}')\n    print(f'PRODUCTION.db_host: {settings2.get(\\\"PRODUCTION.db_host\\\")}')\n    \n    print()\n    print('SUCCESS: env=False loads all sections without environment filtering')\nfinally:\n    os.unlink(config_file)\n\"" action.permission=* action.action=allow action.pattern=*
