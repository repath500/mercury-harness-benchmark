@@ -20,10 +20,10 @@ class Network(DiscreteSpace):
         """A Networked grid.
 
         Args:
-            G: a NetworkX Graph instance.
-            capacity (int) : the capacity of the cell
-            random (Random): a random number generator
-            cell_klass (type[Cell]): The base Cell class to use in the Network
+            G: a NetworkX graph instance.
+            capacity: the capacity of the cell
+            random: a random number generator
+            cell_klass: The base Cell class to use in the Network
 
         """
         super().__init__(capacity=capacity, random=random, cell_klass=cell_klass)
@@ -37,6 +37,19 @@ class Network(DiscreteSpace):
         for cell in self.all_cells:
             self._connect_single_cell(cell)
 
-    def _connect_single_cell(self, cell):
-        for node_id in self.G.neighbors(cell.coordinate):
-            cell.connect(self._cells[node_id])
+    def _connect_single_cell(self, cell: Cell) -> None:
+        """Connect cell to its neighbors in the network.
+
+        For network spaces, the connection key is the node identifier
+        of the connected cell, making network navigation explicit.
+
+        Args:
+            cell: the cell to connect
+
+        """
+        # cell.coordinate is stored as a tuple, but node IDs are single values
+        # So we need to extract the original node ID from the tuple
+        node_id = cell.coordinate[0]
+        for neighbor_id in self.G.neighbors(node_id):
+            # Use neighbor_id as the connection key for explicit network navigation
+            cell.connect(self._cells[neighbor_id], neighbor_id)
