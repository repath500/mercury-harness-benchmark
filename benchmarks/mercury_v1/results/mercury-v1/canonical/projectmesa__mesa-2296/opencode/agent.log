{"type":"tool_use","timestamp":1788420987485,"sessionID":"ses_f99cd7ab0ffe6L6oTfhwdJt7eq","part":{"type":"tool","tool":"read","callID":"call_b27ac027a13c4307a1b7927e","state":{"status":"completed","input":{"filePath":"/testbed/tests/test_cell_space.py"},"output":"<path>/testbed/tests/test_cell_space.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Test cell spaces.\"\"\"\n2: \n3: import random\n4: \n5: import pytest\n6: \n7: from mesa import Model\n8: from mesa.experimental.cell_space import (\n9:     Cell,\n10:     CellAgent,\n11:     CellCollection,\n12:     HexGrid,\n13:     Network,\n14:     OrthogonalMooreGrid,\n15:     OrthogonalVonNeumannGrid,\n16:     VoronoiGrid,\n17: )\n18: \n19: \n20: def test_orthogonal_grid_neumann():\n21:     \"\"\"Test orthogonal grid with von Neumann neighborhood.\"\"\"\n22:     width = 10\n23:     height = 10\n24:     grid = OrthogonalVonNeumannGrid((width, height), torus=False, capacity=None)\n25: \n26:     assert len(grid._cells) == width * height\n27: \n28:     # von neumann neighborhood, torus false, top left corner\n29:     assert len(grid._cells[(0, 0)]._connections) == 2\n30:     for connection in grid._cells[(0, 0)]._connections:\n31:         assert connection.coordinate in {(0, 1), (1, 0)}\n32: \n33:     # von neumann neighborhood, torus false, top right corner\n34:     for connection in grid._cells[(0, width - 1)]._connections:\n35:         assert connection.coordinate in {(0, width - 2), (1, width - 1)}\n36: \n37:     # von neumann neighborhood, torus false, bottom left corner\n38:     for connection in grid._cells[(height - 1, 0)]._connections:\n39:         assert connection.coordinate in {(height - 1, 1), (height - 2, 0)}\n40: \n41:     # von neumann neighborhood, torus false, bottom right corner\n42:     for connection in grid._cells[(height - 1, width - 1)]._connections:\n43:         assert connection.coordinate in {\n44:             (height - 1, width - 2),\n45:             (height - 2, width - 1),\n46:         }\n47: \n48:     # von neumann neighborhood middle of grid\n49:     assert len(grid._cells[(5, 5)]._connections) == 4\n50:     for connection in grid._cells[(5, 5)]._connections:\n51:         assert connection.coordinate in {(4, 5), (5, 4), (5, 6), (6, 5)}\n52: \n53:     # von neumann neighborhood, torus True, top corner\n54:     grid = OrthogonalVonNeumannGrid((width, height), torus=True, capacity=None)\n55:     assert len(grid._cells[(0, 0)]._connections) == 4\n56:     for connection in grid._cells[(0, 0)]._connections:\n57:         assert connection.coordinate in {(0, 1), (1, 0), (0, 9), (9, 0)}\n58: \n59:     # von neumann neighborhood, torus True, top right corner\n60:     for connection in grid._cells[(0, width - 1)]._connections:\n61:         assert connection.coordinate in {(0, 8), (0, 0), (1, 9), (9, 9)}\n62: \n63:     # von neumann neighborhood, torus True, bottom left corner\n64:     for connection in grid._cells[(9, 0)]._connections:\n65:         assert connection.coordinate in {(9, 1), (9, 9), (0, 0), (8, 0)}\n66: \n67:     # von neumann neighborhood, torus True, bottom right corner\n68:     for connection in grid._cells[(9, 9)]._connections:\n69:         assert connection.coordinate in {(9, 0), (9, 8), (8, 9), (0, 9)}\n70: \n71: \n72: def test_orthogonal_grid_neumann_3d():\n73:     \"\"\"Test 3D orthogonal grid with von Neumann neighborhood.\"\"\"\n74:     width = 10\n75:     height = 10\n76:     depth = 10\n77:     grid = OrthogonalVonNeumannGrid((width, height, depth), torus=False, capacity=None)\n78: \n79:     assert len(grid._cells) == width * height * depth\n80: \n81:     # von neumann neighborhood, torus false, top left corner\n82:     assert len(grid._cells[(0, 0, 0)]._connections) == 3\n83:     for connection in grid._cells[(0, 0, 0)]._connections:\n84:         assert connection.coordinate in {(0, 0, 1), (0, 1, 0), (1, 0, 0)}\n85: \n86:     # von neumann neighborhood, torus false, top right corner\n87:     for connection in grid._cells[(0, width - 1, 0)]._connections:\n88:         assert connection.coordinate in {\n89:             (0, width - 1, 1),\n90:             (0, width - 2, 0),\n91:             (1, width - 1, 0),\n92:         }\n93: \n94:     # von neumann neighborhood, torus false, bottom left corner\n95:     for connection in grid._cells[(height - 1, 0, 0)]._connections:\n96:         assert connection.coordinate in {\n97:             (height - 1, 0, 1),\n98:             (height - 1, 1, 0),\n99:             (height - 2, 0, 0),\n100:         }\n101: \n102:     # von neumann neighborhood, torus false, bottom right corner\n103:     for connection in grid._cells[(height - 1, width - 1, 0)]._connections:\n104:         assert connection.coordinate in {\n105:             (height - 1, width - 1, 1),\n106:             (height - 1, width - 2, 0),\n107:             (height - 2, width - 1, 0),\n108:         }\n109: \n110:     # von neumann neighborhood middle of grid\n111:     assert len(grid._cells[(5, 5, 5)]._connections) == 6\n112:     for connection in grid._cells[(5, 5, 5)]._connections:\n113:         assert connection.coordinate in {\n114:             (4, 5, 5),\n115:             (5, 4, 5),\n116:             (5, 5, 4),\n117:             (5, 5, 6),\n118:             (5, 6, 5),\n119:             (6, 5, 5),\n120:         }\n121: \n122:     # von neumann neighborhood, torus True, top corner\n123:     grid = OrthogonalVonNeumannGrid((width, height, depth), torus=True, capacity=None)\n124:     assert len(grid._cells[(0, 0, 0)]._connections) == 6\n125:     for connection in grid._cells[(0, 0, 0)]._connections:\n126:         assert connection.coordinate in {\n127:             (0, 0, 1),\n128:             (0, 1, 0),\n129:             (1, 0, 0),\n130:             (0, 0, 9),\n131:             (0, 9, 0),\n132:             (9, 0, 0),\n133:         }\n134: \n135: \n136: def test_orthogonal_grid_moore():\n137:     \"\"\"Test orthogonal grid with Moore neighborhood.\"\"\"\n138:     width = 10\n139:     height = 10\n140: \n