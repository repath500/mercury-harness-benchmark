\n=== Network Example ===\nCell at 0 connections:\n  1 -> 1\n  2 -> 2\n\n=== Custom Key Example ===\nCell1 connections:\n  east -> (1, 0)\n  north -> (0, 1)\n\n=== Disconnect Example ===\nAfter disconnecting cell2:\n  north -> (0, 1)\ncell2 in connections: False\n\n=== All tests passed! ===\n","metadata":{"output":"=== Grid Example ===\nCell at (2, 2) connections:\n  (-1, -1) -> (1, 1)\n  (-1, 0) -> (1, 2)\n  (-1, 1) -> (1, 3)\n  (0, -1) -> (2, 1)\n  (0, 1) -> (2, 3)\n  (1, -1) -> (3, 1)\n  (1, 0) -> (3, 2)\n  (1, 1) -> (3, 3)\n\n=== Network Example ===\nCell at 0 connections:\n  1 -> 1\n  2 -> 2\n\n=== Custom Key Example ===\nCell1 connections:\n  east -> (1, 0)\n  north -> (0, 1)\n\n=== Disconnect Example ===\nAfter disconnecting cell2:\n  north -> (0, 1)\ncell2 in connections: False\n\n=== All tests passed! ===\n","exit":0,"truncated":false},"title":"cd /testbed && python << 'EOF'\nfrom mesa.experimental.cell_space import OrthogonalMooreGrid, Network, Cell\nimport networkx as nx\n\n# Test Grid - connection keys are coordinate differences\nprint(\"=== Grid Example ===\")\ngrid = OrthogonalMooreGrid((5, 5), torus=False)\ncell = grid._cells[(2, 2)]\nprint(f\"Cell at {cell.coordinate} connections:\")\nfor key, connected_cell in cell.connections.items():\n    print(f\"  {key} -> {connected_cell.coordinate}\")\n\n# Test Network - connection keys are node names\nprint(\"\\n=== Network Example ===\")\nG = nx.Graph()\nG.add_edges_from([(0, 1), (0, 2), (1, 3), (2, 3)])\nnet = Network(G)\ncell = net._cells[0]\nprint(f\"Cell at {cell.coordinate} connections:\")\nfor key, connected_cell in cell.connections.items():\n    print(f\"  {key} -> {connected_cell.coordinate}\")\n\n# Test custom key\nprint(\"\\n=== Custom Key Example ===\")\ncell1 = Cell((0, 0))\ncell2 = Cell((1, 0))\ncell3 = Cell((0, 1))\ncell1.connect(cell2, key=\"east\")\ncell1.connect(cell3, key=\"north\")\nprint(f\"Cell1 connections:\")\nfor key, connected_cell in cell1.connections.items():\n    print(f\"  {key} 