+    def test_check_issuer_with_list_of_issuers(self, jwt):
+        issuers = ["urn:foo", "urn:bar"]
+        payload = {"some": "payload", "iss": "urn:foo"}
+        token = jwt.encode(payload, "secret")
+        jwt.decode(token, "secret", issuer=issuers, algorithms=["HS256"])
+
+    def test_check_issuer_with_list_of_issuers_second_match(self, jwt):
+        issuers = ["urn:foo", "urn:bar"]
+        payload = {"some": "payload", "iss": "urn:bar"}
+        token = jwt.encode(payload, "secret")
+        jwt.decode(token, "secret", issuer=issuers, algorithms=["HS256"])
+
+    def test_raise_exception_invalid_issuer_with_list(self, jwt):
+        issuers = ["urn:foo", "urn:bar"]
+        payload = {"some": "payload", "iss": "urn:baz"}
+        token = jwt.encode(payload, "secret")
+
+        with pytest.raises(InvalidIssuerError):
+            jwt.decode(token, "secret", issuer=issuers, algorithms=["HS256"])
+
+    def test_raise_exception_token_without_issuer_with_list(self, jwt):
+        issuers = ["urn:foo", "urn:bar"]
+        payload = {"some": "payload"}
+        token = jwt.encode(payload, "secret")
+
+        with pytest.raises(MissingRequiredClaimError) as exc:
+            jwt.decode(token, "secret", issuer=issuers, algorithms=["HS256"])
+
+        assert exc.value.claim == "iss"
 
