{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c95bb034f6d4433983aaff5b","type":"tool_result","content":"1\tfrom datetime import datetime\n2\tfrom typing import Iterator\n3\t\n4\timport pytest\n5\t\n6\tfrom starlette import convertors\n7\tfrom starlette.convertors import Convertor, register_url_convertor\n8\tfrom starlette.requests import Request\n9\tfrom starlette.responses import JSONResponse\n10\tfrom starlette.routing import Route, Router\n11\tfrom tests.types import TestClientFactory\n12\t\n13\t\n14\t@pytest.fixture(scope=\"module\", autouse=True)\n15\tdef refresh_convertor_types() -> Iterator[None]:\n16\t    convert_types = convertors.CONVERTOR_TYPES.copy()\n17\t    yield\n18\t    convertors.CONVERTOR_TYPES = convert_types\n19\t\n20\t\n21\tclass DateTimeConvertor(Convertor[datetime]):\n22\t    regex = \"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(.[0-9]+)?\"\n23\t\n24\t    def convert(self, value: str) -> datetime:\n25\t        return datetime.strptime(value, \"%Y-%m-%dT%H:%M:%S\")\n26\t\n27\t    def to_string(self, value: datetime) -> str:\n28\t        return value.strftime(\"%Y-%m-%dT%H:%M:%S\")\n29\t\n30\t\n31\t@pytest.fixture(scope=\"function\")\n32\tdef app() -> Router:\n33\t    register_url_convertor(\"datetime\", DateTimeConvertor())\n34\t\n35\t    def datetime_convertor(request: Request) -> JSONResponse:\n36\t        param = request.path_params[\"param\"]\n37\t        assert isinstance(param, datetime)\n38\t        return JSONResponse({\"datetime\": param.strftime(\"%Y-%m-%dT%H:%M:%S\")})\n39\t\n40\t    return Router(\n41\t        routes=[\n42\t            Route(\n43\t                \"/datetime/{param:datetime}\",\n44\t                endpoint=datetime_convertor,\n45\t                name=\"datetime-convertor\",\n46\t            )\n47\t        ]\n48\t    )\n49\t\n50\t\n51\tdef test_datetime_convertor(test_client_factory: TestClientFactory, app: Router) -> None:\n52\t    client = test_client_factory(app)\n53\t    response = client.get(\"/datetime/2020-01-01T00:00:00\")\n54\t    assert response.json() == {\"datetime\": \"2020-01-01T00:00:00\"}\n55\t\n56\t    assert (\n57\t        app.url_path_for(\"datetime-convertor\", param=datetime(1996, 1, 22, 23, 0, 0)) == \"/datetime/1996-01-22T23:00:00\"\n58\t    )\n59\t\n60\t\n61\t@pytest.mark.parametrize(\"param, status_code\", [(\"1.0\", 200), (\"1-0\", 404)])\n62\tdef test_default_float_convertor(test_client_factory: TestClientFactory, param: str, status_code: int) -> None:\n63\t    def float_convertor(request: Request) -> JSONResponse:\n64\t        param = request.path_params[\"param\"]\n65\t        assert isinstance(param, float)\n66\t        return JSONResponse({\"float\": param})\n67\t\n68\t    app = Router(routes=[Route(\"/{param:float}\", endpoint=float_convertor)])\n69\t\n70\t    client = test_client_factory(app)\n71\t    response = client.get(f\"/{param}\")\n72\t    assert response.status_code == status_code\n73\t"}]},"parent_tool_use_id":null,"session_id":"5e8d3a93-aeeb-4449-bbe4-d0ac3e467d60","uuid":"49fb1c1f-4bef-41b3-805d-10f42f5b4a51","timestamp":"2026-09-03T06:34:23.496Z","tool_use_result":{"type":"text","file":{"filePath":"/testbed/tests/test_convertors.py","content":"from datetime import datetime\nfrom typing import Iterator\n\nimport pytest\n\nfrom starlette import convertors\nfrom starlette.convertors import Convertor, register_url_convertor\nfrom starlette.requests import Request\nfrom starlette.responses import JSONResponse\nfrom starlette.routing import Route, Router\nfrom tests.types import TestClientFactory\n\n\n@pytest.fixture(scope=\"module\", autouse=True)\ndef refresh_convertor_types() -> Iterator[None]:\n    convert_types = convertors.CONVERTOR_TYPES.copy()\n    yield\n    convertors.CONVERTOR_TYPES = convert_types\n\n\nclass DateTimeConvertor(Convertor[datetime]):\n    regex = \"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(.[0-9]+)?\"\n\n    def convert(self, value: str) -> datetime:\n        return datetime.strptime(value, \"%Y-%m-%dT%H:%M:%S\")\n\n    def to_string(self, value: datetime) -> str:\n        return value.strftime(\"%Y-%m-%dT%H:%M:%S\")\n\n\n@pytest.fixture(scope=\"function\")\ndef app() -> Router:\n    register_url_convertor(\"datetime\", DateTimeConvertor())\n\n    def datetime_convertor(request: Request) -> JSONResponse:\n        param = request.path_params[\"param\"]\n        assert isinstance(param, datetime)\n        return JSONResponse({\"datetime\": param.strftime(\"%Y-%m-%dT%H:%M:%S\")})\n\n    return Router(\n        routes=[\n            Route(\n                \"/datetime/{param:datetime}\",\n                endpoint=datetime_convertor,\n                name=\"datetime-convertor\",\n            )\n        ]\n    )\n\n\ndef test_datetime_convertor(test_client_factory: TestClientFactory, app: Router) -> None:\n    client = test_client_factory(app)\n    response = client.get(\"/datetime/2020-01-01T00:00:00\")\n    assert response.json() == {\"datetime\": \"2020-01-01T00:00:00\"}\n\n    assert (\n        app.url_path_for(\"datetime-convertor\", param=datetime(1996, 1, 22, 23, 0, 0)) == \"/datetime/1996-01-22T23:00:00\"\n    )\n\n\n@pytest.mark.parametrize(\"param, status_code\", [(\"1.0\", 200), (\"1-0\", 404)])\ndef test_default_float_convertor(test_client_factory: TestClientFactory, param: str, status_code: int) -> None:\n    def float_convertor(request: Request) -> JSONResponse:\n        param = request.path_params[\"param\"]\n        assert isinstance(param, float)\n        return JSONResponse({\"float\": param})\n\n    app = Router(routes=[Route(\"/{param:float}\", endpoint=float_convertor)])\n\n    client = test_client_factory(app)\n    response = client.get(f\"/{param}\")\n    assert response.status_code == status_code\n","numLines":73,"startLine":1,"totalLines":73}}}
