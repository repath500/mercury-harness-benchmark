--- a/starlette/convertors.py
+++ b/starlette/convertors.py
@@ -67,10 +67,13 @@ class FloatConvertor(Convertor[float]):
 
 
 class UUIDConvertor(Convertor[uuid.UUID]):
-    regex = "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
+    # Match UUID with hyphens (36 chars) or without hyphens (32 chars), case insensitive
+    regex = "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{32}"
 
     def convert(self, value: str) -> uuid.UUID:
-        return uuid.UUID(value)
+        # Normalize UUID string: remove hyphens and convert to lowercase
+        normalized = value.replace("-", "").lower()
+        return uuid.UUID(normalized)
 
     def to_string(self, value: uuid.UUID) -> str:
         return str(value)
