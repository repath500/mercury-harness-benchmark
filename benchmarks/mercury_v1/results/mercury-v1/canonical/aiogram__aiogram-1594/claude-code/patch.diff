             "foo": "bar",
             "baz": "test",
         }
+
+    async def test_get_value(self, storage: BaseStorage, storage_key: StorageKey):
+        # Test getting existing value
+        await storage.set_data(key=storage_key, data={"foo": "bar", "baz": "qux"})
+        assert await storage.get_value(key=storage_key, field="foo") == "bar"
+        assert await storage.get_value(key=storage_key, field="baz") == "qux"
+
+        # Test getting non-existent value with default
+        assert await storage.get_value(key=storage_key, field="nonexistent") is None
+        assert await storage.get_value(key=storage_key, field="nonexistent", default="default") == "default"
+
+        # Test getting non-existent value without default (explicit None)
+        assert await storage.get_value(key=storage_key, field="nonexistent", default=None) is None
+
+    async def test_get_value_isolation(self, storage: BaseStorage, storage_key: StorageKey):
+        # Test that get_value does not allow mutation to affect stored data
+        await storage.set_data(key=storage_key, data={"foo": "bar"})
+        value = await storage.get_value(key=storage_key, field="foo")
+        # Modifying the returned value should not affect stored data
+        if isinstance(value, dict):
+            value["modified"] = True
+            assert await storage.get_value(key=storage_key, field="foo") == "bar"
