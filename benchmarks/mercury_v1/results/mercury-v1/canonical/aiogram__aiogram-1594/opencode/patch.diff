+    async def test_get_value(self, bot: MockedBot):
+        storage = MemoryStorage()
+        key = StorageKey(user_id=42, chat_id=-42, bot_id=bot.id)
+        ctx = FSMContext(storage=storage, key=key)
+        
+        await ctx.set_data({"foo": "bar", "count": 10})
+        
+        assert await ctx.get_value("foo") == "bar"
+        assert await ctx.get_value("count") == 10
+        assert await ctx.get_value("nonexistent") is None
+        assert await ctx.get_value("nonexistent", "default") == "default"
+
+    async def test_get_value_isolation(self, bot: MockedBot):
+        storage = MemoryStorage()
+        key = StorageKey(user_id=42, chat_id=-42, bot_id=bot.id)
+        ctx = FSMContext(storage=storage, key=key)
+        
+        await ctx.set_data({"foo": "bar"})
+        value = await ctx.get_value("foo")
+        
+        assert value == "bar"
+        assert value is not ctx.storage.storage[key].data
