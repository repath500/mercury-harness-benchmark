{"type":"tool_use","timestamp":1788422203967,"sessionID":"ses_f99bb14eaffeLRyeOsPWdJgTt0","part":{"type":"tool","tool":"read","callID":"call_425a3abc0b514e1d92bb4b61","state":{"status":"completed","input":{"filePath":"/testbed/tests/test_fsm/test_context.py"},"output":"<path>/testbed/tests/test_fsm/test_context.py</path>\n<type>file</type>\n<content>\n1: import pytest\n2: \n3: from aiogram.fsm.context import FSMContext\n4: from aiogram.fsm.storage.base import StorageKey\n5: from aiogram.fsm.storage.memory import MemoryStorage\n6: from tests.mocked_bot import MockedBot\n7: \n8: \n9: @pytest.fixture()\n10: def state(bot: MockedBot):\n11:     storage = MemoryStorage()\n12:     key = StorageKey(user_id=42, chat_id=-42, bot_id=bot.id)\n13:     ctx = storage.storage[key]\n14:     ctx.state = \"test\"\n15:     ctx.data = {\"foo\": \"bar\"}\n16:     return FSMContext(storage=storage, key=key)\n17: \n18: \n19: class TestFSMContext:\n20:     async def test_address_mapping(self, bot: MockedBot):\n21:         storage = MemoryStorage()\n22:         ctx = storage.storage[StorageKey(chat_id=-42, user_id=42, bot_id=bot.id)]\n23:         ctx.state = \"test\"\n24:         ctx.data = {\"foo\": \"bar\"}\n25:         state = FSMContext(storage=storage, key=StorageKey(chat_id=-42, user_id=42, bot_id=bot.id))\n26:         state2 = FSMContext(storage=storage, key=StorageKey(chat_id=42, user_id=42, bot_id=bot.id))\n27:         state3 = FSMContext(storage=storage, key=StorageKey(chat_id=69, user_id=69, bot_id=bot.id))\n28: \n29:         assert await state.get_state() == \"test\"\n30:         assert await state2.get_state() is None\n31:         assert await state3.get_state() is None\n32: \n33:         assert await state.get_data() == {\"foo\": \"bar\"}\n34:         assert await state2.get_data() == {}\n35:         assert await state3.get_data() == {}\n36: \n37:         await state2.set_state(\"experiments\")\n38:         assert await state.get_state() == \"test\"\n39:         assert await state3.get_state() is None\n40: \n41:         await state3.set_data({\"key\": \"value\"})\n42:         assert await state2.get_data() == {}\n43: \n44:         await state.update_data({\"key\": \"value\"})\n45:         assert await state.get_data() == {\"foo\": \"bar\", \"key\": \"value\"}\n46: \n47:         await state.clear()\n48:         assert await state.get_state() is None\n49:         assert await state.get_data() == {}\n50: \n51:         assert await state2.get_state() == \"experiments\"\n\n(End of file - total 51 lines)\n</content>","metadata":{"preview":"import pytest\n\nfrom aiogram.fsm.context import FSMContext\nfrom aiogram.fsm.storage.base import StorageKey\nfrom aiogram.fsm.storage.memory import MemoryStorage\nfrom tests.mocked_bot import MockedBot\n\n\n@pytest.fixture()\ndef state(bot: MockedBot):\n    storage = MemoryStorage()\n    key = StorageKey(user_id=42, chat_id=-42, bot_id=bot.id)\n    ctx = storage.storage[key]\n    ctx.state = \"test\"\n    ctx.data = {\"foo\": \"bar\"}\n    return FSMContext(storage=storage, key=key)\n\n\nclass TestFSMContext:\n    async def test_address_mapping(self, bot: MockedBot):","truncated":false,"loaded":[],"display":{"type":"file","path":"/testbed/tests/test_fsm/test_context.py","text":"import pytest\n\nfrom aiogram.fsm.context import FSMContext\nfrom aiogram.fsm.storage.base import StorageKey\nfrom aiogram.fsm.storage.memory import MemoryStorage\nfrom tests.mocked_bot import MockedBot\n\n\n@pytest.fixture()\ndef state(bot: MockedBot):\n    storage = MemoryStorage()\n    key = StorageKey(user_id=42, chat_id=-42, bot_id=bot.id)\n    ctx = storage.storage[key]\n    ctx.state = \"test\"\n    ctx.data = {\"foo\": \"bar\"}\n    return FSMContext(storage=storage, key=key)\n\n\nclass TestFSMContext:\n    async def test_address_mapping(self, bot: MockedBot):\n        storage = MemoryStorage()\n        ctx = storage.storage[StorageKey(chat_id=-42, user_id=42, bot_id=bot.id)]\n        ctx.state = \"test\"\n        ctx.data = {\"foo\": \"bar\"}\n        state = FSMContext(storage=storage, key=StorageKey(chat_id=-42, user_id=42, bot_id=bot.id))\n        state2 = FSMContext(storage=storage, key=StorageKey(chat_id=42, user_id=42, bot_id=bot.id))\n        state3 = FSMContext(storage=storage, key=StorageKey(chat_id=69, user_id=69, bot_id=bot.id))\n\n        assert await state.get_state() == \"test\"\n        assert await state2.get_state() is None\n        assert await state3.get_state() is None\n\n        assert await state.get_data() == {\"foo\": \"bar\"}\n        assert await state2.get_data() == {}\n        assert await state3.get_data() == {}\n\n        await state2.set_state(\"experiments\")\n        assert await state.get_state() == \"test\"\n        assert await state3.get_state() is None\n\n        await state3.set_data({\"key\": \"value\"})\n        assert await state2.get_data() == {}\n\n        await state.update_data({\"key\": \"value\"})\n        assert await state.get_data() == {\"foo\": \"bar\", \"key\": \"value\"}\n\n        await state.clear()\n        assert await state.get_state() is None\n        assert await state.get_data() == {}\n\n        assert await state2.get_state() == \"experiments\"","lineStart":1,"lineEnd":51,"totalLines":51,"truncated":false}},"title":"tests/test_fsm/test_context.py","time":{"start":1788422203950,"end":1788422203963}},"id":"prt_066452a09001vztTUhUGYIUgIC","sessionID":"ses_f99bb14eaffeLRyeOsPWdJgTt0","messageID":"msg_066452701001pH05kMlZ530T8W"}}
{"type":"tool_use","timestamp":1788422204018,"sessionID":"ses_f99bb14eaffeLRyeOsPWdJgTt0","part":{"type":"tool","tool":"read","callID":"call_56a9b5c983da464d9101211c","state":{"status":"completed","input":{"filePath":"/testbed/tests/test_fsm/test_scene.py"},"output":"<path>/testbed/tests/test_fsm/test_scene.py</path>\n<type>file</type>\n<content>\n1: import inspect\n2: from datetime import datetime\n3: from unittest.mock import ANY, AsyncMock, patch\n4: \n5: import pytest\n6: \n7: from aiogram import Dispatcher, F, Router\n8: from aiogram.dispatcher.event.bases import NextMiddlewareType\n9: from aiogram.enums import UpdateType\n10: from aiogram.exceptions import SceneException\n11: from aiogram.filters import Command, StateFilter\n12: from aiogram.fsm.context import FSMContext\n13: from aiogram.fsm.scene import (\n14:     ActionContainer,\n15:     After,\n16:     HandlerContainer,\n17:     HistoryManager,\n18:     ObserverDecorator,\n19:     ObserverMarker,\n20:     Scene,\n21:     SceneAction,\n22:     SceneConfig,\n23:     SceneHandlerWrapper,\n24:     SceneRegistry,\n25:     ScenesManager,\n26:     SceneWizard,\n27:     _empty_handler,\n28:     on,\n29: )\n30: from aiogram.fsm.state import State, StatesGroup\n31: from aiogram.fsm.storage.base import StorageKey\n32: from aiogram.fsm.storage.memory import MemoryStorage, MemoryStorageRecord\n33: from aiogram.types import Chat, Message, Update\n34: from tests.mocked_bot import MockedBot\n35: \n36: \n37: class TestOnMarker:\n38:     @pytest.mark.parametrize(\n39:         \"marker_name\",\n40:         [\n41:             \"message\",\n42:             \"edited_message\",\n43:             \"channel_post\",\n44:             \"edited_channel_post\",\n45:             \"inline_query\",\n46:             \"chosen_inline_result\",\n47:             \"callback_query\",\n48:             \"shipping_query\",\n49:             \"pre_checkout_query\",\n50:             \"poll\",\n51:             \"poll_answer\",\n52:             \"my_chat_member\",\n53:             \"chat_member\",\n54:             \"chat_join_request\",\n55:         ],\n56:     )\n57:     def test_marker_name(self, marker_name: str):\n58:         attr = getattr(on, marker_name)\n59:         assert isinstance(attr, ObserverMarker)\n60:         assert attr.name == marker_name\n61: \n62: \n63: async def test_empty_handler():\n64:     result = await _empty_handler()\n65:     assert result is None\n66: \n67: \n68: class TestAfter:\n69:     def test_exit(self):\n70:         after = After.exit()\n71:         assert after is not None\n72:         assert after.action == SceneAction.exit\n73:         assert after.scene is None\n74: \n75:     def test_back(self):\n76:         after = After.back()\n77:         assert after is not None\n78:         assert after.action == SceneAction.back\n79:         assert after.scene is None\n80: \n81:     def test_goto(self):\n82:         after = After.goto(\"test\")\n83:         assert after is not None\n84:         assert after.action == SceneAction.enter\n85:         assert after.scene == \"test\"\n86: \n87: \n88: class TestObserverMarker:\n89:     def test_decorator(self):\n90:         marker = ObserverMarker(\"test\")\n91:         decorator = marker(F.test, after=After.back())\n92:         assert isinstance(decorator, ObserverDecorator)\n93:         assert decorator.name == \"test\"\n94:         assert len(decorator.filters) == 1\n95:         assert decorator.action is None\n96:         assert decorator.after is not None\n97: \n98:     def test_enter(self):\n99:         marker = ObserverMarker(\"test\")\n100:         decorator = marker.enter(F.test)\n101:         assert isinstance(decorator, ObserverDecorator)\n102:         assert decorator.name == \"test\"\n103:         assert len(decorator.filters) == 1\n104:         assert decorator.action == SceneAction.enter\n105:         assert decorator.after is None\n106: \n107:     def test_leave(self):\n108:         marker = ObserverMarker(\"test\")\n109:         decorator = marker.leave()\n110:         assert isinstance(decorator, ObserverDecorator)\n111:         assert decorator.name == \"test\"\n112:         assert len(decorator.filters) == 0\n113:         assert decorator.action == SceneAction.leave\n114:         assert decorator.after is None\n115: \n116:     def test_exit(self):\n117:         marker = ObserverMarker(\"test\")\n118:         decorator = marker.exit()\n119:         assert isinstance(decorator, ObserverDecorator)\n120:         assert decorator.name == \"test\"\n121:         assert len(decorator.filters) == 0\n122:         assert decorator.action == SceneAction.exit\n123:         assert decorator.after is None\n124: \n125:     def test_back(self):\n126:         marker = ObserverMarker(\"test\")\n127:         decorator = marker.back()\n128:         assert isinstance(decorator, ObserverDecorator)\n129:         assert decorator.name == \"test\"\n130:         assert len(decorator.filters) == 0\n131:         assert decorator.action == SceneAction.back\n132:         assert decorator.after is None\n133: \n134: \n135: class TestObserverDecorator:\n136:     def test_wrap_something(self):\n137:         decorator = ObserverDecorator(\"test\", F.test)\n138: \n139:         with pytest.raises(TypeError):\n140:             decorator(\"test\")\n141: \n142:     def test_wrap_handler(self):\n143:         decorator = ObserverDecorator(\"test\", F.test)\n144: \n145:         def handler():\n146:             pass\n147: \n148:         wrapped = decorator(handler)\n149: \n150:         assert wrapped is not None\n151:         assert hasattr(wrapped, \"__aiogram_handler__\")\n152:         assert isinstance(wrapped.__aiogram_handler__, list)\n153:         assert len(wrapped.__aiogram_handler__) == 1\n154: \n155:         wrapped2 = decorator(handler)\n156: \n157:         assert len(wrapped2.__aiogram_handler__) == 2\n158: \n159:     def test_wrap_action(self):\n160:         decorator = ObserverDecorator(\"test\", F.test, action=SceneAction.enter)\n161: \n162:         def handler():\n163:             pass\n164: \n165:         wrapped = decorator(handler)\n166:         assert wrapped is not None\n167:         assert not hasattr(wrapped, \"__aiogram_handler__\")\n168:         assert hasattr(wrapped, \"__aiogram_action__\")\n169: \n170:         assert isinstance(wrapped.__aiogram_action__, dict)\n171:         assert len(wrapped.__aiogram_action__) == 1\n172:         assert SceneAction.enter in wrapped.__aiogram_action__\n173:         assert \"test\" in wrapped.__aiogram_action__[SceneAction.enter]\n174: \n175:     def test_observer_decorator_leave(self):\n176:         observer_decorator = ObserverDecorator(\"Test Name\", (F.text,))\n177:         action_container = observer_decorator.leave()\n178:         assert isinstance(action_container, ActionContainer)\n179:         assert action_container.name == \"Test Name\"\n180:         assert action_container.filters == (F.text,)\n181:         assert action_container.action == SceneAction.leave\n182: \n183:     def test_observer_decorator_enter(self):\n184:         observer_decorator = ObserverDecorator(\"test\", (F.text,))\n185:         target = \"mock_target\"\n186:         action_container = observer_decorator.enter(target)\n187:         assert isinstance(action_container, ActionContainer)\n188:         assert action_container.name == \"test\"\n189:         assert action_container.filters == (F.text,)\n190:         assert action_container.action == SceneAction.enter\n191:         assert action_container.target == target\n192: \n193:     def test_observer_decorator_exit(self):\n194:         observer_decorator = ObserverDecorator(\"test\", (F.text,))\n195:         action_container = observer_decorator.exit()\n196:         assert isinstance(action_container, ActionContainer)\n197:         assert action_container.name == \"test\"\n198:         assert action_container.filters == (F.text,)\n199:         assert action_container.action == SceneAction.exit\n200: \n201:     def test_observer_decorator_back(self):\n202:         observer_decorator = ObserverDecorator(\"test\", (F.text,))\n203:         action_container = observer_decorator.back()\n204:         assert isinstance(action_container, ActionContainer)\n205:         assert action_container.name == \"test\"\n206:         assert action_container.filters == (F.text,)\n207:         assert action_container.action == SceneAction.back\n208: \n209: \n210: class TestActionContainer:\n211:     async def test_action_container_execute_enter(self):\n212:         wizard_mock = AsyncMock(spec=SceneWizard)\n213: \n214:         action_container = ActionContainer(\n215:             \"Test Name\", (F.text,), SceneAction.enter, \"Test Target\"\n216:         )\n217:         await action_container.execute(wizard_mock)\n218: \n219:         wizard_mock.goto.assert_called_once_with(\"Test Target\")\n220: \n221:     async def test_action_container_execute_leave(self):\n222:         wizard_mock = AsyncMock(spec=SceneWizard)\n223: \n224:         action_container = ActionContainer(\"Test Name\", (F.text,), SceneAction.leave)\n225:         await action_container.execute(wizard_mock)\n226: \n227:         wizard_mock.leave.assert_called_once()\n228: \n229:     async def test_action_container_execute_exit(self):\n230:         wizard_mock = AsyncMock(spec=SceneWizard)\n231: \n232:         action_container = ActionContainer(\"Test Name\", (F.text,), SceneAction.exit)\n233:         await action_container.execute(wizard_mock)\n234: \n235:         wizard_mock.exit.assert_called_once()\n236: \n237:     async def test_action_container_execute_back(self):\n238:         wizard_mock = AsyncMock(spec=SceneWizard)\n239: \n240:         action_container = ActionContainer(\"Test Name\", (F.text,), SceneAction.back)\n241:         await action_container.execute(wizard_mock)\n242: \n243:         wizard_mock.back.assert_called_once()\n244: \n245: \n246: class TestSceneHandlerWrapper:\n247:     async def test_scene_handler_wrapper_call(self):\n248:         class MyScene(Scene):\n249:             pass\n250: \n251:         async def handler_mock(*args, **kwargs):\n252:             return 42\n253: \n254:         state_mock = AsyncMock(spec=FSMContext)\n255:         scenes_mock = AsyncMock(spec=ScenesManager)\n256:         event_update_mock = Update(\n257:             update_id=42,\n258:             message=Message(\n259:                 message_id=42,\n260:                 text=\"test\",\n261:                 date=datetime.now(),\n262:                 chat=Chat(\n263:                     type=\"private\",\n264:                     id=42,\n265:                 ),\n266:             ),\n267:         )\n268:         kwargs = {\"state\": state_mock, \"scenes\": scenes_mock, \"event_update\": event_update_mock}\n269: \n270:         scene_handler_wrapper = SceneHandlerWrapper(MyScene, handler_mock)\n271:         result = await scene_handler_wrapper(event_update_mock, **kwargs)\n272: \n273:         # Check whether result is correct\n274:         assert result == 42\n275: \n276:     async def test_scene_handler_wrapper_call_with_after(self):\n277:         class MyScene(Scene):\n278:             pass\n279: \n280:         async def handler_mock(*args, **kwargs):\n281:             return 42\n282: \n283:         state_mock = AsyncMock(spec=FSMContext)\n284:         scenes_mock = AsyncMock(spec=ScenesManager)\n285:         event_update_mock = Update(\n286:             update_id=42,\n287:             message=Message(\n288:                 message_id=42,\n289:                 text=\"test\",\n290:                 date=datetime.now(),\n291:                 chat=Chat(\n292:                     type=\"private\",\n293:                     id=42,\n294:                 ),\n295:             ),\n296:         )\n297:         kwargs = {\"state\": state_mock, \"scenes\": scenes_mock, \"event_update\": event_update_mock}\n298: \n299:         scene_handler_wrapper = SceneHandlerWrapper(MyScene, handler_mock, after=After.exit())\n300: \n301:         with patch(\n302:             \"aiogram.fsm.scene.ActionContainer.execute\", new_callable=AsyncMock\n303:         ) as after_mock:\n304:             result = await scene_handler_wrapper(event_update_mock, **kwargs)\n305: \n306:             # Check whether after_mock is called\n307:             after_mock.assert_called_once_with(ANY)\n308: \n309:             # Check whether result is correct\n310:             assert result == 42\n311: \n312:     def test_scene_handler_wrapper_str(self):\n313:         class MyScene(Scene):\n314:             pass\n315: \n316:         async def handler_mock(*args, **kwargs):\n317:             pass\n318: \n319:         after = After.back()\n320: \n321:         scene_handler_wrapper = SceneHandlerWrapper(MyScene, handler_mock, after=after)\n322:         result = str(scene_handler_wrapper)\n323: \n324:         assert result == f\"SceneHandlerWrapper({MyScene}, {handler_mock}, after={after})\"\n325: \n326:     def test_await(self):\n327:         class MyScene(Scene):\n328:             pass\n329: \n330:         async def handler_mock(*args, **kwargs):\n331:             pass\n332: \n333:         scene_handler_wrapper = SceneHandlerWrapper(MyScene, handler_mock)\n334: \n335:         assert inspect.isawaitable(scene_handler_wrapper)\n336: \n337:         assert hasattr(scene_handler_wrapper, \"__await__\")\n338:         assert scene_handler_wrapper.__await__() is scene_handler_wrapper\n339: \n340: \n341: class TestHistoryManager:\n342:     async def test_history_manager_push(self):\n343:         state = FSMContext(\n344:             storage=MemoryStorage(), key=StorageKey(bot_id=42, chat_id=-42, user_id=42)\n345:         )\n346:         history_manager = HistoryManager(state=state)\n347: \n348:         data = {\"test_data\": \"test_data\"}\n349:         await history_manager.push(\"test_state\", data)\n350: \n351:         history_data = await history_manager._history_state.get_data()\n352:         assert history_data.get(\"history\") == [{\"state\": \"test_state\", \"data\": data}]\n353: \n354:     async def test_history_manager_push_if_history_overflow(self):\n355:         state = FSMContext(\n356:             storage=MemoryStorage(), key=StorageKey(bot_id=42, chat_id=-42, user_id=42)\n357:         )\n358:         history_manager = HistoryManager(state=state, size=2)\n359: \n360:         states = [\"test_state\", \"test_state2\", \"test_state3\", \"test_state4\"]\n361:         data = {\"test_data\": \"test_data\"}\n362:         for state in states:\n363:             await history_manager.push(state, data)\n364: \n365:         history_data = await history_manager._history_state.get_data()\n366:         assert history_data.get(\"history\") == [\n367:             {\"state\": \"test_state3\", \"data\": data},\n368:             {\"state\": \"test_state4\", \"data\": data},\n369:         ]\n370: \n371:     async def test_history_manager_pop(self):\n372:         state = FSMContext(\n373:             storage=MemoryStorage(), key=StorageKey(bot_id=42, chat_id=-42, user_id=42)\n374:         )\n375:         history_manager = HistoryManager(state=state)\n376: \n377:         data = {\"test_data\": \"test_data\"}\n378:         await history_manager.push(\"test_state\", data)\n379:         await history_manager.push(\"test_state2\", data)\n380: \n381:         record = await history_manager.pop()\n382:         history_data = await history_manager._history_state.get_data()\n383: \n384:         assert isinstance(record, MemoryStorageRecord)\n385:         assert record == MemoryStorageRecord(state=\"test_state2\", data=data)\n386:         assert history_data.get(\"history\") == [{\"state\": \"test_state\", \"data\": data}]\n387: \n388:     async def test_history_manager_pop_if_history_empty(self):\n389:         state = FSMContext(\n390:             storage=MemoryStorage(), key=StorageKey(bot_id=42, chat_id=-42, user_id=42)\n391:         )\n392:         history_manager = HistoryManager(state=state)\n393: \n394:         record = await history_manager.pop()\n395:         assert record is None\n396: \n397:     async def test_history_manager_pop_if_history_become_empty_after_pop(self):\n398:         state = FSMContext(\n399:             storage=MemoryStorage(), key=StorageKey(bot_id=42, chat_id=-42, user_id=42)\n400:         )\n401:         history_manager = HistoryManager(state=state)\n402: \n403:         data = {\"test_data\": \"test_data\"}\n404:         await history_manager.push(\"test_state\", data)\n405: \n406:         await history_manager.pop()\n407: \n408:         assert await history_manager._history_state.get_data() == {}\n409: \n410:     async def test_history_manager_get(self):\n411:         state = FSMContext(\n412:             storage=MemoryStorage(), key=StorageKey(bot_id=42, chat_id=-42, user_id=42)\n413:         )\n414:         history_manager = HistoryManager(state=state)\n415: \n416:         data = {\"test_data\": \"test_data\"}\n417:         await history_manager.push(\"test_state\", data)\n418: \n419:         record = await history_manager.get()\n420: \n421:         assert isinstance(record, MemoryStorageRecord)\n422:         assert record == MemoryStorageRecord(state=\"test_state\", data=data)\n423: \n424:     async def test_history_manager_get_if_history_empty(self):\n425:         state = FSMContext(\n426:             storage=MemoryStorage(), key=StorageKey(bot_id=42, chat_id=-42, user_id=42)\n427:         )\n428:         history_manager = HistoryManager(state=state)\n429: \n430:         record = await history_manager.get()\n431:         assert record is None\n432: \n433:     async def test_history_manager_all(self):\n434:         state = FSMContext(\n435:             storage=MemoryStorage(), key=StorageKey(bot_id=42, chat_id=-42, user_id=42)\n436:         )\n437:         history_manager_size = 10\n438:         history_manager = HistoryManager(state=state, size=history_manager_size)\n439: \n440:         data = {\"test_data\": \"test_data\"}\n441:         for i in range(history_manager_size):\n442:             await history_manager.push(f\"test_state{i}\", data)\n443: \n444:         records = await history_manager.all()\n445: \n446:         assert isinstance(records, list)\n447:         assert len(records) == history_manager_size\n448:         assert all(isinstance(record, MemoryStorageRecord) for record in records)\n449: \n450:     async def test_history_manager_all_if_history_empty(self):\n451:         state = FSMContext(\n452:             storage=MemoryStorage(), key=StorageKey(bot_id=42, chat_id=-42, user_id=42)\n453:         )\n454:         history_manager = HistoryManager(state=state)\n455: \n456:         records = await history_manager.all()\n457:         assert records == []\n458: \n459:     async def test_history_manager_clear(self):\n460:         state = FSMContext(\n461:             storage=MemoryStorage(), key=StorageKey(bot_id=42, chat_id=-42, user_id=42)\n462:         )\n463: \n464:         history_manager = HistoryManager(state=state)\n465:         data = {\"test_data\": \"test_data\"}\n466:         await history_manager.push(\"test_state\", data)\n467: \n468:         await history_manager.clear()\n469: \n470:         assert await history_manager._history_state.get_data() == {}\n471: \n472:     async def test_history_manager_snapshot(self):\n473:         state = FSMContext(\n474:             storage=MemoryStorage(), key=StorageKey(bot_id=42, chat_id=-42, user_id=42)\n475:         )\n476: \n477:         history_manager = HistoryManager(state=state)\n478:         data = {\"test_data\": \"test_data\"}\n479:         await history_manager.push(\"test_state\", data)\n480: \n481:         await history_manager.snapshot()\n482: \n483:         assert await history_manager._history_state.get_data() == {\n484:             \"history\": [\n485:                 {\"state\": \"test_state\", \"data\": data},\n486:                 {\n487:                     \"state\": await history_manager._state.get_state(),\n488:                     \"data\": await history_manager._state.get_data(),\n489:                 },\n490:             ]\n491:         }\n492: \n493:     async def test_history_manager_set_state(self):\n494:         state_mock = AsyncMock(spec=FSMContext)\n495:         state_mock.storage = MemoryStorage()\n496:         state_mock.key = StorageKey(bot_id=42, chat_id=-42, user_id=42)\n497:         state_mock.set_state = AsyncMock()\n498:         state_mock.set_data = AsyncMock()\n499: \n500:         history_manager = HistoryManager(state=state_mock)\n501:         history_manager._state = state_mock\n502: \n503:         state = \"test_state\"\n504:         data = {\"test_data\": \"test_data\"}\n505:         await history_manager._set_state(state, data)\n506: \n507:         state_mock.set_state.assert_called_once_with(state)\n508:         state_mock.set_data.assert_called_once_with(data)\n509: \n510:     async def test_history_manager_rollback(self):\n511:         history_manager = HistoryManager(\n512:             state=FSMContext(\n513:                 storage=MemoryStorage(), key=StorageKey(bot_id=42, chat_id=-42, user_id=42)\n514:             )\n515:         )\n516: \n517:         data = {\"test_data\": \"test_data\"}\n518:         await history_manager.push(\"test_state\", data)\n519:         await history_manager.push(\"test_state2\", data)\n520: \n521:         record = await history_manager.get()\n522:         assert record == MemoryStorageRecord(state=\"test_state2\", data=data)\n523: \n524:         await history_manager.rollback()\n525: \n526:         record = await history_manager.get()\n527:         assert record == MemoryStorageRecord(state=\"test_state\", data=data)\n528: \n529:     async def test_history_manager_rollback_if_not_previous_state(self):\n530:         history_manager = HistoryManager(\n531:             state=FSMContext(\n532:                 storage=MemoryStorage(), key=StorageKey(bot_id=42, chat_id=-42, user_id=42)\n533:             )\n534:         )\n535: \n536:         data = {\"test_data\": \"test_data\"}\n537:         await history_manager.push(\"test_state\", data)\n538: \n539:         state = await history_manager.rollback()\n540:         assert state == \"test_state\"\n541: \n542:         state = await history_manager.rollback()\n543:         assert state is None\n544: \n545: \n546: class TestScene:\n547:     def test_scene_subclass_initialisation(self):\n548:         class ParentScene(Scene):\n549:             @on.message(F.text)\n550:             def parent_handler(self, *args, **kwargs):\n551:                 pass\n552: \n553:             @on.message.enter(F.text)\n554:             def parent_action(self, *args, **kwargs):\n555:                 pass\n556: \n557:         class SubScene(\n558:             ParentScene,\n559:             state=\"sub_state\",\n560:             reset_data_on_enter=True,\n561:             reset_history_on_enter=True,\n562:             callback_query_without_state=True,\n563:         ):\n564:             general_handler = on.message(\n565:                 F.text.casefold() == \"test\", after=After.goto(\"sub_state\")\n566:             )\n567: \n568:             @on.message(F.text)\n569:             def sub_handler(self, *args, **kwargs):\n570:                 pass\n571: \n572:             @on.message.exit()\n573:             def sub_action(self, *args, **kwargs):\n574:                 pass\n575: \n576:         # Assert __scene_config__ attributes are correctly set for SubScene\n577:         assert isinstance(SubScene.__scene_config__, SceneConfig)\n578:         assert SubScene.__scene_config__.state == \"sub_state\"\n579:         assert SubScene.__scene_config__.reset_data_on_enter is True\n580:         assert SubScene.__scene_config__.reset_history_on_enter is True\n581:         assert SubScene.__scene_config__.callback_query_without_state is True\n582: \n583:         # Assert handlers are correctly set\n584:         assert len(SubScene.__scene_config__.handlers) == 3\n585: \n586:         for handler in SubScene.__scene_config__.handlers:\n587:             assert isinstance(handler, HandlerContainer)\n588:             assert handler.name == \"message\"\n589:             assert handler.handler in (\n590:                 ParentScene.parent_handler,\n591:                 SubScene.sub_handler,\n592:                 _empty_handler,\n593:             )\n594:             assert handler.filters == (F.text,)\n595: \n596:         # Assert actions are correctly set\n597:         assert len(SubScene.__scene_config__.actions) == 2\n598: \n599:         enter_action = SubScene.__scene_config__.actions[SceneAction.enter]\n600:         assert isinstance(enter_action, dict)\n601:         assert \"message\" in enter_action\n602:         assert enter_action[\"message\"].callback == ParentScene.parent_action\n603: \n604:         exit_action = SubScene.__scene_config__.actions[SceneAction.exit]\n605:         assert isinstance(exit_action, dict)\n606:         assert \"message\" in exit_action\n607:         assert exit_action[\"message\"].callback == SubScene.sub_action\n608: \n609:     def test_scene_subclass_initialisation_bases_is_scene_subclass(self):\n610:         class NotAScene:\n611:             pass\n612: \n613:         class MyScene(Scene, NotAScene):\n614:             pass\n615: \n616:         class TestClass(MyScene, NotAScene):\n617:             pass\n618: \n619:         assert MyScene in TestClass.__bases__\n620:         assert NotAScene in TestClass.__bases__\n621:         bases = [base for base in TestClass.__bases__ if not issubclass(base, Scene)]\n622:         assert Scene not in bases\n623:         assert NotAScene in bases\n624: \n625:     def test_scene_add_to_router(self):\n626:         class MyScene(Scene):\n627:             @on.message(F.text)\n628:             def test_handler(self, *args, **kwargs):\n629:                 pass\n630: \n631:         router = Router()\n632:         MyScene.add_to_router(router)\n633: \n634:         assert len(router.observers[\"message\"].handlers) == 1\n635: \n636:     def test_scene_add_to_router_scene_with_callback_query_without_state(self):\n637:         class MyScene(Scene, callback_query_without_state=True):\n638:             @on.callback_query(F.data)\n639:             def test_handler(self, *args, **kwargs):\n640:                 pass\n641: \n642:         router = Router()\n643:         MyScene.add_to_router(router)\n644: \n645:         assert len(router.observers[\"callback_query\"].handlers) == 1\n646:         assert (\n647:             StateFilter(MyScene.__scene_config__.state)\n648:             not in router.observers[\"callback_query\"].handlers[0].filters\n649:         )\n650: \n651:     def test_scene_as_handler(self):\n652:         class MyScene(Scene):\n653:             @on.message(F.text)\n654:             def test_handler(self, *args, **kwargs):\n655:                 pass\n656: \n657:         handler = MyScene.as_handler()\n658: \n659:         router = Router()\n660:         router.message.register(handler)\n661:         assert router.observers[\"message\"].handlers[0].callback == handler\n662: \n663:     async def test_scene_as_handler_enter(self):\n664:         class MyScene(Scene):\n665:             @on.message.enter(F.text)\n666:             def test_handler(self, *args, **kwargs):\n667:                 pass\n668: \n669:         event = AsyncMock()\n670: \n671:         scenes = ScenesManager(\n672:             registry=SceneRegistry(Router()),\n673:             update_type=\"message\",\n674:             event=event,\n675:             state=FSMContext(\n676:                 storage=MemoryStorage(), key=StorageKey(bot_id=42, chat_id=-42, user_id=42)\n677:             ),\n678:             data={},\n679:         )\n680:         scenes.enter = AsyncMock()\n681: \n682:         kwargs = {\"test_kwargs\": \"test_kwargs\"}\n683:         handler = MyScene.as_handler(**kwargs)\n684:         await handler(event, scenes)\n685: \n686:         scenes.enter.assert_called_once_with(MyScene, **kwargs)\n687: \n688: \n689: class TestSceneWizard:\n690:     async def test_scene_wizard_enter_with_reset_data_on_enter(self):\n691:         class MyScene(Scene, reset_data_on_enter=True):\n692:             pass\n693: \n694:         scene_config_mock = AsyncMock()\n695:         scene_config_mock.state = \"test_state\"\n696: \n697:         state_mock = AsyncMock(spec=FSMContext)\n698:         state_mock.set_state = AsyncMock()\n699: \n700:         wizard = SceneWizard(\n701:             scene_config=MyScene.__scene_config__,\n702:             manager=AsyncMock(spec=ScenesManager),\n703:             state=state_mock,\n704:             update_type=\"message\",\n705:             event=AsyncMock(),\n706:             data={},\n707:         )\n708:         kwargs = {\"test_kwargs\": \"test_kwargs\"}\n709:         wizard._on_action = AsyncMock()\n710: \n711:         await wizard.enter(**kwargs)\n712: \n713:         state_mock.set_data.assert_called_once_with({})\n714:         state_mock.set_state.assert_called_once_with(MyScene.__scene_config__.state)\n715:         wizard._on_action.assert_called_once_with(SceneAction.enter, **kwargs)\n716: \n717:     async def test_scene_wizard_enter_with_reset_history_on_enter(self):\n718:         class MyScene(Scene, reset_history_on_enter=True):\n719:             pass\n720: \n721:         state_mock = AsyncMock(spec=FSMContext)\n722:         state_mock.set_state = AsyncMock()\n723: \n724:         manager = AsyncMock(spec=ScenesManager)\n725:         manager.history = AsyncMock(spec=HistoryManager)\n726:         manager.history.clear = AsyncMock()\n727: \n728:         wizard = SceneWizard(\n729:             scene_config=MyScene.__scene_config__,\n730:             manager=manager,\n731:             state=state_mock,\n732:             update_type=\"message\",\n733:             event=AsyncMock(),\n734:             data={},\n735:         )\n736:         kwargs = {\"test_kwargs\": \"test_kwargs\"}\n737:         wizard._on_action = AsyncMock()\n738: \n739:         await wizard.enter(**kwargs)\n740: \n741:         manager.history.clear.assert_called_once()\n742:         state_mock.set_state.assert_called_once_with(MyScene.__scene_config__.state)\n743:         wizard._on_action.assert_called_once_with(SceneAction.enter, **kwargs)\n744: \n745:     async def test_scene_wizard_leave_with_history(self):\n746:         scene_config_mock = AsyncMock()\n747:         scene_config_mock.state = \"test_state\"\n748: \n749:         manager = AsyncMock(spec=ScenesManager)\n750:         manager.history = AsyncMock(spec=HistoryManager)\n751:         manager.history.snapshot = AsyncMock()\n752: \n753:         wizard = SceneWizard(\n754:             scene_config=scene_config_mock,\n755:             manager=manager,\n756:             state=AsyncMock(spec=FSMContext),\n757:             update_type=\"message\",\n758:             event=AsyncMock(),\n759:             data={},\n760:         )\n761:         wizard._on_action = AsyncMock()\n762: \n763:         kwargs = {\"test_kwargs\": \"test_kwargs\"}\n764:         await wizard.leave(_with_history=False, **kwargs)\n765: \n766:         manager.history.snapshot.assert_not_called()\n767:         wizard._on_action.assert_called_once_with(SceneAction.leave, **kwargs)\n768: \n769:     async def test_scene_wizard_leave_without_history(self):\n770:         scene_config_mock = AsyncMock()\n771:         scene_config_mock.state = \"test_state\"\n772: \n773:         manager = AsyncMock(spec=ScenesManager)\n774:         manager.history = AsyncMock(spec=HistoryManager)\n775:         manager.history.snapshot = AsyncMock()\n776: \n777:         wizard = SceneWizard(\n778:             scene_config=scene_config_mock,\n779:             manager=manager,\n780:             state=AsyncMock(spec=FSMContext),\n781:             update_type=\"message\",\n782:             event=AsyncMock(),\n783:             data={},\n784:         )\n785:         wizard._on_action = AsyncMock()\n786: \n787:         kwargs = {\"test_kwargs\": \"test_kwargs\"}\n788:         await wizard.leave(**kwargs)\n789: \n790:         manager.history.snapshot.assert_called_once()\n791:         wizard._on_action.assert_called_once_with(SceneAction.leave, **kwargs)\n792: \n793:     async def test_scene_wizard_back(self):\n794:         current_scene_config_mock = AsyncMock()\n795:         current_scene_config_mock.state = \"test_state\"\n796: \n797:         previous_scene_config_mock = AsyncMock()\n798:         previous_scene_config_mock.state = \"previous_test_state\"\n799: \n800:         previous_scene_mock = AsyncMock()\n801:         previous_scene_mock.__scene_config__ = previous_scene_config_mock\n802: \n803:         manager = AsyncMock(spec=ScenesManager)\n804:         manager.history = AsyncMock(spec=HistoryManager)\n805:         manager.history.rollback = AsyncMock(return_value=previous_scene_mock)\n806:         manager.enter = AsyncMock()\n807: \n808:         wizard = SceneWizard(\n809:             scene_config=current_scene_config_mock,\n810:             manager=manager,\n811:             state=AsyncMock(spec=FSMContext),\n812:             update_type=\"message\",\n813:             event=AsyncMock(),\n814:             data={},\n815:         )\n816:         wizard.leave = AsyncMock()\n817: \n818:         kwargs = {\"test_kwargs\": \"test_kwargs\"}\n819:         await wizard.back(**kwargs)\n820: \n821:         wizard.leave.assert_called_once_with(_with_history=False, **kwargs)\n822:         manager.history.rollback.assert_called_once()\n823:         manager.enter.assert_called_once_with(previous_scene_mock, _check_active=False, **kwargs)\n824: \n825:     async def test_scene_wizard_retake(self):\n826:         scene_config_mock = AsyncMock()\n827:         scene_config_mock.state = \"test_state\"\n828: \n829:         wizard = SceneWizard(\n830:             scene_config=scene_config_mock,\n831:             manager=AsyncMock(spec=Sc