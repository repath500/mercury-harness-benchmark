       wizard.state.update_data.assert_called_once_with(data=kwargs)\n1041:         assert result == {**kwargs}\n1042: \n1043:     async def test_scene_wizard_clear_data(self):\n1044:         wizard = SceneWizard(\n1045:             scene_config=AsyncMock(),\n1046:             manager=AsyncMock(),\n1047:             state=AsyncMock(),\n1048:             update_type=\"message\",\n1049:             event=AsyncMock(),\n1050:             data={},\n1051:         )\n1052:         wizard.set_data = AsyncMock()\n1053: \n1054:         await wizard.clear_data()\n1055: \n1056:         wizard.set_data.assert_called_once_with({})\n1057: \n1058: \n1059: class TestScenesManager:\n1060:     async def test_scenes_manager_get_scene(self, bot: MockedBot):\n1061:         class MyScene(Scene):\n1062:             pass\n1063: \n1064:         router = Router()\n1065: \n1066:         registry = SceneRegistry(router)\n1067:         registry.add(MyScene)\n1068: \n1069:         scenes_manager = ScenesManager(\n1070:             registry=registry,\n1071:             update_type=\"message\",\n1072:             event=Update(\n1073:                 update_id=42,\n1074:                 message=Message(\n1075:                     message_id=42,\n1076:                     text=\"test\",\n1077:                     date=datetime.now(),\n1078:                     chat=Chat(\n1079:                         type=\"private\",\n1080:                         id=42,\n1081:                     ),\n1082:                 ),\n1083:             ),\n1084:             state=FSMContext(\n1085:                 storage=MemoryStorage(), key=StorageKey(chat_id=-42, user_id=42, bot_id=bot.id)\n1086:             ),\n1087:             data={},\n1088:         )\n1089: \n1090:         scene = await scenes_manager._get_scene(MyScene)\n1091:         assert isinstance(scene, MyScene)\n1092:         assert isinstance(scene.wizard, SceneWizard)\n1093:         assert scene.wizard.scene_config == MyScene.__scene_config__\n1094:         assert scene.wizard.manager == scenes_manager\n1095:         assert scene.wizard.update_type == \"message\"\n1096:         assert scene.wizard.data == {}\n1097: \n1098:     async def test_scenes_manager_get_active_scene(self, bot: MockedBot):\n1099:         class TestScene(Scene):\n1100:             pass\n1101: \n1102:         class TestScene2(Scene, state=\"test_state2\"):\n1103:             pass\n1104: \n1105:         registry = SceneRegistry(Router())\n1106:         registry.add(TestScene, TestScene2)\n1107: \n1108:         manager = ScenesManager(\n1109:             registry,\n1110:             update_type=\"message\",\n1111:             event=Update(\n1112:                 update_id=42,\n1113:                 message=Message(\n1114:                     message_id=42,\n1115:                     text=\"test\",\n1116:                     date=datetime.now(),\n1117:                     chat=Chat(\n1118:                         type=\"private\",\n1119:                         id=42,\n1120:                     ),\n1121:                 ),\n1122:             ),\n1123:             state=FSMContext(\n1124:                 storage=MemoryStorage(), key=StorageKey(chat_id=-42, user_id=42, bot_id=bot.id)\n1125:             ),\n1126:             data={},\n1127:         )\n1128: \n1129:         scene = await manager._get_active_scene()\n1130:         assert isinstance(scene, TestScene)\n1131: \n1132:         await manager.enter(TestScene2)\n1133:         scene = await manager._get_active_scene()\n1134:         assert isinstance(scene, TestScene2)\n1135: \n1136:     async def test_scenes_manager_get_active_scene_with_scene_exception(self, bot: MockedBot):\n1137:         registry = SceneRegistry(Router())\n1138: \n1139:         manager = ScenesManager(\n1140:             registry,\n1141:             update_type=\"message\",\n1142:             event=Update(\n1143:                 update_id=42,\n1144:                 message=Message(\n1145:                     message_id=42,\n