+
+    async def test_get_value(self, bot: MockedBot, state):
+        # Test getting existing value
+        assert await state.get_value("foo") == "bar"
+        
+        # Test getting non-existing value (default None)
+        assert await state.get_value("nonexistent") is None
+        
+        # Test getting non-existing value with default
+        assert await state.get_value("nonexistent", "default") == "default"
+
+        # Test with empty state
+        await state.clear()
+        assert await state.get_value("any") is None
+        assert await state.get_value("any", "default") == "default"
+
