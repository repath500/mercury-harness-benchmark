+    async def test_get_value(self, bot: MockedBot):
+        storage = MemoryStorage()
+        key = StorageKey(user_id=42, chat_id=-42, bot_id=bot.id)
+        state = FSMContext(storage=storage, key=key)
+
+        assert await state.get_value(field="foo") is None
+        assert await state.get_value(field="foo", default="default") == "default"
+        assert await state.get_value(field="baz") is None
+
+        await state.set_data({"foo": "bar"})
+        assert await state.get_value(field="foo") == "bar"
+
