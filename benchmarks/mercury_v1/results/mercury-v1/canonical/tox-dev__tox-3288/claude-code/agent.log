{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_d4fb4b6b0c494fbc9f16c713","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\tfrom abc import abstractmethod\n4\tfrom argparse import ArgumentTypeError\n5\tfrom typing import TYPE_CHECKING, Any, List, Mapping, TypeVar\n6\t\n7\tfrom tox.plugin import impl\n8\tfrom tox.tox_env.python.pip.req_file import PythonDeps\n9\t\n10\tfrom .convert import Convert, Factory\n11\tfrom .str_convert import StrConvert\n12\t\n13\tif TYPE_CHECKING:\n14\t    from tox.config.cli.parser import ToxParser\n15\t    from tox.config.main import Config\n16\t\n17\t    from .section import Section\n18\t\n19\t\n20\tclass Override:  # noqa: PLW1641\n21\t    \"\"\"An override for config definitions.\"\"\"\n22\t\n23\t    def __init__(self, value: str) -> None:\n24\t        key, equal, self.value = value.partition(\"=\")\n25\t        if not equal:\n26\t            msg = f\"override {value} has no = sign in it\"\n27\t            raise ArgumentTypeError(msg)\n28\t\n29\t        self.append = False\n30\t        if key.endswith(\"+\"):  # key += value appends to a list\n31\t            key = key[:-1]\n32\t            self.append = True\n33\t\n34\t        self.namespace, _, self.key = key.rpartition(\".\")\n35\t\n36\t    def __repr__(self) -> str:\n37\t        return f\"{self.__class__.__name__}('{self}')\"\n38\t\n39\t    def __str__(self) -> str:\n40\t        return f\"{self.namespace}{'.' if self.namespace else ''}{self.key}={self.value}\"\n41\t\n42\t    def __eq__(self, other: object) -> bool:\n43\t        if type(self) != type(other):\n44\t            return False\n45\t        return (self.namespace, self.key, self.value) == (\n46\t            other.namespace,  # type: ignore[attr-defined]\n47\t            other.key,  # type: ignore[attr-defined]\n48\t            other.value,  # type: ignore[attr-defined]\n49\t        )\n50\t\n51\t    def __ne__(self, other: object) -> bool:\n52\t        return not (self == other)\n53\t\n54\t\n55\tclass ConfigLoadArgs:\n56\t    \"\"\"Arguments that help loading a configuration value.\"\"\"\n57\t\n58\t    def __init__(self, chain: list[str] | None, name: str | None, env_name: str | None) -> None:\n59\t        \"\"\"\n60\t        :param chain: the configuration chain (useful to detect circular references)\n61\t        :param name: the name of the configuration\n62\t        :param env_name: the tox environment this load is for\n63\t        \"\"\"\n64\t        self.chain: list[str] = chain or []\n65\t        self.name = name\n66\t        self.env_name = env_name\n67\t\n68\t    def copy(self) -> ConfigLoadArgs:\n69\t        \"\"\":return: create a copy of the object\"\"\"\n70\t        return ConfigLoadArgs(self.chain.copy(), self.name, self.env_name)\n71\t\n72\t\n73\tOverrideMap = Mapping[str, List[Override]]\n74\t\n75\tT = TypeVar(\"T\")\n76\tV = TypeVar(\"V\")\n77\t\n78\t\n79\tclass Loader(Convert[T]):\n80\t    \"\"\"Loader loads a configuration value and converts it.\"\"\"\n81\t\n82\t    def __init__(self, section: Section, overrides: list[Override]) -> None:\n83\t        self._section = section\n84\t        self.overrides: dict[str, list[Override]] = {}\n85\t        for override in overrides:\n86\t            self.overrides.setdefault(override.key, []).append(override)\n87\t        self.parent: Loader[Any] | None = None\n88\t\n89\t    @property\n90\t    def section(self) -> Section:\n91\t        return self._section\n92\t\n93\t    @abstractmethod\n94\t    def load_raw(self, key: str, conf: Config | None, env_name: str | None) -> T:\n95\t        \"\"\"\n96\t        Load the raw object from the config store.\n97\t\n98\t        :param key: the key under what we want the configuration\n99\t        :param env_name: load for env name\n100\t        :param conf: the global config object\n101\t        \"\"\"\n102\t        raise NotImplementedError\n103\t\n104\t    @abstractmethod\n105\t    def found_keys(self) -> set[str]:\n106\t        \"\"\"A list of configuration keys found within the configuration.\"\"\"\n107\t        raise NotImplementedError\n108\t\n109\t    def __repr__(self) -> str:\n110\t        return f\"{type(self).__name__}\"\n111\t\n112\t    def __contains__(self, item: str) -> bool:\n113\t        return item in self.found_keys()\n114\t\n115\t    def load(  # noqa: PLR0913\n116\t        self,\n117\t        key: str,\n118\t        of_type: type[V],\n119\t        factory: Factory[V],\n120\t        conf: Config | None,\n121\t        args: ConfigLoadArgs,\n122\t    ) -> V:\n123\t        \"\"\"\n124\t        Load a value (raw and then convert).\n125\t\n126\t        :param key: the key under it lives\n127\t        :param of_type: the type to convert to\n128\t        :param factory: factory method to build the object\n129\t        :param conf: the configuration object of this tox session (needed to manifest the value)\n130\t        :param args: the config load arguments\n131\t        :return: the converted type\n132\t        \"\"\"\n133\t        from tox.config.set_env import SetEnv  # noqa: PLC0415\n134\t\n135\t        overrides = self.overrides.get(key, [])\n136\t\n137\t        try:\n138\t            raw = self.load_raw(key, conf, args.env_name)\n139\t        except KeyError:\n140\t            converted = None\n141\t            if not overrides:\n142\t                raise\n143\t        else:\n144\t            converted = self.build(key, of_type, factory, conf, raw, args)\n145\t\n146\t        for override in overrides:\n147\t            converted_override = _STR_CONVERT.to(override.value, of_type, factory)\n148\t            if override.append and converted is not None:\n149\t                if isinstance(converted, list) and isinstance(converted_override, list):\n150\t                    converted += converted_override\n151\t                elif isinstance(converted, dict) and isinstance(converted_override, dict):\n152\t                    converted.update(converted_override)\n153\t                elif isinstance(converted, SetEnv) and isinstance(converted_override, SetEnv):\n154\t                    converted.update(converted_override, override=True)\n155\t                elif isinstance(converted, PythonDeps) and isinstance(converted_override, PythonDeps):\n156\t                    converted += converted_override\n157\t                else:\n158\t                    msg = \"Only able to append to lists and dicts\"\n159\t                    raise ValueError(msg)\n160\t            else:\n161\t                converted = converted_override\n162\t\n163\t        return converted  # type: ignore[return-value]\n164\t\n165\t    def build(  # noqa: PLR0913\n166\t        self,\n167\t        key: str,  # noqa: ARG002\n168\t        of_type: type[V],\n169\t        factory: Factory[V],\n170\t        conf: Config | None,  # noqa: ARG002\n171\t        raw: T,\n172\t        args: ConfigLoadArgs,  # noqa: ARG002\n173\t    ) -> V:\n174\t        \"\"\"\n175\t        Materialize the raw configuration value from the loader.\n176\t\n177\t        :param future: a future which when called will provide the converted config value\n178\t        :param key: the config key\n179\t        :param of_type: the config type\n180\t        :param conf: the global config\n181\t        :param raw: the raw value\n182\t        :param args: env args\n183\t        \"\"\"\n184\t        return self.to(raw, of_type, factory)\n185\t\n186\t\n187\t@impl\n188\tdef tox_add_option(parser: ToxParser) -> None:\n189\t    override_short_option = \"-x\"\n190\t    parser.add_argument(\n191\t        override_short_option,\n192\t        \"--override\",\n193\t        action=\"append\",\n194\t        type=Override,\n195\t        default=[],\n196\t        dest=\"override\",\n197\t        help=f\"configuration override(s), e.g., {override_short_option} testenv:pypy3.ignore_errors=True\",\n198\t    )\n199\t\n200\t\n201\t_STR_CONVERT = StrConvert()\n202\t"}]},"parent_tool_use_id":"call_4b596dc0205a4f71973f751c","session_id":"cb0f6f6f-51e6-41a4-8fa5-1626e82bdc6e","uuid":"feb23f64-df76-4978-a3c3-d1ed98a83457","timestamp":"2026-09-03T06:57:49.085Z","subagent_type":"Explore","task_description":"Explore ConfigSet implementation"}
