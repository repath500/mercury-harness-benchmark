{"type":"tool_use","timestamp":1788418179866,"sessionID":"ses_f99f89748ffewmTPERPjSRhC5T","part":{"type":"tool","tool":"read","callID":"call_81a3579bc24d46e2a249804f","state":{"status":"completed","input":{"filePath":"/testbed/src/tox/config/loader/convert.py"},"output":"<path>/testbed/src/tox/config/loader/convert.py</path>\n<type>file</type>\n<content>\n1: from __future__ import annotations\n2: \n3: from abc import ABC, abstractmethod\n4: from collections import OrderedDict\n5: from pathlib import Path\n6: from types import GenericAlias\n7: from typing import Any, Callable, Dict, Generic, Iterator, List, Literal, Optional, Set, TypeVar, Union, cast\n8: \n9: from tox.config.types import Command, EnvList\n10: \n11: _NO_MAPPING = object()\n12: T = TypeVar(\"T\")\n13: V = TypeVar(\"V\")\n14: \n15: Factory = Optional[Callable[[object], T]]  # note the argument is anything, due e.g. memory loader can inject anything\n16: \n17: \n18: class Convert(ABC, Generic[T]):\n19:     \"\"\"A class that converts a raw type to a given tox (python) type.\"\"\"\n20: \n21:     def to(self, raw: T, of_type: type[V], factory: Factory[V]) -> V:  # noqa: PLR0911\n22:         \"\"\"\n23:         Convert given raw type to python type.\n24: \n25:         :param raw: the raw type\n26:         :param of_type: python type\n27:         :param factory: factory method to build the object\n28:         :return: the converted type\n29:         \"\"\"\n30:         from_module = getattr(of_type, \"__module__\", None)\n31:         is_typing = from_module in {\"typing\", \"typing_extensions\"}\n32:         is_generic_alias = isinstance(of_type, GenericAlias)\n33:         if is_typing or is_generic_alias:\n34:             return self._to_typing(raw, of_type, factory)\n35:         if issubclass(of_type, Path):\n36:             return self.to_path(raw)  # type: ignore[return-value]\n37:         if issubclass(of_type, bool):\n38:             return self.to_bool(raw)  # type: ignore[return-value]\n39:         if issubclass(of_type, Command):\n40:             return self.to_command(raw)  # type: ignore[return-value]\n41:         if issubclass(of_type, EnvList):\n42:             return self.to_env_list(raw)  # type: ignore[return-value]\n43:         if issubclass(of_type, str):\n44:             return self.to_str(raw)  # type: ignore[return-value]\n45:         if isinstance(raw, of_type):  # already target type no need to transform it\n46:             # do it this late to allow normalization - e.g. string strip\n47:             return raw\n48:         if factory:\n49:             return factory(raw)\n50:         return of_type(raw)  # type: ignore[call-arg]\n51: \n52:     def _to_typing(self, raw: T, of_type: type[V], factory: Factory[V]) -> V:  # noqa: C901\n53:         origin = getattr(of_type, \"__origin__\", of_type.__class__)\n54:         result: Any = _NO_MAPPING\n55:         if origin in {list, List}:\n56:             entry_type = of_type.__args__[0]  # type: ignore[attr-defined]\n57:             result = [self.to(i, entry_type, factory) for i in self.to_list(raw, entry_type)]\n58:         elif origin in {set, Set}:\n59:             entry_type = of_type.__args__[0]  # type: ignore[attr-defined]\n60:             result = {self.to(i, entry_type, factory) for i in self.to_set(raw, entry_type)}\n61:         elif origin in {dict, Dict}:\n62:             key_type, value_type = of_type.__args__[0], of_type.__args__[1]  # type: ignore[attr-defined]\n63:             result = OrderedDict(\n64:                 (self.to(k, key_type, factory), self.to(v, value_type, factory))\n65:                 for k, v in self.to_dict(raw, (key_type, value_type))\n66:             )\n67:         elif origin == Union:  # handle Optional values\n68:             args: list[type[Any]] = of_type.__args__  # type: ignore[attr-defined]\n69:             none = type(None)\n70:             if len(args) == 2 and none in args:  # noqa: PLR2004\n71:                 if isinstance(raw, str):\n72:                     raw = raw.strip()  # type: ignore[assignment]\n73:                 if not raw:\n74:                     result = None\n75:                 else:\n76:                     new_type = next(i for i in args if i != none)  # pragma: no cover\n77:                     result = self.to(raw, new_type, factory)\n78:         elif origin in {Literal, type(Literal)}:\n79:             choice = of_type.__args__  # type: ignore[attr-defined]\n80:             if raw not in choice:\n81:                 msg = f\"{raw} must be one of {choice}\"\n82:                 raise ValueError(msg)\n83:             result = raw\n84:         if result is not _NO_MAPPING:\n85:             return cast(V, result)\n86:         msg = f\"{raw} cannot cast to {of_type!r}\"\n87:         raise TypeError(msg)\n88: \n89:     @staticmethod\n90:     @abstractmethod\n91:     def to_str(value: T) -> str:\n92:         \"\"\"\n93:         Convert to string.\n94: \n95:         :param value: the value to convert\n96:         :returns: a string representation of the value\n97:         \"\"\"\n98:         raise NotImplementedError\n99: \n100:     @staticmethod\n101:     @abstractmethod\n102:     def to_bool(value: T) -> bool:\n103:         \"\"\"\n104:         Convert to boolean.\n105: \n106:         :param value: the value to convert\n107:         :returns: a boolean representation of the value\n108:         \"\"\"\n109:         raise NotImplementedError\n110: \n111:     @staticmethod\n112:     @abstractmethod\n113:     def to_list(value: T, of_type: type[Any]) -> Iterator[T]:\n114:         \"\"\"\n115:         Convert to list.\n116: \n117:         :param value: the value to convert\n118:         :param of_type: the type of elements in the list\n119:         :returns: a list representation of the value\n120:         \"\"\"\n121:         raise NotImplementedError\n122: \n123:     @staticmethod\n124:     @abstractmethod\n125:     def to_set(value: T, of_type: type[Any]) -> Iterator[T]:\n126:         \"\"\"\n127:         Convert to set.\n128: \n129:         :param value: the value to convert\n130:         :param of_type: the type of elements in the set\n131:         :returns: a set representation of the value\n132:         \"\"\"\n133:         raise NotImplementedError\n134: \n135:     @staticmethod\n136:     @abstractmethod\n137:     def to_dict(value: T, of_type: tuple[type[Any], type[Any]]) -> Iterator[tuple[T, T]]:\n138:         \"\"\"\n139:         Convert to dictionary.\n140: \n141:         :param value: the value to convert\n142:         :param of_type: a tuple indicating the type of the key and the value\n143:         :returns: a iteration of key-value pairs that gets populated into a dict\n144:         \"\"\"\n145:         raise NotImplementedError\n146: \n147:     @staticmethod\n148:     @abstractmethod\n149:     def to_path(value: T) -> Path:\n150:         \"\"\"\n151:         Convert to path.\n152: \n153:         :param value: the value to convert\n154:         :returns: path representation of the value\n155:         \"\"\"\n156:         raise NotImplementedError\n157: \n158:     @staticmethod\n159:     @abstractmethod\n160:     def to_command(value: T) -> Command:\n161:         \"\"\"\n162:         Convert to a command to execute.\n163: \n164:         :param value: the value to convert\n165:         :returns: command representation of the value\n166:         \"\"\"\n167:         raise NotImplementedError\n168: \n169:     @staticmethod\n170:     @abstractmethod\n171:     def to_env_list(value: T) -> EnvList:\n172:         \"\"\"\n173:         Convert to a tox EnvList.\n174: \n175:         :param value: the value to convert\n176:         :returns: a list of tox environments from the value\n177:         \"\"\"\n178:         raise NotImplementedError\n179: \n180: \n181: __all__ = [\n182:     \"Convert\",\n183:     \"Factory\",\n184: ]\n\n(End of file - total 184 lines)\n</content>","metadata":{"preview":"from __future__ import annotations\n\nfrom abc import ABC, abstractmethod\nfrom collections import OrderedDict\nfrom pathlib import Path\nfrom types import GenericAlias\nfrom typing import Any, Callable, Dict, Generic, Iterator, List, Literal, Optional, Set, TypeVar, Union, cast\n\nfrom tox.config.types import Command, EnvList\n\n_NO_MAPPING = object()\nT = TypeVar(\"T\")\nV = TypeVar(\"V\")\n\nFactory = Optional[Callable[[object], T]]  # note the argument is anything, due e.g. memory loader can inject anything\n\n\nclass Convert(ABC, Generic[T]):\n    \"\"\"A class that converts a raw type to a given tox (python) type.\"\"\"\n","truncated":false,"loaded":[],"display":{"type":"file","path":"/testbed/src/tox/config/loader/convert.py","text":"from __future__ import annotations\n\nfrom abc import ABC, abstractmethod\nfrom collections import OrderedDict\nfrom pathlib import Path\nfrom types import GenericAlias\nfrom typing import Any, Callable, Dict, Generic, Iterator, List, Literal, Optional, Set, TypeVar, Union, cast\n\nfrom tox.config.types import Command, EnvList\n\n_NO_MAPPING = object()\nT = TypeVar(\"T\")\nV = TypeVar(\"V\")\n\nFactory = Optional[Callable[[object], T]]  # note the argument is anything, due e.g. memory loader can inject anything\n\n\nclass Convert(ABC, Generic[T]):\n    \"\"\"A class that converts a raw type to a given tox (python) type.\"\"\"\n\n    def to(self, raw: T, of_type: type[V], factory: Factory[V]) -> V:  # noqa: PLR0911\n        \"\"\"\n        Convert given raw type to python type.\n\n        :param raw: the raw type\n        :param of_type: python type\n        :param factory: factory method to build the object\n        :return: the converted type\n        \"\"\"\n        from_module = getattr(of_type, \"__module__\", None)\n        is_typing = from_module in {\"typing\", \"typing_extensions\"}\n        is_generic_alias = isinstance(of_type, GenericAlias)\n        if is_typing or is_generic_alias:\n            return self._to_typing(raw, of_type, factory)\n        if issubclass(of_type, Path):\n            return self.to_path(raw)  # type: ignore[return-value]\n        if issubclass(of_type, bool):\n            return self.to_bool(raw)  # type: ignore[return-value]\n        if issubclass(of_type, Command):\n            return self.to_command(raw)  # type: ignore[return-value]\n        if issubclass(of_type, EnvList):\n            return self.to_env_list(raw)  # type: ignore[return-value]\n        if issubclass(of_type, str):\n            return self.to_str(raw)  # type: ignore[return-value]\n        if isinstance(raw, of_type):  # already target type no need to transform it\n            # do it this late to allow normalization - e.g. string strip\n            return raw\n        if factory:\n            return factory(raw)\n        return of_type(raw)  # type: ignore[call-arg]\n\n    def _to_typing(self, raw: T, of_type: type[V], factory: Factory[V]) -> V:  # noqa: C901\n        origin = getattr(of_type, \"__origin__\", of_type.__class__)\n        result: Any = _NO_MAPPING\n        if origin in {list, List}:\n            entry_type = of_type.__args__[0]  # type: ignore[attr-defined]\n            result = [self.to(i, entry_type, factory) for i in self.to_list(raw, entry_type)]\n        elif origin in {set, Set}:\n            entry_type = of_type.__args__[0]  # type: ignore[attr-defined]\n            result = {self.to(i, entry_type, factory) for i in self.to_set(raw, entry_type)}\n        elif origin in {dict, Dict}:\n            key_type, value_type = of_type.__args__[0], of_type.__args__[1]  # type: ignore[attr-defined]\n            result = OrderedDict(\n                (self.to(k, key_type, factory), self.to(v, value_type, factory))\n                for k, v in self.to_dict(raw, (key_type, value_type))\n            )\n        elif origin == Union:  # handle Optional values\n            args: list[type[Any]] = of_type.__args__  # type: ignore[attr-defined]\n            none = type(None)\n            if len(args) == 2 and none in args:  # noqa: PLR2004\n                if isinstance(raw, str):\n                    raw = raw.strip()  # type: ignore[assignment]\n                if not raw:\n                    result = None\n                else:\n                    new_type = next(i for i in args if i != none)  # pragma: no cover\n                    result = self.to(raw, new_type, factory)\n        elif origin in {Literal, type(Literal)}:\n            choice = of_type.__args__  # type: ignore[attr-defined]\n            if raw not in choice:\n                msg = f\"{raw} must be one of {choice}\"\n                raise ValueError(msg)\n            result = raw\n        if result is not _NO_MAPPING:\n            return cast(V, result)\n        msg = f\"{raw} cannot cast to {of_type!r}\"\n        raise TypeError(msg)\n\n    @staticmethod\n    @abstractmethod\n    def to_str(value: T) -> str:\n        \"\"\"\n        Convert to string.\n\n        :param value: the value to convert\n        :returns: a string representation of the value\n        \"\"\"\n        raise NotImplementedError\n\n    @staticmethod\n    @abstractmethod\n    def to_bool(value: T) -> bool:\n        \"\"\"\n        Convert to boolean.\n\n        :param value: the value to convert\n        :returns: a boolean representation of the value\n        \"\"\"\n        raise NotImplementedError\n\n    @staticmethod\n    @abstractmethod\n    def to_list(value: T, of_type: type[Any]) -> Iterator[T]:\n        \"\"\"\n        Convert to list.\n\n        :param value: the value to convert\n        :param of_type: the type of elements in the list\n        :returns: a list representation of the value\n        \"\"\"\n        raise NotImplementedError\n\n    @staticmethod\n    @abstractmethod\n    def to_set(value: T, of_type: type[Any]) -> Iterator[T]:\n        \"\"\"\n        Convert to set.\n\n        :param value: the value to convert\n        :param of_type: the type of elements in the set\n        :returns: a set representation of the value\n        \"\"\"\n        raise NotImplementedError\n\n    @staticmethod\n    @abstractmethod\n    def to_dict(value: T, of_type: tuple[type[Any], type[Any]]) -> Iterator[tuple[T, T]]:\n        \"\"\"\n        Convert to dictionary.\n\n        :param value: the value to convert\n        :param of_type: a tuple indicating the type of the key and the value\n        :returns: a iteration of key-value pairs that gets populated into a dict\n        \"\"\"\n        raise NotImplementedError\n\n    @staticmethod\n    @abstractmethod\n    def to_path(value: T) -> Path:\n        \"\"\"\n        Convert to path.\n\n        :param value: the value to convert\n        :returns: path representation of the value\n        \"\"\"\n        raise NotImplementedError\n\n    @staticmethod\n    @abstractmethod\n    def to_command(value: T) -> Command:\n        \"\"\"\n        Convert to a command to execute.\n\n        :param value: the value to convert\n        :returns: command representation of the value\n        \"\"\"\n        raise NotImplementedError\n\n    @staticmethod\n    @abstractmethod\n    def to_env_list(value: T) -> EnvList:\n        \"\"\"\n        Convert to a tox EnvList.\n\n        :param value: the value to convert\n        :returns: a list of tox environments from the value\n        \"\"\"\n        raise NotImplementedError\n\n\n__all__ = [\n    \"Convert\",\n    \"Factory\",\n]","lineStart":1,"lineEnd":184,"totalLines":184,"truncated":false}},"title":"src/tox/config/loader/convert.py","time":{"start":1788418179848,"end":1788418179863}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_06607c2eb001bPBHwlKR1bupmu","sessionID":"ses_f99f89748ffewmTPERPjSRhC5T","messageID":"msg_06607c189001qALtnbSLmk2U6K"}}
