     ],
 )
diff --git a/tests/config/test_sets.py b/tests/config/test_sets.py
index c92eeeea..b57ed342 100644
--- a/tests/config/test_sets.py
+++ b/tests/config/test_sets.py
@@ -192,3 +192,31 @@ def test_config_work_dir(tox_project: ToxProjectCreator, work_dir: str) -> None:
     result = project.run("c", *(["--workdir", str(project.path / work_dir)] if work_dir else []))
     expected = project.path / work_dir if work_dir else Path("b")
     assert expected == result.state.conf.core["work_dir"]
+
+
+def test_config_set_add_config_lowercase_generic(conf_builder: ConfBuilder) -> None:
+    """Test that lowercase generic types (list[str], set[str], dict[str, int]) work properly."""
+    config_set = conf_builder("passenv = foo")
+    config_set.add_config("passenv", of_type=list[str], default=[], desc="desc")
+    assert config_set["passenv"] == ["foo"]
+
+
+def test_config_set_add_config_lowercase_set_generic(conf_builder: ConfBuilder) -> None:
+    """Test that lowercase set[str] type works properly."""
+    config_set = conf_builder("passenv = foo")
+    config_set.add_config("passenv", of_type=set[str], default=set(), desc="desc")
+    assert config_set["passenv"] == {"foo"}
+
+
+def test_config_set_add_config_lowercase_dict_generic(conf_builder: ConfBuilder) -> None:
+    """Test that lowercase dict[str, int] type works properly."""
+    config_set = conf_builder("env_vars = a=1\n  b=2")
+    config_set.add_config("env_vars", of_type=dict[str, int], default={}, desc="desc")
+    assert config_set["env_vars"] == {"a": 1, "b": 2}
+
+
+def test_config_set_add_config_optional_list_generic(conf_builder: ConfBuilder) -> None:
+    """Test that Optional[list[str]] type works properly."""
+    config_set = conf_builder("passenv = foo")
+    config_set.add_config("passenv", of_type=Optional[list[str]], default=None, desc="desc")
+    assert config_set["passenv"] == ["foo"]
