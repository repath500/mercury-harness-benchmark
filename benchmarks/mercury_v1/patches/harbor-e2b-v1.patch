diff --git a/src/harbor/environments/e2b.py b/src/harbor/environments/e2b.py
index c45f105..b6f582c 100644
--- a/src/harbor/environments/e2b.py
+++ b/src/harbor/environments/e2b.py
@@ -101,13 +101,16 @@ class E2BEnvironment(BaseEnvironment):
 
         self._workdir = parse_dockerfile_workdir(self._environment_definition_path)
 
         self._sandbox: AsyncSandbox | None = None
         env_hash = self.environment_id[:SNAPSHOT_HASH_LEN]
-        self._template_name = f"{environment_name}__{env_hash}".replace(
-            "/", "__"
-        ).replace(".", "-")
+        # Current E2B template resolution requires an explicit tag; an
+        # untagged sandbox request is resolved as the legacy ``default`` tag.
+        self._template_name = (
+            f"{environment_name}__{env_hash}".replace("/", "__").replace(".", "-")
+            + ":latest"
+        )
 
     @staticmethod
     @override
     def type() -> EnvironmentType:
         return EnvironmentType.E2B
@@ -226,11 +229,13 @@ class E2BEnvironment(BaseEnvironment):
 
         self._sandbox = await AsyncSandbox.create(
             template=self._template_name,
             metadata=metadata,
             envs=self._startup_env(),
-            timeout=86_400,
+            # Current E2B accounts/API reject leases longer than one hour.
+            # Keep this aligned with the V1 agent timeout and the E2B limit.
+            timeout=3_600,
             allow_internet_access=(
                 self.network_policy.network_mode != NetworkMode.NO_NETWORK
             ),
             network=self._sandbox_create_network_options(),
         )
