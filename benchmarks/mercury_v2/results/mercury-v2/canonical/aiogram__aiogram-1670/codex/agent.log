{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nfrom pathlib import Path\npath = Path('tests/test_dispatcher/test_dispatcher.py')\ntext = path.read_text()\nneedle = '''    async def test_exception_handler_catch_exceptions(self, bot: MockedBot):\n'''\naddition = '''    async def test_polling_tasks_concurrency_limit(self, bot: MockedBot):\n        dispatcher = Dispatcher()\n\n        async def _mock_updates(*_):\n            for update_id in range(3):\n                yield Update(update_id=update_id)\n\n        with (\n            patch(\n                \\\"aiogram.dispatcher.dispatcher.Dispatcher._process_update\\\",\n                side_effect=lambda bot, update: asyncio.sleep(0.02),\n            ) as mocked_process_update,\n            patch(\n                \\\"aiogram.dispatcher.dispatcher.Dispatcher._listen_updates\\\"\n            ) as patched_listen_updates,\n        ):\n            patched_listen_updates.return_value = _mock_updates()\n            await dispatcher._polling(\n                bot=bot, handle_as_tasks=True, tasks_concurrency_limit=1\n            )\n\n        assert mocked_process_update.await_count == 3\n\n    async def test_polling_tasks_semaphore_release_on_error(self, bot: MockedBot):\n        dispatcher = Dispatcher()\n\n        async def _mock_updates(*_):\n            for update_id in range(2):\n                yield Update(update_id=update_id)\n\n        async def process_update(*_: Any) -> bool:\n            raise Exception(\\\"Kaboom\"'!\")\n\n        with (\n            patch(\n                \"aiogram.dispatcher.dispatcher.Dispatcher._process_update\",\n                side_effect=process_update,\n            ) as mocked_process_update,\n            patch(\n                \"aiogram.dispatcher.dispatcher.Dispatcher._listen_updates\"\n            ) as patched_listen_updates,\n        ):\n            patched_listen_updates.return_value = _mock_updates()\n            await dispatcher._polling(\n                bot=bot, handle_as_tasks=True, tasks_concurrency_limit=1\n            )\n            await asyncio.gather(*dispatcher._handle_update_tasks)\n\n        assert mocked_process_update.await_count == 2\n\n'\"'''\nif needle not in text:\n    raise SystemExit('needle not found')\ntext = text.replace(needle, addition + needle, 1)\npath.write_text(text)\nPY\ngit diff --check\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
