+    def _create_handle_update_task(
+        self,
+        handle_update: Coroutine[Any, Any, bool],
+        release_semaphore: Optional[Callable[[], None]] = None,
+    ) -> None:
+        handle_update_task = asyncio.create_task(handle_update)
+        self._handle_update_tasks.add(handle_update_task)
+
+        def release_handle_update_task(task: asyncio.Task[Any]) -> None:
+            self._handle_update_tasks.discard(task)
+            if release_semaphore is not None:
+                release_semaphore()
+
+        handle_update_task.add_done_callback(release_handle_update_task)
