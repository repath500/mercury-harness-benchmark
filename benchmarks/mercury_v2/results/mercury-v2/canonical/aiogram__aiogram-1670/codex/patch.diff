@@ -793,6 +793,73 @@ class TestDispatcher:
             else:
                 mocked_process_update.assert_awaited()
 
+    async def test_polling_tasks_concurrency_limit(self, bot: MockedBot):
+        dispatcher = Dispatcher()
+
+        async def _mock_updates(*_):
+            for update_id in range(3):
+                yield Update(update_id=update_id)
+
+        started = [Event(), Event(), Event()]
+        release = Event()
+
+        async def process_update(update: Update, **_: Any) -> bool:
+            started[update.update_id].set()
+            await release.wait()
+            return True
+
+        with (
+            patch(
+                "aiogram.dispatcher.dispatcher.Dispatcher._process_update",
+                side_effect=process_update,
+            ) as mocked_process_update,
+            patch(
+                "aiogram.dispatcher.dispatcher.Dispatcher._listen_updates"
+            ) as patched_listen_updates,
+        ):
+            patched_listen_updates.return_value = _mock_updates()
+            polling_task = asyncio.create_task(
+                dispatcher._polling(
+                    bot=bot, handle_as_tasks=True, tasks_concurrency_limit=1
+                )
+            )
+            await asyncio.wait_for(started[0].wait(), timeout=0.1)
+            assert not started[1].is_set()
+            assert not started[2].is_set()
+            release.set()
+            await asyncio.wait_for(polling_task, timeout=0.1)
+
+        assert mocked_process_update.await_count == 3
+
+    async def test_polling_tasks_semaphore_release_on_error(self, bot: MockedBot):
+        dispatcher = Dispatcher()
+
+        async def _mock_updates(*_):
+            for update_id in range(2):
+                yield Update(update_id=update_id)
+
+        async def process_update(update: Update, **_: Any) -> bool:
+            if update.update_id == 0:
+                raise Exception("Kaboom!")
+            return True
+
+        with (
+            patch(
+                "aiogram.dispatcher.dispatcher.Dispatcher._process_update",
+                side_effect=process_update,
+            ) as mocked_process_update,
+            patch(
+                "aiogram.dispatcher.dispatcher.Dispatcher._listen_updates"
+            ) as patched_listen_updates,
+        ):
+            patched_listen_updates.return_value = _mock_updates()
+            await dispatcher._polling(
+                bot=bot, handle_as_tasks=True, tasks_concurrency_limit=1
+            )
+            await asyncio.gather(*dispatcher._handle_update_tasks)
+
+        assert mocked_process_update.await_count == 2
+
