e process update id=%d by bot id=%d\\n%s: %s\",\n317:                 update.update_id,\n318:                 bot.id,\n319:                 e.__class__.__name__,\n320:                 e,\n321:             )\n322:             return True  # because update was processed but unsuccessful\n323: \n324:     async def _polling(\n325:         self,\n326:         bot: Bot,\n327:         polling_timeout: int = 30,\n328:         handle_as_tasks: bool = True,\n329:         backoff_config: BackoffConfig = DEFAULT_BACKOFF_CONFIG,\n330:         allowed_updates: Optional[List[str]] = None,\n331:         **kwargs: Any,\n332:     ) -> None:\n333:         \"\"\"\n334:         Internal polling process\n335: \n336:         :param bot:\n337:         :param kwargs:\n338:         :return:\n339:         \"\"\"\n340:         user: User = await bot.me()\n341:         loggers.dispatcher.info(\n342:             \"Run polling for bot @%s id=%d - %r\", user.username, bot.id, user.full_name\n343:         )\n344:         try:\n345:             async for update in self._listen_updates(\n346:                 bot,\n347:                 polling_timeout=polling_timeout,\n348:                 backoff_config=backoff_config,\n349:                 allowed_updates=allowed_updates,\n350:             ):\n351:                 handle_update = self._process_update(bot=bot, update=update, **kwargs)\n352:                 if handle_as_tasks:\n353:                     handle_update_task = asyncio.create_task(handle_update)\n354:                     self._handle_update_tasks.add(handle_update_task)\n355:                     handle_update_task.add_done_callback(self._handle_update_tasks.discard)\n356:                 else:\n357:                     await handle_update\n358:         finally:\n359:             loggers.dispatcher.info(\n360:                 \"Polling stopped for bot @%s id=%d - %r\", user.username, bot.id, user.full_name\n361:             )\n362: \n363:     async def _feed_webhook_update(self, bot: Bot, update: Update, **kwargs: Any) -> Any:\n364:         \"\"\"\n365:         The same with `Dispatcher.process_update()` but returns real response instead of bool\n366:         \"\"\"\n367:         try:\n368:             return await self.feed_update(bot, update, **kwargs)\n369:         except Exception as e:\n370:             loggers.event.exception(\n371:                 \"Cause exception while process update id=%d by bot id=%d\\n%s: %s\",\n372:                 update.update_id,\n373:                 bot.id,\n374:                 e.__class__.__name__,\n375:                 e,\n376:             )\n377:             raise\n378: \n379:     async def feed_webhook_update(\n380:         self, bot: Bot, update: Union[Update, Dict[str, Any]], _timeout: float = 55, **kwargs: Any\n381:     ) -> Optional[TelegramMethod[TelegramType]]:\n382:         if not isinstance(update, Update):  # Allow to use raw updates\n383:             update = Update.model_validate(update, context={\"bot\": bot})\n384: \n385:         ctx = contextvars.copy_context()\n386:         loop = asyncio.get_running_loop()\n387:         waiter = loop.create_future()\n388: \n389:         def release_waiter(*_: Any) -> None:\n390:             if not waiter.done():\n391:                 waiter.set_result(None)\n392: \n393:         timeout_handle = loop.call_later(_timeout, release_waiter)\n394: \n395:         process_updates: Future[Any] = asyncio.ensure_future(\n396:             self._feed_webhook_update(bot=bot, update=update, **kwargs)\n397:         )\n398:         process_updates.add_done_callback(release_waiter, context=ctx)\n399: \n400:         def process_response(task: Future[Any]) -> None:\n401:             warnings.warn(\n402:                 \"Detected slow response into webhook.\\n\"\n403:                 \"Telegram is waiting for response only first 60 seconds and then re-send update.\\n\"\n404:                 \"For preventing this situation response into webhook returned immediately \"\n405:                 \"and handler is moved to background and still processing update.\",\n406:                 RuntimeWarning,\n407:             )\n408:             try:\n409:                 result = task.result()\n410:             except Exception as e:\n411:                 raise e\n412:             if isinstance(result, TelegramMethod):\n413:                 asyncio.ensure_future(self.silent_call_request(bot=bot, result=result))\n414: \n415:         try:\n416:             try:\n417:                 await waiter\n418:             except CancelledError:  # pragma: no cover\n419:                 process_updates.remove_done_callback(release_waiter)\n420:                 process_updates.cancel()\n421:                 raise\n422: \n423:             if process_updates.done():\n424:                 # TODO: handle exceptions\n425:                 response: Any = process_updates.result()\n426:                 if isinstance(response, TelegramMethod):\n427:                     return response\n428: \n429:             else:\n430:                 process_updates.remove_done_callback(release_waiter)\n431:                 process_updates.add_done_callback(process_response, context=ctx)\n432: \n433:         finally:\n434:             timeout_handle.cancel()\n435: \n436:         return None\n437: \n438:     async def stop_polling(self) -> None:\n439:         \"\"\"\n440:         Execute this method if you want to stop polling programmatically\n441: \n442:         :return:\n443:         \"\"\"\n444:         if not self._running_lock.locked():\n445:             raise RuntimeError(\"Polling is not started\")\n446:         if not self._stop_signal or not self._stopped_signal:\n447:             return\n448:         self._stop_signal.set()\n449:         await self._stopped_signal.wait()\n450: \n451:     def _signal_stop_polling(self, sig: signal.Signals) -> None:\n452:         if not self._running_lock.locked():\n453:             return\n454: \n455:         loggers.dispatcher.warning(\"Received %s signal\", sig.name)\n456:         if not self._stop_signal:\n457:             return\n458:         self._stop_signal.set()\n459: \n460:     async def start_polling(\n461:         self,\n462:         *bots: Bot,\n463:         polling_timeout: int = 10,\n464:         handle_as_tasks: bool = True,\n465:         backoff_config: BackoffConfig = DEFAULT_BACKOFF_CONFIG,\n466:         allowed_updates: Optional[Union[List[str], UNSET_TYPE]] = UNSET,\n467:         handle_signals: bool = True,\n468:         close_bot_session: bool = True,\n469:         **kwargs: Any,\n470:     ) -> None:\n471:         \"\"\"\n472:         Polling runner\n473: \n474:         :param bots: Bot instances (one or more)\n475:         :param polling_timeout: Long-polling wait time\n476:         :param handle_as_tasks: Run task for each event and no wait result\n477:         :param backoff_config: backoff-retry config\n478:         :param allowed_updates: List of the update types you want your bot to receive\n479:                By default, all used update types are enabled (resolved from handlers)\n480:         :param handle_signals: handle signals (SIGINT/SIGTERM)\n481:         :param close_bot_session: close bot sessions on shutdown\n482:         :param kwargs: contextual data\n483:         :return:\n484:         \"\"\"\n485:         if not bots:\n486:             raise ValueError(\"At least one bot instance is required to start polling\")\n487:         if \"bot\" in kwargs:\n488:             raise ValueError(\n489:                 \"Keyword argument 'bot' is not acceptable, \"\n490:                 \"the bot instance should be passed as positional argument\"\n491:             )\n492: \n493:         async with self._running_lock:  # Prevent to run this method twice at a once\n494:             if self._stop_signal is None:\n495:                 self._stop_signal = Event()\n496:             if self._stopped_signal is None:\n497:                 self._stopped_signal = Event()\n498: \n499:             if allowed_updates is UNSET:\n500:                 allowed_updates = self.resolve_used_update_types()\n501: \n502:             self._stop_signal.clear()\n503:             self._stopped_signal.clear()\n504: \n505:             if handle_signals:\n506:                 loop = asyncio.get_running_loop()\n507:                 with suppress(NotImplementedError):  # pragma: no cover\n508:                     # Signals handling is not supported on Windows\n509:                     # It also can't be covered on Windows\n510:                     loop.add_signal_handler(\n511:                         signal.SIGTERM, self._signal_stop_polling, signal.SIGTERM\n512:                     )\n513:                     loop.add_signal_handler(\n514:                         signal.SIGINT, self._signal_stop_polling, signal.SIGINT\n515:                     )\n516: \n517:             workflow_data = {\n518:                 \"dispatcher\": self,\n519:                 \"bots\": bots,\n520:                 **self.workflow_data,\n521:                 **kwargs,\n522:             }\n523:             if \"bot\" in workflow_data:\n524:                 workflow_data.pop(\"bot\")\n525: \n526:             await self.emit_startup(bot=bots[-1], **workflow_data)\n527:             loggers.dispatcher.info(\"Start polling\")\n528:             try:\n529:                 tasks: List[asyncio.Task[Any]] = [\n530:                     asyncio.create_task(\n531:                         self._polling(\n532:                             bot=bot,\n533:                             handle_as_tasks=handle_as_tasks,\n534:                             polling_timeout=polling_timeout,\n535:                             backoff_config=backoff_config,\n536:                             allowed_updates=allowed_updates,\n537:                             **workflow_data,\n538:                         )\n539:                     )\n540:                     for bot in bots\n541:                 ]\n542:                 tasks.append(asyncio.create_task(self._stop_signal.wait()))\n543:                 done, pending = await asyncio.wait(tasks, return_when=asyncio.FIRST_COMPLETED)\n544: \n545:                 for task in pending:\n546:                     # (mostly) Graceful shutdown unfinished tasks\n547:                     task.cancel()\n548:                     with suppress(CancelledError):\n549:                         await task\n550:                 # Wait finished tasks to propagate unhandled exceptions\n551:                 await asyncio.gather(*done)\n552: \n553:             finally:\n554:                 loggers.dispatcher.info(\"Polling stopped\")\n555:                 try:\n556:                     await self.emit_shutdown(bot=bots[-1], **workflow_data)\n557:                 finally:\n558:                     if close_bot_session:\n559:                         await asyncio.gather(*(bot.session.close() for bot in bots))\n560:                 self._stopped_signal.set()\n561: \n562:     def run_polling(\n563:         self,\n564:         *bots: Bot,\n565:         polling_timeout: int = 10,\n566:         handle_as_tasks: bool = True,\n567:         backoff_config: BackoffConfig = DEFAULT_BACKOFF_CONFIG,\n568:         allowed_updates: Optional[Union[List[str], UNSET_TYPE]] = UNSET,\n569:         handle_signals: bool = True,\n570:         close_bot_session: bool = True,\n571:         **kwargs: Any,\n572:     ) -> None:\n573:         \"\"\"\n574:         Run many bots with polling\n575: \n576:         :param bots: Bot instances (one or more)\n577:         :param polling_timeout: Long-polling wait time\n578:         :param handle_as_tasks: Run task for each event and no wait result\n579:         :param backoff_config: backoff-retry config\n580:         :param allowed_updates: List of the update types you want your bot to receive\n581:         :param handle_signals: handle signals (SIGINT/SIGTERM)\n582:         :param close_bot_session: close bot sessions on shutdown\n583:         :param kwargs: contextual data\n584:         :return:\n585:         \"\"\"\n586:         with suppress(KeyboardInterrupt):\n587:             return asyncio.run(\n588:                 self.start_polling(\n589:                     *bots,\n590:                     **kwargs,\n591:                     polling_timeout=polling_timeout,\n592:                     handle_as_tasks=handle_as_tasks,\n593:                     backoff_config=backoff_config,\n594:                     allowed_updates=allowed_updates,\n595:                     handle_signals=handle_signals,\n596:                     close_bot_session=close_bot_session,\n597:                 )\n598:             )\n\n(End of file - total 598 lines)\n</content>","metadata":{"preview":"        \"\"\"\n        Simulate answer into WebHook\n\n        :param bot:\n        :param result:\n        :return:\n        \"\"\"\n        try:\n            await bot(result)\n        except TelegramAPIError as e:\n            # In due to WebHook mechanism doesn't allow getting response for\n            # requests called in answer to WebHook request.\n            # Need to skip unsuccessful responses.\n            # For debugging here is added logging.\n            loggers.event.error(\"Failed to make answer: %s: %s\", e.__class__.__name__, e)\n\n    async def _process_update(\n        self, bot: Bot, update: Update, call_answer: bool = True, **kwargs: Any\n    ) -> bool:\n        \"\"\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/testbed/aiogram/dispatcher/dispatcher.py","text":"        \"\"\"\n        Simulate answer into WebHook\n\n        :param bot:\n        :param result:\n        :return:\n        \"\"\"\n        try:\n            await bot(result)\n        except TelegramAPIError as e:\n            # In due to WebHook mechanism doesn't allow getting response for\n            # requests called in answer to WebHook request.\n            # Need to skip unsuccessful responses.\n            # For debugging here is added logging.\n            loggers.event.error(\"Failed to make answer: %s: %s\", e.__class__.__name__, e)\n\n    async def _process_update(\n        self, bot: Bot, update: Update, call_answer: bool = True, **kwargs: Any\n    ) -> bool:\n        \"\"\"\n        Propagate update to event listeners\n\n        :param bot: instance of Bot\n        :param update: instance of Update\n        :param call_answer: need to execute response as Telegram method (like answer into webhook)\n        :param kwargs: contextual data for middlewares, filters and handlers\n        :return: status\n        \"\"\"\n        try:\n            response = await self.feed_update(bot, update, **kwargs)\n            if call_answer and isinstance(response, TelegramMethod):\n                await self.silent_call_request(bot=bot, result=response)\n            return response is not UNHANDLED\n\n        except Exception as e:\n            loggers.event.exception(\n                \"Cause exception while process update id=%d by bot id=%d\\n%s: %s\",\n                update.update_id,\n                bot.id,\n                e.__class__.__name__,\n                e,\n            )\n            return True  # because update was processed but unsuccessful\n\n    async def _polling(\n        self,\n        bot: Bot,\n        polling_timeout: int = 30,\n        handle_as_tasks: bool = True,\n        backoff_config: BackoffConfig = DEFAULT_BACKOFF_CONFIG,\n        allowed_updates: Optional[List[str]] = None,\n        **kwargs: Any,\n    ) -> None:\n        \"\"\"\n        Internal polling process\n\n        :param bot:\n        :param kwargs:\n        :return:\n        \"\"\"\n        user: User = await bot.me()\n        loggers.dispatcher.info(\n            \"Run polling for bot @%s id=%d - %r\", user.username, bot.id, user.full_name\n        )\n        try:\n            async for update in self._listen_updates(\n                bot,\n                polling_timeout=polling_timeout,\n                backoff_config=backoff_config,\n                allowed_updates=allowed_updates,\n            ):\n                handle_update = self._process_update(bot=bot, update=update, **kwargs)\n                if handle_as_tasks:\n                    handle_update_task = asyncio.create_task(handle_update)\n                    self._handle_update_tasks.add(handle_update_task)\n                    handle_update_task.add_done_callback(self._handle_update_tasks.discard)\n                else:\n                    await handle_update\n        finally:\n            loggers.dispatcher.info(\n                \"Polling stopped for bot @%s id=%d - %r\", user.username, bot.id, user.full_name\n            )\n\n    async def _feed_webhook_update(self, bot: Bot, update: Update, **kwargs: Any) -> Any:\n        \"\"\"\n        The same with `Dispatcher.process_update()` but returns real response instead of bool\n        \"\"\"\n        try:\n            return await self.feed_update(bot, update, **kwargs)\n        except Exception as e:\n            loggers.event.exception(\n                \"Cause exception while process update id=%d by bot id=%d\\n%s: %s\",\n                update.update_id,\n                bot.id,\n                e.__class__.__name__,\n                e,\n            )\n            raise\n\n    async def feed_webhook_update(\n        self, bot: Bot, update: Union[Update, Dict[str, Any]], _timeout: float = 55, **kwargs: Any\n    ) -> Optional[TelegramMethod[TelegramType]]:\n        if not isinstance(update, Update):  # Allow to use raw updates\n            update = Update.model_validate(update, context={\"bot\": bot})\n\n        ctx = contextvars.copy_context()\n        loop = asyncio.get_running_loop()\n        waiter = loop.create_future()\n\n        def release_waiter(*_: Any) -> None:\n            if not waiter.done():\n                waiter.set_result(None)\n\n        timeout_handle = loop.call_later(_timeout, release_waiter)\n\n        process_updates: Future[Any] = asyncio.ensure_future(\n            self._feed_webhook_update(bot=bot, update=update, **kwargs)\n        )\n        process_updates.add_done_callback(release_waiter, context=ctx)\n\n        def process_response(task: Future[Any]) -> None:\n            warnings.warn(\n                \"Detected slow response into webhook.\\n\"\n                \"Telegram is waiting for response only first 60 seconds and then re-send update.\\n\"\n                \"For preventing this situation response into webhook returned immediately \"\n                \"and handler is moved to background and still processing update.\",\n                RuntimeWarning,\n            )\n            try:\n                result = task.result()\n            except Exception as e:\n                raise e\n            if isinstance(result, TelegramMethod):\n                asyncio.ensure_future(self.silent_call_request(bot=bot, result=result))\n\n        try:\n            try:\n                await waiter\n            except CancelledError:  # pragma: no cover\n                process_updates.remove_done_callback(release_waiter)\n                process_updates.cancel()\n                raise\n\n            if process_updates.done():\n                # TODO: handle exceptions\n                response: Any = process_updates.result()\n                if isinstance(response, TelegramMethod):\n                    return response\n\n            else:\n                process_updates.remove_done_callback(release_waiter)\n                process_updates.add_done_callback(process_response, context=ctx)\n\n        finally:\n            timeout_handle.cancel()\n\n        return None\n\n    async def stop_polling(self) -> None:\n        \"\"\"\n        Execute this method if you want to stop polling programmatically\n\n        :return:\n        \"\"\"\n        if not self._running_lock.locked():\n            raise RuntimeError(\"Polling is not started\")\n        if not self._stop_signal or not self._stopped_signal:\n            return\n        self._stop_signal.set()\n        await self._stopped_signal.wait()\n\n    def _signal_stop_polling(self, sig: signal.Signals) -> None:\n        if not self._running_lock.locked():\n            return\n\n        loggers.dispatcher.warning(\"Received %s signal\", sig.name)\n        if not self._stop_signal:\n            return\n        self._stop_signal.set()\n\n    async def start_polling(\n        self,\n        *bots: Bot,\n        polling_timeout: int = 10,\n        handle_as_tasks: bool = True,\n        backoff_config: BackoffConfig = DEFAULT_BACKOFF_CONFIG,\n        allowed_updates: Optional[Union[List[str], UNSET_TYPE]] = UNSET,\n        handle_signals: bool = True,\n        close_bot_session: bool = True,\n        **kwargs: Any,\n    ) -> None:\n        \"\"\"\n        Polling runner\n\n        :param bots: Bot instances (one or more)\n        :param polling_timeout: Long-polling wait time\n        :param handle_as_tasks: Run task for each event and no wait result\n        :param backoff_config: backoff-retry config\n        :param allowed_updates: List of the update types you want your bot to receive\n               By default, all used update types are enabled (resolved from handlers)\n        :param handle_signals: handle signals (SIGINT/SIGTERM)\n        :param close_bot_session: close bot sessions on shutdown\n        :param kwargs: contextual data\n        :return:\n        \"\"\"\n        if not bots:\n            raise ValueError(\"At least one bot instance is required to start polling\")\n        if \"bot\" in kwargs:\n            raise ValueError(\n                \"Keyword argument 'bot' is not acceptable, \"\n                \"the bot instance should be passed as positional argument\"\n            )\n\n        async with self._running_lock:  # Prevent to run this method twice at a once\n            if self._stop_signal is None:\n                self._stop_signal = Event()\n            if self._stopped_signal is None:\n                self._stopped_signal = Event()\n\n            if allowed_updates is UNSET:\n                allowed_updates = self.resolve_used_update_types()\n\n            self._stop_signal.clear()\n            self._stopped_signal.clear()\n\n            if handle_signals:\n                loop = asyncio.get_running_loop()\n                with suppress(NotImplementedError):  # pragma: no cover\n                    # Signals handling is not supported on Windows\n                    # It also can't be covered on Windows\n                    loop.add_signal_handler(\n                        signal.SIGTERM, self._signal_stop_polling, signal.SIGTERM\n                    )\n                    loop.add_signal_handler(\n                        signal.SIGINT, self._signal_stop_polling, signal.SIGINT\n                    )\n\n            workflow_data = {\n                \"dispatcher\": self,\n                \"bots\": bots,\n                **self.workflow_data,\n                **kwargs,\n            }\n            if \"bot\" in workflow_data:\n                workflow_data.pop(\"bot\")\n\n            await self.emit_startup(bot=bots[-1], **workflow_data)\n            loggers.dispatcher.info(\"Start polling\")\n            try:\n                tasks: List[asyncio.Task[Any]] = [\n                    asyncio.create_task(\n                        self._polling(\n                            bot=bot,\n                            handle_as_tasks=handle_as_tasks,\n                            polling_timeout=polling_timeout,\n                            backoff_config=backoff_config,\n                            allowed_updates=allowed_updates,\n                            **workflow_data,\n                        )\n                    )\n                    for bot in bots\n                ]\n                tasks.append(asyncio.create_task(self._stop_signal.wait()))\n                done, pending = await asyncio.wait(tasks, return_when=asyncio.FIRST_COMPLETED)\n\n                for task in pending:\n                    # (mostly) Graceful shutdown unfinished tasks\n                    task.cancel()\n                    with suppress(CancelledError):\n                        await task\n                # Wait finished tasks to propagate unhandled exceptions\n                await asyncio.gather(*done)\n\n            finally:\n                loggers.dispatcher.info(\"Polling stopped\")\n                try:\n                    await self.emit_shutdown(bot=bots[-1], **workflow_data)\n                finally:\n                    if close_bot_session:\n                        await asyncio.gather(*(bot.session.close() for bot in bots))\n                self._stopped_signal.set()\n\n    def run_polling(\n        self,\n        *bots: Bot,\n        polling_timeout: int = 10,\n        handle_as_tasks: bool = True,\n        backoff_config: BackoffConfig = DEFAULT_BACKOFF_CONFIG,\n        allowed_updates: Optional[Union[List[str], UNSET_TYPE]] = UNSET,\n        handle_signals: bool = True,\n        close_bot_session: bool = True,\n        **kwargs: Any,\n    ) -> None:\n        \"\"\"\n        Run many bots with polling\n\n        :param bots: Bot instances (one or more)\n        :param polling_timeout: Long-polling wait time\n        :param handle_as_tasks: Run task for each event and no wait result\n        :param backoff_config: backoff-retry config\n        :param allowed_updates: List of the update types you want your bot to receive\n        :param handle_signals: handle signals (SIGINT/SIGTERM)\n        :param close_bot_session: close bot sessions on shutdown\n        :param kwargs: contextual data\n        :return:\n        \"\"\"\n        with suppress(KeyboardInterrupt):\n            return asyncio.run(\n                self.start_polling(\n                    *bots,\n                    **kwargs,\n                    polling_timeout=polling_timeout,\n                    handle_as_tasks=handle_as_tasks,\n                    backoff_config=backoff_config,\n                    allowed_updates=allowed_updates,\n                    handle_signals=handle_signals,\n                    close_bot_session=close_bot_session,\n                )\n            )","lineStart":280,"lineEnd":598,"totalLines":598,"truncated":false}},"title":"aiogram/dispatcher/dispatcher.py","time":{"start":1788484610293,"end":1788484610331}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_069fd68ee001Ico7Ea4JF8iPGq","sessionID":"ses_f9602b4c8ffeg2NhL92h7AtLNR","messageID":"msg_069fd60f6001Md0qdEo4r0uXf2"}}
