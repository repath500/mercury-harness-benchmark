{"type":"tool_use","timestamp":1788484767952,"sessionID":"ses_f9602b4c8ffeg2NhL92h7AtLNR","part":{"type":"tool","tool":"write","callID":"call_4eb9af70d039472f9f862a87","state":{"status":"completed","input":{"content":"Fix memory exhaustion in polling mode with concurrent updates.\n\nAdded a semaphore-based solution to limit the number of concurrent tasks when using :code:`handle_as_tasks=True` in polling mode.\nThis prevents Out of Memory (OOM) errors in memory-limited containers when there's a large queue of updates to process.\nYou can now control the maximum number of concurrent updates with the new :code:`tasks_concurrency_limit`\nparameter in :code:`start_polling()` and :code:`run_polling()` methods.\n","filePath":"/testbed/CHANGES/1658.bugfix.rst"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/testbed/CHANGES/1658.bugfix.rst","exists":false,"truncated":false},"title":"CHANGES/1658.bugfix.rst","time":{"start":1788484767927,"end":1788484767946}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_069ffd0b0001oxVwPY3dEtvB9f","sessionID":"ses_f9602b4c8ffeg2NhL92h7AtLNR","messageID":"msg_069ffc139001N1OygDxxf2U6el"}}
