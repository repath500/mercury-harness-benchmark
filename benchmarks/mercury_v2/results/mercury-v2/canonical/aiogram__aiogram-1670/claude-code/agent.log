{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a06a1e6ee979b3be632b6f","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport asyncio\n4\timport contextvars\n5\timport signal\n6\timport warnings\n7\tfrom asyncio import CancelledError, Event, Future, Lock\n8\tfrom contextlib import suppress\n9\tfrom typing import Any, AsyncGenerator, Dict, List, Optional, Set, Union\n10\t\n11\tfrom .. import loggers\n12\tfrom ..client.bot import Bot\n13\tfrom ..exceptions import TelegramAPIError\n14\tfrom ..fsm.middleware import FSMContextMiddleware\n15\tfrom ..fsm.storage.base import BaseEventIsolation, BaseStorage\n16\tfrom ..fsm.storage.memory import DisabledEventIsolation, MemoryStorage\n17\tfrom ..fsm.strategy import FSMStrategy\n18\tfrom ..methods import GetUpdates, TelegramMethod\n19\tfrom ..methods.base import TelegramType\n20\tfrom ..types import Update, User\n21\tfrom ..types.base import UNSET, UNSET_TYPE\n22\tfrom ..types.update import UpdateTypeLookupError\n23\tfrom ..utils.backoff import Backoff, BackoffConfig\n24\tfrom .event.bases import UNHANDLED, SkipHandler\n25\tfrom .event.telegram import TelegramEventObserver\n26\tfrom .middlewares.error import ErrorsMiddleware\n27\tfrom .middlewares.user_context import UserContextMiddleware\n28\tfrom .router import Router\n29\t\n30\tDEFAULT_BACKOFF_CONFIG = BackoffConfig(min_delay=1.0, max_delay=5.0, factor=1.3, jitter=0.1)\n31\t\n32\t\n33\tclass Dispatcher(Router):\n34\t    \"\"\"\n35\t    Root router\n36\t    \"\"\"\n37\t\n38\t    def __init__(\n39\t        self,\n40\t        *,  # * - Preventing to pass instance of Bot to the FSM storage\n41\t        storage: Optional[BaseStorage] = None,\n42\t        fsm_strategy: FSMStrategy = FSMStrategy.USER_IN_CHAT,\n43\t        events_isolation: Optional[BaseEventIsolation] = None,\n44\t        disable_fsm: bool = False,\n45\t        name: Optional[str] = None,\n46\t        **kwargs: Any,\n47\t    ) -> None:\n48\t        \"\"\"\n49\t        Root router\n50\t\n51\t        :param storage: Storage for FSM\n52\t        :param fsm_strategy: FSM strategy\n53\t        :param events_isolation: Events isolation\n54\t        :param disable_fsm: Disable FSM, note that if you disable FSM\n55\t            then you should not use storage and events isolation\n56\t        :param kwargs: Other arguments, will be passed as keyword arguments to handlers\n57\t        \"\"\"\n58\t        super(Dispatcher, self).__init__(name=name)\n59\t\n60\t        if storage and not isinstance(storage, BaseStorage):\n61\t            raise TypeError(\n62\t                f\"FSM storage should be instance of 'BaseStorage' not {type(storage).__name__}\"\n63\t            )\n64\t\n65\t        # Telegram API provides originally only one event type - Update\n66\t        # For making easily interactions with events here is registered handler which helps\n67\t        # to separate Update to different event types like Message, CallbackQuery etc.\n68\t        self.update = self.observers[\"update\"] = TelegramEventObserver(\n69\t            router=self, event_name=\"update\"\n70\t        )\n71\t        self.update.register(self._listen_update)\n72\t\n73\t        # Error handlers should work is out of all other functions\n74\t        # and should be registered before all others middlewares\n75\t        self.update.outer_middleware(ErrorsMiddleware(self))\n76\t\n77\t        # User context middleware makes small optimization for all other builtin\n78\t        # middlewares via caching the user and chat instances in the event context\n79\t        self.update.outer_middleware(UserContextMiddleware())\n80\t\n81\t        # FSM middleware should always be registered after User context middleware\n82\t        # because here is used context from previous step\n83\t        self.fsm = FSMContextMiddleware(\n84\t            storage=storage or MemoryStorage(),\n85\t            strategy=fsm_strategy,\n86\t            events_isolation=events_isolation or DisabledEventIsolation(),\n87\t        )\n88\t        if not disable_fsm:\n89\t            # Note that when FSM middleware is disabled, the event isolation is also disabled\n90\t            # Because the isolation mechanism is a part of the FSM\n91\t            self.update.outer_middleware(self.fsm)\n92\t        self.shutdown.register(self.fsm.close)\n93\t\n94\t        self.workflow_data: Dict[str, Any] = kwargs\n95\t        self._running_lock = Lock()\n96\t        self._stop_signal: Optional[Event] = None\n97\t        self._stopped_signal: Optional[Event] = None\n98\t        self._handle_update_tasks: Set[asyncio.Task[Any]] = set()\n99\t\n100\t    def __getitem__(self, item: str) -> Any:\n101\t        return self.workflow_data[item]\n102\t\n103\t    def __setitem__(self, key: str, value: Any) -> None:\n104\t        self.workflow_data[key] = value\n105\t\n106\t    def __delitem__(self, key: str) -> None:\n107\t        del self.workflow_data[key]\n108\t\n109\t    def get(self, key: str, /, default: Optional[Any] = None) -> Optional[Any]:\n110\t        return self.workflow_data.get(key, default)\n111\t\n112\t    @property\n113\t    def storage(self) -> BaseStorage:\n114\t        return self.fsm.storage\n115\t\n116\t    @property\n117\t    def parent_router(self) -> Optional[Router]:\n118\t        \"\"\"\n119\t        Dispatcher has no parent router and can't be included to any other routers or dispatchers\n120\t\n121\t        :return:\n122\t        \"\"\"\n123\t        return None  # noqa: RET501\n124\t\n125\t    @parent_router.setter\n126\t    def parent_router(self, value: Router) -> None:\n127\t        \"\"\"\n128\t        Dispatcher is root Router then configuring parent router is not allowed\n129\t\n130\t        :param value:\n131\t        :return:\n132\t        \"\"\"\n133\t        raise RuntimeError(\"Dispatcher can not be attached to another Router.\")\n134\t\n135\t    async def feed_update(self, bot: Bot, update: Update, **kwargs: Any) -> Any:\n136\t        \"\"\"\n137\t        Main entry point for incoming updates\n138\t        Response of this method can be used as Webhook response\n139\t\n140\t        :param bot:\n141\t        :param update:\n142\t        \"\"\"\n143\t        loop = asyncio.get_running_loop()\n144\t        handled = False\n145\t        start_time = loop.time()\n146\t\n147\t        if update.bot != bot:\n148\t            # Re-mounting update to the current bot instance for making possible to\n149\t            # use it in shortcuts.\n150\t            # Here is update is re-created because we need to propagate context to\n151\t            # all nested objects and attributes of the Update, but it\n152\t            # is impossible without roundtrip to JSON :(\n153\t            # The preferred way is that pass already mounted Bot instance to this update\n154\t            # before call feed_update method\n155\t            update = Update.model_validate(update.model_dump(), context={\"bot\": bot})\n156\t\n157\t        try:\n158\t            response = await self.update.wrap_outer_middleware(\n159\t                self.update.trigger,\n160\t                update,\n161\t                {\n162\t                    **self.workflow_data,\n163\t                    **kwargs,\n164\t                    \"bot\": bot,\n165\t                },\n166\t            )\n167\t            handled = response is not UNHANDLED\n168\t            return response\n169\t        finally:\n170\t            finish_time = loop.time()\n171\t            duration = (finish_time - start_time) * 1000\n172\t            loggers.event.info(\n173\t                \"Update id=%s is %s. Duration %d ms by bot id=%d\",\n174\t                update.update_id,\n175\t                \"handled\" if handled else \"not handled\",\n176\t                duration,\n177\t                bot.id,\n178\t            )\n179\t\n180\t    async def feed_raw_update(self, bot: Bot, update: Dict[str, Any], **kwargs: Any) -> Any:\n181\t        \"\"\"\n182\t        Main entry point for incoming updates with automatic Dict->Update serializer\n183\t\n184\t        :param bot:\n185\t        :param update:\n186\t        :param kwargs:\n187\t        \"\"\"\n188\t        parsed_update = Update.model_validate(update, context={\"bot\": bot})\n189\t        return await self._feed_webhook_update(bot=bot, update=parsed_update, **kwargs)\n190\t\n191\t    @classmethod\n192\t    async def _listen_updates(\n193\t        cls,\n194\t        bot: Bot,\n195\t        polling_timeout: int = 30,\n196\t        backoff_config: BackoffConfig = DEFAULT_BACKOFF_CONFIG,\n197\t        allowed_updates: Optional[List[str]] = None,\n198\t    ) -> AsyncGenerator[Update, None]:\n199\t        \"\"\"\n200\t        Endless updates reader with correctly handling any server-side or connection errors.\n201\t\n202\t        So you may not worry that the polling will stop working.\n203\t        \"\"\"\n204\t        backoff = Backoff(config=backoff_config)\n205\t        get_updates = GetUpdates(timeout=polling_timeout, allowed_updates=allowed_updates)\n206\t        kwargs = {}\n207\t        if bot.session.timeout:\n208\t            # Request timeout can be lower than session timeout and that's OK.\n209\t            # To prevent false-positive TimeoutError we should wait longer than polling timeout\n210\t            kwargs[\"request_timeout\"] = int(bot.session.timeout + polling_timeout)\n211\t        failed = False\n212\t        while True:\n213\t            try:\n214\t                updates = await bot(get_updates, **kwargs)\n215\t            except Exception as e:\n216\t                failed = True\n217\t                # In cases when Telegram Bot API was inaccessible don't need to stop polling\n218\t                # process because some developers can't make auto-restarting of the script\n219\t                loggers.dispatcher.error(\"Failed to fetch updates - %s: %s\", type(e).__name__, e)\n220\t                # And also backoff timeout is best practice to retry any network activity\n221\t                loggers.dispatcher.warning(\n222\t                    \"Sleep for %f seconds and try again... (tryings = %d, bot id = %d)\",\n223\t                    backoff.next_delay,\n224\t                    backoff.counter,\n225\t                    bot.id,\n226\t                )\n227\t                await backoff.asleep()\n228\t                continue\n229\t\n230\t            # In case when network connection was fixed let's reset the backoff\n231\t            # to initial value and then process updates\n232\t            if failed:\n233\t                loggers.dispatcher.info(\n234\t                    \"Connection established (tryings = %d, bot id = %d)\",\n235\t                    backoff.counter,\n236\t                    bot.id,\n237\t                )\n238\t                backoff.reset()\n239\t                failed = False\n240\t\n241\t            for update in updates:\n242\t                yield update\n243\t                # The getUpdates method returns the earliest 100 unconfirmed updates.\n244\t                # To confirm an update, use the offset parameter when calling getUpdates\n245\t                # All updates with update_id less than or equal to offset will be marked\n246\t                # as confirmed on the server and will no longer be returned.\n247\t                get_updates.offset = update.update_id + 1\n248\t\n249\t    async def _listen_update(self, update: Update, **kwargs: Any) -> Any:\n250\t        \"\"\"\n251\t        Main updates listener\n252\t\n253\t        Workflow:\n254\t        - Detect content type and propagate to observers in current router\n255\t        - If no one filter is pass - propagate update to child routers as Update\n256\t\n257\t        :param update:\n258\t        :param kwargs:\n259\t        :return:\n260\t        \"\"\"\n261\t        try:\n262\t            update_type = update.event_type\n263\t            event = update.event\n264\t        except UpdateTypeLookupError as e:\n265\t            warnings.warn(\n266\t                \"Detected unknown update type.\\n\"\n267\t                \"Seems like Telegram Bot API was updated and you have \"\n268\t                \"installed not latest version of aiogram framework\"\n269\t                f\"\\nUpdate: {update.model_dump_json(exclude_unset=True)}\",\n270\t                RuntimeWarning,\n271\t            )\n272\t            raise SkipHandler() from e\n273\t\n274\t        kwargs.update(event_update=update)\n275\t\n276\t        return await self.propagate_event(update_type=update_type, event=event, **kwargs)\n277\t\n278\t    @classmethod\n279\t    async def silent_call_request(cls, bot: Bot, result: TelegramMethod[Any]) -> None:\n280\t        \"\"\"\n281\t        Simulate answer into WebHook\n282\t\n283\t        :param bot:\n284\t        :param result:\n285\t        :return:\n286\t        \"\"\"\n287\t        try:\n288\t            await bot(result)\n289\t        except TelegramAPIError as e:\n290\t            # In due to WebHook mechanism doesn't allow getting response for\n291\t            # requests called in answer to WebHook request.\n292\t            # Need to skip unsuccessful responses.\n293\t            # For debugging here is added logging.\n294\t            loggers.event.error(\"Failed to make answer: %s: %s\", e.__class__.__name__, e)\n295\t\n296\t    async def _process_update(\n297\t        self, bot: Bot, update: Update, call_answer: bool = True, **kwargs: Any\n298\t    ) -> bool:\n299\t        \"\"\"\n300\t        Propagate update to event listeners\n301\t\n302\t        :param bot: instance of Bot\n303\t        :param update: instance of Update\n304\t        :param call_answer: need to execute response as Telegram method (like answer into webhook)\n305\t        :param kwargs: contextual data for middlewares, filters and handlers\n306\t        :return: status\n307\t        \"\"\"\n308\t        try:\n309\t            response = await self.feed_update(bot, update, **kwargs)\n310\t            if call_answer and isinstance(response, TelegramMethod):\n311\t                await self.silent_call_request(bot=bot, result=response)\n312\t            return response is not UNHANDLED\n313\t\n314\t        except Exception as e:\n315\t            loggers.event.exception(\n316\t                \"Cause exception while process update id=%d by bot id=%d\\n%s: %s\",\n317\t                update.update_id,\n318\t                bot.id,\n319\t                e.__class__.__name__,\n320\t                e,\n321\t            )\n322\t            return True  # because update was processed but unsuccessful\n323\t\n324\t    async def _polling(\n325\t        self,\n326\t        bot: Bot,\n327\t        polling_timeout: int = 30,\n328\t        handle_as_tasks: bool = True,\n329\t        backoff_config: BackoffConfig = DEFAULT_BACKOFF_CONFIG,\n330\t        allowed_updates: Optional[List[str]] = None,\n331\t        **kwargs: Any,\n332\t    ) -> None:\n333\t        \"\"\"\n334\t        Internal polling process\n335\t\n336\t        :param bot:\n337\t        :param kwargs:\n338\t        :return:\n339\t        \"\"\"\n340\t        user: User = await bot.me()\n341\t        loggers.dispatcher.info(\n342\t            \"Run polling for bot @%s id=%d - %r\", user.username, bot.id, user.full_name\n343\t        )\n344\t        try:\n345\t            async for update in self._listen_updates(\n346\t                bot,\n347\t                polling_timeout=polling_timeout,\n348\t                backoff_config=backoff_config,\n349\t                allowed_updates=allowed_updates,\n350\t            ):\n351\t                handle_update = self._process_update(bot=bot, update=update, **kwargs)\n352\t                if handle_as_tasks:\n353\t                    handle_update_task = asyncio.create_task(handle_update)\n354\t                    self._handle_update_tasks.add(handle_update_task)\n355\t                    handle_update_task.add_done_callback(self._handle_update_tasks.discard)\n356\t                else:\n357\t                    await handle_update\n358\t        finally:\n359\t            loggers.dispatcher.info(\n360\t                \"Polling stopped for bot @%s id=%d - %r\", user.username, bot.id, user.full_name\n361\t            )\n362\t\n363\t    async def _feed_webhook_update(self, bot: Bot, update: Update, **kwargs: Any) -> Any:\n364\t        \"\"\"\n365\t        The same with `Dispatcher.process_update()` but returns real response instead of bool\n366\t        \"\"\"\n367\t        try:\n368\t            return await self.feed_update(bot, update, **kwargs)\n369\t        except Exception as e:\n370\t            loggers.event.exception(\n371\t                \"Cause exception while process update id=%d by bot id=%d\\n%s: %s\",\n372\t                update.update_id,\n373\t                bot.id,\n374\t                e.__class__.__name__,\n375\t                e,\n376\t            )\n377\t            raise\n378\t\n379\t    async def feed_webhook_update(\n380\t        self, bot: Bot, update: Union[Update, Dict[str, Any]], _timeout: float = 55, **kwargs: Any\n381\t    ) -> Optional[TelegramMethod[TelegramType]]:\n382\t        if not isinstance(update, Update):  # Allow to use raw updates\n383\t            update = Update.model_validate(update, context={\"bot\": bot})\n384\t\n385\t        ctx = contextvars.copy_context()\n386\t        loop = asyncio.get_running_loop()\n387\t        waiter = loop.create_future()\n388\t\n389\t        def release_waiter(*_: Any) -> None:\n390\t            if not waiter.done():\n391\t                waiter.set_result(None)\n392\t\n393\t        timeout_handle = loop.call_later(_timeout, release_waiter)\n394\t\n395\t        process_updates: Future[Any] = asyncio.ensure_future(\n396\t            self._feed_webhook_update(bot=bot, update=update, **kwargs)\n397\t        )\n398\t        process_updates.add_done_callback(release_waiter, context=ctx)\n399\t\n400\t        def process_response(task: Future[Any]) -> None:\n401\t            warnings.warn(\n402\t                \"Detected slow response into webhook.\\n\"\n403\t                \"Telegram is waiting for response only first 60 seconds and then re-send update.\\n\"\n404\t                \"For preventing this situation response into webhook returned immediately \"\n405\t                \"and handler is moved to background and still processing update.\",\n406\t                RuntimeWarning,\n407\t            )\n408\t            try:\n409\t                result = task.result()\n410\t            except Exception as e:\n411\t                raise e\n412\t            if isinstance(result, TelegramMethod):\n413\t                asyncio.ensure_future(self.silent_call_request(bot=bot, result=result))\n414\t\n415\t        try:\n416\t            try:\n417\t                await waiter\n418\t            except CancelledError:  # pragma: no cover\n419\t                process_updates.remove_done_callback(release_waiter)\n420\t                process_updates.cancel()\n421\t                raise\n422\t\n423\t            if process_updates.done():\n424\t                # TODO: handle exceptions\n425\t                response: Any = process_updates.result()\n426\t                if isinstance(response, TelegramMethod):\n427\t                    return response\n428\t\n429\t            else:\n430\t                process_updates.remove_done_callback(release_waiter)\n431\t                process_updates.add_done_callback(process_response, context=ctx)\n432\t\n433\t        finally:\n434\t            timeout_handle.cancel()\n435\t\n436\t        return None\n437\t\n438\t    async def stop_polling(self) -> None:\n439\t        \"\"\"\n440\t        Execute this method if you want to stop polling programmatically\n441\t\n442\t        :return:\n443\t        \"\"\"\n444\t        if not self._running_lock.locked():\n445\t            raise RuntimeError(\"Polling is not started\")\n446\t        if not self._stop_signal or not self._stopped_signal:\n447\t            return\n448\t        self._stop_signal.set()\n449\t        await self._stopped_signal.wait()\n450\t\n451\t    def _signal_stop_polling(self, sig: signal.Signals) -> None:\n452\t        if not self._running_lock.locked():\n453\t            return\n454\t\n455\t        loggers.dispatcher.warning(\"Received %s signal\", sig.name)\n456\t        if not self._stop_signal:\n457\t            return\n458\t        self._stop_signal.set()\n459\t\n460\t    async def start_polling(\n461\t        self,\n462\t        *bots: Bot,\n463\t        polling_timeout: int = 10,\n464\t        handle_as_tasks: bool = True,\n465\t        backoff_config: BackoffConfig = DEFAULT_BACKOFF_CONFIG,\n466\t        allowed_updates: Optional[Union[List[str], UNSET_TYPE]] = UNSET,\n467\t        handle_signals: bool = True,\n468\t        close_bot_session: bool = True,\n469\t        **kwargs: Any,\n470\t    ) -> None:\n471\t        \"\"\"\n472\t        Polling runner\n473\t\n474\t        :param bots: Bot instances (one or more)\n475\t        :param polling_timeout: Long-polling wait time\n476\t        :param handle_as_tasks: Run task for each event and no wait result\n477\t        :param backoff_config: backoff-retry config\n478\t        :param allowed_updates: List of the update types you want your bot to receive\n479\t               By default, all used update types are enabled (resolved from handlers)\n480\t        :param handle_signals: handle signals (SIGINT/SIGTERM)\n481\t        :param close_bot_session: close bot sessions on shutdown\n482\t        :param kwargs: contextual data\n483\t        :return:\n484\t        \"\"\"\n485\t        if not bots:\n486\t            raise ValueError(\"At least one bot instance is required to start polling\")\n487\t        if \"bot\" in kwargs:\n488\t            raise ValueError(\n489\t                \"Keyword argument 'bot' is not acceptable, \"\n490\t                \"the bot instance should be passed as positional argument\"\n491\t            )\n492\t\n493\t        async with self._running_lock:  # Prevent to run this method twice at a once\n494\t            if self._stop_signal is None:\n495\t                self._stop_signal = Event()\n496\t            if self._stopped_signal is None:\n497\t                self._stopped_signal = Event()\n498\t\n499\t            if allowed_updates is UNSET:\n500\t                allowed_updates = self.resolve_used_update_types()\n501\t\n502\t            self._stop_signal.clear()\n503\t            self._stopped_signal.clear()\n504\t\n505\t            if handle_signals:\n506\t                loop = asyncio.get_running_loop()\n507\t                with suppress(NotImplementedError):  # pragma: no cover\n508\t                    # Signals handling is not supported on Windows\n509\t                    # It also can't be covered on Windows\n510\t                    loop.add_signal_handler(\n511\t                        signal.SIGTERM, self._signal_stop_polling, signal.SIGTERM\n512\t                    )\n513\t                    loop.add_signal_handler(\n514\t                        signal.SIGINT, self._signal_stop_polling, signal.SIGINT\n515\t                    )\n516\t\n517\t            workflow_data = {\n518\t                \"dispatcher\": self,\n519\t                \"bots\": bots,\n520\t                **self.workflow_data,\n521\t                **kwargs,\n522\t            }\n523\t            if \"bot\" in workflow_data:\n524\t                workflow_data.pop(\"bot\")\n525\t\n526\t            await self.emit_startup(bot=bots[-1], **workflow_data)\n527\t            loggers.dispatcher.info(\"Start polling\")\n528\t            try:\n529\t                tasks: List[asyncio.Task[Any]] = [\n530\t                    asyncio.create_task(\n531\t                        self._polling(\n532\t                            bot=bot,\n533\t                            handle_as_tasks=handle_as_tasks,\n534\t                            polling_timeout=polling_timeout,\n535\t                            backoff_config=backoff_config,\n536\t                            allowed_updates=allowed_updates,\n537\t                            **workflow_data,\n538\t                        )\n539\t                    )\n540\t                    for bot in bots\n541\t                ]\n542\t                tasks.append(asyncio.create_task(self._stop_signal.wait()))\n543\t                done, pending = await asyncio.wait(tasks, return_when=asyncio.FIRST_COMPLETED)\n544\t\n545\t                for task in pending:\n546\t                    # (mostly) Graceful shutdown unfinished tasks\n547\t                    task.cancel()\n548\t                    with suppress(CancelledError):\n549\t                        await task\n550\t                # Wait finished tasks to propagate unhandled exceptions\n551\t                await asyncio.gather(*done)\n552\t\n553\t            finally:\n554\t                loggers.dispatcher.info(\"Polling stopped\")\n555\t                try:\n556\t                    await self.emit_shutdown(bot=bots[-1], **workflow_data)\n557\t                finally:\n558\t                    if close_bot_session:\n559\t                        await asyncio.gather(*(bot.session.close() for bot in bots))\n560\t                self._stopped_signal.set()\n561\t\n562\t    def run_polling(\n563\t        self,\n564\t        *bots: Bot,\n565\t        polling_timeout: int = 10,\n566\t        handle_as_tasks: bool = True,\n567\t        backoff_config: BackoffConfig = DEFAULT_BACKOFF_CONFIG,\n568\t        allowed_updates: Optional[Union[List[str], UNSET_TYPE]] = UNSET,\n569\t        handle_signals: bool = True,\n570\t        close_bot_session: bool = True,\n571\t        **kwargs: Any,\n572\t    ) -> None:\n573\t        \"\"\"\n574\t        Run many bots with polling\n575\t\n576\t        :param bots: Bot instances (one or more)\n577\t        :param polling_timeout: Long-polling wait time\n578\t        :param handle_as_tasks: Run task for each event and no wait result\n579\t        :param backoff_config: backoff-retry config\n580\t        :param allowed_updates: List of the update types you want your bot to receive\n581\t        :param handle_signals: handle signals (SIGINT/SIGTERM)\n582\t        :param close_bot_session: close bot sessions on shutdown\n583\t        :param kwargs: contextual data\n584\t        :return:\n585\t        \"\"\"\n586\t        with suppress(KeyboardInterrupt):\n587\t            return asyncio.run(\n588\t                self.start_polling(\n589\t                    *bots,\n590\t                    **kwargs,\n591\t                    polling_timeout=polling_timeout,\n592\t                    handle_as_tasks=handle_as_tasks,\n593\t                    backoff_config=backoff_config,\n594\t                    allowed_updates=allowed_updates,\n595\t                    handle_signals=handle_signals,\n596\t                    close_bot_session=close_bot_session,\n597\t                )\n598\t            )\n599\t"}]},"parent_tool_use_id":null,"session_id":"1f1101d0-3721-48e8-b2bc-05484b9b7dc0","uuid":"83a78506-3b83-4d4e-8136-d6df873657c6","timestamp":"2026-09-04T01:52:54.881Z","tool_use_result":{"type":"text","file":{"filePath":"/testbed/aiogram/dispatcher/dispatcher.py","content":"from __future__ import annotations\n\nimport asyncio\nimport contextvars\nimport signal\nimport warnings\nfrom asyncio import CancelledError, Event, Future, Lock\nfrom contextlib import suppress\nfrom typing import Any, AsyncGenerator, Dict, List, Optional, Set, Union\n\nfrom .. import loggers\nfrom ..client.bot import Bot\nfrom ..exceptions import TelegramAPIError\nfrom ..fsm.middleware import FSMContextMiddleware\nfrom ..fsm.storage.base import BaseEventIsolation, BaseStorage\nfrom ..fsm.storage.memory import DisabledEventIsolation, MemoryStorage\nfrom ..fsm.strategy import FSMStrategy\nfrom ..methods import GetUpdates, TelegramMethod\nfrom ..methods.base import TelegramType\nfrom ..types import Update, User\nfrom ..types.base import UNSET, UNSET_TYPE\nfrom ..types.update import UpdateTypeLookupError\nfrom ..utils.backoff import Backoff, BackoffConfig\nfrom .event.bases import UNHANDLED, SkipHandler\nfrom .event.telegram import TelegramEventObserver\nfrom .middlewares.error import ErrorsMiddleware\nfrom .middlewares.user_context import UserContextMiddleware\nfrom .router import Router\n\nDEFAULT_BACKOFF_CONFIG = BackoffConfig(min_delay=1.0, max_delay=5.0, factor=1.3, jitter=0.1)\n\n\nclass Dispatcher(Router):\n    \"\"\"\n    Root router\n    \"\"\"\n\n    def __init__(\n        self,\n        *,  # * - Preventing to pass instance of Bot to the FSM storage\n        storage: Optional[BaseStorage] = None,\n        fsm_strategy: FSMStrategy = FSMStrategy.USER_IN_CHAT,\n        events_isolation: Optional[BaseEventIsolation] = None,\n        disable_fsm: bool = False,\n        name: Optional[str] = None,\n        **kwargs: Any,\n    ) -> None:\n        \"\"\"\n        Root router\n\n        :param storage: Storage for FSM\n        :param fsm_strategy: FSM strategy\n        :param events_isolation: Events isolation\n        :param disable_fsm: Disable FSM, note that if you disable FSM\n            then you should not use storage and events isolation\n        :param kwargs: Other arguments, will be passed as keyword arguments to handlers\n        \"\"\"\n        super(Dispatcher, self).__init__(name=name)\n\n        if storage and not isinstance(storage, BaseStorage):\n            raise TypeError(\n                f\"FSM storage should be instance of 'BaseStorage' not {type(storage).__name__}\"\n            )\n\n        # Telegram API provides originally only one event type - Update\n        # For making easily interactions with events here is registered handler which helps\n        # to separate Update to different event types like Message, CallbackQuery etc.\n        self.update = self.observers[\"update\"] = TelegramEventObserver(\n            router=self, event_name=\"update\"\n        )\n        self.update.register(self._listen_update)\n\n        # Error handlers should work is out of all other functions\n        # and should be registered before all others middlewares\n        self.update.outer_middleware(ErrorsMiddleware(self))\n\n        # User context middleware makes small optimization for all other builtin\n        # middlewares via caching the user and chat instances in the event context\n        self.update.outer_middleware(UserContextMiddleware())\n\n        # FSM middleware should always be registered after User context middleware\n        # because here is used context from previous step\n        self.fsm = FSMContextMiddleware(\n            storage=storage or MemoryStorage(),\n            strategy=fsm_strategy,\n            events_isolation=events_isolation or DisabledEventIsolation(),\n        )\n        if not disable_fsm:\n            # Note that when FSM middleware is disabled, the event isolation is also disabled\n            # Because the isolation mechanism is a part of the FSM\n            self.update.outer_middleware(self.fsm)\n        self.shutdown.register(self.fsm.close)\n\n        self.workflow_data: Dict[str, Any] = kwargs\n        self._running_lock = Lock()\n        self._stop_signal: Optional[Event] = None\n        self._stopped_signal: Optional[Event] = None\n        self._handle_update_tasks: Set[asyncio.Task[Any]] = set()\n\n    def __getitem__(self, item: str) -> Any:\n        return self.workflow_data[item]\n\n    def __setitem__(self, key: str, value: Any) -> None:\n        self.workflow_data[key] = value\n\n    def __delitem__(self, key: str) -> None:\n        del self.workflow_data[key]\n\n    def get(self, key: str, /, default: Optional[Any] = None) -> Optional[Any]:\n        return self.workflow_data.get(key, default)\n\n    @property\n    def storage(self) -> BaseStorage:\n        return self.fsm.storage\n\n    @property\n    def parent_router(self) -> Optional[Router]:\n        \"\"\"\n        Dispatcher has no parent router and can't be included to any other routers or dispatchers\n\n        :return:\n        \"\"\"\n        return None  # noqa: RET501\n\n    @parent_router.setter\n    def parent_router(self, value: Router) -> None:\n        \"\"\"\n        Dispatcher is root Router then configuring parent router is not allowed\n\n        :param value:\n        :return:\n        \"\"\"\n        raise RuntimeError(\"Dispatcher can not be attached to another Router.\")\n\n    async def feed_update(self, bot: Bot, update: Update, **kwargs: Any) -> Any:\n        \"\"\"\n        Main entry point for incoming updates\n        Response of this method can be used as Webhook response\n\n        :param bot:\n        :param update:\n        \"\"\"\n        loop = asyncio.get_running_loop()\n        handled = False\n        start_time = loop.time()\n\n        if update.bot != bot:\n            # Re-mounting update to the current bot instance for making possible to\n            # use it in shortcuts.\n            # Here is update is re-created because we need to propagate context to\n            # all nested objects and attributes of the Update, but it\n            # is impossible without roundtrip to JSON :(\n            # The preferred way is that pass already mounted Bot instance to this update\n            # before call feed_update method\n            update = Update.model_validate(update.model_dump(), context={\"bot\": bot})\n\n        try:\n            response = await self.update.wrap_outer_middleware(\n                self.update.trigger,\n                update,\n                {\n                    **self.workflow_data,\n                    **kwargs,\n                    \"bot\": bot,\n                },\n            )\n            handled = response is not UNHANDLED\n            return response\n        finally:\n            finish_time = loop.time()\n            duration = (finish_time - start_time) * 1000\n            loggers.event.info(\n                \"Update id=%s is %s. Duration %d ms by bot id=%d\",\n                update.update_id,\n                \"handled\" if handled else \"not handled\",\n                duration,\n                bot.id,\n            )\n\n    async def feed_raw_update(self, bot: Bot, update: Dict[str, Any], **kwargs: Any) -> Any:\n        \"\"\"\n        Main entry point for incoming updates with automatic Dict->Update serializer\n\n        :param bot:\n        :param update:\n        :param kwargs:\n        \"\"\"\n        parsed_update = Update.model_validate(update, context={\"bot\": bot})\n        return await self._feed_webhook_update(bot=bot, update=parsed_update, **kwargs)\n\n    @classmethod\n    async def _listen_updates(\n        cls,\n        bot: Bot,\n        polling_timeout: int = 30,\n        backoff_config: BackoffConfig = DEFAULT_BACKOFF_CONFIG,\n        allowed_updates: Optional[List[str]] = None,\n    ) -> AsyncGenerator[Update, None]:\n        \"\"\"\n        Endless updates reader with correctly handling any server-side or connection errors.\n\n        So you may not worry that the polling will stop working.\n        \"\"\"\n        backoff = Backoff(config=backoff_config)\n        get_updates = GetUpdates(timeout=polling_timeout, allowed_updates=allowed_updates)\n        kwargs = {}\n        if bot.session.timeout:\n            # Request timeout can be lower than session timeout and that's OK.\n            # To prevent false-positive TimeoutError we should wait longer than polling timeout\n            kwargs[\"request_timeout\"] = int(bot.session.timeout + polling_timeout)\n        failed = False\n        while True:\n            try:\n                updates = await bot(get_updates, **kwargs)\n            except Exception as e:\n                failed = True\n                # In cases when Telegram Bot API was inaccessible don't need to stop polling\n                # process because some developers can't make auto-restarting of the script\n                loggers.dispatcher.error(\"Failed to fetch updates - %s: %s\", type(e).__name__, e)\n                # And also backoff timeout is best practice to retry any network activity\n                loggers.dispatcher.warning(\n                    \"Sleep for %f seconds and try again... (tryings = %d, bot id = %d)\",\n                    backoff.next_delay,\n                    backoff.counter,\n                    bot.id,\n                )\n                await backoff.asleep()\n                continue\n\n            # In case when network connection was fixed let's reset the backoff\n            # to initial value and then process updates\n            if failed:\n                loggers.dispatcher.info(\n                    \"Connection established (tryings = %d, bot id = %d)\",\n                    backoff.counter,\n                    bot.id,\n                )\n                backoff.reset()\n                failed = False\n\n            for update in updates:\n                yield update\n                # The getUpdates method returns the earliest 100 unconfirmed updates.\n                # To confirm an update, use the offset parameter when calling getUpdates\n                # All updates with update_id less than or equal to offset will be marked\n                # as confirmed on the server and will no longer be returned.\n                get_updates.offset = update.update_id + 1\n\n    async def _listen_update(self, update: Update, **kwargs: Any) -> Any:\n        \"\"\"\n        Main updates listener\n\n        Workflow:\n        - Detect content type and propagate to observers in current router\n        - If no one filter is pass - propagate update to child routers as Update\n\n        :param update:\n        :param kwargs:\n        :return:\n        \"\"\"\n        try:\n            update_type = update.event_type\n            event = update.event\n        except UpdateTypeLookupError as e:\n            warnings.warn(\n                \"Detected unknown update type.\\n\"\n                \"Seems like Telegram Bot API was updated and you have \"\n                \"installed not latest version of aiogram framework\"\n                f\"\\nUpdate: {update.model_dump_json(exclude_unset=True)}\",\n                RuntimeWarning,\n            )\n            raise SkipHandler() from e\n\n        kwargs.update(event_update=update)\n\n        return await self.propagate_event(update_type=update_type, event=event, **kwargs)\n\n    @classmethod\n    async def silent_call_request(cls, bot: Bot, result: TelegramMethod[Any]) -> None:\n        \"\"\"\n        Simulate answer into WebHook\n\n        :param bot:\n        :param result:\n        :return:\n        \"\"\"\n        try:\n            await bot(result)\n        except TelegramAPIError as e:\n            # In due to WebHook mechanism doesn't allow getting response for\n            # requests called in answer to WebHook request.\n            # Need to skip unsuccessful responses.\n            # For debugging here is added logging.\n            loggers.event.error(\"Failed to make answer: %s: %s\", e.__class__.__name__, e)\n\n    async def _process_update(\n        self, bot: Bot, update: Update, call_answer: bool = True, **kwargs: Any\n    ) -> bool:\n        \"\"\"\n        Propagate update to event listeners\n\n        :param bot: instance of Bot\n        :param update: instance of Update\n        :param call_answer: need to execute response as Telegram method (like answer into webhook)\n        :param kwargs: contextual data for middlewares, filters and handlers\n        :return: status\n        \"\"\"\n        try:\n            response = await self.feed_update(bot, update, **kwargs)\n            if call_answer and isinstance(response, TelegramMethod):\n                await self.silent_call_request(bot=bot, result=response)\n            return response is not UNHANDLED\n\n        except Exception as e:\n            loggers.event.exception(\n                \"Cause exception while process update id=%d by bot id=%d\\n%s: %s\",\n                update.update_id,\n                bot.id,\n                e.__class__.__name__,\n                e,\n            )\n            return True  # because update was processed but unsuccessful\n\n    async def _polling(\n        self,\n        bot: Bot,\n        polling_timeout: int = 30,\n        handle_as_tasks: bool = True,\n        backoff_config: BackoffConfig = DEFAULT_BACKOFF_CONFIG,\n        allowed_updates: Optional[List[str]] = None,\n        **kwargs: Any,\n    ) -> None:\n        \"\"\"\n        Internal polling process\n\n        :param bot:\n        :param kwargs:\n        :return:\n        \"\"\"\n        user: User = await bot.me()\n        loggers.dispatcher.info(\n            \"Run polling for bot @%s id=%d - %r\", user.username, bot.id, user.full_name\n        )\n        try:\n            async for update in self._listen_updates(\n                bot,\n                polling_timeout=polling_timeout,\n                backoff_config=backoff_config,\n                allowed_updates=allowed_updates,\n            ):\n                handle_update = self._process_update(bot=bot, update=update, **kwargs)\n                if handle_as_tasks:\n                    handle_update_task = asyncio.create_task(handle_update)\n                    self._handle_update_tasks.add(handle_update_task)\n                    handle_update_task.add_done_callback(self._handle_update_tasks.discard)\n                else:\n                    await handle_update\n        finally:\n            loggers.dispatcher.info(\n                \"Polling stopped for bot @%s id=%d - %r\", user.username, bot.id, user.full_name\n            )\n\n    async def _feed_webhook_update(self, bot: Bot, update: Update, **kwargs: Any) -> Any:\n        \"\"\"\n        The same with `Dispatcher.process_update()` but returns real response instead of bool\n        \"\"\"\n        try:\n            return await self.feed_update(bot, update, **kwargs)\n        except Exception as e:\n            loggers.event.exception(\n                \"Cause exception while process update id=%d by bot id=%d\\n%s: %s\",\n                update.update_id,\n                bot.id,\n                e.__class__.__name__,\n                e,\n            )\n            raise\n\n    async def feed_webhook_update(\n        self, bot: Bot, update: Union[Update, Dict[str, Any]], _timeout: float = 55, **kwargs: Any\n    ) -> Optional[TelegramMethod[TelegramType]]:\n        if not isinstance(update, Update):  # Allow to use raw updates\n            update = Update.model_validate(update, context={\"bot\": bot})\n\n        ctx = contextvars.copy_context()\n        loop = asyncio.get_running_loop()\n        waiter = loop.create_future()\n\n        def release_waiter(*_: Any) -> None:\n            if not waiter.done():\n                waiter.set_result(None)\n\n        timeout_handle = loop.call_later(_timeout, release_waiter)\n\n        process_updates: Future[Any] = asyncio.ensure_future(\n            self._feed_webhook_update(bot=bot, update=update, **kwargs)\n        )\n        process_updates.add_done_callback(release_waiter, context=ctx)\n\n        def process_response(task: Future[Any]) -> None:\n            warnings.warn(\n                \"Detected slow response into webhook.\\n\"\n                \"Telegram is waiting for response only first 60 seconds and then re-send update.\\n\"\n                \"For preventing this situation response into webhook returned immediately \"\n                \"and handler is moved to background and still processing update.\",\n                RuntimeWarning,\n            )\n            try:\n                result = task.result()\n            except Exception as e:\n                raise e\n            if isinstance(result, TelegramMethod):\n                asyncio.ensure_future(self.silent_call_request(bot=bot, result=result))\n\n        try:\n            try:\n                await waiter\n            except CancelledError:  # pragma: no cover\n                process_updates.remove_done_callback(release_waiter)\n                process_updates.cancel()\n                raise\n\n            if process_updates.done():\n                # TODO: handle exceptions\n                response: Any = process_updates.result()\n                if isinstance(response, TelegramMethod):\n                    return response\n\n            else:\n                process_updates.remove_done_callback(release_waiter)\n                process_updates.add_done_callback(process_response, context=ctx)\n\n        finally:\n            timeout_handle.cancel()\n\n        return None\n\n    async def stop_polling(self) -> None:\n        \"\"\"\n        Execute this method if you want to stop polling programmatically\n\n        :return:\n        \"\"\"\n        if not self._running_lock.locked():\n            raise RuntimeError(\"Polling is not started\")\n        if not self._stop_signal or not self._stopped_signal:\n            return\n        self._stop_signal.set()\n        await self._stopped_signal.wait()\n\n    def _signal_stop_polling(self, sig: signal.Signals) -> None:\n        if not self._running_lock.locked():\n            return\n\n        loggers.dispatcher.warning(\"Received %s signal\", sig.name)\n        if not self._stop_signal:\n            return\n        self._stop_signal.set()\n\n    async def start_polling(\n        self,\n        *bots: Bot,\n        polling_timeout: int = 10,\n        handle_as_tasks: bool = True,\n        backoff_config: BackoffConfig = DEFAULT_BACKOFF_CONFIG,\n        allowed_updates: Optional[Union[List[str], UNSET_TYPE]] = UNSET,\n        handle_signals: bool = True,\n        close_bot_session: bool = True,\n        **kwargs: Any,\n    ) -> None:\n        \"\"\"\n        Polling runner\n\n        :param bots: Bot instances (one or more)\n        :param polling_timeout: Long-polling wait time\n        :param handle_as_tasks: Run task for each event and no wait result\n        :param backoff_config: backoff-retry config\n        :param allowed_updates: List of the update types you want your bot to receive\n               By default, all used update types are enabled (resolved from handlers)\n        :param handle_signals: handle signals (SIGINT/SIGTERM)\n        :param close_bot_session: close bot sessions on shutdown\n        :param kwargs: contextual data\n        :return:\n        \"\"\"\n        if not bots:\n            raise ValueError(\"At least one bot instance is required to start polling\")\n        if \"bot\" in kwargs:\n            raise ValueError(\n                \"Keyword argument 'bot' is not acceptable, \"\n                \"the bot instance should be passed as positional argument\"\n            )\n\n        async with self._running_lock:  # Prevent to run this method twice at a once\n            if self._stop_signal is None:\n                self._stop_signal = Event()\n            if self._stopped_signal is None:\n                self._stopped_signal = Event()\n\n            if allowed_updates is UNSET:\n                allowed_updates = self.resolve_used_update_types()\n\n            self._stop_signal.clear()\n            self._stopped_signal.clear()\n\n            if handle_signals:\n                loop = asyncio.get_running_loop()\n                with suppress(NotImplementedError):  # pragma: no cover\n                    # Signals handling is not supported on Windows\n                    # It also can't be covered on Windows\n                    loop.add_signal_handler(\n                        signal.SIGTERM, self._signal_stop_polling, signal.SIGTERM\n                    )\n                    loop.add_signal_handler(\n                        signal.SIGINT, self._signal_stop_polling, signal.SIGINT\n                    )\n\n            workflow_data = {\n                \"dispatcher\": self,\n                \"bots\": bots,\n                **self.workflow_data,\n                **kwargs,\n            }\n            if \"bot\" in workflow_data:\n                workflow_data.pop(\"bot\")\n\n            await self.emit_startup(bot=bots[-1], **workflow_data)\n            loggers.dispatcher.info(\"Start polling\")\n            try:\n                tasks: List[asyncio.Task[Any]] = [\n                    asyncio.create_task(\n                        self._polling(\n                            bot=bot,\n                            handle_as_tasks=handle_as_tasks,\n                            polling_timeout=polling_timeout,\n                            backoff_config=backoff_config,\n                            allowed_updates=allowed_updates,\n                            **workflow_data,\n                        )\n                    )\n                    for bot in bots\n                ]\n                tasks.append(asyncio.create_task(self._stop_signal.wait()))\n                done, pending = await asyncio.wait(tasks, return_when=asyncio.FIRST_COMPLETED)\n\n                for task in pending:\n                    # (mostly) Graceful shutdown unfinished tasks\n                    task.cancel()\n                    with suppress(CancelledError):\n                        await task\n                # Wait finished tasks to propagate unhandled exceptions\n                await asyncio.gather(*done)\n\n            finally:\n                loggers.dispatcher.info(\"Polling stopped\")\n                try:\n                    await self.emit_shutdown(bot=bots[-1], **workflow_data)\n                finally:\n                    if close_bot_session:\n                        await asyncio.gather(*(bot.session.close() for bot in bots))\n                self._stopped_signal.set()\n\n    def run_polling(\n        self,\n        *bots: Bot,\n        polling_timeout: int = 10,\n        handle_as_tasks: bool = True,\n        backoff_config: BackoffConfig = DEFAULT_BACKOFF_CONFIG,\n        allowed_updates: Optional[Union[List[str], UNSET_TYPE]] = UNSET,\n        handle_signals: bool = True,\n        close_bot_session: bool = True,\n        **kwargs: Any,\n    ) -> None:\n        \"\"\"\n        Run many bots with polling\n\n        :param bots: Bot instances (one or more)\n        :param polling_timeout: Long-polling wait time\n        :param handle_as_tasks: Run task for each event and no wait result\n        :param backoff_config: backoff-retry config\n        :param allowed_updates: List of the update types you want your bot to receive\n        :param handle_signals: handle signals (SIGINT/SIGTERM)\n        :param close_bot_session: close bot sessions on shutdown\n        :param kwargs: contextual data\n        :return:\n        \"\"\"\n        with suppress(KeyboardInterrupt):\n            return asyncio.run(\n                self.start_polling(\n                    *bots,\n                    **kwargs,\n                    polling_timeout=polling_timeout,\n                    handle_as_tasks=handle_as_tasks,\n                    backoff_config=backoff_config,\n                    allowed_updates=allowed_updates,\n                    handle_signals=handle_signals,\n                    close_bot_session=close_bot_session,\n                )\n            )\n","numLines":599,"startLine":1,"totalLines":599}}}
