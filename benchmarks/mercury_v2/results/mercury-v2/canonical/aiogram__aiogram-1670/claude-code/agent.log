{"type":"assistant","message":{"id":"gen-1788486899-GiBRPVpPaecdf286uMEu","type":"message","role":"assistant","container":null,"content":[{"type":"tool_use","id":"call_01a06a20583d72508a6dab98","caller":{"type":"direct"},"name":"Bash","input":{"command":"python - <<'EOF'\nimport asyncio\nfrom unittest.mock import patch, AsyncMock\n\nfrom tests.mocked_bot import MockedBot\nfrom aiogram import Dispatcher\nfrom aiogram.types import Update\n\n\nasync def main():\n    bot = MockedBot()\n    dispatcher = Dispatcher()\n\n    active = 0\n    max_active = 0\n    processed = []\n\n    @dispatcher.update()\n    async def handler(update: Update):\n        nonlocal active, max_active\n        active += 1\n        max_active = max(max_active, active)\n        await asyncio.sleep(0.05)\n        if update.update_id % 2 == 1:\n            raise RuntimeError(\"boom\")  # failures must also release the slot\n        active -= 1\n        processed.append(update.update_id)\n\n    async def mock_updates(*_):\n        for i in range(10):\n            yield Update(update_id=i)\n\n    with (\n        patch.object(dispatcher, \"_listen_updates\", return_value=mock_updates()),\n        patch.object(Router := dispatcher, \"emit_startup\", new_callable=AsyncMock),\n        patch.object(type(dispatcher), \"emit_shutdown\", new_callable=AsyncMock),\n    ):\n        # 1) With limit=2: at most 2 concurrent tasks, all updates processed\n        await dispatcher.start_polling(bot, tasks_concurrency_limit=2)\n        assert max_active <= 2, f\"limit violated: {max_active}\"\n        assert len(processed) == 5, f\"only even ids processed: {processed}\"\n        print(f\"limit=2: max_active={max_active}, processed={processed} -> OK\")\n\n        # 2) No limit: behavior unchanged (all 10 run concurrently)\n        dispatcher._handle_update_tasks.clear()\n        active = max_active = 0\n        processed = []\n        await dispatcher.start_polling(bot)\n        assert max_active == 10, f\"expected unlimited concurrency, got {max_active}\"\n        print(f\"no limit: max_active={max_active} -> OK\")\n\n        # 3) handle_as_tasks=False: limit must not apply (sequential awaiting)\n        active = max_active = 0\n        with patch.object(\n            type(dispatcher), \"_listen_updates\", return_value=mock_updates()\n        ):\n            await dispatcher.start_polling(\n                bot, handle_as_tasks=False, tasks_concurrency_limit=2\n            )\n        assert max_active == 1, f\"sequential mode shouldn't stack tasks: {max_active}\"\n        print(f\"handle_as_tasks=False: max_active={max_active} -> OK\")\n\n\nasyncio.run(main())\nprint(\"ALL END-TO-END CHECKS PASSED\")\nEOF","description":"End-to-end verification of concurrency limit via start_polling","timeout":120000}}],"model":"z-ai/glm-5.3-flash","stop_reason":null,"stop_details":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0,"output_tokens_details":null,"cache_creation_input_tokens":null,"cache_read_input_tokens":null,"cache_creation":null,"inference_geo":null,"server_tool_use":null,"service_tier":null,"speed":"standard"},"provider":"Together","context_management":null},"parent_tool_use_id":null,"session_id":"1f1101d0-3721-48e8-b2bc-05484b9b7dc0","uuid":"8e6d5af2-a4a7-4aa7-aa0e-83dcae019c07","timestamp":"2026-09-04T01:55:07.632Z","request_id":"gen-1788486899-GiBRPVpPaecdf286uMEu"}
