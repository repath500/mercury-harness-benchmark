ndex.data_keys[\"repo\"]\n56:         )\n57:         dvc_info[\"isdvc\"] = dvc_info[\"isout\"]\n58:         ret[\"dvc_info\"] = dvc_info\n59:         ret[\"type\"] = dvc_info[\"type\"]\n60:         ret[\"size\"] = dvc_info[\"size\"]\n61:         if not fs_info and \"md5\" in dvc_info:\n62:             ret[\"md5\"] = dvc_info[\"md5\"]\n63:         if not fs_info and \"md5-dos2unix\" in dvc_info:\n64:             ret[\"md5-dos2unix\"] = dvc_info[\"md5-dos2unix\"]\n65: \n66:     if fs_info:\n67:         ret[\"type\"] = fs_info[\"type\"]\n68:         ret[\"size\"] = fs_info[\"size\"]\n69:         ret[\"fs_info\"] = fs_info\n70:         isexec = False\n71:         if fs_info[\"type\"] == \"file\":\n72:             isexec = utils.is_exec(fs_info[\"mode\"])\n73:         ret[\"isexec\"] = isexec\n74: \n75:     return ret\n76: \n77: \n78: def _get_dvc_path(dvc_fs, subkey):\n79:     return dvc_fs.join(*subkey) if subkey else \"\"\n80: \n81: \n82: class _DVCFileSystem(AbstractFileSystem):\n83:     cachable = False\n84:     root_marker = \"/\"\n85: \n86:     def __init__(  # noqa: PLR0913\n87:         self,\n88:         url: Optional[str] = None,\n89:         rev: Optional[str] = None,\n90:         repo: Optional[\"Repo\"] = None,\n91:         subrepos: bool = False,\n92:         repo_factory: Optional[RepoFactory] = None,\n93:         fo: Optional[str] = None,\n94:         target_options: Optional[dict[str, Any]] = None,  # noqa: ARG002\n95:         target_protocol: Optional[str] = None,  # noqa: ARG002\n96:         config: Optional[\"DictStrAny\"] = None,\n97:         remote: Optional[str] = None,\n98:         remote_config: Optional[\"DictStrAny\"] = None,\n99:         **kwargs,\n100:     ) -> None:\n101:         \"\"\"DVC + git-tracked files fs.\n102: \n103:         Args:\n104:             path (str, optional): URL or path to a DVC/Git repository.\n105:                 Defaults to a DVC repository in the current working directory.\n106:                 Both HTTP and SSH protocols are supported for remote Git repos\n107:                 (e.g. [user@]server:project.git).\n108:             rev (str, optional): Any Git revision such as a branch or tag name,\n109:                 a commit hash or a dvc experiment name.\n110:                 Defaults to the default branch in case of remote repositories.\n111:                 In case of a local repository, if rev is unspecified, it will\n112:                 default to the working directory.\n113:                 If the repo is not a Git repo, this option is ignored.\n114:             repo (:obj:`Repo`, optional): `Repo` instance.\n115:             subrepos (bool): traverse to subrepos.\n116:                 By default, it ignores subrepos.\n117:             repo_factory (callable): A function to initialize subrepo with.\n118:                 The default is `Repo`.\n119:             config (dict): Repo config to be passed into `repo_factory`.\n120:             remote (str): Remote name to be passed into `repo_factory`.\n121:             remote_config(dict): Remote config to be passed into `repo_factory`.\n122: \n123:         Examples:\n124:             - Opening a filesystem from repo in current working directory\n125: \n126:             >>> fs = DVCFileSystem()\n127: \n128:             - Opening a filesystem from local repository\n129: \n130:             >>> fs = DVCFileSystem(\"path/to/local/repository\")\n131: \n132:             - Opening a remote repository\n133: \n134:             >>> fs = DVCFileSystem(\n135:             ...    \"https://github.com/iterative/example-get-started\",\n136:             ...    rev=\"main\",\n137:             ... )\n138:         \"\"\"\n139:         super().__init__()\n140:         self._repo = repo\n141:         self._repo_factory = repo_factory\n142:         self._traverse_subrepos = subrepos\n143:         self._repo_stack = ExitStack()\n144:         self._repo_kwargs = {\n145:             \"url\": url if url is not None else fo,\n146:             \"rev\": rev,\n147:             \"subrepos\": subrepos,\n148:             \"config\": config,\n149:             \"remote\": remote,\n150:             \"remote_config\": remote_config,\n151:         }\n152: \n153:     def getcwd(self):\n154:         relparts: tuple[str, ...] = ()\n155:         assert self.repo is not None\n156:         if self.repo.fs.isin(self.repo.fs.getcwd(), self.repo.root_dir):\n157:             relparts = self.repo.fs.relparts(self.repo.fs.getcwd(), self.repo.root_dir)\n158:         return self.root_marker + self.sep.join(relparts)\n159: \n160:     @classmethod\n161:     def join(cls, *parts: str) -> str:\n162:         return posixpath.join(*parts)\n163: \n164:     @classmethod\n165:     def parts(cls, path: str) -> tuple[str, ...]:\n166:         ret = []\n167:         while True:\n168:             path, part = posixpath.split(path)\n169: \n170:             if part:\n171:                 ret.append(part)\n172:                 continue\n173: \n174:             if path:\n175:                 ret.append(path)\n176: \n177:             break\n178: \n179:         ret.reverse()\n180: \n181:         return tuple(ret)\n182: \n183:     def normpath(self, path: str) -> str:\n184:         return posixpath.normpath(path)\n185: \n186:     def abspath(self, path: str) -> str:\n187:         if not posixpath.isabs(path):\n188:             path = self.join(self.getcwd(), path)\n189:         return self.normpath(path)\n190: \n191:     def relpath(self, path: str, start: Optional[str] = None) -> str:\n192:         if start is None:\n193:             start = \".\"\n194:         return posixpath.relpath(self.abspath(path), start=self.abspath(start))\n195: \n196:     def relparts(self, path: str, start: Optional[str] = None) -> tuple[str, ...]:\n197:         return self.parts(self.relpath(path, start=start))\n198: \n199:     @functools.cached_property\n200:     def repo(self):\n201:         if self._repo:\n202:             return self._repo\n203: \n204:         repo = self._make_repo(**self._repo_kwargs)\n205: \n206:         self._repo_stack.enter_context(repo)\n207:         self._repo = repo\n208:         return repo\n209: \n210:     @functools.cached_property\n211:     def repo_factory(self):\n212:         if self._repo_factory:\n213:             return self._repo_factory\n214: \n215:         if self._repo:\n216:             from dvc.repo import Repo\n217: \n218:             return Repo\n219: \n220:         return self.repo._fs_conf[\"repo_factory\"]\n221: \n222:     @functools.cached_property\n223:     def fsid(self) -> str:\n224:         from fsspec.utils import tokenize\n225: \n226:         from dvc.scm import NoSCM\n227: \n228:         return \"dvcfs_\" + tokenize(\n229:             self.repo.url or self.repo.root_dir,\n230:             self.repo.get_rev() if not isinstance(self.repo.scm, NoSCM) else None,\n231:         )\n232: \n233:     def _get_key(self, path: \"StrPath\") -> Key:\n234:         path = os.fspath(path)\n235:         parts = self.repo.fs.relparts(path, self.repo.root_dir)\n236:         if parts == (os.curdir,):\n237:             return ()\n238:         return parts\n239: \n240:     @functools.cached_property\n241:     def _subrepos_trie(self):\n242:         \"\"\"Keeps track of each and every path with the corresponding repo.\"\"\"\n243: \n244:         from pygtrie import Trie\n245: \n246:         trie = Trie()\n247:         key = self._get_key(self.repo.root_dir)\n248:         trie[key] = self.repo\n249:         return trie\n250: \n251:     def _get_key_from_relative(self, path) -> Key:\n252:         path = self._strip_protocol(path)\n253:         parts = self.relparts(path, self.root_marker)\n254:         if parts and parts[0] == os.curdir:\n255:             return parts[1:]\n256:         return parts\n257: \n258:     def _from_key(self, parts: Key) -> str:\n259:         return self.repo.fs.join(self.repo.root_dir, *parts)\n260: \n261:     @functools.cached_property\n262:     def _datafss(self):\n263:         \"\"\"Keep a datafs instance of each repo.\"\"\"\n264: \n265:         datafss = {}\n266: \n267:         if hasattr(self.repo, \"dvc_dir\"):\n268:             key = self._get_key(self.repo.root_dir)\n269:             datafss[key] = DataFileSystem(index=self.repo.index.data[\"repo\"])\n270: \n271:         return datafss\n272: \n273:     @property\n274:     def repo_url(self):\n275:         return self.repo.url\n276: \n277:     @classmethod\n278:     def _make_repo(cls, **kwargs) -> \"Repo\":\n279:         from dvc.repo import Repo\n280: \n281:         with Repo.open(uninitialized=True, **kwargs) as repo:\n282:             return repo\n283: \n284:     def _get_repo(self, key: Key) -> \"Repo\":\n285:         \"\"\"Returns repo that the path falls in, using prefix.\n286: \n287:         If the path is already tracked/collected, it just returns the repo.\n288: \n289:         Otherwise, it collects the repos that might be in the path's parents\n290:         and then returns the appropriate one.\n291:         \"\"\"\n292:         repo = self._subrepos_trie.get(key)\n293:         if repo:\n294:             return repo\n295: \n296:         prefix_key, repo = self._subrepos_trie.longest_prefix(key)\n297:         dir_keys = (key[:i] for i in range(len(prefix_key) + 1, len(key) + 1))\n298:         self._update(dir_keys, starting_repo=repo)\n299:         return self._subrepos_trie.get(key) or self.repo\n300: \n301:     @wrap_with(threading.Lock())\n302:     def _update(self, dir_keys, starting_repo):\n303:         \"\"\"Checks for subrepo in directories and updates them.\"\"\"\n304:         repo = starting_repo\n305:         for key in dir_keys:\n306:             d = self._from_key(key)\n307:             if self._is_dvc_repo(d):\n308:                 repo = self.repo_factory(\n309:                     d,\n310:                     fs=self.repo.fs,\n311:                     scm=self.repo.scm,\n312:                     repo_factory=self.repo_factory,\n313:                 )\n314:                 self._repo_stack.enter_context(repo)\n315:                 self._datafss[key] = DataFileSystem(index=repo.index.data[\"repo\"])\n316:             self._subrepos_trie[key] = repo\n317: \n318:     def _is_dvc_repo(self, dir_path):\n319:         \"\"\"Check if the directory is a dvc repo.\"\"\"\n320:         if not self._traverse_subrepos:\n321:             return False\n322: \n323:         from dvc.repo import Repo\n324: \n325:         repo_path = self.repo.fs.join(dir_path, Repo.DVC_DIR)\n326:         return self.repo.fs.isdir(repo_path)\n327: \n328:     def _get_subrepo_info(\n329:         self, key: Key\n330:     ) -> tuple[\"Repo\", Optional[DataFileSystem], Key]:\n331:         \"\"\"\n332:         Returns information about the subrepo the key is part of.\n333:         \"\"\"\n334:         repo = self._get_repo(key)\n335:         repo_key: Key\n336:         if repo is self.repo:\n337:             repo_key = ()\n338:             subkey = key\n339:         else:\n340:             repo_key = self._get_key(repo.root_dir)\n341:             subkey = key[len(repo_key) :]\n342: \n343:         dvc_fs = self._datafss.get(repo_key)\n344:         return repo, dvc_fs, subkey\n345: \n346:     def _open(self, path, mode=\"rb\", **kwargs):\n347:         if mode != \"rb\":\n348:             raise OSError(errno.EROFS, os.strerror(errno.EROFS))\n349: \n350:         key = self._get_key_from_relative(path)\n351:         fs_path = self._from_key(key)\n352:         try:\n353:             return self.repo.fs.open(fs_path, mode=mode)\n354:         except FileNotFoundError:\n355:             _, dvc_fs, subkey = self._get_subrepo_info(key)\n356:             if not dvc_fs:\n357:                 raise\n358: \n359:         dvc_path = _get_dvc_path(dvc_fs, subkey)\n360:         return dvc_fs.open(dvc_path, mode=mode, cache=kwargs.get(\"cache\", False))\n361: \n362:     def isdvc(self, path, **kwargs) -> bool:\n363:         \"\"\"Is this entry dvc-tracked?\"\"\"\n364:         try:\n365:             return self.info(path).get(\"dvc_info\", {}).get(\"isout\", False)\n366:         except FileNotFoundError:\n367:             return False\n368: \n369:     def ls(self, path, detail=True, dvc_only=False, **kwargs):  # noqa: C901, PLR0912\n370:         key = self._get_key_from_relative(path)\n371:         repo, dvc_fs, subkey = self._get_subrepo_info(key)\n372: \n373:         dvc_infos = {}\n374:         dvc_info = {}\n375:         if dvc_fs:\n376:             dvc_path = _get_dvc_path(dvc_fs, subkey)\n377:             with suppress(FileNotFoundError):\n378:                 dvc_info = dvc_fs.info(dvc_path)\n379:                 if dvc_info[\"type\"] == \"file\":\n380:                     dvc_infos[\"\"] = dvc_info\n381:                 else:\n382:                     for info in dvc_fs.ls(dvc_path, detail=True):\n383:                         dvc_infos[dvc_fs.name(info[\"name\"])] = info\n384: \n385:         fs_infos = {}\n386:         fs_info = {}\n387:         ignore_subrepos = kwargs.get(\"ignore_subrepos\", True)\n388:         if not dvc_only:\n389:             fs = self.repo.fs\n390:             fs_path = self._from_key(key)\n391:             try:\n392:                 fs_info = fs.info(fs_path)\n393:                 if fs_info[\"type\"] == \"file\":\n394:                     fs_infos[\"\"] = fs_info\n395:                 else:\n396:                     for info in repo.dvcignore.ls(\n397:                         fs, fs_path, detail=True, ignore_subrepos=ignore_subrepos\n398:                     ):\n399:                         fs_infos[fs.name(info[\"name\"])] = info\n400:             except (FileNotFoundError, NotADirectoryError):\n401:                 pass\n402: \n403:         if not (fs_info or dvc_info):\n404:             # broken symlink or TreeError\n405:             raise FileNotFoundError(errno.ENOENT, os.strerror(errno.ENOENT), path)\n406: \n407:         if fs_info and dvc_info and dvc_info[\"type\"] != fs_info[\"type\"]:\n408:             dvc_infos.clear()  # invalidate dvc_info if file type differs\n409: \n410:         dvcfiles = kwargs.get(\"dvcfiles\", False)\n411: \n412:         infos = []\n413:         paths = []\n414:         names = set(dvc_infos.keys()) | set(fs_infos.keys())\n415: \n416:         for name in names:\n417:             if not dvcfiles and _is_dvc_file(name):\n418:                 continue\n419: \n420:             entry_path = self.join(path, name) if name else path\n421:             info = _merge_info(\n422:                 repo, (*subkey, name), fs_infos.get(name), dvc_infos.get(name)\n423:             )\n424:             info[\"name\"] = entry_path\n425:             infos.append(info)\n426:             paths.append(entry_path)\n427: \n428:         if not detail:\n429:             return paths\n430: \n431:         return infos\n432: \n433:     def info(self, path, **kwargs):\n434:         key = self._get_key_from_relative(path)\n435:         ignore_subrepos = kwargs.get(\"ignore_subrepos\", True)\n436:         return self._info(key, path, ignore_subrepos=ignore_subrepos)\n437: \n438:     def _info(  # noqa: C901\n439:         self, key, path, ignore_subrepos=True, check_ignored=True\n440:     ):\n441:         repo, dvc_fs, subkey = self._get_subrepo_info(key)\n442: \n443:         dvc_info = None\n444:         if dvc_fs:\n445:             try:\n446:                 dvc_info = dvc_fs.fs.index.info(subkey)\n447:                 dvc_path = _get_dvc_path(dvc_fs, subkey)\n448:                 dvc_info[\"name\"] = dvc_path\n449:             except KeyError:\n450:                 pass\n451: \n452:         fs_info = None\n453:         fs = self.repo.fs\n454:         fs_path = self._from_key(key)\n455:         try:\n456:             fs_info = fs.info(fs_path)\n457:             if check_ignored and repo.dvcignore.is_ignored(\n458:                 fs, fs_path, ignore_subrepos=ignore_subrepos\n459:             ):\n460:                 fs_info = None\n461:         except (FileNotFoundError,