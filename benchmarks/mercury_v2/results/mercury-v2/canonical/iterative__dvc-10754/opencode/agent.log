timestamp=2026-09-04T05:55:20.091Z level=INFO run=14d1c5b6 message=evaluated permission=bash pattern="python - <<'EOF'\nimport sys; sys.path.insert(0, \"/testbed\")\nimport os, warnings\nos.chdir(\"/tmp/opencode/repotest\")\nfrom fsspec import url_to_fs\nfrom dvc.repo import Repo\nRepo.init()\nRepo().stage(name=\"data\", outs={\"data/foo\": None}, fname=\"data/foo.dvc\").dump()\n\n# fsspec integration: storage_options with repo= instead of url=\nfs, path = url_to_fs(\"dvc://data/foo\", repo=\"/tmp/opencode/repotest\")\nprint(\"url_to_fs path:\", path)\nprint(\"exists:\", fs.exists(path))\nprint(\"content:\", fs.open(path).read())\n\n# backward compat: url= still works\nwith warnings.catch_warnings(record=True) as w:\n    warnings.simplefilter(\"always\")\n    from dvc.api import DVCFileSystem\n    fs2 = DVCFileSystem(url=\"/tmp/opencode/repotest\")\n    print(\"url= compat exists:\", fs2.exists(\"data/foo\"))\n\n# positional + Repo instance\nfs3 = DVCFileSystem(Repo(\"/tmp/opencode/repotest\"))\nprint(\"positional repo instance exists:\", fs3.exists(\"data/foo\"))\nfs4 = DVCFileSystem()\nprint(\"cwd default exists:\", fs4.exists(\"data/foo\"))\nEOF" action.permission=* action.action=allow action.pattern=*
