     def fs(self, request, tmp_dir, dvc, scm):
-        return DVCFileSystem(tmp_dir, **request.param)
+        return DVCFileSystem(repo=tmp_dir, **request.param)
 
     @pytest.fixture(autouse=True)
     def mock_ignore(self, mocker):
@@ -803,3 +803,33 @@ def test_maxdepth(tmp_dir, dvc, scm):
             "subdir2": {"file3": "file3", "subdir3": {"file4": "file4"}},
         },
     }
+
+
+def test_repo_parameter(tmp_dir, dvc):
+    fs = DVCFileSystem(repo=tmp_dir)
+    assert fs.repo.root_dir == dvc.root_dir
+
+
+def test_repo_instance_is_used_directly(dvc):
+    from dvc.fs.dvc import _DVCFileSystem
+
+    fs = _DVCFileSystem(repo=dvc)
+    assert fs.repo is dvc
+
+
+def test_url_parameter_alias(tmp_dir, dvc):
+    fs = DVCFileSystem(url=tmp_dir)
+    assert fs.repo.root_dir == dvc.root_dir
+
+
+def test_repo_and_url_are_mutually_exclusive(tmp_dir):
+    with pytest.raises(TypeError, match="specify either"):
+        DVCFileSystem(repo=tmp_dir, url=tmp_dir)
+
+def test_fsspec_url_to_fs(tmp_dir, dvc):
+    from fsspec.core import url_to_fs
+
+    fs, path = url_to_fs(f"dvc://{tmp_dir.as_posix()}")
+    assert isinstance(fs, DVCFileSystem)
+    assert fs.repo.root_dir == dvc.root_dir
+    assert path == tmp_dir.as_posix()
