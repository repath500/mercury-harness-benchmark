diff --git a/tests/unit/fs/test_dvc.py b/tests/unit/fs/test_dvc.py
index 728f045e9..2369e1eff 100644
--- a/tests/unit/fs/test_dvc.py
+++ b/tests/unit/fs/test_dvc.py
@@ -696,3 +696,45 @@ def test_fsid_url(erepo_dir):
         fs = DVCFileSystem(repo=dvc)
         assert fs.fsid != old_fsid
         assert fs.fsid == "dvcfs_" + tokenize(url, erepo_dir.scm.get_rev())
+
+
+def test_init_with_url_kwarg_deprecated(tmp_dir, dvc):
+    tmp_dir.gen("foo", "foo")
+    dvc.add("foo")
+    (tmp_dir / "foo").unlink()
+
+    with pytest.warns(DeprecationWarning, match="use 'repo' instead"):
+        fs = DVCFileSystem(url=str(tmp_dir))
+        assert fs.exists("foo")
+
+    with pytest.warns(DeprecationWarning, match="use 'repo' instead"):
+        fs = DVCFileSystem(url=tmp_dir)
+        assert fs.exists("foo")
+
+    with pytest.warns(DeprecationWarning, match="use 'repo' instead"):
+        fs = DVCFileSystem(url=dvc)
+        assert fs.exists("foo")
+
+
+def test_init_with_repo_path(tmp_dir, dvc):
+    tmp_dir.gen("foo", "foo")
+    dvc.add("foo")
+    (tmp_dir / "foo").unlink()
+
+    fs = DVCFileSystem(repo=str(tmp_dir))
+    assert fs.exists("foo")
+
+    fs = DVCFileSystem(repo=tmp_dir)
+    assert fs.exists("foo")
+
+
+def test_url_to_fs(tmp_dir, dvc):
+    from fsspec.core import url_to_fs
+
+    tmp_dir.gen("foo", "foo")
+    dvc.add("foo")
+    (tmp_dir / "foo").unlink()
+
+    fs, _ = url_to_fs("dvc://", repo=str(tmp_dir))
+    with fs.open("foo") as fobj:
+        assert fobj.read() == b"foo"
