{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a06a66b8f171e2af3f3490","type":"tool_result","content":"1\timport errno\n2\timport functools\n3\timport ntpath\n4\timport os\n5\timport posixpath\n6\timport threading\n7\tfrom collections import defaultdict, deque\n8\tfrom contextlib import ExitStack, nullcontext, suppress\n9\tfrom glob import has_magic\n10\tfrom typing import TYPE_CHECKING, Any, Callable, Optional, Union\n11\t\n12\tfrom fsspec.spec import DEFAULT_CALLBACK, AbstractFileSystem\n13\tfrom funcy import wrap_with\n14\t\n15\tfrom dvc.log import logger\n16\tfrom dvc.utils.threadpool import ThreadPoolExecutor\n17\tfrom dvc_objects.fs.base import AnyFSPath, FileSystem\n18\t\n19\tfrom .data import DataFileSystem\n20\t\n21\tif TYPE_CHECKING:\n22\t    from contextlib import AbstractContextManager\n23\t\n24\t    from dvc.repo import Repo\n25\t    from dvc.types import DictStrAny, StrPath\n26\t\n27\t    from .callbacks import Callback\n28\t\n29\tlogger = logger.getChild(__name__)\n30\t\n31\tRepoFactory = Union[Callable[..., \"Repo\"], type[\"Repo\"]]\n32\tKey = tuple[str, ...]\n33\t\n34\t\n35\tdef as_posix(path: str) -> str:\n36\t    return path.replace(ntpath.sep, posixpath.sep)\n37\t\n38\t\n39\t# NOT the same as dvc.dvcfile.is_dvc_file()!\n40\tdef _is_dvc_file(fname):\n41\t    from dvc.dvcfile import is_valid_filename\n42\t    from dvc.ignore import DvcIgnore\n43\t\n44\t    return is_valid_filename(fname) or fname == DvcIgnore.DVCIGNORE_FILE\n45\t\n46\t\n47\tdef _merge_info(repo, key, fs_info, dvc_info):\n48\t    from . import utils\n49\t\n50\t    ret = {\"repo\": repo}\n51\t\n52\t    if dvc_info:\n53\t        dvc_info[\"isout\"] = any(\n54\t            (len(out_key) <= len(key) and key[: len(out_key)] == out_key)\n55\t            for out_key in repo.index.data_keys[\"repo\"]\n56\t        )\n57\t        dvc_info[\"isdvc\"] = dvc_info[\"isout\"]\n58\t        ret[\"dvc_info\"] = dvc_info\n59\t        ret[\"type\"] = dvc_info[\"type\"]\n60\t        ret[\"size\"] = dvc_info[\"size\"]\n61\t        if not fs_info and \"md5\" in dvc_info:\n62\t            ret[\"md5\"] = dvc_info[\"md5\"]\n63\t        if not fs_info and \"md5-dos2unix\" in dvc_info:\n64\t            ret[\"md5-dos2unix\"] = dvc_info[\"md5-dos2unix\"]\n65\t\n66\t    if fs_info:\n67\t        ret[\"type\"] = fs_info[\"type\"]\n68\t        ret[\"size\"] = fs_info[\"size\"]\n69\t        ret[\"fs_info\"] = fs_info\n70\t        isexec = False\n71\t        if fs_info[\"type\"] == \"file\":\n72\t            isexec = utils.is_exec(fs_info[\"mode\"])\n73\t        ret[\"isexec\"] = isexec\n74\t\n75\t    return ret\n76\t\n77\t\n78\tdef _get_dvc_path(dvc_fs, subkey):\n79\t    return dvc_fs.join(*subkey) if subkey else \"\"\n80\t\n81\t\n82\tclass _DVCFileSystem(AbstractFileSystem):\n83\t    cachable = False\n84\t    root_marker = \"/\"\n85\t\n86\t    def __init__(  # noqa: PLR0913\n87\t        self,\n88\t        url: Optional[str] = None,\n89\t        rev: Optional[str] = None,\n90\t        repo: Optional[\"Repo\"] = None,\n91\t        subrepos: bool = False,\n92\t        repo_factory: Optional[RepoFactory] = None,\n93\t        fo: Optional[str] = None,\n94\t        target_options: Optional[dict[str, Any]] = None,  # noqa: ARG002\n95\t        target_protocol: Optional[str] = None,  # noqa: ARG002\n96\t        config: Optional[\"DictStrAny\"] = None,\n97\t        remote: Optional[str] = None,\n98\t        remote_config: Optional[\"DictStrAny\"] = None,\n99\t        **kwargs,\n100\t    ) -> None:\n101\t        \"\"\"DVC + git-tracked files fs.\n102\t\n103\t        Args:\n104\t            path (str, optional): URL or path to a DVC/Git repository.\n105\t                Defaults to a DVC repository in the current working directory.\n106\t                Both HTTP and SSH protocols are supported for remote Git repos\n107\t                (e.g. [user@]server:project.git).\n108\t            rev (str, optional): Any Git revision such as a branch or tag name,\n109\t                a commit hash or a dvc experiment name.\n110\t                Defaults to the default branch in case of remote repositories.\n111\t                In case of a local repository, if rev is unspecified, it will\n112\t                default to the working directory.\n113\t                If the repo is not a Git repo, this option is ignored.\n114\t            repo (:obj:`Repo`, optional): `Repo` instance.\n115\t            subrepos (bool): traverse to subrepos.\n116\t                By default, it ignores subrepos.\n117\t            repo_factory (callable): A function to initialize subrepo with.\n118\t                The default is `Repo`.\n119\t            config (dict): Repo config to be passed into `repo_factory`.\n120\t            remote (str): Remote name to be passed into `repo_factory`.\n121\t            remote_config(dict): Remote config to be passed into `repo_factory`.\n122\t\n123\t        Examples:\n124\t            - Opening a filesystem from repo in current working directory\n125\t\n126\t            >>> fs = DVCFileSystem()\n127\t\n128\t            - Opening a filesystem from local repository\n129\t\n130\t            >>> fs = DVCFileSystem(\"path/to/local/repository\")\n131\t\n132\t            - Opening a remote repository\n133\t\n134\t            >>> fs = DVCFileSystem(\n135\t            ...    \"https://github.com/iterative/example-get-started\",\n136\t            ...    rev=\"main\",\n137\t            ... )\n138\t        \"\"\"\n139\t        super().__init__()\n140\t        self._repo = repo\n141\t        self._repo_factory = repo_factory\n142\t        self._traverse_subrepos = subrepos\n143\t        self._repo_stack = ExitStack()\n144\t        self._repo_kwargs = {\n145\t            \"url\": url if url is not None else fo,\n146\t            \"rev\": rev,\n147\t            \"subrepos\": subrepos,\n148\t            \"config\": config,\n149\t            \"remote\": remote,\n150\t            \"remote_config\": remote_config,\n151\t        }\n152\t\n153\t    def getcwd(self):\n154\t        relparts: tuple[str, ...] = ()\n155\t        assert self.repo is not None\n156\t        if self.repo.fs.isin(self.repo.fs.getcwd(), self.repo.root_dir):\n157\t            relparts = self.repo.fs.relparts(self.repo.fs.getcwd(), self.repo.root_dir)\n158\t        return self.root_marker + self.sep.join(relparts)\n159\t\n160\t    @classmethod\n161\t    def join(cls, *parts: str) -> str:\n162\t        return posixpath.join(*parts)\n163\t\n164\t    @classmethod\n165\t    def parts(cls, path: str) -> tuple[str, ...]:\n166\t        ret = []\n167\t        while True:\n168\t            path, part = posixpath.split(path)\n169\t\n170\t            if part:\n171\t                ret.append(part)\n172\t                continue\n173\t\n174\t            if path:\n175\t                ret.append(path)\n176\t\n177\t            break\n178\t\n179\t        ret.reverse()\n180\t\n181\t        return tuple(ret)\n182\t\n183\t    def normpath(self, path: str) -> str:\n184\t        return posixpath.normpath(path)\n185\t\n186\t    def abspath(self, path: str) -> str:\n187\t        if not posixpath.isabs(path):\n188\t            path = self.join(self.getcwd(), path)\n189\t        return self.normpath(path)\n190\t\n191\t    def relpath(self, path: str, start: Optional[str] = None) -> str:\n192\t        if start is None:\n193\t            start = \".\"\n194\t        return posixpath.relpath(self.abspath(path), start=self.abspath(start))\n195\t\n196\t    def relparts(self, path: str, start: Optional[str] = None) -> tuple[str, ...]:\n197\t        return self.parts(self.relpath(path, start=start))\n198\t\n199\t    @functools.cached_property\n200\t    def repo(self):\n201\t        if self._repo:\n202\t            return self._repo\n203\t\n204\t        repo = self._make_repo(**self._repo_kwargs)\n205\t\n206\t        self._repo_stack.enter_context(repo)\n207\t        self._repo = repo\n208\t        return repo\n209\t\n210\t    @functools.cached_property\n211\t    def repo_factory(self):\n212\t        if self._repo_factory:\n213\t            return self._repo_factory\n214\t\n215\t        if self._repo:\n216\t            from dvc.repo import Repo\n217\t\n218\t            return Repo\n219\t\n220\t        return self.repo._fs_conf[\"repo_factory\"]\n221\t\n222\t    @functools.cached_property\n223\t    def fsid(self) -> str:\n224\t        from fsspec.utils import tokenize\n225\t\n226\t        from dvc.scm import NoSCM\n227\t\n228\t        return \"dvcfs_\" + tokenize(\n229\t            self.repo.url or self.repo.root_dir,\n230\t            self.repo.get_rev() if not isinstance(self.repo.scm, NoSCM) else None,\n231\t        )\n232\t\n233\t    def _get_key(self, path: \"StrPath\") -> Key:\n234\t        path = os.fspath(path)\n235\t        parts = self.repo.fs.relparts(path, self.repo.root_dir)\n236\t        if parts == (os.curdir,):\n237\t            return ()\n238\t        return parts\n239\t\n240\t    @functools.cached_property\n241\t    def _subrepos_trie(self):\n242\t        \"\"\"Keeps track of each and every path with the corresponding repo.\"\"\"\n243\t\n244\t        from pygtrie import Trie\n245\t\n246\t        trie = Trie()\n247\t        key = self._get_key(self.repo.root_dir)\n248\t        trie[key] = self.repo\n249\t        return trie\n250\t\n251\t    def _get_key_from_relative(self, path) -> Key:\n252\t        path = self._strip_protocol(path)\n253\t        parts = self.relparts(path, self.root_marker)\n254\t        if parts and parts[0] == os.curdir:\n255\t            return parts[1:]\n256\t        return parts\n257\t\n258\t    def _from_key(self, parts: Key) -> str:\n259\t        return self.repo.fs.join(self.repo.root_dir, *parts)\n260\t\n261\t    @functools.cached_property\n262\t    def _datafss(self):\n263\t        \"\"\"Keep a datafs instance of each repo.\"\"\"\n264\t\n265\t        datafss = {}\n266\t\n267\t        if hasattr(self.repo, \"dvc_dir\"):\n268\t            key = self._get_key(self.repo.root_dir)\n269\t            datafss[key] = DataFileSystem(index=self.repo.index.data[\"repo\"])\n270\t\n271\t        return datafss\n272\t\n273\t    @property\n274\t    def repo_url(self):\n275\t        return self.repo.url\n276\t\n277\t    @classmethod\n278\t    def _make_repo(cls, **kwargs) -> \"Repo\":\n279\t        from dvc.repo import Repo\n280\t\n281\t        with Repo.open(uninitialized=True, **kwargs) as repo:\n282\t            return repo\n283\t\n284\t    def _get_repo(self, key: Key) -> \"Repo\":\n285\t        \"\"\"Returns repo that the path falls in, using prefix.\n286\t\n287\t        If the path is already tracked/collected, it just returns the repo.\n288\t\n289\t        Otherwise, it collects the repos that might be in the path's parents\n290\t        and then returns the appropriate one.\n291\t        \"\"\"\n292\t        repo = self._subrepos_trie.get(key)\n293\t        if repo:\n294\t            return repo\n295\t\n296\t        prefix_key, repo = self._subrepos_trie.longest_prefix(key)\n297\t        dir_keys = (key[:i] for i in range(len(prefix_key) + 1, len(key) + 1))\n298\t        self._update(dir_keys, starting_repo=repo)\n299\t        return self._subrepos_trie.get(key) or self.repo\n300\t\n301\t    @wrap_with(threading.Lock())\n302\t    def _update(self, dir_keys, starting_repo):\n303\t        \"\"\"Checks for subrepo in directories and updates them.\"\"\"\n304\t        repo = starting_repo\n305\t        for key in dir_keys:\n306\t            d = self._from_key(key)\n307\t            if self._is_dvc_repo(d):\n308\t                repo = self.repo_factory(\n309\t                    d,\n310\t                    fs=self.repo.fs,\n311\t                    scm=self.repo.scm,\n312\t                    repo_factory=self.repo_factory,\n313\t                )\n314\t                self._repo_stack.enter_context(repo)\n315\t                self._datafss[key] = DataFileSystem(index=repo.index.data[\"repo\"])\n316\t            self._subrepos_trie[key] = repo\n317\t\n318\t    def _is_dvc_repo(self, dir_path):\n319\t        \"\"\"Check if the directory is a dvc repo.\"\"\"\n320\t        if not self._traverse_subrepos:\n321\t            return False\n322\t\n323\t        from dvc.repo import Repo\n324\t\n325\t        repo_path = self.repo.fs.join(dir_path, Repo.DVC_DIR)\n326\t        return self.repo.fs.isdir(repo_path)\n327\t\n328\t    def _get_subrepo_info(\n329\t        self, key: Key\n330\t    ) -> tuple[\"Repo\", Optional[DataFileSystem], Key]:\n331\t        \"\"\"\n332\t        Returns information about the subrepo the key is part of.\n333\t        \"\"\"\n334\t        repo = self._get_repo(key)\n335\t        repo_key: Key\n336\t        if repo is self.repo:\n337\t            repo_key = ()\n338\t            subkey = key\n339\t        else:\n340\t            repo_key = self._get_key(repo.root_dir)\n341\t            subkey = key[len(repo_key) :]\n342\t\n343\t        dvc_fs = self._datafss.get(repo_key)\n344\t        return repo, dvc_fs, subkey\n345\t\n346\t    def _open(self, path, mode=\"rb\", **kwargs):\n347\t        if mode != \"rb\":\n348\t            raise OSError(errno.EROFS, os.strerror(errno.EROFS))\n349\t\n350\t        key = self._get_key_from_relative(path)\n351\t        fs_path = self._from_key(key)\n352\t        try:\n353\t            return self.repo.fs.open(fs_path, mode=mode)\n354\t        except FileNotFoundError:\n355\t            _, dvc_fs, subkey = self._get_subrepo_info(key)\n356\t            if not dvc_fs:\n357\t                raise\n358\t\n359\t        dvc_path = _get_dvc_path(dvc_fs, subkey)\n360\t        return dvc_fs.open(dvc_path, mode=mode, cache=kwargs.get(\"cache\", False))\n361\t\n362\t    def isdvc(self, path, **kwargs) -> bool:\n363\t        \"\"\"Is this entry dvc-tracked?\"\"\"\n364\t        try:\n365\t            return self.info(path).get(\"dvc_info\", {}).get(\"isout\", False)\n366\t        except FileNotFoundError:\n367\t            return False\n368\t\n369\t    def ls(self, path, detail=True, dvc_only=False, **kwargs):  # noqa: C901, PLR0912\n370\t        key = self._get_key_from_relative(path)\n371\t        repo, dvc_fs, subkey = self._get_subrepo_info(key)\n372\t\n373\t        dvc_infos = {}\n374\t        dvc_info = {}\n375\t        if dvc_fs:\n376\t            dvc_path = _get_dvc_path(dvc_fs, subkey)\n377\t            with suppress(FileNotFoundError):\n378\t                dvc_info = dvc_fs.info(dvc_path)\n379\t                if dvc_info[\"type\"] == \"file\":\n380\t                    dvc_infos[\"\"] = dvc_info\n381\t                else:\n382\t                    for info in dvc_fs.ls(dvc_path, detail=True):\n383\t                        dvc_infos[dvc_fs.name(info[\"name\"])] = info\n384\t\n385\t        fs_infos = {}\n386\t        fs_info = {}\n387\t        ignore_subrepos = kwargs.get(\"ignore_subrepos\", True)\n388\t        if not dvc_only:\n389\t            fs = self.repo.fs\n390\t            fs_path = self._from_key(key)\n391\t            try:\n392\t                fs_info = fs.info(fs_path)\n393\t                if fs_info[\"type\"] == \"file\":\n394\t                    fs_infos[\"\"] = fs_info\n395\t                else:\n396\t                    for info in repo.dvcignore.ls(\n397\t                        fs, fs_path, detail=True, ignore_subrepos=ignore_subrepos\n398\t                    ):\n399\t                        fs_infos[fs.name(info[\"name\"])] = info\n400\t            except (FileNotFoundError, NotADirectoryError):\n401\t                pass\n402\t\n403\t        if not (fs_info or dvc_info):\n404\t            # broken symlink or TreeError\n405\t            raise FileNotFoundError(errno.ENOENT, os.strerror(errno.ENOENT), path)\n406\t\n407\t        if fs_info and dvc_info and dvc_info[\"type\"] != fs_info[\"type\"]:\n408\t            dvc_infos.clear()  # invalidate dvc_info if file type differs\n409\t\n410\t        dvcfiles = kwargs.get(\"dvcfiles\", False)\n411\t\n412\t        infos = []\n413\t        paths = []\n414\t        names = set(dvc_infos.keys()) | set(fs_infos.keys())\n415\t\n416\t        for name in names:\n417\t            if not dvcfiles and _is_dvc_file(name):\n418\t                continue\n419\t\n420\t            entry_path = self.join(path, name) if name else path\n421\t            info = _merge_info(\n422\t                repo, (*subkey, name), fs_infos.get(name), dvc_infos.get(name)\n423\t            )\n424\t            info[\"name\"] = entry_path\n425\t            infos.append(info)\n426\t            paths.append(entry_path)\n427\t\n428\t        if not detail:\n429\t            return paths\n430\t\n431\t        return infos\n432\t\n433\t    def info(self, path, **kwargs):\n434\t        key = self._get_key_from_relative(path)\n435\t        ignore_subrepos = kwargs.get(\"ignore_subrepos\", True)\n436\t        return self._info(key, path, ignore_subrepos=ignore_subrepos)\n437\t\n438\t    def _info(  # noqa: C901\n439\t        self, key, path, ignore_subrepos=True, check_ignored=True\n440\t    ):\n441\t        repo, dvc_fs, subkey = self._get_subrepo_info(key)\n442\t\n443\t        dvc_info = None\n444\t        if dvc_fs:\n445\t            try:\n446\t                dvc_info = dvc_fs.fs.index.info(subkey)\n447\t                dvc_path = _get_dvc_path(dvc_fs, subkey)\n448\t                dvc_info[\"name\"] = dvc_path\n449\t            except KeyError:\n450\t                pass\n451\t\n452\t        fs_info = None\n453\t        fs = self.repo.fs\n454\t        fs_path = self._from_key(key)\n455\t        try:\n456\t            fs_info = fs.info(fs_path)\n457\t            if check_ignored and repo.dvcignore.is_ignored(\n458\t                fs, fs_path, ignore_subrepos=ignore_subrepos\n459\t            ):\n460\t                fs_info = None\n461\t        except (FileNotFoundError, NotADirectoryError):\n462\t            if not dvc_info:\n463\t                raise\n464\t\n465\t        # NOTE: if some parent in fs_path turns out to be a file, it means\n466\t        # that the whole repofs branch doesn't exist.\n467\t        if dvc_info and not fs_info:\n468\t            for parent in fs.parents(fs_path):\n469\t                try:\n470\t                    if fs.info(parent)[\"type\"] != \"directory\":\n471\t                        dvc_info = None\n472\t                        break\n473\t                except FileNotFoundError:\n474\t                    continue\n475\t\n476\t        if not dvc_info and not fs_info:\n477\t            raise FileNotFoundError(errno.ENOENT, os.strerror(errno.ENOENT), path)\n478\t\n479\t        info = _merge_info(repo, subkey, fs_info, dvc_info)\n480\t        info[\"name\"] = path\n481\t        return info\n482\t\n483\t    def get(\n484\t        self,\n485\t        rpath,\n486\t        lpath,\n487\t        recursive=False,\n488\t        callback=DEFAULT_CALLBACK,\n489\t        maxdepth=None,\n490\t        batch_size=None,\n491\t        **kwargs,\n492\t    ):\n493\t        self._get(\n494\t            rpath,\n495\t            lpath,\n496\t            recursive=recursive,\n497\t            callback=callback,\n498\t            maxdepth=maxdepth,\n499\t            batch_size=batch_size,\n500\t            **kwargs,\n501\t        )\n502\t\n503\t    def _get(  # noqa: C901, PLR0912, PLR0915\n504\t        self,\n505\t        rpath,\n506\t        lpath,\n507\t        recursive=False,\n508\t        callback=DEFAULT_CALLBACK,\n509\t        maxdepth=None,\n510\t        batch_size=None,\n511\t        **kwargs,\n512\t    ) -> list[tuple[str, str, Optional[dict]]]:\n513\t        if (\n514\t            isinstance(rpath, list)\n515\t            or isinstance(lpath, list)\n516\t            or has_magic(rpath)\n517\t            or not self.exists(rpath)\n518\t            or not recursive\n519\t        ):\n520\t            super().get(\n521\t                rpath,\n522\t                lpath,\n523\t                recursive=recursive,\n524\t                callback=callback,\n525\t                maxdepth=maxdepth,\n526\t                **kwargs,\n527\t            )\n528\t            return []\n529\t\n530\t        if os.path.isdir(lpath) or lpath.endswith(os.path.sep):\n531\t            lpath = self.join(lpath, os.path.basename(rpath))\n532\t\n533\t        if self.isfile(rpath):\n534\t            with callback.branched(rpath, lpath) as child:\n535\t                self.get_file(rpath, lpath, callback=child, **kwargs)\n536\t                return [(rpath, lpath, None)]\n537\t\n538\t        result: list[tuple[str, str, Optional[dict]]] = []\n539\t        _dirs: list[str] = []\n540\t        _files: dict[FileSystem, list[tuple[str, str, Optional[dict]]]]\n541\t        _files = defaultdict(list)\n542\t\n543\t        for root, dirs, files in self.walk(rpath, maxdepth=maxdepth, detail=True):\n544\t            if files:\n545\t                callback.set_size((callback.size or 0) + len(files))\n546\t\n547\t            parts = self.relparts(root, rpath)\n548\t            if parts in ((os.curdir,), (\"\",)):\n549\t                parts = ()\n550\t            dest_root = os.path.join(lpath, *parts)\n551\t            if not maxdepth or len(parts) < maxdepth - 1:\n552\t                _dirs.extend(f\"{dest_root}{os.path.sep}{d}\" for d in dirs)\n553\t\n554\t            key = self._get_key_from_relative(root)\n555\t            _, dvc_fs, _ = self._get_subrepo_info(key)\n556\t\n557\t            for name, info in files.items():\n558\t                dvc_info = info.get(\"dvc_info\")\n559\t                fs_info = info.get(\"fs_info\")\n560\t                if dvc_fs and dvc_info and not fs_info:\n561\t                    fs = dvc_fs\n562\t                    fs_path = dvc_info[\"name\"]\n563\t                else:\n564\t                    fs = self.repo.fs\n565\t                    fs_path = fs_info[\"name\"]\n566\t\n567\t                src_path = f\"{root}{self.sep}{name}\"\n568\t                dest_path = f\"{dest_root}{os.path.sep}{name}\"\n569\t                _files[fs].append((fs_path, dest_path, dvc_info))\n570\t                result.append((src_path, dest_path, info))\n571\t\n572\t        os.makedirs(lpath, exist_ok=True)\n573\t        for d in _dirs:\n574\t            os.makedirs(d, exist_ok=True)\n575\t\n576\t        def get_file(arg: tuple[FileSystem, tuple[str, str, Optional[dict]]]):\n577\t            fs, (src, dest, info) = arg\n578\t            kw = kwargs\n579\t            if isinstance(fs, DataFileSystem):\n580\t                kw = kw | {\"info\": info}\n581\t            with callback.branched(src, dest) as child:\n582\t                fs.get_file(src, dest, callback=child, **kw)\n583\t\n584\t        if batch_size == 1:\n585\t            ctx: AbstractContextManager = nullcontext()\n586\t            map_fn: Callable = map\n587\t        else:\n588\t            ctx = ThreadPoolExecutor(max_workers=batch_size)\n589\t            map_fn = ctx.imap_unordered\n590\t\n591\t        with ctx:\n592\t            it = ((fs, f) for fs, files in _files.items() for f in files)\n593\t            deque(callback.wrap(map_fn(get_file, it)), maxlen=0)\n594\t        return result\n595\t\n596\t    def get_file(self, rpath, lpath, **kwargs):\n597\t        dvc_info = kwargs.pop(\"info\", {}).pop(\"dvc_info\", None)\n598\t        key = self._get_key_from_relative(rpath)\n599\t        fs_path = self._from_key(key)\n600\t        dirpath = os.path.dirname(lpath)\n601\t        if dirpath:\n602\t            # makedirs raises error if the string is empty\n603\t            os.makedirs(dirpath, exist_ok=True)\n604\t\n605\t        try:\n606\t            return self.repo.fs.get_file(fs_path, lpath, **kwargs)\n607\t        except FileNotFoundError:\n608\t            _, dvc_fs, subkey = self._get_subrepo_info(key)\n609\t            if not dvc_fs:\n610\t                raise\n611\t\n612\t        dvc_path = _get_dvc_path(dvc_fs, subkey)\n613\t        return dvc_fs.get_file(dvc_path, lpath, info=dvc_info, **kwargs)\n614\t\n615\t    def du(self, path, total=True, maxdepth=None, withdirs=False, **kwargs):\n616\t        if maxdepth is not None:\n617\t            raise NotImplementedError\n618\t\n619\t        sizes = {}\n620\t        dus = {}\n621\t        todo = deque([self.info(path)])\n622\t        while todo:\n623\t            info = todo.popleft()\n624\t            isdir = info[\"type\"] == \"directory\"\n625\t            size = info[\"size\"] or 0\n626\t            name = info[\"name\"]\n627\t\n628\t            if not isdir:\n629\t                sizes[name] = size\n630\t                continue\n631\t\n632\t            dvc_info = info.get(\"dvc_info\") or {}\n633\t            fs_info = info.get(\"fs_info\")\n634\t            entry = dvc_info.get(\"entry\")\n635\t            if (\n636\t                dvc_info\n637\t                and not fs_info\n638\t                and entry is not None\n639\t                and entry.size is not None\n640\t            ):\n641\t                dus[name] = entry.size\n642\t                continue\n643\t\n644\t            if withdirs:\n645\t                sizes[name] = size\n646\t\n647\t            todo.extend(self.ls(info[\"name\"], detail=True))\n648\t\n649\t        if total:\n650\t            return sum(sizes.values()) + sum(dus.values())\n651\t\n652\t        return sizes\n653\t\n654\t    def close(self):\n655\t        self._repo_stack.close()\n656\t\n657\t\n658\tclass DVCFileSystem(FileSystem):\n659\t    protocol = \"local\"\n660\t    PARAM_CHECKSUM = \"md5\"\n661\t\n662\t    def _prepare_credentials(self, **config) -> dict[str, Any]:\n663\t        return config\n664\t\n665\t    @functools.cached_property\n666\t    def fs(self) -> \"_DVCFileSystem\":\n667\t        return _DVCFileSystem(**self.fs_args)\n668\t\n669\t    @property\n670\t    def immutable(self):\n671\t        from dvc.scm import NoSCM\n672\t\n673\t        if isinstance(self.fs.repo.scm, NoSCM):\n674\t            return False\n675\t\n676\t        return self.fs._repo_kwargs.get(\"rev\") == self.fs.repo.get_rev()\n677\t\n678\t    def getcwd(self):\n679\t        return self.fs.getcwd()\n680\t\n681\t    def _get(\n682\t        self,\n683\t        from_info: Union[AnyFSPath, list[AnyFSPath]],\n684\t        to_info: Union[AnyFSPath, list[AnyFSPath]],\n685\t        callback: \"Callback\" = DEFAULT_CALLBACK,\n686\t        recursive: bool = False,\n687\t        batch_size: Optional[int] = None,\n688\t        **kwargs,\n689\t    ) -> list[tuple[str, str, Optional[dict]]]:\n690\t        # FileSystem.get is non-recursive by default if arguments are lists\n691\t        # otherwise, it's recursive.\n692\t        recursive = not (isinstance(from_info, list) and isinstance(to_info, list))\n693\t        return self.fs._get(\n694\t            from_info,\n695\t            to_info,\n696\t            callback=callback,\n697\t            recursive=recursive,\n698\t            batch_size=batch_size,\n699\t            **kwargs,\n700\t        )\n701\t\n702\t    def get(\n703\t        self,\n704\t        from_info: Union[AnyFSPath, list[AnyFSPath]],\n705\t        to_info: Union[AnyFSPath, list[AnyFSPath]],\n706\t        callback: \"Callback\" = DEFAULT_CALLBACK,\n707\t        recursive: bool = False,\n708\t        batch_size: Optional[int] = None,\n709\t        **kwargs,\n710\t    ) -> None:\n711\t        self._get(\n712\t            from_info,\n713\t            to_info,\n714\t            callback=callback,\n715\t            batch_size=batch_size,\n716\t            recursive=recursive,\n717\t            **kwargs,\n718\t        )\n719\t\n720\t    @property\n721\t    def fsid(self) -> str:\n722\t        return self.fs.fsid\n723\t\n724\t    def isdvc(self, path, **kwargs) -> bool:\n725\t        return self.fs.isdvc(path, **kwargs)\n726\t\n727\t    @property\n728\t    def repo(self) -> \"Repo\":\n729\t        return self.fs.repo\n730\t\n731\t    @property\n732\t    def repo_url(self) -> str:\n733\t        return self.fs.repo_url\n734\t\n735\t    def from_os_path(self, path: str) -> str:\n736\t        if os.path.isabs(path) or (\n737\t            os.name == \"nt\" and posixpath.isabs(path) and ntpath.sep not in path\n738\t        ):\n739\t            path = os.path.relpath(path, self.repo.root_dir)\n740\t        return as_posix(path)\n741\t\n742\t    def close(self):\n743\t        if \"fs\" in self.__dict__:\n744\t            self.fs.close()\n745\t"}]},"parent_tool_use_id":null,"session_id":"4ced045f-2deb-4a03-96b6-51f3c49ecc7b","uuid":"ae1ee40c-5ef2-4668-a344-be4e4b12a57b","timestamp":"2026-09-04T03:11:52.161Z","tool_use_result":{"type":"text","file":{"filePath":"/testbed/dvc/fs/dvc.py","content":"import errno\nimport functools\nimport ntpath\nimport os\nimport posixpath\nimport threading\nfrom collections import defaultdict, deque\nfrom contextlib import ExitStack, nullcontext, suppress\nfrom glob import has_magic\nfrom typing import TYPE_CHECKING, Any, Callable, Optional, Union\n\nfrom fsspec.spec import DEFAULT_CALLBACK, AbstractFileSystem\nfrom funcy import wrap_with\n\nfrom dvc.log import logger\nfrom dvc.utils.threadpool import ThreadPoolExecutor\nfrom dvc_objects.fs.base import AnyFSPath, FileSystem\n\nfrom .data import DataFileSystem\n\nif TYPE_CHECKING:\n    from contextlib import AbstractContextManager\n\n    from dvc.repo import Repo\n    from dvc.types import DictStrAny, StrPath\n\n    from .callbacks import Callback\n\nlogger = logger.getChild(__name__)\n\nRepoFactory = Union[Callable[..., \"Repo\"], type[\"Repo\"]]\nKey = tuple[str, ...]\n\n\ndef as_posix(path: str) -> str:\n    return path.replace(ntpath.sep, posixpath.sep)\n\n\n# NOT the same as dvc.dvcfile.is_dvc_file()!\ndef _is_dvc_file(fname):\n    from dvc.dvcfile import is_valid_filename\n    from dvc.ignore import DvcIgnore\n\n    return is_valid_filename(fname) or fname == DvcIgnore.DVCIGNORE_FILE\n\n\ndef _merge_info(repo, key, fs_info, dvc_info):\n    from . import utils\n\n    ret = {\"repo\": repo}\n\n    if dvc_info:\n        dvc_info[\"isout\"] = any(\n            (len(out_key) <= len(key) and key[: len(out_key)] == out_key)\n            for out_key in repo.index.data_keys[\"repo\"]\n        )\n        dvc_info[\"isdvc\"] = dvc_info[\"isout\"]\n        ret[\"dvc_info\"] = dvc_info\n        ret[\"type\"] = dvc_info[\"type\"]\n        ret[\"size\"] = dvc_info[\"size\"]\n        if not fs_info and \"md5\" in dvc_info:\n            ret[\"md5\"] = dvc_info[\"md5\"]\n        if not fs_info and \"md5-dos2unix\" in dvc_info:\n            ret[\"md5-dos2unix\"] = dvc_info[\"md5-dos2unix\"]\n\n    if fs_info:\n        ret[\"type\"] = fs_info[\"type\"]\n        ret[\"size\"] = fs_info[\"size\"]\n        ret[\"fs_info\"] = fs_info\n        isexec = False\n        if fs_info[\"type\"] == \"file\":\n            isexec = utils.is_exec(fs_info[\"mode\"])\n        ret[\"isexec\"] = isexec\n\n    return ret\n\n\ndef _get_dvc_path(dvc_fs, subkey):\n    return dvc_fs.join(*subkey) if subkey else \"\"\n\n\nclass _DVCFileSystem(AbstractFileSystem):\n    cachable = False\n    root_marker = \"/\"\n\n    def __init__(  # noqa: PLR0913\n        self,\n        url: Optional[str] = None,\n        rev: Optional[str] = None,\n        repo: Optional[\"Repo\"] = None,\n        subrepos: bool = False,\n        repo_factory: Optional[RepoFactory] = None,\n        fo: Optional[str] = None,\n        target_options: Optional[dict[str, Any]] = None,  # noqa: ARG002\n        target_protocol: Optional[str] = None,  # noqa: ARG002\n        config: Optional[\"DictStrAny\"] = None,\n        remote: Optional[str] = None,\n        remote_config: Optional[\"DictStrAny\"] = None,\n        **kwargs,\n    ) -> None:\n        \"\"\"DVC + git-tracked files fs.\n\n        Args:\n            path (str, optional): URL or path to a DVC/Git repository.\n                Defaults to a DVC repository in the current working directory.\n                Both HTTP and SSH protocols are supported for remote Git repos\n                (e.g. [user@]server:project.git).\n            rev (str, optional): Any Git revision such as a branch or tag name,\n                a commit hash or a dvc experiment name.\n                Defaults to the default branch in case of remote repositories.\n                In case of a local repository, if rev is unspecified, it will\n                default to the working directory.\n                If the repo is not a Git repo, this option is ignored.\n            repo (:obj:`Repo`, optional): `Repo` instance.\n            subrepos (bool): traverse to subrepos.\n                By default, it ignores subrepos.\n            repo_factory (callable): A function to initialize subrepo with.\n                The default is `Repo`.\n            config (dict): Repo config to be passed into `repo_factory`.\n            remote (str): Remote name to be passed into `repo_factory`.\n            remote_config(dict): Remote config to be passed into `repo_factory`.\n\n        Examples:\n            - Opening a filesystem from repo in current working directory\n\n            >>> fs = DVCFileSystem()\n\n            - Opening a filesystem from local repository\n\n            >>> fs = DVCFileSystem(\"path/to/local/repository\")\n\n            - Opening a remote repository\n\n            >>> fs = DVCFileSystem(\n            ...    \"https://github.com/iterative/example-get-started\",\n            ...    rev=\"main\",\n            ... )\n        \"\"\"\n        super().__init__()\n        self._repo = repo\n        self._repo_factory = repo_factory\n        self._traverse_subrepos = subrepos\n        self._repo_stack = ExitStack()\n        self._repo_kwargs = {\n            \"url\": url if url is not None else fo,\n            \"rev\": rev,\n            \"subrepos\": subrepos,\n            \"config\": config,\n            \"remote\": remote,\n            \"remote_config\": remote_config,\n        }\n\n    def getcwd(self):\n        relparts: tuple[str, ...] = ()\n        assert self.repo is not None\n        if self.repo.fs.isin(self.repo.fs.getcwd(), self.repo.root_dir):\n            relparts = self.repo.fs.relparts(self.repo.fs.getcwd(), self.repo.root_dir)\n        return self.root_marker + self.sep.join(relparts)\n\n    @classmethod\n    def join(cls, *parts: str) -> str:\n        return posixpath.join(*parts)\n\n    @classmethod\n    def parts(cls, path: str) -> tuple[str, ...]:\n        ret = []\n        while True:\n            path, part = posixpath.split(path)\n\n            if part:\n                ret.append(part)\n                continue\n\n            if path:\n                ret.append(path)\n\n            break\n\n        ret.reverse()\n\n        return tuple(ret)\n\n    def normpath(self, path: str) -> str:\n        return posixpath.normpath(path)\n\n    def abspath(self, path: str) -> str:\n        if not posixpath.isabs(path):\n            path = self.join(self.getcwd(), path)\n        return self.normpath(path)\n\n    def relpath(self, path: str, start: Optional[str] = None) -> str:\n        if start is None:\n            start = \".\"\n        return posixpath.relpath(self.abspath(path), start=self.abspath(start))\n\n    def relparts(self, path: str, start: Optional[str] = None) -> tuple[str, ...]:\n        return self.parts(self.relpath(path, start=start))\n\n    @functools.cached_property\n    def repo(self):\n        if self._repo:\n            return self._repo\n\n        repo = self._make_repo(**self._repo_kwargs)\n\n        self._repo_stack.enter_context(repo)\n        self._repo = repo\n        return repo\n\n    @functools.cached_property\n    def repo_factory(self):\n        if self._repo_factory:\n            return self._repo_factory\n\n        if self._repo:\n            from dvc.repo import Repo\n\n            return Repo\n\n        return self.repo._fs_conf[\"repo_factory\"]\n\n    @functools.cached_property\n    def fsid(self) -> str:\n        from fsspec.utils import tokenize\n\n        from dvc.scm import NoSCM\n\n        return \"dvcfs_\" + tokenize(\n            self.repo.url or self.repo.root_dir,\n            self.repo.get_rev() if not isinstance(self.repo.scm, NoSCM) else None,\n        )\n\n    def _get_key(self, path: \"StrPath\") -> Key:\n        path = os.fspath(path)\n        parts = self.repo.fs.relparts(path, self.repo.root_dir)\n        if parts == (os.curdir,):\n            return ()\n        return parts\n\n    @functools.cached_property\n    def _subrepos_trie(self):\n        \"\"\"Keeps track of each and every path with the corresponding repo.\"\"\"\n\n        from pygtrie import Trie\n\n        trie = Trie()\n        key = self._get_key(self.repo.root_dir)\n        trie[key] = self.repo\n        return trie\n\n    def _get_key_from_relative(self, path) -> Key:\n        path = self._strip_protocol(path)\n        parts = self.relparts(path, self.root_marker)\n        if parts and parts[0] == os.curdir:\n            return parts[1:]\n        return parts\n\n    def _from_key(self, parts: Key) -> str:\n        return self.repo.fs.join(self.repo.root_dir, *parts)\n\n    @functools.cached_property\n    def _datafss(self):\n        \"\"\"Keep a datafs instance of each repo.\"\"\"\n\n        datafss = {}\n\n        if hasattr(self.repo, \"dvc_dir\"):\n            key = self._get_key(self.repo.root_dir)\n            datafss[key] = DataFileSystem(index=self.repo.index.data[\"repo\"])\n\n        return datafss\n\n    @property\n    def repo_url(self):\n        return self.repo.url\n\n    @classmethod\n    def _make_repo(cls, **kwargs) -> \"Repo\":\n        from dvc.repo import Repo\n\n        with Repo.open(uninitialized=True, **kwargs) as repo:\n            return repo\n\n    def _get_repo(self, key: Key) -> \"Repo\":\n        \"\"\"Returns repo that the path falls in, using prefix.\n\n        If the path is already tracked/collected, it just returns the repo.\n\n        Otherwise, it collects the repos that might be in the path's parents\n        and then returns the appropriate one.\n        \"\"\"\n        repo = self._subrepos_trie.get(key)\n        if repo:\n            return repo\n\n        prefix_key, repo = self._subrepos_trie.longest_prefix(key)\n        dir_keys = (key[:i] for i in range(len(prefix_key) + 1, len(key) + 1))\n        self._update(dir_keys, starting_repo=repo)\n        return self._subrepos_trie.get(key) or self.repo\n\n    @wrap_with(threading.Lock())\n    def _update(self, dir_keys, starting_repo):\n        \"\"\"Checks for subrepo in directories and updates them.\"\"\"\n        repo = starting_repo\n        for key in dir_keys:\n            d = self._from_key(key)\n            if self._is_dvc_repo(d):\n                repo = self.repo_factory(\n                    d,\n                    fs=self.repo.fs,\n                    scm=self.repo.scm,\n                    repo_factory=self.repo_factory,\n                )\n                self._repo_stack.enter_context(repo)\n                self._datafss[key] = DataFileSystem(index=repo.index.data[\"repo\"])\n            self._subrepos_trie[key] = repo\n\n    def _is_dvc_repo(self, dir_path):\n        \"\"\"Check if the directory is a dvc repo.\"\"\"\n        if not self._traverse_subrepos:\n            return False\n\n        from dvc.repo import Repo\n\n        repo_path = self.repo.fs.join(dir_path, Repo.DVC_DIR)\n        return self.repo.fs.isdir(repo_path)\n\n    def _get_subrepo_info(\n        self, key: Key\n    ) -> tuple[\"Repo\", Optional[DataFileSystem], Key]:\n        \"\"\"\n        Returns information about the subrepo the key is part of.\n        \"\"\"\n        repo = self._get_repo(key)\n        repo_key: Key\n        if repo is self.repo:\n            repo_key = ()\n            subkey = key\n        else:\n            repo_key = self._get_key(repo.root_dir)\n            subkey = key[len(repo_key) :]\n\n        dvc_fs = self._datafss.get(repo_key)\n        return repo, dvc_fs, subkey\n\n    def _open(self, path, mode=\"rb\", **kwargs):\n        if mode != \"rb\":\n            raise OSError(errno.EROFS, os.strerror(errno.EROFS))\n\n        key = self._get_key_from_relative(path)\n        fs_path = self._from_key(key)\n        try:\n            return self.repo.fs.open(fs_path, mode=mode)\n        except FileNotFoundError:\n            _, dvc_fs, subkey = self._get_subrepo_info(key)\n            if not dvc_fs:\n                raise\n\n        dvc_path = _get_dvc_path(dvc_fs, subkey)\n        return dvc_fs.open(dvc_path, mode=mode, cache=kwargs.get(\"cache\", False))\n\n    def isdvc(self, path, **kwargs) -> bool:\n        \"\"\"Is this entry dvc-tracked?\"\"\"\n        try:\n            return self.info(path).get(\"dvc_info\", {}).get(\"isout\", False)\n        except FileNotFoundError:\n            return False\n\n    def ls(self, path, detail=True, dvc_only=False, **kwargs):  # noqa: C901, PLR0912\n        key = self._get_key_from_relative(path)\n        repo, dvc_fs, subkey = self._get_subrepo_info(key)\n\n        dvc_infos = {}\n        dvc_info = {}\n        if dvc_fs:\n            dvc_path = _get_dvc_path(dvc_fs, subkey)\n            with suppress(FileNotFoundError):\n                dvc_info = dvc_fs.info(dvc_path)\n                if dvc_info[\"type\"] == \"file\":\n                    dvc_infos[\"\"] = dvc_info\n                else:\n                    for info in dvc_fs.ls(dvc_path, detail=True):\n                        dvc_infos[dvc_fs.name(info[\"name\"])] = info\n\n        fs_infos = {}\n        fs_info = {}\n        ignore_subrepos = kwargs.get(\"ignore_subrepos\", True)\n        if not dvc_only:\n            fs = self.repo.fs\n            fs_path = self._from_key(key)\n            try:\n                fs_info = fs.info(fs_path)\n                if fs_info[\"type\"] == \"file\":\n                    fs_infos[\"\"] = fs_info\n                else:\n                    for info in repo.dvcignore.ls(\n                        fs, fs_path, detail=True, ignore_subrepos=ignore_subrepos\n                    ):\n                        fs_infos[fs.name(info[\"name\"])] = info\n            except (FileNotFoundError, NotADirectoryError):\n                pass\n\n        if not (fs_info or dvc_info):\n            # broken symlink or TreeError\n            raise FileNotFoundError(errno.ENOENT, os.strerror(errno.ENOENT), path)\n\n        if fs_info and dvc_info and dvc_info[\"type\"] != fs_info[\"type\"]:\n            dvc_infos.clear()  # invalidate dvc_info if file type differs\n\n        dvcfiles = kwargs.get(\"dvcfiles\", False)\n\n        infos = []\n        paths = []\n        names = set(dvc_infos.keys()) | set(fs_infos.keys())\n\n        for name in names:\n            if not dvcfiles and _is_dvc_file(name):\n                continue\n\n            entry_path = self.join(path, name) if name else path\n            info = _merge_info(\n                repo, (*subkey, name), fs_infos.get(name), dvc_infos.get(name)\n            )\n            info[\"name\"] = entry_path\n            infos.append(info)\n            paths.append(entry_path)\n\n        if not detail:\n            return paths\n\n        return infos\n\n    def info(self, path, **kwargs):\n        key = self._get_key_from_relative(path)\n        ignore_subrepos = kwargs.get(\"ignore_subrepos\", True)\n        return self._info(key, path, ignore_subrepos=ignore_subrepos)\n\n    def _info(  # noqa: C901\n        self, key, path, ignore_subrepos=True, check_ignored=True\n    ):\n        repo, dvc_fs, subkey = self._get_subrepo_info(key)\n\n        dvc_info = None\n        if dvc_fs:\n            try:\n                dvc_info = dvc_fs.fs.index.info(subkey)\n                dvc_path = _get_dvc_path(dvc_fs, subkey)\n                dvc_info[\"name\"] = dvc_path\n            except KeyError:\n                pass\n\n        fs_info = None\n        fs = self.repo.fs\n        fs_path = self._from_key(key)\n        try:\n            fs_info = fs.info(fs_path)\n            if check_ignored and repo.dvcignore.is_ignored(\n                fs, fs_path, ignore_subrepos=ignore_subrepos\n            ):\n                fs_info = None\n        except (FileNotFoundError, NotADirectoryError):\n            if not dvc_info:\n                raise\n\n        # NOTE: if some parent in fs_path turns out to be a file, it means\n        # that the whole repofs branch doesn't exist.\n        if dvc_info and not fs_info:\n            for parent in fs.parents(fs_path):\n                try:\n                    if fs.info(parent)[\"type\"] != \"directory\":\n                        dvc_info = None\n                        break\n                except FileNotFoundError:\n                    continue\n\n        if not dvc_info and not fs_info:\n            raise FileNotFoundError(errno.ENOENT, os.strerror(errno.ENOENT), path)\n\n        info = _merge_info(repo, subkey, fs_info, dvc_info)\n        info[\"name\"] = path\n        return info\n\n    def get(\n        self,\n        rpath,\n        lpath,\n        recursive=False,\n        callback=DEFAULT_CALLBACK,\n        maxdepth=None,\n        batch_size=None,\n        **kwargs,\n    ):\n        self._get(\n            rpath,\n            lpath,\n            recursive=recursive,\n            callback=callback,\n            maxdepth=maxdepth,\n            batch_size=batch_size,\n            **kwargs,\n        )\n\n    def _get(  # noqa: C901, PLR0912, PLR0915\n        self,\n        rpath,\n        lpath,\n        recursive=False,\n        callback=DEFAULT_CALLBACK,\n        maxdepth=None,\n        batch_size=None,\n        **kwargs,\n    ) -> list[tuple[str, str, Optional[dict]]]:\n        if (\n            isinstance(rpath, list)\n            or isinstance(lpath, list)\n            or has_magic(rpath)\n            or not self.exists(rpath)\n            or not recursive\n        ):\n            super().get(\n                rpath,\n                lpath,\n                recursive=recursive,\n                callback=callback,\n                maxdepth=maxdepth,\n                **kwargs,\n            )\n            return []\n\n        if os.path.isdir(lpath) or lpath.endswith(os.path.sep):\n            lpath = self.join(lpath, os.path.basename(rpath))\n\n        if self.isfile(rpath):\n            with callback.branched(rpath, lpath) as child:\n                self.get_file(rpath, lpath, callback=child, **kwargs)\n                return [(rpath, lpath, None)]\n\n        result: list[tuple[str, str, Optional[dict]]] = []\n        _dirs: list[str] = []\n        _files: dict[FileSystem, list[tuple[str, str, Optional[dict]]]]\n        _files = defaultdict(list)\n\n        for root, dirs, files in self.walk(rpath, maxdepth=maxdepth, detail=True):\n            if files:\n                callback.set_size((callback.size or 0) + len(files))\n\n            parts = self.relparts(root, rpath)\n            if parts in ((os.curdir,), (\"\",)):\n                parts = ()\n            dest_root = os.path.join(lpath, *parts)\n            if not maxdepth or len(parts) < maxdepth - 1:\n                _dirs.extend(f\"{dest_root}{os.path.sep}{d}\" for d in dirs)\n\n            key = self._get_key_from_relative(root)\n            _, dvc_fs, _ = self._get_subrepo_info(key)\n\n            for name, info in files.items():\n                dvc_info = info.get(\"dvc_info\")\n                fs_info = info.get(\"fs_info\")\n                if dvc_fs and dvc_info and not fs_info:\n                    fs = dvc_fs\n                    fs_path = dvc_info[\"name\"]\n                else:\n                    fs = self.repo.fs\n                    fs_path = fs_info[\"name\"]\n\n                src_path = f\"{root}{self.sep}{name}\"\n                dest_path = f\"{dest_root}{os.path.sep}{name}\"\n                _files[fs].append((fs_path, dest_path, dvc_info))\n                result.append((src_path, dest_path, info))\n\n        os.makedirs(lpath, exist_ok=True)\n        for d in _dirs:\n            os.makedirs(d, exist_ok=True)\n\n        def get_file(arg: tuple[FileSystem, tuple[str, str, Optional[dict]]]):\n            fs, (src, dest, info) = arg\n            kw = kwargs\n            if isinstance(fs, DataFileSystem):\n                kw = kw | {\"info\": info}\n            with callback.branched(src, dest) as child:\n                fs.get_file(src, dest, callback=child, **kw)\n\n        if batch_size == 1:\n            ctx: AbstractContextManager = nullcontext()\n            map_fn: Callable = map\n        else:\n            ctx = ThreadPoolExecutor(max_workers=batch_size)\n            map_fn = ctx.imap_unordered\n\n        with ctx:\n            it = ((fs, f) for fs, files in _files.items() for f in files)\n            deque(callback.wrap(map_fn(get_file, it)), maxlen=0)\n        return result\n\n    def get_file(self, rpath, lpath, **kwargs):\n        dvc_info = kwargs.pop(\"info\", {}).pop(\"dvc_info\", None)\n        key = self._get_key_from_relative(rpath)\n        fs_path = self._from_key(key)\n        dirpath = os.path.dirname(lpath)\n        if dirpath:\n            # makedirs raises error if the string is empty\n            os.makedirs(dirpath, exist_ok=True)\n\n        try:\n            return self.repo.fs.get_file(fs_path, lpath, **kwargs)\n        except FileNotFoundError:\n            _, dvc_fs, subkey = self._get_subrepo_info(key)\n            if not dvc_fs:\n                raise\n\n        dvc_path = _get_dvc_path(dvc_fs, subkey)\n        return dvc_fs.get_file(dvc_path, lpath, info=dvc_info, **kwargs)\n\n    def du(self, path, total=True, maxdepth=None, withdirs=False, **kwargs):\n        if maxdepth is not None:\n            raise NotImplementedError\n\n        sizes = {}\n        dus = {}\n        todo = deque([self.info(path)])\n        while todo:\n            info = todo.popleft()\n            isdir = info[\"type\"] == \"directory\"\n            size = info[\"size\"] or 0\n            name = info[\"name\"]\n\n            if not isdir:\n                sizes[name] = size\n                continue\n\n            dvc_info = info.get(\"dvc_info\") or {}\n            fs_info = info.get(\"fs_info\")\n            entry = dvc_info.get(\"entry\")\n            if (\n                dvc_info\n                and not fs_info\n                and entry is not None\n                and entry.size is not None\n            ):\n                dus[name] = entry.size\n                continue\n\n            if withdirs:\n                sizes[name] = size\n\n            todo.extend(self.ls(info[\"name\"], detail=True))\n\n        if total:\n            return sum(sizes.values()) + sum(dus.values())\n\n        return sizes\n\n    def close(self):\n        self._repo_stack.close()\n\n\nclass DVCFileSystem(FileSystem):\n    protocol = \"local\"\n    PARAM_CHECKSUM = \"md5\"\n\n    def _prepare_credentials(self, **config) -> dict[str, Any]:\n        return config\n\n    @functools.cached_property\n    def fs(self) -> \"_DVCFileSystem\":\n        return _DVCFileSystem(**self.fs_args)\n\n    @property\n    def immutable(self):\n        from dvc.scm import NoSCM\n\n        if isinstance(self.fs.repo.scm, NoSCM):\n            return False\n\n        return self.fs._repo_kwargs.get(\"rev\") == self.fs.repo.get_rev()\n\n    def getcwd(self):\n        return self.fs.getcwd()\n\n    def _get(\n        self,\n        from_info: Union[AnyFSPath, list[AnyFSPath]],\n        to_info: Union[AnyFSPath, list[AnyFSPath]],\n        callback: \"Callback\" = DEFAULT_CALLBACK,\n        recursive: bool = False,\n        batch_size: Optional[int] = None,\n        **kwargs,\n    ) -> list[tuple[str, str, Optional[dict]]]:\n        # FileSystem.get is non-recursive by default if arguments are lists\n        # otherwise, it's recursive.\n        recursive = not (isinstance(from_info, list) and isinstance(to_info, list))\n        return self.fs._get(\n            from_info,\n            to_info,\n            callback=callback,\n            recursive=recursive,\n            batch_size=batch_size,\n            **kwargs,\n        )\n\n    def get(\n        self,\n        from_info: Union[AnyFSPath, list[AnyFSPath]],\n        to_info: Union[AnyFSPath, list[AnyFSPath]],\n        callback: \"Callback\" = DEFAULT_CALLBACK,\n        recursive: bool = False,\n        batch_size: Optional[int] = None,\n        **kwargs,\n    ) -> None:\n        self._get(\n            from_info,\n            to_info,\n            callback=callback,\n            batch_size=batch_size,\n            recursive=recursive,\n            **kwargs,\n        )\n\n    @property\n    def fsid(self) -> str:\n        return self.fs.fsid\n\n    def isdvc(self, path, **kwargs) -> bool:\n        return self.fs.isdvc(path, **kwargs)\n\n    @property\n    def repo(self) -> \"Repo\":\n        return self.fs.repo\n\n    @property\n    def repo_url(self) -> str:\n        return self.fs.repo_url\n\n    def from_os_path(self, path: str) -> str:\n        if os.path.isabs(path) or (\n            os.name == \"nt\" and posixpath.isabs(path) and ntpath.sep not in path\n        ):\n            path = os.path.relpath(path, self.repo.root_dir)\n        return as_posix(path)\n\n    def close(self):\n        if \"fs\" in self.__dict__:\n            self.fs.close()\n","numLines":745,"startLine":1,"totalLines":745}}}
