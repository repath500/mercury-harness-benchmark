{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a06a67077472a18a0cf6f1","type":"tool_result","content":"1\tfrom copy import deepcopy\n2\tfrom typing import TYPE_CHECKING, Any, ClassVar, Optional, Union\n3\t\n4\timport voluptuous as vol\n5\t\n6\tfrom dvc.utils import as_posix\n7\t\n8\tfrom .base import Dependency\n9\t\n10\tif TYPE_CHECKING:\n11\t    from dvc.fs import DVCFileSystem\n12\t    from dvc.output import Output\n13\t    from dvc.stage import Stage\n14\t    from dvc_data.hashfile.hash_info import HashInfo\n15\t\n16\t\n17\tclass RepoDependency(Dependency):\n18\t    PARAM_REPO = \"repo\"\n19\t    PARAM_URL = \"url\"\n20\t    PARAM_REV = \"rev\"\n21\t    PARAM_REV_LOCK = \"rev_lock\"\n22\t    PARAM_CONFIG = \"config\"\n23\t    PARAM_REMOTE = \"remote\"\n24\t\n25\t    REPO_SCHEMA: ClassVar[dict] = {\n26\t        PARAM_REPO: {\n27\t            vol.Required(PARAM_URL): str,\n28\t            PARAM_REV: str,\n29\t            PARAM_REV_LOCK: str,\n30\t            PARAM_CONFIG: vol.Any(str, dict),\n31\t            PARAM_REMOTE: vol.Any(str, dict),\n32\t        }\n33\t    }\n34\t\n35\t    def __init__(self, def_repo: dict[str, Any], stage: \"Stage\", *args, **kwargs):\n36\t        self.def_repo = def_repo\n37\t        super().__init__(stage, *args, **kwargs)\n38\t\n39\t        self.fs = self._make_fs()\n40\t        self.fs_path = as_posix(self.fs.normpath(self.def_path))\n41\t\n42\t    def _parse_path(self, fs, fs_path):  # noqa: ARG002\n43\t        return None\n44\t\n45\t    @property\n46\t    def is_in_repo(self):\n47\t        return False\n48\t\n49\t    def __str__(self):\n50\t        return f\"{self.def_path} ({self.def_repo[self.PARAM_URL]})\"\n51\t\n52\t    def workspace_status(self):\n53\t        current = self._make_fs(locked=True).repo.get_rev()\n54\t        updated = self._make_fs(locked=False).repo.get_rev()\n55\t\n56\t        if current != updated:\n57\t            return {str(self): \"update available\"}\n58\t\n59\t        return {}\n60\t\n61\t    def status(self):\n62\t        return self.workspace_status()\n63\t\n64\t    def save(self):\n65\t        rev = self.fs.repo.get_rev()\n66\t        if self.def_repo.get(self.PARAM_REV_LOCK) is None:\n67\t            self.def_repo[self.PARAM_REV_LOCK] = rev\n68\t\n69\t    @classmethod\n70\t    def _dump_def_repo(cls, def_repo) -> dict[str, str]:\n71\t        repo = {cls.PARAM_URL: def_repo[cls.PARAM_URL]}\n72\t\n73\t        rev = def_repo.get(cls.PARAM_REV)\n74\t        if rev:\n75\t            repo[cls.PARAM_REV] = def_repo[cls.PARAM_REV]\n76\t\n77\t        rev_lock = def_repo.get(cls.PARAM_REV_LOCK)\n78\t        if rev_lock:\n79\t            repo[cls.PARAM_REV_LOCK] = rev_lock\n80\t\n81\t        config = def_repo.get(cls.PARAM_CONFIG)\n82\t        if config:\n83\t            repo[cls.PARAM_CONFIG] = config\n84\t\n85\t        remote = def_repo.get(cls.PARAM_REMOTE)\n86\t        if remote:\n87\t            repo[cls.PARAM_REMOTE] = remote\n88\t        return repo\n89\t\n90\t    def dumpd(self, **kwargs) -> dict[str, Union[str, dict[str, str]]]:\n91\t        return {\n92\t            self.PARAM_PATH: self.def_path,\n93\t            self.PARAM_REPO: self._dump_def_repo(self.def_repo),\n94\t        }\n95\t\n96\t    def download(self, to: \"Output\", jobs: Optional[int] = None):\n97\t        from dvc.fs import LocalFileSystem\n98\t\n99\t        files = super().download(to=to, jobs=jobs)\n100\t        if not isinstance(to.fs, LocalFileSystem):\n101\t            return\n102\t\n103\t        hashes: list[tuple[str, HashInfo, dict[str, Any]]] = []\n104\t        for src_path, dest_path, maybe_info in files:\n105\t            try:\n106\t                info = maybe_info or self.fs.info(src_path)\n107\t                hash_info = info[\"dvc_info\"][\"entry\"].hash_info\n108\t                dest_info = to.fs.info(dest_path)\n109\t            except (KeyError, AttributeError):\n110\t                # If no hash info found, just keep going and output will be hashed