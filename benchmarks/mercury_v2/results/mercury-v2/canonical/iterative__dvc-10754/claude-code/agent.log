.dvc_gen({\"data\": {\"foo\": \"foo\", \"bar\": \"bar\"}}, commit=\"data\")\n57\t        dvc.push()\n58\t\n59\t        if clear_cache:\n60\t            remove(dvc.cache.repo.path)\n61\t\n62\t        if url := fs_kwargs.get(\"url\"):\n63\t            fs_kwargs[\"url\"] = url.format(path=tmp_dir, posixpath=tmp_dir.as_posix())\n64\t        if rev := fs_kwargs.get(\"rev\"):\n65\t            fs_kwargs[\"rev\"] = rev.format(default_branch=scm.active_branch())\n66\t\n67\t        fs = DVCFileSystem(**fs_kwargs)\n68\t\n69\t        assert fs.ls(\"/\", detail=False) == M.unordered(\n70\t            \"/.gitignore\", \"/scripts\", \"/data\"\n71\t        )\n72\t        assert fs.ls(\"scripts\", detail=False) == [\"scripts/script1\"]\n73\t        assert fs.ls(\"data\", detail=False) == M.unordered(\"data/foo\", \"data/bar\")\n74\t\n75\t        data_info = M.dict(\n76\t            name=\"/data\",\n77\t            type=\"directory\",\n78\t            dvc_info=M.dict(isdvc=True, isout=True),\n79\t        )\n80\t        scripts_info = M.dict(name=\"/scripts\", type=\"directory\", isexec=False)\n81\t\n82\t        assert sorted(fs.ls(\"/\"), key=lambda i: i[\"name\"]) == [\n83\t            M.dict(name=\"/.gitignore\", type=\"file\", isexec=False),\n84\t            data_info,\n85\t            scripts_info,\n86\t        ]\n87\t\n88\t        with pytest.raises(FileNotFoundError):\n89\t            fs.info(\"/not-existing-path\")\n90\t\n91\t        assert fs.info(\"/\") == M.dict(name=\"/\", isexec=False, type=\"directory\")\n92\t        assert fs.info(\"/data\") == data_info\n93\t        assert fs.info(\"/scripts\") == scripts_info\n94\t        assert fs.info(\"/data/foo\") == M.dict(name=\"/data/foo\", type=\"file\")\n95\t        assert fs.info(\"/scripts/script1\") == M.dict(\n96\t            name=\"/scripts/script1\", type=\"file\"\n97\t        )\n98\t\n99\t        assert not fs.isdvc(\"/\")\n100\t        assert fs.isdvc(\"/data\")\n101\t        assert fs.isdvc(\"/data/foo\")\n102\t     