+    @pytest.mark.asyncio
+    async def test_run_config_settings_are_used_when_no_initial_settings(self):
+        """Test that run config settings are used when initial settings are absent."""
+        mock_model = Mock(spec=RealtimeModel)
+        mock_model.connect = AsyncMock()
+        mock_model.add_listener = Mock()
+
+        agent = Mock(spec=RealtimeAgent)
