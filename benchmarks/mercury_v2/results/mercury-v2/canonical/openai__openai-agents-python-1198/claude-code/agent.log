{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_48686a0758f84865b2028810","type":"tool_result","content":"1\t\"\"\"Minimal realtime session implementation for voice agents.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom ..run_context import TContext\n6\tfrom .agent import RealtimeAgent\n7\tfrom .config import (\n8\t    RealtimeRunConfig,\n9\t)\n10\tfrom .model import (\n11\t    RealtimeModel,\n12\t    RealtimeModelConfig,\n13\t)\n14\tfrom .openai_realtime import OpenAIRealtimeWebSocketModel\n15\tfrom .session import RealtimeSession\n16\t\n17\t\n18\tclass RealtimeRunner:\n19\t    \"\"\"A `RealtimeRunner` is the equivalent of `Runner` for realtime agents. It automatically\n20\t    handles multiple turns by maintaining a persistent connection with the underlying model\n21\t    layer.\n22\t\n23\t    The session manages the local history copy, executes tools, runs guardrails and facilitates\n24\t    handoffs between agents.\n25\t\n26\t    Since this code runs on your server, it uses WebSockets by default. You can optionally create\n27\t    your own custom model layer by implementing the `RealtimeModel` interface.\n28\t    \"\"\"\n29\t\n30\t    def __init__(\n31\t        self,\n32\t        starting_agent: RealtimeAgent,\n33\t        *,\n34\t        model: RealtimeModel | None = None,\n35\t        config: RealtimeRunConfig | None = None,\n36\t    ) -> None:\n37\t        \"\"\"Initialize the realtime runner.\n38\t\n39\t        Args:\n40\t            starting_agent: The agent to start the session with.\n41\t            context: The context to use for the session.\n42\t            model: The model to use. If not provided, will use a default OpenAI realtime model.\n43\t            config: Override parameters to use for the entire run.\n44\t        \"\"\"\n45\t        self._starting_agent = starting_agent\n46\t        self._config = config\n47\t        self._model = model or OpenAIRealtimeWebSocketModel()\n48\t\n49\t    async def run(\n50\t        self, *, context: TContext | None = None, model_config: RealtimeModelConfig | None = None\n51\t    ) -> RealtimeSession:\n52\t        \"\"\"Start and returns a realtime session.\n53\t\n54\t        Returns:\n55\t            RealtimeSession: A session object that allows bidirectional communication with the\n56\t            realtime model.\n57\t\n58\t        Example:\n59\t            ```python\n60\t            runner = RealtimeRunner(agent)\n61\t            async with await runner.run() as session:\n62\t                await session.send_message(\"Hello\")\n63\t                async for event in session:\n64\t                    print(event)\n65\t            ```\n66\t        \"\"\"\n67\t        # Create and return the connection\n68\t        session = RealtimeSession(\n69\t            model=self._model,\n70\t            agent=self._starting_agent,\n71\t            context=context,\n72\t            model_config=model_config,\n73\t            run_config=self._config,\n74\t        )\n75\t\n76\t        return session\n77\t"}]},"parent_tool_use_id":null,"session_id":"f9b990b0-ca4b-481f-a781-dd48cfe3ddbd","uuid":"c87e5003-fa03-421b-8399-5785fe9a11c8","timestamp":"2026-09-04T01:06:21.288Z","tool_use_result":{"type":"text","file":{"filePath":"/testbed/src/agents/realtime/runner.py","content":"\"\"\"Minimal realtime session implementation for voice agents.\"\"\"\n\nfrom __future__ import annotations\n\nfrom ..run_context import TContext\nfrom .agent import RealtimeAgent\nfrom .config import (\n    RealtimeRunConfig,\n)\nfrom .model import (\n    RealtimeModel,\n    RealtimeModelConfig,\n)\nfrom .openai_realtime import OpenAIRealtimeWebSocketModel\nfrom .session import RealtimeSession\n\n\nclass RealtimeRunner:\n    \"\"\"A `RealtimeRunner` is the equivalent of `Runner` for realtime agents. It automatically\n    handles multiple turns by maintaining a persistent connection with the underlying model\n    layer.\n\n    The session manages the local history copy, executes tools, runs guardrails and facilitates\n    handoffs between agents.\n\n    Since this code runs on your server, it uses WebSockets by default. You can optionally create\n    your own custom model layer by implementing the `RealtimeModel` interface.\n    \"\"\"\n\n    def __init__(\n        self,\n        starting_agent: RealtimeAgent,\n        *,\n        model: RealtimeModel | None = None,\n        config: RealtimeRunConfig | None = None,\n    ) -> None:\n        \"\"\"Initialize the realtime runner.\n\n        Args:\n            starting_agent: The agent to start the session with.\n            context: The context to use for the session.\n            model: The model to use. If not provided, will use a default OpenAI realtime model.\n            config: Override parameters to use for the entire run.\n        \"\"\"\n        self._starting_agent = starting_agent\n        self._config = config\n        self._model = model or OpenAIRealtimeWebSocketModel()\n\n    async def run(\n        self, *, context: TContext | None = None, model_config: RealtimeModelConfig | None = None\n    ) -> RealtimeSession:\n        \"\"\"Start and returns a realtime session.\n\n        Returns:\n            RealtimeSession: A session object that allows bidirectional communication with the\n            realtime model.\n\n        Example:\n            ```python\n            runner = RealtimeRunner(agent)\n            async with await runner.run() as session:\n                await session.send_message(\"Hello\")\n                async for event in session:\n                    print(event)\n            ```\n        \"\"\"\n        # Create and return the connection\n        session = RealtimeSession(\n            model=self._model,\n            agent=self._starting_agent,\n            context=context,\n            model_config=model_config,\n            run_config=self._config,\n        )\n\n        return session\n","numLines":77,"startLine":1,"totalLines":77}}}
