+def test_empty_cell_collection():
+    """Test that empty CellCollections work without errors."""
+    rng = random.Random()
+
+    # direct initialization with an empty iterable
+    empty = CellCollection([], random=rng)
+    assert len(empty) == 0
+    assert list(empty) == []
+    assert empty.cells == []
+    assert list(empty.agents) == []
+    assert empty._capacity is None
+
+    # direct initialization with an empty mapping
+    empty = CellCollection({}, random=rng)
+    assert len(empty) == 0
+    assert empty._capacity is None
+
+    # select with a filter that matches no cells returns an empty collection
+    collection = CellCollection(
+        [Cell((i,), capacity=5, random=rng) for i in range(10)], random=rng
+    )
+    empty = collection.select(lambda cell: False)
+    assert len(empty) == 0
+    assert empty._capacity is None
+
+    # methods on an empty collection don't raise
+    assert list(empty.select()) == []
+    assert len(empty.select(at_most=0.5)) == 0
+    assert list(empty.select(lambda cell: True)) == []
+
+    # capacity of a non-empty collection is unchanged
+    assert collection._capacity == 5
+
+
