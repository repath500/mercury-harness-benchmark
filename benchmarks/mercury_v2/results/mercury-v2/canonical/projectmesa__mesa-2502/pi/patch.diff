+def test_empty_cell_collection():
+    """Test that empty CellCollections work correctly (issue #2473)."""
+    rng = random.Random()
+
+    # directly create an empty collection
+    collection = CellCollection([], random=rng)
+    assert len(collection) == 0
+    assert collection._capacity is None
+
+    # create an empty collection using select
+    collection = CellCollection(
+        [Cell((i,), random=rng) for i in range(10)], random=rng
+    )
+    empty_collection = collection.select(lambda cell: False)
+    assert len(empty_collection) == 0
+    assert empty_collection._capacity is None
+
+    # chaining select on an empty collection works as well
+    assert len(empty_collection.select()) == 0
+    assert len(empty_collection.select(at_most=0.5)) == 0
+
+
