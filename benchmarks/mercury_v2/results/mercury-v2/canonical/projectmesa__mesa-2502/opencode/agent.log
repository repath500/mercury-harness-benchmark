{"type":"tool_use","timestamp":1788463195019,"sessionID":"ses_f974d9641ffeYfNBhdx33Io0s3","part":{"type":"tool","tool":"bash","callID":"call_dbd266db829840ae9a2156a1","state":{"status":"completed","input":{"command":"git diff"},"output":"diff --git a/mesa/experimental/cell_space/cell_collection.py b/mesa/experimental/cell_space/cell_collection.py\nindex ead67021..ea683126 100644\n--- a/mesa/experimental/cell_space/cell_collection.py\n+++ b/mesa/experimental/cell_space/cell_collection.py\n@@ -49,7 +49,9 @@ class CellCollection(Generic[T]):\n             self._cells = {cell: cell.agents for cell in cells}\n \n         #\n-        self._capacity: int = next(iter(self._cells.keys())).capacity\n+        self._capacity: int | None = (\n+            next(iter(self._cells.keys())).capacity if self._cells else None\n+        )\n \n         if random is None:\n             warnings.warn(\n@@ -77,6 +79,17 @@ class CellCollection(Generic[T]):\n     def cells(self) -> list[T]:  # noqa\n         return list(self._cells.keys())\n \n+    @property\n+    def capacity(self) -> int | None:\n+        \"\"\"Capacity of the cells in the collection.\n+\n+        Returns:\n+            The capacity shared by all cells in the collection, or None if the\n+            collection is empty (in which case no capacity is available).\n+\n+        \"\"\"\n+        return self._capacity\n+\n     @property\n     def agents(self) -> Iterable[CellAgent]:  # noqa\n         return itertools.chain.from_iterable(self._cells.values())\ndiff --git a/tests/test_cell_space.py b/tests/test_cell_space.py\nindex add5f6f8..365de0c8 100644\n--- a/tests/test_cell_space.py\n+++ b/tests/test_cell_space.py\n@@ -583,6 +583,31 @@ def test_cell_collection():\n     assert len(cells) == len(collection)\n \n \n+def test_empty_cell_collection():\n+    \"\"\"Test CellCollection with no cells.\"\"\"\n+    collection = CellCollection([], random=random.Random())\n+    assert len(collection) == 0\n+    assert len(list(collection)) == 0\n+    assert len(collection.cells) == 0\n+    assert len(list(collection.agents)) == 0\n+    assert collection.capacity is None\n+\n+    selected = collection.select(lambda cell: True)\n+    assert len(selected) == 0\n+\n+    grid = OrthogonalMooreGrid((10, 10), torus=False, random=random.Random(42))\n+    empty = grid.all_cells.select(lambda cell: False)\n+    assert len(empty) == 0\n+    assert empty.capacity is None\n+\n+    grid = OrthogonalMooreGrid((10, 10), torus=False, random=random.Random(42))\n+    cell = grid[0, 0]\n+    cell.add_agent(CellAgent(Model()))\n+    not_empty = grid.all_cells.select(lambda cell: True)\n+    assert len(not_empty) == 100\n+    assert not_empty.capacity == cell.capacity\n+\n+\n ### PropertyLayer tests\n def test_property_layer_integration():\n     \"\"\"Test integration of PropertyLayer with DiscrateSpace and Cell.\"\"\"\n","metadata":{"output":"diff --git a/mesa/experimental/cell_space/cell_collection.py b/mesa/experimental/cell_space/cell_collection.py\nindex ead67021..ea683126 100644\n--- a/mesa/experimental/cell_space/cell_collection.py\n+++ b/mesa/experimental/cell_space/cell_collection.py\n@@ -49,7 +49,9 @@ class CellCollection(Generic[T]):\n             self._cells = {cell: cell.agents for cell in cells}\n \n         #\n-        self._capacity: int = next(iter(self._cells.keys())).capacity\n+        self._capacity: int | None = (\n+            next(iter(self._cells.keys())).capacity if self._cells else None\n+        )\n \n         if random is None:\n             warnings.warn(\n@@ -77,6 +79,17 @@ class CellCollection(Generic[T]):\n     def cells(self) -> list[T]:  # noqa\n         return list(self._cells.keys())\n \n+    @property\n+    def capacity(self) -> int | None:\n+        \"\"\"Capacity of the cells in the collection.\n+\n+        Returns:\n+            The capacity shared by all cells in the collection, or None if the\n+            collection is empty (in which case no capacity is available).\n+\n+        \"\"\"\n+        return self._capacity\n+\n     @property\n     def agents(self) -> Iterable[CellAgent]:  # noqa\n         return itertools.chain.from_iterable(self._cells.values())\ndiff --git a/tests/test_cell_space.py b/tests/test_cell_space.py\nindex add5f6f8..365de0c8 100644\n--- a/tests/test_cell_space.py\n+++ b/tests/test_cell_space.py\n@@ -583,6 +583,31 @@ def test_cell_collection():\n     assert len(cells) == len(collection)\n \n \n+def test_empty_cell_collection():\n+    \"\"\"Test CellCollection with no cells.\"\"\"\n+    collection = CellCollection([], random=random.Random())\n+    assert len(collection) == 0\n+    assert len(list(collection)) == 0\n+    assert len(collection.cells) == 0\n+    assert len(list(collection.agents)) == 0\n+    assert collection.capacity is None\n+\n+    selected = collection.select(lambda cell: True)\n+    assert len(selected) == 0\n+\n+    grid = OrthogonalMooreGrid((10, 10), torus=False, random=random.Random(42))\n+    empty = grid.all_cells.select(lambda cell: False)\n+    assert len(empty) == 0\n+    assert empty.capacity is None\n+\n+    grid = OrthogonalMooreGrid((10, 10), torus=False, random=random.Random(42))\n+    cell = grid[0, 0]\n+    cell.add_agent(CellAgent(Model()))\n+    not_empty = grid.all_cells.select(lambda cell: True)\n+    assert len(not_empty) == 100\n+    assert not_empty.capacity == cell.capacity\n+\n+\n ### PropertyLayer tests\n def test_property_layer_integration():\n     \"\"\"Test integration of PropertyLayer with DiscrateSpace and Cell.\"\"\"\n","exit":0,"truncated":false},"title":"git diff","time":{"start":1788463194983,"end":1788463195016}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Confirmed: the 5 lint errors exist on the base commit too (pre-existing). My changes are clean and formatted.\n\nLet me show the final diff to summarize.","format":"unknown","index":0}]}},"id":"prt_068b6a3620018bPHkNv93sWVmG","sessionID":"ses_f974d9641ffeYfNBhdx33Io0s3","message