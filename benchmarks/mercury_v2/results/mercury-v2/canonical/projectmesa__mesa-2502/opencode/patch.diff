+def test_empty_cell_collection():
+    """Test CellCollection with no cells."""
+    collection = CellCollection([], random=random.Random())
+    assert len(collection) == 0
+    assert len(list(collection)) == 0
+    assert len(collection.cells) == 0
+    assert len(list(collection.agents)) == 0
+    assert collection.capacity is None
+
+    selected = collection.select(lambda cell: True)
+    assert len(selected) == 0
+
+    grid = OrthogonalMooreGrid((10, 10), torus=False, random=random.Random(42))
+    empty = grid.all_cells.select(lambda cell: False)
+    assert len(empty) == 0
+    assert empty.capacity is None
+
+    grid = OrthogonalMooreGrid((10, 10), torus=False, random=random.Random(42))
+    cell = grid[0, 0]
+    cell.add_agent(CellAgent(Model()))
+    not_empty = grid.all_cells.select(lambda cell: True)
+    assert len(not_empty) == 100
+    assert not_empty.capacity == cell.capacity
+
+
