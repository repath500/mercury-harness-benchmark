+def test_encode_image_supports_generic_files(tmp_path):
+    pdf_path = tmp_path / "document.pdf"
+    pdf_path.write_bytes(b"%PDF-1.4")
+    video_path = tmp_path / "video.mov"
+    video_path.write_bytes(b"MOV")
+    unknown_path = tmp_path / "unknown"
+    unknown_path.write_bytes(b"data")
+
+    assert encode_image(str(pdf_path)).startswith("data:application/pdf;base64,")
+    assert encode_image(str(video_path)).startswith("data:video/quicktime;base64,")
+    assert encode_image(str(unknown_path)).startswith("data:application/octet-stream;base64,")
+    assert is_image(str(pdf_path))
+    assert is_image("data:application/pdf;base64,JVBERi0=")
+
+
+def test_encode_image_pil_uses_standard_mime(tmp_path):
+    png = PILImage.new("RGB", (1, 1), "red")
+    png_path = tmp_path / "pixel.png"
+    png.save(png_path)
+    jpeg_path = tmp_path / "pixel.jpg"
+    PILImage.new("RGB", (1, 1), "blue").save(jpeg_path, format="JPEG")
+    jpeg = PILImage.open(jpeg_path)
+
+    assert encode_image(png).startswith("data:image/png;base64,")
+    assert encode_image(jpeg).startswith("data:image/jpeg;base64,")
+
+
