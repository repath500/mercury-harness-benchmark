y data URI accepted (not just images)\ndata_uri = 'data:application/pdf;base64,JVBERi0xLjQ='\nassert encode_image(data_uri) == data_uri\nassert is_image(data_uri) is True\nprint('Data URI   -> passed through & recognized')\n\n# 5. is_image: any data URI, local file, backward compat\nassert is_image('data:image/png;base64,iVBORw0=') is True\nassert is_image(pdf_path) is True\nassert is_image('https://example.com/doc.pdf') is True\nprint('is_image   -> data URIs, files, URLs all valid')\n\n# 6. PIL images -> proper MIME per format\nfrom PIL import Image as PILImage\npng = PILImage.new('RGB', (10, 10)); png.format = None\nassert encode_image(png).startswith('data:image/png;base64,')\nbuf = tempfile.NamedTemporaryFile(suffix='.jpg', delete=False); buf.close()\npng.save(buf.name, format='JPEG'); jpeg = PILImage.open(buf.name)\nassert encode_image(jpeg).startswith('data:image/jpeg;base64,'), encode_image(jpeg)[:40]\nprint('PIL images -> image/png, image/jpeg')\n\n# 7. Clear error messages\ntry:\n    encode_image('/tmp/does_not_exist_12345')\nexcept ValueError as e:\n    print('Bad path   -> ValueError:', e)\ntry:\n    encode_image('not a url or file')\nexcept ValueError as e:\n    print('Bad string -> ValueError:', e)\ntry:\n    with tempfile.NamedTemporaryFile(suffix='.unknownext', delete=False) as f:\n        f.write(b'xyz'); p = f.name\n    encode_image(p)\nexcept ValueError as e:\n    print('No MIME    -> ValueError:', e)\n\n# 8. Backward-compat classmethods still work\nimg = Image.from_file(pdf_path); assert img.url.startswith('data:application/pdf')\nimg2 = Image.from_url('https://example.com/doc.pdf'); assert img2.url == 'https://example.com/doc.pdf'\nimg3 = Image.from_PIL(png); assert img3.url.startswith('data:image/png')\nprint('classmethods -> from_file/from_url/from_PIL OK')\n\n# cleanup\nfor p in [pdf_path, vid_path, aud_path, buf.name, p]: os.unlink(p)\nprint()\nprint('ALL SANITY CHECKS PASSED')\n\""}}],"api":"openai-completions","provider":"harbor-endpoint",