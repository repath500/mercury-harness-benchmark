jpeg).startswith('data:image/jpeg;base64,'), encode_image(jpeg)[:40]\nprint('PIL images -> image/png, image/jpeg')\n\n# 7. Clear error messages\ntry:\n    encode_image('/tmp/does_not_exist_12345')\nexcept ValueError as e:\n    print('Bad path   -> ValueError:', e)\ntry:\n    encode_image('not a url or file')\nexcept ValueError as e:\n    print('Bad string -> ValueError:', e)\ntry:\n    with tempfile.NamedTemporaryFile(suffix='.unknownext', delete=False) as f:\n        f.write(b'xyz'); p = f.name\n    encode_image(p)\nexcept ValueError as e:\n    print('No MIME    -> ValueError:', e)\n\n# 8. Backward-compat classmethods still work\nimg = Image.from_file(pdf_path); assert img.url.startswith('data:application/pdf')\nimg2 = Image.from_url('https://example.com/doc.pdf'); assert img2.url == 'https://example.com/doc.pdf'\nimg3 = Image.from_PIL(png); assert img3.url.startswith('data:image/png')\nprint('classmethods -> from_file/from_url/from_PIL OK')\n\n# cleanup\nfor p in [pdf_path, vid_path, aud_path, buf.name, p]: os.unlink(p)\nprint()\nprint('ALL SANITY CHECKS PASSED')\n\""}}],"api":"openai-completions","provider":"harbor-endpoint","model":"z-ai/glm-5.3-flash","usage":{"input":698,"output":1017,"cacheRead":30080,"cacheWrite":0,"reasoning":171,"totalTokens":31795,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1788480446481,"responseId":"gen-1788480446-k1ISoQd8hLh7s4bNwUFJ","rawStopReason":"tool_calls"}}
