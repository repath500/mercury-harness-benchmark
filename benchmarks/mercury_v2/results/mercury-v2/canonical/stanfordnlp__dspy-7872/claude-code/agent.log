_patterns(obj, pattern):\n54\t            count = 0\n55\t            if check_pattern(obj, pattern):\n56\t                count += 1\n57\t            if isinstance(obj, dict):\n58\t                count += sum(count_patterns(v, pattern) for v in obj.values())\n59\t            if isinstance(obj, (list, tuple)):\n60\t                count += sum(count_patterns(v, pattern) for v in obj)\n61\t            return count\n62\t            \n63\t        return count_patterns(messages, pattern)\n64\t    except Exception:\n65\t        return 0\n66\t\n67\tdef setup_predictor(signature, expected_output):\n68\t    \"\"\"Helper to set up a predictor with DummyLM\"\"\"\n69\t    lm = DummyLM([expected_output])\n70\t    dspy.settings.configure(lm=lm)\n71\t    return dspy.Predict(signature), lm\n72\t\n73\t@pytest.mark.parametrize(\"test_case\", [\n74\t    {\n75\t        \"name\": \"probabilistic_classification\",\n76\t        \"signature\": \"image: dspy.Image, class_labels: List[str] -> probabilities: Dict[str, float]\",\n77\t        \"inputs\": {\"image\": \"https://example.com/dog.jpg\", \"class_labels\": [\"dog\", \"cat\", \"bird\"]},\n78\t        \"key_output\": \"probabilities\",\n79\t        \"expected\": {\"probabilities\": {\"dog\": 0.8, \"cat\": 0.1, \"bird\": 0.1}}\n80\t    },\n81\t    {\n82\t        \"name\": \"image_to_code\",\n83\t        \"signature\": \"ui_image: dspy.Image, target_language: str -> generated_code: str\",\n84\t        \"inputs\": {\"ui_image\": \"https://example.com/button.png\", \"target_language\": \"HTML\"},\n85\t        \"key_output\": \"generated_code\",\n86\t        \"expected\": {\"generated_code\": \"<button>Click me</button>\"}\n87\t    },\n88\t    {\n89\t        \"name\": \"bbox_detection\",\n90\t        \"signature\": \"image: dspy.Image -> bboxes: List[Tuple[int, int, int, int]]\",\n91\t        \"inputs\": {\"image\": \"https://example.com/image.jpg\"},\n92\t        \"key_output\": \"bboxes\",\n93\t        \"expected\": {\"bboxes\": [(10, 20, 30, 40), (50, 60, 70, 80)]}\n94\t    },\n95\t    {\n96\t        \"name\": \"multilingual_caption\",\n97\t        \"signature\": \"image: dspy.Image, languages: List[str] -> captions: Dict[str, str]\",\n98\t        \"inputs\": {\"image\": \"https://example.com/dog.jpg\", \"languages\": [\"en\", \"es\", \"fr\"]},\n99\t        \"key_output\": \"captions\",\n100\t        \"expected\": {\"captions\": {\"en\": \"A golden retriever\", \"es\": \"Un golden retriever\", \"fr\": \"Un golden retriever\"}}\n101\t    }\n102\t])\n103\tdef test_basic_image_operations(test_case):\n104\t    \"\"\"Consolidated test for basic image operations\"\"\"\n105\t    predictor, lm = setup_predictor(test_case[\"signature\"], test_case[\"expected\"])\n106\t    \n107\t    # Convert string URLs to dspy.Image objects\n108\t    inputs = {k: dspy.Image.from_url(v) if isinstance(v, str) and k in [\"image\", \"ui_image\"] else v \n109\t             for k, v in test_case[\"inputs\"].items()}\n110\t    \n111\t    result = predictor(**inputs)\n112\t    \n113\t    # Check result based on output field name\n114\t    output_field = next(f for f in [\"probabilities\", \"generated_code\", \"bboxes\", \"captions\"] \n115\t                       if hasattr(result, f))\n116\t    assert getattr(result, output_field) == test_case[\"expected\"][test_case[\"key_output\"]]\n117\t    assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 1\n118\t\n119\t@pytest.mark.parametrize(\"image_input,description\", [\n120\t    (\"pil_image\", \"PIL Image\"),\n121\t    (\"encoded_pil_image\", \"encoded PIL image string\"), \n122\t    (\"dspy_image_download\", \"dspy.Image with download=True\"),\n123\t    (\"dspy_image_no_download\", \"dspy.Image without download\")\n124\t])\n125\tdef test_image_input_formats(request, sample_pil_image, sample_dspy_image_download, \n126\t                           sample_dspy_image_no_download, image_input, description):\n127\t    \"\"\"Test different input formats for image fields\"\"\"\n128\t    signature = \"image: dspy.Image, class_labels: List[str] -> probabilities: Dict[str, float]\"\n129\t    expected = {\"probabilities\": {\"dog\": 0.8, \"cat\": 0.1, \"bird\": 0.1}}\n130\t    predictor, lm = setup_predictor(signature, expected)\n131\t\n132\t    input_map = {\n133\t        \"pil_image\": sample_pil_image,\n134\t        \"encoded_pil_image\": encode_image(sample_pil_image),\n135\t        \"dspy_image_download\": sample_dspy_image_download,\n136\t        \"dspy_image_no_download\": sample_dspy_image_no_download\n137\t    }\n138\t    \n139\t    actual_input = input_map[image_input]\n140\t    # TODO(isaacbmiller): Support the cases without direct dspy.Image coercion\n141\t    if image_input in [\"pil_image\", \"encoded_pil_image\"]:\n142\t        pytest.xfail(f\"{description} not fully supported without dspy.from_PIL\")\n143\t\n144\t    result = predictor(image=actual_input, class_labels=[\"dog\", \"cat\", \"bird\"])\n145\t    assert result.probabilities == expected[\"probabilities\"]\n146\t    assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 1\n147\t\n148\tdef test_predictor_save_load(sample_url, sample_pil_image):\n149\t    \"\"\"Test saving and loading predictors with image fields\"\"\"\n150\t    signature = \"image: dspy.Image -> caption: str\"\n151\t    examples = [\n152\t        dspy.Example(image=dspy.Image.from_url(sample_url), caption=\"Example 1\"),\n153\t        dspy.Example(image=sample_pil_image, caption=\"Example 2\"),\n154\t    ]\n155\t    \n156\t    predictor, lm = setup_predictor(signature, {\"caption\": \"A golden retriever\"})\n157\t    optimizer = dspy.teleprompt.LabeledFewShot(k=1)\n158\t    compiled_predictor = optimizer.compile(student=predictor, trainset=examples, sample=False)\n159\t\n160\t    with tempfile.NamedTemporaryFile(mode='w+', delete=True, suffix=\".json\") as temp_file:\n161\t        compiled_predictor.save(temp_file.name)\n162\t        loaded_predictor = dspy.Predict(signature)\n163\t        loaded_predictor.load(temp_file.name)\n164\t    \n165\t    result = loaded_predictor(image=dspy.Image.from_url(\"https://example.com/dog.jpg\"))\n166\t    assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 2\n167\t    assert \"<DSPY_IMAGE_START>\" not in str(lm.history[-1][\"messages\"])\n168\t\n169\tdef test_save_load_complex_default_types():\n170\t    \"\"\"Test saving and loading predictors with complex default types (lists of images)\"\"\"\n171\t    examples = [\n172\t        dspy.Example(\n173\t            image_list=[\n174\t                dspy.Image.from_url(\"https://example.com/dog.jpg\"),\n175\t                dspy.Image.from_url(\"https://example.com/cat.jpg\")\n176\t            ],\n177\t            caption=\"Example 1\"\n178\t        ).with_inputs(\"image_list\"),\n179\t    ]\n180\t\n181\t    class ComplexTypeSignature(dspy.Signature):\n182\t        image_list: List[dspy.Image] = dspy.InputField(desc=\"A list of images\")\n183\t        caption: str = dspy.OutputField(desc=\"A caption for the image list\")\n184\t\n185\t    predictor, lm = setup_predictor(ComplexTypeSignature, {\"caption\": \"A list of images\"})\n186\t    optimizer = dspy.teleprompt.LabeledFewShot(k=1)\n187\t    compiled_predictor = optimizer.compile(student=predictor, trainset=examples, sample=False)\n188\t\n189\t    with tempfile.NamedTemporaryFile(mode='w+', delete=True, suffix=\".json\") as temp_file:\n190\t        compiled_predictor.save(temp_file.name)\n191\t        loaded_predictor = dspy.Predict(ComplexTypeSignature)\n192\t        loaded_predictor.load(temp_file.name)\n193\t    \n194\t    result = loaded_predictor(**examples[0].inputs())\n195\t    assert result.caption == \"A list of images\"\n196\t    assert str(lm.history[-1][\"messages\"]).count(\"'url'\") == 4\n197\t    assert \"<DSPY_IMAGE_START>\" not in str(lm.history[-1][\"messages\"])\n198\t\n199\tclass BasicImageSignature(dspy.Signature):\n200\t    \"\"\"Basic signature with a single image input\"\"\"\n201\t    image: dspy.Image = dspy.InputField()\n202\t    output: str = dspy.OutputField()\n203\t\n204\tclass ImageListSignature(dspy.Signature):\n205\t    \"\"\"Signature with a list of images input\"\"\"\n206\t    image_list: List[dspy.Image] = dspy.InputField()\n207\t    output: str = dspy.OutputField()\n208\t\n209\t@pytest.mark.parametrize(\"test_case\", [\n210\t    {\n211\t        \"name\": \"basic_dspy_signature\",\n212\t        \"signature_class\": BasicImageSignature,\n213\t        \"inputs\": {\n214\t            \"image\": \"https://example.com/dog.jpg\"\n215\t        },\n216\t        \"expected\": {\"output\": \"A dog photo\"},\n217\t        \"expected_image_urls\": 2\n218\t    },\n219\t    {\n220\t        \"name\": \"list_dspy_signature\",\n221\t        \"signature_class\": ImageListSignature,\n222\t        \"inputs\": {\n223\t            \"image_list\": [\"https://example.com/dog.jpg\", \"https://example.com/cat.jpg\"]\n224\t        },\n225\t        \"expected\": {\"output\": \"Multiple photos\"},\n226\t        \"expected_image_urls\": 4\n227\t    }\n228\t])\n229\tdef test_save_load_complex_types(test_case):\n230\t    \"\"\"Test saving and loading predictors with complex types\"\"\"\n231\t    signature_cls = test_case[\"signature_class\"]\n232\t    \n233\t    # Convert string URLs to dspy.Image objects in input\n234\t    processed_input = {}\n235\t    for key, value in test_case[\"inputs\"].items():\n236\t        if isinstance(value, str) and \"http\" in value:\n237\t            processed_input[key] = dspy.Image.from_url(value)\n238\t        elif isinstance(value, list) and value and isinstance(value[0], str):\n239\t            processed_input[key] = [dspy.Image.from_url(url) for url in value]\n240\t        else:\n241\t            processed_input[key] = value\n242\t    \n243\t    # Create example and predictor\n244\t    examples = [\n245\t        dspy.Example(**processed_input, **test_case[\"expected\"]).with_inputs(*processed_input.keys())\n246\t    ]\n247\t    \n248\t    predictor, lm = setup_predictor(signature_cls, test_case[\"expected\"])\n249\t    optimizer = dspy.teleprompt.LabeledFewShot(k=1)\n250\t    compiled_predictor = optimizer.compile(student=predictor, trainset=examples, sample=False)\n251\t    \n252\t    # Test save and load\n253\t    with tempfile.NamedTemporaryFile(mode='w+', delete=True, suffix=\".json\") as temp_file:\n254\t        compiled_predictor.save(temp_file.name)\n255\t        loaded_predictor = dspy.Predict(signature_cls)\n256\t        loaded_predictor.load(temp_file.name)\n257\t    \n258\t    # Run prediction\n259\t    result = loaded_predictor(**processed_input)\n260\t    \n261\t    # Verify output matches expected\n262\t    for key, value in test_case[\"expected\"].items():\n263\t        assert getattr(result, key) == value\n264\t    \n265\t    # Verify correct number of image URLs in messages\n266\t    assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == test_case[\"expected_image_urls\"]\n267\t    assert \"<DSPY_IMAGE_START>\" not in str(lm.history[-1][\"messages\"])\n268\t\n269\tdef test_save_load_pydantic_model():\n270\t    \"\"\"Test saving and loading predictors with pydantic models\"\"\"\n271\t    class ImageModel(pydantic.BaseModel):\n272\t        image: dspy.Image\n273\t        image_list: Optional[List[dspy.Image]] = None\n274\t        output: str\n275\t\n276\t    class PydanticSignature(dspy.Signature):\n277\t        model_input: ImageModel = dspy.InputField()\n278\t        output: str = dspy.OutputField()\n279\t\n280\t    # Create model instance\n281\t    model_input = ImageModel(\n282\t        image=dspy.Image.from_url(\"https://example.com/dog.jpg\"),\n283\t        image_list=[dspy.Image.from_url(\"https://example.com/cat.jpg\")],\n284\t        output=\"Multiple photos\"\n285\t    )\n286\t\n287\t    # Create example and predictor\n288\t    examples = [\n289\t        dspy.Example(model_input=model_input, output=\"Multiple photos\").with_inputs(\"model_input\")\n290\t    ]\n291\t\n292\t    predictor, lm = setup_predictor(PydanticSignature, {\"output\": \"Multiple photos\"})\n293\t    optimizer = dspy.teleprompt.LabeledFewShot(k=1)\n294\t    compiled_predictor = optimizer.compile(student=predictor, trainset=examples, sample=False)\n295\t\n296\t    # Test save and load\n297\t    with tempfile.NamedTemporaryFile(mode='w+', delete=True, suffix=\".json\") as temp_file:\n298\t        compiled_predictor.save(temp_file.name)\n299\t        loaded_predictor = dspy.Predict(PydanticSignature)\n300\t        loaded_predictor.load(temp_file.name)\n301\t\n302\t    # Run prediction\n303\t    result = loaded_predictor(model_input=model_input)\n304\t\n305\t    # Verify output matches expected\n306\t    assert result.output == \"Multiple photos\"\n307\t    assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 4\n308\t    assert \"<DSPY_IMAGE_START>\" not in str(lm.history[-1][\"messages\"])\n309\t\n310\tdef test_optional_image_field():\n311\t    \"\"\"Test that optional image fields are not required\"\"\"\n312\t    class OptionalImageSignature(dspy.Signature):\n313\t        image: Optional[dspy.Image] = dspy.InputField()\n314\t        output: str = dspy.OutputField()\n315\t\n316\t    predictor, lm = setup_predictor(OptionalImageSignature, {\"output\": \"Hello\"})\n317\t    result = predictor(image=None)\n318\t    assert result.output == \"Hello\"\n319\t    assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 0\n320\t\n321\tdef test_image_repr():\n322\t    \"\"\"Test string representation of Image objects\"\"\"\n323\t    url_image = dspy.Image.from_url(\"https://example.com/dog.jpg\", download=False)\n324\t    assert str(url_image) == \"<DSPY_IMAGE_START>https://example.com/dog.jpg<DSPY_IMAGE_END>\"\n325\t    assert repr(url_image) == \"Image(url='https://example.com/dog.jpg')\"\n326\t    \n327\t    sample_pil = PILImage.new('RGB', (60, 30), color='red')\n328\t    pil_image = dspy.Image.from_PIL(sample_pil)\n329\t    assert str(pil_image).startswith(\"<DSPY_IMAGE_START>data:image/png;base64,\")\n330\t    assert str(pil_image).endswith(\"<DSPY_IMAGE_END>\")\n331\t    assert \"base64\" in str(pil_image)"}]},"parent_tool_use_id":null,"session_id":"8a69ecad-8bc9-46d6-966d-44bd01212aec","uuid":"2984a81f-7494-4c01-9ec9-d9f7f579bf5a","timestamp":"2026-09-04T00:12:16.556Z","tool_use_result":{"type":"text","file":{"filePath":"/testbed/tests/signatures/test_adapter_image.py","content":"from typing import Dict, List, Optional, Tuple\n\nimport pytest\nfrom PIL import Image as PILImage\nimport requests\nfrom io import BytesIO\n\nimport dspy\nfrom dspy import Predict\nfrom dspy.utils.dummies import DummyLM\nfrom dspy.adapters.types.image import encode_image\nimport tempfile\nimport pydantic\n\n@pytest.fixture\ndef sample_pil_image():\n    \"\"\"Fixture to provide a sample image for testing\"\"\"\n    url = 'https://images.dog.ceo/breeds/dane-great/n02109047_8912.jpg'\n    response = requests.get(url)\n    response.raise_for_status()\n    return PILImage.open(BytesIO(response.content))\n\n@pytest.fixture\ndef sample_dspy_image_download():\n    return dspy.Image.from_url(\"https://images.dog.ceo/breeds/dane-great/n02109047_8912.jpg\", download=True)\n\n@pytest.fixture\ndef sample_url():\n    return \"https://images.dog.ceo/breeds/dane-great/n02109047_8912.jpg\"\n\n@pytest.fixture\ndef sample_dspy_image_no_download():\n    return dspy.Image.from_url(\"https://images.dog.ceo/breeds/dane-great/n02109047_8912.jpg\", download=False)\n\ndef count_messages_with_image_url_pattern(messages):\n    pattern = {\n        'type': 'image_url',\n        'image_url': {\n            'url': lambda x: isinstance(x, str)\n        }\n    }\n    \n    try:\n        def check_pattern(obj, pattern):\n            if isinstance(pattern, dict):\n                if not isinstance(obj, dict):\n                    return False\n                return all(k in obj and check_pattern(obj[k], v) for k, v in pattern.items())\n            if callable(pattern):\n                return pattern(obj)\n            return obj == pattern\n            \n        def count_patterns(obj, pattern):\n            count = 0\n            if check_pattern(obj, pattern):\n                count += 1\n            if isinstance(obj, dict):\n                count += sum(count_patterns(v, pattern) for v in obj.values())\n            if isinstance(obj, (list, tuple)):\n                count += sum(count_patterns(v, pattern) for v in obj)\n            return count\n            \n        return count_patterns(messages, pattern)\n    except Exception:\n        return 0\n\ndef setup_predictor(signature, expected_output):\n    \"\"\"Helper to set up a predictor with DummyLM\"\"\"\n    lm = DummyLM([expected_output])\n    dspy.settings.configure(lm=lm)\n    return dspy.Predict(signature), lm\n\n@pytest.mark.parametrize(\"test_case\", [\n    {\n        \"name\": \"probabilistic_classification\",\n        \"signature\": \"image: dspy.Image, class_labels: List[str] -> probabilities: Dict[str, float]\",\n        \"inputs\": {\"image\": \"https://example.com/dog.jpg\", \"class_labels\": [\"dog\", \"cat\", \"bird\"]},\n        \"key_output\": \"probabilities\",\n        \"expected\": {\"probabilities\": {\"dog\": 0.8, \"cat\": 0.1, \"bird\": 0.1}}\n    },\n    {\n        \"name\": \"image_to_code\",\n        \"signature\": \"ui_image: dspy.Image, target_language: str -> generated_code: str\",\n        \"inputs\": {\"ui_image\": \"https://example.com/button.png\", \"target_language\": \"HTML\"},\n        \"key_output\": \"generated_code\",\n        \"expected\": {\"generated_code\": \"<button>Click me</button>\"}\n    },\n    {\n        \"name\": \"bbox_detection\",\n        \"signature\": \"image: dspy.Image -> bboxes: List[Tuple[int, int, int, int]]\",\n        \"inputs\": {\"image\": \"https://example.com/image.jpg\"},\n        \"key_output\": \"bboxes\",\n        \"expected\": {\"bboxes\": [(10, 20, 30, 40), (50, 60, 70, 80)]}\n    },\n    {\n        \"name\": \"multilingual_caption\",\n        \"signature\": \"image: dspy.Image, languages: List[str] -> captions: Dict[str, str]\",\n        \"inputs\": {\"image\": \"https://example.com/dog.jpg\", \"languages\": [\"en\", \"es\", \"fr\"]},\n        \"key_output\": \"captions\",\n        \"expected\": {\"captions\": {\"en\": \"A golden retriever\", \"es\": \"Un golden retriever\", \"fr\": \"Un golden retriever\"}}\n    }\n])\ndef test_basic_image_operations(test_case):\n    \"\"\"Consolidated test for basic image operations\"\"\"\n    predictor, lm = setup_predictor(test_case[\"signature\"], test_case[\"expected\"])\n    \n    # Convert string URLs to dspy.Image objects\n    inputs = {k: dspy.Image.from_url(v) if isinstance(v, str) and k in [\"image\", \"ui_image\"] else v \n             for k, v in test_case[\"inputs\"].items()}\n    \n    result = predictor(**inputs)\n    \n    # Check result based on output field name\n    output_field = next(f for f in [\"probabilities\", \"generated_code\", \"bboxes\", \"captions\"] \n                       if hasattr(result, f))\n    assert getattr(result, output_field) == test_case[\"expected\"][test_case[\"key_output\"]]\n    assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 1\n\n@pytest.mark.parametrize(\"image_input,description\", [\n    (\"pil_image\", \"PIL Image\"),\n    (\"encoded_pil_image\", \"encoded PIL image string\"), \n    (\"dspy_image_download\", \"dspy.Image with download=True\"),\n    (\"dspy_image_no_download\", \"dspy.Image without download\")\n])\ndef test_image_input_formats(request, sample_pil_image, sample_dspy_image_download, \n                           sample_dspy_image_no_download, image_input, description):\n    \"\"\"Test different input formats for image fields\"\"\"\n    signature = \"image: dspy.Image, class_labels: List[str] -> probabilities: Dict[str, float]\"\n    expected = {\"probabilities\": {\"dog\": 0.8, \"cat\": 0.1, \"bird\": 0.1}}\n    predictor, lm = setup_predictor(signature, expected)\n\n    input_map = {\n        \"pil_image\": sample_pil_image,\n        \"encoded_pil_image\": encode_image(sample_pil_image),\n        \"dspy_image_download\": sample_dspy_image_download,\n        \"dspy_image_no_download\": sample_dspy_image_no_download\n    }\n    \n    actual_input = input_map[image_input]\n    # TODO(isaacbmiller): Support the cases without direct dspy.Image coercion\n    if image_input in [\"pil_image\", \"encoded_pil_image\"]:\n        pytest.xfail(f\"{description} not fully supported without dspy.from_PIL\")\n\n    result = predictor(image=actual_input, class_labels=[\"dog\", \"cat\", \"bird\"])\n    assert result.probabilities == expected[\"probabilities\"]\n    assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 1\n\ndef test_predictor_save_load(sample_url, sample_pil_image):\n    \"\"\"Test saving and loading predictors with image fields\"\"\"\n    signature = \"image: dspy.Image -> caption: str\"\n    examples = [\n        dspy.Example(image=dspy.Image.from_url(sample_url), caption=\"Example 1\"),\n        dspy.Example(image=sample_pil_image, caption=\"Example 2\"),\n    ]\n    \n    predictor, lm = setup_predictor(signature, {\"caption\": \"A golden retriever\"})\n    optimizer = dspy.teleprompt.LabeledFewShot(k=1)\n    compiled_predictor = optimizer.compile(student=predictor, trainset=examples, sample=False)\n\n    with tempfile.NamedTemporaryFile(mode='w+', delete=True, suffix=\".json\") as temp_file:\n        compiled_predictor.save(temp_file.name)\n        loaded_predictor = dspy.Predict(signature)\n        loaded_predictor.load(temp_file.name)\n    \n    result = loaded_predictor(image=dspy.Image.from_url(\"https://example.com/dog.jpg\"))\n    assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 2\n    assert \"<DSPY_IMAGE_START>\" not in str(lm.history[-1][\"messages\"])\n\ndef test_save_load_complex_default_types():\n    \"\"\"Test saving and loading predictors with complex default types (lists of images)\"\"\"\n    examples = [\n        dspy.Example(\n            image_list=[\n                dspy.Image.from_url(\"https://example.com/dog.jpg\"),\n                dspy.Image.from_url(\"https://example.com/cat.jpg\")\n            ],\n            caption=\"Example 1\"\n        ).with_inputs(\"image_list\"),\n    ]\n\n    class ComplexTypeSignature(dspy.Signature):\n        image_list: List[dspy.Image] = dspy.InputField(desc=\"A list of images\")\n        caption: str = dspy.OutputField(desc=\"A caption for the image list\")\n\n    predictor, lm = setup_predictor(ComplexTypeSignature, {\"caption\": \"A list of images\"})\n    optimizer = dspy.teleprompt.LabeledFewShot(k=1)\n    compiled_predictor = optimizer.compile(student=predictor, trainset=examples, sample=False)\n\n    with tempfile.NamedTemporaryFile(mode='w+', delete=True, suffix=\".json\") as temp_file:\n        compiled_predictor.save(temp_file.name)\n        loaded_predictor = dspy.Predict(ComplexTypeSignature)\n        loaded_predictor.load(temp_file.name)\n    \n    result = loaded_predictor(**examples[0].inputs())\n    assert result.caption == \"A list of images\"\n    assert str(lm.history[-1][\"messages\"]).count(\"'url'\") == 4\n    assert \"<DSPY_IMAGE_START>\" not in str(lm.history[-1][\"messages\"])\n\nclass BasicImageSignature(dspy.Signature):\n    \"\"\"Basic signature with a single image input\"\"\"\n    image: dspy.Image = dspy.InputField()\n    output: str = dspy.OutputField()\n\nclass ImageListSignature(dspy.Signature):\n    \"\"\"Signature with a list of images input\"\"\"\n    image_list: List[dspy.Image] = dspy.InputField()\n    output: str = dspy.OutputField()\n\n@pytest.mark.parametrize(\"test_case\", [\n    {\n        \"name\": \"basic_dspy_signature\",\n        \"signature_class\": BasicImageSignature,\n        \"inputs\": {\n            \"image\": \"https://example.com/dog.jpg\"\n        },\n        \"expected\": {\"output\": \"A dog photo\"},\n        \"expected_image_urls\": 2\n    },\n    {\n        \"name\": \"list_dspy_signature\",\n        \"signature_class\": ImageListSignature,\n        \"inputs\": {\n            \"image_list\": [\"https://example.com/dog.jpg\", \"https://example.com/cat.jpg\"]\n        },\n        \"expected\": {\"output\": \"Multiple photos\"},\n        \"expected_image_urls\": 4\n    }\n])\ndef test_save_load_complex_types(test_case):\n    \"\"\"Test saving and loading predictors with complex types\"\"\"\n    signature_cls = test_case[\"signature_class\"]\n    \n    # Convert string URLs to dspy.Image objects in input\n    processed_input = {}\n    for key, value in test_case[\"inputs\"].items():\n        if isinstance(value, str) and \"http\" in value:\n            processed_input[key] = dspy.Image.from_url(value)\n        elif isinstance(value, list) and value and isinstance(value[0], str):\n            processed_input[key] = [dspy.Image.from_url(url) for url in value]\n        else:\n            processed_input[key] = value\n    \n    # Create example and predictor\n    examples = [\n        dspy.Example(**processed_input, **test_case[\"expected\"]).with_inputs(*processed_input.keys())\n    ]\n    \n    predictor, lm = setup_predictor(signature_cls, test_case[\"expected\"])\n    optimizer = dspy.teleprompt.LabeledFewShot(k=1)\n    compiled_predictor = optimizer.compile(student=predictor, trainset=examples, sample=False)\n    \n    # Test save and load\n    with tempfile.NamedTemporaryFile(mode='w+', delete=True, suffix=\".json\") as temp_file:\n        compiled_predictor.save(temp_file.name)\n        loaded_predictor = dspy.Predict(signature_cls)\n        loaded_predictor.load(temp_file.name)\n    \n    # Run prediction\n    result = loaded_predictor(**processed_input)\n    \n    # Verify output matches expected\n    for key, value in test_case[\"expected\"].items():\n        assert getattr(result, key) == value\n    \n    # Verify correct number of image URLs in messages\n    assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == test_case[\"expected_image_urls\"]\n    assert \"<DSPY_IMAGE_START>\" not in str(lm.history[-1][\"messages\"])\n\ndef test_save_load_pydantic_model():\n    \"\"\"Test saving and loading predictors with pydantic models\"\"\"\n    class ImageModel(pydantic.BaseModel):\n        image: dspy.Image\n        image_list: Optional[List[dspy.Image]] = None\n        output: str\n\n    class PydanticSignature(dspy.Signature):\n        model_input: ImageModel = dspy.InputField()\n        output: str = dspy.OutputField()\n\n    # Create model instance\n    model_input = ImageModel(\n        image=dspy.Image.from_url(\"https://example.com/dog.jpg\"),\n        image_list=[dspy.Image.from_url(\"https://example.com/cat.jpg\")],\n        output=\"Multiple photos\"\n    )\n\n    # Create example and predictor\n    examples = [\n        dspy.Example(model_input=model_input, output=\"Multiple photos\").with_inputs(\"model_input\")\n    ]\n\n    predictor, lm = setup_predictor(PydanticSignature, {\"output\": \"Multiple photos\"})\n    optimizer = dspy.teleprompt.LabeledFewShot(k=1)\n    compiled_predictor = optimizer.compile(student=predictor, trainset=examples, sample=False)\n\n    # Test save and load\n    with tempfile.NamedTemporaryFile(mode='w+', delete=True, suffix=\".json\") as temp_file:\n        compiled_predictor.save(temp_file.name)\n        loaded_predictor = dspy.Predict(PydanticSignature)\n        loaded_predictor.load(temp_file.name)\n\n    # Run prediction\n    result = loaded_predictor(model_input=model_input)\n\n    # Verify output matches expected\n    assert result.output == \"Multiple photos\"\n    assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 4\n    assert \"<DSPY_IMAGE_START>\" not in str(lm.history[-1][\"messages\"])\n\ndef test_optional_image_field():\n    \"\"\"Test that optional image fields are not required\"\"\"\n    class OptionalImageSignature(dspy.Signature):\n        image: Optional[dspy.Image] = dspy.InputField()\n        output: str = dspy.OutputField()\n\n    predictor, lm = setup_predictor(OptionalImageSignature, {\"output\": \"Hello\"})\n    result = predictor(image=None)\n    assert result.output == \"Hello\"\n    assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 0\n\ndef test_image_repr():\n    \"\"\"Test string representation of Image objects\"\"\"\n    url_image = dspy.Image.from_url(\"https://example.com/dog.jpg\", download=False)\n    assert str(url_image) == \"<DSPY_IMAGE_START>https://example.com/dog.jpg<DSPY_IMAGE_END>\"\n    assert repr(url_image) == \"Image(url='https://example.com/dog.jpg')\"\n    \n    sample_pil = PILImage.new('RGB', (60, 30), color='red')\n    pil_image = dspy.Image.from_PIL(sample_pil)\n    assert str(pil_image).startswith(\"<DSPY_IMAGE_START>data:image/png;base64,\")\n    assert str(pil_image).endswith(\"<DSPY_IMAGE_END>\")\n    assert \"base64\" in str(pil_image)","numLines":331,"startLine":1,"totalLines":331}}}
