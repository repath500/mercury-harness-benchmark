{"type":"tool_use","timestamp":1788479972879,"sessionID":"ses_f96499560ffeg5ToJAP0YiOCHb","part":{"type":"tool","tool":"read","callID":"call_1daa0de5420544208ced8153","state":{"status":"completed","input":{"filePath":"/testbed/tests/signatures/test_adapter_image.py"},"output":"<path>/testbed/tests/signatures/test_adapter_image.py</path>\n<type>file</type>\n<content>\n1: from typing import Dict, List, Optional, Tuple\n2: \n3: import pytest\n4: from PIL import Image as PILImage\n5: import requests\n6: from io import BytesIO\n7: \n8: import dspy\n9: from dspy import Predict\n10: from dspy.utils.dummies import DummyLM\n11: from dspy.adapters.types.image import encode_image\n12: import tempfile\n13: import pydantic\n14: \n15: @pytest.fixture\n16: def sample_pil_image():\n17:     \"\"\"Fixture to provide a sample image for testing\"\"\"\n18:     url = 'https://images.dog.ceo/breeds/dane-great/n02109047_8912.jpg'\n19:     response = requests.get(url)\n20:     response.raise_for_status()\n21:     return PILImage.open(BytesIO(response.content))\n22: \n23: @pytest.fixture\n24: def sample_dspy_image_download():\n25:     return dspy.Image.from_url(\"https://images.dog.ceo/breeds/dane-great/n02109047_8912.jpg\", download=True)\n26: \n27: @pytest.fixture\n28: def sample_url():\n29:     return \"https://images.dog.ceo/breeds/dane-great/n02109047_8912.jpg\"\n30: \n31: @pytest.fixture\n32: def sample_dspy_image_no_download():\n33:     return dspy.Image.from_url(\"https://images.dog.ceo/breeds/dane-great/n02109047_8912.jpg\", download=False)\n34: \n35: def count_messages_with_image_url_pattern(messages):\n36:     pattern = {\n37:         'type': 'image_url',\n38:         'image_url': {\n39:             'url': lambda x: isinstance(x, str)\n40:         }\n41:     }\n42:     \n43:     try:\n44:         def check_pattern(obj, pattern):\n45:             if isinstance(pattern, dict):\n46:                 if not isinstance(obj, dict):\n47:                     return False\n48:                 return all(k in obj and check_pattern(obj[k], v) for k, v in pattern.items())\n49:             if callable(pattern):\n50:                 return pattern(obj)\n51:             return obj == pattern\n52:             \n53:         def count_patterns(obj, pattern):\n54:             count = 0\n55:             if check_pattern(obj, pattern):\n56:                 count += 1\n57:             if isinstance(obj, dict):\n58:                 count += sum(count_patterns(v, pattern) for v in obj.values())\n59:             if isinstance(obj, (list, tuple)):\n60:                 count += sum(count_patterns(v, pattern) for v in obj)\n61:             return count\n62:             \n63:         return count_patterns(messages, pattern)\n64:     except Exception:\n65:         return 0\n66: \n67: def setup_predictor(signature, expected_output):\n68:     \"\"\"Helper to set up a predictor with DummyLM\"\"\"\n69:     lm = DummyLM([expected_output])\n70:     dspy.settings.configure(lm=lm)\n71:     return dspy.Predict(signature), lm\n72: \n73: @pytest.mark.parametrize(\"test_case\", [\n74:     {\n75:         \"name\": \"probabilistic_classification\",\n76:         \"signature\": \"image: dspy.Image, class_labels: List[str] -> probabilities: Dict[str, float]\",\n77:         \"inputs\": {\"image\": \"https://example.com/dog.jpg\", \"class_labels\": [\"dog\", \"cat\", \"bird\"]},\n78:         \"key_output\": \"probabilities\",\n79:         \"expected\": {\"probabilities\": {\"dog\": 0.8, \"cat\": 0.1, \"bird\": 0.1}}\n80:     },\n81:     {\n82:         \"name\": \"image_to_code\",\n83:         \"signature\": \"ui_image: dspy.Image, target_language: str -> generated_code: str\",\n84:         \"inputs\": {\"ui_image\": \"https://example.com/button.png\", \"target_language\": \"HTML\"},\n85:         \"key_output\": \"generated_code\",\n86:         \"expected\": {\"generated_code\": \"<button>Click me</button>\"}\n87:     },\n88:     {\n89:         \"name\": \"bbox_detection\",\n90:         \"signature\": \"image: dspy.Image -> bboxes: List[Tuple[int, int, int, int]]\",\n91:         \"inputs\": {\"image\": \"https://example.com/image.jpg\"},\n92:         \"key_output\": \"bboxes\",\n93:         \"expected\": {\"bboxes\": [(10, 20, 30, 40), (50, 60, 70, 80)]}\n94:     },\n95:     {\n96:         \"name\": \"multilingual_caption\",\n97:         \"signature\": \"image: dspy.Image, languages: List[str] -> captions: Dict[str, str]\",\n98:         \"inputs\": {\"image\": \"https://example.com/dog.jpg\", \"languages\": [\"en\", \"es\", \"fr\"]},\n99:         \"key_output\": \"captions\",\n100:         \"expected\": {\"captions\": {\"en\": \"A golden retriever\", \"es\": \"Un golden retriever\", \"fr\": \"Un golden retriever\"}}\n101:     }\n102: ])\n103: def test_basic_image_operations(test_case):\n104:     \"\"\"Consolidated test for basic image operations\"\"\"\n105:     predictor, lm = setup_predictor(test_case[\"signature\"], test_case[\"expected\"])\n106:     \n107:     # Convert string URLs to dspy.Image objects\n108:     inputs = {k: dspy.Image.from_url(v) if isinstance(v, str) and k in [\"image\", \"ui_image\"] else v \n109:              for k, v in test_case[\"inputs\"].items()}\n110:     \n111:     result = predictor(**inputs)\n112:     \n113:     # Check result based on output field name\n114:     output_field = next(f for f in [\"probabilities\", \"generated_code\", \"bboxes\", \"captions\"] \n115:                        if hasattr(result, f))\n116:     assert getattr(result, output_field) == test_case[\"expected\"][test_case[\"key_output\"]]\n117:     assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 1\n118: \n119: @pytest.mark.parametrize(\"image_input,description\", [\n120:     (\"pil_image\", \"PIL Image\"),\n121:     (\"encoded_pil_image\", \"encoded PIL image string\"), \n122:     (\"dspy_image_download\", \"dspy.Image with download=True\"),\n123:     (\"dspy_image_no_download\", \"dspy.Image without download\")\n124: ])\n125: def test_image_input_formats(request, sample_pil_image, sample_dspy_image_download, \n126:                            sample_dspy_image_no_download, image_input, description):\n127:     \"\"\"Test different input formats for image fields\"\"\"\n128:     signature = \"image: dspy.Image, class_labels: List[str] -> probabilities: Dict[str, float]\"\n129:     expected = {\"probabilities\": {\"dog\": 0.8, \"cat\": 0.1, \"bird\": 0.1}}\n130:     predictor, lm = setup_predictor(signature, expected)\n131: \n132:     input_map = {\n133:         \"pil_image\": sample_pil_image,\n134:         \"encoded_pil_image\": encode_image(sample_pil_image),\n135:         \"dspy_image_download\": sample_dspy_image_download,\n136:         \"dspy_image_no_download\": sample_dspy_image_no_download\n137:     }\n138:     \n139:     actual_input = input_map[image_input]\n140:     # TODO(isaacbmiller): Support the cases without direct dspy.Image coercion\n141:     if image_input in [\"pil_image\", \"encoded_pil_image\"]:\n142:         pytest.xfail(f\"{description} not fully supported without dspy.from_PIL\")\n143: \n144:     result = predictor(image=actual_input, class_labels=[\"dog\", \"cat\", \"bird\"])\n145:     assert result.probabilities == expected[\"probabilities\"]\n146:     assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 1\n147: \n148: def test_predictor_save_load(sample_url, sample_pil_image):\n149:     \"\"\"Test saving and loading predictors with image fields\"\"\"\n150:     signature = \"image: dspy.Image -> caption: str\"\n151:     examples = [\n152:         dspy.Example(image=dspy.Image.from_url(sample_url), caption=\"Example 1\"),\n153:         dspy.Example(image=sample_pil_image, caption=\"Example 2\"),\n154:     ]\n155:     \n156:     predictor, lm = setup_predictor(signature, {\"caption\": \"A golden retriever\"})\n157:     optimizer = dspy.teleprompt.LabeledFewShot(k=1)\n158:     compiled_predictor = optimizer.compile(student=predictor, trainset=examples, sample=False)\n159: \n160:     with tempfile.NamedTemporaryFile(mode='w+', delete=True, suffix=\".json\") as temp_file:\n161:         compiled_predictor.save(temp_file.name)\n162:         loaded_predictor = dspy.Predict(signature)\n163:         loaded_predictor.load(temp_file.name)\n164:     \n165:     result = loaded_predictor(image=dspy.Image.from_url(\"https://example.com/dog.jpg\"))\n166:     assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 2\n167:     assert \"<DSPY_IMAGE_START>\" not in str(lm.history[-1][\"messages\"])\n168: \n169: def test_save_load_complex_default_types():\n170:     \"\"\"Test saving and loading predictors with complex default types (lists of images)\"\"\"\n171:     examples = [\n172:         dspy.Example(\n173:             image_list=[\n174:                 dspy.Image.from_url(\"https://example.com/dog.jpg\"),\n175:                 dspy.Image.from_url(\"https://example.com/cat.jpg\")\n176:             ],\n177:             caption=\"Example 1\"\n178:         ).with_inputs(\"image_list\"),\n179:     ]\n180: \n181:     class ComplexTypeSignature(dspy.Signature):\n182:         image_list: List[dspy.Image] = dspy.InputField(desc=\"A list of images\")\n183:         caption: str = dspy.OutputField(desc=\"A caption for the image list\")\n184: \n185:     predictor, lm = setup_predictor(ComplexTypeSignature, {\"caption\": \"A list of images\"})\n186:     optimizer = dspy.teleprompt.LabeledFewShot(k=1)\n187:     compiled_predictor = optimizer.compile(student=predictor, trainset=examples, sample=False)\n188: \n189:     with tempfile.NamedTemporaryFile(mode='w+', delete=True, suffix=\".json\") as temp_file:\n190:         compiled_predictor.save(temp_file.name)\n191:         loaded_predictor = dspy.Predict(ComplexTypeSignature)\n192:         loaded_predictor.load(temp_file.name)\n193:     \n194:     result = loaded_predictor(**examples[0].inputs())\n195:     assert result.caption == \"A list of images\"\n196:     assert str(lm.history[-1][\"messages\"]).count(\"'url'\") == 4\n197:     assert \"<DSPY_IMAGE_START>\" not in str(lm.history[-1][\"messages\"])\n198: \n199: class BasicImageSignature(dspy.Signature):\n200:     \"\"\"Basic signature with a single image input\"\"\"\n201:     image: dspy.Image = dspy.InputField()\n202:     output: str = dspy.OutputField()\n203: \n204: class ImageListSignature(dspy.Signature):\n205:     \"\"\"Signature with a list of images input\"\"\"\n206:     image_list: List[dspy.Image] = dspy.InputField()\n207:     output: str = dspy.OutputField()\n208: \n209: @pytest.mark.parametrize(\"test_case\", [\n210:     {\n211:         \"name\": \"basic_dspy_signature\",\n212:         \"signature_class\": BasicImageSignature,\n213:         \"inputs\": {\n214:             \"image\": \"https://example.com/dog.jpg\"\n215:         },\n216:         \"expected\": {\"output\": \"A dog photo\"},\n217:         \"expected_image_urls\": 2\n218:     },\n219:     {\n220:         \"name\": \"list_dspy_signature\",\n221:         \"signature_class\": ImageListSignature,\n222:         \"inputs\": {\n223:             \"image_list\": [\"https://example.com/dog.jpg\", \"https://example.com/cat.jpg\"]\n224:         },\n225:         \"expected\": {\"output\": \"Multiple photos\"},\n226:         \"expected_image_urls\": 4\n227:     }\n228: ])\n229: def test_save_load_complex_types(test_case):\n230:     \"\"\"Test saving and loading predictors with complex types\"\"\"\n231:     signature_cls = test_case[\"signature_class\"]\n232:     \n233:     # Convert string URLs to dspy.Image objects in input\n234:     processed_input = {}\n235:     for key, value in test_case[\"inputs\"].items():\n236:         if isinstance(value, str) and \"http\" in value:\n237:             processed_input[key] = dspy.Image.from_url(value)\n238:         elif isinstance(value, list) and value and isinstance(value[0], str):\n239:             processed_input[key] = [dspy.Image.from_url(url) for url in value]\n240:         else:\n241:             processed_input[key] = value\n242:     \n243:     # Create example and predictor\n244:     examples = [\n245:         dspy.Example(**processed_input, **test_case[\"expected\"]).with_inputs(*processed_input.keys())\n246:     ]\n247:     \n248:     predictor, lm = setup_predictor(signature_cls, test_case[\"expected\"])\n249:     optimizer = dspy.teleprompt.LabeledFewShot(k=1)\n250:     compiled_predictor = optimizer.compile(student=predictor, trainset=examples, sample=False)\n251:     \n252:     # Test save and load\n253:     with tempfile.NamedTemporaryFile(mode='w+', delete=True, suffix=\".json\") as temp_file:\n254:         compiled_predictor.save(temp_file.name)\n255:         loaded_predictor = dspy.Predict(signature_cls)\n256:         loaded_predictor.load(temp_file.name)\n257:     \n258:     # Run prediction\n259:     result = loaded_predictor(**processed_input)\n260:     \n261:     # Verify output matches expected\n262:     for key, value in test_case[\"expected\"].items():\n263:         assert getattr(result, key) == value\n264:     \n265:     # Verify correct number of image URLs in messages\n266:     assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == test_case[\"expected_image_urls\"]\n267:     assert \"<DSPY_IMAGE_START>\" not in str(lm.history[-1][\"messages\"])\n268: \n269: def test_save_load_pydantic_model():\n270:     \"\"\"Test saving and loading predictors with pydantic models\"\"\"\n271:     class ImageModel(pydantic.BaseModel):\n272:         image: dspy.Image\n273:         image_list: Optional[List[dspy.Image]] = None\n274:         output: str\n275: \n276:     class PydanticSignature(dspy.Signature):\n277:         model_input: ImageModel = dspy.InputField()\n278:         output: str = dspy.OutputField()\n279: \n280:     # Create model instance\n281:     model_input = ImageModel(\n282:         image=dspy.Image.from_url(\"https://example.com/dog.jpg\"),\n283:         image_list=[dspy.Image.from_url(\"https://example.com/cat.jpg\")],\n284:         output=\"Multiple photos\"\n285:     )\n286: \n287:     # Create example and predictor\n288:     examples = [\n289:         dspy.Example(model_input=model_input, output=\"Multiple photos\").with_inputs(\"model_input\")\n290:     ]\n291: \n292:     predictor, lm = setup_predictor(PydanticSignature, {\"output\": \"Multiple photos\"})\n293:     optimizer = dspy.teleprompt.LabeledFewShot(k=1)\n294:     compiled_predictor = optimizer.compile(student=predictor, trainset=examples, sample=False)\n295: \n296:     # Test save and load\n297:     with tempfile.NamedTemporaryFile(mode='w+', delete=True, suffix=\".json\") as temp_file:\n298:         compiled_predictor.save(temp_file.name)\n299:         loaded_predictor = dspy.Predict(PydanticSignature)\n300:         loaded_predictor.load(temp_file.name)\n301: \n302:     # Run prediction\n303:     result = loaded_predictor(model_input=model_input)\n304: \n305:     # Verify output matches expected\n306:     assert result.output == \"Multiple photos\"\n307:     assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 4\n308:     assert \"<DSPY_IMAGE_START>\" not in str(lm.history[-1][\"messages\"])\n309: \n310: def test_optional_image_field():\n311:     \"\"\"Test that optional image fields are not required\"\"\"\n312:     class OptionalImageSignature(dspy.Signature):\n313:         image: Optional[dspy.Image] = dspy.InputField()\n314:         output: str = dspy.OutputField()\n315: \n316:     predictor, lm = setup_predictor(OptionalImageSignature, {\"output\": \"Hello\"})\n317:     result = predictor(image=None)\n318:     assert result.output == \"Hello\"\n319:     assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 0\n320: \n321: def test_image_repr():\n322:     \"\"\"Test string representation of Image objects\"\"\"\n323:     url_image = dspy.Image.from_url(\"https://example.com/dog.jpg\", download=False)\n324:     assert str(url_image) == \"<DSPY_IMAGE_START>https://example.com/dog.jpg<DSPY_IMAGE_END>\"\n325:     assert repr(url_image) == \"Image(url='https://example.com/dog.jpg')\"\n326:     \n327:     sample_pil = PILImage.new('RGB', (60, 30), color='red')\n328:     pil_image = dspy.Image.from_PIL(sample_pil)\n329:     assert str(pil_image).startswith(\"<DSPY_IMAGE_START>data:image/png;base64,\")\n330:     assert str(pil_image).endswith(\"<DSPY_IMAGE_END>\")\n331:     assert \"base64\" in str(pil_image)\n\n(End of file - total 331 lines)\n</content>","metadata":{"preview":"from typing import Dict, List, Optional, Tuple\n\nimport pytest\nfrom PIL import Image as PILImage\nimport requests\nfrom io import BytesIO\n\nimport dspy\nfrom dspy import Predict\nfrom dspy.utils.dummies import DummyLM\nfrom dspy.adapters.types.image import encode_image\nimport tempfile\nimport pydantic\n\n@pytest.fixture\ndef sample_pil_image():\n    \"\"\"Fixture to provide a sample image for testing\"\"\"\n    url = 'https://images.dog.ceo/breeds/dane-great/n02109047_8912.jpg'\n    response = requests.get(url)\n    response.raise_for_status()","truncated":false,"loaded":[],"display":{"type":"file","path":"/testbed/tests/signatures/test_adapter_image.py","text":"from typing import Dict, List, Optional, Tuple\n\nimport pytest\nfrom PIL import Image as PILImage\nimport requests\nfrom io import BytesIO\n\nimport dspy\nfrom dspy import Predict\nfrom dspy.utils.dummies import DummyLM\nfrom dspy.adapters.types.image import encode_image\nimport tempfile\nimport pydantic\n\n@pytest.fixture\ndef sample_pil_image():\n    \"\"\"Fixture to provide a sample image for testing\"\"\"\n    url = 'https://images.dog.ceo/breeds/dane-great/n02109047_8912.jpg'\n    response = requests.get(url)\n    response.raise_for_status()\n    return PILImage.open(BytesIO(response.content))\n\n@pytest.fixture\ndef sample_dspy_image_download():\n    return dspy.Image.from_url(\"https://images.dog.ceo/breeds/dane-great/n02109047_8912.jpg\", download=True)\n\n@pytest.fixture\ndef sample_url():\n    return \"https://images.dog.ceo/breeds/dane-great/n02109047_8912.jpg\"\n\n@pytest.fixture\ndef sample_dspy_image_no_download():\n    return dspy.Image.from_url(\"https://images.dog.ceo/breeds/dane-great/n02109047_8912.jpg\", download=False)\n\ndef count_messages_with_image_url_pattern(messages):\n    pattern = {\n        'type': 'image_url',\n        'image_url': {\n            'url': lambda x: isinstance(x, str)\n        }\n    }\n    \n    try:\n        def check_pattern(obj, pattern):\n            if isinstance(pattern, dict):\n                if not isinstance(obj, dict):\n                    return False\n                return all(k in obj and check_pattern(obj[k], v) for k, v in pattern.items())\n            if callable(pattern):\n                return pattern(obj)\n            return obj == pattern\n            \n        def count_patterns(obj, pattern):\n            count = 0\n            if check_pattern(obj, pattern):\n                count += 1\n            if isinstance(obj, dict):\n                count += sum(count_patterns(v, pattern) for v in obj.values())\n            if isinstance(obj, (list, tuple)):\n                count += sum(count_patterns(v, pattern) for v in obj)\n            return count\n            \n        return count_patterns(messages, pattern)\n    except Exception:\n        return 0\n\ndef setup_predictor(signature, expected_output):\n    \"\"\"Helper to set up a predictor with DummyLM\"\"\"\n    lm = DummyLM([expected_output])\n    dspy.settings.configure(lm=lm)\n    return dspy.Predict(signature), lm\n\n@pytest.mark.parametrize(\"test_case\", [\n    {\n        \"name\": \"probabilistic_classification\",\n        \"signature\": \"image: dspy.Image, class_labels: List[str] -> probabilities: Dict[str, float]\",\n        \"inputs\": {\"image\": \"https://example.com/dog.jpg\", \"class_labels\": [\"dog\", \"cat\", \"bird\"]},\n        \"key_output\": \"probabilities\",\n        \"expected\": {\"probabilities\": {\"dog\": 0.8, \"cat\": 0.1, \"bird\": 0.1}}\n    },\n    {\n        \"name\": \"image_to_code\",\n        \"signature\": \"ui_image: dspy.Image, target_language: str -> generated_code: str\",\n        \"inputs\": {\"ui_image\": \"https://example.com/button.png\", \"target_language\": \"HTML\"},\n        \"key_output\": \"generated_code\",\n        \"expected\": {\"generated_code\": \"<button>Click me</button>\"}\n    },\n    {\n        \"name\": \"bbox_detection\",\n        \"signature\": \"image: dspy.Image -> bboxes: List[Tuple[int, int, int, int]]\",\n        \"inputs\": {\"image\": \"https://example.com/image.jpg\"},\n        \"key_output\": \"bboxes\",\n        \"expected\": {\"bboxes\": [(10, 20, 30, 40), (50, 60, 70, 80)]}\n    },\n    {\n        \"name\": \"multilingual_caption\",\n        \"signature\": \"image: dspy.Image, languages: List[str] -> captions: Dict[str, str]\",\n        \"inputs\": {\"image\": \"https://example.com/dog.jpg\", \"languages\": [\"en\", \"es\", \"fr\"]},\n        \"key_output\": \"captions\",\n        \"expected\": {\"captions\": {\"en\": \"A golden retriever\", \"es\": \"Un golden retriever\", \"fr\": \"Un golden retriever\"}}\n    }\n])\ndef test_basic_image_operations(test_case):\n    \"\"\"Consolidated test for basic image operations\"\"\"\n    predictor, lm = setup_predictor(test_case[\"signature\"], test_case[\"expected\"])\n    \n    # Convert string URLs to dspy.Image objects\n    inputs = {k: dspy.Image.from_url(v) if isinstance(v, str) and k in [\"image\", \"ui_image\"] else v \n             for k, v in test_case[\"inputs\"].items()}\n    \n    result = predictor(**inputs)\n    \n    # Check result based on output field name\n    output_field = next(f for f in [\"probabilities\", \"generated_code\", \"bboxes\", \"captions\"] \n                       if hasattr(result, f))\n    assert getattr(result, output_field) == test_case[\"expected\"][test_case[\"key_output\"]]\n    assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 1\n\n@pytest.mark.parametrize(\"image_input,description\", [\n    (\"pil_image\", \"PIL Image\"),\n    (\"encoded_pil_image\", \"encoded PIL image string\"), \n    (\"dspy_image_download\", \"dspy.Image with download=True\"),\n    (\"dspy_image_no_download\", \"dspy.Image without download\")\n])\ndef test_image_input_formats(request, sample_pil_image, sample_dspy_image_download, \n                           sample_dspy_image_no_download, image_input, description):\n    \"\"\"Test different input formats for image fields\"\"\"\n    signature = \"image: dspy.Image, class_labels: List[str] -> probabilities: Dict[str, float]\"\n    expected = {\"probabilities\": {\"dog\": 0.8, \"cat\": 0.1, \"bird\": 0.1}}\n    predictor, lm = setup_predictor(signature, expected)\n\n    input_map = {\n        \"pil_image\": sample_pil_image,\n        \"encoded_pil_image\": encode_image(sample_pil_image),\n        \"dspy_image_download\": sample_dspy_image_download,\n        \"dspy_image_no_download\": sample_dspy_image_no_download\n    }\n    \n    actual_input = input_map[image_input]\n    # TODO(isaacbmiller): Support the cases without direct dspy.Image coercion\n    if image_input in [\"pil_image\", \"encoded_pil_image\"]:\n        pytest.xfail(f\"{description} not fully supported without dspy.from_PIL\")\n\n    result = predictor(image=actual_input, class_labels=[\"dog\", \"cat\", \"bird\"])\n    assert result.probabilities == expected[\"probabilities\"]\n    assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 1\n\ndef test_predictor_save_load(sample_url, sample_pil_image):\n    \"\"\"Test saving and loading predictors with image fields\"\"\"\n    signature = \"image: dspy.Image -> caption: str\"\n    examples = [\n        dspy.Example(image=dspy.Image.from_url(sample_url), caption=\"Example 1\"),\n        dspy.Example(image=sample_pil_image, caption=\"Example 2\"),\n    ]\n    \n    predictor, lm = setup_predictor(signature, {\"caption\": \"A golden retriever\"})\n    optimizer = dspy.teleprompt.LabeledFewShot(k=1)\n    compiled_predictor = optimizer.compile(student=predictor, trainset=examples, sample=False)\n\n    with tempfile.NamedTemporaryFile(mode='w+', delete=True, suffix=\".json\") as temp_file:\n        compiled_predictor.save(temp_file.name)\n        loaded_predictor = dspy.Predict(signature)\n        loaded_predictor.load(temp_file.name)\n    \n    result = loaded_predictor(image=dspy.Image.from_url(\"https://example.com/dog.jpg\"))\n    assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 2\n    assert \"<DSPY_IMAGE_START>\" not in str(lm.history[-1][\"messages\"])\n\ndef test_save_load_complex_default_types():\n    \"\"\"Test saving and loading predictors with complex default types (lists of images)\"\"\"\n    examples = [\n        dspy.Example(\n            image_list=[\n                dspy.Image.from_url(\"https://example.com/dog.jpg\"),\n                dspy.Image.from_url(\"https://example.com/cat.jpg\")\n            ],\n            caption=\"Example 1\"\n        ).with_inputs(\"image_list\"),\n    ]\n\n    class ComplexTypeSignature(dspy.Signature):\n        image_list: List[dspy.Image] = dspy.InputField(desc=\"A list of images\")\n        caption: str = dspy.OutputField(desc=\"A caption for the image list\")\n\n    predictor, lm = setup_predictor(ComplexTypeSignature, {\"caption\": \"A list of images\"})\n    optimizer = dspy.teleprompt.LabeledFewShot(k=1)\n    compiled_predictor = optimizer.compile(student=predictor, trainset=examples, sample=False)\n\n    with tempfile.NamedTemporaryFile(mode='w+', delete=True, suffix=\".json\") as temp_file:\n        compiled_predictor.save(temp_file.name)\n        loaded_predictor = dspy.Predict(ComplexTypeSignature)\n        loaded_predictor.load(temp_file.name)\n    \n    result = loaded_predictor(**examples[0].inputs())\n    assert result.caption == \"A list of images\"\n    assert str(lm.history[-1][\"messages\"]).count(\"'url'\") == 4\n    assert \"<DSPY_IMAGE_START>\" not in str(lm.history[-1][\"messages\"])\n\nclass BasicImageSignature(dspy.Signature):\n    \"\"\"Basic signature with a single image input\"\"\"\n    image: dspy.Image = dspy.InputField()\n    output: str = dspy.OutputField()\n\nclass ImageListSignature(dspy.Signature):\n    \"\"\"Signature with a list of images input\"\"\"\n    image_list: List[dspy.Image] = dspy.InputField()\n    output: str = dspy.OutputField()\n\n@pytest.mark.parametrize(\"test_case\", [\n    {\n        \"name\": \"basic_dspy_signature\",\n        \"signature_class\": BasicImageSignature,\n        \"inputs\": {\n            \"image\": \"https://example.com/dog.jpg\"\n        },\n        \"expected\": {\"output\": \"A dog photo\"},\n        \"expected_image_urls\": 2\n    },\n    {\n        \"name\": \"list_dspy_signature\",\n        \"signature_class\": ImageListSignature,\n        \"inputs\": {\n            \"image_list\": [\"https://example.com/dog.jpg\", \"https://example.com/cat.jpg\"]\n        },\n        \"expected\": {\"output\": \"Multiple photos\"},\n        \"expected_image_urls\": 4\n    }\n])\ndef test_save_load_complex_types(test_case):\n    \"\"\"Test saving and loading predictors with complex types\"\"\"\n    signature_cls = test_case[\"signature_class\"]\n    \n    # Convert string URLs to dspy.Image objects in input\n    processed_input = {}\n    for key, value in test_case[\"inputs\"].items():\n        if isinstance(value, str) and \"http\" in value:\n            processed_input[key] = dspy.Image.from_url(value)\n        elif isinstance(value, list) and value and isinstance(value[0], str):\n            processed_input[key] = [dspy.Image.from_url(url) for url in value]\n        else:\n            processed_input[key] = value\n    \n    # Create example and predictor\n    examples = [\n        dspy.Example(**processed_input, **test_case[\"expected\"]).with_inputs(*processed_input.keys())\n    ]\n    \n    predictor, lm = setup_predictor(signature_cls, test_case[\"expected\"])\n    optimizer = dspy.teleprompt.LabeledFewShot(k=1)\n    compiled_predictor = optimizer.compile(student=predictor, trainset=examples, sample=False)\n    \n    # Test save and load\n    with tempfile.NamedTemporaryFile(mode='w+', delete=True, suffix=\".json\") as temp_file:\n        compiled_predictor.save(temp_file.name)\n        loaded_predictor = dspy.Predict(signature_cls)\n        loaded_predictor.load(temp_file.name)\n    \n    # Run prediction\n    result = loaded_predictor(**processed_input)\n    \n    # Verify output matches expected\n    for key, value in test_case[\"expected\"].items():\n        assert getattr(result, key) == value\n    \n    # Verify correct number of image URLs in messages\n    assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == test_case[\"expected_image_urls\"]\n    assert \"<DSPY_IMAGE_START>\" not in str(lm.history[-1][\"messages\"])\n\ndef test_save_load_pydantic_model():\n    \"\"\"Test saving and loading predictors with pydantic models\"\"\"\n    class ImageModel(pydantic.BaseModel):\n        image: dspy.Image\n        image_list: Optional[List[dspy.Image]] = None\n        output: str\n\n    class PydanticSignature(dspy.Signature):\n        model_input: ImageModel = dspy.InputField()\n        output: str = dspy.OutputField()\n\n    # Create model instance\n    model_input = ImageModel(\n        image=dspy.Image.from_url(\"https://example.com/dog.jpg\"),\n        image_list=[dspy.Image.from_url(\"https://example.com/cat.jpg\")],\n        output=\"Multiple photos\"\n    )\n\n    # Create example and predictor\n    examples = [\n        dspy.Example(model_input=model_input, output=\"Multiple photos\").with_inputs(\"model_input\")\n    ]\n\n    predictor, lm = setup_predictor(PydanticSignature, {\"output\": \"Multiple photos\"})\n    optimizer = dspy.teleprompt.LabeledFewShot(k=1)\n    compiled_predictor = optimizer.compile(student=predictor, trainset=examples, sample=False)\n\n    # Test save and load\n    with tempfile.NamedTemporaryFile(mode='w+', delete=True, suffix=\".json\") as temp_file:\n        compiled_predictor.save(temp_file.name)\n        loaded_predictor = dspy.Predict(PydanticSignature)\n        loaded_predictor.load(temp_file.name)\n\n    # Run prediction\n    result = loaded_predictor(model_input=model_input)\n\n    # Verify output matches expected\n    assert result.output == \"Multiple photos\"\n    assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 4\n    assert \"<DSPY_IMAGE_START>\" not in str(lm.history[-1][\"messages\"])\n\ndef test_optional_image_field():\n    \"\"\"Test that optional image fields are not required\"\"\"\n    class OptionalImageSignature(dspy.Signature):\n        image: Optional[dspy.Image] = dspy.InputField()\n        output: str = dspy.OutputField()\n\n    predictor, lm = setup_predictor(OptionalImageSignature, {\"output\": \"Hello\"})\n    result = predictor(image=None)\n    assert result.output == \"Hello\"\n    assert count_messages_with_image_url_pattern(lm.history[-1][\"messages\"]) == 0\n\ndef test_image_repr():\n    \"\"\"Test string representation of Image objects\"\"\"\n    url_image = dspy.Image.from_url(\"https://example.com/dog.jpg\", download=False)\n    assert str(url_image) == \"<DSPY_IMAGE_START>https://example.com/dog.jpg<DSPY_IMAGE_END>\"\n    assert repr(url_image) == \"Image(url='https://example.com/dog.jpg')\"\n    \n    sample_pil = PILImage.new('RGB', (60, 30), color='red')\n    pil_image = dspy.Image.from_PIL(sample_pil)\n    assert str(pil_image).startswith(\"<DSPY_IMAGE_START>data:image/png;base64,\")\n    assert str(pil_image).endswith(\"<DSPY_IMAGE_END>\")\n    assert \"base64\" in str(pil_image)","lineStart":1,"lineEnd":331,"totalLines":331,"truncated":false}},"title":"tests/signatures/test_adapter_image.py","time":{"start":1788479972856,"end":1788479972875}},"metadat