ile(cls, file_path: str):\n51:         return cls(url=encode_image(file_path))\n52: \n53:     @classmethod\n54:     def from_PIL(cls, pil_image):\n55:         return cls(url=encode_image(pil_image))\n56: \n57:     @pydantic.model_serializer()\n58:     def serialize_model(self):\n59:         return \"<DSPY_IMAGE_START>\" + self.url + \"<DSPY_IMAGE_END>\"\n60: \n61:     def __str__(self):\n62:         return self.serialize_model()\n63: \n64:     def __repr__(self):\n65:         if \"base64\" in self.url:\n66:             len_base64 = len(self.url.split(\"base64,\")[1])\n67:             image_type = self.url.split(\";\")[0].split(\"/\")[-1]\n68:             return f\"Image(url=data:image/{image_type};base64,<IMAGE_BASE_64_ENCODED({str(len_base64)})>)\"\n69:         return f\"Image(url='{self.url}')\"\n70: \n71: def is_url(string: str) -> bool:\n72:     \"\"\"Check if a string is a valid URL.\"\"\"\n73:     try:\n74:         result = urlparse(string)\n75:         return all([result.scheme in (\"http\", \"https\"), result.netloc])\n76:     except ValueError:\n77:         return False\n78: \n79: \n80: def encode_image(image: Union[str, bytes, \"PILImage.Image\", dict], download_images: bool = False) -> str:\n81:     \"\"\"\n82:     Encode an image to a base64 data URI.\n83: \n84:     Args:\n85:         image: The image to encode. Can be a PIL Image, file path, URL, or data URI.\n86:         download_images: Whether to download images from URLs.\n87: \n88:     Returns:\n89:         str: The data URI of the image or the URL if download_images is False.\n90: \n91:     Raises:\n92:         ValueError: If the image type is not supported.\n93:     \"\"\"\n94:     if isinstance(image, dict) and \"url\" in image:\n95:         # NOTE: Not doing other validation for now\n96:         return image[\"url\"]\n97:     elif isinstance(image, str):\n98:         if image.startswith(\"data:image/\"):\n99:             # Already a data URI\n100:             return image\n101:         elif os.