{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_45cfa80a7ab345769bcff4b4","type":"tool_result","content":"1\tfrom typing import Optional\n2\t\n3\timport magicattr\n4\t\n5\tfrom dspy.dsp.utils.settings import settings\n6\tfrom dspy.predict.parallel import Parallel\n7\tfrom dspy.primitives.module import BaseModule\n8\tfrom dspy.utils.callback import with_callbacks\n9\tfrom dspy.utils.usage_tracker import track_usage\n10\t\n11\t\n12\tclass ProgramMeta(type):\n13\t    pass\n14\t\n15\t\n16\tclass Module(BaseModule, metaclass=ProgramMeta):\n17\t    def _base_init(self):\n18\t        self._compiled = False\n19\t\n20\t    def __init__(self, callbacks=None):\n21\t        self.callbacks = callbacks or []\n22\t        self._compiled = False\n23\t\n24\t    @with_callbacks\n25\t    def __call__(self, *args, **kwargs):\n26\t        if settings.track_usage and settings.usage_tracker is None:\n27\t            with track_usage() as usage_tracker:\n28\t                output = self.forward(*args, **kwargs)\n29\t                output.set_lm_usage(usage_tracker.get_total_tokens())\n30\t                return output\n31\t\n32\t        return self.forward(*args, **kwargs)\n33\t\n34\t    @with_callbacks\n35\t    async def acall(self, *args, **kwargs):\n36\t        if settings.track_usage and settings.usage_tracker is None:\n37\t            with track_usage() as usage_tracker:\n38\t                output = await self.aforward(*args, **kwargs)\n39\t                output.set_lm_usage(usage_tracker.get_total_tokens())\n40\t                return output\n41\t\n42\t        return await self.aforward(*args, **kwargs)\n43\t\n44\t    def named_predictors(self):\n45\t        from dspy.predict.predict import Predict\n46\t\n47\t        return [(name, param) for name, param in self.named_parameters() if isinstance(param, Predict)]\n48\t\n49\t    def predictors(self):\n50\t        return [param for _, param in self.named_predictors()]\n51\t\n52\t    def set_lm(self, lm):\n53\t        for _, param in self.named_predictors():\n54\t            param.lm = lm\n55\t\n56\t    def get_lm(self):\n57\t        all_used_lms = [param.lm for _, param in self.named_predictors()]\n58\t\n59\t        if len(set(all_used_lms)) == 1:\n60\t            return all_used_lms[0]\n61\t\n62\t        raise ValueError(\"Multiple LMs are being used in the module. There's no unique LM to return.\")\n63\t\n64\t    def __repr__(self):\n65\t        s = []\n66\t\n67\t        for name, param in self.named_predictors():\n68\t            s.append(f\"{name} = {param}\")\n69\t\n70\t        return \"\\n\".join(s)\n71\t\n72\t    def map_named_predictors(self, func):\n73\t        \"\"\"Applies a function to all named predictors.\"\"\"\n74\t        for name, predictor in self.named_predictors():\n75\t            set_attribute_by_name(self, name, func(predictor))\n76\t        return self\n77\t\n78\t    # def activate_assertions(self, handler=backtrack_handler, **handler_args):\n79\t    #     \"\"\"\n80\t    #     Activates assertions for the module.\n81\t    #     The default handler is the backtrack_handler.\n82\t    #     \"\"\"\n83\t    #     assert_transform_module(self, handler, **handler_args)\n84\t    #     return self\n85\t\n86\t    # def __deepcopy__(self, memo):\n87\t    #     # memo is a dict of id's to copies already made during the current call\n88\t    #     # Check if the object is already copied\n89\t    #     if id(self) in memo:\n90\t    #         return memo[id(self)]\n91\t\n92\t    #     print(f\"Deep copying {self.__class__.__name__}...\")\n93\t\n94\t    #     new_copy = copy.copy(self)\n95\t    #     memo[id(self)] = new_copy\n96\t\n97\t    #     for k, v in self.__dict__.items():\n98\t    #         print(f\"Copying attribute {k} of type {type(v)}...\")\n99\t    #         setattr(new_copy, k, copy.deepcopy(v, memo))\n100\t    #         print(\"Done\")\n101\t\n102\t    #     return new_copy\n103\t\n104\t    def batch(\n105\t        self,\n106\t        examples,\