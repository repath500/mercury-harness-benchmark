hat). Making the async path support both keeps parity. I think it's justified and small. Let me do it.\n\nThen re-run the sanity script.","signature":""}],"model":"z-ai/glm-5.3-flash","stop_reason":null,"stop_details":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0,"output_tokens_details":null,"cache_creation_input_tokens":null,"cache_read_input_tokens":null,"cache_creation":null,"inference_geo":null,"server_tool_use":null,"service_tier":null,"speed":"standard"},"provider":"Z.AI","context_management":null},"parent_tool_use_id":null,"session_id":"2274c7b7-1641-4ae2-bc9e-336ac139001c","uuid":"78ef97cb-bd80-4ae3-b61c-6c4977e217e5","timestamp":"2026-09-03T23:48:29.845Z","request_id":"gen-1788479293-OQB6qGjWpL0m9Pf6Jmla"}
