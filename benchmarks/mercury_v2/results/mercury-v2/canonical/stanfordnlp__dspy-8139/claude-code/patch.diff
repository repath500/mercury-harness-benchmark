+@pytest.mark.asyncio
+async def test_async_tool_calling_with_mixed_sync_and_async_tools():
+    """ReAct.aforward should handle both async and sync tools in the same run."""
+
+    async def async_echo(text: str) -> str:
+        """Echoes the text asynchronously."""
+        await asyncio.sleep(0)
+        return f"Async echoed: {text}"
+
+    def sync_add(a: int, b: int) -> int:
+        """Adds two numbers."""
+        return a + b
+
+    react = dspy.ReAct("question -> answer", tools=[async_echo, sync_add])
+    lm = DummyLM(
+        [
+            {
+                "next_thought": "I need to use the async tool.",
+                "next_tool_name": "async_echo",
+                "next_tool_args": {"text": "hello"},
+            },
+            {
+                "next_thought": "Now I need the sync tool.",
+                "next_tool_name": "sync_add",
+                "next_tool_args": {"a": 1, "b": 2},
+            },
+            {
+                "next_thought": "I have all the information, now I can finish.",
+                "next_tool_name": "finish",
+                "next_tool_args": {},
+            },
+            {"reasoning": "Combining the tool results", "answer": "Async echoed: hello and 3"},
+        ]
+    )
+    dspy.settings.configure(lm=lm)
+
+    outputs = await react.acall(question="What are the results?")
+
+    expected_trajectory = {
+        "thought_0": "I need to use the async tool.",
+        "tool_name_0": "async_echo",
+        "tool_args_0": {"text": "hello"},
+        "observation_0": "Async echoed: hello",
+        "thought_1": "Now I need the sync tool.",
+        "tool_name_1": "sync_add",
+        "tool_args_1": {"a": 1, "b": 2},
+        "observation_1": 3,
+        "thought_2": "I have all the information, now I can finish.",
+        "tool_name_2": "finish",
+        "tool_args_2": {},
+        "observation_2": "Completed.",
+    }
+    assert outputs.trajectory == expected_trajectory
+    assert outputs.answer == "Async echoed: hello and 3"
+
+
+@pytest.mark.asyncio
+async def test_async_error_retry():
+    """Tool failures in the async loop should be captured as observations."""
+
+    def foo(a, b):
+        raise Exception("tool error")
+
+    react = dspy.ReAct("a, b -> c:int", tools=[foo])
+    lm = DummyLM(
+        [
+            {"next_thought": "I need to add two numbers.", "next_tool_name": "foo", "next_tool_args": {"a": 1, "b": 2}},
+            {"next_thought": "I have the sum, now I can finish.", "next_tool_name": "finish", "next_tool_args": {}},
+            {"reasoning": "I added the numbers successfully", "c": 3},
+        ]
+    )
+    dspy.settings.configure(lm=lm)
+
+    outputs = await react.acall(a=1, b=2)
+    traj = outputs.trajectory
+
+    assert traj["observation_0"].startswith("Execution error in foo")
+    assert re.search(r"\btool error\b", traj["observation_0"])
+    assert traj["observation_1"] == "Completed."
+
+
+@pytest.mark.asyncio
+async def test_async_trajectory_truncation():
+    """Context window overflow in the async loop should truncate the oldest tool calls."""
+
+    def echo(text: str) -> str:
+        return f"Echoed: {text}"
+
+    react = dspy.ReAct("input_text -> output_text", tools=[echo])
+
+    call_count = 0
+
+    class AsyncMockModule:
+        """Stands in for a dspy module, exposing the async `acall` interface."""
+
+        def __init__(self, fn):
+            self.fn = fn
+
+        async def acall(self, **kwargs):
+            return await self.fn(**kwargs)
+
+    async def mock_react(**kwargs):
+        nonlocal call_count
+        call_count += 1
+
+        if call_count < 3:
+            return dspy.Prediction(
+                next_thought=f"Thought {call_count}",
+                next_tool_name="echo",
+                next_tool_args={"text": f"Text {call_count}"},
+            )
+        elif call_count == 3:
+            raise litellm.ContextWindowExceededError("Context window exceeded", "dummy_model", "dummy_provider")
+        else:
+            return dspy.Prediction(next_thought="Final thought", next_tool_name="finish", next_tool_args={})
+
+    async def mock_extract(**kwargs):
+        return dspy.Prediction(output_text="Final output")
+
+    react.react = AsyncMockModule(mock_react)
+    react.extract = AsyncMockModule(mock_extract)
+
+    result = await react.acall(input_text="test input")
+
+    assert "thought_0" not in result.trajectory
+    assert "thought_2" in result.trajectory
+    assert result.output_text == "Final output"
