+@pytest.mark.asyncio
+async def test_async_mixed_sync_and_async_tools():
+    async def async_double(x: int) -> int:
+        """Double a number asynchronously."""
+        await asyncio.sleep(0.001)
+        return x * 2
+
+    def sync_square(x: int) -> int:
+        """Square a number synchronously."""
+        return x * x
+
+    react = dspy.ReAct("a -> c:int", tools=[async_double, sync_square])
+    lm = DummyLM(
+        [
+            {"next_thought": "I need to double the number.", "next_tool_name": "async_double", "next_tool_args": {"x": 3}},
+            {"next_thought": "Now I need to square it.", "next_tool_name": "sync_square", "next_tool_args": {"x": 6}},
+            {"next_thought": "I have the result, now I can finish.", "next_tool_name": "finish", "next_tool_args": {}},
+            {"reasoning": "I computed everything successfully", "c": 36},
+        ]
+    )
+    dspy.settings.configure(lm=lm)
+    outputs = await react.acall(a=3)
+
+    assert outputs.trajectory["observation_0"] == 6
+    assert outputs.trajectory["observation_1"] == 36
+    assert outputs.trajectory["observation_2"] == "Completed."
+    assert outputs.c == 36
