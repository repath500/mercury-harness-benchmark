+@pytest.mark.asyncio
+async def test_async_tool_calling_with_async_tool():
+    async def fetch(text: str) -> str:
+        """Fetch some data asynchronously."""
+        await asyncio.sleep(0.001)
+        return f"Fetched: {text}"
+
+    react = dspy.ReAct("a -> b:str", tools=[fetch])
+    lm = DummyLM(
+        [
+            {"next_thought": "I need to fetch data.", "next_tool_name": "fetch", "next_tool_args": {"text": "hello"}},
+            {"next_thought": "I have the data, now I can finish.", "next_tool_name": "finish", "next_tool_args": {}},
+            {"reasoning": "I fetched the data successfully", "b": "Fetched: hello"},
+        ]
+    )
