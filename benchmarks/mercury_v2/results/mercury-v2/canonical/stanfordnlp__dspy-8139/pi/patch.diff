+def test_async_tool_call_detection():
+    async def async_tool(x: int) -> int:
+        return x
+
+    def sync_tool(x: int) -> int:
+        return x
+
+    class AsyncCallableTool:
+        async def __call__(self, x: int) -> int:
+            return x
+
+    react = dspy.ReAct("a -> b:int", tools=[async_tool, sync_tool, AsyncCallableTool()])
+
+    # Async tools (including callable instances with async __call__) go through `acall`
+    assert asyncio.iscoroutinefunction(react.tools["async_tool"].func)
+    assert asyncio.iscoroutinefunction(react.tools["AsyncCallableTool"].func.__call__)
+    # Sync tools are detected as such so they can be called normally
+    assert not asyncio.iscoroutinefunction(react.tools["sync_tool"].func)
