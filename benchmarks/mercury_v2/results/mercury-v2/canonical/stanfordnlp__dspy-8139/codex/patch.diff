+        [
+            {"next_thought": "I need to add the numbers.", "next_tool_name": "sync_add", "next_tool_args": {"a": 2, "b": 3}},
+            {
+                "next_thought": "I can multiply the sum by itself.",
+                "next_tool_name": "async_multiply",
+                "next_tool_args": {"a": 5, "b": 5},
+            },
+            {"next_thought": "I have the final result.", "next_tool_name": "finish", "next_tool_args": {}},
+            {"reasoning": "The calculation is complete", "c": 25},
+        ]
+    )
+    dspy.settings.configure(lm=lm)
+
+    outputs = await react.acall(a=2, b=3)
+
