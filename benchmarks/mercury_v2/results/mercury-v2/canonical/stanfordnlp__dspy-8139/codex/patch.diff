+    def sync_add(a: int, b: int) -> int:
+        """Add two numbers synchronously."""
+        return a + b
+
+    async def async_multiply(a: int, b: int) -> int:
+        """Multiply two numbers asynchronously."""
+        return a * b
+
+    react = dspy.ReAct("a, b -> c:int", tools=[sync_add, async_multiply])
