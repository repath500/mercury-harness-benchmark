{"type":"tool_use","timestamp":1788478262340,"sessionID":"ses_f96638f92ffeVKEyZreH0UcHVL","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-88784f87a6d64227","state":{"status":"completed","input":{"filePath":"/testbed/dspy/predict/react.py"},"output":"<path>/testbed/dspy/predict/react.py</path>\n<type>file</type>\n<content>\n1: import logging\n2: from typing import Any, Callable, Literal\n3: \n4: from litellm import ContextWindowExceededError\n5: \n6: import dspy\n7: from dspy.primitives.program import Module\n8: from dspy.primitives.tool import Tool\n9: from dspy.signatures.signature import ensure_signature\n10: \n11: logger = logging.getLogger(__name__)\n12: \n13: \n14: class ReAct(Module):\n15:     def __init__(self, signature, tools: list[Callable], max_iters=5):\n16:         \"\"\"\n17:         `tools` is either a list of functions, callable classes, or `dspy.Tool` instances.\n18:         \"\"\"\n19: \n20:         self.signature = signature = ensure_signature(signature)\n21:         self.max_iters = max_iters\n22: \n23:         tools = [t if isinstance(t, Tool) else Tool(t) for t in tools]\n24:         tools = {tool.name: tool for tool in tools}\n25: \n26:         inputs = \", \".join([f\"`{k}`\" for k in signature.input_fields.keys()])\n27:         outputs = \", \".join([f\"`{k}`\" for k in signature.output_fields.keys()])\n28:         instr = [f\"{signature.instructions}\\n\"] if signature.instructions else []\n29: \n30:         instr.extend(\n31:             [\n32:                 f\"You are an Agent. In each episode, you will be given the fields {inputs} as input. And you can see your past trajectory so far.\",\n33:                 f\"Your goal is to use one or more of the supplied tools to collect any necessary information for producing {outputs}.\\n\",\n34:                 \"To do this, you will interleave next_thought, next_tool_name, and next_tool_args in each turn, and also when finishing the task.\",\n35:                 \"After each tool call, you receive a resulting observation, which gets appended to your trajectory.\\n\",\n36:                 \"When writing next_thought, you may reason about the current situation and plan for future steps.\",\n37:                 \"When selecting the next_tool_name and its next_tool_args, the tool must be one of:\\n\",\n38:             ]\n39:         )\n40: \n41:         tools[\"finish\"] = Tool(\n42:             func=lambda: \"Completed.\",\n43:             name=\"finish\",\n44:             desc=f\"Marks the task as complete. That is, signals that all infomration for producing the outputs, i.e. {outputs}, are now available to be extracted.\",\n45:             args={},\n46:         )\n47: \n48:         for idx, tool in enumerate(tools.values()):\n49:             args = getattr(tool, \"args\")\n50:             desc = (f\", whose description is <desc>{tool.desc}</desc>.\" if tool.desc else \".\").replace(\"\\n\", \"  \")\n51:             desc += f\" It takes arguments {args} in JSON format.\"\n52:             instr.append(f\"({idx + 1}) {tool.name}{desc}\")\n53: \n54:         react_signature = (\n55:             dspy.Signature({**signature.input_fields}, \"\\n\".join(instr))\n56:             .append(\"trajectory\", dspy.InputField(), type_=str)\n57:             .append(\"next_thought\", dspy.OutputField(), type_=str)\n58:             .append(\"next_tool_name\", dspy.OutputField(), type_=Literal[tuple(tools.keys())])\n59:             .append(\"next_tool_args\", dspy.OutputField(), type_=dict[str, Any])\n60:         )\n61: \n62:         fallback_signature = dspy.Signature(\n63:             {**signature.input_fields, **signature.output_fields},\n64:             signature.instructions,\n65:         ).append(\"trajectory\", dspy.InputField(), type_=str)\n66: \n67:         self.tools = tools\n68:         self.react = dspy.Predict(react_signature)\n69:         self.extract = dspy.ChainOfThought(fallback_signature)\n70: \n71:     def _format_trajectory(self, trajectory: dict[str, Any]):\n72:         adapter = dspy.settings.adapter or dspy.ChatAdapter()\n73:         trajectory_signature = dspy.Signature(f\"{', '.join(trajectory.keys())} -> x\")\n74:         return adapter.format_user_message_content(trajectory_signature, trajectory)\n75: \n76:     def forward(self, **input_args):\n77:         trajectory = {}\n78:         max_iters = input_args.pop(\"max_iters\", self.max_iters)\n79:         for idx in range(max_iters):\n80:             try:\n81:                 pred = self._call_with_potential_trajectory_truncation(self.react, trajectory, **input_args)\n82:             except ValueError as err:\n83:                 logger.warning(f\"Ending the trajectory: Agent failed to select a valid tool: {_fmt_exc(err)}\")\n84:                 break\n85: \n86:             trajectory[f\"thought_{idx}\"] = pred.next_thought\n87:             trajectory[f\"tool_name_{idx}\"] = pred.next_tool_name\n88:             trajectory[f\"tool_args_{idx}\"] = pred.next_tool_args\n89: \n90:             try:\n91:                 trajectory[f\"observation_{idx}\"] = self.tools[pred.next_tool_name](**pred.next_tool_args)\n92:             except Exception as err:\n93:                 trajectory[f\"observation_{idx}\"] = f\"Execution error in {pred.next_tool_name}: {_fmt_exc(err)}\"\n94: \n95:             if pred.next_tool_name == \"finish\":\n96:                 break\n97: \n98:         extract = self._call_with_potential_trajectory_truncation(self.extract, trajectory, **input_args)\n99:         return dspy.Prediction(trajectory=trajectory, **extract)\n100: \n101:     def _call_with_potential_trajectory_truncation(self, module, trajectory, **input_args):\n102:         for _ in range(3):\n103:             try:\n104:                 return module(\n105:                     **input_args,\n106:                     trajectory=self._format_trajectory(trajectory),\n107:                 )\n108:             except ContextWindowExceededError:\n109:                 logger.warning(\"Trajectory exceeded the context window, truncating the oldest tool call information.\")\n110:                 trajectory = self.truncate_trajectory(trajectory)\n111: \n112:     def truncate_trajectory(self, trajectory):\n113:         \"\"\"Truncates the trajectory so that it fits in the context window.\n114: \n115:         Users can override this method to implement their own truncation logic.\n116:         \"\"\"\n117:         keys = list(trajectory.keys())\n118:         if len(keys) < 4:\n119:             # Every tool call has 4 keys: thought, tool_name, tool_args, and observation.\n120:             raise ValueError(\n121:                 \"The trajectory is too long so your prompt exceeded the context window, but the trajectory cannot be \"\n122:                 \"truncated because it only has one tool call.\"\n123:             )\n124: \n125:         for key in keys[:4]:\n126:             trajectory.pop(key)\n127: \n128:         return trajectory\n129: \n130: \n131: def _fmt_exc(err: BaseException, *, limit: int = 5) -> str:\n132:     \"\"\"\n133:     Return a one-string traceback summary.\n134:     * `limit`  – how many stack frames to keep (from the innermost outwards).\n135:     \"\"\"\n136: \n137:     import traceback\n138: \n139:     return \"\\n\" + \"\".join(traceback.format_exception(type(err), err, err.__traceback__, limit=limit)).strip()\n140: \n141: \n142: \"\"\"\n143: Thoughts and Planned Improvements for dspy.ReAct.\n144: \n145: TOPIC 01: How Trajectories are Formatted, or rather when they are formatted.\n146: \n147: Right now, both sub-modules are invoked with a `trajectory` argument, which is a string formatted in `forward`. Though\n148: the formatter uses a general adapter.format_fields, the tracing of DSPy only sees the string, not the formatting logic.\n149: \n150: What this means is that, in demonstrations, even if the user adjusts the adapter for a fixed program, the demos' format\n151: will not update accordingly, but the inference-time trajectories will.\n152: \n153: One way to fix this is to support `format=fn` in the dspy.InputField() for \"trajectory\" in the signatures. But this\n154: means that care must be taken that the adapter is accessed at `forward` runtime, not signature definition time.\n155: \n156: Another potential fix is to more natively support a \"variadic\" input field, where the input is a list of dictionaries,\n157: or a big dictionary, and have each adatper format it accordingly.\n158: \n159: Trajectories also affect meta-programming modules that view the trace later. It's inefficient O(n^2) to view the\n160: trace of every module repeating the prefix.\n161: \n162: \n163: TOPIC 02: Handling default arguments in the Tool class.\n164: \n165: \n166: TOPIC 03: Simplifying ReAct's __init__ by moving modular logic to the Tool class.\n167:     * Handling descriptions and casting.\n168:     * Handling exceptions and error messages.\n169:     * More cleanly defining the \"finish\" tool, perhaps as a runtime-defined function?\n170: \n171: \n172: TOPIC 04: Default behavior when the trajectory gets too long.\n173: \n174: \n175: TOPIC 05: Adding more structure around how the instruction is formatted.\n176:     * Concretely, it's now a string, so an optimizer can and does rewrite it freely.\n177:     * An alternative would be to add more structure, such that a certain template is fixed but values are variable?\n178: \n179: \n180: TOPIC 06: Idiomatically allowing tools that maintain state across iterations, but not across different `forward` calls.\n181:     * So the tool would be newly initialized at the start of each `forward` call, but maintain state across iterations.\n182:     * This is pretty useful for allowing the agent to keep notes or count certain things, etc.\n183: \"\"\"\n\n(End of file - total 183 lines)\n</content>","metadata":{"preview":"import logging\nfrom typing import Any, Callable, Literal\n\nfrom litellm import ContextWindowExceededError\n\nimport dspy\nfrom dspy.primitives.program import Module\nfrom dspy.primitives.tool import Tool\nfrom dspy.signatures.signature import ensure_signature\n\nlogger = logging.getLogger(__name__)\n\n\nclass ReAct(Module):\n    def __init__(self, signature, tools: list[Callable], max_iters=5):\n        \"\"\"\n        `tools` is either a list of functions, callable classes, or `dspy.Tool` instances.\n        \"\"\"\n\n        self.signature = signature = ensure_signature(signature)","truncated":false,"loaded":[],"display":{"type":"file","path":"/testbed/dspy/predict/react.py","text":"import logging\nfrom typing import Any, Callable, Literal\n\nfrom litellm import ContextWindowExceededError\n\nimport dspy\nfrom dspy.primitives.program import Module\nfrom dspy.primitives.tool import Tool\nfrom dspy.signatures.signature import ensure_signature\n\nlogger = logging.getLogger(__name__)\n\n\nclass ReAct(Module):\n    def __init__(self, signature, tools: list[Callable], max_iters=5):\n        \"\"\"\n        `tools` is either a list of functions, callable classes, or `dspy.Tool` instances.\n        \"\"\"\n\n        self.signature = signature = ensure_signature(signature)\n        self.max_iters = max_iters\n\n        tools = [t if isinstance(t, Tool) else Tool(t) for t in tools]\n        tools = {tool.name: tool for tool in tools}\n\n        inputs = \", \".join([f\"`{k}`\" for k in signature.input_fields.keys()])\n        outputs = \", \".join([f\"`{k}`\" for k in signature.output_fields.keys()])\n        instr = [f\"{signature.instructions}\\n\"] if signature.instructions else []\n\n        instr.extend(\n            [\n                f\"You are an Agent. In each episode, you will be given the fields {inputs} as input. And you can see your past trajectory so far.\",\n                f\"Your goal is to use one or more of the supplied tools to collect any necessary information for producing {outputs}.\\n\",\n                \"To do this, you will interleave next_thought, next_tool_name, and next_tool_args in each turn, and also when finishing the task.\",\n                \"After each tool call, you receive a resulting observation, which gets appended to your trajectory.\\n\",\n                \"When writing next_thought, you may reason about the current situation and plan for future steps.\",\n                \"When selecting the next_tool_name and its next_tool_args, the tool must be one of:\\n\",\n            ]\n        )\n\n        tools[\"finish\"] = Tool(\n            func=lambda: \"Completed.\",\n            name=\"finish\",\n            desc=f\"Marks the task as complete. That is, signals that all infomration for producing the outputs, i.e. {outputs}, are now available to be extracted.\",\n            args={},\n        )\n\n        for idx, tool in enumerate(tools.values()):\n            args = getattr(tool, \"args\")\n            desc = (f\", whose description is <desc>{tool.desc}</desc>.\" if tool.desc else \".\").replace(\"\\n\", \"  \")\n            desc += f\" It takes arguments {args} in JSON format.\"\n            instr.append(f\"({idx + 1}) {tool.name}{desc}\")\n\n        react_signature = (\n            dspy.Signature({**signature.input_fields}, \"\\n\".join(instr))\n            .append(\"trajectory\", dspy.InputField(), type_=str)\n            .append(\"next_thought\", dspy.OutputField(), type_=str)\n            .append(\"next_tool_name\", dspy.OutputField(), type_=Literal[tuple(tools.keys())])\n            .append(\"next_tool_args\", dspy.OutputField(), type_=dict[str, Any])\n        )\n\n        fallback_signature = dspy.Signature(\n            {**signature.input_fields, **signature.output_fields},\n            signature.instructions,\n        ).append(\"trajectory\", dspy.InputField(), type_=str)\n\n        self.tools = tools\n        self.react = dspy.Predict(react_signature)\n        self.extract = dspy.ChainOfThought(fallback_signature)\n\n    def _format_trajectory(self, trajectory: dict[str, Any]):\n        adapter = dspy.settings.adapter or dspy.ChatAdapter()\n        trajectory_signature = dspy.Signature(f\"{', '.join(trajectory.keys())} -> x\")\n        return adapter.format_user_message_content(trajectory_signature, trajectory)\n\n    def forward(self, **input_args):\n        trajectory = {}\n        max_iters = input_args.pop(\"max_iters\", self.max_iters)\n        for idx in range(max_iters):\n            try:\n                pred = self._call_with_potential_trajectory_truncation(self.react, trajectory, **input_args)\n            except ValueError as err:\n                logger.warning(f\"Ending the trajectory: Agent failed to select a valid tool: {_fmt_exc(err)}\")\n                break\n\n            trajectory[f\"thought_{idx}\"] = pred.next_thought\n            trajectory[f\"tool_name_{idx}\"] = pred.next_tool_name\n            trajectory[f\"tool_args_{idx}\"] = pred.next_tool_args\n\n            try:\n                trajectory[f\"observation_{idx}\"] = self.tools[pred.next_tool_name](**pred.next_tool_args)\n            except Exception as err:\n                trajectory[f\"observation_{idx}\"] = f\"Execution error in {pred.next_tool_name}: {_fmt_exc(err)}\"\n\n            if pred.next_tool_name == \"finish\":\n                break\n\n        extract = self._call_with_potential_trajectory_truncation(self.extract, trajectory, **input_args)\n        return dspy.Prediction(trajectory=trajectory, **extract)\n\n    def _call_with_potential_trajectory_truncation(self, module, trajectory, **input_args):\n        for _ in range(3):\n            try:\n                return module(\n                    **input_args,\n                    trajectory=self._format_trajectory(trajectory),\n                )\n            except ContextWindowExceededError:\n                logger.warning(\"Trajectory exceeded the context window, truncating the oldest tool call information.\")\n                trajectory = self.truncate_trajectory(trajectory)\n\n    def truncate_trajectory(self, trajectory):\n        \"\"\"Truncates the trajectory so that it fits in the context window.\n\n        Users can override this method to implement their own truncation logic.\n        \"\"\"\n        keys = list(trajectory.keys())\n        if len(keys) < 4:\n            # Every tool call has 4 keys: thought, tool_name, tool_args, and observation.\n            raise ValueError(\n                \"The trajectory is too long so your prompt exceeded the context window, but the trajectory cannot be \"\n                \"truncated because it only has one tool call.\"\n            )\n\n        for key in keys[:4]:\n            trajectory.pop(key)\n\n        return trajectory\n\n\ndef _fmt_exc(err: BaseException, *, limit: int = 5) -> str:\n    \"\"\"\n    Return a one-string traceback summary.\n    * `limit`  – how many stack frames to keep (from the innermost outwards).\n    \"\"\"\n\n    import traceback\n\n    return \"\\n\" + \"\".join(traceback.format_exception(type(err), err, err.__traceback__, limit=limit)).strip()\n\n\n\"\"\"\nThoughts and Planned Improvements for dspy.ReAct.\n\nTOPIC 01: How Trajectories are Formatted, or rather when they are formatted.\n\nRight now, both sub-modules are invoked with a `trajectory` argument, which is a string formatted in `forward`. Though\nthe formatter uses a general adapter.format_fields, the tracing of DSPy only sees the string, not the formatting logic.\n\nWhat this means is that, in demonstrations, even if the user adjusts the adapter for a fixed program, the demos' format\nwill not update accordingly, but the inference-time trajectories will.\n\nOne way to fix this is to support `format=fn` in the dspy.InputField() for \"trajectory\" in the signatures. But this\nmeans that care must be taken that the adapter is accessed at `forward` runtime, not signature definition time.\n\nAnother potential fix is to more natively support a \"variadic\" input field, where the input is a list of dictionaries,\nor a big dictionary, and have each adatper format it accordingly.\n\nTrajectories also affect meta-programming modules that view the trace later. It's inefficient O(n^2) to view the\ntrace of every module repeating the prefix.\n\n\nTOPIC 02: Handling default arguments in the Tool class.\n\n\nTOPIC 03: Simplifying ReAct's __init__ by moving modular logic to the Tool class.\n    * Handling descriptions and casting.\n    * Handling exceptions and error messages.\n    * More cleanly defining the \"finish\" tool, perhaps as a runtime-defined function?\n\n\nTOPIC 04: Default behavior when the trajectory gets too long.\n\n\nTOPIC 05: Adding more structure around how the instruction is formatted.\n    * Concretely, it's now a string, so an optimizer can and does rewrite it freely.\n    * An alternative would be to add more structure, such that a certain template is fixed but values are variable?\n\n\nTOPIC 06: Idiomatically allowing tools that maintain state across iterations, but not across different `forward` calls.\n    * So the tool would be newly initialized at the start of each `forward` call, but maintain state across iterations.\n    * This is pretty useful for allowing the agent to keep notes or count certain things, etc.\n\"\"\"","lineStart":1,"lineEnd":183,"totalLines":183,"truncated":false}},"title":"dspy/predict/react.py","time":{"start":1788478262316,"end":1788478262335}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_0699c8bf6001ijN3FtrDnsKYqj","sessionID":"ses_f96638f92ffeVKEyZreH0UcHVL","messageID":"msg_0699c807b001k3S4g7KzjrgbhK"}}
