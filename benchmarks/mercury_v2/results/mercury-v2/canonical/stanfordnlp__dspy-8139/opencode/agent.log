ct as summy passages.\",\n44: #             \"Let's add some more sentences to act as summy passages.\",\n45: #         ]\n46: #     )\n47: #     dspy.settings.configure(lm=lm, rm=rm)\n48: \n49: #     program = dspy.ReAct(\"question -> answer\")\n50: \n51: #     # Check default tools\n52: #     assert len(program.tools) == 2\n53: #     assert isinstance(program.tools[\"Search\"], dspy.Retrieve)\n54: #     assert isinstance(program.tools[\"Finish\"], dspy.Example)\n55: \n56: #     # Call the ReAct module on a particular input\n57: #     question = \"What is the color of the sky?\"\n58: #     result = program(question=question)\n59: #     assert result.answer == \"blue\"\n60: \n61: \n62: # class DummyTool1:\n63: #     name = \"Tool1\"\n64: #     input_variable = \"query\"\n65: #     desc = \"\"\n66: #     num_calls = 0\n67: \n68: #     def __call__(self, *args, **kwargs):\n69: #         # test case with no passages attribute\n70: #         assert args[0] == \"foo\"\n71: #         self.num_calls += 1\n72: #         return \"tool 1 output\"\n73: \n74: \n75: # @dataclass\n76: # class DummyOutput:\n77: #     passages: str\n78: \n79: \n80: # class DummyTool2:\n81: #     name = \"Tool2\"\n82: #     input_variable = \"query\"\n83: #     desc = \"\"\n84: #     num_calls = 0\n85: \n86: #     def __call__(self, *args, **kwargs):\n87: #         # test case with passages attribute\n88: #         assert args[0] == \"bar\"\n89: #         self.num_calls += 1\n90: #         return DummyOutput(passages=\"tool 2 output\")\n91: \n92: \n93: # def test_custom_tools():\n94: #     lm = DummyLM(\n95: #         [\n96: #             {\"Thought_1\": \"Initial thoughts\", \"Action_1\": \"Tool1[foo]\"},\n97: #             {\"Thought_2\": \"More thoughts\", \"Action_2\": \"Tool2[bar]\"},\n98: #             {\"Thought_3\": \"Even more thoughts\", \"Action_3\": \"Finish[baz]\"},\n99: #         ]\n100: #     )\n101: #     dspy.settings.configure(lm=lm)\n102: \n103: #     tool1 = DummyTool1()\n104: #     tool2 = DummyTool2()\n105: #     program = dspy.ReAct(\"question -> answer\", tools=[tool1, tool2])\n106: \n107: #     question = \"What is the color of the sky?\"\n108: #     result = program(question=question)\n109: #     assert result.answer == \"baz\"\n110: \n111: #     # each tool should be called only once\n112: #     assert tool1.num_calls == 1\n113: #     assert tool2.num_calls == 1\n114: \n115: \n116: # def test_signature_instructions():\n117: #     class ExampleSignature(dspy.Signature):\n118: #         \"\"\"You are going to generate output based on input.\"\"\"\n119: \n120: #         input = dspy.InputField()\n121: #         output = dspy.OutputField()\n122: \n123: #     react = dspy.ReAct(ExampleSignature)\n124: \n125: #     assert react.react[0].signature.instructions is not None\n126: #     assert react.react[0].signature.instructions.startswith(\"You are going to generate output based on input.\")\n127: \n128: \n129: def test_tool_calling_with_pydantic_args():\n130:     class CalendarEvent(BaseModel):\n131:         name: str\n132:         date: str\n133:         participants: dict[str, str]\n134: \n135:     def write_invitation_letter(participant_name: str, event_info: CalendarEvent):\n136:         if participant_name not in event_info.participants:\n137:             return None\n138:         return f\"It's my honor to invite {participant_name} to event {event_info.name} on {event_info.date}\"\n139: \n140:     class InvitationSignature(dspy.Signature):\n141:         participant_name: str = dspy.InputField(desc=\"The name of the participant to invite\")\n142:         event_info: CalendarEvent = dspy.InputField(desc=\"The information about the event\")\n143:         invitation_letter: str = dspy.OutputField(desc=\"The invitation letter to be sent to the participant\")\n144: \n145:     react = dspy.ReAct(InvitationSignature, tools=[write_invitation_letter])\n146: \n147:     lm = DummyLM(\n148:         [\n149:             {\n150:                 \"next_thought\": \"I need to write an invitation letter for Alice to the Science Fair event.\",\n151:                 \"next_tool_name\": \"write_invitation_letter\",\n152:                 \"next_tool_args\": {\n153:                     \"participant_name\": \"Alice\",\n154:                     \"event_info\": {\n155:                         \"name\": \"Science Fair\",\n156:                         \"date\": \"Friday\",\n157:                         \"participants\": {\"Alice\": \"female\", \"Bob\": \"male\"},\n158:                     },\n159:                 },\n160:             },\n161:             {\n162:                 \"next_thought\": (\n163:                     \"I have successfully written the invitation letter for Alice to the Science Fair. Now \"\n164:                     \"I can finish the task.\"\n165:                 ),\n166:                 \"next_tool_name\": \"finish\",\n167:                 \"next_tool_args\": {},\n168:             },\n169:             {\n170:                 \"reasoning\": \"This is a very rigorous reasoning process, trust me bro!\",\n171:                 \"invitation_letter\": \"It's my honor to invite Alice to the Science Fair event on Friday.\",\n172:             },\n173:         ]\n174:     )\n175:     dspy.settings.configure(lm=lm)\n176: \n177:     outputs = react(\n178:         participant_name=\"Alice\",\n179:         event_info=CalendarEvent(\n180:             name=\"Science Fair\",\n181:             date=\"Friday\",\n182:             participants={\"Alice\": \"female\", \"Bob\": \"male\"},\n183:         ),\n184:     )\n185:     assert outputs.invitation_letter == \"It's my honor to invite Alice to the Science Fair event on Friday.\"\n186: \n187:     expected_trajectory = {\n188:         \"thought_0\": \"I need to write an invitation letter for Alice to the Science Fair event.\",\n189:         \"tool_name_0\": \"write_invitation_letter\",\n190:         \"tool_args_0\": {\n191:             \"participant_name\": \"Alice\",\n192:             \"event_info\": {\n193:                 \"name\": \"Science Fair\",\n194:                 \"date\": \"Friday\",\n195:                 \"participants\": {\"Alice\": \"female\", \"Bob\": \"male\"},\n196:             },\n197:         },\n198:         \"observation_0\": \"It's my honor to invite Alice to event Science Fair on Friday\",\n199:         \"thought_1\": \"I have successfully written the invitation letter for Alice to the Science Fair. Now I can finish the task.\",\n200:         \"tool_name_1\": \"finish\",\n201:         \"tool_args_1\": {},\n202:         \"observation_1\": \"Completed.\",\n203:     }\n204:     assert outputs.trajectory == expected_trajectory\n205: \n206: \n207: def test_tool_calling_without_typehint():\n208:     def foo(a, b):\n209:         \"\"\"Add two numbers.\"\"\"\n210:         return a + b\n211: \n212:     react = dspy.ReAct(\"a, b -> c:int\", tools=[foo])\n213:     lm = DummyLM(\n214:         [\n215:             {\"next_thought\": \"I need to add two numbers.\", \"next_tool_name\": \"foo\", \"next_tool_args\": {\"a\": 1, \"b\": 2}},\n216:             {\"next_thought\": \"I have the sum, now I can finish.\", \"next_tool_name\": \"finish\", \"next_tool_args\": {}},\n217:             {\"reasoning\": \"I added the numbers successfully\", \"c\": 3},\n218:         ]\n219:     )\n220:     dspy.settings.configure(lm=lm)\n221:     outputs = react(a=1, b=2)\n222: \n223:     expected_trajectory = {\n224:         \"thought_0\": \"I need to add two numbers.\",\n225:         \"tool_name_0\": \"foo\",\n226:         \"tool_args_0\": {\n227:             \"a\": 1,\n228:             \"b\": 2,\n229:         },\n230:         \"observation_0\": 3,\n231:         \"thought_1\": \"I have the sum, now I can finish.\",\n232:         \"tool_name_1\": \"finish\",\n233:         \"tool_args_1\": {},\n234:         \"observation_1\": \"Completed.\",\n235:     }\n236:     assert outputs.trajectory == expected_trajectory\n237: \n238: \n239: def test_trajectory_truncation():\n240:     # Create a simple tool for testing\n241:     def echo(text: str) -> str:\n242:         return f\"Echoed: {text}\"\n243: \n244:     # Create ReAct instance with our echo tool\n245:     react = dspy.ReAct(\"input_text -> output_text\", tools=[echo])\n246: \n247:     # Mock react.react to simulate multiple tool calls\n248:     call_count = 0\n249: \n250:     def mock_react(**kwargs):\n251:         nonlocal call_count\n252:         call_count += 1\n253: \n254:         if call_count < 3:\n255:             # First 2 calls use the echo tool\n256:             return dspy.Prediction(\n257:                 next_thought=f\"Thought {call_count}\",\n258:                 next_tool_name=\"echo\",\n259:                 next_tool_args={\"text\": f\"Text {call_count}\"},\n260:             )\n261:         elif call_count == 3:\n262:             # The 3rd call raises context window exceeded error\n263:             raise litellm.ContextWindowExceededError(\"Context window exceeded\", \"dummy_model\", \"dummy_provider\")\n264:         else:\n265:             # The 4th call finishes\n266:             return dspy.Prediction(next_thought=\"Final thought\", next_tool_name=\"finish\", next_tool_args={})\n267: \n268:     react.react = mock_react\n269:     react.extract = lambda **kwargs: dspy.Prediction(output_text=\"Final output\")\n270: \n271:     # Call forward and get the result\n272:     result = react(input_text=\"test input\")\n273: \n274:     # Verify that older entries in the trajectory were truncated\n275:     assert \"thought_0\" not in result.trajectory\n276:     assert \"thought_2\" in result.trajectory\n277:     assert result.output_text == \"Final output\"\n278: \n279: \n280: def test_error_retry():\n281:     # --- a tiny tool that always fails -------------------------------------\n282:     def foo(a, b):  # noqa: D401, ANN001\n283:         raise Exception(\"tool error\")\n284: \n285:     # --- program under test -------------------------------------------------\n286:     react = dspy.ReAct(\"a, b -> c:int\", tools=[foo])\n287:     lm = DummyLM(\n288:         [\n289:             {\n290:                 \"next_thought\": \"I need to add two numbers.\",\n291:                 \"next_tool_name\": \"foo\",\n292:                 \"next_tool_args\": {\"a\": 1, \"b\": 2},\n293:             },\n294:             {\n295:                 \"next_thought\": \"I need to add two numbers.\",\n296:                 \"next_tool_name\": \"foo\",\n297:                 \"next_tool_args\": {\"a\": 1, \"b\": 2},\n298:             },\n299:             # (The model *would* succeed on the 3rd turn, but max_iters=2 stops earlier.)\n300:             {\"reasoning\": \"I added the numbers successfully\", \"c\": 3},\n301:         ]\n302:     )\n303:     dspy.settings.configure(lm=lm)\n304: \n305:     outputs = react(a=1, b=2, max_iters=2)\n306:     traj = outputs.trajectory\n307: \n308:     # --- exact-match checks (thoughts + tool calls) -------------------------\n309:     control_expected = {\n310:         \"thought_0\": \"I need to add two numbers.\",\n311:         \"tool_name_0\": \"foo\",\n312:         \"tool_args_0\": {\"a\": 1, \"b\": 2},\n313:         \"thought_1\": \"I need to add two numbers.\",\n314:         \"tool_name_1\": \"foo\",\n315:         \"tool_args_1\": {\"a\": 1, \"b\": 2},\n316:     }\n317:     for k, v in control_expected.items():\n318:         assert traj[k] == v, f\"{k} mismatch\"\n319: \n320:     # --- flexible checks for observations ----------------------------------\n321:     # We only care that each observation mentions our error string; we ignore\n322:     # any extra traceback detail or differing prefixes.\n323:     for i in range(2):\n324:         obs = traj[f\"observation_{i}\"]\n325:         assert re.search(r\"\\btool error\\b\", obs), f\"unexpected observation_{i!r}: {obs}\"\n\n(End of file - total 325 lines)\n</content>","metadata":{"preview":"from pydantic import BaseModel\n\nimport re\nimport dspy\nimport litellm\n\nfrom dspy.utils.dummies import DummyLM\n\n# def test_example_no_tools():\n#     # Create a simple dataset which the model will use with the Retrieve tool.\n#     lm = DummyLM(\n#         [\n#             {\"Thought_1\": \"Initial thoughts\", \"Action_1\": \"Finish[blue]\"},\n#         ]\n#     )\n#     dspy.settings.configure(lm=lm, rm=dummy_rm())\n\n#     program = dspy.ReAct(\"question -> answer\")\n\n#     # Check default tools","truncated":false,"loaded":[],"display":{"type":"file","path":"/testbed/tests/predict/test_react.py","text":"from pydantic import BaseModel\n\nimport re\nimport dspy\nimport litellm\n\nfrom dspy.utils.dummies import DummyLM\n\n# def test_example_no_tools():\n#     # Create a simple dataset which the model will use with the Retrieve tool.\n#     lm = DummyLM(\n#         [\n#             {\"Thought_1\": \"Initial thoughts\", \"Action_1\": \"Finish[blue]\"},\n#         ]\n#     )\n#     dspy.settings.configure(lm=lm, rm=dummy_rm())\n\n#     program = dspy.ReAct(\"question -> answer\")\n\n#     # Check default tools\n#     assert isinstance(program.tools[\"Finish\"], dspy.Example)\n\n#     # Call the ReAct module on a particular input\n#     question = \"What is the color of the sky?\"\n#     result = program(question=question)\n#     assert result.answer == \"blue\"\n\n\n# def test_example_search():\n#     # Create a simple dataset which the model will use with the Retrieve tool.\n#     lm = DummyLM(\n#         [\n#             {\"Thought_1\": \"Initial thoughts\", \"Action_1\": \"Search[the color of the sky]\"},\n#             {\"Thought_2\": \"More thoughts\", \"Action_2\": \"Finish[blue]\\n\\n\"},\n#         ]\n#     )\n#     rm = dummy_rm(\n#         [\n#             \"We all know the color of the sky is blue.\",\n#             \"Something about the sky colors\",\n#             \"This sentence is completely irellevant to answer the question.\",\n#             \"Let's add some more sentences to act as summy passages.\",\n#             \"Let's add some more sentences to act as summy passages.\",\n#             \"Let's add some more sentences to act as summy passages.\",\n#         ]\n#     )\n#     dspy.settings.configure(lm=lm, rm=rm)\n\n#     program = dspy.ReAct(\"question -> answer\")\n\n#     # Check default tools\n#     assert len(program.tools) == 2\n#     assert isinstance(program.tools[\"Search\"], dspy.Retrieve)\n#     assert isinstance(program.tools[\"Finish\"], dspy.Example)\n\n#     # Call the ReAct module on a particular input\n#     question = \"What is the color of the sky?\"\n#     result = program(question=question)\n#     assert result.answer == \"blue\"\n\n\n# class DummyTool1:\n#     name = \"Tool1\"\n#     input_variable = \"query\"\n#     desc = \"\"\n#     num_calls = 0\n\n#     def __call__(self, *args, **kwargs):\n#         # test case with no passages attribute\n#         assert args[0] == \"foo\"\n#         self.num_calls += 1\n#         return \"tool 1 output\"\n\n\n# @dataclass\n# class DummyOutput:\n#     passages: str\n\n\n# class DummyTool2:\n#     name = \"Tool2\"\n#     input_variable = \"query\"\n#     desc = \"\"\n#     num_calls = 0\n\n#     def __call__(self, *args, **kwargs):\n#         # test case with passages attribute\n#         assert args[0] == \"bar\"\n#         self.num_calls += 1\n#         return DummyOutput(passages=\"tool 2 output\")\n\n\n# def test_custom_tools():\n#     lm = DummyLM(\n#         [\n#             {\"Thought_1\": \"Initial thoughts\", \"Action_1\": \"Tool1[foo]\"},\n#             {\"Thought_2\": \"More thoughts\", \"Action_2\": \"Tool2[bar]\"},\n#             {\"Thought_3\": \"Even more thoughts\", \"Action_3\": \"Finish[baz]\"},\n#         ]\n#     )\n#     dspy.settings.configure(lm=lm)\n\n#     tool1 = DummyTool1()\n#     tool2 = DummyTool2()\n#     program = dspy.ReAct(\"question -> answer\", tools=[tool1, tool2])\n\n#     question = \"What is the color of the sky?\"\n#     result = program(question=question)\n#     assert result.answer == \"baz\"\n\n#     # each tool should be called only once\n#     assert tool1.num_calls == 1\n#     assert tool2.num_calls == 1\n\n\n# def test_signature_instructions():\n#     class ExampleSignature(dspy.Signature):\n#         \"\"\"You are going to generate output based on input.\"\"\"\n\n#         input = dspy.InputField()\n#         output = dspy.OutputField()\n\n#     react = dspy.ReAct(ExampleSignature)\n\n#     assert react.react[0].signature.instructions is not None\n#     assert react.react[0].signature.instructions.startswith(\"You are going to generate output based on input.\")\n\n\ndef test_tool_calling_with_pydantic_args():\n    class CalendarEvent(BaseModel):\n        name: str\n        date: str\n        participants: dict[str, str]\n\n    def write_invitation_letter(participant_name: str, event_info: CalendarEvent):\n        if participant_name not in event_info.participants:\n            return None\n        return f\"It's my honor to invite {participant_name} to event {event_info.name} on {event_info.date}\"\n\n    class InvitationSignature(dspy.Signature):\n        participant_name: str = dspy.InputField(desc=\"The name of the participant to invite\")\n        event_info: CalendarEvent = dspy.InputField(desc=\"The information about the event\")\n        invitation_letter: str = dspy.OutputField(desc=\"The invitation letter to be sent to the participant\")\n\n    react = dspy.ReAct(InvitationSignature, tools=[write_invitation_letter])\n\n    lm = DummyLM(\n        [\n            {\n                \"next_thought\": \"I need to write an invitation letter for Alice to the Science Fair event.\",\n                \"next_tool_name\": \"write_invitation_letter\",\n                \"next_tool_args\": {\n                    \"participant_name\": \"Alice\",\n                    \"event_info\": {\n                        \"name\": \"Science Fair\",\n                        \"date\": \"Friday\",\n                        \"participants\": {\"Alice\": \"female\", \"Bob\": \"male\"},\n                    },\n                },\n            },\n            {\n                \"next_thought\": (\n                    \"I have successfully written the invitation letter for Alice to the Science Fair. Now \"\n                    \"I can finish the task.\"\n                ),\n                \"next_tool_name\": \"finish\",\n                \"next_tool_args\": {},\n            },\n            {\n                \"reasoning\": \"This is a very rigorous reasoning process, trust me bro!\",\n                \"invitation_letter\": \"It's my honor to invite Alice to the Science Fair event on Friday.\",\n            },\n        ]\n    )\n    dspy.settings.configure(lm=lm)\n\n    outputs = react(\n        participant_name=\"Alice\",\n        event_info=CalendarEvent(\n            name=\"Science Fair\",\n            date=\"Friday\",\n            participants={\"Alice\": \"female\", \"Bob\": \"male\"},\n        ),\n    )\n    assert outputs.invitation_letter == \"It's my honor to invite Alice to the Science Fair event on Friday.\"\n\n    expected_trajectory = {\n        \"thought_0\": \"I need to write an invitation letter for Alice to the Science Fair event.\",\n        \"tool_name_0\": \"write_invitation_letter\",\n        \"tool_args_0\": {\n            \"participant_name\": \"Alice\",\n            \"event_info\": {\n                \"name\": \"Science Fair\",\n                \"date\": \"Friday\",\n                \"participants\": {\"Alice\": \"female\", \"Bob\": \"male\"},\n            },\n        },\n        \"observation_0\": \"It's my honor to invite Alice to event Science Fair on Friday\",\n        \"thought_1\": \"I have successfully written the invitation letter for Alice to the Science Fair. Now I can finish the task.\",\n        \"tool_name_1\": \"finish\",\n        \"tool_args_1\": {},\n        \"observation_1\": \"Completed.\",\n    }\n    assert outputs.trajectory == expected_trajectory\n\n\ndef test_tool_calling_without_typehint():\n    def foo(a, b):\n        \"\"\"Add two numbers.\"\"\"\n        return a + b\n\n    react = dspy.ReAct(\"a, b -> c:int\", tools=[foo])\n    lm = DummyLM(\n        [\n            {\"next_thought\": \"I need to add two numbers.\", \"next_tool_name\": \"foo\", \"next_tool_args\": {\"a\": 1, \"b\": 2}},\n            {\"next_thought\": \"I have the sum, now I can finish.\", \"next_tool_name\": \"finish\", \"next_tool_args\": {}},\n            {\"reasoning\": \"I added the numbers successfully\", \"c\": 3},\n        ]\n    )\n    dspy.settings.configure(lm=lm)\n    outputs = react(a=1, b=2)\n\n    expected_trajectory = {\n        \"thought_0\": \"I need to add two numbers.\",\n        \"tool_name_0\": \"foo\",\n        \"tool_args_0\": {\n            \"a\": 1,\n            \"b\": 2,\n        },\n        \"observation_0\": 3,\n        \"thought_1\": \"I have the sum, now I can finish.\",\n        \"tool_name_1\": \"finish\",\n        \"tool_args_1\": {},\n        \"observation_1\": \"Completed.\",\n    }\n    assert outputs.trajectory == expected_trajectory\n\n\ndef test_trajectory_truncation():\n    # Create a simple tool for testing\n    def echo(text: str) -> str:\n        return f\"Echoed: {text}\"\n\n    # Create ReAct instance with our echo tool\n    react = dspy.ReAct(\"input_text -> output_text\", tools=[echo])\n\n    # Mock react.react to simulate multiple tool calls\n    call_count = 0\n\n    def mock_react(**kwargs):\n        nonlocal call_count\n        call_count += 1\n\n        if call_count < 3:\n            # First 2 calls use the echo tool\n            return dspy.Prediction(\n                next_thought=f\"Thought {call_count}\",\n                next_tool_name=\"echo\",\n                next_tool_args={\"text\": f\"Text {call_count}\"},\n            )\n        elif call_count == 3:\n            # The 3rd call raises context window exceeded error\n            raise litellm.ContextWindowExceededError(\"Context window exceeded\", \"dummy_model\", \"dummy_provider\")\n        else:\n            # The 4th call finishes\n            return dspy.Prediction(next_thought=\"Final thought\", next_tool_name=\"finish\", next_tool_args={})\n\n    react.react = mock_react\n    react.extract = lambda **kwargs: dspy.Prediction(output_text=\"Final output\")\n\n    # Call forward and get the result\n    result = react(input_text=\"test input\")\n\n    # Verify that older entries in the trajectory were truncated\n    assert \"thought_0\" not in result.trajectory\n    assert \"thought_2\" in result.trajectory\n    assert result.output_text == \"Final output\"\n\n\ndef test_error_retry():\n    # --- a tiny tool that always fails -------------------------------------\n    def foo(a, b):  # noqa: D401, ANN001\n        raise Exception(\"tool error\")\n\n    # --- program under test -------------------------------------------------\n    react = dspy.ReAct(\"a, b -> c:int\", tools=[foo])\n    lm = DummyLM(\n        [\n            {\n                \"next_thought\": \"I need to add two numbers.\",\n                \"next_tool_name\": \"foo\",\n                \"next_tool_args\": {\"a\": 1, \"b\": 2},\n            },\n            {\n                \"next_thought\": \"I need to add two numbers.\",\n                \"next_tool_name\": \"foo\",\n                \"next_tool_args\": {\"a\": 1, \"b\": 2},\n            },\n            # (The model *would* succeed on the 3rd turn, but max_iters=2 stops earlier.)\n            {\"reasoning\": \"I added the numbers successfully\", \"c\": 3},\n        ]\n    )\n    dspy.settings.configure(lm=lm)\n\n    outputs = react(a=1, b=2, max_iters=2)\n    traj = outputs.trajectory\n\n    # --- exact-match checks (thoughts + tool calls) -------------------------\n    control_expected = {\n        \"thought_0\": \"I need to add two numbers.\",\n        \"tool_name_0\": \"foo\",\n        \"tool_args_0\": {\"a\": 1, \"b\": 2},\n        \"thought_1\": \"I need to add two numbers.\",\n        \"tool_name_1\": \"foo\",\n        \"tool_args_1\": {\"a\": 1, \"b\": 2},\n    }\n    for k, v in control_expected.items():\n        assert traj[k] == v, f\"{k} mismatch\"\n\n    # --- flexible checks for observations ----------------------------------\n    # We only care that each observation mentions our error string; we ignore\n    # any extra traceback detail or differing prefixes.\n    for i in range(2):\n        obs = traj[f\"observation_{i}\"]\n        assert re.search(r\"\\btool error\\b\", obs), f\"unexpected observation_{i!r}: {obs}\"","lineStart":1,"lineEnd":325,"totalLines":325,"truncated":false}},"title":"tests/predict/test_react.py","time":{"start":1788478270798,"end":1788478270815}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_0699cac2f0019mNG626J85qn5P","sessionID":"ses_f96638f92ffeVKEyZreH0UcHVL","messageID":"msg_0699ca7c4001GlEKlwB6gEowsQ"}}
