From mesa 3.x source:

```python
    def select(
        self,
        filter_func: Callable[[Agent], bool] | None = None,
        at_most: int | float | None = None,
        inplace: bool = False,
        agent_type: type[Agent] | None = None,
        n: int | None = None,
    ) -> AgentSet:
        """
        Select a subset of agents from the AgentSet based on a filter function and/or quantity limit.

        Args:
            filter_func (Callable[[Agent], bool], optional): A function that takes an Agent and returns True if the
                agent should be included in the result. Defaults to None, meaning no filtering is applied.
            at_most (int | float | None, optional): The maximum amount of agents to select.
                - If an integer, at_most refers to the maximum number of agents to select.
                - If a float, at_most refers to the maximum fraction of agents to select.
                - If None, all matching agents are selected (no limit).
            inplace (bool, optional): If True, modifies the current AgentSet; otherwise, returns a new AgentSet. Defaults to False.
            agent_type (type[Agent], optional): The class type of the agents to select. Defaults to None, meaning no type filtering is applied.
            n (int, optional): Deprecated alias for at_most. Will be removed in Mesa 3.1.

        Returns:
            AgentSet: A new AgentSet containing the selected agents, unless inplace is True, in which case the current AgentSet is updated.

        Raises:
            ValueError: If at_most is negative or invalid.
        """
        if n is not None:
            warnings.warn(
                "The 'n' parameter is deprecated. Use 'at_most' instead.",
                DeprecationWarning,
                stacklevel=2,
            )
            at_most = n

        if filter_func is None and agent_type is None and at_most is None:
            return self if inplace else copy.copy(self)

        # Handle at_most being a float
        if isinstance(at_most, float):
            if at_most < 0:
                raise ValueError("at_most must be greater than or equal to 0.")
            if at_most > 1:
                raise ValueError("float value of at_most must be between 0.0 and 1.0.")
            at_most = int(at_most * len(self))
```

