timestamp=2026-09-03T22:18:54.745Z level=INFO run=af4b6a3d message=evaluated permission=bash pattern="python -c \"\nimport jwt\nfrom jwt import PyJWK, PyJWS\nfrom tests.utils import key_path\nfrom cryptography.hazmat.primitives.serialization import load_pem_private_key\nfrom jwt.algorithms import RSAAlgorithm\n\nwith open(key_path('testkey_rsa.priv'), 'rb') as f:\n    priv = load_pem_private_key(f.read(), password=None)\n\n# 1. JWT encode with a private RSA JWK, algorithm inferred\njwk_dict = RSAAlgorithm.to_jwk(priv, as_dict=True)\njwk_dict['alg'] = 'RS256'\njwk = PyJWK(jwk_dict)\npub_dict = RSAAlgorithm.to_jwk(priv.public_key(), as_dict=True)\npub_dict['alg'] = 'RS256'\npub_jwk = PyJWK(pub_dict)\ntoken = jwt.encode({'some': 'payload'}, jwk)\nprint('1. JWT+JWK header:', jwt.get_unverified_header(token))\nprint('   roundtrip:', jwt.decode(token, pub_jwk, algorithms=['RS256']))\n\n# 2. JWS encode with oct JWK (HS384 from JWK alg)\njws = PyJWS()\noct_jwk = PyJWK({'kty': 'oct', 'alg': 'HS384', 'k': 'c2VjcmV0'})\nmsg = jws.encode(b'hello world', oct_jwk)\nprint('2. JWS+JWK header:', jws.get_unverified_header(msg))\nprint('   roundtrip:', jws.decode(msg, oct_jwk, algorithms=['HS384']))\n\n# 3. Explicit algorithm override wins over JWK alg\nmsg2 = jws.encode(b'hello world', oct_jwk, algorithm='HS512')\nprint('3. override header:', jws.get_unverified_header(msg2))\n\n# 4. string key defaults to HS256 (backward compat)\nmsg3 = jws.encode(b'hello world', 'secret')\nprint('4. str key default:', jws.get_unverified_header(msg3))\n\n# 5. 'none' still available when explicit\nmsg4 = jws.encode(b'hello world', key=None, algorithm='none')\nprint('5. none header:', jws.get_unverified_header(msg4))\n\n# 6. JWT encode with headers alg overriding JWK\ntoken6 = jwt.encode({'a': 1}, oct_jwk, headers={'alg': 'HS256'})\nprint('6. header override:', jwt.get_unverified_header(token6))\n\"" action.permission=* action.action=allow action.pattern=*
