{"type":"tool_use","timestamp":1788473801516,"sessionID":"ses_f96a9ebceffeKmiM5H0EW3IjUw","part":{"type":"tool","tool":"read","callID":"call_ab8b48aa58f74ce3a14cd692","state":{"status":"completed","input":{"filePath":"/testbed/tests/test_api_jws.py","limit":120},"output":"<path>/testbed/tests/test_api_jws.py</path>\n<type>file</type>\n<content>\n1: import json\n2: from decimal import Decimal\n3: \n4: import pytest\n5: \n6: from jwt.algorithms import NoneAlgorithm, has_crypto\n7: from jwt.api_jwk import PyJWK\n8: from jwt.api_jws import PyJWS\n9: from jwt.exceptions import (\n10:     DecodeError,\n11:     InvalidAlgorithmError,\n12:     InvalidSignatureError,\n13:     InvalidTokenError,\n14: )\n15: from jwt.utils import base64url_decode\n16: from jwt.warnings import RemovedInPyjwt3Warning\n17: \n18: from .utils import crypto_required, key_path, no_crypto_required\n19: \n20: try:\n21:     from cryptography.hazmat.primitives.serialization import (\n22:         load_pem_private_key,\n23:         load_pem_public_key,\n24:         load_ssh_public_key,\n25:     )\n26: except ModuleNotFoundError:\n27:     pass\n28: \n29: \n30: @pytest.fixture\n31: def jws():\n32:     return PyJWS()\n33: \n34: \n35: @pytest.fixture\n36: def payload():\n37:     \"\"\"Creates a sample jws claimset for use as a payload during tests\"\"\"\n38:     return b\"hello world\"\n39: \n40: \n41: class TestJWS:\n42:     def test_register_algo_does_not_allow_duplicate_registration(self, jws):\n43:         jws.register_algorithm(\"AAA\", NoneAlgorithm())\n44: \n45:         with pytest.raises(ValueError):\n46:             jws.register_algorithm(\"AAA\", NoneAlgorithm())\n47: \n48:     def test_register_algo_rejects_non_algorithm_obj(self, jws):\n49:         with pytest.raises(TypeError):\n50:             jws.register_algorithm(\"AAA123\", {})\n51: \n52:     def test_unregister_algo_removes_algorithm(self, jws):\n53:         supported = jws.get_algorithms()\n54:         assert \"none\" in supported\n55:     