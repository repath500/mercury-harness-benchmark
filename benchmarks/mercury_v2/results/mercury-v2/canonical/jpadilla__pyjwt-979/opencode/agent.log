timestamp=2026-09-03T22:18:20.286Z level=INFO run=af4b6a3d message=evaluated permission=bash pattern="python -c \"\nimport jwt\nfrom jwt import PyJWK\n\n# 1. JWT encode with a JWK (RSA) - algorithm inferred from JWK\nfrom tests.utils import key_path\nwith open(key_path('testkey_rsa.priv'), 'rb') as f:\n    pem = f.read()\nfrom cryptography.hazmat.primitives.serialization import load_pem_private_key\nfrom jwt.algorithms import RSAAlgorithm\npriv = load_pem_private_key(pem, password=None)\njwk_dict = RSAAlgorithm.to_jwk(priv, as_dict=True)\njwk_dict['alg'] = 'RS256'\njwk = PyJWK(jwk_dict)\ntoken = jwt.encode({'some': 'payload'}, jwk)\nprint('JWT+JWK header:', jwt.get_unverified_header(token))\nprint('roundtrip ok:', jwt.decode(token, jwk, algorithms=['RS256']))\n\n# 2. JWS encode with an oct JWK, no algorithm given\nfrom jwt import PyJWS\njws = PyJWS()\noct_jwk = PyJWK({'kty': 'oct', 'alg': 'HS384', 'k': 'c2VjcmV0'})\nmsg = jws.encode(b'hello world', oct_jwk)\nprint('JWS+JWK header:', jws.get_unverified_header(msg))\nprint('JWS roundtrip ok:', jws.decode(msg, oct_jwk, algorithms=['HS384']))\n\n# 3. Explicit algorithm override with JWK\nmsg2 = jws.encode(b'hello world', oct_jwk, algorithm='HS512')\nprint('override header:', jws.get_unverified_header(msg2))\n\n# 4. Backward compat: string key defaults to HS256, algorithm=None+non-JWK\nmsg3 = jws.encode(b'hello world', 'secret')\nprint('str key default:', jws.get_unverified_header(msg3))\n\n# 5. key=None, algorithm='none' still works\nmsg4 = jws.encode(b'hello world', key=None, algorithm='none')\nprint('none header:', jws.get_unverified_header(msg4))\n\"" action.permission=* action.action=allow action.pattern=*
