       self._validate_nbf(payload, now, leeway)\n242: \n243:         if \"exp\" in payload and options[\"verify_exp\"]:\n244:             self._validate_exp(payload, now, leeway)\n245: \n246:         if options[\"verify_iss\"]:\n247:             self._validate_iss(payload, issuer)\n248: \n249:         if options[\"verify_aud\"]:\n250:             self._validate_aud(\n251:                 payload, audience, strict=options.get(\"strict_aud\", False)\n252:             )\n253: \n254:     def _validate_required_claims(\n255:         self,\n256:         payload: dict[str, Any],\n257:         options: dict[str, Any],\n258:     ) -> None:\n259:         for claim in options[\"require\"]:\n260:             if payload.get(claim) is None:\n261:                 raise MissingRequiredClaimError(claim)\n262: \n263:     def _validate_iat(\n264:         self,\n265:         payload: dict[str, Any],\n266:         now: float,\n267:         leeway: float,\n268:     ) -> None:\n269:         try:\n270:             iat = int(payload[\"iat\"])\n271:         except ValueError:\n272:             raise InvalidIssuedAtError(\"Issued At claim (iat) must be an integer.\")\n273:         if iat > (now + leeway):\n274:             raise ImmatureSignatureError(\"The token is not yet valid (iat)\")\n275: \n276:     def _validate_nbf(\n277:         self,\n278:         payload: dict[str, Any],\n279:         now: float,\n280:         leeway: float,\n281:     ) -> None:\n282:         try:\n283:             nbf = int(payload[\"nbf\"])\n284:         except ValueError:\n285:             raise DecodeError(\"Not Before claim (nbf) must be an integer.\")\n286: \n287:         if nbf > (now + leeway):\n288:             raise ImmatureSignatureError(\"The token is not yet valid (nbf)\")\n289: \n290:     def _validate_exp(\n291:         self,\n292:         payload: dict[str, Any],\n293:         now: float,\n294:         leeway: float,\n295:     ) -> None:\n296:         try:\n297:             exp = int(payload[\"exp\"