thinking":"The upstream PR left `signing_algos = oidc_config[\"id_token_signing_alg_values_supported\"]` in place (the docs diff in PR #886 only removed the `algorithms=signing_algos` line, keeping the variable — since the OIDC server may support multiple algorithms and the JWK carries the right one). I'll keep it consistent with upstream: leave the variable as-is. It's an illustrative example; keeping it matches upstream exactly.\n\nNow, verify the final state of the modified source files, then update the tests per the PR (tests/test_api_jwk.py and tests/test_api_jws.py). Let me view the diffs so far.","thinkingSignature":"[{\"type\":\"reasoning.text\",\"text\":\"The upstream PR left `signing_algos = oidc_config[\\\"id_token_signing_alg_values_supported\\\"]` in place (the docs diff in PR #886 only removed the `algorithms=signing_algos` line, keeping the variable — since the OIDC server may support multiple algorithms and the JWK carries the right one). I'll keep it consistent with upstream: leave the variable as-is. It's an illustrative example; keeping it matches upstream exactly.\\n\\nNow, verify the final state of the modified source files, then update the tests per the PR (tests/test_api_jwk.py and tests/test_api_jws.py). Let me view the diffs so far.\",\"format\":\"unknown\",\"index\":0}]"},{"type":"text","text":"That matches the upstream PR exactly (it kept the `signing_algos` config line). Now let me verify the source changes and run a quick functional check:"},{"type":"toolCall","id":"call_145bca9e7e5f4410a1e92162","name":"bash","arguments":{"command":"cd /testbed && git diff jwt/"}},{"type":"toolCall","id":"call_da4429fa00be4153a6f2fb4e","name":"bash","arguments":{"command":"cd /testbed && python -c \"\nimport jwt, base64, json\n\ndef b64(d): return base64.urlsafe_b64encode(json.dumps(d).encode()).rstrip(b'=').decode()\n\n# HS256 JWK\njwk = jwt.PyJWK({'kty':'oct','k':'c2VjcmV0','alg':'HS256'})\nprint('algorithm_name:', jwk.algorithm_name)\n\ntoken = jwt.encode({'some':'payload'}, 'secret', algorithm='HS256')\n\n# 1. jwt.decode with PyJWK and explicit algorithms\nprint('explicit alg:', jwt.decode(token, key=jwk, algorithms=['HS256']))\n# 2. jwt.decode with PyJWK, no algorithms -> uses JWK alg\nprint('implicit alg:', jwt.decode(token, key=jwk))\n# 3. decode_complete with PyJWK, no algorithms\nprint('complete:', jwt.decode_complete(token, key=jwk))\n# 4. mismatched header alg -> InvalidAlgorithmError\nbad = b64({'typ':'JWT','alg':'HS384'}) + '.' + token.split('.')[1] + '.' + token.split('.')[2]\ntry:\n    jwt.decode(bad, key=jwk)\n    print('ERROR: should have raised')\nexcept jwt.InvalidAlgorithmError as e:\n    print('mismatch raises InvalidAlgorithmError:', e)\n# 5. string key without algorithms still raises\ntry:\n    jwt.decode(token, 'secret')\nexcept jwt.DecodeError as e:\n    print('string key still requires algorithms:', e)\n# 6. PyJWS level\nimport jwt.api_jws as api_jws\npayload = api_jws.decode(token.encode(), jwk)\nprint('jws-level decode:', payload)\n\""}}],"api":"openai-completions","provider":"harbor-endpoint","model":"z-ai/glm-5.3-flash","usage":{"input":581,"output":560,"cacheRead":40640,"cacheWrite":0,"reasoning":139,"totalTokens":41781,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1788494539762,"responseId":"gen-1788494539-EbOJNrkXPMxrzJMcJTAO","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"call_145bca9e7e5f4410a1e92162","toolName":"bash","content":[{"type":"text","text":"diff --git a/jwt/api_jwk.py b/jwt/api_jwk.py\nindex af74578..d35b955 100644\n--- a/jwt/api_jwk.py\n+++ b/jwt/api_jwk.py\n@@ -52,9 +52,11 @@ class PyJWK:\n         if not has_crypto and algorithm in requires_cryptography:\n             raise PyJWKError(f\"{algorithm} requires 'cryptography' to be installed.\")\n \n-        self.Algorithm = self._algorithms.get(algorithm)\n+        self.algorithm_name = algorithm\n \n-        if not self.Algorithm:\n+        if algorithm in self._algorithms:\n+            self.Algorithm = self._algorithms[algorithm]\n+        else:\n             raise PyJWKError(f\"Unable to find an algorithm for key: {self._jwk_data}\")\n \n         self.key = self.Algorithm.from_jwk(self._jwk_data)\ndiff --git a/jwt/api_jws.py b/jwt/api_jws.py\nindex fa6708c..5822ebf 100644\n--- a/jwt/api_jws.py\n+++ b/jwt/api_jws.py\n@@ -11,6 +11,7 @@ from .algorithms import (\n     has_crypto,\n     requires_cryptography,\n )\n+from .api_jwk import PyJWK\n from .exceptions import (\n     DecodeError,\n     InvalidAlgorithmError,\n@@ -172,7 +173,7 @@ class PyJWS:\n     def decode_complete(\n         self,\n         jwt: str | bytes,\n-        key: AllowedPublicKeys | str | bytes = \"\",\n+        key: AllowedPublicKeys | PyJWK | str | bytes = \"\",\n         algorithms: list[str] | None = None,\n         options: dict[str, Any] | None = None,\n         detached_payload: bytes | None = None,\n@@ -190,7 +191,7 @@ class PyJWS:\n         merged_options = {**self.options, **options}\n         verify_signature = merged_options[\"verify_signature\"]\n \n-        if verify_signature and not algorithms:\n+        if verify_signature and not algorithms and not isinstance(key, PyJWK):\n             raise DecodeError(\n                 'It is required that you pass in a value for the \"algorithms\" argument when calling decode().'\n             )\n@@ -217,7 +218,7 @@ class PyJWS:\n     def decode(\n         self,\n         jwt: str | bytes,\n-        key: AllowedPublicKeys | str | bytes = \"\",\n+        key: AllowedPublicKeys | PyJWK | str | bytes = \"\",\n         algorithms: list[str] | None = None,\n         options: dict[str, Any] | None = None,\n         detached_payload: bytes | None = None,\n@@ -289,9 +290,11 @@ class PyJWS:\n         signing_input: bytes,\n         header: dict[str, Any],\n         signature: bytes,\n-        key: AllowedPublicKeys | str | bytes = \"\",\n+        key: AllowedPublicKeys | PyJWK | str | bytes = \"\",\n         algorithms: list[str] | None = None,\n     ) -> None:\n+        if algorithms is None and isinstance(key, PyJWK):\n+            algorithms = [key.algorithm_name]\n         try:\n             alg = header[\"alg\"]\n         except KeyError:\n@@ -300,11 +303,15 @@ class PyJWS:\n         if not alg or (algorithms is not None and alg not in algorithms):\n             raise InvalidAlgorithmError(\"The specified alg value is not allowed\")\n \n-        try:\n-            alg_obj = self.get_algorithm_by_name(alg)\n-        except NotImplementedError as e:\n-            raise InvalidAlgorithmError(\"Algorithm not supported\") from e\n-        prepared_key = alg_obj.prepare_key(key)\n+        if isinstance(key, PyJWK):\n+            alg_obj = key.Algorithm\n+            prepared_key = key.key\n+        else:\n+            try:\n+                alg_obj = self.get_algorithm_by_name(alg)\n+            except NotImplementedError as e:\n+                raise InvalidAlgorithmError(\"Algorithm not supported\") from e\n+            prepared_key = alg_obj.prepare_key(key)\n \n         if not alg_obj.verify(signing_input, prepared_key, signature):\n             raise InvalidSignatureError(\"Signature verification failed\")\ndiff --git a/jwt/api_jwt.py b/jwt/api_jwt.py\nindex 87883bc..33bf355 100644\n--- a/jwt/api_jwt.py\n+++ b/jwt/api_jwt.py\n@@ -8,6 +8,7 @@ from datetime import datetime, timedelta, timezone\n from typing import TYPE_CHECKING, Any, List\n \n from . import api_jws\n+from .api_jwk import PyJWK\n from .exceptions import (\n     DecodeError,\n     ExpiredSignatureError,\n@@ -100,7 +101,7 @@ class PyJWT:\n     def decode_complete(\n         self,\n         jwt: str | bytes,\n-        key: AllowedPublicKeys | str | bytes = \"\",\n+        key: AllowedPublicKeys | PyJWK | str | bytes = \"\",\n         algorithms: list[str] | None = None,\n         options: dict[str, Any] | None = None,\n         # deprecated arg, remove in pyjwt3\n@@ -143,7 +144,7 @