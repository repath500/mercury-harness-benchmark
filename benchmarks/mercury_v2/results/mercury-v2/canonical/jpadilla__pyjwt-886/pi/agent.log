adilla/pyjwt+algorithms+PyJWK+fix\" | python3 -c \"\nimport json,sys\nd=json.load(sys.stdin)\nfor item in d.get('items',[])[:10]:\n    print(item['sha'][:10], item['commit']['message'].split(chr(10))[0])\n\""}}],"api":"openai-completions","provider":"harbor-endpoint","model":"z-ai/glm-5.3-flash","usage":{"input":3576,"output":1528,"cacheRead":25664,"cacheWrite":0,"reasoning":1335,"totalTokens":30768,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1788494302938,"responseId":"gen-1788494302-t51dF6FGr5SECqiuTec8","rawStopReason":"tool_calls"},"toolResults":[{"role":"toolResult","toolCallId":"call_39b1a449fbcf48d58ade63f6","toolName":"bash","content":[{"type":"text","text":"38:            \"verify_signature\": True,\n133:        options.setdefault(\"verify_signature\", True)\n138:        if verify is not None and verify != options[\"verify_signature\"]:\n141:                \"The equivalent is setting `verify_signature` to False in the `options` dictionary. \"\n147:        if not options[\"verify_signature\"]:\n===\n            options.setdefault(\"verify_iat\", False)\n            options.setdefault(\"verify_aud\", False)\n            options.setdefault(\"verify_iss\", False)\n            options.setdefault(\"verify_sub\", False)\n            options.setdefault(\"verify_jti\", False)\n\n        decoded = api_jws.decode_complete(\n            jwt,\n            key=key,\n            algorithms=algorithms,\n            options=options,\n            detached_payload=detached_payload,\n        )\n\n        payload = self._decode_payload(decoded)\n\n"}],"isError":false,"timestamp":1788494338584},{"role":"toolResult","toolCallId":"call_e9cda17bccae48738c730707","toolName":"bash","content":[{"type":"text","text":"1451d70eca fix: do not store reference to algorithms dict on PyJWK (#1143)\nbd9700cca7 Use PyJWK algorithm when encoding without explicit algorithm (#1148)\nab8176abe2 Decode with PyJWK (#886)\n95791b1759 Bundle