timestamp=2026-09-04T07:28:16.521Z level=INFO run=30e15862 message=evaluated permission=bash pattern="python - <<'EOF'\nimport jwt\nfrom jwt.api_jwk import PyJWK\nfrom jwt.exceptions import InvalidAlgorithmError, DecodeError\n\n# encode an HS256 token\ntoken = jwt.encode({\"hello\": \"world\"}, \"secret\", algorithm=\"HS256\")\nprint(\"token:\", token)\n\njwk = PyJWK({\"kty\": \"oct\", \"alg\": \"HS256\", \"k\": \"c2VjcmV0\"})\n\n# 1. algorithm_name attribute\nprint(\"algorithm_name:\", jwk.algorithm_name)\n\n# 2. decode with PyJWK, no algorithms -> uses JWK's algorithm\nprint(\"decode w/ jwk, no algs:\", jwt.decode(token, jwk))\nprint(\"decode_complete w/ jwk, no algs:\", jwt.decode_complete(token, key=jwk)[\"header\"])\n\n# 3. decode with PyJWK + explicit algorithms still works\nprint(\"decode w/ jwk + algs:\", jwt.decode(token, jwk, algorithms=[\"HS256\"]))\n\n# 4. mismatched algorithm in JWK rejected\njwk512 = PyJWK({\"kty\": \"oct\", \"alg\": \"HS512\", \"k\": \"c2VjcmV0\"})\ntry:\n    jwt.decode(token, jwk512)\nexcept InvalidAlgorithmError as e:\n    print(\"mismatch -> InvalidAlgorithmError:\", e)\n\n# 5. non-PyJWK without algorithms still errors\ntry:\n    jwt.decode(token, \"secret\")\nexcept DecodeError as e:\n    print(\"no jwk, no algs -> DecodeError:\", e)\nEOF" action.permission=* action.action=allow action.pattern=*
