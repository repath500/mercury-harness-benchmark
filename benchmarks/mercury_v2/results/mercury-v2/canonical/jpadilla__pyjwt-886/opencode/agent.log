{"type":"tool_use","timestamp":1788506645076,"sessionID":"ses_f94b3b3fdffeGjmu6JJ70nAmp6","part":{"type":"tool","tool":"read","callID":"call_506f4e80b6a04025906f92c7","state":{"status":"completed","input":{"filePath":"/testbed/docs/usage.rst","limit":110,"offset":270},"output":"<path>/testbed/docs/usage.rst</path>\n<type>file</type>\n<content>\n270: \n271: If you wish to require one or more claims to be present in the claimset, you can set the ``require`` parameter to include these claims.\n272: \n273: .. code-block:: pycon\n274: \n275:     >>> jwt.decode(encoded, options={\"require\": [\"exp\", \"iss\", \"sub\"]})\n276:     {'exp': 1371720939, 'iss': 'urn:foo', 'sub': '25c37522-f148-4cbf-8ee6-c4a9718dd0af'}\n277: \n278: Retrieve RSA signing keys from a JWKS endpoint\n279: ----------------------------------------------\n280: \n281: \n282: .. code-block:: pycon\n283: \n284:     >>> import jwt\n285:     >>> from jwt import PyJWKClient\n286:     >>> token = \"eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiIsImtpZCI6Ik5FRTFRVVJCT1RNNE16STVSa0ZETlRZeE9UVTFNRGcyT0Rnd1EwVXpNVGsxUWpZeVJrUkZRdyJ9.eyJpc3MiOiJodHRwczovL2Rldi04N2V2eDlydS5hdXRoMC5jb20vIiwic3ViIjoiYVc0Q2NhNzl4UmVMV1V6MGFFMkg2a0QwTzNjWEJWdENAY2xpZW50cyIsImF1ZCI6Imh0dHBzOi8vZXhwZW5zZXMtYXBpIiwiaWF0IjoxNTcyMDA2OTU0LCJleHAiOjE1NzIwMDY5NjQsImF6cCI6ImFXNENjYTc5eFJlTFdVejBhRTJINmtEME8zY1hCVnRDIiwiZ3R5IjoiY2xpZW50LWNyZWRlbnRpYWxzIn0.PUxE7xn52aTCohGiWoSdMBZGiYAHwE5FYie0Y1qUT68IHSTXwXVd6hn02HTah6epvHHVKA2FqcFZ4GGv5VTHEvYpeggiiZMgbxFrmTEY0csL6VNkX1eaJGcuehwQCRBKRLL3zKmA5IKGy5GeUnIbpPHLHDxr-GXvgFzsdsyWlVQvPX2xjeaQ217r2PtxDeqjlf66UYl6oY6AqNS8DH3iryCvIfCcybRZkc_hdy-6ZMoKT6Piijvk_aXdm7-QQqKJFHLuEqrVSOuBqqiNfVrG27QzAPuPOxvfXTVLXL2jek5meH6n-VWgrBdoMFH93QEszEDowDAEhQPHVs0xj7SIzA\"\n287:     >>> kid = \"NEE1QURBOTM4MzI5RkFDNTYxOTU1MDg2ODgwQ0UzMTk1QjYyRkRFQw\"\n288:     >>> url = \"https://dev-87evx9ru.auth0.com/.well-known/jwks.json\"\n289:     >>> optional_custom_headers = {\"User-agent\": \"custom-user-agent\"}\n290:     >>> jwks_client = PyJWKClient(url, headers=optional_custom_headers)\n291:     >>> signing_key = jwks_client.get_signing_key_from_jwt(token)\n292:     >>> data = jwt.decode(\n293:     ...     token,\n294:     ...     signing_key.key,\n295:     ...     algorithms=[\"RS256\"],\n296:     ...     audience=\"https://expenses-api\",\n297:     ...     options={\"verify_exp\": False},\n298:     ... )\n299:     >>> print(data)\n300:     {'iss': 'https://dev-87evx9ru.auth0.com/', 'sub': 'aW4Cca79xReLWUz0aE2H6kD0O3cXBVtC@clients', 'aud': 'https://expenses-api', 'iat': 1572006954, 'exp': 1572006964, 'azp': 'aW4Cca79xReLWUz0aE2H6kD0O3cXBVtC', 'gty': 'client-credentials'}\n301: \n302: OIDC Login Flow\n303: ---------------\n304: \n305: The following usage demonstrates an OIDC login flow using pyjwt. Further\n306: reading about the OIDC spec is recommended for implementers.\n307: \n308: In particular, this demonstrates validation of the ``at_hash`` claim.\n309: This claim relies on data from outside of the the JWT for validation. Methods\n310: are provided which support computation and validation of this claim, but it\n311: is not built into pyjwt.\n312: \n313: .. code-block:: python\n314: \n315:     import base64\n316:     import jwt\n317:     import requests\n318: \n319: \n320:     # Part 1: setup\n321:     # get the OIDC config and JWKs to use\n322: \n323:     # in OIDC, you must know your client_id (this is the OAuth 2.0 client_id)\n324:     client_id = ...\n325: \n326:     # example of fetching data from your OIDC server\n327:     # see: https://openid.net/specs/openid-connect-discovery-1_0.html#ProviderConfig\n328:     oidc_server = ...\n329:     oidc_config = requests.get(\n330:         f\"https://{oidc_server}/.well-known/openid-configuration\"\n331:     ).json()\n332:     signing_algos = oidc_config[\"id_token_signing_alg_values_supported\"]\n333: \n334:     # setup a PyJWKClient to get the appropriate signing key\n335:     jwks_client = jwt.PyJWKClient(oidc_config[\"jwks_uri\"])\n336: \n337: \n338:     # Part 2: login / authorization\n339:     # when a user completes an OIDC login flow, there will be a well-formed\n340:     # response object to parse/handle\n341: \n342:     # data from the login flow\n343:     # see: https://openid.net/specs/openid-connect-core-1_0.html#TokenResponse\n344:     token_response = ...\n345:     id_token = token_response[\"id_token\"]\n346:     access_token = token_response[\"access_token\"]\n347: \n348: \n349:     # Part 3: decode and validate at_hash\n350:     # after the login is complete, the id_token needs to be decoded\n351:     # this is the stage at which an OIDC client must verify the at_hash\n352: \n353:     # get signing_key from id_token\n354:     signing_key = jwks_client.get_signing_key_from_jwt(id_token)\n355: \n356:     # now, decode_complete to get payload + header\n357:     data = jwt.decode_complete(\n358:         id_token,\n359:         key=signing_key.key,\n360:         algorithms=signing_algos,\n361:         audience=client_id,\n362:     )\n363:     payload, header = data[\"payload\"], data[\"header\"]\n364: \n365:     # get the pyjwt algorithm object\n366:     alg_obj = jwt.get_algorithm_by_name(header[\"alg\"])\n367: \n368:     # compute at_hash, then validate / assert\n369:     digest = alg_obj.compute_hash_digest(access_token)\n370:     at_hash = base64.urlsafe_b64encode(digest[: (len(digest) // 2)]).rstrip(\"=\")\n371:     assert at_hash == payload[\"at_hash\"]\n\n(End of file - total 371 lines)\n</content>","metadata":{"preview":"\nIf you wish to require one or more claims to be present in the claimset, you can set the ``require`` parameter to include these claims.\n\n.. code-block:: pycon\n\n    >>> jwt.decode(encoded, options={\"require\": [\"exp\", \"iss\", \"sub\"]})\n    {'exp': 1371720939, 'iss': 'urn:foo', 'sub': '25c37522-f148-4cbf-8ee6-c4a9718dd0af'}\n\nRetrieve RSA signing keys from a JWKS endpoint\n----------------------------------------------\n\n\n.. code-block:: pycon\n\n    >>> import jwt\n    >>> from jwt import PyJWKClient\n    >>> token = \"eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiIsImtpZCI6Ik5FRTFRVVJCT1RNNE16STVSa0ZETlRZeE9UVTFNRGcyT0Rnd1EwVXpNVGsxUWpZeVJrUkZRdyJ9.eyJpc3MiOiJodHRwczovL2Rldi04N2V2eDlydS5hdXRoMC5jb20vIiwic3ViIjoiYVc0Q2NhNzl4UmVMV1V6MGFFMkg2a0QwTzNjWEJWdENAY2xpZW50cyIsImF1ZCI6Imh0dHBzOi8vZXhwZW5zZXMtYXBpIiwiaWF0IjoxNTcyMDA2OTU0LCJleHAiOjE1NzIwMDY5NjQsImF6cCI6ImFXNENjYTc5eFJlTFdVejBhRTJINmtEME8zY1hCVnRDIiwiZ3R5IjoiY2xpZW50LWNyZWRlbnRpYWxzIn0.PUxE7xn52aTCohGiWoSdMBZGiYAHwE5FYie0Y1qUT68IHSTXwXVd6hn02HTah6epvHHVKA2FqcFZ4GGv5VTHEvYpeggiiZMgbxFrmTEY0csL6VNkX1eaJGcuehwQCRBKRLL3zKmA5IKGy5GeUnIbpPHLHDxr-GXvgFzsdsyWlVQvPX2xjeaQ217r2PtxDeqjlf66UYl6oY6AqNS8DH3iryCvIfCcybRZkc_hdy-6ZMoKT6Piijvk_aXdm7-QQqKJFHLuEqrVSOuBqqiNfVrG27QzAPuPOxvfXTVLXL2jek5meH6n-VWgrBdoMFH93QEszEDowDAEhQPHVs0xj7SIzA\"\n    >>> kid = \"NEE1QURBOTM4MzI5RkFDNTYxOTU1MDg2ODgwQ0UzMTk1QjYyRkRFQw\"\n    >>> url = \"https://dev-87evx9ru.auth0.com/.well-known/jwks.json\"\n    >>> optional_custom_headers = {\"User-agent\": \"custom-user-agent\"}","truncated":false,"loaded":[],"display":{"type":"file","path":"/testbed/docs/usage.rst","text":"\nIf you wish to require one or more claims to be present in the claimset, you can set the ``require`` parameter to include these claims.\n\n.. code-block:: pycon\n\n    >>> jwt.decode(encoded, options={\"require\": [\"exp\", \"iss\", \"sub\"]})\n    {'exp': 1371720939, 'iss': 'urn:foo', 'sub': '25c37522-f148-4cbf-8ee6-c4a9718dd0af'}\n\nRetrieve RSA signing keys from a JWKS endpoint\n----------------------------------------------\n\n\n.. code-block:: pycon\n\n    >>> import jwt\n    >>> from jwt import PyJWKClient\n    >>> token = \"eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiIsImtpZCI6Ik5FRTFRVVJCT1RNNE16STVSa0ZETlRZeE9UVTFNRGcyT0Rnd1EwVXpNVGsxUWpZeVJrUkZRdyJ9.eyJpc3MiOiJodHRwczovL2Rldi04N2V2eDlydS5hdXRoMC5jb20vIiwic3ViIjoiYVc0Q2NhNzl4UmVMV1V6MGFFMkg2a0QwTzNjWEJWdENAY2xpZW50cyIsImF1ZCI6Imh0dHBzOi8vZXhwZW5zZXMtYXBpIiwiaWF0IjoxNTcyMDA2OTU0LCJleHAiOjE1NzIwMDY5NjQsImF6cCI6ImFXNENjYTc5eFJlTFdVejBhRTJINmtEME8zY1hCVnRDIiwiZ3R5IjoiY2xpZW50LWNyZWRlbnRpYWxzIn0.PUxE7xn52aTCohGiWoSdMBZGiYAHwE5FYie0Y1qUT68IHSTXwXVd6hn02HTah6epvHHVKA2FqcFZ4GGv5VTHEvYpeggiiZMgbxFrmTEY0csL6VNkX1eaJGcuehwQCRBKRLL3zKmA5IKGy5GeUnIbpPHLHDxr-GXvgFzsdsyWlVQvPX2xjeaQ217r2PtxDeqjlf66UYl6oY6AqNS8DH3iryCvIfCcybRZkc_hdy-6ZMoKT6Piijvk_aXdm7-QQqKJFHLuEqrVSOuBqqiNfVrG27QzAPuPOxvfXTVLXL2jek5meH6n-VWgrBdoMFH93QEszEDowDAEhQPHVs0xj7SIzA\"\n    >>> kid = \"NEE1QURBOTM4MzI5RkFDNTYxOTU1MDg2ODgwQ0UzMTk1QjYyRkRFQw\"\n    >>> url = \"https://dev-87evx9ru.auth0.com/.well-known/jwks.json\"\n    >>> optional_custom_headers = {\"User-agent\": \"custom-user-agent\"}\n    >>> jwks_client = PyJWKClient(url, headers=optional_custom_headers)\n    >>> signing_key = jwks_client.get_signing_key_from_jwt(token)\n    >>> data = jwt.decode(\n    ...     token,\n    ...     signing_key.key,\n    ...     algorithms=[\"RS256\"],\n    ...     audience=\"https://expenses-api\",\n    ...     options={\"verify_exp\": False},\n    ... )\n    >>> print(data)\n    {'iss': 'https://dev-87evx9ru.auth0.com/', 'sub': 'aW4Cca79xReLWUz0aE2H6kD0O3cXBVtC@clients', 'aud': 'https://expenses-api', 'iat': 1572006954, 'exp': 1572006964, 'azp': 'aW4Cca79xReLWUz0aE2H6kD0O3cXBVtC', 'gty': 'client-credentials'}\n\nOIDC Login Flow\n---------------\n\nThe following usage demonstrates an OIDC login flow using pyjwt. Further\nreading about the OIDC spec is recommended for implementers.\n\nIn particular, this demonstrates validation of the ``at_hash`` claim.\nThis claim relies on data from outside of the the JWT for validation. Methods\nare provided which support computation and validation of this claim, but it\nis not built into pyjwt.\n\n.. code-block:: python\n\n    import base64\n    import jwt\n    import requests\n\n\n    # Part 1: setup\n    # get the OIDC config and JWKs to use\n\n    # in OIDC, you must know your client_id (this is the OAuth 2.0 client_id)\n    client_id = ...\n\n    # example of fetching data from your OIDC server\n    # see: https://openid.net/specs/openid-connect-discovery-1_0.html#ProviderConfig\n    oidc_server = ...\n    oidc_config = requests.get(\n        f\"https://{oidc_server}/.well-known/openid-configuration\"\n    ).json()\n    signing_algos = oidc_config[\"id_token_signing_alg_values_supported\"]\n\n    # setup a PyJWKClient to get the appropriate signing key\n    jwks_client = jwt.PyJWKClient(oidc_config[\"jwks_uri\"])\n\n\n    # Part 2: login / authorization\n    # when a user completes an OIDC login flow, there will be a well-formed\n    # response object to parse/handle\n\n    # data from the login flow\n    # see: https://openid.net/specs/openid-connect-core-1_0.html#TokenResponse\n    token_response = ...\n    id_token = token_response[\"id_token\"]\n    access_token = token_response[\"access_token\"]\n\n\n    # Part 3: decode and validate at_hash\n    # after the login is complete, the id_token needs to be decoded\n    # this is the stage at which an OIDC client must verify the at_hash\n\n    # get signing_key from id_token\n    signing_key = jwks_client.get_signing_key_from_jwt(id_token)\n\n    # now, decode_complete to get payload + header\n    data = jwt.decode_complete(\n        id_token,\n        key=signing_key.key,\n        algorithms=signing_algos,\n        audience=client_id,\n    )\n    payload, header = data[\"payload\"], data[\"header\"]\n\n    # get the pyjwt algorithm object\n    alg_obj = jwt.get_algorithm_by_name(header[\"alg\"])\n\n    # compute at_hash, then validate / assert\n    digest = alg_obj.compute_hash_digest(access_token)\n    at_hash = base64.urlsafe_b64encode(digest[: (len(digest) // 2)]).rstrip(\"=\")\n    assert at_hash == payload[\"at_hash\"]","lineStart":270,"lineEnd":371,"totalLines":371,"truncated":false}},"title":"docs/usage.rst","time":{"start":1788506645017,"end":1788506645073}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Let me look at the docs/usage.rst around those lines, and also check the actual upstream PyJWT implementation of this feature (PR #826). Let me fetch the upstream commit for reference.\n\nActually, let me first check the tests to understand what tests might exist for this feature (or will be added). Let me check test_api_jwk.py and test_jwks_client.py.","format":"unknown","index":0}]}},"id":"prt_06b4da2130012AkV526vIbDNZ7","sessionID":"ses_f94b3b3fdffeGjmu6JJ70nAmp6","messageID":"msg_06b4d8e910010yfl5jfYfDMlmz"}}
