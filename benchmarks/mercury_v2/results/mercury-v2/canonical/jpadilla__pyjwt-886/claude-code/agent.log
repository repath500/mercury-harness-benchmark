{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a06b5a6fb27663a8d195c9","type":"tool_result","content":"1\timport json\n2\t\n3\timport pytest\n4\t\n5\tfrom jwt.algorithms import has_crypto\n6\tfrom jwt.api_jwk import PyJWK, PyJWKSet\n7\tfrom jwt.exceptions import InvalidKeyError, PyJWKError, PyJWKSetError\n8\t\n9\tfrom .utils import crypto_required, key_path, no_crypto_required\n10\t\n11\tif has_crypto:\n12\t    from jwt.algorithms import ECAlgorithm, HMACAlgorithm, OKPAlgorithm, RSAAlgorithm\n13\t\n14\t\n15\tclass TestPyJWK:\n16\t    @crypto_required\n17\t    def test_should_load_key_from_jwk_data_dict(self):\n18\t        algo = RSAAlgorithm(RSAAlgorithm.SHA256)\n19\t\n20\t        with open(key_path(\"jwk_rsa_pub.json\")) as keyfile:\n21\t            pub_key = algo.from_jwk(keyfile.read())\n22\t\n23\t        key_data_str = algo.to_jwk(pub_key)\n24\t        key_data = json.loads(key_data_str)\n25\t\n26\t        # TODO Should `to_jwk` set these?\n27\t        key_data[\"alg\"] = \"RS256\"\n28\t        key_data[\"use\"] = \"sig\"\n29\t        key_data[\"kid\"] = \"keyid-abc123\"\n30\t\n31\t        jwk = PyJWK.from_dict(key_data)\n32\t\n33\t        assert jwk.key_type == \"RSA\"\n34\t        assert jwk.key_id == \"keyid-abc123\"\n35\t        assert jwk.public_key_use == \"sig\"\n36\t\n37\t    @crypto_required\n38\t    def test_should_load_key_from_jwk_data_json_string(self):\n39\t        algo = RSAAlgorithm(RSAAlgorithm.SHA256)\n40\t\n41\t        with open(key_path(\"jwk_rsa_pub.json\")) as keyfile:\n42\t            pub_key = algo.from_jwk(keyfile.read())\n43\t\n44\t        key_data_str = algo.to_jwk(pub_key)\n45\t        key_data = json.loads(key_data_str)\n46\t\n47\t        # TODO Should `to_jwk` set these?\n48\t        key_data[\"alg\"] = \"RS256\"\n49\t        key_data[\"use\"] = \"sig\"\n50\t        key_data[\"kid\"] = \"keyid-abc123\"\n51\t\n52\t        jwk = PyJWK.from_json(json.dumps(key_data))\n53\t\n54\t        assert jwk.key_type == \"RSA\"\n55\t        assert jwk.key_id == \"keyid-abc123\"\n56\t        assert jwk.public_key_use == \"sig\"\n57\t\n58\t    @crypto_required\n59\t    def test_should_load_key_without_alg_from_dict(self):\n60\t        with open(key_path(\"jwk_rsa_pub.json\")) as keyfile:\n61\t            key_data = json.loads(keyfile.read())\n62\t\n63\t        jwk = PyJWK.from_dict(key_data)\n64\t\n65\t        assert jwk.key_type == \"RSA\"\n66\t        assert isinstance(jwk.Algorithm, RSAAlgorithm)\n67\t        assert jwk.Algorithm.hash_alg == RSAAlgorithm.SHA256\n68\t\n69\t    @crypto_required\n70\t    def test_should_load_key_from_dict_with_algorithm(self):\n71\t        with open(key_path(\"jwk_rsa_pub.json\")) as keyfile:\n72\t            key_data = json.loads(keyfile.read())\n73\t\n74\t        jwk = PyJWK.from_dict(key_data, algorithm=\"RS256\")\n75\t\n76\t        assert jwk.key_type == \"RSA\"\n77\t        assert isinstance(jwk.Algorithm, RSAAlgorithm)\n78\t        assert jwk.Algorithm.hash_alg == RSAAlgorithm.SHA256\n79\t\n80\t    @crypto_required\n81\t    def test_should_load_key_ec_p256_from_dict(self):\n82\t        with open(key_path(\"jwk_ec_pub_P-256.json\")) as keyfile:\n83\t            key_data = json.loads(keyfile.read())\n84\t\n85\t        jwk = PyJWK.from_dict(key_data)\n86\t\n87\t        assert jwk.key_type == \"EC\"\n88\t        assert isinstance(jwk.Algorithm, ECAlgorithm)\n89\t        assert jwk.Algorithm.hash_alg == ECAlgorithm.SHA256\n90\t\n91\t    @crypto_required\n92\t    def test_should_load_key_ec_p384_from_dict(self):\n93\t        with open(key_path(\"jwk_ec_pub_P-384.json\")) as keyfile:\n94\t            key_data = json.loads(keyfile.read())\n95\t\n96\t        jwk = PyJWK.from_dict(key_data)\n97\t\n98\t        assert jwk.key_type == \"EC\"\n99\t        assert isinstance(jwk.Algorithm, ECAlgorithm)\n100\t        assert jwk.Algorithm.hash_alg == ECAlgorithm.SHA384\n101\t\n102\t    @crypto_required\n103\t    def test_should_load_key_ec_p521_from_dict(self):\