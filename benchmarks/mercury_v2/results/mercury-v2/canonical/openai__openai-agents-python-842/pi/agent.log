tensions/models/litellm_model.py\n@@ -283,6 +283,10 @@ class LitellmModel(Model):\n             extra_kwargs[\"metadata\"] = model_settings.metadata\n         if model_settings.extra_body and isinstance(model_settings.extra_body, dict):\n             extra_kwargs.update(model_settings.extra_body)\n+        if model_settings.extra_args and isinstance(model_settings.extra_args, dict):\n+            extra_kwargs.update(\n+                {k: v for k, v in model_settings.extra_args.items() if v is not None}\n+            )\n \n         ret = await litellm.acompletion(\n             model=self.model,\ndiff --git a/src/agents/model_settings.py b/src/agents/model_settings.py\nindex 7b016c98..245af5c7 100644\n--- a/src/agents/model_settings.py\n+++ b/src/agents/model_settings.py\n@@ -73,6 +73,20 @@ class ModelSettings:\n     \"\"\"Additional headers to provide with the request.\n     Defaults to None if not provided.\"\"\"\n \n+    extra_args: dict[str, Any] | None = None\n+    \"\"\"Arbitrary keyword arguments to pass to the underlying model API call. This is an escape\n+    hatch that you can use to pass provider-specific parameters, even if they are not explicitly\n+    supported by this class.\n+\n+    ```python\n+    settings = ModelSettings(extra_args={\"some_provider_arg\": True})\n+    ```\n+\n+    Note: not all model providers support all parameters, so using unsupported parameters may\n+    cause errors. Please check the API documentation for the specific model and provider you\n+    are using. Any `None` values are filtered out before the request is made.\n+    \"\"\"\n+\n     def resolve(self, override: ModelSettings | None) -> ModelSettings:\n         \"\"\"Produce a new ModelSettings by overlaying any non-None values from the\n         override on top of this instance.\"\"\"\n@@ -84,6 +98,8 @@ class ModelSettings:\n             for field in fields(self)\n             if getattr(override, field.name) is not None\n         }\n+        if self.extra_args and over