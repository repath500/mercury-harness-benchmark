rt resolved.extra_args == {\"provider_arg\": True}\n    assert resolved.temperature == 0.5\n\n\ndef test_resolve_keeps_base_extra_args_when_override_has_none() -> None:\n    \"\"\"If the override has no extra_args, the base's extra_args should be kept.\"\"\"\n\n    base = ModelSettings(extra_args={\"provider_arg\": True})\n    override = ModelSettings(temperature=0.2)\n\n    resolved = base.resolve(override)\n\n    assert resolved.extra_args == {\"provider_arg\": True}\n    assert resolved.temperature == 0.2\n\n\ndef test_resolve_does_not_mutate_original_settings() -> None:\n    \"\"\"Resolving should produce new settings without mutating either input.\"\"\"\n\n    base = ModelSettings(extra_args={\"provider_arg\": True})\n    override = ModelSettings(extra_args={\"another\": 1})\n\n    resolved = base.resolve(override)\n\n    assert base.extra_args == {\"provider_arg\": True}\n    assert override.extra_args == {\"another\": 1}\n    assert resolved.extra_args == {\"provider_arg\": True, \"another\": 1}\n","path":"/testbed/tests/model_settings/test_resolve.py"}}],"api":"openai-completions","provider":"harbor-endpoint","model":"z-ai/glm-5.3-flash","usage":{"input":572,"output":776,"cacheRead":31616,"cacheWrite":0,"reasoning":38,"totalTokens":32964,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1788493844525,"responseId":"gen-1788493844-eZN9QYI57tkJGKYkMf4J","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"call_21e13f66115f4e2e97a00c9e","toolName":"edit","content":[{"type":"text","text":"Successfully replaced 1 block(s) in /testbed/tests/model_settings/test_serialization.py."}],"details":{"diff":"    ...\n 46         include_usage=False,\n 47         extra_query={\"foo\": \"bar\"},\n 48         extra_body={\"foo\": \"bar\"},\n 49         extra_headers={\"foo\": \"bar\"},\n+50         extra_args={\"foo\": \"bar\"},\n 50     )\n 51 \n 52     # Verify that every single field is set to a non-None val