  extra_args: dict[str, Any] | None = None\n+    \"\"\"Arbitrary keyword arguments to pass to the underlying model API call. This is an escape\n+    hatch that you can use to pass provider-specific parameters, even if they are not explicitly\n+    supported by this class.\n+\n+    ```python\n+    settings = ModelSettings(extra_args={\"some_provider_arg\": True})\n+    ```\n+\n+    Note: not all model providers support all parameters, so using unsupported parameters may\n+    cause errors. Please check the API documentation for the specific model and provider you\n+    are using. Any `None` values are filtered out before the request is made.\n+    \"\"\"\n+\n     def resolve(self, override: ModelSettings | None) -> ModelSettings:\n         \"\"\"Produce a new ModelSettings by overlaying any non-None values from the\n         override on top of this instance.\"\"\"\n@@ -84,6 +98,8 @@ class ModelSettings:\n             for field in fields(self)\n             if getattr(override, field.name) is not None\n         }\n+        if self.extra_args and override.extra_args:\n+            changes[\"extra_args\"] = {**self.extra_args, **override.extra_args}\n         return replace(self, **changes)\n \n     def to_json_dict(self) -> dict[str, Any]:\ndiff --git a/src/agents/models/openai_chatcompletions.py b/src/agents/models/openai_chatcompletions.py\nindex 6b4045d2..ec3ffa6a 100644\n--- a/src/agents/models/openai_chatcompletions.py\n+++ b/src/agents/models/openai_chatcompletions.py\n@@ -43,6 +43,10 @@ class OpenAIChatCompletionsModel(Model):\n     def _non_null_or_not_given(self, value: Any) -> Any:\n         return value if value is not None else NOT_GIVEN\n \n+    def _remove_not_given(self, value: dict[str, Any]) -> dict[str, Any]:\n+        \"\"\"Filter out NOT_GIVEN and None values to keep the API request clean.\"\"\"\n+        return {k: v for k, v in value.items() if v is not NOT_GIVEN and v is not None}\n+\n     async def get_response(\n         self,\n         system_instructions: str | None,\n@@ -281,6 +285,7 @@ class OpenAIChatCompletionsModel(Model):\n             extra_query=model_settings.extra_query,\n             extra_body=model_settings.extra_body,\n             metadata=self._non_null_or_not_given(model_settings.metadata),\n+            **self._remove_not_given(model_settings.extra_args or {}),\n         )\n \n         if isinstance(ret, ChatCompletion):\ndiff --git a/src/agents/models/openai_responses.py b/src/agents/models/openai_responses.py\nindex 86c8e69c..f7402e0e 100644\n--- a/src/agents/models/openai_responses.py\n+++ b/src/agents/models/openai_responses.py\n@@ -64,6 +64,10 @@ class OpenAIResponsesModel(Model):\n     def _non_null_or_not_given(self, value: Any) -> Any:\n         return value if value is not None else NOT_GIVEN\n \n+    def _remove_not_given(self, value: dict[str, Any]) -> dict[str, Any]:\n+        \"\"\"Filter out NOT_GIVEN and None values to keep the API request clean.\"\"\"\n+        return {k: v for k, v in value.items() if v is not NOT_GIVEN and v is not None}\n+\n     async def get_response(\n         self,\n         system_instructions: str | None,\n@@ -266,6 +270,7 @@ class OpenAIResponsesModel(Model):\n             store=self._non_null_or_not_given(model_settings.store),\n             reasoning=self._non_null_or_not_given(model_settings.reasoning),\n             metadata=self._non_null_or_not_given(model_settings.metadata),\n+            **self._remove_not_given(model_settings.extra_args or {}),\n         )\n \n     def _get_client(self) -> AsyncOpenAI:\ndiff --git a/tests/model_settings/test_serialization.py b/tests/model_settings/test_serialization.py\nindex d76a58d1..ab3af481 100644\n--- a/tests/model_settings/test_serialization.py\n+++ b/tests/model_settings/test_serialization.py\n@@ -47,6 +47,7 @@ def test_all_fields_serialization() -> None:\n         extra_query={\"foo\": \"bar\"},\n         extra_body={\"foo\": \"bar\"},\n         extra_headers={\"foo\": \"bar\"},\n+        extra