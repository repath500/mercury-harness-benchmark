del_settings.extra_args, dict):\n            extra_kwargs.update(model_settings.extra_args)\n```\n\nYes, I'm reasonably confident this is in current upstream. I'll add it.\n\n### Tests\n\n1. Update `tests/model_settings/test_serialization.py` — add `extra_args={\"foo\": \"bar\"}` to the all-fields test.\n\n2. New `tests/model_settings/test_resolve.py`? Hmm, or add resolve tests to test_serialization.py file? Cleaner: new file `tests/model_settings/test_resolve.py` with:\n\n```python\nfrom agents.model_settings import ModelSettings\n\n\ndef test_resolve_without_override_returns_same_settings() -> None:\n    base = ModelSettings(temperature=0.5)\n    assert base.resolve(None) is base\n\n\ndef test_resolve_overrides_non_none_values() -> None:\n    base = ModelSettings(temperature=0.5, top_p=0.9)\n    override = ModelSettings(temperature=0.2)\n    resolved = base.resolve(override)\n    assert resolved.temperature == 0.2\n    assert resolved.top_p == 0.9\n\n\ndef test_resolve_merges_extra_args_with_override_precedence() -> None:\n    base = ModelSettings(extra_args={\"provider_arg\": True, \"shared\": \"base\"})\n    override = ModelSettings(extra_args={\"shared\": \"override\", \"another\": 1})\n    resolved = base.resolve(override)\n    assert resolved.extra_args == {\"provider_arg\": True, \"shared\": \"override\", \"another\": 1}\n\n\ndef test_resolve_uses_override_extra_args_when_base_has_none() -> None:\n    base = ModelSettings(temperature=0.5)\n    override = ModelSettings(extra_args={\"provider_arg\": True})\n    resolved = base.resolve(override)\n    assert resolved.extra_args == {\"provider_arg\": True}\n\n\ndef test_resolve_keeps_base_extra_args_when_override_has_none() -> None:\n    base = ModelSettings(extra_args={\"provider_arg\": True})\n    override = ModelSettings(temperature=0.2)\n    resolved = base.resolve(override)\n    assert resolved.extra_args == {\"provider_arg\": True}\n    assert resolved.temperature == 0.2\n```\n\n3. New `tests/test_extra_arg