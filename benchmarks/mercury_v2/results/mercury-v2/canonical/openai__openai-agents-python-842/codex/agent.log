te(self, **kwargs):\n    51\t            nonlocal called_kwargs\n    52\t            called_kwargs = kwargs\n    53\t            message = ChatCompletionMessage(role=\"assistant\", content=\"Hello\")\n    54\t            choice = Choice(index=0, finish_reason=\"stop\", message=message)\n    55\t            return ChatCompletion(\n    56\t                id=\"resp-id\",\n    57\t                created=0,\n    58\t                model=\"fake\",\n    59\t                object=\"chat.completion\",\n    60\t                choices=[choice],\n    61\t                usage=None,\n    62\t            )\n    63\t\n    64\t    class DummyClient:\n    65\t        def __init__(self):\n    66\t            self.chat = type(\"_Chat\", (), {\"completions\": DummyCompletions()})()\n    67\t            self.base_url = \"https://api.openai.com\"\n    68\t\n    69\t    model = OpenAIChatCompletionsModel(model=\"gpt-4\", openai_client=DummyClient())  # type: ignore\n    70\t    await model.get_response(\n    71\t        system_instructions=None,\n    72\t        input=\"hi\",\n    73\t        model_settings=ModelSettings(extra_args={\"service_tier\": \"flex\", \"unused\": None}),\n    74\t        tools=[],\n    75\t        output_schema=None,\n    76\t        handoffs=[],\n    77\t        tracing=ModelTracing.DISABLED,\n    78\t        previous_response_id=None,\n    79\t    )\n    80\t    assert called_kwargs[\"service_tier\"] == \"flex\"\n    81\t    assert \"unused\" not in called_kwargs\n    82\t\n    83\t\n    84\tdef test_extra_args_are_merged_not_replaced():\n    85\t    base = ModelSettings(extra_args={\"base\": 1, \"shared\": \"base\"})\n    86\t    override = ModelSettings(extra_args={\"override\": 2, \"shared\": \"override\"})\n    87\t    assert base.resolve(override).extra_args == {\n    88\t        \"base\": 1,\n    89\t        \"override\": 2,\n    90\t        \"shared\": \"override\",\n    91\t    }\n    92\t\n    93\t\n    94\tdef test_none_extra_args_are_filtered():\n    95\t    assert ModelSettings(extra_args={\"foo\": None, \"bar\": 1}).get_extra_args() == {\"bar\": 1}\n    82\t\n    83\tWhen you want to further configure the model used for an agent, you can pass [`ModelSettings`][agents.models.interface.ModelSettings], which provides optional model configuration parameters such as temperature.\n    84\t\n    85\t```python\n    86\tfrom agents import Agent, ModelSettings\n    87\t\n    88\tenglish_agent = Agent(\n    89\t    name=\"English agent\",\n    90\t    instructions=\"You only speak English\",\n    91\t    model=\"gpt-4o\",\n    92\t    model_settings=ModelSettings(temperature=0.1),\n    93\t)\n    94\t```\n    95\t\n    96\tFor provider-specific parameters that are not part of `ModelSettings`, use `extra_args` as an escape\n    97\thatch. These keyword arguments are passed directly to the model provider's API. Since providers do\n    98\tnot all support the same parameters, unsupported values can cause API errors.\n    99\t\n   100\t```python\n   101\tmodel_settings = ModelSettings(\n   102\t    temperature=0.1,\n   103\t    extra_args={\"service_tier\": \"flex\"},\n   104\t)\n   105\t```\n   106\t\n   107\t## Common issues with using other LLM providers\n   108\t\n   109\t### Tracing client error 401\n   110\t\n   111\tIf you get errors related to tracing, this is because traces are uploaded to OpenAI servers, and you don't have an OpenAI API key. You have three options to resolve this:\n   112\t\n   113\t1. Disable tracing entirely: [`set_tracing_disabled(True)`][agents.set_tracing_disabled].\n   114\t2. Set an OpenAI key for tracing: [`set_tracing_export_api_key(...)`][agents.set_tracing_export_api_key]. This API key will only be used for uploading traces, and must be from [platform.openai.com](https://platform.openai.com/).\n   115\t3. Use a non-OpenAI trace processor. See the [tracing docs](../tracing.md#custom-tracing-processors).\n","exit_code":0,"status":"completed"}}
