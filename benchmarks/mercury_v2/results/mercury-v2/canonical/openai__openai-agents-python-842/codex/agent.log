n=\\\"stop\\\", message=message)\n            return ChatCompletion(\n                id=\\\"resp-id\\\",\n                created=0,\n                model=\\\"fake\\\",\n                object=\\\"chat.completion\\\",\n                choices=[choice],\n                usage=None,\n            )\n\n    class DummyClient:\n        def __init__(self):\n            self.chat = type(\\\"_Chat\\\", (), {\\\"completions\\\": DummyCompletions()})()\n            self.base_url = \\\"https://api.openai.com\\\"\n\n    model = OpenAIChatCompletionsModel(model=\\\"gpt-4\\\", openai_client=DummyClient())  # type: ignore\n    await model.get_response(\n        system_instructions=None,\n        input=\\\"hi\\\",\n        model_settings=ModelSettings(extra_args={\\\"service_tier\\\": \\\"flex\\\", \\\"unused\\\": None}),\n        tools=[],\n        output_schema=None,\n        handoffs=[],\n        tracing=ModelTracing.DISABLED,\n        previous_response_id=None,\n    )\n    assert called_kwargs[\\\"service_tier\\\"] == \\\"flex\\\"\n    assert \\\"unused\\\" not in called_kwargs\n\n\ndef test_extra_args_are_merged_not_replaced():\n    base = ModelSettings(extra_args={\\\"base\\\": 1, \\\"shared\\\": \\\"base\\\"})\n    override = ModelSettings(extra_args={\\\"override\\\": 2, \\\"shared\\\": \\\"override\\\"})\n    assert base.resolve(override).extra_args == {\n        \\\"base\\\": 1,\n        \\\"override\\\": 2,\n        \\\"shared\\\": \\\"override\\\",\n    }\n\n\ndef test_none_extra_args_are_filtered():\n    assert ModelSettings(extra_args={\\\"foo\\\": None, \\\"bar\\\": 1}).get_extra_args() == {\\\"bar\\\": 1}\nPY\napply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: tests/model_settings/test_serialization.py\n@@\n         extra_body={\\\"foo\\\": \\\"bar\\\"},\n         extra_headers={\\\"foo\\\": \\\"bar\\\"},\n+        extra_args={\\\"foo\\\": \\\"bar\\\"},\n*** End Patch\nPATCH\ncat > /tmp/docs_patch.py <<'PY'\nfrom pathlib import Path\npath = Path(\\\"docs/models/index.md\\\")\ntext = path.read_text()\nold = '''\"'```python\nfrom agents import Agent, ModelSettings\n\nenglish_agent = Agent(\n    name=\"English agent\",\n    instructions=\"You only speak English\",\n    model=\"gpt-4o\",\n    model_settings=ModelSettings(temperature=0.1),\n)\n```\n'\"'''\nnew = '''\"'```python\nfrom agents import Agent, ModelSettings\n\nenglish_agent = Agent(\n    name=\"English agent\",\n    instructions=\"You only speak English\",\n    model=\"gpt-4o\",\n    model_settings=ModelSettings(temperature=0.1),\n)\n```\n\nFor provider-specific parameters that are not part of `ModelSettings`, use `extra_args` as an escape\nhatch. These keyword arguments are passed directly to the model provider'\"'s API. Since providers do\nnot all support the same parameters, unsupported values can cause API errors.\n\n\"'```python\nmodel_settings = ModelSettings(\n    temperature=0.1,\n    extra_args={\"service_tier\": \"flex\"},\n)\n```\n'\"'''\nif text.count(old) \"'!= 1:\n    raise SystemExit(\"docs anchor not found\")\npath.write_text(text.replace(old, new))\nPY\npython /tmp/docs_patch.py\nuv run pytest -q tests/test_extra_headers.py tests/test_extra_args.py tests/model_settings/test_serialization.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
