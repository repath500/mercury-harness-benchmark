{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a06b2b9dac7e8381aea946","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport json\n4\timport time\n5\tfrom collections.abc import AsyncIterator\n6\tfrom typing import TYPE_CHECKING, Any, Literal, cast, overload\n7\t\n8\tfrom openai import NOT_GIVEN, AsyncOpenAI, AsyncStream\n9\tfrom openai.types import ChatModel\n10\tfrom openai.types.chat import ChatCompletion, ChatCompletionChunk\n11\tfrom openai.types.responses import Response\n12\tfrom openai.types.responses.response_usage import InputTokensDetails, OutputTokensDetails\n13\t\n14\tfrom .. import _debug\n15\tfrom ..agent_output import AgentOutputSchemaBase\n16\tfrom ..handoffs import Handoff\n17\tfrom ..items import ModelResponse, TResponseInputItem, TResponseStreamEvent\n18\tfrom ..logger import logger\n19\tfrom ..tool import Tool\n20\tfrom ..tracing import generation_span\n21\tfrom ..tracing.span_data import GenerationSpanData\n22\tfrom ..tracing.spans import Span\n23\tfrom ..usage import Usage\n24\tfrom .chatcmpl_converter import Converter\n25\tfrom .chatcmpl_helpers import HEADERS, ChatCmplHelpers\n26\tfrom .chatcmpl_stream_handler import ChatCmplStreamHandler\n27\tfrom .fake_id import FAKE_RESPONSES_ID\n28\tfrom .interface import Model, ModelTracing\n29\t\n30\tif TYPE_CHECKING:\n31\t    from ..model_settings import ModelSettings\n32\t\n33\t\n34\tclass OpenAIChatCompletionsModel(Model):\n35\t    def __init__(\n36\t        self,\n37\t        model: str | ChatModel,\n38\t        openai_client: AsyncOpenAI,\n39\t    ) -> None:\n40\t        self.model = model\n41\t        self._client = openai_client\n42\t\n43\t    def _non_null_or_not_given(self, value: Any) -> Any:\n44\t        return value if value is not None else NOT_GIVEN\n45\t\n46\t    async def get_response(\n47\t        self,\n48\t        system_instructions: str | None,\n49\t        input: str | list[TResponseInputItem],\n50\t        model_settings: ModelSettings,\n51\t        tools: list[Tool],\n52\t        output_schema: AgentOutputSchemaBase | None,\n53\t        handoffs: list[Handoff],\n54\t        tracing: ModelTracing,\n55\t        previous_response_id: str | None,\n56\t    ) -> ModelResponse:\n57\t        with generation_span(\n58\t            model=str(self.model),\n59\t            model_config=model_settings.to_json_dict() | {\"base_url\": str(self._client.base_url)},\n60\t            disabled=tracing.is_disabled(),\n61\t        ) as span_generation:\n62\t            response = await self._fetch_response(\n63\t                system_instructions,\n64\t                input,\n65\t                model_settings,\n66\t                tools,\n67\t                output_schema,\n68\t                handoffs,\n69\t                span_generation,\n70\t                tracing,\n71\t                stream=False,\n72\t            )\n73\t\n74\t            first_choice = response.choices[0]\n75\t            message = first_choice.message\n76\t\n77\t            if _debug.DONT_LOG_MODEL_DATA:\n78\t                logger.debug(\"Received model response\")\n79\t            else:\n80\t                if message is not None:\n81\t                    logger.debug(\n82\t                        \"LLM resp:\\n%s\\n\",\n83\t                        json.dumps(message.model_dump(), indent=2),\n84\t                    )\n85\t                else:\n86\t                    logger.debug(\n87\t                        \"LLM resp had no message. finish_reason: %s\",\n88\t                        first_choice.finish_reason,\n89\t                    )\n90\t\n91\t            usage = (\n92\t                Usage(\n93\t                    requests=1,\n94\t                    input_tokens=response.usage.prompt_tokens,\n95\t                    output_tokens=response.usage.completion_tokens,\n96\t                    total_tokens=response.usage.total_tokens,\n97\t                    input_tokens_details=InputTokensDetails(\n98\t                        cached_tokens=getattr(\n99\t                            response.usage.prompt_tokens_details, \"cached_tokens\", 0\n100\t                        )\n101\t                        or 0,\n102\t                    ),\n103\t                    output_tokens_details=OutputTokensDetails(\n104\t                        reasoning_tokens=getattr(\n105\t                            response.usage.completion_tokens_details, \"reasoning_tokens\", 0\n106\t                        )\n107\t                        or 0,\n108\t                    ),\n109\t                )\n110\t                if response.usage\n111\t                else Usage()\n112\t            )\n113\t            if tracing.include_data():\n114\t                span_generation.span_data.output = (\n115\t                    [message.model_dump()] if message is not None else []\n116\t                )\n117\t            span_generation.span_data.usage = {\n118\t                \"input_tokens\": usage.input_tokens,\n119\t                \"output_tokens\": usage.output_tokens,\n120\t            }\n121\t\n122\t            items = Converter.message_to_output_items(message) if message is not None else []\n123\t\n124\t            return ModelResponse(\n125\t                output=items,\n126\t                usage=usage,\n127\t                response_id=None,\n128\t            )\n129\t\n130\t    async def stream_response(\n131\t        self,\n132\t        system_instructions: str | None,\n133\t        input: str | list[TResponseInputItem],\n134\t        model_settings: ModelSettings,\n135\t        tools: list[Tool],\n136\t        output_schema: AgentOutputSchemaBase | None,\n137\t        handoffs: list[Handoff],\n138\t        tracing: ModelTracing,\n139\t        *,\n140\t        previous_response_id: str | None,\n141\t    ) -> AsyncIterator[TResponseStreamEvent]:\n142\t        \"\"\"\n143\t        Yields a partial message as it is generated, as well as the usage information.\n144\t        \"\"\"\n145\t        with generation_span(\n146\t            model=str(self.model),\n147\t            model_config=model_settings.to_json_dict() | {\"base_url\": str(self._client.base_url)},\n148\t            disabled=tracing.is_disabled(),\n149\t        ) as span_generation:\n150\t            response, stream = await self._fetch_response(\n151\t                system_instructions,\n152\t                input,\n153\t                model_settings,\n154\t                tools,\n155\t                output_schema,\n156\t                handoffs,\n157\t                span_generation,\n158\t                tracing,\n159\t                stream=True,\n160\t            )\n161\t\n162\t            final_response: Response | None = None\n163\t            async for chunk in ChatCmplStreamHandler.handle_stream(response, stream):\n164\t                yield chunk\n165\t\n166\t                if chunk.type == \"response.completed\":\n167\t                    final_response = chunk.response\n168\t\n169\t            if tracing.include_data() and final_response:\n170\t                span_generation.span_data.output = [final_response.model_dump()]\n171\t\n172\t            if final_response and final_response.usage:\n173\t                span_generation.span_data.usage = {\n174\t                    \"input_tokens\": final_response.usage.input_tokens,\n175\t                    \"output_tokens\": final_response.usage.output_tokens,\n176\t                }\n177\t\n178\t    @overload\n179\t    async def _fetch_response(\n180\t        self,\n181\t        system_instructions: str | None,\n182\t        input: str | list[TResponseInputItem],\n183\t        model_settings: ModelSettings,\n184\t        tools: list[Tool],\n185\t        output_schema: AgentOutputSchemaBase | None,\n186\t        handoffs: list[Handoff],\n187\t        span: Span[GenerationSpanData],\n188\t        tracing: ModelTracing,\n189\t        stream: Literal[True],\n190\t    ) -> tuple[Response, AsyncStream[ChatCompletionChunk]]: ...\n191\t\n192\t    @overload\n193\t    async def _fetch_response(\n194\t        self,\n195\t        system_instructions: str | None,\n196\t        input: str | list[TResponseInputItem],\n197\t        model_settings: ModelSettings,\n198\t        tools: list[Tool],\n199\t        output_schema: AgentOutputSchemaBase | None,\n200\t        handoffs: list[Handoff],\n201\t        span: Span[GenerationSpanData],\n202\t        tracing: ModelTracing,\n203\t        stream: Literal[False],\n204\t    ) -> ChatCompletion: ...\n205\t\n206\t    async def _fetch_response(\n207\t        self,\n208\t        system_instructions: str | None,\n209\t        input: str | list[TResponseInputItem],\n210\t        model_settings: ModelSettings,\n211\t        tools: list[Tool],\n212\t        output_schema: AgentOutputSchemaBase | None,\n213\t        handoffs: list[Handoff],\n214\t        span: Span[GenerationSpanData],\n215\t        tracing: ModelTracing,\n216\t        stream: bool = False,\n217\t    ) -> ChatCompletion | tuple[Response, AsyncStream[ChatCompletionChunk]]:\n218\t        converted_messages = Converter.items_to_messages(input)\n219\t\n220\t        if system_instructions:\n221\t            converted_messages.insert(\n222\t                0,\n223\t                {\n224\t                    \"content\": system_instructions,\n225\t                    \"role\": \"system\",\n226\t                },\n227\t            )\n228\t        if tracing.include_data():\n229\t            span.span_data.input = converted_messages\n230\t\n231\t        parallel_tool_calls = (\n232\t            True\n233\t            if model_settings.parallel_tool_calls and tools and len(tools) > 0\n234\t            else False\n235\t            if model_settings.parallel_tool_calls is False\n236\t            else NOT_GIVEN\n237\t        )\n238\t        tool_choice = Converter.convert_tool_choice(model_settings.tool_choice)\n239\t        response_format = Converter.convert_response_format(output_schema)\n240\t\n241\t        converted_tools = [Converter.tool_to_openai(tool) for tool in tools] if tools else []\n242\t\n243\t        for handoff in handoffs:\n244\t            converted_tools.append(Converter.convert_handoff_tool(handoff))\n245\t\n246\t        if _debug.DONT_LOG_MODEL_DATA:\n247\t            logger.debug(\"Calling LLM\")\n248\t        else:\n249\t            logger.debug(\n250\t                f\"{json.dumps(converted_messages, indent=2)}\\n\"\n251\t                f\"Tools:\\n{json.dumps(converted_tools, indent=2)}\\n\"\n252\t                f\"Stream: {stream}\\n\"\n253\t                f\"Tool choice: {tool_choice}\\n\"\n254\t                f\"Response format: {response_format}\\n\"\n255\t            )\n256\t\n257\t        reasoning_effort = model_settings.reasoning.effort if model_settings.reasoning else None\n258\t        store = ChatCmplHelpers.get_store_param(self._get_client(), model_settings)\n259\t\n260\t        stream_options = ChatCmplHelpers.get_stream_options_param(\n261\t            self._get_client(), model_settings, stream=stream\n262\t        )\n263\t\n264\t        ret = await self._get_client().chat.completions.create(\n265\t            model=self.model,\n266\t            messages=converted_messages,\n267\t            tools=converted_tools or NOT_GIVEN,\n268\t            temperature=self._non_null_or_not_given(model_settings.temperature),\n269\t            top_p=self._non_null_or_not_given(model_settings.top_p),\n270\t            frequency_penalty=self._non_null_or_not_given(model_settings.frequency_penalty),\n271\t            presence_penalty=self._non_null_or_not_given(model_settings.presence_penalty),\n272\t            max_tokens=self._non_null_or_not_given(model_settings.max_tokens),\n273\t            tool_choice=tool_choice,\n274\t            response_format=response_format,\n275\t            parallel_tool_calls=parallel_tool_calls,\n276\t            stream=stream,\n277\t            stream_options=self._non_null_or_not_given(stream_options),\n278\t          