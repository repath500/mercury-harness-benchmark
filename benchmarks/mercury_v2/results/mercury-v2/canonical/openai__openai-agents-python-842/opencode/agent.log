{"type":"tool_use","timestamp":1788505035432,"sessionID":"ses_f94ccbbd8ffex6r1tm6ai3wHOS","part":{"type":"tool","tool":"read","callID":"call_2a127882747f45b3b1663b1d","state":{"status":"completed","input":{"filePath":"/testbed/tests/test_openai_chatcompletions.py","limit":70,"offset":229},"output":"<path>/testbed/tests/test_openai_chatcompletions.py</path>\n<type>file</type>\n<content>\n229: async def test_fetch_response_non_stream(monkeypatch) -> None:\n230:     \"\"\"\n231:     Verify that `_fetch_response` builds the correct OpenAI API call when not\n232:     streaming and returns the ChatCompletion object directly. We supply a\n233:     dummy ChatCompletion through a stubbed OpenAI client and inspect the\n234:     captured kwargs.\n235:     \"\"\"\n236: \n237:     # Dummy completions to record kwargs\n238:     class DummyCompletions:\n239:         def __init__(self) -> None:\n240:             self.kwargs: dict[str, Any] = {}\n241: \n242:         async def create(self, **kwargs: Any) -> Any:\n243:             self.kwargs = kwargs\n244:             return chat\n245: \n246:     class DummyClient:\n247:         def __init__(self, completions: DummyCompletions) -> None:\n248:             self.chat = type(\"_Chat\", (), {\"completions\": completions})()\n249:             self.base_url = httpx.URL(\"http://fake\")\n250: \n251:     msg = ChatCompletionMessage(role=\"assistant\", content=\"ignored\")\n252:     choice = Choice(index=0, finish_reason=\"stop\", message=msg)\n253:     chat = ChatCompletion(\n254:         id=\"resp-id\",\n255:         created=0,\n256:         model=\"fake\",\n257:         object=\"chat.completion\",\n258:         choices=[choice],\n259:     )\n260:     completions = DummyCompletions()\n261:     dummy_client = DummyClient(completions)\n262:     model = OpenAIChatCompletionsModel(model=\"gpt-4\", openai_client=dummy_client)  # type: ignore\n263:     # Execute the private fetch with a system instruction and simple string input.\n264:     with generation_span(disabled=True) as span:\n265:         result = await model._fetch_response(\n266:             system_instructions=\"sys\",\n267:             input=\"hi\",\n268:             model_settings=ModelSettings(),\n269:             tools=[],\n270:             output_schema=None,\n271:             handoffs=[],\n272:             span=span,\n273:             tracing=ModelTracing.DISABLED,\n274:             stream=False,\n275:         )\n276:     assert result is chat\n277:     # Ensure expected args were passed through to OpenAI client.\n278:     kwargs = completions.kwargs\n279:     assert kwargs[\"stream\"] is False\n280:     assert kwargs[\"store\"] is NOT_GIVEN\n281:     assert kwargs[\"model\"] == \"gpt-4\"\n282:     assert kwargs[\"messages\"][0][\"role\"] == \"system\"\n283:     assert kwargs[\"messages\"][0][\"content\"] == \"sys\"\n284:     assert kwargs[\"messages\"][1][\"role\"] == \"user\"\n285:     # Defaults for optional fields become the NOT_GIVEN sentinel\n286:     assert kwargs[\"tools\"] is NOT_GIVEN\n287:     assert kwargs[\"tool_choice\"] is NOT_GIVEN\n288:     assert kwargs[\"response_format\"] is NOT_GIVEN\n289:     assert kwargs[\"stream_options\"] is NOT_GIVEN\n290: \n291: \n292: @pytest.mark.asyncio\n293: async def test_fetch_response_stream(monkeypatch) -> None:\n294:     \"\"\"\n295:     When `stream=True`, `_fetch_response` should return a bare `Response`\n296:     object along with the underlying async stream. The OpenAI client call\n297:     should include `stream_options` to request usage-delimited chunks.\n298:     \"\"\"\n\n(Showing lines 229-298 of 379. Use offset=299 to continue.)\n</content>","metadata":{"preview":"async def test_fetch_response_non_stream(monkeypatch) -> None:\n    \"\"\"\n    Verify that `_fetch_response` builds the correct OpenAI API call when not\n    streaming and returns the ChatCompletion object directly. We supply a\n    dummy ChatCompletion through a stubbed OpenAI client and inspect the\n    captured kwargs.\n    \"\"\"\n\n    # Dummy completions to record kwargs\n    class DummyCompletions:\n        def __init__(self) -> None:\n            self.kwargs: dict[str, Any] = {}\n\n        async def create(self, **kwargs: Any) -> Any:\n            self.kwargs = kwargs\n            return chat\n\n    class DummyClient:\n        def __init__(self, completions: DummyCompletions) -> None:\n            self.chat = type(\"_Chat\", (), {\"completions\": completions})()","truncated":true,"loaded":[],"display":{"type":"file","path":"/testbed/tests/test_openai_chatcompletions.py","text":"async def test_fetch_response_non_stream(monkeypatch) -> None:\n    \"\"\"\n    Verify that `_fetch_response` builds the correct OpenAI API call when not\n    streaming and returns the ChatCompletion object directly. We supply a\n    dummy ChatCompletion through a stubbed OpenAI client and inspect the\n    captured kwargs.\n    \"\"\"\n\n    # Dummy completions to record kwargs\n    class DummyCompletions:\n        def __init__(self) -> None:\n            self.kwargs: dict[str, Any] = {}\n\n        async def create(self, **kwargs: Any) -> Any:\n            self.kwargs = kwargs\n            return chat\n\n    class DummyClient:\n        def __init__(self, completions: DummyCompletions) -> None:\n            self.chat = type(\"_Chat\", (), {\"completions\": completions})()\n            self.base_url = httpx.URL(\"http://fake\")\n\n    msg = ChatCompletionMessage(role=\"assistant\", content=\"ignored\")\n    choice = Choice(index=0, finish_reason=\"stop\", message=msg)\n    chat = ChatCompletion(\n        id=\"resp-id\",\n        created=0,\n        model=\"fake\",\n        object=\"chat.completion\",\n        choices=[choice],\n    )\n    completions = DummyCompletions()\n    dummy_client = DummyClient(completions)\n    model = OpenAIChatCompletionsModel(model=\"gpt-4\", openai_client=dummy_client)  # type: ignore\n    # Execute the private fetch with a system instruction and simple string input.\n    with generation_span(disabled=True) as span:\n        result = await model._fetch_response(\n            system_instructions=\"sys\",\n            input=\"hi\",\n            model_settings=ModelSettings(),\n            tools=[],\n            output_schema=None,\n            handoffs=[],\n            span=span,\n            tracing=ModelTracing.DISABLED,\n            stream=False,\n        )\n    assert result is chat\n    # Ensure expected args were passed through to OpenAI client.\n    kwargs = completions.kwargs\n    assert kwargs[\"stream\"] is False\n    assert kwargs[\"store\"] is NOT_GIVEN\n    assert kwargs[\"model\"] == \"gpt-4\"\n    assert kwargs[\"messages\"][0][\"role\"] == \"system\"\n    assert kwargs[\"messages\"][0][\"content\"] == \"sys\"\n    assert kwargs[\"messages\"][1][\"role\"] == \"user\"\n    # Defaults for optional fields become the NOT_GIVEN sentinel\n    assert kwargs[\"tools\"] is NOT_GIVEN\n    assert kwargs[\"tool_choice\"] is NOT_GIVEN\n    assert kwargs[\"response_format\"] is NOT_GIVEN\n    assert kwargs[\"stream_options\"] is NOT_GIVEN\n\n\n@pytest.mark.asyncio\nasync def test_fetch_response_stream(monkeypatch) -> None:\n    \"\"\"\n    When `stream=True`, `_fetch_response` should return a bare `Response`\n    object along with the underlying async stream. The OpenAI client call\n    should include `stream_options` to request usage-delimited chunks.\n    \"\"\"","lineStart":229,"lineEnd":298,"totalLines":379,"truncated":true}},"title":"tests/test_openai_chatcompletions.py","time":{"start":1788505035387,"end":1788505035426}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_06b351275001ge61zbCErKxDim","sessionID":"ses_f94ccbbd8ffex6r1tm6ai3wHOS","messageID":"msg_06b350acb001ANIKyo9dkGwFqM"}}
