onse.usage.prompt_tokens,\n95:                     output_tokens=response.usage.completion_tokens,\n96:                     total_tokens=response.usage.total_tokens,\n97:                     input_tokens_details=InputTokensDetails(\n98:                         cached_tokens=getattr(\n99:                             response.usage.prompt_tokens_details, \"cached_tokens\", 0\n100:                         )\n101:                         or 0,\n102:                     ),\n103:                     output_tokens_details=OutputTokensDetails(\n104:                         reasoning_tokens=getattr(\n105:                             response.usage.completion_tokens_details, \"reasoning_tokens\", 0\n106:                         )\n107:                         or 0,\n108:                     ),\n109:                 )\n110:                 if response.usage\n111:                 else Usage()\n112:             )\n113:             if tracing.include_data():\n114:                 span_generation.span_data.output = (\n115:                     [message.model_dump()] if message is not None else []\n116:                 )\n117:             span_generation.span_data.usage = {\n118:                 \"input_tokens\": usage.input_tokens,\n119:                 \"output_tokens\": usage.output_tokens,\n120:             }\n121: \n122:             items = Converter.message_to_output_items(message) if message is not None else []\n123: \n124:             return ModelResponse(\n125:                 output=items,\n126:                 usage=usage,\n127:                 response_id=None,\n128:             )\n129: \n130:     async def stream_response(\n131:         self,\n132:         system_instructions: str | None,\n133:         input: str | list[TResponseInputItem],\n134:         model_settings: ModelSettings,\n135:         tools: list[Tool],\n136:         output_schema: AgentOutputSchemaBase | None,\n137:         handoffs: list[Handoff],\n138:         tracing: ModelTracing,\n139:         *,\n14