{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a0689604137540afa7bec6","type":"tool_result","content":"diff --git a/dspy/primitives/tool.py b/dspy/primitives/tool.py\nindex 94817397e..9c8e388ee 100644\n--- a/dspy/primitives/tool.py\n+++ b/dspy/primitives/tool.py\n@@ -57,6 +57,7 @@ class Tool:\n         self.args = args\n         self.arg_types = arg_types\n         self.arg_desc = arg_desc\n+        self.has_kwargs = False\n \n         self._parse_function(func, arg_desc)\n \n@@ -129,6 +130,7 @@ class Tool:\n         self.desc = self.desc or desc\n         self.args = self.args or args\n         self.arg_types = self.arg_types or arg_types\n+        self.has_kwargs = any([param.kind == param.VAR_KEYWORD for param in sig.parameters.values()])\n \n     def _parse_args(self, **kwargs):\n         parsed_kwargs = {}\n@@ -147,6 +149,9 @@ class Tool:\n     def __call__(self, **kwargs):\n         for k, v in kwargs.items():\n             if k not in self.args:\n+                if self.has_kwargs:\n+                    # If the tool has kwargs, skip validation for unknown args\n+                    continue\n                 raise ValueError(f\"Arg {k} is not in the tool's args.\")\n             try:\n                 instance = v.model_dump() if hasattr(v, \"model_dump\") else v\ndiff --git a/tests/primitives/test_tool.py b/tests/primitives/test_tool.py\nindex ce6b3f441..02d0eb4fa 100644\n--- a/tests/primitives/test_tool.py\n+++ b/tests/primitives/test_tool.py\n@@ -193,3 +193,28 @@ def test_tool_call_parses_nested_list_of_pydantic_model():\n \n     result = tool(**args)\n     assert result == [[DummyModel(field1=\"hello\", field2=123)]]\n+\n+\n+def test_tool_call_kwarg():\n+    def fn(x: int, **kwargs):\n+        return kwargs\n+    tool = Tool(fn)\n+\n+    assert tool(x=1, y=2, z=3) == {\"y\": 2, \"z\": 3}\n+\n+\n+def test_tool_call_kwargs_with_defaults():\n+    def product_fn(c: int = 1, d: int = 1, **kwargs):\n+        return c * d\n+\n+    tool = Tool(product_fn)\n+    assert tool(c=5, d=4) == 20\n+    # Defaults apply when the args are omitted, and arbitrary extra kwargs are passed through.\n+    assert tool() == 1\n+    assert tool(c=5, d=4, extra=\"ignored\") == 20\n+\n+\n+def test_tool_without_kwargs_rejects_unknown_args():\n+    tool = Tool(dummy_function)\n+    with pytest.raises(ValueError, match=\"Arg z is not in the tool's args.\"):\n+        tool(x=1, y=\"hello\", z=3)","is_error":false}]},"parent_tool_use_id":null,"session_id":"919e1a27-296c-4b52-a99d-24b9ce88abc3","uuid":"5aa7517e-db01-4f75-bea2-139ae8b8ad43","timestamp":"2026-09-03T18:44:17.481Z","tool_use_result":{"stdout":"diff --git a/dspy/primitives/tool.py b/dspy/primitives/tool.py\nindex 94817397e..9c8e388ee 100644\n--- a/dspy/primitives/tool.py\n+++ b/dspy/primitives/tool.py\n@@ -57,6 +57,7 @@ class Tool:\n         self.args = args\n         self.arg_types = arg_types\n         self.arg_desc = arg_desc\n+        self.has_kwargs = False\n \n         self._parse_function(func, arg_desc)\n \n@@ -129,6 +130,7 @@ class Tool:\n         self.desc = self.desc or desc\n         self.args = self.args or args\n         self.arg_types = self.arg_types or arg_types\n+        self.has_kwargs = any([param.kind == param.VAR_KEYWORD for param in sig.parameters.values()])\n \n     def _parse_args(self, **kwargs):\n         parsed_kwargs = {}\n@@ -147,6 +149,9 @@ class Tool:\n     def __call__(self, **kwargs):\n         for k, v in kwargs.items():\n             if k not in self.args:\n+                if self.has_kwargs:\n+                    # If the tool has kwargs, skip validation for unknown args\n+                    continue\n                 raise ValueError(f\"Arg {k} is not in the tool's args.\")\n             try:\n                 instance = v.model_dump() if hasattr(v, \"model_dump\") else v\ndiff --git a/tests/primitives/test_tool.py b/tests/primitives/test_tool.py\nindex ce6b3f441..02d0eb4fa 100644\n--- a/tests/primitives/test_tool.py\n++