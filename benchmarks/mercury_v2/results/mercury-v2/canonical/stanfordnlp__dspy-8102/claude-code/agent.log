{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_25243d8905684368b41b2858","type":"tool_result","content":"1\timport inspect\n2\tfrom typing import Any, Callable, Optional, get_origin, get_type_hints\n3\t\n4\tfrom jsonschema import ValidationError, validate\n5\tfrom pydantic import BaseModel, TypeAdapter, create_model\n6\t\n7\tfrom dspy.utils.callback import with_callbacks\n8\t\n9\t\n10\tclass Tool:\n11\t    \"\"\"Tool class.\n12\t\n13\t    This class is used to simplify the creation of tools for tool calling (function calling) in LLMs. Only supports\n14\t    functions for now.\n15\t    \"\"\"\n16\t\n17\t    def __init__(\n18\t        self,\n19\t        func: Callable,\n20\t        name: Optional[str] = None,\n21\t        desc: Optional[str] = None,\n22\t        args: Optional[dict[str, Any]] = None,\n23\t        arg_types: Optional[dict[str, Any]] = None,\n24\t        arg_desc: Optional[dict[str, str]] = None,\n25\t    ):\n26\t        \"\"\"Initialize the Tool class.\n27\t\n28\t        Users can choose to specify the `name`, `desc`, `args`, and `arg_types`, or let the `dspy.Tool`\n29\t        automatically infer the values from the function. For values that are specified by the user, automatic inference\n30\t        will not be performed on them.\n31\t\n32\t        Args:\n33\t            func (Callable): The actual function that is being wrapped by the tool.\n34\t            name (Optional[str], optional): The name of the tool. Defaults to None.\n35\t            desc (Optional[str], optional): The description of the tool. Defaults to None.\n36\t            args (Optional[dict[str, Any]], optional): The args and their schema of the tool, represented as a\n37\t                dictionary from arg name to arg's json schema. Defaults to None.\n38\t            arg_types (Optional[dict[str, Any]], optional): The argument types of the tool, represented as a dictionary\n39\t                from arg name to the type of the argument. Defaults to None.\n40\t            arg_desc (Optional[dict[str, str]], optional): Descriptions for each arg, represented as a\n41\t                dictionary from arg name to description string. Defaults to None.\n42\t\n43\t        Example:\n44\t\n45\t        ```python\n46\t        def foo(x: int, y: str = \"hello\"):\n47\t            return str(x) + y\n48\t\n49\t        tool = Tool(foo)\n50\t        print(tool.args)\n51\t        # Expected output: {'x': {'type': 'integer'}, 'y': {'type': 'string', 'default': 'hello'}}\n52\t        ```\n53\t        \"\"\"\n54\t        self.func = func\n55\t        self.name = name\n56\t        self.desc = desc\n57\t        self.args = args\n58\t        self.arg_types = arg_types\n59\t        self.arg_desc = arg_desc\n60\t\n61\t        self._parse_function(func, arg_desc)\n62\t\n63\t    def _resolve_pydantic_schema(self, model: type[BaseModel]) -> dict:\n64\t        \"\"\"Recursively resolve Pydantic model schema, expanding all references.\"\"\"\n65\t        schema = model.model_json_schema()\n66\t\n67\t        # If there are no definitions to resolve, return the main schema\n68\t        if \"$defs\" not in schema and \"definitions\" not in schema:\n69\t            return schema\n70\t\n71\t        def resolve_refs(obj: Any) -> Any:\n72\t            if not isinstance(obj, (dict, list)):\n73\t                return obj\n74\t\n75\t            if isinstance(obj, dict):\n76\t                if \"$ref\" in obj:\n77\t                    ref_path = obj[\"$ref\"].split(\"/\")[-1]\n78\t                    return resolve_refs(schema[\"$defs\"][ref_path])\n79\t                return {k: resolve_refs(v) for k, v in obj.items()}\n80\t\n81\t            # Must be a list\n82\t            return [resolve_refs(item) for item in obj]\n83\t\n84\t        # Resolve all references in the main schema\n85\t        resolved_schema = resolve_refs(schema)\n86\t        # Remove the $defs key as it's no longer needed\n87\t        resolved_schema.pop(\"$defs\", None)\n88\t        return resolved_schema\n89\t\n90\t    def _parse_function(self, func: Callable, arg_desc: dict[str, str] = None):\n91\t        \"\"\"Helper method that parses a function to extract the name, description, and args.\n92\t\n93\t        This is a helper function that automatically infers the name, description, and args of the tool from the\n94\t        provided function. In order to make the inference work, the function must have valid type hints.\n95\t        \"\"\"\n96\t        annotations_func = func if inspect.isfunction(func) or inspect.ismethod(func) else func.__call__\n97\t        name = getattr(func, \"__name__\", type(func).__name__)\n98\t        desc = getattr(func, \"__doc__\", None) or getattr(annotations_func, \"__doc__\", \"\")\n99\t        args = {}\n100\t        arg_types = {}\n101\t\n102\t        # Use inspect.signature to get all arg names\n103\t        sig = inspect.signature(annotations_func)\n104\t        # Get available type hints\n105\t        available_hints = get_type_hints(annotations_func)\n106\t        # Build a dictionary of arg name -> type (defaulting to Any when missing)\n107\t        hints = {param_name: available_hints.get(param_name, Any) for param_name in sig.parameters.keys()}\n108\t        default_values = {param_name: sig.parameters[param_name].default for param_name in sig.parameters.keys()}\n109\t\n110\t        # Process each argument's type to generate its JSON schema.\n111\t        for k, v in hints.items():\n112\t            arg_types[k] = v\n113\t            if k == \"return\":\n114\t                continue\n115\t            # Check if the type (or its origin) is a subclass of Pydantic's BaseModel\n116\t            origin = get_origin(v) or v\n117\t            if isinstance(origin, type) and issubclass(origin, BaseModel):\n118\t                # Get json schema, and replace $ref with the actual schema\n119\t                v_json_schema = self._resolve_pydantic_schema(v)\n120\t                args[k] = v_json_schema\n121\t            else:\n122\t                args[k] = TypeAdapter(v).json_schema()\n123\t            if default_values[k] is not inspect.Parameter.empty:\n124\t                args[k][\"default\"] = default_values[k]\n125\t            if arg_desc and k in arg_desc:\n126\t                args[k][\"description\"] = arg_desc[k]\n127\t\n128\t        self.name = self.name or name\n129\t        self.desc = self.desc or desc\n130\t        self.args = self.args or args\n131\t        self.arg_types = self.arg_types or arg_types\n132\t\n133\t    def _parse_args(self, **kwargs):\n134\t        parsed_kwargs = {}\n135\t        for k, v in kwargs.items():\n136\t            if k in self.arg_types and self.arg_types[k] != any:\n137\t                # Create a pydantic model wrapper with a dummy field `value` to parse the arg to the correct type.\n138\t                # This is specifically useful for handling nested Pydantic models like `list[list[MyPydanticModel]]`\n139\t                pydantic_wrapper = create_model(\"Wrapper\", value=(self.arg_types[k], ...))\n140\t                parsed = pydantic_wrapper.model_validate({\"value\": v})\n141\t                parsed_kwargs[k] = parsed.value\n142\t            else:\n143\t                parsed_kwargs[k] = v\n144\t        return parsed_kwargs\n145\t\n146\t    @with_callbacks\n147\t    def __call__(self, **kwargs):\n148\t        for k, v in kwargs.items():\n149\t            if k not in self.args:\n150\t                raise ValueError(f\"Arg {k} is not in the tool's args.\")\n151\t            try:\n152\t                instance = v.model_dump() if hasattr(v, \"model_dump\") else v\n153\t                type_str = self.args[k].get(\"type\")\n154\t                if type_str is not None and type_str != \"Any\":\n155\t                    validate(instance=instance, schema=self.args[k])\n156\t            except ValidationError as e:\n157\t                raise ValueError(f\"Arg {k} is invalid: {e.message}\")\n158\t\n159\t        parsed_kwargs = self._parse_args(**kwargs)\n160\t        return self.func(**parsed_kwargs)\n161\t"}]},"parent_tool_use_id":null,"session_id":"919e1a27-296c-4b52-a99d-24b9ce88abc3","uuid":"bb9c8f23-d1bf-43ed-a081-960fd23ddcd7","timestamp":"2026-09-03T18:39:31.185Z","tool_use_result":{"type":"text","file":{"filePath":"/testbed/dspy/primitives/tool.py","content":"import inspect\nfrom typing import Any, Callable, Optional, get_origin, get_type_hints\n\nfrom jsonschema import ValidationError, validate\nfrom pydantic import BaseModel, TypeAdapter, create_model\n\nfrom dspy.utils.callback import with_callbacks\n\n\nclass Tool:\n    \"\"\"Tool class.\n\n    This class is used to simplify the creation of tools for tool calling (function calling) in LLMs. Only supports\n    functions for now.\n    \"\"\"\n\n    def __init__(\n        self,\n        func: Callable,\n        name: Optional[str] = None,\n        desc: Optional[str] = None,\n        args: Optional[dict[str, Any]] = None,\n        arg_types: Optional[dict[str, Any]] = None,\n        arg_desc: Optional[dict[str, str]] = None,\n    ):\n        \"\"\"Initialize the Tool class.\n\n        Users can choose to specify the `name`, `desc`, `args`, and `arg_types`, or let the `dspy.Tool`\n        automatically infer the values from the function. For values that are specified by the user, automatic inference\n        will not be performed on them.\n\n        Args:\n            func (Callable): The actual function that is being wrapped by the tool.\n            name (Optional[str], optional): The name of the tool. Defaults to None.\n            desc (Optional[str], optional): The description of the tool. Defaults to None.\n            args (Optional[dict[str, Any]], optional): The args and their schema of the tool, represented as a\n                dictionary from arg name to arg's json schema. Defaults to None.\n            arg_types (Optional[dict[str, Any]], optional): The argument types of the tool, represented as a dictionary\n                from arg name to the type of the argument. Defaults to None.\n            arg_desc (Optional[dict[str, str]], optional): Descriptions for each arg, represented as a\n                dictionary from arg name to description string. Defaults to None.\n\n        Example:\n\n        ```python\n        def foo(x: int, y: str = \"hello\"):\n            return str(x) + y\n\n        tool = Tool(foo)\n        print(tool.args)\n        # Expected output: {'x': {'type': 'integer'}, 'y': {'type': 'string', 'default': 'hello'}}\n        ```\n        \"\"\"\n        self.func = func\n        self.name = name\n        self.desc = desc\n        self.args = args\n        self.arg_types = arg_types\n        self.arg_desc = arg_desc\n\n        self._parse_function(func, arg_desc)\n\n    def _resolve_pydantic_schema(self, model: type[BaseModel]) -> dict:\n        \"\"\"Recursively resolve Pydantic model schema, expanding all references.\"\"\"\n        schema = model.model_json_schema()\n\n        # If there are no definitions to resolve, return the main schema\n        if \"$defs\" not in schema and \"definitions\" not in schema:\n            return schema\n\n        def resolve_refs(obj: Any) -> Any:\n            if not isinstance(obj, (dict, list)):\n                return obj\n\n            if isinstance(obj, dict):\n                if \"$ref\" in obj:\n                    ref_path = obj[\"$ref\"].split(\"/\")[-1]\n                    return resolve_refs(schema[\"$defs\"][ref_path])\n                return {k: resolve_refs(v) for k, v in obj.items()}\n\n            # Must be a list\n            return [resolve_refs(item) for item in obj]\n\n        # Resolve all references in the main schema\n        resolved_schema = resolve_refs(schema)\n        # Remove the $defs key as it's no longer needed\n        resolved_schema.pop(\"$defs\", None)\n        return resolved_schema\n\n    def _parse_function(self, func: Callable, arg_desc: dict[str, str] = None):\n        \"\"\"Helper method that parses a function to extract the name, description, and args.\n\n        This is a helper function that automatically infers the name, description, and args of the tool from the\n        provided function. In order to make the inference work, the function must have valid type hints.\n        \"\"\"\n        annotations_func = func if inspect.isfunction(func) or inspect.ismethod(func) else func.__call__\n        name = getattr(func, \"__name__\", type(func).__name__)\n        desc = getattr(func, \"__doc__\", None) or getattr(annotations_func, \"__doc__\", \"\")\n        args = {}\n        arg_types = {}\n\n        # Use inspect.signature to get all arg names\n        sig = inspect.signature(annotations_func)\n        # Get available type hints\n        available_hints = get_type_hints(annotations_func)\n        # Build a dictionary of arg name -> type (defaulting to Any when missing)\n        hints = {param_name: available_hints.get(param_name, Any) for param_name in sig.parameters.keys()}\n        default_values = {param_name: sig.parameters[param_name].default for param_name in sig.parameters.keys()}\n\n        # Process each argument's type to generate its JSON schema.\n        for k, v in hints.items():\n            arg_types[k] = v\n            if k == \"return\":\n                continue\n            # Check if the type (or its origin) is a subclass of Pydantic's BaseModel\n            origin = get_origin(v) or v\n            if isinstance(origin, type) and issubclass(origin, BaseModel):\n                # Get json schema, and replace $ref with the actual schema\n                v_json_schema = self._resolve_pydantic_schema(v)\n                args[k] = v_json_schema\n            else:\n                args[k] = TypeAdapter(v).json_schema()\n            if default_values[k] is not inspect.Parameter.empty:\n                args[k][\"default\"] = default_values[k]\n            if arg_desc and k in arg_desc:\n                args[k][\"description\"] = arg_desc[k]\n\n        self.name = self.name or name\n        self.desc = self.desc or desc\n        self.args = self.args or args\n        self.arg_types = self.arg_types or arg_types\n\n    def _parse_args(self, **kwargs):\n        parsed_kwargs = {}\n        for k, v in kwargs.items():\n            if k in self.arg_types and self.arg_types[k] != any:\n                # Create a pydantic model wrapper with a dummy field `value` to parse the arg to the correct type.\n                # This is specifically useful for handling nested Pydantic models like `list[list[MyPydanticModel]]`\n                pydantic_wrapper = create_model(\"Wrapper\", value=(self.arg_types[k], ...))\n                parsed = pydantic_wrapper.model_validate({\"value\": v})\n                parsed_kwargs[k] = parsed.value\n            else:\n                parsed_kwargs[k] = v\n        return parsed_kwargs\n\n    @with_callbacks\n    def __call__(self, **kwargs):\n        for k, v in kwargs.items():\n            if k not in self.args:\n                raise ValueError(f\"Arg {k} is not in the tool's args.\")\n            try:\n                instance = v.model_dump() if hasattr(v, \"model_dump\") else v\n                type_str = self.args[k].get(\"type\")\n                if type_str is not None and type_str != \"Any\":\n                    validate(instance=instance, schema=self.args[k])\n            except ValidationError as e:\n                raise ValueError(f\"Arg {k} is invalid: {e.message}\")\n\n        parsed_kwargs = self._parse_args(**kwargs)\n        return self.func(**parsed_kwargs)\n","numLines":161,"startLine":1,"totalLines":161}}}
