+def test_tool_with_kwargs_callable():
+    def foo(c=1, d=1, **kwargs):
+        return c * d
+
+    tool = Tool(foo)
+    assert tool.args == {"c": {"default": 1}, "d": {"default": 1}}
+    assert tool(c=5, d=4) == 20
+
+
+def test_tool_with_kwargs_accepts_unknown_args():
+    def foo(**kwargs):
+        return kwargs
+
+    tool = Tool(foo)
+    assert tool(c=5, d=4) == {"c": 5, "d": 4}
+
+
