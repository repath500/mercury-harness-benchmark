+    assert tool(c=5, d=4) == 20\n+    assert tool(c=5, d=4, unknown_arg=\"ignored\") == 20\n+\n+\n+def test_tool_without_kwargs_rejects_unknown_args():\n+    tool = Tool(dummy_function)\n+    assert not tool.has_kwargs\n+    with pytest.raises(ValueError, match=\"Arg unknown_arg is not in the tool's args.\"):\n+        tool(x=42, y=\"hello\", unknown_arg=\"ignored\")\n","additions":26,"deletions":0},"truncated":false},"title":"tests/primitives/test_tool.py","time":{"start":1788462083474,"end":1788462083489}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"The implementation matches upstream. Now add tests to /testbed/tests/primitives/test_tool.py covering:\n\n1. `def dummy_function(c=1, d=1, **kwargs): return c * d` — wait, user described \"takes **kwargs and returns the product of two optional parameters 'c' and 'd', with default values of 1\". Two interpretations; test both:\n   - `**kwargs`-only function reading c/d from kwargs: `tool(c=5, d=4) == 20`\n   - `def f(c=1, d=1, **kwargs)` with extra unknown kwarg\n2. Backward compat: function without **kwargs still raises ValueError for unknown arg.\n\nThen run the test suite.","format":"unknown","index":0}]}},"id":"prt_068a5ad8d001V60oNMsOKOJYLU","sessionID":"ses_f975e9cd0ffe5iITn19UOhisdq","messageID":"msg_068a57f03001vXm5raW1NFAHfy"}}
