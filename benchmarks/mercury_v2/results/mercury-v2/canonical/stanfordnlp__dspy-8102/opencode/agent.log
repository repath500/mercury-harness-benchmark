{"type":"tool_use","timestamp":1788461813915,"sessionID":"ses_f975e9cd0ffe5iITn19UOhisdq","part":{"type":"tool","tool":"read","callID":"call_7a5282acbc4d4d8392789a45","state":{"status":"completed","input":{"filePath":"/testbed/dspy/primitives/tool.py"},"output":"<path>/testbed/dspy/primitives/tool.py</path>\n<type>file</type>\n<content>\n1: import inspect\n2: from typing import Any, Callable, Optional, get_origin, get_type_hints\n3: \n4: from jsonschema import ValidationError, validate\n5: from pydantic import BaseModel, TypeAdapter, create_model\n6: \n7: from dspy.utils.callback import with_callbacks\n8: \n9: \n10: class Tool:\n11:     \"\"\"Tool class.\n12: \n13:     This class is used to simplify the creation of tools for tool calling (function calling) in LLMs. Only supports\n14:     functions for now.\n15:     \"\"\"\n16: \n17:     def __init__(\n18:         self,\n19:         func: Callable,\n20:         name: Optional[str] = None,\n21:         desc: Optional[str] = None,\n22:         args: Optional[dict[str, Any]] = None,\n23:         arg_types: Optional[dict[str, Any]] = None,\n24:         arg_desc: Optional[dict[str, str]] = None,\n25:     ):\n26:         \"\"\"Initialize the Tool class.\n27: \n28:         Users can choose to specify the `name`, `desc`, `args`, and `arg_types`, or let the `dspy.Tool`\n29:         automatically infer the values from the function. For values that are specified by the user, automatic inference\n30:         will not be performed on them.\n31: \n32:         Args:\n33:             func (Callable): The actual function that is being wrapped by the tool.\n34:             name (Optional[str], optional): The name of the tool. Defaults to None.\n35:             desc (Optional[str], optional): The description of the tool. Defaults to None.\n36:             args (Optional[dict[str, Any]], optional): The args and their schema of the tool, represented as a\n37:                 dictionary from arg name to arg's json schema. Defaults to None.\n38:             arg_types (Optional[dict[str, Any]], optional): The argument types of the tool, represented as a dictionary\n39:                 from arg name to the type of the argument. Defaults to None.\n40:             arg_desc (Optional[dict[str, str]], optional): Descriptions for each arg, represented as a\n41:                 dictionary from arg name to description string. Defaults to None.\n42: \n43:         Example:\n44: \n45:         ```python\n46:         def foo(x: int, y: str = \"hello\"):\n47:             return str(x) + y\n48: \n49:         tool = Tool(foo)\n50:         print(tool.args)\n51:         # Expected output: {'x': {'type': 'integer'}, 'y': {'type': 'string', 'default': 'hello'}}\n52:         ```\n53:         \"\"\"\n54:         self.func = func\n55:         self.name = name\n56:         self.desc = desc\n57:         self.args = args\n58:         self.arg_types = arg_types\n59:         self.arg_desc = arg_desc\n60: \n61:         self._parse_function(func, arg_desc)\n62: \n63:     def _resolve_pydantic_schema(self, model: type[BaseModel]) -> dict:\n64:         \"\"\"Recursively resolve Pydantic model schema, expanding all references.\"\"\"\n65:         schema = model.model_json_schema()\n66: \n67:         # If there are no definitions to resolve, return the main schema\n68:         if \"$defs\" not in schema and \"definitions\" not in schema:\n69:             return schema\n70: \n71:         def resolve_refs(obj: Any) -> Any:\n72:             if not isinstance(obj, (dict, list)):\n73:                 return obj\n74: \n75:             if isinstance(obj, dict):\n76:                 if \"$ref\" in obj:\n77:                     ref_path = obj[\"$ref\"].split(\"/\")[-1]\n78:                     return resolve_refs(schema[\"$defs\"][ref_path])\n79:                 return {k: resolve_refs(v) for k, v in obj.items()}\n80: \n81:             # Must be a list\n82:             return [resolve_refs(item) for item in obj]\n83: \n84:         # Resolve all