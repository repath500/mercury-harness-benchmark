ct.addresses if addr.is_primary), profile.contact.addresses[0]\n59:     )\n60: \n61:     return {\n62:         \"user_id\": profile.user_id,\n63:         \"name\": profile.name,\n64:         \"priority\": priority,\n65:         \"primary_address\": primary_address.model_dump(),\n66:         \"notes\": notes,\n67:     }\n68: \n69: \n70: def test_basic_initialization():\n71:     tool = Tool(name=\"test_tool\", desc=\"A test tool\", args={\"param1\": {\"type\": \"string\"}}, func=lambda x: x)\n72:     assert tool.name == \"test_tool\"\n73:     assert tool.desc == \"A test tool\"\n74:     assert tool.args == {\"param1\": {\"type\": \"string\"}}\n75:     assert callable(tool.func)\n76: \n77: \n78: def test_tool_from_function():\n79:     tool = Tool(dummy_function)\n80: \n81:     assert tool.name == \"dummy_function\"\n82:     assert \"A dummy function for testing\" in tool.desc\n83:     assert \"x\" in tool.args\n84:     assert \"y\" in tool.args\n85:     assert tool.args[\"x\"][\"type\"] == \"integer\"\n86:     assert tool.args[\"y\"][\"type\"] == \"string\"\n87:     assert tool.args[\"y\"][\"default\"] == \"hello\"\n88: \n89: \n90: def test_tool_from_class():\n91:     class Foo:\n92:         def __init__(self, user_id: str):\n93:             self.user_id = user_id\n94: \n95:         def __call__(self, a: int, b: int) -> int:\n96:             \"\"\"Add two numbers.\"\"\"\n97:             return a + b\n98: \n99:     tool = Tool(Foo(\"123\"))\n100:     assert tool.name == \"Foo\"\n101:     assert tool.desc == \"Add two numbers.\"\n102:     assert tool.args == {\"a\": {\"type\": \"integer\"}, \"b\": {\"type\": \"integer\"}}\n103: \n104: \n105: def test_tool_from_function_with_pydantic():\n106:     tool = Tool(dummy_with_pydantic)\n107: \n108:     assert tool.name == \"dummy_with_pydantic\"\n109:     assert \"model\" in tool.args\n110:     assert tool.args[\"model\"][\"type\"] == \"object\"\n111:     assert \"field1\" in tool.args[\"model\"][\"properties\"]\n112:     assert