+def test_tool_with_kwargs():
+    def dummy_function_with_kwargs(**kwargs):
+        """A function that accepts arbitrary keyword arguments."""
+        return kwargs.get("c", 1) * kwargs.get("d", 1)
+
+    tool = Tool(dummy_function_with_kwargs)
+
+    assert tool.has_var_keyword is True
+    assert tool.args == {}
+    assert tool(c=5, d=4) == 20
+
+
+def test_tool_with_kwargs_passes_through_arbitrary_args():
+    def dummy_function_with_kwargs(**kwargs):
+        return kwargs
+
+    tool = Tool(dummy_function_with_kwargs)
+
+    assert tool(anything="goes", other=123) == {"anything": "goes", "other": 123}
+
+
+def test_tool_with_named_args_and_kwargs():
+    def dummy_function_with_kwargs(a: int, c=1, d=1, **kwargs):
+        return a + c * d
+
+    tool = Tool(dummy_function_with_kwargs)
+
+    assert tool.has_var_keyword is True
+    assert tool.args == {"a": {"type": "integer"}, "c": {"default": 1}, "d": {"default": 1}}
+    assert tool(a=2, c=5, d=4, extra="ignored") == 22
+
+
+def test_tool_with_kwargs_still_validates_named_args():
+    def dummy_function_with_kwargs(a: int, **kwargs):
+        return a
+
+    tool = Tool(dummy_function_with_kwargs)
+
+    with pytest.raises(ValueError):
+        tool(a="not an integer")
+
+
+def test_tool_without_kwargs_rejects_unknown_args():
+    tool = Tool(dummy_function)
+
+    assert tool.has_var_keyword is False
+    with pytest.raises(ValueError, match="Arg unknown is not in the tool's args."):
+        tool(x=1, y="hello", unknown="boo")
+
+
+def test_tool_from_class_with_kwargs():
+    class Foo:
+        def __call__(self, **kwargs):
+            """Multiply two values."""
+            return kwargs.get("c", 1) * kwargs.get("d", 1)
+
+    tool = Tool(Foo())
+
+    assert tool.has_var_keyword is True
+    assert tool.args == {}
+    assert tool(c=5, d=4) == 20
+
+
