     return kwargs.get(\"c\", 1) * kwargs.get(\"d\", 1)\n+\n+    tool = Tool(dummy_function_with_kwargs)\n+\n+    assert tool.has_var_keyword is True\n+    assert tool.args == {}\n+    assert tool(c=5, d=4) == 20\n+\n+\n+def test_tool_with_kwargs_passes_through_arbitrary_args():\n+    def dummy_function_with_kwargs(**kwargs):\n+        return kwargs\n+\n+    tool = Tool(dummy_function_with_kwargs)\n+\n+    assert tool(anything=\"goes\", other=123) == {\"anything\": \"goes\", \"other\": 123}\n+\n+\n+def test_tool_with_named_args_and_kwargs():\n+    def dummy_function_with_kwargs(a: int, c=1, d=1, **kwargs):\n+        return a + c * d\n+\n+    tool = Tool(dummy_function_with_kwargs)\n+\n+    assert tool.has_var_keyword is True\n+    assert tool.args == {\"a\": {\"type\": \"integer\"}, \"c\": {\"default\": 1}, \"d\": {\"default\": 1}}\n+    assert tool(a=2, c=5, d=4, extra=\"ignored\") == 22\n+\n+\n+def test_tool_with_kwargs_still_validates_named_args():\n+    def dummy_function_with_kwargs(a: int, **kwargs):\n+        return a\n+\n+    tool = Tool(dummy_function_with_kwargs)\n+\n+    with pytest.raises(ValueError):\n+        tool(a=\"not an integer\")\n+\n+\n+def test_tool_without_kwargs_rejects_unknown_args():\n+    tool = Tool(dummy_function)\n+\n+    assert tool.has_var_keyword is False\n+    with pytest.raises(ValueError, match=\"Arg unknown is not in the tool's args.\"):\n+        tool(x=1, y=\"hello\", unknown=\"boo\")\n+\n+\n+def test_tool_from_class_with_kwargs():\n+    class Foo:\n+        def __call__(self, **kwargs):\n+            \"\"\"Multiply two values.\"\"\"\n+            return kwargs.get(\"c\", 1) * kwargs.get(\"d\", 1)\n+\n+    tool = Tool(Foo())\n+\n+    assert tool.has_var_keyword is True\n+    assert tool.args == {}\n+    assert tool(c=5, d=4) == 20\n+\n+\n def test_tool_from_function_with_pydantic_nesting():\n     tool = Tool(complex_dummy_function)\n \n"}],"isError":false,"timestamp":1788462293304},{"role":"assistant","content":[{"type":"thinking","thinking":"Everything passes. Let me summarize the changes for the user.","thinkingSignature":"[{\"type\":\"reasoning.text\",\"text\":\"Everything passes. Let me summarize the changes for the user.\",\"format\":\"unknown\",\"index\":0}]"},{"type":"text","text":"Done. `dspy.Tool` now supports callables with `**kwargs`. All 18 tool tests pass (12 original + 6 new), plus the callback/streaming suites that use `Tool`.\n\n## Changes\n\n**`dspy/primitives/tool.py`** — three coordinated changes:\n\n1. **`_parse_function`** now detects a `**kwargs` parameter via `inspect.Parameter.VAR_KEYWORD` and stores it as `self.has_var_keyword` (initialized to `False` in `__init__` for safety).\n2. **`_parse_function`** excludes `*args`/`**kwargs` parameters from the inferred schema (`args`/`arg_types`). Previously, a `**kwargs` function produced a bogus `{'kwargs': {}}` entry in the tool schema, which would have leaked into LLM function-calling schemas as a fake `kwargs` parameter.\n3. **`__call__`** allows keyword arguments not in `self.args` to pass through when `self.has_var_keyword` is `True` (skipping type validation for them, since they have no declared type). Functions without `**kwargs` keep the existing `ValueError(f\"Arg {k} is not in the tool's args.\")` behavior, so backward compatibility is fully preserved.\n\n**`tests/primitives/test_tool.py`** — added 6 regression tests covering: the exact scenario from your report (`tool(c=5, d=4) == 20`), arbitrary kwargs pass-through, named args mixed with `**kwargs` (with defaults preserved in the schema), continued validation of explicitly-typed named args even when `**kwargs` is present, unchanged rejection of unknown args for functions without `**kwargs`, and callable class instances with `**kwargs`.\n\n## Behavior summary\n\n```python\ndef fn(**kwargs):\n    return kwargs.get(\"c\", 1) * kwargs.get(\"d\", 1)\n\ntool = Tool(fn)\ntool(c=5, d=4)  # → 20, no error\ntool.args       # → {} (no bogus \"kwargs\" entry)\n\ndef fixed(x: int, y: str = \"hello\"): ...\ntool2 = Tool(fixed)\ntool2(x=1, unknown=\"boo\")  # → ValueError: Arg unknown is not in the tool's args. (unchanged)\n```\n\nNamed-parameter validation still applies even on `**kwargs` functions (e.g., `a: int` still rejects a string), and the 2 failing `test_json_adapter` tests are pre-existing failures unrelated to this change — they fail identically on the pristine checkout."}],"api":"openai-completions","provider":"harbor-endpoint","model":"z-ai/glm-5.3-flash","usage":{"input":9582,"output":554,"cacheRead":8960,"cacheWrite":0,"reasoning":12,"totalTokens":19096,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"stop","timestamp":1788462293306,"responseId":"gen-1788462293-4sm8q8YZmA5v7Tk27y85","rawStopReason":"stop"}],"willRetry":false}
