timestamp=2026-09-03T20:28:41.003Z level=INFO run=cd671067 message=evaluated permission=bash pattern="python -c \"\nfrom smolagents.local_python_executor import LocalPythonExecutor\n\ndef my_custom_function(x: int) -> int:\n    return x * 42\n\n# Without send_tools being called\nexecutor = LocalPythonExecutor([], additional_functions={'my_custom_function': my_custom_function})\noutput, logs, is_final = executor('result = my_custom_function(2)\\nresult')\nprint('no send_tools:', output, repr(logs), is_final)\nassert output == 84\n\n# With send_tools called\nexecutor2 = LocalPythonExecutor([], additional_functions={'my_custom_function': my_custom_function})\nexecutor2.send_tools({})\noutput2, logs2, _ = executor2('my_custom_function(10)')\nprint('with send_tools:', output2)\nassert output2 == 420\n\n# State preservation across executions\nout, _, _ = executor('my_custom_function(result)')\nprint('state preserved:', out)\nassert out == 3528\n\n# Default behavior unchanged\nexecutor3 = LocalPythonExecutor([])\noutput3, logs3, _ = executor3('print(1 + 1)\\n2 + 3')\nprint('default:', output3, repr(logs3))\nassert output3 == 5 and logs3 == '1 + 1 = 2\\n'\n\n# additional_functions default None\nexecutor4 = LocalPythonExecutor([])\nassert executor4.additional_functions == {}\nprint('OK')\n\"" action.permission=* action.action=allow action.pattern=*
