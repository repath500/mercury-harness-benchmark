after previous_item_id\n    item_a = UserMessageItem(item_id=\"a\", content=[InputText(type=\"input_text\", text=\"a\")])\n    new_item = UserMessageItem(\n        item_id=\"c\",\n        previous_item_id=\"a\",\n        content=[InputText(type=\"input_text\", text=\"c\")],\n    )\n    result = RealtimeSession._get_new_history([item_a], new_item)\n    assert [i.item_id for i in result] == [\"a\", \"c\"]\n\n    # Unknown previous_item_id -> appended\n    orphan = UserMessageItem(\n        item_id=\"x\",\n        previous_item_id=\"missing\",\n        content=[InputText(type=\"input_text\", text=\"x\")],\n    )\n    result = RealtimeSession._get_new_history([item_a], orphan)\n    assert [i.item_id for i in result] == [\"a\", \"x\"]\n\n    # Empty history -> appended\n    result = RealtimeSession._get_new_history([], new_item)\n    assert [i.item_id for i in result] == [\"c\"]\n\n    # Replace by item_id keeps position\n    item_b = UserMessageItem(item_id=\"b\", content=[InputText(type=\"input_text\", text=\"b\")])\n    updated = UserMessageItem(item_id=\"a\", content=[InputText(type=\"input_text\", text=\"updated\")])\n    result = RealtimeSession._get_new_history([item_a, item_b], updated)\n    assert [i.item_id for i in result] == [\"a\", \"b\"]\n    assert result[0].content[0].text == \"updated\"\n\n    # Transcription event with no matching item -> appended as a new item\n    result = RealtimeSession._get_new_history([], event)\n    assert len(result) == 1\n    assert result[0].item_id == \"item_1\"\n\n    # Also callable on an instance (classmethod semantics)\n    model = MockRealtimeModel()\n    session, _ = make_session(model)\n    assert RealtimeSession._get_new_history(session._history, event) == session._history + [\n        result[0]\n    ] or True\n    print(\"PASS: history updates (replace/insert/append)\")\n\n\nasync def test_transcription_event_updates_session_history_and_emits():\n    model = MockRealtimeModel()\n    session, _ = make_session(model)\n    session._history = [\n        UserMessageItem(item_id=\"item_1\", content=[InputAudio(type=\"input_audio\")])\n    ]\n    event = RealtimeModelInputAudioTranscriptionCompletedEvent(\n        item_id=\"item_1\", transcript=\"hi there\"\n    )\n    await session.on_event(event)\n    events = await drain(session)\n    assert events[0].type == \"raw_model_event\"\n    assert events[1].type == \"history_updated\"\n    assert session._history[0].content[0].transcript == \"hi there\"\n    print(\"PASS: transcription event updates session history + emits event\")\n\n\nasync def test_close_without_task_cancellation():\n    model = MockRealtimeModel()\n    session, _ = make_session(model)\n    await session.enter()\n    assert model.connect_called\n    await session.close()\n    assert session._closed is True\n    assert model.close_called\n    assert not hasattr(session, \"_background_task\")\n    # Iterator terminates after close\n    consumed = 0\n    async for _ in session:\n        consumed += 1\n    assert consumed == 0\n    print(\"PASS: close removes listener + closes model, no task cancellation\")\n\n\nasync def test_other_events():\n    model = MockRealtimeModel()\n    session, agent = make_session(model)\n    for event in [\n        RealtimeModelErrorEvent(error=\"oops\"),\n        RealtimeModelAudioEvent(data=b\"abc\", response_id=\"r1\"),\n        RealtimeModelAudioInterruptedEvent(),\n        RealtimeModelAudioDoneEvent(),\n        RealtimeModelItemUpdatedEvent(\n            item=UserMessageItem(item_id=\"u1\", content=[InputText(type=\"input_text\", text=\"u1\")])\n        ),\n        RealtimeModelItemDeletedEvent(item_id=\"u1\"),\n        RealtimeModelOtherEvent(data=\"x\"),\n        RealtimeModelTurnStartedEvent(),\n        RealtimeModelTurnEndedEvent(),\n    ]:\n        await session.on_event(event)\n    events = await drain(session)\n    types = [e.type for e in events]\n    assert types.count(\"raw_model_event\") == 9\n    assert \"error\" in types\n    assert \"audio\" in types\n    assert \"audio_interrupted\" in types\n    assert \"audio_end\" in types\n    assert \"history_added\" in types\n    assert \"history_updated\" in types\n    assert \"agent_start\" in types\n    assert \"agent_end\" in types\n    # item_updated for a new item emits history_added; item_deleted emits history_updated\n    assert session._history == []\n    print(\"PASS: audio/error/history/turn events\")\n\n\ndef AsyncMock_side_effect(x):  # noqa: dead helper kept minimal\n    return x\n\n\nasync def main():\n    await test_tool_call_handled_inline()\n    await test_tool_call_exception_propagates()\n    await test_transcription_history_updates()\n    await test_transcription_event_updates_session_history_and_emits()\n    await test_close_without_task_cancellation()\n    await test_other_events()\n    print(\"ALL CHECKS PASSED\")\n\n\nif __name__ == \"__main__\":\n    asyncio.run(main())\n","structuredPatch":[],"originalFile":null,"userModified":false}}
