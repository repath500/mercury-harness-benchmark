{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_e9cc254110744b739646f2bf","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport asyncio\n4\tfrom collections.abc import AsyncIterator\n5\tfrom typing import Any\n6\t\n7\tfrom typing_extensions import assert_never\n8\t\n9\tfrom ..handoffs import Handoff\n10\tfrom ..run_context import RunContextWrapper, TContext\n11\tfrom ..tool import FunctionTool\n12\tfrom ..tool_context import ToolContext\n13\tfrom .agent import RealtimeAgent\n14\tfrom .config import RealtimeUserInput\n15\tfrom .events import (\n16\t    RealtimeAgentEndEvent,\n17\t    RealtimeAgentStartEvent,\n18\t    RealtimeAudio,\n19\t    RealtimeAudioEnd,\n20\t    RealtimeAudioInterrupted,\n21\t    RealtimeError,\n22\t    RealtimeEventInfo,\n23\t    RealtimeHistoryAdded,\n24\t    RealtimeHistoryUpdated,\n25\t    RealtimeRawModelEvent,\n26\t    RealtimeSessionEvent,\n27\t    RealtimeToolEnd,\n28\t    RealtimeToolStart,\n29\t)\n30\tfrom .items import InputAudio, InputText, RealtimeItem\n31\tfrom .model import RealtimeModel, RealtimeModelConfig, RealtimeModelListener\n32\tfrom .model_events import (\n33\t    RealtimeModelEvent,\n34\t    RealtimeModelInputAudioTranscriptionCompletedEvent,\n35\t    RealtimeModelToolCallEvent,\n36\t)\n37\t\n38\t\n39\tclass RealtimeSession(RealtimeModelListener):\n40\t    \"\"\"A connection to a realtime model. It streams events from the model to you, and allows you to\n41\t    send messages and audio to the model.\n42\t\n43\t    Example:\n44\t        ```python\n45\t        runner = RealtimeRunner(agent)\n46\t        async with await runner.run() as session:\n47\t            # Send messages\n48\t            await session.send_message(\"Hello\")\n49\t            await session.send_audio(audio_bytes)\n50\t\n51\t            # Stream events\n52\t            async for event in session:\n53\t                if event.type == \"audio\":\n54\t                    # Handle audio event\n55\t                    pass\n56\t        ```\n57\t    \"\"\"\n58\t\n59\t    def __init__(\n60\t        self,\n61\t        model: RealtimeModel,\n62\t        agent: RealtimeAgent,\n63\t        context: TContext | None,\n64\t        model_config: RealtimeModelConfig | None = None,\n65\t    ) -> None:\n66\t        \"\"\"Initialize the session.\n67\t\n68\t        Args:\n69\t            model: The model to use.\n70\t            agent: The current agent.\n71\t            context_wrapper: The context wrapper.\n72\t            event_info: Event info object.\n73\t            history: The conversation history.\n74\t            model_config: Model configuration.\n75\t        \"\"\"\n76\t        self._model = model\n77\t        self._current_agent = agent\n78\t        self._context_wrapper = RunContextWrapper(context)\n79\t        self._event_info = RealtimeEventInfo(context=self._context_wrapper)\n80\t        self._history: list[RealtimeItem] = []\n81\t        self._model_config = model_config or {}\n82\t        self._event_queue: asyncio.Queue[RealtimeSessionEvent] = asyncio.Queue()\n83\t        self._closed = False\n84\t        self._background_task: asyncio.Task[None] | None = None\n85\t\n86\t    async def __aenter__(self) -> RealtimeSession:\n87\t        \"\"\"Start the session by connecting to the model. After this, you will be able to stream\n88\t        events from the model and send messages and audio to the model.\n89\t        \"\"\"\n90\t        # Add ourselves as a listener\n91\t        self._model.add_listener(self)\n92\t\n93\t        # Connect to the model\n94\t        await self._model.connect(self._model_config)\n95\t\n96\t        # Emit initial history update\n97\t        await self._put_event(\n98\t            RealtimeHistoryUpdated(\n99\t                history=self._history,\n100\t                info=self._event_info,\n101\t            )\n102\t        )\n103\t\n104\t        return self\n105\t\n106\t    async def enter(self) -> RealtimeSession:\n107\t        \"\"\"Enter the async context manager. We strongly recommend using the async context manager\n108\t        pattern instead of this method. If you use this, you need to manually call `close()` when\n109\t        you are done.\n110\t        \"\"\"\n111\t        return await self.__aenter__()\n112\t\n113\t    async def __aexit__(self, _exc_type: Any, _exc_val: Any, _exc_tb: Any) -> None:\n114\t        \"\"\"End the session.\"\"\"\n115\t        await self.close()\n116\t\n117\t    async def __aiter__(self) -> AsyncIterator[RealtimeSessionEvent]:\n118\t        \"\"\"Iterate over events from the session.\"\"\"\n119\t        while not self._closed:\n120\t            try:\n121\t                event = await self._event_queue.get()\n122\t                yield event\n123\t            except asyncio.CancelledError:\n124\t                break\n125\t\n126\t    async def close(self) -> None:\n127\t        \"\"\"Close the session.\"\"\"\n128\t        self._closed = True\n129\t        self._model.remove_listener(self)\n130\t        await self._model.close()\n131\t\n132\t        # Cancel any background tasks\n133\t        if self._background_task and not self._background_task.done():\n134\t            self._background_task.cancel()\n135\t            try:\n136\t                await self._background_task\n137\t            except asyncio.CancelledError:\n138\t                pass\n139\t\n140\t    async def send_message(self, message: RealtimeUserInput) -> None:\n141\t        \"\"\"Send a message to the model.\"\"\"\n142\t        await self._model.send_message(message)\n143\t\n144\t    async def send_audio(self, audio: bytes, *, commit: bool = False) -> None:\n145\t        \"\"\"Send a raw audio chunk to the model.\"\"\"\n146\t        await self._model.send_audio(audio, commit=commit)\n147\t\n148\t    async def interrupt(self) -> None:\n149\t        \"\"\"Interrupt the model.\"\"\"\n150\t        await self._model.interrupt()\n151\t\n152\t    async def on_event(self, event: RealtimeModelEvent) -> None:\n153\t        await self._put_event(RealtimeRawModelEvent(data=event, info=self._event_info))\n154\t\n155\t        if event.type == \"error\":\n156\t            await self._put_event(RealtimeError(info=self._event_info, error=event.error))\n157\t        elif event.type == \"function_call\":\n158\t            # Handle tool calls in the background to avoid blocking event stream\n159\t            self._background_task = asyncio.create_task(self._handle_tool_call(event))\n160\t        elif event.type == \"audio\":\n161\t            await self._put_event(RealtimeAudio(info=self._event_info, audio=event))\n162\t        elif event.type == \"audio_interrupted\":\n163\t            await self._put_event(RealtimeAudioInterrupted(info=self._event_info))\n164\t        elif event.type == \"audio_done\":\n165\t            await self._put_event(RealtimeAudioEnd(info=self._event_info))\n166\t        elif event.type == \"conversation.item.input_audio_transcription.completed\":\n167\t            self._history = self._get_new_history(self._history, event)\n168\t            await self._put_event(\n169\t                RealtimeHistoryUpdated(info=self._event_info, history=self._history)\n170\t            )\n171\t        elif event.type == \"transcript_delta\":\n172\t            # TODO (rm) Add guardrails\n173\t            pass\n174\t        elif event.type == \"item_updated\":\n175\t            is_new = not any(item.item_id == event.item.item_id for item in self._history)\n176\t            self._history = self._get_new_history(self._history, event.item)\n177\t            if is_new:\n178\t                new_item = next(\n179\t                    item for item in self._history if item.item_id == event.item.item_id\n180\t                )\n181\t                await self._put_event(RealtimeHistoryAdded(info=self._event_info, item=new_item))\n182\t            else:\n183\t                await self._put_event(\n184\t                    RealtimeHistoryUpdated(info=self._event_info, history=self._history)\n185\t                )\n186\t        elif event.type == \"item_deleted\":\n187\t            deleted_id = event.item_id\n188\t            self._history = [item for item in self._history if item.item_id != deleted_id]\n189\t            await self._put_event(\n190\t                RealtimeHistoryUpdated(info=self._event_info, history=self._history)\n191\t            )\n192\t        elif event.type == \"connection_status\":\n193\t            pass\n194\t        elif event.type == \"turn_started\":\n195\t            await self._put_event(\n196\t                RealtimeAgentStartEvent(\n197\t                    agent=self._current_agent,\n198\t                    info=self._event_info,\n199\t                )\n200\t            )\n201\t        elif event.type == \"turn_ended\":\n202\t            await self._put_event(\n203\t                RealtimeAgentEndEvent(\n204\t                    agent=self._current_agent,\n205\t                    info=self._event_info,\n206\t                )\n207\t            )\n208\t        elif event.type == \"other\":\n209\t            pass\n210\t        else:\n211\t            assert_never(event)\n212\t\n213\t    async def _put_event(self, event: RealtimeSessionEvent) -> None:\n214\t        \"\"\"Put an event into the queue.\"\"\"\n215\t        await self._event_queue.put(event)\n216\t\n217\t    async def _handle_tool_call(self, event: RealtimeModelToolCallEvent) -> None:\n218\t        \"\"\"Handle a tool call event.\"\"\"\n219\t        all_tools = await self._current_agent.get_all_tools(self._context_wrapper)\n220\t        function_map = {tool.name: tool for tool in all_tools if isinstance(tool, FunctionTool)}\n221\t        handoff_map = {tool.name: tool for tool in all_tools if isinstance(tool, Handoff)}\n222\t\n223\t        if event.name in function_map:\n224\t            await self._put_event(\n225\t                RealtimeToolStart(\n226\t                    info=self._event_info,\n227\t                    tool=function_map[event.name],\n228\t                    agent=self._current_agent,\n229\t                )\n230\t            )\n231\t\n232\t            func_tool = function_map[event.name]\n233\t            tool_context = ToolContext.from_agent_context(self._context_wrapper, event.call_id)\n234\t            result = await func_tool.on_invoke_tool(tool_context, event.arguments)\n235\t\n236\t            await self._model.send_tool_output(event, str(result), True)\n237\t\n238\t            await self._put_event(\n239\t                RealtimeToolEnd(\n240\t                    info=self._event_info,\n241\t                    tool=func_tool,\n242\t                    output=result,\n243\t                    agent=self._current_agent,\n244\t                )\n245\t            )\n246\t        elif event.name in handoff_map:\n247\t            # TODO (rm) Add support for handoffs\n248\t            pass\n249\t        else:\n250\t            # TODO (rm) Add error handling\n251\t            pass\n252\t\n253\t    def _get_new_history(\n254\t        self,\n255\t        old_history: list[RealtimeItem],\n256\t        event: RealtimeModelInputAudioTranscriptionCompletedEvent | RealtimeItem,\n257\t    ) -> list[RealtimeItem]:\n258\t        # Merge transcript into placeholder input_audio message.\n259\t        if isinstance(event, RealtimeModelInputAudioTranscriptionCompletedEvent):\n260\t            new_history: list[RealtimeItem] = []\n261\t            for item in old_history:\n262\t                if item.item_id == event.item_id and item.type == \"message\" and item.role == \"user\":\n263\t                    content: list[InputText | InputAudio] = []\n264\t                    for entry in item.content:\n265\t                        if entry.type == \"input_audio\":\n266\t                            copied_entry = entry.model_copy(update={\"transcript\": event.transcript})\n267\t                            content.append(copied_entry)\n268\t                        else:\n269\t                            content.append(entry)  # type: ignore\n270\t                    new_history.append(\n271\t                        item.model_copy(update={\"content\": content, \"status\": \"completed\"})\n272\t                    )\n273\t                else:\n274\t                    new_history.append(item)\n275\t            return new_history\n276\t\n277\t        # Otherwise it's just a new item\n278\t        # TODO (rm) Add support for audio storage config\n279\t\n280\t        # If the item already exists, update it\n281\t        existing_index = next(\n282\t            (i for i, item in enumerate(old_history) if item.item_id == event.item_id), None\n283\t        )\n284\t        if existing_index is not None:\n285\t            new_history = old_history.copy()\n286\t            new_history[existing_index] = event\n287\t            return new_history\n288\t        # Otherwise, insert it after the previous_item_id if that is set\n289\t        elif event.previous_item_id:\n290\t            # Insert the new item after the previous item\n291\t            previous_index = next(\n292\t                (i for i, item in enumerate(old_history) if item.item_id == event.previous_item_id),\n293\t                None,\n294\t            )\n295\t            if previous_index is not None:\n296\t                new_history = old_history.copy()\n297\t                new_history.insert(previous_index + 1, event)\n298\t                return new_history\n299\t        # Otherwise, add it to the end\n300\t        return old_history + [event]\n301\t"}]},"parent_tool_use_id":null,"session_id":"13d715a6-efdd-4627-ab02-a32241b860a9","uuid":"d5b8ee93-f57e-4f12-a6e2-f8fb7feb14c3","timestamp":"2026-09-04T06:03:08.131Z","tool_use_result":{"type":"text","file":{"filePath":"/testbed/src/agents/realtime/session.py","content":"from __future__ import annotations\n\nimport asyncio\nfrom collections.abc import AsyncIterator\nfrom typing import Any\n\nfrom typing_extensions import assert_never\n\nfrom ..handoffs import Handoff\nfrom ..run_context import RunContextWrapper, TContext\nfrom ..tool import FunctionTool\nfrom ..tool_context import ToolContext\nfrom .agent import RealtimeAgent\nfrom .config import RealtimeUserInput\nfrom .events import (\n    RealtimeAgentEndEvent,\n    RealtimeAgentStartEvent,\n    RealtimeAudio,\n    RealtimeAudioEnd,\n    RealtimeAudioInterrupted,\n    RealtimeError,\n    RealtimeEventInfo,\n    RealtimeHistoryAdded,\n    RealtimeHistoryUpdated,\n    RealtimeRawModelEvent,\n    RealtimeSessionEvent,\n    RealtimeToolEnd,\n    RealtimeToolStart,\n)\nfrom .items import InputAudio, InputText, RealtimeItem\nfrom .model import RealtimeModel, RealtimeModelConfig, RealtimeModelListener\nfrom .model_events import (\n    RealtimeModelEvent,\n    RealtimeModelInputAudioTranscriptionCompletedEvent,\n    RealtimeModelToolCallEvent,\n)\n\n\nclass RealtimeSession(RealtimeModelListener):\n    \"\"\"A connection to a realtime model. It streams events from the model to you, and allows you to\n    send messages and audio to the model.\n\n    Example:\n        ```python\n        runner = RealtimeRunner(agent)\n        async with await runner.run() as session:\n            # Send messages\n            await session.send_message(\"Hello\")\n            await session.send_audio(audio_bytes)\n\n            # Stream events\n            async for event in session:\n                if event.type == \"audio\":\n                    # Handle audio event\n                    pass\n        ```\n    \"\"\"\n\n    def __init__(\n        self,\n        model: RealtimeModel,\n        agent: RealtimeAgent,\n        context: TContext | None,\n        model_config: RealtimeModelConfig | None = None,\n    ) -> None:\n        \"\"\"Initialize the session.\n\n        Args:\n            model: The model to use.\n            agent: The current agent.\n            context_wrapper: The context wrapper.\n            event_info: Event info object.\n            history: The conversation history.\n            model_config: Model configuration.\n        \"\"\"\n        self._model = model\n        self._current_agent = agent\n        self._context_wrapper = RunContextWrapper(context)\n        self._event_info = RealtimeEventInfo(context=self._context_wrapper)\n        self._history: list[RealtimeItem] = []\n        self._model_config = model_config or {}\n        self._event_queue: asyncio.Queue[RealtimeSessionEvent] = asyncio.Queue()\n        self._closed = False\n        self._background_task: asyncio.Task[None] | None = None\n\n    async def __aenter__(self) -> RealtimeSession:\n        \"\"\"Start the session by connecting to the model. After this, you will be able to stream\n        events from the model and send messages and audio to the model.\n        \"\"\"\n        # Add ourselves as a listener\n        self._model.add_listener(self)\n\n        # Connect to the model\n        await self._model.connect(self._model_config)\n\n        # Emit initial history update\n        await self._put_event(\n            RealtimeHistoryUpdated(\n                history=self._history,\n                info=self._event_info,\n            )\n        )\n\n        return self\n\n    async def enter(self) -> RealtimeSession:\n        \"\"\"Enter the async context manager. We strongly recommend using the async context manager\n        pattern instead of this method. If you use this, you need to manually call `close()` when\n        you are done.\n        \"\"\"\n        return await self.__aenter__()\n\n    async def __aexit__(self, _exc_type: Any, _exc_val: Any, _exc_tb: Any) -> None:\n        \"\"\"End the session.\"\"\"\n        await self.close()\n\n    async def __aiter__(self) -> AsyncIterator[RealtimeSessionEvent]:\n        \"\"\"Iterate over events from the session.\"\"\"\n        while not self._closed:\n            try:\n                event = await self._event_queue.get()\n                yield event\n            except asyncio.CancelledError:\n                break\n\n    async def close(self) -> None:\n        \"\"\"Close the session.\"\"\"\n        self._closed = True\n        self._model.remove_listener(self)\n        await self._model.close()\n\n        # Cancel any background tasks\n        if self._background_task and not self._background_task.done():\n            self._background_task.cancel()\n            try:\n                await self._background_task\n            except asyncio.CancelledError:\n                pass\n\n    async def send_message(self, message: RealtimeUserInput) -> None:\n        \"\"\"Send a message to the model.\"\"\"\n        await self._model.send_message(message)\n\n    async def send_audio(self, audio: bytes, *, commit: bool = False) -> None:\n        \"\"\"Send a raw audio chunk to the model.\"\"\"\n        await self._model.send_audio(audio, commit=commit)\n\n    async def interrupt(self) -> None:\n        \"\"\"Interrupt the model.\"\"\"\n        await self._model.interrupt()\n\n    async def on_event(self, event: RealtimeModelEvent) -> None:\n        await self._put_event(RealtimeRawModelEvent(data=event, info=self._event_info))\n\n        if event.type == \"error\":\n            await self._put_event(RealtimeError(info=self._event_info, error=event.error))\n        elif event.type == \"function_call\":\n            # Handle tool calls in the background to avoid blocking event stream\n            self._background_task = asyncio.create_task(self._handle_tool_call(event))\n        elif event.type == \"audio\":\n            await self._put_event(RealtimeAudio(info=self._event_info, audio=event))\n        elif event.type == \"audio_interrupted\":\n            await self._put_event(RealtimeAudioInterrupted(info=self._event_info))\n        elif event.type == \"audio_done\":\n            await self._put_event(RealtimeAudioEnd(info=self._event_info))\n        elif event.type == \"conversation.item.input_audio_transcription.completed\":\n            self._history = self._get_new_history(self._history, event)\n            await self._put_event(\n                RealtimeHistoryUpdated(info=self._event_info, history=self._history)\n            )\n        elif event.type == \"transcript_delta\":\n            # TODO (rm) Add guardrails\n            pass\n        elif event.type == \"item_updated\":\n            is_new = not any(item.item_id == event.item.item_id for item in self._history)\n            self._history = self._get_new_history(self._history, event.item)\n            if is_new:\n                new_item = next(\n                    item for item in self._history if item.item_id == event.item.item_id\n                )\n                await self._put_event(RealtimeHistoryAdded(info=self._event_info, item=new_item))\n            else:\n                await self._put_event(\n                    RealtimeHistoryUpdated(info=self._event_info, history=self._history)\n                )\n        elif event.type == \"item_deleted\":\n            deleted_id = event.item_id\n            self._history = [item for item in self._history if item.item_id != deleted_id]\n            await self._put_event(\n                RealtimeHistoryUpdated(info=self._event_info, history=self._history)\n            )\n        elif event.type == \"connection_status\":\n            pass\n        elif event.type == \"turn_started\":\n            await self._put_event(\n                RealtimeAgentStartEvent(\n                    agent=self._current_agent,\n                    info=self._event_info,\n                )\n            )\n        elif event.type == \"turn_ended\":\n            await self._put_event(\n                RealtimeAgentEndEvent(\n                    agent=self._current_agent,\n                    info=self._event_info,\n                )\n            )\n        elif event.type == \"other\":\n            pass\n        else:\n            assert_never(event)\n\n    async def _put_event(self, event: RealtimeSessionEvent) -> None:\n        \"\"\"Put an event into the queue.\"\"\"\n        await self._event_queue.put(event)\n\n    async def _handle_tool_call(self, event: RealtimeModelToolCallEvent) -> None:\n        \"\"\"Handle a tool call event.\"\"\"\n        all_tools = await self._current_agent.get_all_tools(self._context_wrapper)\n        function_map = {tool.name: tool for tool in all_tools if isinstance(tool, FunctionTool)}\n        handoff_map = {tool.name: tool for tool in all_tools if isinstance(tool, Handoff)}\n\n        if event.name in function_map:\n            await self._put_event(\n                RealtimeToolStart(\n                    info=self._event_info,\n                    tool=function_map[event.name],\n                    agent=self._current_agent,\n                )\n            )\n\n            func_tool = function_map[event.name]\n            tool_context = ToolContext.from_agent_context(self._context_wrapper, event.call_id)\n            result = await func_tool.on_invoke_tool(tool_context, event.arguments)\n\n            await self._model.send_tool_output(event, str(result), True)\n\n            await self._put_event(\n                RealtimeToolEnd(\n                    info=self._event_info,\n                    tool=func_tool,\n                    output=result,\n                    agent=self._current_agent,\n                )\n            )\n        elif event.name in handoff_map:\n            # TODO (rm) Add support for handoffs\n            pass\n        else:\n            # TODO (rm) Add error handling\n            pass\n\n    def _get_new_history(\n        self,\n        old_history: list[RealtimeItem],\n        event: RealtimeModelInputAudioTranscriptionCompletedEvent | RealtimeItem,\n    ) -> list[RealtimeItem]:\n        # Merge transcript into placeholder input_audio message.\n        if isinstance(event, RealtimeModelInputAudioTranscriptionCompletedEvent):\n            new_history: list[RealtimeItem] = []\n            for item in old_history:\n                if item.item_id == event.item_id and item.type == \"message\" and item.role == \"user\":\n                    content: list[InputText | InputAudio] = []\n                    for entry in item.content:\n                        if entry.type == \"input_audio\":\n                            copied_entry = entry.model_copy(update={\"transcript\": event.transcript})\n                            content.append(copied_entry)\n                        else:\n                            content.append(entry)  # type: ignore\n                    new_history.append(\n                        item.model_copy(update={\"content\": content, \"status\": \"completed\"})\n                    )\n                else:\n                    new_history.append(item)\n            return new_history\n\n        # Otherwise it's just a new item\n        # TODO (rm) Add support for audio storage config\n\n        # If the item already exists, update it\n        existing_index = next(\n            (i for i, item in enumerate(old_history) if item.item_id == event.item_id), None\n        )\n        if existing_index is not None:\n            new_history = old_history.copy()\n            new_history[existing_index] = event\n            return new_history\n        # Otherwise, insert it after the previous_item_id if that is set\n        elif event.previous_item_id:\n            # Insert the new item after the previous item\n            previous_index = next(\n                (i for i, item in enumerate(old_history) if item.item_id == event.previous_item_id),\n                None,\n            )\n            if previous_index is not None:\n                new_history = old_history.copy()\n                new_history.insert(previous_index + 1, event)\n                return new_history\n        # Otherwise, add it to the end\n        return old_history + [event]\n","numLines":301,"startLine":1,"totalLines":301}}}
