{"type":"tool_use","timestamp":1788503345751,"sessionID":"ses_f94e4d0f6ffeQOYRYclieGJzVe","part":{"type":"tool","tool":"read","callID":"call_a3f24c3d92bf4e2d9290ae0c","state":{"status":"completed","input":{"filePath":"/testbed/src/agents/realtime/session.py"},"output":"<path>/testbed/src/agents/realtime/session.py</path>\n<type>file</type>\n<content>\n1: from __future__ import annotations\n2: \n3: import asyncio\n4: from collections.abc import AsyncIterator\n5: from typing import Any\n6: \n7: from typing_extensions import assert_never\n8: \n9: from ..handoffs import Handoff\n10: from ..run_context import RunContextWrapper, TContext\n11: from ..tool import FunctionTool\n12: from ..tool_context import ToolContext\n13: from .agent import RealtimeAgent\n14: from .config import RealtimeUserInput\n15: from .events import (\n16:     RealtimeAgentEndEvent,\n17:     RealtimeAgentStartEvent,\n18:     RealtimeAudio,\n19:     RealtimeAudioEnd,\n20:     RealtimeAudioInterrupted,\n21:     RealtimeError,\n22:     RealtimeEventInfo,\n23:     RealtimeHistoryAdded,\n24:     RealtimeHistoryUpdated,\n25:     RealtimeRawModelEvent,\n26:     RealtimeSessionEvent,\n27:     RealtimeToolEnd,\n28:     RealtimeToolStart,\n29: )\n30: from .items import InputAudio, InputText, RealtimeItem\n31: from .model import RealtimeModel, RealtimeModelConfig, RealtimeModelListener\n32: from .model_events import (\n33:     RealtimeModelEvent,\n34:     RealtimeModelInputAudioTranscriptionCompletedEvent,\n35:     RealtimeModelToolCallEvent,\n36: )\n37: \n38: \n39: class RealtimeSession(RealtimeModelListener):\n40:     \"\"\"A connection to a realtime model. It streams events from the model to you, and allows you to\n41:     send messages and audio to the model.\n42: \n43:     Example:\n44:         ```python\n45:         runner = RealtimeRunner(agent)\n46:         async with await runner.run() as session:\n47:             # Send messages\n48:             await session.send_message(\"Hello\")\n49:             await session.send_audio(audio_bytes)\n50: \n51:             # Stream events\n52:             async for event in session:\n53:                 if event.type == \"audio\":\n54:                     # Handle audio event\n55:                     pass\n56:         ```\n57:     \"\"\"\n58: \n59:     def __init__(\n60:         self,\n61:         model: RealtimeModel,\n62:         agent: RealtimeAgent,\n63:         context: TContext | None,\n64:         model_config: RealtimeModelConfig | None = None,\n65:     ) -> None:\n66:         \"\"\"Initialize the session.\n67: \n68:         Args:\n69:             model: The model to use.\n70:             agent: The current agent.\n71:             context_wrapper: The context wrapper.\n72:             event_info: Event info object.\n73:             history: The conversation history.\n74:             model_config: Model configuration.\n75:         \"\"\"\n76:         self._model = model\n77:         self._current_agent = agent\n78:         self._context_wrapper = RunContextWrapper(context)\n79:         self._event_info = RealtimeEventInfo(context=self._context_wrapper)\n80:         self._history: list[RealtimeItem] = []\n81:         self._model_config = model_config or {}\n82:         self._event_queue: asyncio.Queue[RealtimeSessionEvent] = asyncio.Queue()\n83:         self._closed = False\n84:         self._background_task: asyncio.Task[None] | None = None\n85: \n86:     async def __aenter__(self) -> RealtimeSession:\n87:         \"\"\"Start the session by connecting to the model. After this, you will be able to stream\n88:         events from the model and send messages and audio to the model.\n89:         \"\"\"\n90:         # Add ourselves as a listener\n91:         self._model.add_listener(self)\n92: \n93:         # Connect to the model\n94:         await self._model.connect(self._model_config)\n95: \n96:         # Emit initial history update\n97:         await self._put_event(\n98:             RealtimeHistoryUpdated(\n99:                 history=self._history,\n100:                 info=self._event_info,\n101:             )\n102:         )\n103: \n104:         return self\n105: \n106:     async def enter(self) -> RealtimeSession:\n107:         \"\"\"Enter the async context manager. We strongly recommend using the async context manager\n108:         pattern instead of this method. If you use this, you need to manually call `close()` when\n109:         you are done.\n110:         \"\"\"\n111:         return await self.__aenter__()\n112: \n113:     async def __aexit__(self, _exc_type: Any, _exc_val: Any, _exc_tb: Any) -> None:\n114:         \"\"\"End the session.\"\"\"\n115:         await self.close()\n116: \n117:     async def __aiter__(self) -> AsyncIterator[RealtimeSessionEvent]:\n118:         \"\"\"Iterate over events from the session.\"\"\"\n119:         while not self._closed:\n120:             try:\n121:                 event = await self._event_queue.get()\n122:                 yield event\n123:             except asyncio.CancelledError:\n124:                 break\n125: \n126:     async def close(self) -> None:\n127:         \"\"\"Close the session.\"\"\"\n128:         self._closed = True\n129:         self._model.remove_listener(self)\n130:         await self._model.close()\n131: \n132:         # Cancel any background tasks\n133:         if self._background_task and not self._background_task.done():\n134:             self._background_task.cancel()\n135:             try:\n136:                 await self._background_task\n137:             except asyncio.CancelledError:\n138:                 pass\n139: \n140:     async def send_message(self, message: RealtimeUserInput) -> None:\n141:         \"\"\"Send a message to the model.\"\"\"\n142:         await self._model.send_message(message)\n143: \n144:     async def send_audio(self, audio: bytes, *, commit: bool = False) -> None:\n145:         \"\"\"Send a raw audio chunk to the model.\"\"\"\n146:         await self._model.send_audio(audio, commit=commit)\n147: \n148:     async def interrupt(self) -> None:\n149:         \"\"\"Interrupt the model.\"\"\"\n150:         await self._model.interrupt()\n151: \n152:     async def on_event(self, event: RealtimeModelEvent) -> None:\n153:         await self._put_event(RealtimeRawModelEvent(data=event, info=self._event_info))\n154: \n155:         if event.type == \"error\":\n156:             await self._put_event(RealtimeError(info=self._event_info, error=event.error))\n157:         elif event.type == \"function_call\":\n158:             # Handle tool calls in the background to avoid blocking event stream\n159:             self._background_task = asyncio.create_task(self._handle_tool_call(event))\n160:         elif event.type == \"audio\":\n161:             await self._put_event(RealtimeAudio(info=self._event_info, audio=event))\n162:         elif event.type == \"audio_interrupted\":\n163:             await self._put_event(RealtimeAudioInterrupted(info=self._event_info))\n164:         elif event.type == \"audio_done\":\n165:             await self._put_event(RealtimeAudioEnd(info=self._event_info))\n166:         elif event.type == \"conversation.item.input_audio_transcription.completed\":\n167:             self._history = self._get_new_history(self._history, event)\n168:             await self._put_event(\n169:                 RealtimeHistoryUpdated(info=self._event_info, history=self._history)\n170:             )\n171:         elif event.type == \"transcript_delta\":\n172:             # TODO (rm) Add guardrails\n173:             pass\n174:         elif event.type == \"item_updated\":\n175:             is_new = not any(item.item_id == event.item.item_id for item in self._history)\n176:             self._history = self._get_new_history(self._history, event.item)\n177:             if is_new:\n178:                 new_item = next(\n179:                     item for item in self._history if item.item_id == event.item.item_id\n180:                 )\n181:                 await self._put_event(RealtimeHistoryAdded(info=self._event_info, item=new_item))\n182:             else:\n183:                 await self._put_event(\n184:                     RealtimeHistoryUpdated(info=self._event_info, history=self._history)\n185:                 )\n186:         elif event.type == \"item_deleted\":\n187:             deleted_id = event.item_id\n188:             self._history = [item for item in self._history if item.item_id != deleted_id]\n189:             await self._put_event(\n190:                 RealtimeHistoryUpdated(info=self._event_info, history=self._history)\n191:             )\n192:         elif event.type == \"connection_status\":\n193:             pass\n194:         elif event.type == \"turn_started\":\n195:             await self._put_event(\n196:                 RealtimeAgentStartEvent(\n197:                     agent=self._current_agent,\n198:                     info=self._event_info,\n199:                 )\n200:             )\n201:         elif event.type == \"turn_ended\":\n202:             await self._put_event(\n203:                 RealtimeAgentEndEvent(\n204:                     agent=self._current_agent,\n205:                     info=self._event_info,\n206:                 )\n207:             )\n208:         elif event.type == \"other\":\n209:             pass\n210:         else:\n211:             assert_never(event)\n212: \n213:     async def _put_event(self, event: RealtimeSessionEvent) -> None:\n214:         \"\"\"Put an event into the queue.\"\"\"\n215:         await self._event_queue.put(event)\n216: \n217:     async def _handle_tool_call(self, event: RealtimeModelToolCallEvent) -> None:\n218:         \"\"\"Handle a tool call event.\"\"\"\n219:         all_tools = await self._current_agent.get_all_tools(self._context_wrapper)\n220:         function_map = {tool.name: tool for tool in all_tools if isinstance(tool, FunctionTool)}\n221:         handoff_map = {tool.name: tool for tool in all_tools if isinstance(tool, Handoff)}\n222: \n223:         if event.name in function_map:\n224:             await self._put_event(\n225:                 RealtimeToolStart(\n226:                     info=self._event_info,\n227:                     tool=function_map[event.name],\n228:                     agent=self._current_agent,\n229:                 )\n230:             )\n231: \n232:             func_tool = function_map[event.name]\n233:             tool_context = ToolContext.from_agent_context(self._context_wrapper, event.call_id)\n234:             result = await func_tool.on_invoke_tool(tool_context, event.arguments)\n235: \n236:             await self._model.send_tool_output(event, str(result), True)\n237: \n238:             await self._put_event(\n239:                 RealtimeToolEnd(\n240:                     info=self._event_info,\n241:                     tool=func_tool,\n242:                     output=result,\n243:                     agent=self._current_agent,\n244:                 )\n245:             )\n246:         elif event.name in handoff_map:\n247:             # TODO (rm) Add support for handoffs\n248:             pass\n249:         else:\n250:             # TODO (rm) Add error handling\n251:             pass\n252: \n253:     def _get_new_history(\n254:         self,\n255:         old_history: list[RealtimeItem],\n256:         event: RealtimeModelInputAudioTranscriptionCompletedEvent | RealtimeItem,\n257:     ) -> list[RealtimeItem]:\n258:         # Merge transcript into placeholder input_audio message.\n259:         if isinstance(event, RealtimeModelInputAudioTranscriptionCompletedEvent):\n260:             new_history: list[RealtimeItem] = []\n261:             for item in old_history:\n262:                 if item.item_id == event.item_id and item.type == \"message\" and item.role == \"user\":\n263:                     content: list[InputText | InputAudio] = []\n264:                     for entry in item.content:\n265:                         if entry.type == \"input_audio\":\n266:                             copied_entry = entry.model_copy(update={\"transcript\": event.transcript})\n267:                             content.append(copied_entry)\n268:                         else:\n269:                             content.append(entry)  # type: ignore\n270:                     new_history.append(\n271:                         item.model_copy(update={\"content\": content, \"status\": \"completed\"})\n272:                     )\n273:                 else:\n274:                     new_history.append(item)\n275:             return new_history\n276: \n277:         # Otherwise it's just a new item\n278:         # TODO (rm) Add support for audio storage config\n279: \n280:         # If the item already exists, update it\n281:         existing_index = next(\n282:             (i for i, item in enumerate(old_history) if item.item_id == event.item_id), None\n283:         )\n284:         if existing_index is not None:\n285:             new_history = old_history.copy()\n286:             new_history[existing_index] = event\n287:             return new_history\n288:         # Otherwise, insert it after the previous_item_id if that is set\n289:         elif event.previous_item_id:\n290:             # Insert the new item after the previous item\n291:             previous_index = next(\n292:                 (i for i, item in enumerate(old_history) if item.item_id == event.previous_item_id),\n293:                 None,\n294:             )\n295:             if previous_index is not None:\n296:                 new_history = old_history.copy()\n297:                 new_history.insert(previous_index + 1, event)\n298:                 return new_history\n299:         # Otherwise, add it to the end\n300:         return old_history + [event]\n\n(End of file - total 300 lines)\n</content>","metadata":{"preview":"from __future__ import annotations\n\nimport asyncio\nfrom collections.abc import AsyncIterator\nfrom typing import Any\n\nfrom typing_extensions import assert_never\n\nfrom ..handoffs import Handoff\nfrom ..run_context import RunContextWrapper, TContext\nfrom ..tool import FunctionTool\nfrom ..tool_context import ToolContext\nfrom .agent import RealtimeAgent\nfrom .config import RealtimeUserInput\nfrom .events import (\n    RealtimeAgentEndEvent,\n    RealtimeAgentStartEvent,\n    RealtimeAudio,\n    RealtimeAudioEnd,\n    RealtimeAudioInterrupted,","truncated":false,"loaded":[],"display":{"type":"file","path":"/testbed/src/agents/realtime/session.py","text":"from __future__ import annotations\n\nimport asyncio\nfrom collections.abc import AsyncIterator\nfrom typing import Any\n\nfrom typing_extensions import assert_never\n\nfrom ..handoffs import Handoff\nfrom ..run_context import RunContextWrapper, TContext\nfrom ..tool import FunctionTool\nfrom ..tool_context import ToolContext\nfrom .agent import RealtimeAgent\nfrom .config import RealtimeUserInput\nfrom .events import (\n    RealtimeAgentEndEvent,\n    RealtimeAgentStartEvent,\n    RealtimeAudio,\n    RealtimeAudioEnd,\n    RealtimeAudioInterrupted,\n    RealtimeError,\n    RealtimeEventInfo,\n    RealtimeHistoryAdded,\n    RealtimeHistoryUpdated,\n    RealtimeRawModelEvent,\n    RealtimeSessionEvent,\n    RealtimeToolEnd,\n    RealtimeToolStart,\n)\nfrom .items import InputAudio, InputText, RealtimeItem\nfrom .model import RealtimeModel, RealtimeModelConfig, RealtimeModelListener\nfrom .model_events import (\n    RealtimeModelEvent,\n    RealtimeModelInputAudioTranscriptionCompletedEvent,\n    RealtimeModelToolCallEvent,\n)\n\n\nclass RealtimeSession(RealtimeModelListener):\n    \"\"\"A connection to a realtime model. It streams events from the model to you, and allows you to\n    send messages and audio to the model.\n\n    Example:\n        ```python\n        runner = RealtimeRunner(agent)\n        async with await runner.run() as session:\n            # Send messages\n            await session.send_message(\"Hello\")\n            await session.send_audio(audio_bytes)\n\n            # Stream events\n            async for event in session:\n                if event.type == \"audio\":\n                    # Handle audio event\n                    pass\n        ```\n    \"\"\"\n\n    def __init__(\n        self,\n        model: RealtimeModel,\n        agent: RealtimeAgent,\n        context: TContext | None,\n        model_config: RealtimeModelConfig | None = None,\n    ) -> None:\n        \"\"\"Initialize the session.\n\n        Args:\n            model: The model to use.\n            agent: The current agent.\n            context_wrapper: The context wrapper.\n            event_info: Event info object.\n            history: The conversation history.\n            model_config: Model configuration.\n        \"\"\"\n        self._model = model\n        self._current_agent = agent\n        self._context_wrapper = RunContextWrapper(context)\n        self._event_info = RealtimeEventInfo(context=self._context_wrapper)\n        self._history: list[RealtimeItem] = []\n        self._model_config = model_config or {}\n        self._event_queue: asyncio.Queue[RealtimeSessionEvent] = asyncio.Queue()\n        self._closed = False\n        self._background_task: asyncio.Task[None] | None = None\n\n    async def __aenter__(self) -> RealtimeSession:\n        \"\"\"Start the session by connecting to the model. After this, you will be able to stream\n        events from the model and send messages and audio to the model.\n        \"\"\"\n        # Add ourselves as a listener\n        self._model.add_listener(self)\n\n        # Connect to the model\n        await self._model.connect(self._model_config)\n\n        # Emit initial history update\n        await self._put_event(\n            RealtimeHistoryUpdated(\n                history=self._history,\n                info=self._event_info,\n            )\n        )\n\n        return self\n\n    async def enter(self) -> RealtimeSession:\n        \"\"\"Enter the async context manager. We strongly recommend using the async context manager\n        pattern instead of this method. If you use this, you need to manually call `close()` when\n        you are done.\n        \"\"\"\n        return await self.__aenter__()\n\n    async def __aexit__(self, _exc_type: Any, _exc_val: Any, _exc_tb: Any) -> None:\n        \"\"\"End the session.\"\"\"\n        await self.close()\n\n    async def __aiter__(self) -> AsyncIterator[RealtimeSessionEvent]:\n        \"\"\"Iterate over events from the session.\"\"\"\n        while not self._closed:\n            try:\n                event = await self._event_queue.get()\n                yield event\n            except asyncio.CancelledError:\n                break\n\n    async def close(self) -> None:\n        \"\"\"Close the session.\"\"\"\n        self._closed = True\n        self._model.remove_listener(self)\n        await self._model.close()\n\n        # Cancel any background tasks\n        if self._background_task and not self._background_task.done():\n            self._background_task.cancel()\n            try:\n                await self._background_task\n            except asyncio.CancelledError:\n                pass\n\n    async def send_message(self, message: RealtimeUserInput) -> None:\n        \"\"\"Send a message to the model.\"\"\"\n        await self._model.send_message(message)\n\n    async def send_audio(self, audio: bytes, *, commit: bool = False) -> None:\n        \"\"\"Send a raw audio chunk to the model.\"\"\"\n        await self._model.send_audio(audio, commit=commit)\n\n    async def interrupt(self) -> None:\n        \"\"\"Interrupt the model.\"\"\"\n        await self._model.interrupt()\n\n    async def on_event(self, event: RealtimeModelEvent) -> None:\n        await self._put_event(RealtimeRawModelEvent(data=event, info=self._event_info))\n\n        if event.type == \"error\":\n            await self._put_event(RealtimeError(info=self._event_info, error=event.error))\n        elif event.type == \"function_call\":\n            # Handle tool calls in the background to avoid blocking event stream\n            self._background_task = asyncio.create_task(self._handle_tool_call(event))\n        elif event.type == \"audio\":\n            await self._put_event(RealtimeAudio(info=self._event_info, audio=event))\n        elif event.type == \"audio_interrupted\":\n            await self._put_event(RealtimeAudioInterrupted(info=self._event_info))\n        elif event.type == \"audio_done\":\n            await self._put_event(RealtimeAudioEnd(info=self._event_info))\n        elif event.type == \"conversation.item.input_audio_transcription.completed\":\n            self._history = self._get_new_history(self._history, event)\n            await self._put_event(\n                RealtimeHistoryUpdated(info=self._event_info, history=self._history)\n            )\n        elif event.type == \"transcript_delta\":\n            # TODO (rm) Add guardrails\n            pass\n        elif event.type == \"item_updated\":\n            is_new = not any(item.item_id == event.item.item_id for item in self._history)\n            self._history = self._get_new_history(self._history, event.item)\n            if is_new:\n                new_item = next(\n                    item for item in self._history if item.item_id == event.item.item_id\n                )\n                await self._put_event(RealtimeHistoryAdded(info=self._event_info, item=new_item))\n            else:\n                await self._put_event(\n                    RealtimeHistoryUpdated(info=self._event_info, history=self._history)\n                )\n        elif event.type == \"item_deleted\":\n            deleted_id = event.item_id\n            self._history = [item for item in self._history if item.item_id != deleted_id]\n            await self._put_event(\n                RealtimeHistoryUpdated(info=self._event_info, history=self._history)\n            )\n        elif event.type == \"connection_status\":\n            pass\n        elif event.type == \"turn_started\":\n            await self._put_event(\n                RealtimeAgentStartEvent(\n                    agent=self._current_agent,\n                    info=self._event_info,\n                )\n            )\n        elif event.type == \"turn_ended\":\n            await self._put_event(\n                RealtimeAgentEndEvent(\n                    agent=self._current_agent,\n                    info=self._event_info,\n                )\n            )\n        elif event.type == \"other\":\n            pass\n        else:\n            assert_never(event)\n\n    async def _put_event(self, event: RealtimeSessionEvent) -> None:\n        \"\"\"Put an event into the queue.\"\"\"\n        await self._event_queue.put(event)\n\n    async def _handle_tool_call(self, event: RealtimeModelToolCallEvent) -> None:\n        \"\"\"Handle a tool call event.\"\"\"\n        all_tools = await self._current_agent.get_all_tools(self._context_wrapper)\n        function_map = {tool.name: tool for tool in all_tools if isinstance(tool, FunctionTool)}\n        handoff_map = {tool.name: tool for tool in all_tools if isinstance(tool, Handoff)}\n\n        if event.name in function_map:\n            await self._put_event(\n                RealtimeToolStart(\n                    info=self._event_info,\n                    tool=function_map[event.name],\n                    agent=self._current_agent,\n                )\n            )\n\n            func_tool = function_map[event.name]\n            tool_context = ToolContext.from_agent_context(self._context_wrapper, event.call_id)\n            result = await func_tool.on_invoke_tool(tool_context, event.arguments)\n\n            await self._model.send_tool_output(event, str(result), True)\n\n            await self._put_event(\n                RealtimeToolEnd(\n                    info=self._event_info,\n                    tool=func_tool,\n                    output=result,\n                    agent=self._current_agent,\n                )\n            )\n        elif event.name in handoff_map:\n            # TODO (rm) Add support for handoffs\n            pass\n        else:\n            # TODO (rm) Add error handling\n            pass\n\n    def _get_new_history(\n        self,\n        old_history: list[RealtimeItem],\n        event: RealtimeModelInputAudioTranscriptionCompletedEvent | RealtimeItem,\n    ) -> list[RealtimeItem]:\n        # Merge transcript into placeholder input_audio message.\n        if isinstance(event, RealtimeModelInputAudioTranscriptionCompletedEvent):\n            new_history: list[RealtimeItem] = []\n            for item in old_history:\n                if item.item_id == event.item_id and item.type == \"message\" and item.role == \"user\":\n                    content: list[InputText | InputAudio] = []\n                    for entry in item.content:\n                        if entry.type == \"input_audio\":\n                            copied_entry = entry.model_copy(update={\"transcript\": event.transcript})\n                            content.append(copied_entry)\n                        else:\n                            content.append(entry)  # type: ignore\n                    new_history.append(\n                        item.model_copy(update={\"content\": content, \"status\": \"completed\"})\n                    )\n                else:\n                    new_history.append(item)\n            return new_history\n\n        # Otherwise it's just a new item\n        # TODO (rm) Add support for audio storage config\n\n        # If the item already exists, update it\n        existing_index = next(\n            (i for i, item in enumerate(old_history) if item.item_id == event.item_id), None\n        )\n        if existing_index is not None:\n            new_history = old_history.copy()\n            new_history[existing_index] = event\n            return new_history\n        # Otherwise, insert it after the previous_item_id if that is set\n        elif event.previous_item_id:\n            # Insert the new item after the previous item\n            previous_index = next(\n                (i for i, item in enumerate(old_history) if item.item_id == event.previous_item_id),\n                None,\n            )\n            if previous_index is not None:\n                new_history = old_history.copy()\n                new_history.insert(previous_index + 1, event)\n                return new_history\n        # Otherwise, add it to the end\n        return old_history + [event]","lineStart":1,"lineEnd":300,"totalLines":300,"truncated":false}},"title":"src/agents/realtime/session.py","time":{"start":1788503345707,"end":1788503345744}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_06b1b4a24001jd1HJc7naZ82wE","sessionID":"ses_f94e4d0f6ffeQOYRYclieGJzVe","messageID":"msg_06b1b4376001g5A5VKgeGC1Mys"}}
