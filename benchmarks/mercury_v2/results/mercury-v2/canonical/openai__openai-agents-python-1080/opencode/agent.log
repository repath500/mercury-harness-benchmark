{"type":"tool_use","timestamp":1788503479335,"sessionID":"ses_f94e4d0f6ffeQOYRYclieGJzVe","part":{"type":"tool","tool":"write","callID":"call_b9bc58372b4244a69ca0e533","state":{"status":"completed","input":{"content":"import asyncio\nimport json\nfrom typing import Any\n\nimport pytest\n\nfrom agents.realtime.agent import RealtimeAgent\nfrom agents.realtime.items import AssistantMessageItem, InputAudio, InputText, UserMessageItem\nfrom agents.realtime.model import RealtimeModel\nfrom agents.realtime.model_events import (\n    RealtimeModelInputAudioTranscriptionCompletedEvent,\n    RealtimeModelToolCallEvent,\n)\nfrom agents.realtime.session import RealtimeSession\nfrom agents.tool import function_tool\n\n\nclass EventRecordingModel(RealtimeModel):\n    \"\"\"A fake realtime model that records interactions for testing.\"\"\"\n\n    def __init__(self) -> None:\n        self.listeners: list[Any] = []\n        self.closed = False\n        self.tool_outputs: list[tuple[RealtimeModelToolCallEvent, str, bool]] = []\n\n    async def connect(self, options=None):\n        pass\n\n    def add_listener(self, listener):\n        self.listeners.append(listener)\n\n    def remove_listener(self, listener):\n        if listener in self.listeners:\n            self.listeners.remove(listener)\n\n    async def send_event(self, event):\n        pass\n\n    async def send_message(self, message, other_event_data=None):\n        pass\n\n    async def send_audio(self, audio, commit=False):\n        pass\n\n    async def send_tool_output(self, tool_call, output, start_response=True):\n        self.tool_outputs.append((tool_call, output, start_response))\n\n    async def interrupt(self):\n        pass\n\n    async def close(self):\n        self.closed = True\n\n    async def emit(self, event):\n        for listener in list(self.listeners):\n            await listener.on_event(event)\n\n\ndef create_session(model: RealtimeModel) -> RealtimeSession:\n    agent = RealtimeAgent(name=\"Test\", instructions=\"Test instructions\", tools=[])\n    return RealtimeSession(model=model, agent=agent, context=None)\n\n\n@function_tool\ndef get_weather(city: str) -> str:\n    \"\"\"Get the weather for a city.\"\"\"\n    return f\"The weather in {city} is sunny\"\n\n\n@pytest.mark.asyncio\nasync def test_function_call_is_handled_inline_without_background_task():\n    \"\"\"Tool calls should be processed directly in the event flow, not via background tasks.\"\"\"\n    model = EventRecordingModel()\n    session = create_session(model)\n    session._current_agent = RealtimeAgent(\n        name=\"Test\", instructions=\"Test instructions\", tools=[get_weather]\n    )\n\n    await session.__aenter__()\n\n    assert not hasattr(session, \"_background_task\")\n\n    tool_call_event = RealtimeModelToolCallEvent(\n        name=\"get_weather\",\n        call_id=\"call_1\",\n        arguments=json.dumps({\"city\": \"Tokyo\"}),\n    )\n\n    await model.emit(tool_call_event)\n\n    # The tool call should be fully processed by the time on_event returns.\n    assert len(model.tool_outputs) == 1\n    assert model.tool_outputs[0][0] is tool_call_event\n    assert \"sunny\" in model.tool_outputs[0][1]\n\n    session_events = []\n    while not session._event_queue.empty():\n        session_events.append(session._event_queue.get_nowait())\n\n    event_types = [event.type for event in session_events]\n    assert \"tool_start\" in event_types\n    assert \"tool_end\" in event_types\n    assert event_types.index(\"tool_start\") < event_types.index(\"tool_end\")\n\n    await session.close()\n\n\n@pytest.mark.asyncio\nasync def test_close_removes_listener_and_closes_model_without_task_cancellation():\n    \"\"\"Closing the session should not attempt to cancel any background tasks.\"\"\"\n    model = EventRecordingModel()\n    session = create_session(model)\n\n    await session.__aenter__()\n    assert session in model.listeners\n\n    await session.close()\n\n    assert session._closed\n    assert session not in model.listeners\n    assert model.closed\n\n\ndef test_get_new_history_can_be_called_as_classmethod():\n    \"\"\"_get_new_history should be callable directly on the class.\"\"\"\n    item = UserMessageItem(\n        item_id=\"item_1\",\n        content=[InputText(text=\"hello\")],\n    )\n\n    result = RealtimeSession._get_new_history([], item)\n\n    assert result == [item]\n\n\ndef test_get_new_history_updates_existing_item():\n    \"\"\"An event whose item already exists should replace it, not duplicate it.\"\"\"\n    existing = AssistantMessageItem(\n        item_id=\"item_1\",\n        status=\"in_progress\",\n        content=[InputText(text=\"old\")],\n    )\n    updated = AssistantMessageItem(\n        item_id=\"item_1\",\n        status=\"completed\",\n        content=[InputText(text=\"new\")],\n    )\n\n    result = RealtimeSession._get_new_history([existing], updated)\n\n    assert result == [updated]\n    assert len(result) == 1\n\n\ndef test_get_new_history_inserts_after_previous_item():\n    \"\"\"A new item should be inserted after previous_item_id when set.\"\"\"\n    first = AssistantMessageItem(item_id=\"item_1\", content=[InputText(text=\"first\")])\n    third = AssistantMessageItem(item_id=\"item_3\", content=[InputText(text=\"third\")])\n    second = AssistantMessageItem(\n        item_id=\"item_2\",\n        previous_item_id=\"item_1\",\n        content=[InputText(text=\"second\")],\n    )\n\n    result = RealtimeSession._get_new_history([first, third], second)\n\n    assert [item.item_id for item in result] == [\"item_1\", \"item_2\", \"item_3\"]\n\n\ndef test_get_new_history_appends_when_previous_item_not_found():\n    \"\"\"When previous_item_id is not in history, the item goes to the end.\"\"\"\n    existing = AssistantMessageItem(item_id=\"item_1\", content=[InputText(text=\"first\")])\n    new_item = AssistantMessageItem(\n        item_id=\"item_2\",\n        previous_item_id=\"unknown\",\n        content=[InputText(text=\"second\")],\n    )\n\n    result = RealtimeSession._get_new_history([existing], new_item)\n\n    assert [item.item_id for item in result] == [\"item_1\", \"item_2\"]\n\n\n@pytest.mark.asyncio\nasync def test_audio_transcription_completed_updates_session_history():\n    \"\"\"A completed transcription should merge the transcript into the placeholder item.\"\"\"\n    model = EventRecordingModel()\n    session = create_session(model)\n\n    await session.__aenter__()\n\n    placeholder = UserMessageItem(\n        item_id=\"item_1\",\n        content=[InputAudio(audio=\"abc\")],\n    )\n    session._history = [placeholder]\n\n    transcription_event = RealtimeModelInputAudioTranscriptionCompletedEvent(\n        item_id=\"item_1\",\n        transcript=\"hello there\",\n    )\n\n    await model.emit(transcription_event)\n\n    assert len(session._history) == 1\n    updated_item = session._history[0]\n    assert updated_item.type == \"message\" and updated_item.role == \"user\"\n    assert updated_item.content[0].type == \"input_audio\"\n    assert updated_item.content[0].transcript == \"hello there\"\n\n    session_events = []\n    while not session._event_queue.empty():\n        session_events.append(session._event_queue.get_nowait())\n\n    history_updates = [event for event in session_events if event.type == \"history_updated\"]\n    assert len(history_updates) == 1\n    assert history_updates[0].history == session._history\n\n    await session.close()\n\n\n@pytest.mark.asyncio\nasync def test_audio_transcription_completed_without_matching_item_is_noop():\n    \"\"\"A transcription for an unknown item should leave the history unchanged.\"\"\"\n    model = EventRecordingModel()\n    session = create_session(model)\n\n    await session.__aenter__()\n\n    existing = UserMessageItem(\n        item_id=\"item_1\",\n        content=[InputText(text=\"hello\")],\n    )\n    session._history = [existing]\n\n    transcription_event = RealtimeModelInputAudioTranscriptionCompletedEvent(\n        item_id=\"item_unknown\",\n        transcript=\"hello there\",\n    )\n\n    await model.emit(transcription_event)\n\n    assert session._history == [existing]\n\n    await session.close()\n","filePath":"/testbed/tests/realtime/test_session.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/testbed/tests/realtime/test_session.py","exists":false,"truncated":false},"title":"tests/realtime/test_session.py","time":{"start":1788503479319,"end":1788503479330}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me write the test file `tests/realtime/test_session.py`. I'll cover:\n\n1. `test_function_call_handled_inline` - tool call processed in the main flow (no background task created; session has no `_background_task` attribute; ToolStart/ToolEnd events emitted synchronously)\n2. `test_get_new_history_is_classmethod` - the method can be called as a class method\n3. `test_history_update_on_audio_transcription` - replacing existing items (transcript merged into placeholder)\n4. `test_get_new_history_inserts_at_position` - insertion based on previous_item_id\n5. `test_close_does_not_cancel_background_tasks` - close just removes listener and closes model\n\nLet me check how the `@function_tool` decorator works for creating a FunctionTool for the test.","format":"unknown","index":0}]}},"id":"prt_06b1d5411001sMw45LmQz90EoG","sessionID":"ses_f94e4d0f6ffeQOYRYclieGJzVe","messageID":"msg_06b1cbf0d001D30Xx01X3UiInl"}}
