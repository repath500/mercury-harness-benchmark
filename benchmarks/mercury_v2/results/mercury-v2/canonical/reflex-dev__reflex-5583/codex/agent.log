       self._pages[route] = component\n   868\t\n   869\t\n   870\t        Based on conflicts that React Router would throw if not intercepted.\n   871\t\n   872\t        Raises:\n   873\t            RouteValueError: exception showing which conflict exist with the route to be added\n   874\t\n   875\t        Args:\n   876\t            new_route: the route being newly added.\n   877\t        \"\"\"\n   878\t        from reflex.utils.exceptions import RouteValueError\n   879\t\n   880\t        if \"[\" not in new_route:\n   881\t            return\n   882\t\n   883\t        segments = (\n   884\t            constants.RouteRegex.SINGLE_SEGMENT,\n   885\t            constants.RouteRegex.DOUBLE_SEGMENT,\n   886\t            constants.RouteRegex.DOUBLE_CATCHALL_SEGMENT,\n   887\t        )\n   888\t        for route in self._pages:\n   889\t            replaced_route = replace_brackets_with_keywords(route)\n   890\t            for rw, r, nr in zip(\n   891\t                replaced_route.split(\"/\"),\n   892\t                route.split(\"/\"),\n   893\t                new_route.split(\"/\"),\n   894\t                strict=False,\n   895\t            ):\n   896\t                if rw in segments and r != nr:\n   897\t                    # If the slugs in the segments of both routes are not the same, then the route is invalid\n   898\t                    msg = f\"You cannot use different slug names for the same dynamic path in  {route} and {new_route} ('{r}' != '{nr}')\"\n   899\t                    raise RouteValueError(msg)\n   900\t                if rw not in segments and r != nr:\n   901\t                    # if the section being compared in both routes is not a dynamic segment(i.e not wrapped in brackets)\n   902\t                    # then we are guaranteed that the route is valid and there's no need checking the rest.\n   903\t                    # eg. /posts/[id]/info/[slug1] and /posts/[id]/info1/[slug1] is always going to be valid since\n   904\t                    # info1 will break away into its own tree.\n   905\t                    break\n   906\t\n   907\t    def _setup_admin_dash(self):\n   908\t        \"\"\"Setup the admin dash.\"\"\"\n   909\t        try:\n   910\t            from starlette_admin.contrib.sqla.admin import Admin\n   911\t            from starlette_admin.contrib.sqla.view import ModelView\n   912\t        except ImportError:\n   913\t            return\n   914\t\n   915\t        # Get the admin dash.\n   916\t        if not self._api:\n   917\t            return\n   918\t\n   919\t        admin_dash = self.admin_dash\n   920\t\n   921\t        if admin_dash and admin_dash.models:\n   922\t            # Build the admin dashboard\n   923\t            admin = (\n   924\t                admin_dash.admin\n   925\t                if admin_dash.admin\n   926\t                else Admin(\n   927\t                    engine=Model.get_db_engine(),\n   928\t                    title=\"Reflex Admin Dashboard\",\n   929\t                    logo_url=\"https://reflex.dev/Reflex.svg\",\n   930\t                )\n   931\t            )\n   932\t\n   933\t            for model in admin_dash.models:\n   934\t                view = admin_dash.view_overrides.get(model, ModelView)\n   935\t                admin.add_view(view(model))\n   936\t\n   937\t            admin.mount_to(self._api)\n   938\t\n   939\t    def _get_frontend_packages(self, imports: dict[str, set[ImportVar]]):\n   940\t        \"\"\"Gets the frontend packages to be installed and filters out the unnecessary ones.\n   941\t\n   942\t        Args:\n   943\t            imports: A dictionary containing the imports used in the current page.\n   944\t\n   945\t        Example:\n   946\t            >>> _get_frontend_packages({\"react\": \"16.14.0\", \"react-dom\": \"16.14.0\"})\n   947\t        \"\"\"\n   948\t        dependencies = constants.PackageJson.DEPENDENCIES\n   949\t        dev_dependencies = constants.PackageJson.DEV_DEPENDENCIES\n   950\t        page_imports = {\n   951\t            i\n   952\t            for i, tags in imports.items()\n   953\t            if i not in dependencies\n   954\t            and i not in dev_dependencies\n   955\t            and not any(i.startswith(prefix) for prefix in [\"/\", \"$/\", \".\"])\n   956\t            and i != \"\"\n   957\t            and any(tag.install for tag in tags)\n   958\t        }\n   959\t        pinned = {i.rpartition(\"@\")[0] for i in page_imports if \"@\" in i}\n   960\t        page_imports = {i for i in page_imports if i not in pinned}\n","exit_code":0,"status":"completed"}}
