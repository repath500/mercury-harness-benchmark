+def test_app_disable_state():
+    """Test that state stays disabled even for stateful-looking pages."""
+    app = App(enable_state=False)
+    app.add_page(rx.box("Index"), route="/")
+    app.add_page(
+        rx.box(rx.text(GenState.value)), route="/stateful", on_load=rx.console_log("")
+    )
+    app._compile_page("stateful")
+
+    assert app._state_enabled is False
+    assert app._state is None
+    assert app._state_manager is None
+    assert app.get_load_events("/stateful")
+
