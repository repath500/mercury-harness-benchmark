@@ -1527,6 +1528,47 @@ def test_app_state_manager():
     )
 
 
+def test_app_enable_state_disabled():
+    """State can be disabled at the app level and stays disabled."""
+    app = App(enable_state=False)
+    assert app.enable_state is False
+
+    # _enable_state is a no-op when state is disabled.
+    app._enable_state()
+    assert app._state is None
+    assert app._state_manager is None
+    with pytest.raises(ValueError):
+        _ = app.state_manager
+
+    # App initialization skipped state setup.
+    assert app._event_namespace is None
+
+
+def test_app_enable_state_disabled_compile_page():
+    """Pages are compiled without state processing when state is disabled."""
+    app = App(enable_state=False)
+
+    def index():
+        return rx.box("Index")
+
+    def stateful_page():
+        return rx.box("Stateful")
+
+    app.add_page(index, route="/", on_load=lambda: None)
+    app.add_page(stateful_page, route="/stateful")
+
+    n_states_before = len(all_base_state_classes)
+    app._compile_page("index")
+    app._compile_page("stateful")
+
+    # State was not enabled, even for pages that look stateful.
+    assert app._state is None
+    assert app._stateful_pages == {}
+    assert len(all_base_state_classes) == n_states_before
+    assert "index" in app._pages
+    assert "stateful" in app._pages
+
+
 def test_generate_component():
     def index():
         return rx.box("Index")
