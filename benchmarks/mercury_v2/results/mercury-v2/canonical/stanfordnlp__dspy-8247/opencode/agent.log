{"type":"tool_use","timestamp":1788458519743,"sessionID":"ses_f97919226ffeSaD2Vc16sHo0wL","part":{"type":"tool","tool":"read","callID":"call_396dea05283a41f4a13532e2","state":{"status":"completed","input":{"filePath":"/testbed/tests/predict/test_predict.py"},"output":"<path>/testbed/tests/predict/test_predict.py</path>\n<type>file</type>\n<content>\n1: import copy\n2: import enum\n3: from datetime import datetime\n4: from unittest.mock import patch\n5: \n6: import pydantic\n7: import pytest\n8: import ujson\n9: from litellm import ModelResponse\n10: \n11: import dspy\n12: from dspy import Predict, Signature\n13: from dspy.utils.dummies import DummyLM\n14: \n15: \n16: def test_initialization_with_string_signature():\n17:     signature_string = \"input1, input2 -> output\"\n18:     predict = Predict(signature_string)\n19:     expected_instruction = \"Given the fields `input1`, `input2`, produce the fields `output`.\"\n20:     assert predict.signature.instructions == expected_instruction\n21:     assert predict.signature.instructions == Signature(signature_string).instructions\n22: \n23: \n24: def test_reset_method():\n25:     predict_instance = Predict(\"input -> output\")\n26:     predict_instance.lm = \"modified\"\n27:     predict_instance.traces = [\"trace\"]\n28:     predict_instance.train = [\"train\"]\n29:     predict_instance.demos = [\"demo\"]\n30:     predict_instance.reset()\n31:     assert predict_instance.lm is None\n32:     assert predict_instance.traces == []\n33:     assert predict_instance.train == []\n34:     assert predict_instance.demos == []\n35: \n36: \n37: def test_lm_after_dump_and_load_state():\n38:     predict_instance = Predict(\"input -> output\")\n39:     lm = dspy.LM(\n40:         model=\"openai/gpt-4o-mini\",\n41:         model_type=\"chat\",\n42:         temperature=1,\n43:         max_tokens=100,\n44:         num_retries=10,\n45:     )\n46:     predict_instance.lm = lm\n47:     expected_lm_state = {\n48:         \"model\": \"openai/gpt-4o-mini\",\n49:         \"model_type\": \"chat\",\n50:         \"temperature\": 1,\n51:         \"max_tokens\": 100,\n52:         \"num_retries\": 10,\n53:         \"cache\": True,\n54:         \"cache_in_memory\": True,\n55:         \"finetuning_model\": None,\n56:         \"launch_kwargs\": {},\n57:         \"train_kwargs\": {},\n58:     }\n59:     assert lm.dump_state() == expected_lm_state\n60:     dumped_state = predict_instance.dump_state()\n61:     new_instance = Predict(\"input -> output\")\n62:     new_instance.load_state(dumped_state)\n63:     assert new_instance.lm.dump_state() == expected_lm_state\n64: \n65: \n66: def test_call_method():\n67:     predict_instance = Predict(\"input -> output\")\n68:     lm = DummyLM([{\"output\": \"test output\"}])\n69:     dspy.settings.configure(lm=lm)\n70:     result = predict_instance(input=\"test input\")\n71:     assert result.output == \"test output\"\n72: \n73: \n74: def test_instructions_after_dump_and_load_state():\n75:     predict_instance = Predict(Signature(\"input -> output\", \"original instructions\"))\n76:     dumped_state = predict_instance.dump_state()\n77:     new_instance = Predict(Signature(\"input -> output\", \"new instructions\"))\n78:     new_instance.load_state(dumped_state)\n79:     assert new_instance.signature.instructions == \"original instructions\"\n80: \n81: \n82: def test_demos_after_dump_and_load_state():\n83:     class TranslateToEnglish(dspy.Signature):\n84:         \"\"\"Translate content from a language to English.\"\"\"\n85: \n86:         content: str = dspy.InputField()\n87:         language: str = dspy.InputField()\n88:         translation: str = dspy.OutputField()\n89: \n90:     original_instance = Predict(TranslateToEnglish)\n91:     original_instance.demos = [\n92:         dspy.Example(\n93:             content=\"¿Qué tal?\",\n94:             language=\"SPANISH\",\n95:             translation=\"Hello there\",\n96:         ).with_inputs(\"content\", \"language\"),\n97:     ]\n98: \n99:     dumped_state = original_instance.dump_state()\n100:     assert len(dumped_state[\"demos\"]) == len(original_instance.demos)\n101:     assert dumped_state[\"demos\"][0][\"content\"] == original_instance.demos[0].content\n102: \n103:     saved_state = ujson.dumps(dumped_state)\n104:     loaded_state = ujson.loads(saved_state)\n105: \n106:     new_instance = Predict(TranslateToEnglish)\n107:     new_instance.load_state(loaded_state)\n108:     assert len(new_instance.demos) == len(original_instance.demos)\n109:     # Demos don't need to keep the same types after saving and loading the state.\n110:     assert new_instance.demos[0][\"content\"] == original_instance.demos[0].content\n111: \n112: \n113: def test_typed_demos_after_dump_and_load_state():\n114:     class Item(pydantic.BaseModel):\n115:         name: str\n116:         quantity: int\n117: \n118:     class InventorySignature(dspy.Signature):\n119:         \"\"\"Handle inventory items and their translations.\"\"\"\n120: \n121:         items: list[Item] = dspy.InputField()\n122:         language: str = dspy.InputField()\n123:         translated_items: list[Item] = dspy.OutputField()\n124:         total_quantity: int = dspy.OutputField()\n125: \n126:     original_instance = Predict(InventorySignature)\n127:     original_instance.demos = [\n128:         dspy.Example(\n129:             items=[Item(name=\"apple\", quantity=5), Item(name=\"banana\", quantity=3)],\n130:             language=\"SPANISH\",\n131:             translated_items=[Item(name=\"manzana\", quantity=5), Item(name=\"plátano\", quantity=3)],\n132:             total_quantity=8,\n133:         ).with_inputs(\"items\", \"language\"),\n134:     ]\n135: \n136:     # Test dump_state\n137:     dumped_state = original_instance.dump_state()\n138:     assert len(dumped_state[\"demos\"]) == len(original_instance.demos)\n139:     # Verify the input items were properly serialized\n140:     assert isinstance(dumped_state[\"demos\"][0][\"items\"], list)\n141:     assert len(dumped_state[\"demos\"][0][\"items\"]) == 2\n142:     assert dumped_state[\"demos\"][0][\"items\"][0] == {\"name\": \"apple\", \"quantity\": 5}\n143: \n144:     # Test serialization/deserialization\n145:     saved_state = ujson.dumps(dumped_state)\n146:     loaded_state = ujson.loads(saved_state)\n147: \n148:     # Test load_state\n149:     new_instance = Predict(InventorySignature)\n150:     new_instance.load_state(loaded_state)\n151:     assert len(new_instance.demos) == len(original_instance.demos)\n152: \n153:     # Verify the structure is maintained after loading\n154:     loaded_demo = new_instance.demos[0]\n155:     assert isinstance(loaded_demo[\"items\"], list)\n156:     assert len(loaded_demo[\"items\"]) == 2\n157:     assert loaded_demo[\"items\"][0][\"name\"] == \"apple\"\n158:     assert loaded_demo[\"items\"][0][\"quantity\"] == 5\n159:     assert loaded_demo[\"items\"][1][\"name\"] == \"banana\"\n160:     assert loaded_demo[\"items\"][1][\"quantity\"] == 3\n161: \n162:     # Verify output items were also properly maintained\n163:     assert isinstance(loaded_demo[\"translated_items\"], list)\n164:     assert len(loaded_demo[\"translated_items\"]) == 2\n165:     assert loaded_demo[\"translated_items\"][0][\"name\"] == \"manzana\"\n166:     assert loaded_demo[\"translated_items\"][1][\"name\"] == \"plátano\"\n167: \n168: \n169: # def test_typed_demos_after_dump_and_load_state():\n170: #     class TypedTranslateToEnglish(dspy.Signature):\n171: #         \"\"\"Translate content from a language to English.\"\"\"\n172: \n173: #         class Input(pydantic.BaseModel):\n174: #             content: str\n175: #             language: str\n176: \n177: #         class Output(pydantic.BaseModel):\n178: #             translation: str\n179: \n180: #         input: Input = dspy.InputField()\n181: #         output: Output = dspy.OutputField()\n182: \n183: #     original_instance = TypedPredictor(TypedTranslateToEnglish).predictor\n184: #     original_instance.demos = [\n185: #         dspy.Example(\n186: #             input=TypedTranslateToEnglish.Input(\n187: #                 content=\"¿Qué tal?\",\n188: #                 language=\"SPANISH\",\n189: #             ),\n190: #             output=TypedTranslateToEnglish.Output(\n191: #                 translation=\"Hello there\",\n192: #             ),\n193: #         ).with_inputs(\"input\"),\n194: #     ]\n195: \n196: #     dumped_state = original_instance.dump_state()\n197: #     assert len(dumped_state[\"demos\"]) == len(original_instance.demos)\n198: #     assert dumped_state[\"demos\"][0][\"input\"] == original_instance.demos[0].input.model_dump_json()\n199: \n200: #     saved_state = ujson.dumps(dumped_state)\n201: #     loaded_state = ujson.loads(saved_state)\n202: \n203: #     new_instance = TypedPredictor(TypedTranslateToEnglish).predictor\n204: #     new_instance.load_state(loaded_state)\n205: #     assert len(new_instance.demos) == len(original_instance.demos)\n206: #     # Demos don't need to keep the same types after saving and loading the state.\n207: #     assert new_instance.demos[0][\"input\"] == original_instance.demos[0].input.model_dump_json()\n208: \n209: \n210: def test_signature_fields_after_dump_and_load_state(tmp_path):\n211:     class CustomSignature(dspy.Signature):\n212:         \"\"\"I am just an instruction.\"\"\"\n213: \n214:         sentence = dspy.InputField(desc=\"I am an innocent input!\")\n215:         sentiment = dspy.OutputField()\n216: \n217:     file_path = tmp_path / \"tmp.json\"\n218:     original_instance = Predict(CustomSignature)\n219:     original_instance.save(file_path)\n220: \n221:     class CustomSignature2(dspy.Signature):\n222:         \"\"\"I am not a pure instruction.\"\"\"\n223: \n224:         sentence = dspy.InputField(desc=\"I am a malicious input!\")\n225:         sentiment = dspy.OutputField(desc=\"I am a malicious output!\", prefix=\"I am a prefix!\")\n226: \n227:     new_instance = Predict(CustomSignature2)\n228:     assert new_instance.signature.dump_state() != original_instance.signature.dump_state()\n229:     # After loading, the fields should be the same.\n230:     new_instance.load(file_path)\n231:     assert new_instance.signature.dump_state() == original_instance.signature.dump_state()\n232: \n233: \n234: @pytest.mark.parametrize(\"filename\", [\"model.json\", \"model.pkl\"])\n235: def test_lm_field_after_dump_and_load_state(tmp_path, filename):\n236:     file_path = tmp_path / filename\n237:     lm = dspy.LM(\n238:         model=\"openai/gpt-4o-mini\",\n239:         model_type=\"chat\",\n240:         temperature=1,\n241:         max_tokens=100,\n242:         num_retries=10,\n243:     )\n244:     original_predict = dspy.Predict(\"q->a\")\n245:     original_predict.lm = lm\n246: \n247:     original_predict.save(file_path)\n248: \n249:     assert file_path.exists()\n250: \n251:     loaded_predict = dspy.Predict(\"q->a\")\n252:     loaded_predict.load(file_path)\n253: \n254:     assert original_predict.dump_state() == loaded_predict.dump_state()\n255: \n256: \n257: def test_forward_method():\n258:     program = Predict(\"question -> answer\")\n259:     dspy.settings.configure(lm=DummyLM([{\"answer\": \"No more responses\"}]))\n260:     result = program(question=\"What is 1+1?\").answer\n261:     assert result == \"No more responses\"\n262: \n263: \n264: def test_forward_method2():\n265:     program = Predict(\"question -> answer1, answer2\")\n266:     dspy.settings.configure(lm=DummyLM([{\"answer1\": \"my first answer\", \"answer2\": \"my second answer\"}]))\n267:     result = program(question=\"What is 1+1?\")\n268:     assert result.answer1 == \"my first answer\"\n269:     assert result.answer2 == \"my second answer\"\n270: \n271: \n272: def test_config_management():\n273:     predict_instance = Predict(\"input -> output\")\n274:     predict_instance.update_config(new_key=\"value\")\n275:     config = predict_instance.get_config()\n276:     assert \"new_key\" in config and config[\"new_key\"] == \"value\"\n277: \n278: \n279: def test_multi_output():\n280:     program = Predict(\"question -> answer\", n=2)\n281:     dspy.settings.configure(lm=DummyLM([{\"answer\": \"my first answer\"}, {\"answer\": \"my second answer\"}]))\n282:     results = program(question=\"What is 1+1?\")\n283:     assert results.completions.answer[0] == \"my first answer\"\n284:     assert results.completions.answer[1] == \"my second answer\"\n285: \n286: \n287: def test_multi_output2():\n288:     program = Predict(\"question -> answer1, answer2\", n=2)\n289:     dspy.settings.configure(\n290:         lm=DummyLM(\n291:             [\n292:                 {\"answer1\": \"my 0 answer\", \"answer2\": \"my 2 answer\"},\n293:                 {\"answer1\": \"my 1 answer\", \"answer2\": \"my 3 answer\"},\n294:             ],\n295:         )\n296:     )\n297:     results = program(question=\"What is 1+1?\")\n298:     assert results.completions.answer1[0] == \"my 0 answer\"\n299:     assert results.completions.answer1[1] == \"my 1 answer\"\n300:     assert results.completions.answer2[0] == \"my 2 answer\"\n301:     assert results.completions.answer2[1] == \"my 3 answer\"\n302: \n303: \n304: def test_datetime_inputs_and_outputs():\n305:     # Define a model for datetime inputs and outputs\n306:     class TimedEvent(pydantic.BaseModel):\n307:         event_name: str\n308:         event_time: datetime\n309: \n310:     class TimedSignature(dspy.Signature):\n311:         events: list[TimedEvent] = dspy.InputField()\n312:         summary: str = dspy.OutputField()\n313:         next_event_time: datetime = dspy.OutputField()\n314: \n315:     program = Predict(TimedSignature)\n316: \n317:     lm = DummyLM(\n318:         [\n319:             {\n320:                 \"reasoning\": \"Processed datetime inputs\",\n321:                 \"summary\": \"All events are processed\",\n322:                 \"next_event_time\": \"2024-11-27T14:00:00\",\n323:             }\n324:         ]\n325:     )\n326:     dspy.settings.configure(lm=lm)\n327: \n328:     output = program(\n329:         events=[\n330:             TimedEvent(event_name=\"Event 1\", event_time=datetime(2024, 11, 25, 10, 0, 0)),\n331:             TimedEvent(event_name=\"Event 2\", event_time=datetime(2024, 11, 25, 15, 30, 0)),\n332:         ]\n333:     )\n334:     assert output.summary == \"All events are processed\"\n335:     assert output.next_event_time == datetime(2024, 11, 27, 14, 0, 0)\n336: \n337: \n338: def test_explicitly_valued_enum_inputs_and_outputs():\n339:     class Status(enum.Enum):\n340:         PENDING = \"pending\"\n341:         IN_PROGRESS = \"in_progress\"\n342:         COMPLETED = \"completed\"\n343: \n344:     class StatusSignature(dspy.Signature):\n345:         current_status: Status = dspy.InputField()\n346:         next_status: Status = dspy.OutputField()\n347: \n348:     program = Predict(StatusSignature)\n349: \n350:     lm = DummyLM(\n351:         [\n352:             {\n353:                 \"reasoning\": \"The current status is 'PENDING', advancing to 'IN_PROGRESS'.\",\n354:                 \"next_status\": \"in_progress\",\n355:             }\n356:         ]\n357:     )\n358:     dspy.settings.configure(lm=lm)\n359: \n360:     output = program(current_status=Status.PENDING)\n361:     assert output.next_status == Status.IN_PROGRESS\n362: \n363: \n364: def test_enum_inputs_and_outputs_with_shared_names_and_values():\n365:     class TicketStatus(enum.Enum):\n366:         OPEN = \"CLOSED\"\n367:         CLOSED = \"RESOLVED\"\n368:         RESOLVED = \"OPEN\"\n369: \n370:     class TicketStatusSignature(dspy.Signature):\n371:         current_status: TicketStatus = dspy.InputField()\n372:         next_status: TicketStatus = dspy.OutputField()\n373: \n374:     program = Predict(TicketStatusSignature)\n375: \n376:     # Mock reasoning and output\n377:     lm = DummyLM(\n378:         [\n379:             {\n380:                 \"reasoning\": \"The ticket is currently 'OPEN', transitioning to 'CLOSED'.\",\n381:                 \"next_status\": \"RESOLVED\",  # Refers to TicketStatus.CLOSED by value\n382:             }\n383:         ]\n384:     )\n385:     dspy.settings.configure(lm=lm)\n386: \n387:     output = program(current_status=TicketStatus.OPEN)\n388:     assert output.next_status == TicketStatus.CLOSED  # By value\n389: \n390: \n391: def test_auto_valued_enum_inputs_and_outputs():\n392:     Status = enum.Enum(\"Status\", [\"PENDING\", \"IN_PROGRESS\", \"COMPLETED\"])  # noqa: N806\n393: \n394:     class StatusSignature(dspy.Signature):\n395:         current_status: Status = dspy.InputField()\n396:         next_status: Status = dspy.OutputField()\n397: \n398:     program = Predict(StatusSignature)\n399: \n400:     lm = DummyLM(\n401:         [\n402:             {\n403:                 \"reasoning\": \"The current status is 'PENDING', advancing to 'IN_PROGRESS'.\",\n404:                 \"next_status\": \"IN_PROGRESS\",  # Use the auto-assigned value for IN_PROGRESS\n405:             }\n406:         ]\n407:     )\n408:     dspy.settings.configure(lm=lm)\n409: \n410:     output = program(current_status=Status.PENDING)\n411:     assert output.next_status == Status.IN_PROGRESS\n412: \n413: \n414: def test_named_predictors():\n415:     class MyModule(dspy.Module):\n416:         def __init__(self):\n417:             super().__init__()\n418:             self.inner = Predict(\"question -> answer\")\n419: \n420:     program = MyModule()\n421:     assert program.named_predictors() == [(\"inner\", program.inner)]\n422: \n423:     # Check that it also works the second time.\n424:     program2 = copy.deepcopy(program)\n425:     assert program2.named_predictors() == [(\"inner\", program2.inner)]\n426: \n427: \n428: def test_output_only():\n429:     class OutputOnlySignature(dspy.Signature):\n430:         output = dspy.OutputField()\n431: \n432:     predictor = Predict(OutputOnlySignature)\n433: \n434:     lm = DummyLM([{\"output\": \"short answer\"}])\n435:     dspy.settings.configure(lm=lm)\n436:     assert predictor().output == \"short answer\"\n437: \n438: \n439: def test_load_state_chaining():\n440:     \"\"\"Test that load_state returns self for chaining.\"\"\"\n441:     original = Predict(\"question -> answer\")\n442:     original.demos = [{\"question\": \"test\", \"answer\": \"response\"}]\n443:     state = original.dump_state()\n444: \n445:     new_instance = Predict(\"question -> answer\").load_state(state)\n446:     assert new_instance is not None\n447:     assert new_instance.demos == original.demos\n448: \n449: \n450: @pytest.mark.parametrize(\"adapter_type\", [\"chat\", \"json\"])\n451: def test_call_predict_with_chat_history(adapter_type):\n452:     class SpyLM(dspy.LM):\n453:         def __init__(self, *args, return_json=False, **kwargs):\n454:             super().__init__(*args, **kwargs)\n455:             self.calls = []\n456:             self.return_json = return_json\n457: \n458:         def __call__(self, prompt=None, messages=None, **kwargs):\n459:             self.calls.append({\"prompt\": prompt, \"messages\": messages, \"kwargs\": kwargs})\n460:             if self.return_json:\n461:                 return [\"{'answer':'100%'}\"]\n462:             return [\"[[ ## answer ## ]]\\n100%!\"]\n463: \n464:     class MySignature(dspy.Signature):\n465:         question: str = dspy.InputField()\n466:         history: dspy.History = dspy.InputField()\n467:         answer: str = dspy.OutputField()\n468: \n469:     program = Predict(MySignature)\n470: \n471:     if adapter_type == \"chat\":\n472:         lm = SpyLM(\"dummy_model\")\n473:         dspy.settings.configure(adapter=dspy.ChatAdapter(), lm=lm)\n474:     else:\n475:         lm = SpyLM(\"dummy_model\", return_json=True)\n476:         dspy.settings.configure(adapter=dspy.JSONAdapter(), lm=lm)\n477: \n478:     program(\n479:         question=\"are you sure that's correct?\",\n480:         history=dspy.History(messages=[{\"question\": \"what's the capital of france?\", \"answer\": \"paris\"}]),\n481:     )\n482: \n483:     # Verify the LM was called with correct messages\n484:     assert len(lm.calls) == 1\n485:     messages = lm.calls[0][\"messages\"]\n486: \n487:     assert len(messages) == 4\n488: \n489:     assert \"what's the capital of france?\" in messages[1][\"content\"]\n490:     assert \"paris\" in messages[2][\"content\"]\n491:     assert \"are you sure that's correct\" in messages[3][\"content\"]\n492: \n493: \n494: def test_lm_usage():\n495:     program = Predict(\"question -> answer\")\n496:     dspy.settings.configure(lm=dspy.LM(\"openai/gpt-4o-mini\", cache=False), track_usage=True)\n497:     with patch(\n498:         \"dspy.clients.lm.litellm_completion\",\n499:         return_value=ModelResponse(\n500:             choices=[{\"message\": {\"content\": \"[[ ## answer ## ]]\\nParis\"}}],\n501:             usage={\"total_tokens\": 10},\n502:         ),\n503:     ):\n504:         result = program(question=\"What is the capital of France?\")\n505:         assert result.answer == \"Paris\"\n506:         assert result.get_lm_usage()[\"openai/gpt-4o-mini\"][\"total_tokens\"] == 10\n507: \n508: \n509: def test_positional_arguments():\n510:     program = Predict(\"question -> answer\")\n511:     with pytest.raises(ValueError) as e:\n512:         program(\"What is the capital of France?\")\n513:     assert str(e.value) == (\n514:         \"Positional arguments are not allowed when calling `dspy.Predict`, must use keyword arguments that match \"\n515:         \"your signature input fields: 'question'. For example: `predict(question=input_value, ...)`.\"\n516:     )\n517: \n518: \n519: @pytest.mark.parametrize(\"adapter_type\", [\"chat\", \"json\"])\n520: def test_field_constraints(adapter_type):\n521:     class SpyLM(dspy.LM):\n522:         def __init__(self, *args, return_json=False, **kwargs):\n523:             super().__init__(*args, **kwargs)\n524:             self.calls = []\n525:             self.return_json = return_json\n526: \n527:         def __call__(self, prompt=None, messages=None, **kwargs):\n528:             self.calls.append({\"prompt\": prompt, \"messages\": messages, \"kwargs\": kwargs})\n529:             if self.return_json:\n530:                 return [\"{'score':'0.5', 'count':'2'}\"]\n531:             return [\"[[ ## score ## ]]\\n0.5\\n[[ ## count ## ]]\\n2\"]\n532: \n533:     class ConstrainedSignature(dspy.Signature):\n534:         \"\"\"Test signature with constrained fields.\"\"\"\n535: \n536:         # Input with length and value constraints\n537:         text: str = dspy.InputField(min_length=5, max_length=100, desc=\"Input text\")\n538:         number: int = dspy.InputField(gt=0, lt=10, desc=\"A number between 0 and 10\")\n539: \n540:         # Output with multiple constraints\n541:         score: float = dspy.OutputField(ge=0.0, le=1.0, desc=\"Score between 0 and 1\")\n542:         count: int = dspy.OutputField(multiple_of=2, desc=\"Even number count\")\n543: \n544:     program = Predict(ConstrainedSignature)\n545:     lm = SpyLM(\"dummy_model\")\n546:     if adapter_type == \"chat\":\n547:         lm = SpyLM(\"dummy_model\")\n548:         dspy.settings.configure(adapter=dspy.ChatAdapter(), lm=lm)\n549:     else:\n550:         lm = SpyLM(\"dummy_model\", return_json=True)\n551:         dspy.settings.configure(adapter=dspy.JSONAdapter(), lm=lm)\n552: \n553:     # Call the predictor to trigger instruction generation\n554:     program(text=\"hello world\", number=5)\n555: \n556:     # Get the system message containing the instructions\n557:     system_message = lm.calls[0][\"messages\"][0][\"content\"]\n558: \n559:     # Verify constraints are included in the field descriptions\n560:     assert \"minimum length: 5\" in system_message\n561:     assert \"maximum length: 100\" in system_message\n562:     assert \"greater than: 0\" in system_message\n563:     assert \"less than: 10\" in system_message\n564:     assert \"greater than or equal to: 0.0\" in system_message\n565:     assert \"less than or equal to: 1.0\" in system_message\n566:     assert \"a multiple of the given number: 2\" in system_message\n567: \n568: \n569: @pytest.mark.asyncio\n570: async def test_async_predict():\n571:     program = Predict(\"question -> answer\")\n572:     dspy.settings.configure(lm=DummyLM([{\"answer\": \"Paris\"}]))\n573:     result = await program.acall(question=\"What is the capital of France?\")\n574:     assert result.answer == \"Paris\"\n\n(End of file - total 574 lines)\n</content>","metadata":{"preview":"import copy\nimport enum\nfrom datetime import datetime\nfrom unittest.mock import patch\n\nimport pydantic\nimport pytest\nimport ujson\nfrom litellm import ModelResponse\n\nimport dspy\nfrom dspy import Predict, Signature\nfrom dspy.utils.dummies import DummyLM\n\n\ndef test_initialization_with_string_signature():\n    signature_string = \"input1, input2 -> output\"\n    predict = Predict(signature_string)\n    expected_instruction = \"Given the fields `input1`, `input2`, produce the fields `output`.\"\n    assert predict.signature.instructions == expected_instruction","truncated":false,"loaded":[],"display":{"type":"file","path":"/testbed/tests/predict/test_predict.py","text":"import copy\nimport enum\nfrom datetime import datetime\nfrom unittest.mock import patch\n\nimport pydantic\nimport pytest\nimport ujson\nfrom litellm import ModelResponse\n\nimport dspy\nfrom dspy import Predict, Signature\nfrom dspy.utils.dummies import DummyLM\n\n\ndef test_initialization_with_string_signature():\n    signature_string = \"input1, input2 -> output\"\n    predict = Predict(signature_string)\n    expected_instruction = \"Given the fields `input1`, `input2`, produce the fields `output`.\"\n    assert predict.signature.instructions == expected_instruction\n    assert predict.signature.instructions == Signature(signature_string).instructions\n\n\ndef test_reset_method():\n    predict_instance = Predict(\"input -> output\")\n    predict_instance.lm = \"modified\"\n    predict_instance.traces = [\"trace\"]\n    predict_instance.train = [\"train\"]\n    predict_instance.demos = [\"demo\"]\n    predict_instance.reset()\n    assert predict_instance.lm is None\n    assert predict_instance.traces == []\n    assert predict_instance.train == []\n    assert predict_instance.demos == []\n\n\ndef test_lm_after_dump_and_load_state():\n    predict_instance = Predict(\"input -> output\")\n    lm = dspy.LM(\n        model=\"openai/gpt-4o-mini\",\n        model_type=\"chat\",\n        temperature=1,\n        max_tokens=100,\n        num_retries=10,\n    )\n    predict_instance.lm = lm\n    expected_lm_state = {\n        \"model\": \"openai/gpt-4o-mini\",\n        \"model_type\": \"chat\",\n        \"temperature\": 1,\n        \"max_tokens\": 100,\n        \"num_retries\": 10,\n        \"cache\": True,\n        \"cache_in_memory\": True,\n        \"finetuning_model\": None,\n        \"launch_kwargs\": {},\n        \"train_kwargs\": {},\n    }\n    assert lm.dump_state() == expected_lm_state\n    dumped_state = predict_instance.dump_state()\n    new_instance = Predict(\"input -> output\")\n    new_instance.load_state(dumped_state)\n    assert new_instance.lm.dump_state() == expected_lm_state\n\n\ndef test_call_method():\n    predict_instance = Predict(\"input -> output\")\n    lm = DummyLM([{\"output\": \"test output\"}])\n    dspy.settings.configure(lm=lm)\n    result = predict_instance(input=\"test input\")\n    assert result.output == \"test output\"\n\n\ndef test_instructions_after_dump_and_load_state():\n    predict_instance = Predict(Signature(\"input -> output\", \"original instructions\"))\n    dumped_state = predict_instance.dump_state()\n    new_instance = Predict(Signature(\"input -> output\", \"new instructions\"))\n    new_instance.load_state(dumped_state)\n    assert new_instance.signature.instructions == \"original instructions\"\n\n\ndef test_demos_after_dump_and_load_state():\n    class TranslateToEnglish(dspy.Signature):\n        \"\"\"Translate content from a language to English.\"\"\"\n\n        content: str = dspy.InputField()\n        language: str = dspy.InputField()\n        translation: str = dspy.OutputField()\n\n    original_instance = Predict(TranslateToEnglish)\n    original_instance.demos = [\n        dspy.Example(\n            content=\"¿Qué tal?\",\n            language=\"SPANISH\",\n            translation=\"Hello there\",\n        ).with_inputs(\"content\", \"language\"),\n    ]\n\n    dumped_state = original_instance.dump_state()\n    assert len(dumped_state[\"demos\"]) == len(original_instance.demos)\n    assert dumped_state[\"demos\"][0][\"content\"] == original_instance.demos[0].content\n\n    saved_state = ujson.dumps(dumped_state)\n    loaded_state = ujson.loads(saved_state)\n\n    new_instance = Predict(TranslateToEnglish)\n    new_instance.load_state(loaded_state)\n    assert len(new_instance.demos) == len(original_instance.demos)\n    # Demos don't need to keep the same types after saving and loading the state.\n    assert new_instance.demos[0][\"content\"] == original_instance.demos[0].content\n\n\ndef test_typed_demos_after_dump_and_load_state():\n    class Item(pydantic.BaseModel):\n        name: str\n        quantity: int\n\n    class InventorySignature(dspy.Signature):\n        \"\"\"Handle inventory items and their translations.\"\"\"\n\n        items: list[Item] = dspy.InputField()\n        language: str = dspy.InputField()\n        translated_items: list[Item] = dspy.OutputField()\n        total_quantity: int = dspy.OutputField()\n\n    original_instance = Predict(InventorySignature)\n    original_instance.demos = [\n        dspy.Example(\n            items=[Item(name=\"apple\", quantity=5), Item(name=\"banana\", quantity=3)],\n            language=\"SPANISH\",\n            translated_items=[Item(name=\"manzana\", quantity=5), Item(name=\"plátano\", quantity=3)],\n            total_quantity=8,\n        ).with_inputs(\"items\", \"language\"),\n    ]\n\n    # Test dump_state\n    dumped_state = original_instance.dump_state()\n    assert len(dumped_state[\"demos\"]) == len(original_instance.demos)\n    # Verify the input items were properly serialized\n    assert isinstance(dumped_state[\"demos\"][0][\"items\"], list)\n    assert len(dumped_state[\"demos\"][0][\"items\"]) == 2\n    assert dumped_state[\"demos\"][0][\"items\"][0] == {\"name\": \"apple\", \"quantity\": 5}\n\n    # Test serialization/deserialization\n    saved_state = ujson.dumps(dumped_state)\n    loaded_state = ujson.loads(saved_state)\n\n    # Test load_state\n    new_instance = Predict(InventorySignature)\n    new_instance.load_state(loaded_state)\n    assert len(new_instance.demos) == len(original_instance.demos)\n\n    # Verify the structure is maintained after loading\n    loaded_demo = new_instance.demos[0]\n    assert isinstance(loaded_demo[\"items\"], list)\n    assert len(loaded_demo[\"items\"]) == 2\n    assert loaded_demo[\"items\"][0][\"name\"] == \"apple\"\n    assert loaded_demo[\"items\"][0][\"quantity\"] == 5\n    assert loaded_demo[\"items\"][1][\"name\"] == \"banana\"\n    assert loaded_demo[\"items\"][1][\"quantity\"] == 3\n\n    # Verify output items were also properly maintained\n    assert isinstance(loaded_demo[\"translated_items\"], list)\n    assert len(loaded_demo[\"translated_items\"]) == 2\n    assert loaded_demo[\"translated_items\"][0][\"name\"] == \"manzana\"\n    assert loaded_demo[\"translated_items\"][1][\"name\"] == \"plátano\"\n\n\n# def test_typed_demos_after_dump_and_load_state():\n#     class TypedTranslateToEnglish(dspy.Signature):\n#         \"\"\"Translate content from a language to English.\"\"\"\n\n#         class Input(pydantic.BaseModel):\n#             content: str\n#             language: str\n\n#         class Output(pydantic.BaseModel):\n#             translation: str\n\n#         input: Input = dspy.InputField()\n#         output: Output = dspy.OutputField()\n\n#     original_instance = TypedPredictor(TypedTranslateToEnglish).predictor\n#     original_instance.demos = [\n#         dspy.Example(\n#             input=TypedTranslateToEnglish.Input(\n#                 content=\"¿Qué tal?\",\n#                 language=\"SPANISH\",\n#             ),\n#             output=TypedTranslateToEnglish.Output(\n#                 translation=\"Hello there\",\n#             ),\n#         ).with_inputs(\"input\"),\n#     ]\n\n#     dumped_state = original_instance.dump_state()\n#     assert len(dumped_state[\"demos\"]) == len(original_instance.demos)\n#     assert dumped_state[\"demos\"][0][\"input\"] == original_instance.demos[0].input.model_dump_json()\n\n#     saved_state = ujson.dumps(dumped_state)\n#     loaded_state = ujson.loads(saved_state)\n\n#     new_instance = TypedPredictor(TypedTranslateToEnglish).predictor\n#     new_instance.load_state(loaded_state)\n#     assert len(new_instance.demos) == len(original_instance.demos)\n#     # Demos don't need to keep the same types after saving and loading the state.\n#     assert new_instance.demos[0][\"input\"] == original_instance.demos[0].input.model_dump_json()\n\n\ndef test_signature_fields_after_dump_and_load_state(tmp_path):\n    class CustomSignature(dspy.Signature):\n        \"\"\"I am just an instruction.\"\"\"\n\n        sentence = dspy.InputField(desc=\"I am an innocent input!\")\n        sentiment = dspy.OutputField()\n\n    file_path = tmp_path / \"tmp.json\"\n    original_instance = Predict(CustomSignature)\n    original_instance.save(file_path)\n\n    class CustomSignature2(dspy.Signature):\n        \"\"\"I am not a pure instruction.\"\"\"\n\n        sentence = dspy.InputField(desc=\"I am a malicious input!\")\n        sentiment = dspy.OutputField(desc=\"I am a malicious output!\", prefix=\"I am a prefix!\")\n\n    new_instance = Predict(CustomSignature2)\n    assert new_instance.signature.dump_state() != original_instance.signature.dump_state()\n    # After loading, the fields should be the same.\n    new_instance.load(file_path)\n    assert new_instance.signature.dump_state() == original_instance.signature.dump_state()\n\n\n@pytest.mark.parametrize(\"filename\", [\"model.json\", \"model.pkl\"])\ndef test_lm_field_after_dump_and_load_state(tmp_path, filename):\n    file_path = tmp_path / filename\n    lm = dspy.LM(\n        model=\"openai/gpt-4o-mini\",\n        model_type=\"chat\",\n        temperature=1,\n        max_tokens=100,\n        num_retries=10,\n    )\n    original_predict = dspy.Predict(\"q->a\")\n    original_predict.lm = lm\n\n    original_predict.save(file_path)\n\n    assert file_path.exists()\n\n    loaded_predict = dspy.Predict(\"q->a\")\n    loaded_predict.load(file_path)\n\n    assert original_predict.dump_state() == loaded_predict.dump_state()\n\n\ndef test_forward_method():\n    program = Predict(\"question -> answer\")\n    dspy.settings.configure(lm=DummyLM([{\"answer\": \"No more responses\"}]))\n    result = program(question=\"What is 1+1?\").answer\n    assert result == \"No more responses\"\n\n\ndef test_forward_method2():\n    program = Predict(\"question -> answer1, answer2\")\n    dspy.settings.configure(lm=DummyLM([{\"answer1\": \"my first answer\", \"answer2\": \"my second answer\"}]))\n    result = program(question=\"What is 1+1?\")\n    assert result.answer1 == \"my first answer\"\n    assert result.answer2 == \"my second answer\"\n\n\ndef test_config_management():\n    predict_instance = Predict(\"input -> output\")\n    predict_instance.update_config(new_key=\"value\")\n    config = predict_instance.get_config()\n    assert \"new_key\" in config and config[\"new_key\"] == \"value\"\n\n\ndef test_multi_output():\n    program = Predict(\"question -> answer\", n=2)\n    dspy.settings.configure(lm=DummyLM([{\"answer\": \"my first answer\"}, {\"answer\": \"my second answer\"}]))\n    results = program(question=\"What is 1+1?\")\n    assert results.completions.answer[0] == \"my first answer\"\n    assert results.completions.answer[1] == \"my second answer\"\n\n\ndef test_multi_output2():\n    program = Predict(\"question -> answer1, answer2\", n=2)\n    dspy.settings.configure(\n        lm=DummyLM(\n            [\n                {\"answer1\": \"my 0 answer\", \"answer2\": \"my 2 answer\"},\n                {\"answer1\": \"my 1 answer\", \"answer2\": \"my 3 answer\"},\n            ],\n        )\n    )\n    results = program(question=\"What is 1+1?\")\n    assert results.completions.answer1[0] == \"my 0 answer\"\n    assert results.completions.answer1[1] == \"my 1 answer\"\n    assert results.completions.answer2[0] == \"my 2 answer\"\n    assert results.completions.answer2[1] == \"my 3 answer\"\n\n\ndef test_datetime_inputs_and_outputs():\n    # Define a model for datetime inputs and outputs\n    class TimedEvent(pydantic.BaseModel):\n        event_name: str\n        event_time: datetime\n\n    class TimedSignature(dspy.Signature):\n        events: list[TimedEvent] = dspy.InputField()\n        summary: str = dspy.OutputField()\n        next_event_time: datetime = dspy.OutputField()\n\n    program = Predict(TimedSignature)\n\n    lm = DummyLM(\n        [\n            {\n                \"reasoning\": \"Processed datetime inputs\",\n                \"summary\": \"All events are processed\",\n                \"next_event_time\": \"2024-11-27T14:00:00\",\n            }\n        ]\n    )\n    dspy.settings.configure(lm=lm)\n\n    output = program(\n        events=[\n            TimedEvent(event_name=\"Event 1\", event_time=datetime(2024, 11, 25, 10, 0, 0)),\n            TimedEvent(event_name=\"Event 2\", event_time=datetime(2024, 11, 25, 15, 30, 0)),\n        ]\n    )\n    assert output.summary == \"All events are processed\"\n    assert output.next_event_time == datetime(2024, 11, 27, 14, 0, 0)\n\n\ndef test_explicitly_valued_enum_inputs_and_outputs():\n    class Status(enum.Enum):\n        PENDING = \"pending\"\n        IN_PROGRESS = \"in_progress\"\n        COMPLETED = \"completed\"\n\n    class StatusSignature(dspy.Signature):\n        current_status: Status = dspy.InputField()\n        next_status: Status = dspy.OutputField()\n\n    program = Predict(StatusSignature)\n\n    lm = DummyLM(\n        [\n            {\n                \"reasoning\": \"The current status is 'PENDING', advancing to 'IN_PROGRESS'.\",\n                \"next_status\": \"in_progress\",\n            }\n        ]\n    )\n    dspy.settings.configure(lm=lm)\n\n    output = program(current_status=Status.PENDING)\n    assert output.next_status == Status.IN_PROGRESS\n\n\ndef test_enum_inputs_and_outputs_with_shared_names_and_values():\n    class TicketStatus(enum.Enum):\n        OPEN = \"CLOSED\"\n        CLOSED = \"RESOLVED\"\n        RESOLVED = \"OPEN\"\n\n    class TicketStatusSignature(dspy.Signature):\n        current_status: TicketStatus = dspy.InputField()\n        next_status: TicketStatus = dspy.OutputField()\n\n    program = Predict(TicketStatusSignature)\n\n    # Mock reasoning and output\n    lm = DummyLM(\n        [\n            {\n                \"reasoning\": \"The ticket is currently 'OPEN', transitioning to 'CLOSED'.\",\n                \"next_status\": \"RESOLVED\",  # Refers to TicketStatus.CLOSED by value\n            }\n        ]\n    )\n    dspy.settings.configure(lm=lm)\n\n    output = program(current_status=TicketStatus.OPEN)\n    assert output.next_status == TicketStatus.CLOSED  # By value\n\n\ndef test_auto_valued_enum_inputs_and_outputs():\n    Status = enum.Enum(\"Status\", [\"PENDING\", \"IN_PROGRESS\", \"COMPLETED\"])  # noqa: N806\n\n    class StatusSignature(dspy.Signature):\n        current_status: Status = dspy.InputField()\n        next_status: Status = dspy.OutputField()\n\n    program = Predict(StatusSignature)\n\n    lm = DummyLM(\n        [\n            {\n                \"reasoning\": \"The current status is 'PENDING', advancing to 'IN_PROGRESS'.\",\n                \"next_status\": \"IN_PROGRESS\",  # Use the auto-assigned value for IN_PROGRESS\n            }\n        ]\n    )\n    dspy.settings.configure(lm=lm)\n\n    output = program(current_status=Status.PENDING)\n    assert output.next_status == Status.IN_PROGRESS\n\n\ndef test_named_predictors():\n    class MyModule(dspy.Module):\n        def __init__(self):\n            super().__init__()\n            self.inner = Predict(\"question -> answer\")\n\n    program = MyModule()\n    assert program.named_predictors() == [(\"inner\", program.inner)]\n\n    # Check that it also works the second time.\n    program2 = copy.deepcopy(program)\n    assert program2.named_predictors() == [(\"inner\", program2.inner)]\n\n\ndef test_output_only():\n    class OutputOnlySignature(dspy.Signature):\n        output = dspy.OutputField()\n\n    predictor = Predict(OutputOnlySignature)\n\n    lm = DummyLM([{\"output\": \"short answer\"}])\n    dspy.settings.configure(lm=lm)\n    assert predictor().output == \"short answer\"\n\n\ndef test_load_state_chaining():\n    \"\"\"Test that load_state returns self for chaining.\"\"\"\n    original = Predict(\"question -> answer\")\n    original.demos = [{\"question\": \"test\", \"answer\": \"response\"}]\n    state = original.dump_state()\n\n    new_instance = Predict(\"question -> answer\").load_state(state)\n    assert new_instance is not None\n    assert new_instance.demos == original.demos\n\n\n@pytest.mark.parametrize(\"adapter_type\", [\"chat\", \"json\"])\ndef test_call_predict_with_chat_history(adapter_type):\n    class SpyLM(dspy.LM):\n        def __init__(self, *args, return_json=False, **kwargs):\n            super().__init__(*args, **kwargs)\n            self.calls = []\n            self.return_json = return_json\n\n        def __call__(self, prompt=None, messages=None, **kwargs):\n            self.calls.append({\"prompt\": prompt, \"messages\": messages, \"kwargs\": kwargs})\n            if self.return_json:\n                return [\"{'answer':'100%'}\"]\n            return [\"[[ ## answer ## ]]\\n100%!\"]\n\n    class MySignature(dspy.Signature):\n        question: str = dspy.InputField()\n        history: dspy.History = dspy.InputField()\n        answer: str = dspy.OutputField()\n\n    program = Predict(MySignature)\n\n    if adapter_type == \"chat\":\n        lm = SpyLM(\"dummy_model\")\n        dspy.settings.configure(adapter=dspy.ChatAdapter(), lm=lm)\n    else:\n        lm = SpyLM(\"dummy_model\", return_json=True)\n        dspy.settings.configure(adapter=dspy.JSONAdapter(), lm=lm)\n\n    program(\n        question=\"are you sure that's correct?\",\n        history=dspy.History(messages=[{\"question\": \"what's the capital of france?\", \"answer\": \"paris\"}]),\n    )\n\n    # Verify the LM was called with correct messages\n    assert len(lm.calls) == 1\n    messages = lm.calls[0][\"messages\"]\n\n    assert len(messages) == 4\n\n    assert \"what's the capital of france?\" in messages[1][\"content\"]\n    assert \"paris\" in messages[2][\"content\"]\n    assert \"are you sure that's correct\" in messages[3][\"content\"]\n\n\ndef test_lm_usage():\n    program = Predict(\"question -> answer\")\n    dspy.settings.configure(lm=dspy.LM(\"openai/gpt-4o-mini\", cache=False), track_usage=True)\n    with patch(\n        \"dspy.clients.lm.litellm_completion\",\n        return_value=ModelResponse(\n            choices=[{\"message\": {\"content\": \"[[ ## answer ## ]]\\nParis\"}}],\n            usage={\"total_tokens\": 10},\n        ),\n    ):\n        result = program(question=\"What is the capital of France?\")\n        assert result.answer == \"Paris\"\n        assert result.get_lm_usage()[\"openai/gpt-4o-mini\"][\"total_tokens\"] == 10\n\n\ndef test_positional_arguments():\n    program = Predict(\"question -> answer\")\n    with pytest.raises(ValueError) as e:\n        program(\"What is the capital of France?\")\n    assert str(e.value) == (\n        \"Positional arguments are not allowed when calling `dspy.Predict`, must use keyword arguments that match \"\n        \"your signature input fields: 'question'. For example: `predict(question=input_value, ...)`.\"\n    )\n\n\n@pytest.mark.parametrize(\"adapter_type\", [\"chat\", \"json\"])\ndef test_field_constraints(adapter_type):\n    class SpyLM(dspy.LM):\n        def __init__(self, *args, return_json=False, **kwargs):\n            super().__init__(*args, **kwargs)\n            self.calls = []\n            self.return_json = return_json\n\n        def __call__(self, prompt=None, messages=None, **kwargs):\n            self.calls.append({\"prompt\": prompt, \"messages\": messages, \"kwargs\": kwargs})\n            if self.return_json:\n                return [\"{'score':'0.5', 'count':'2'}\"]\n            return [\"[[ ## score ## ]]\\n0.5\\n[[ ## count ## ]]\\n2\"]\n\n    class ConstrainedSignature(dspy.Signature):\n        \"\"\"Test signature with constrained fields.\"\"\"\n\n        # Input with length and value constraints\n        text: str = dspy.InputField(min_length=5, max_length=100, desc=\"Input text\")\n        number: int = dspy.InputField(gt=0, lt=10, desc=\"A number between 0 and 10\")\n\n        # Output with multiple constraints\n        score: float = dspy.OutputField(ge=0.0, le=1.0, desc=\"Score between 0 and 1\")\n        count: int = dspy.OutputField(multiple_of=2, desc=\"Even number count\")\n\n    program = Predict(ConstrainedSignature)\n    lm = SpyLM(\"dummy_model\")\n    if adapter_type == \"chat\":\n        lm = SpyLM(\"dummy_model\")\n        dspy.settings.configure(adapter=dspy.ChatAdapter(), lm=lm)\n    else:\n        lm = SpyLM(\"dummy_model\", return_json=True)\n        dspy.settings.configure(adapter=dspy.JSONAdapter(), lm=lm)\n\n    # Call the predictor to trigger instruction generation\n    program(text=\"hello world\", number=5)\n\n    # Get the system message containing the instructions\n    system_message = lm.calls[0][\"messages\"][0][\"content\"]\n\n    # Verify constraints are included in the field descriptions\n    assert \"minimum length: 5\" in system_message\n    assert \"maximum length: 100\" in system_message\n    assert \"greater than: 0\" in system_message\n    assert \"less than: 10\" in system_message\n    assert \"greater than or equal to: 0.0\" in system_message\n    assert \"less than or equal to: 1.0\" in system_message\n    assert \"a multiple of the given number: 2\" in system_message\n\n\n@pytest.mark.asyncio\nasync def test_async_predict():\n    program = Predict(\"question -> answer\")\n    dspy.settings.configure(lm=DummyLM([{\"answer\": \"Paris\"}]))\n    result = await program.acall(question=\"What is the capital of France?\")\n    assert result.answer == \"Paris\"","lineStart":1,"lineEnd":574,"totalLines":574,"truncated":false}},"title":"tests/predict/test_predict.py","time":{"start":1788458519716,"end":1788458519737}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_0686f4c9f0019LqA6tzDVz6TA3","sessionID":"ses_f97919226ffeSaD2Vc16sHo0wL","messageID":"msg_0686f43f1001fG0kPVS9Zdy1cj"}}
