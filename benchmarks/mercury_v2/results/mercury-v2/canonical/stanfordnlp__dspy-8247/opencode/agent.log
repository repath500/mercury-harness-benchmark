{"type":"tool_use","timestamp":1788458539991,"sessionID":"ses_f97919226ffeSaD2Vc16sHo0wL","part":{"type":"tool","tool":"read","callID":"call_c18d1a2d1f364e43b04c52fb","state":{"status":"completed","input":{"filePath":"/testbed/dspy/adapters/base.py","limit":60,"offset":100},"output":"<path>/testbed/dspy/adapters/base.py</path>\n<type>file</type>\n<content>\n100:         And system message should contain the field description, field structure, and task description.\n101:         ```\n102: \n103: \n104:         Args:\n105:             signature: The DSPy signature for which to format the input messages.\n106:             demos: A list of few-shot examples.\n107:             inputs: The input arguments to the DSPy module.\n108: \n109:         Returns:\n110:             A list of multiturn messages as expected by the LM.\n111:         \"\"\"\n112:         inputs_copy = dict(inputs)\n113: \n114:         # If the signature and inputs have conversation history, we need to format the conversation history and\n115:         # remove the history field from the signature.\n116:         history_field_name = self._get_history_field_name(signature)\n117:         if history_field_name:\n118:             # In order to format the conversation history, we need to remove the history field from the signature.\n119:             signature_without_history = signature.delete(history_field_name)\n120:             conversation_history = self.format_conversation_history(\n121:                 signature_without_history,\n122:                 history_field_name,\n123:                 inputs_copy,\n124:             )\n125: \n126:         messages = []\n127:         system_message = (\n128:             f\"{self.format_field_description(signature)}\\n\"\n129:             f\"{self.format_field_structure(signature)}\\n\"\n130:             f\"{self.format_task_description(signature)}\"\n131:         )\n132:         messages.append({\"role\": \"system\", \"content\": system_message})\n133:         messages.extend(self.format_demos(signature, demos))\n134:         if history_field_name:\n135:             # Conversation history and current input\n136:             content = self.format_user_message_content(signature_without_history, inputs_copy, main_request=True)\n137:             messages.extend(conversation_history)\n138:             messages.append({\"role\": \"user\", \"content\": content})\n139:         else:\n140:             # Only current input\n141:             content = self.format_user_message_content(signature, inputs_copy, main_request=True)\n142:             messages.append({\"role\": \"user\", \"content\": content})\n143: \n144:         messages = split_message_content_for_custom_types(messages)\n145:         return messages\n146: \n147:     def format_field_description(self, signature: Type[Signature]) -> str:\n148:         \"\"\"Format the field description for the system message.\n149: \n150:         This method formats the field description for the system message. It should return a string that contains\n151:         the field description for the input fields and the output fields.\n152: \n153:         Args:\n154:             signature: The DSPy signature for which to format the field description.\n155: \n156:         Returns:\n157:             A string that contains the field description for the input fields and the output fields.\n158:         \"\"\"\n159:         raise NotImplementedError\n\n(Showing lines 100-159 of 355. Use offset=160 to continue.)\n</content>","metadata":{"preview":"        And system message should contain the field description, field structure, and task description.\n        ```\n\n\n        Args:\n            signature: The DSPy signature for which to format the input messages.\n            demos: A list of few-shot examples.\n            inputs: The input arguments to the DSPy module.\n\n        Returns:\n            A list of multiturn messages as expected by the LM.\n        \"\"\"\n        inputs_copy = dict(inputs)\n\n        # If the signature and inputs have conversation history, we need to format the conversation history and\n        # remove the history field from the signature.\n        history_field_name = self._get_history_field_name(signature)\n        if history_field_name:\n            # In order to format the conversation history, we need to remove the history field from the signature.\n            signature_without_history = signature.delete(history_field_name)","truncated":true,"loaded":[],"display":{"type":"file","path":"/testbed/dspy/adapters/base.py","text":"        And system message should contain the field description, field structure, and task description.\n        ```\n\n\n        Args:\n            signature: The DSPy signature for which to format the input messages.\n            demos: A list of few-shot examples.\n            inputs: The input arguments to the DSPy module.\n\n        Returns:\n            A list of multiturn messages as expected by the LM.\n        \"\"\"\n        inputs_copy = dict(inputs)\n\n        # If the signature and inputs have conversation history, we need to format the conversation history and\n        # remove the history field from the signature.\n        history_field_name = self._get_history_field_name(signature)\n        if history_field_name:\n            # In order to format the conversation history, we need to remove the history field from the signature.\n            signature_without_history = signature.delete(history_field_name)\n            conversation_history = self.format_conversation_history(\n                signature_without_history,\n                history_field_name,\n                inputs_copy,\n            )\n\n        messages = []\n        system_message = (\n            f\"{self.format_field_description(signature)}\\n\"\n            f\"{self.format_field_structure(signature)}\\n\"\n            f\"{self.format_task_description(signature)}\"\n        )\n        messages.append({\"role\": \"system\", \"content\": system_message})\n        messages.extend(self.format_demos(signature, demos))\n        if history_field_name:\n            # Conversation history and current input\n            content = self.format_user_message_content(signature_without_history, inputs_copy, main_request=True)\n            messages.extend(conversation_history)\n            messages.append({\"role\": \"user\", \"content\": content})\n        else:\n            # Only current input\n            content = self.format_user_message_content(signature, inputs_copy, main_request=True)\n            messages.append({\"role\": \"user\", \"content\": content})\n\n        messages = split_message_content_for_custom_types(messages)\n        return messages\n\n    def format_field_description(self, signature: Type[Signature]) -> str:\n        \"\"\"Format the field description for the system message.\n\n        This method formats the field description for the system message. It should return a string that contains\n        the field description for the input fields and the output fields.\n\n        Args:\n            signature: The DSPy signature for which to format the field description.\n\n        Returns:\n            A string that contains the field description for the input fields and the output fields.\n        \"\"\"\n        raise NotImplementedError","lineStart":100,"lineEnd":159,"totalLines":355,"truncated":true}},"title":"dspy/adapters/base.py","time":{"start":1788458539967,"end":1788458539988}},"id":"prt_0686f9bbb001XUxlpO23Hki15X","sessionID":"ses_f97919226ffeSaD2Vc16sHo0wL","messageID":"msg_0686f4d41001xgaLsnqSlOcDmf"}}
