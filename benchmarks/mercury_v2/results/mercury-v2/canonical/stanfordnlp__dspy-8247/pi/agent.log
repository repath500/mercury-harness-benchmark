openai/gpt-4o-mini', cache=False)\ndspy.settings.configure(lm=lm)\nprogram = dspy.Predict('question -> answer')\nprediction = {'type': 'content', 'content': 'The capital of France is Paris.'}\nwith patch('dspy.clients.lm.litellm_completion', side_effect=fake_completion):\n    result = program(question='What is the capital of France?', prediction=prediction)\n\nprint('result.answer:', result.answer)\nprint('prediction in request:', captured['request']['prediction'])\nassert captured['request']['prediction'] == prediction\nprint('OK: prediction passed through to the LM request payload')\n\""}}],"api":"openai-completions","provider":"harbor-endpoint","model":"z-ai/glm-5.3-flash","usage":{"input":373,"output":367,"cacheRead":24448,"cacheWrite":0,"reasoning":89,"totalTokens":25188,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1788459335781,"responseId":"gen-1788459335-BlNBY3EoyVj5HNTjNIUe","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"call_8049f78cd9d147b788032c0f","toolName":"bash","content":[{"type":"text","text":"diff --git a/dspy/predict/predict.py b/dspy/predict/predict.py\nindex 9f78ca804..ae1fb6814 100644\n--- a/dspy/predict/predict.py\n+++ b/dspy/predict/predict.py\n@@ -108,6 +108,14 @@ class Predict(Module, Parameter):\n         if (temperature is None or temperature <= 0.15) and num_generations > 1:\n             config[\"temperature\"] = 0.7\n \n+        # If the input contains a predicted output (OpenAI's Predicted Outputs\n+        # feature), move it to the LM config so it can guide the generation\n+        # instead of being treated as a regular input field.\n+        prediction = kwargs.get(\"prediction\")\n+        if isinstance(prediction, dict) and prediction.get(\"type\") == \"content\" and \"content\" in prediction:\n+            kwargs.pop(\"prediction\")\n+            config[\"prediction\"] = prediction\n+\n         if not all(k in kwargs for k in signature.input_fields):\n             present = [k for k in signature.input_fields if k in kwargs]\n             missing = [k for k in signature.input_fields if k not in kwargs]\ndiff --git a/tests/predict/test_predict.py b/tests/predict/test_predict.py\nindex ba0c47820..538cba25f 100644\n--- a/tests/predict/test_predict.py\n+++ b/tests/predict/test_predict.py\n@@ -572,3 +572,71 @@ async def test_async_predict():\n     dspy.settings.configure(lm=DummyLM([{\"answer\": \"Paris\"}]))\n     result = await program.acall(question=\"What is the capital of France?\")\n     assert result.answer == \"Paris\"\n+\n+\n+class PredictionSpyLM(dspy.LM):\n+    def __init__(self, *args, **kwargs):\n+        super().__init__(*args, **kwargs)\n+        self.calls = []\n+\n+    def __call__(self, prompt=None, messages=None, **kwargs):\n+        self.calls.append({\"prompt\": prompt, \"messages\": messages, \"kwargs\": kwargs})\n+        return [\"[[ ## answer ## ]]\\nParis!\"]\n+\n+    async def acall(self, prompt=None, messages=None, **kwargs):\n+        self.calls.append({\"prompt\": prompt, \"messages\": messages, \"kwargs\": kwargs})\n+        return [\"[[ ## answer ## ]]\\nParis!\"]\n+\n+\n+@pytest.mark.asyncio\n+async def test_predicted_outputs_moved_to_lm_config():\n+    \"\"\"A valid OpenAI predicted output should be moved to the LM config, not treated as an input field.\"\"\"\n+    program = Predict(\"question -> answer\")\n+    prediction = {\"type\": \"content\", \"content\": \"The capital of France is Paris.\"}\n+\n+    sync_lm = PredictionSpyLM(\"dummy_model\")\n+    dspy.settings.configure(lm=sync_lm)\n+    result = program(question=\"What is the capital of France?\", prediction=prediction, config={\"temperature\": 0.5})\n+    assert result.answer == \"Paris!\"\n+\n+    assert len(sync_lm.calls) == 1\n+    # The prediction should be forwarded to the LM as a config parameter.\n+    assert sync_lm.calls[0][\"kwargs\"][\"prediction\"] == prediction\n+    # Other config adjustments should still work alongside it.\n+    assert sync_lm.calls[0][\"kwargs\"][\"temperature\"] == 0.5\n+    # The prediction should not be kept in the processed input fields (e.g. it must\n+    # not show up in the trace of module inputs).\n+    assert \"prediction\" not in dspy.settings.trace[-1][1]\n+    assert dspy.settings.trace[-1][1] == {\"question\": \"What is the capital of France?\"}\n+\n+    async_lm = PredictionSpyLM(\"dummy_model\")\n+    dspy.settings.configure(lm=async_lm)\n+    result = await program.acall(question=\"What is the capital of France?\", prediction=prediction, config={\"temperature\": 0.5})\n+    assert result.answer == \"Paris!\"\n+\n+    assert len(async_lm.calls) == 1\n+    assert async_lm.calls[0][\"kwargs\"][\"prediction\"] == prediction\n+    assert async_lm.calls[0][\"kwargs\"][\"temperature\"] == 0.5\n+\n+\n+@pytest.mark.parametrize(\n+    \"invalid_prediction\",\n+    [\n+        \"The capital of France is Paris.\",\n+        [\"The capital of France is Paris.\"],\n+        {\"type\": \"other\", \"content\": \"The capital of France is Paris.\"},\n+        {\"type\": \"content\"},\n+        {\"content\": \"The capital of France is Paris.\"},\n+        None,\n+    ],\n+)\n+def test_invalid_predicted_outputs_kept_as_input(invalid_prediction):\n+    \"\"\"Values that don't follow the predicted outputs format must remain regular input data.\"\"\"\n+    program = Predict(\"question -> answer\")\n+    lm = PredictionSpyLM(\"dummy_model\")\n+    dspy.settings.configure(lm=lm)\n+\n+    program(question=\"What is the capital of France?\", prediction=invalid_prediction)\n+\n+    assert len(lm.calls) == 1\n+    assert \"prediction\" not in lm.calls[0][\"kwargs\"]\n"}],"isError":false,"timestamp":1788459347329},{"role":"toolResult","toolCallId":"call_88bdaa97c7e1473ab8a527a7","toolName":"bash","content":[{"type":"text","text":"result.answer: Paris!\nprediction in request: {'type': 'content', 'content': 'The capital of France is Paris.'}\nOK: prediction passed through to the LM request payload\n"}],"isError":false,"timestamp":1788459347329},{"role":"assistant","content":[{"type":"thinking","thinking":"Everything works end to end. Let me also run the full predict test suite one more time to be safe, and maybe a broader smoke test on the broader test suite sections that involve Predict heavily (e.g., tests/predict passed already; tests/teleprompt might be slow — the ones I ran are sufficient: predict, clients, adapters, caching all pass except 2 pre-existing failures).\n\nLet me summarize the changes for the user.","thinkingSignature":"[{\"type\":\"reasoning.text\",\"text\":\"Everything works end to end. Let me also run the full predict test suite one more time to be safe, and maybe a broader smoke test on the broader test suite sections that involve Predict heavily (e.g., tests/predict passed already; tests/teleprompt might be slow — the ones I ran are sufficient: predict, clients, adapters, caching all pass except 2 pre-existing failures).\\n\\nLet me summarize the changes for the user.\",\"format\":\"unknown\",\"index\":0}]"},{"type":"text","text":"Done. The integration works end to end — here's a summary:\n\n## Changes\n\n### `dspy/predict/predict.py` (implementation)\nAdded handling in `Predict._forward_preprocess`, which is the single funnel through which both `forward()` and `aforward()` process inputs and build the LM config:\n\n```python\n# If the input contains a predicted output (OpenAI's Predicted Outputs\n# feature), move it to the LM config so it can guide the generation\n# instead of being treated as a regular input field.\nprediction = kwargs.get(\"prediction\")\nif isinstance(prediction, dict) and prediction.get(\"type\") == \"content\" and \"content\" in prediction:\n    kwargs.pop(\"prediction\")\n    config[\"prediction\"] = prediction\n```\n\n**How it works:**\n- When your input includes `prediction={\"type\": \"content\", \"content\": \"...\"}`, DSPy removes it from the input kwargs (so it never reaches the adapter, input validation, or traces as input data) and moves it into the LM config.\n- The config is passed as `lm_kwargs` to the LM call, where it flows directly into the litellm/OpenAI request payload as the `prediction` API parameter.\n- The format check is strict: the value must be a dict with `type == \"content\"` **and** contain a `content` key. Anything else — a string, a list, `None`, a dict with a different `type`, or a dict missing either key — is left untouched as regular input data, so a coincidental `prediction` field in your signature is unaffected.\n- Works alongside all existing config behavior: the test verifies `temperature` adjustments coexist with `prediction`, and it's placed after the temperature/randomness logic so nothing interferes. Since it's in `_forward_preprocess`, caching also keys off the prediction value (different predictions produce different requests).\n\n### `tests/predict/test_predict.py` (tests)\n- `test_predicted_outputs_moved_to_lm_config` — verifies sync and async calls forward a valid prediction to the LM as a config parameter, coexist with `config={\"temperature\": 0.5}`, and that the prediction is stripped from the processed inputs (checked via the module trace).\n- `test_invalid_predicted_outputs_kept_as_input` — parametrized over invalid shapes (string, list, wrong `type`, missing `content`, missing `type`, `None`); all stay as input data and never reach the LM config.\n\n## Test results\n- All 7 new tests pass; full `tests/predict/` suite: **65 passed, 5 skipped**\n- `tests/clients/`, `tests/caching/`, `tests/adapters/`: pass (the 2 JSON-adapter failures are pre-existing on the clean checkout — they fail identically with my changes stashed)\n\nUsage:\n```python\nprogram(question=\"...\", prediction={\"type\": \"content\", \"content\": \"The capital of France is Paris.\"})\n# or per-call config style:\nprogram(question=\"...\", config={\"prediction\": {\"type\": \"content\", \"content\": \"...\"}})\n```"}],"api":"openai-completions","provider":"harbor-endpoint","model":"z-ai/glm-5.3-flash","usage":{"input":14374,"output":731,"cacheRead":11968,"cacheWrite":0,"reasoning":88,"totalTokens":27073,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"stop","timestamp":1788459347331,"responseId":"gen-1788459347-3QXNWHgsLWrjwOK9Jz1V","rawStopReason":"stop"}],"willRetry":false}
