{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_66aeee500b6a4a6e97d10005","type":"tool_result","content":"diff --git a/dspy/predict/predict.py b/dspy/predict/predict.py\nindex 9f78ca804..afc7293ef 100644\n--- a/dspy/predict/predict.py\n+++ b/dspy/predict/predict.py\n@@ -108,6 +108,19 @@ class Predict(Module, Parameter):\n         if (temperature is None or temperature <= 0.15) and num_generations > 1:\n             config[\"temperature\"] = 0.7\n \n+        # If the user passes a `prediction` field in the format of OpenAI's predicted outputs feature\n+        # (https://platform.openai.com/docs/guides/predicted-outputs), move it to the LM config so it's\n+        # forwarded to the LM call as a parameter instead of being treated as regular input data. Values\n+        # that don't follow this format are left untouched to avoid clashing with legit input fields that\n+        # happen to be named `prediction`.\n+        if (\n+            \"prediction\" in kwargs\n+            and isinstance(kwargs[\"prediction\"], dict)\n+            and kwargs[\"prediction\"].get(\"type\") == \"content\"\n+            and \"content\" in kwargs[\"prediction\"]\n+        ):\n+            config[\"prediction\"] = kwargs.pop(\"prediction\")\n+\n         if not all(k in kwargs for k in signature.input_fields):\n             present = [k for k in signature.input_fields if k in kwargs]\n             missing = [k for k in signature.input_fields if k not in kwargs]\ndiff --git a/tests/predict/test_predict.py b/tests/predict/test_predict.py\nindex ba0c47820..61c8d65ff 100644\n--- a/tests/predict/test_predict.py\n+++ b/tests/predict/test_predict.py\n@@ -572,3 +572,84 @@ async def test_async_predict():\n     dspy.settings.configure(lm=DummyLM([{\"answer\": \"Paris\"}]))\n     result = await program.acall(question=\"What is the capital of France?\")\n     assert result.answer == \"Paris\"\n+\n+\n+class PredictionSpyLM(dspy.LM):\n+    def __init__(self, *args, **kwargs):\n+        super().__init__(*args, **kwargs)\n+        self.calls = []\n+\n+    def __call__(self, prompt=None, messages=None, **kwargs):\n+        self.calls.append({\"prompt\": prompt, \"messages\": messages, \"kwargs\": kwargs})\n+        return [\"[[ ## answer ## ]]\\n100%!\"]\n+\n+    async def acall(self, prompt=None, messages=None, **kwargs):\n+        return self.__call__(prompt=prompt, messages=messages, **kwargs)\n+\n+\n+def test_valid_prediction_moved_to_lm_config():\n+    program = Predict(\"question -> answer\")\n+    lm = PredictionSpyLM(\"dummy_model\")\n+    dspy.settings.configure(lm=lm)\n+\n+    prediction = {\"type\": \"content\", \"content\": \"The capital of France is Paris.\"}\n+    result = program(question=\"What is the capital of France?\", prediction=prediction)\n+\n+    assert result.answer == \"100%!\"\n+    assert len(lm.calls) == 1\n+    # The predicted output is forwarded to the LM call as a parameter...\n+    assert lm.calls[0][\"kwargs\"][\"prediction\"] == prediction\n+    # ...and no longer treated as regular input data.\n+    assert all(\"The capital of France is Paris.\" not in message[\"content\"] for message in lm.calls[0][\"messages\"])\n+\n+\n+def test_prediction_field_with_other_config():\n+    program = Predict(\"question -> answer\")\n+    lm = PredictionSpyLM(\"dummy_model\")\n+    dspy.settings.configure(lm=lm)\n+\n+    prediction = {\"type\": \"content\", \"content\": \"The capital of France is Paris.\"}\n+    program(question=\"What is the capital of France?\", prediction=prediction, config={\"temperature\": 0.5})\n+\n+    assert lm.calls[0][\"kwargs\"][\"prediction\"] == prediction\n+    assert lm.calls[0][\"kwargs\"][\"temperature\"] == 0.5\n+\n+\n+@pytest.mark.asyncio\n+async def test_valid_prediction_moved_to_lm_config_async():\n+    program = Predict(\"question -> answer\")\n+    lm = PredictionSpyLM(\"dummy_model\")\n+    dspy.settings.configure(lm=lm)\n+\n+    prediction = {\"type\": \"content\", \"content\": \"The capital of France is Paris.\"}\n+    await program.acall(question=\"What is the capital of France?\", prediction=prediction)\n+\n+    assert lm.calls[0][\"kwargs\"][\"prediction\"] == prediction\n+\n+\n+@pytest.mark.parametrize(\n+    (\"prediction\", \"expected_in_user_message\"),\n+    [\n+        (\"The capital of France is Paris.\", \"The capital of France is Paris.\"),\n+        ({\"type\": \"unsupported_type\", \"content\": \"The capital of France is Paris.\"}, '\"unsupported_type\"'),\n+        ({\"type\": \"content\"}, '{\"type\": \"content\"}'),\n+    ],\n+)\n+def test_malformed_prediction_left_as_input_data(prediction, expected_in_user_message):\n+    class PredictionSignature(dspy.Signature):\n+        \"\"\"Answer the question.\"\"\"\n+\n+        question: str = dspy.InputField()\n+        prediction = dspy.InputField()\n+        answer: str = dspy.OutputField()\n+\n+    program = Predict(PredictionSignature)\n+    lm = PredictionSpyLM(\"dummy_model\")\n+    dspy.settings.configure(lm=lm)\n+\n+    program(question=\"What is the capital of France?\", prediction=prediction)\n+\n+    assert len(lm.calls) == 1\n+    # Values that don't follow the predicted outputs format are regular inputs, not LM parameters.\n+    assert \"prediction\" not in lm.calls[0][\"kwargs\"]\n+    assert expected_in_user_message in lm.calls[0][\"messages\"][-1][\"content\"]","is_error":false}]},"parent_tool_use_id":null,"session_id":"daf4bd95-90eb-4bd5-a8b2-615c44312155","uuid":"36dd2c48-3c56-4d16-a897-255fd62b586a","timestamp":"2026-09-03T17:50:14.928Z","tool_use_result":{"stdout":"diff --git a/dspy/predict/predict.py b/dspy/predict/predict.py\nindex 9f78ca804..afc7293ef 100644\n--- a/dspy/predict/predict.py\n+++ b/dspy/predict/predict.py\n@@ -108,6 +108,19 @@ class Predict(Module, Parameter):\n         if (temperature is None or temperature <= 0.15) and num_generations > 1:\n             config[\"temperature\"] = 0.7\n \n+        # If the user passes a `prediction` field in the 