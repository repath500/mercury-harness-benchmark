{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_d43ca7fff9ad44e8853e6899","type":"tool_result","content":"1\timport logging\n2\timport os\n3\timport re\n4\timport threading\n5\tfrom typing import Any, Dict, List, Literal, Optional, cast\n6\t\n7\timport litellm\n8\tfrom anyio.streams.memory import MemoryObjectSendStream\n9\tfrom asyncer import syncify\n10\t\n11\timport dspy\n12\tfrom dspy.clients.cache import request_cache\n13\tfrom dspy.clients.openai import OpenAIProvider\n14\tfrom dspy.clients.provider import Provider, ReinforceJob, TrainingJob\n15\tfrom dspy.clients.utils_finetune import TrainDataFormat\n16\tfrom dspy.dsp.utils.settings import settings\n17\tfrom dspy.utils.callback import BaseCallback\n18\t\n19\tfrom .base_lm import BaseLM\n20\t\n21\tlogger = logging.getLogger(__name__)\n22\t\n23\t\n24\tclass LM(BaseLM):\n25\t    \"\"\"\n26\t    A language model supporting chat or text completion requests for use with DSPy modules.\n27\t    \"\"\"\n28\t\n29\t    def __init__(\n30\t        self,\n31\t        model: str,\n32\t        model_type: Literal[\"chat\", \"text\"] = \"chat\",\n33\t        temperature: float = 0.0,\n34\t        max_tokens: int = 4000,\n35\t        cache: bool = True,\n36\t        cache_in_memory: bool = True,\n37\t        callbacks: Optional[List[BaseCallback]] = None,\n38\t        num_retries: int = 3,\n39\t        provider=None,\n40\t        finetuning_model: Optional[str] = None,\n41\t        launch_kwargs: Optional[dict[str, Any]] = None,\n42\t        train_kwargs: Optional[dict[str, Any]] = None,\n43\t        **kwargs,\n44\t    ):\n45\t        \"\"\"\n46\t        Create a new language model instance for use with DSPy modules and programs.\n47\t\n48\t        Args:\n49\t            model: The model to use. This should be a string of the form ``\"llm_provider/llm_name\"``\n50\t                   supported by LiteLLM. For example, ``\"openai/gpt-4o\"``.\n51\t            model_type: The type of the model, either ``\"chat\"`` or ``\"text\"``.\n52\t            temperature: The sampling temperature to use when generating responses.\n53\t            max_tokens: The maximum number of tokens to generate per response.\n54\t            cache: Whether to cache the model responses for reuse to improve performance\n55\t                   and reduce costs.\n56\t            cache_in_memory (deprecated): To enable additional caching with LRU in memory.\n57\t            callbacks: A list of callback functions to run before and after each request.\n58\t            num_retries: The number of times to retry a request if it fails transiently due to\n59\t                         network error, rate limiting, etc. Requests are retried with exponential\n60\t                         backoff.\n61\t            provider: The provider to use. If not specified, the provider will be inferred from the model.\n62\t            finetuning_model: The model to finetune. In some providers, the models available for finetuning is different\n63\t                from the models available for inference.\n64\t        \"\"\"\n65\t        # Remember to update LM.copy() if you modify the constructor!\n66\t        self.model = model\n67\t        self.model_type = model_type\n68\t        self.cache = cache\n69\t        self.cache_in_memory = cache_in_memory\n70\t        self.provider = provider or self.infer_provider()\n71\t        self.callbacks = callbacks or []\n72\t        self.history = []\n73\t        self.num_retries = num_retries\n74\t        self.finetuning_model = finetuning_model\n75\t        self.launch_kwargs = launch_kwargs or {}\n76\t        self.train_kwargs = train_kwargs or {}\n77\t\n78\t        # Handle model-specific configuration for different model families\n79\t        model_family = model.split(\"/\")[-1].lower() if \"/\" in model else model.lower()\n80\t\n81\t        # Match pattern: o[1,3,4] at the start, optionally followed by -mini and anything else\n82\t        model_pattern = re.match(r\"^o([134])(?:-mini)?\", model_family)\n83\t\n84\t        if model_pattern:\n85\t            # Handle OpenAI reasoning models (o1, o3)\n86\t            assert (\n87\t                max_tokens >= 20_000 and temperature == 1.0\n88\t            ), \"OpenAI's reasoning models require passing temperature=1.0 and max_tokens >= 20_000 to `dspy.LM(...)`\"\n89\t            self.kwargs = dict(temperature=temperature, max_completion_tokens=max_tokens, **kwargs)\n90\t        else:\n91\t            self.kwargs = dict(temperature=temperature, max_tokens=max_tokens, **kwargs)\n92\t\n93\t    def _get_cached_completion_fn(self, completion_fn, cache, enable_memory_cache):\n94\t        ignored_args_for_cache_key = [\"api_key\", \"api_base\", \"base_url\"]\n95\t        if cache and enable_memory_cache:\n96\t            completion_fn = request_cache(\n97\t                cache_arg_name=\"request\",\n98\t                ignored_args_for_cache_key=ignored_args_for_cache_key,\n99\t            )(completion_fn)\n100\t        elif cache:\n101\t            completion_fn = request_cache(\n102\t                cache_arg_name=\"request\",\n103\t                ignored_args_for_cache_key=ignored_args_for_cache_key,\n104\t                enable_memory_cache=False,\n105\t            )(completion_fn)\n106\t        else:\n107\t            completion_fn = completion_fn\n108\t\n109\t        if not cache or litellm.cache is None:\n110\t            litellm_cache_args = {\"no-cache\": True, \"no-store\": True}\n111\t        else:\n112\t            litellm_cache_args = {\"no-cache\": False, \"no-store\": False}\n113\t\n114\t        return completion_fn, litellm_cache_args\n115\t\n116\t    def forward(self, prompt=None, messages=None, **kwargs):\n117\t        # Build the request.\n118\t        cache = kwargs.pop(\"cache\", self.cache)\n119\t        enable_memory_cache = kwargs.pop(\"cache_in_memory\", self.cache_in_memory)\n120\t\n121\t        messages = messages or [{\"role\": \"user\", \"content\": prompt}]\n122\t        kwargs = {**self.kwargs, **kwargs}\n123\t\n124\t        completion = litellm_completion if self.model_type == \"chat\" else litellm_text_completion\n125\t        completion, litellm_cache_args = self._get_cached_completion_fn(completion, cache, enable_memory_cache)\n126\t\n127\t        results = completion(\n128\t            request=dict(model=self.model, messages=messages, **kwargs),\n129\t            num_retries=self.num_retries,\n130\t            cache=litellm_cache_args,\n131\t        )\n132\t\n133\t        if any(c.finish_reason == \"length\" for c in results[\"choices\"]):\n134\t            logger.warning(\n135\t                f\"LM response was truncated due to exceeding max_tokens={self.kwargs['max_tokens']}. \"\n136\t                \"You can inspect the latest LM interactions with `dspy.inspect_history()`. \"\n137\t                \"To avoid truncation, consider passing a larger max_tokens when setting up dspy.LM. \"\n138\t                f\"You may also consider increasing the temperature (currently {self.kwargs['temperature']}) \"\n139\t                \" if the reason for truncation is repetition.\"\n140\t            )\n141\t\n142\t        if not getattr(results, \"cache_hit\", False) and dspy.settings.usage_tracker and hasattr(results, \"usage\"):\n143\t            settings.usage_tracker.add_usage(self.model, dict(results.usage))\n144\t        return results\n145\t\n146\t    async def aforward(self, prompt=None, messages=None, **kwargs):\n147\t        # Build the request.\n148\t        cache = kwargs.pop(\"cache\", self.cache)\n149\t        enable_memory_cache = kwargs.pop(\"cache_in_memory\", self.cache_in_memory)\n150\t\n151\t        messages = messages or [{\"role\": \"user\", \"content\": prompt}]\n152\t        kwargs = {**self.kwargs, **kwargs}\n153\t\n154\t        completion = alitellm_completion if self.model_type == \"chat\" else alitellm_text_completion\n155\t        completion, litellm_cache_args = self._get_cached_completion_fn(completion, cache, enable_memory_cache)\n156\t\n157\t        results = await completion(\n158\t            request=dict(model=self.model, messages=messages, **kwargs),\n159\t            num_retries=self.num_retries,\n160\t            cache=litellm_cache_args,\n161\t        )\n162\t\n163\t        if any(c.finish_reason == \"length\" for c in results[\"choices\"]):\n164\t            logger.warning(\n165\t                f\"LM response was truncated due to exceeding max_tokens={self.kwargs['max_tokens']}. \"\n166\t                \"You can inspect the latest LM interactions with `dspy.inspect_history()`. \"\n167\t                \"To avoid truncation, consider passing a larger max_tokens when setting up dspy.LM. \"\n168\t                f\"You may also consider increasing the temperature (currently {self.kwargs['temperature']}) \"\n169\t                \" if the reason for truncation is repetition.\"\n170\t            )\n171\t\n172\t        if not getattr(results, \"cache_hit\", False) and dspy.settings.usage_tracker and hasattr(results, \"usage\"):\n173\t            settings.usage_tracker.add_usage(self.model, dict(results.usage))\n174\t        return results\n175\t\n176\t    def launch(self, launch_kwargs: Optional[Dict[str, Any]] = None):\n177\t        self.provider.launch(self, launch_kwargs)\n178\t\n179\t    def kill(self, launch_kwargs: Optional[Dict[str, Any]] = None):\n180\t        self.provider.kill(self, launch_kwargs)\n181\t\n182\t    def finetune(\n183\t        self,\n184\t        train_data: List[Dict[str, Any]],\n185\t        train_data_format: Optional[TrainDataFormat],\n186\t        train_kwargs: Optional[Dict[str, Any]] = None,\n187\t    ) -> TrainingJob:\n188\t        from dspy import settings as settings\n189\t\n190\t        err = f\"Provider {self.provider} does not support fine-tuning.\"\n191\t        assert self.provider.finetunable, err\n192\t\n193\t        def thread_function_wrapper():\n194\t            return self._run_finetune_job(job)\n195\t\n196\t        thread = threading.Thread(target=thread_function_wrapper)\n197\t        train_kwargs = train_kwargs or self.train_kwargs\n198\t        model_to_finetune = self.finetuning_model or self.model\n199\t        job = self.provider.TrainingJob(\n200\t            thread=thread,\n201\t            model=model_to_finetune,\n202\t            train_data=train_data,\n203\t            train_data_format=train_data_format,\n204\t            train_kwargs=train_kwargs,\n205\t        )\n206\t        thread.start()\n207\t\n208\t        return job\n209\t\n210\t    def reinforce(self, train_kwargs) -> ReinforceJob:\n211\t        # TODO(GRPO Team): Should we return an initialized job here?\n212\t        from dspy import settings as settings\n213\t\n214\t        err = f\"Provider {self.provider} does not implement the reinforcement learning interface.\"\n215\t        assert self.provider.reinforceable, err\n216\t\n217\t        job = self.provider.ReinforceJob(lm=self, train_kwargs=train_kwargs)\n218\t        job.initialize()\n219\t        return job\n220\t\n221\t    def _run_finetune_job(self, job: TrainingJob):\n222\t        # TODO(enhance): We should listen for keyboard interrupts somewhere.\n223\t        # Requires TrainingJob.cancel() to be implemented for each provider.\n224\t        try:\n225\t            model = self.provider.finetune(\n226\t                job=job,\n227\t                model=job.model,\n228\t                train_data=job.train_data,\n229\t                train_data_format=job.train_data_format,\n230\t                train_kwargs=job.train_kwargs,\n231\t            )\n232\t            lm = self.copy(model=model)\n233\t            job.set_result(lm)\n234\t        except Exception as err:\n235\t            logger.error(err)\n236\t            job.set_result(err)\n237\t\n238\t    def infer_provider(self) -> Provider:\n239\t        if OpenAIProvider.is_provider_model(self.model):\n240\t            return OpenAIProvider()\n241\t        return Provider()\n242\t\n243\t    def dump_state(self):\n244\t        state_keys = [\n245\t            \"model\",\n246\t            \"model_type\",\n247\t            \"cache\",\n248\t            \"cache_in_memory\",\n249\t            \"num_retries\",\n250\t            \"finetuning_model\",\n251\t            \"launch_kwargs\",\n252\t            \"train_kwargs\",\n253\t        ]\n254\t        return {key: getattr(self, key) for key in state_keys} | self.kwargs\n255\t\n256\t\n257\tdef _get_stream_completion_fn(\n258\t    request: Dict[str, Any],\n259\t    cache_kwargs: Dict[str, Any],\n260\t    sync=True,\n261\t):\n262\t    stream = dspy.settings.send_stream\n263\t    caller_predict = dspy.settings.caller_predict\n264\t\n265\t    if stream is None:\n266\t        return None\n267\t\n268\t    # The stream is already opened, and will be closed by the caller.\n269\t    stream = cast(MemoryObjectSendStream, stream)\n270\t    caller_predict_id = id(caller_predict) if caller_predict else None\n271\t\n272\t    async def stream_completion(request: Dict[str, Any], cache_kwargs: Dict[str, Any]):\n273\t        response = await litellm.acompletion(\n274\t            cache=cache_kwargs,\n275\t            stream=True,\n276\t            **request,\n277\t        )\n278\t        chunks = []\n279\t        async for chunk in response:\n280\t            if caller_predict_id:\n281\t                # Add the predict id to the chunk so that the stream listener can identify which predict produces it.\n282\t                chunk.predict_id = caller_predict_id\n283\t            chunks.append(chunk)\n284\t            await stream.send(chunk)\n285\t        return litellm.stream_chunk_builder(chunks)\n286\t\n287\t    def sync_stream_completion():\n288\t        syncified_stream_completion = syncify(stream_completion)\n289\t        return syncified_stream_completion(request, cache_kwargs)\n290\t\n291\t    async def async_stream_completion():\n292\t        return await stream_completion(request, cache_kwargs)\n293\t\n294\t    if sync:\n295\t        return sync_stream_completion\n296\t    else:\n297\t        return async_stream_completion\n298\t\n299\t\n300\tdef litellm_completion(request: Dict[str, Any], num_retries: int, cache: Optional[Dict[str, Any]] = None):\n301\t    cache = cache or {\"no-cache\": True, \"no-store\": True}\n302\t    stream_completion = _get_stream_completion_fn(request, cache, sync=True)\n303\t    if stream_completion is None:\n304\t        return litellm.completion(\n305\t            cache=cache,\n306\t            num_retries=num_retries,\n307\t            retry_strategy=\"exponential_backoff_retry\",\n308\t            **request,\n309\t        )\n310\t\n311\t    return stream_completion()\n312\t\n313\t\n314\tdef litellm_text_completion(request: Dict[str, Any], num_retries: int, cache: Optional[Dict[str, Any]] = None):\n315\t    cache = cache or {\"no-cache\": True, \"no-store\": True}\n316\t    # Extract the provider and model from the model string.\n317\t    # TODO: Not all the models are in the format of \"provider/model\"\n318\t    model = request.pop(\"model\").split(\"/\", 1)\n319\t    provider, model = model[0] if len(model) > 1 else \"openai\", model[-1]\n320\t\n321\t    # Use the API key and base from the request, or from the environment.\n322\t    api_key = request.pop(\"api_key\", None) or os.getenv(f\"{provider}_API_KEY\")\n323\t    api_base = request.pop(\"api_base\", None) or os.getenv(f\"{provider}_API_BASE\")\n324\t\n325\t    # Build the prompt from the messages.\n326\t    prompt = \"\\n\\n\".join([x[\"content\"] for x in request.pop(\"messages\")] + [\"BEGIN RESPONSE:\"])\n327\t\n328\t    return litellm.text_completion(\n329\t        cache=cache,\n330\t        model=f\"text-completion-openai/{model}\",\n331\t        api_key=api_key,\n332\t        api_base=api_base,\n333\t        prompt=prompt,\n334\t        num_retries=num_retries,\n335\t        retry_strategy=\"exponential_backoff_retry\",\n336\t        **request,\n337\t    )\n338\t\n339\t\n340\tasync def alitellm_completion(request: Dict[str, Any], num_retries: int, cache: Optional[Dict[str, Any]] = None):\n341\t    cache = cache or {\"no-cache\": True, \"no-store\": True}\n342\t    stream_completion = _get_stream_completion_fn(request, cache, sync=False)\n343\t    if stream_completion is None:\n344\t        return await litellm.acompletion(\n345\t            cache=cache,\n346\t            num_retries=num_retries,\n347\t            retry_strategy=\"exponential_backoff_retry\",\n348\t            **request,\n349\t        )\n350\t\n351\t    return await stream_completion()\n352\t\n353\t\n354\tasync def alitellm_text_completion(request: Dict[str, Any], num_retries: int, cache: Optional[Dict[str, Any]] = None):\n355\t    cache = cache or {\"no-cache\": True, \"no-store\": True}\n356\t    model = request.pop(\"model\").split(\"/\", 1)\n357\t    provider, model = model[0] if len(model) > 1 else \"openai\", model[-1]\n358\t\n359\t    # Use the API key and base from the request, or from the environment.\n360\t    api_key = request.pop(\"api_key\", None) or os.getenv(f\"{provider}_API_KEY\")\n361\t    api_base = request.pop(\"api_base\", None) or os.getenv(f\"{provider}_API_BASE\")\n362\t\n363\t    # Build the prompt from the messages.\n364\t    prompt = \"\\n\\n\".join([x[\"content\"] for x in request.pop(\"messages\")] + [\"BEGIN RESPONSE:\"])\n365\t\n366\t    return await litellm.atext_completion(\n367\t        cache=cache,\n368\t        model=f\"text-completion-openai/{model}\",\n369\t        api_key=api_key,\n370\t        api_base=api_base,\n371\t        prompt=prompt,\n372\t        num_retries=num_retries,\n373\t        retry_strategy=\"exponential_backoff_retry\",\n374\t        **request,\n375\t    )\n376\t"}]},"parent_tool_use_id":null,"session_id":"daf4bd95-90eb-4bd5-a8b2-615c44312155","uuid":"dfcf6743-0a7f-4ccb-8f68-1af1f37b391a","timestamp":"2026-09-03T17:45:51.320Z","tool_use_result":{"type":"text","file":{"filePath":"/testbed/dspy/clients/lm.py","content":"import logging\nimport os\nimport re\nimport threading\nfrom typing import Any, Dict, List, Literal, Optional, cast\n\nimport litellm\nfrom anyio.streams.memory import MemoryObjectSendStream\nfrom asyncer import syncify\n\nimport dspy\nfrom dspy.clients.cache import request_cache\nfrom dspy.clients.openai import OpenAIProvider\nfrom dspy.clients.provider import Provider, ReinforceJob, TrainingJob\nfrom dspy.clients.utils_finetune import TrainDataFormat\nfrom dspy.dsp.utils.settings import settings\nfrom dspy.utils.callback import BaseCallback\n\nfrom .base_lm import BaseLM\n\nlogger = logging.getLogger(__name__)\n\n\nclass LM(BaseLM):\n    \"\"\"\n    A language model supporting chat or text completion requests for use with DSPy modules.\n    \"\"\"\n\n    def __init__(\n        self,\n        model: str,\n        model_type: Literal[\"chat\", \"text\"] = \"chat\",\n        temperature: float = 0.0,\n        max_tokens: int = 4000,\n        cache: bool = True,\n        cache_in_memory: bool = True,\n        callbacks: Optional[List[BaseCallback]] = None,\n        num_retries: int = 3,\n        provider=None,\n        finetuning_model: Optional[str] = None,\n        launch_kwargs: Optional[dict[str, Any]] = None,\n        train_kwargs: Optional[dict[str, Any]] = None,\n        **kwargs,\n    ):\n        \"\"\"\n        Create a new language model instance for use with DSPy modules and programs.\n\n        Args:\n            model: The model to use. This should be a string of the form ``\"llm_provider/llm_name\"``\n                   supported by LiteLLM. For example, ``\"openai/gpt-4o\"``.\n            model_type: The type of the model, either ``\"chat\"`` or ``\"text\"``.\n            temperature: The sampling temperature to use when generating responses.\n            max_tokens: The maximum number of tokens to generate per response.\n            cache: Whether to cache the model responses for reuse to improve performance\n                   and reduce costs.\n            cache_in_memory (deprecated): To enable additional caching with LRU in memory.\n            callbacks: A list of callback functions to run before and after each request.\n            num_retries: The number of times to retry a request if it fails transiently due to\n                         network error, rate limiting, etc. Requests are retried with exponential\n                         backoff.\n            provider: The provider to use. If not specified, the provider will be inferred from the model.\n            finetuning_model: The model to finetune. In some providers, the models available for finetuning is different\n                from the models available for inference.\n        \"\"\"\n        # Remember to update LM.copy() if you modify the constructor!\n        self.model = model\n        self.model_type = model_type\n        self.cache = cache\n        self.cache_in_memory = cache_in_memory\n        self.provider = provider or self.infer_provider()\n        self.callbacks = callbacks or []\n        self.history = []\n        self.num_retries = num_retries\n        self.finetuning_model = finetuning_model\n        self.launch_kwargs = launch_kwargs or {}\n        self.train_kwargs = train_kwargs or {}\n\n        # Handle model-specific configuration for different model families\n        model_family = model.split(\"/\")[-1].lower() if \"/\" in model else model.lower()\n\n        # Match pattern: o[1,3,4] at the start, optionally followed by -mini and anything else\n        model_pattern = re.match(r\"^o([134])(?:-mini)?\", model_family)\n\n        if model_pattern:\n            # Handle OpenAI reasoning models (o1, o3)\n            assert (\n                max_tokens >= 20_000 and temperature == 1.0\n            ), \"OpenAI's reasoning models require passing temperature=1.0 and max_tokens >= 20_000 to `dspy.LM(...)`\"\n            self.kwargs = dict(temperature=temperature, max_completion_tokens=max_tokens, **kwargs)\n        else:\n            self.kwargs = dict(temperature=temperature, max_tokens=max_tokens, **kwargs)\n\n    def _get_cached_completion_fn(self, completion_fn, cache, enable_memory_cache):\n        ignored_args_for_cache_key = [\"api_key\", \"api_base\", \"base_url\"]\n        if cache and enable_memory_cache:\n            completion_fn = request_cache(\n                cache_arg_name=\"request\",\n                ignored_args_for_cache_key=ignored_args_for_cache_key,\n            )(completion_fn)\n        elif cache:\n            completion_fn = request_cache(\n                cache_arg_name=\"request\",\n                ignored_args_for_cache_key=ignored_args_for_cache_key,\n                enable_memory_cache=False,\n            )(completion_fn)\n        else:\n            completion_fn = completion_fn\n\n        if not cache or litellm.cache is None:\n            litellm_cache_args = {\"no-cache\": True, \"no-store\": True}\n        else:\n            litellm_cache_args = {\"no-cache\": False, \"no-store\": False}\n\n        return completion_fn, litellm_cache_args\n\n    def forward(self, prompt=None, messages=None, **kwargs):\n        # Build the request.\n        cache = kwargs.pop(\"cache\", self.cache)\n        enable_memory_cache = kwargs.pop(\"cache_in_memory\", self.cache_in_memory)\n\n        messages = messages or [{\"role\": \"user\", \"content\": prompt}]\n        kwargs = {**self.kwargs, **kwargs}\n\n        completion = litellm_completion if self.model_type == \"chat\" else litellm_text_completion\n        completion, litellm_cache_args = self._get_cached_completion_fn(completion, cache, enable_memory_cache)\n\n        results = completion(\n            request=dict(model=self.model, messages=messages, **kwargs),\n            num_retries=self.num_retries,\n            cache=litellm_cache_args,\n        )\n\n        if any(c.finish_reason == \"length\" for c in results[\"choices\"]):\n            logger.warning(\n                f\"LM response was truncated due to exceeding max_tokens={self.kwargs['max_tokens']}. \"\n                \"You can inspect the latest LM interactions with `dspy.inspect_history()`. \"\n                \"To avoid truncation, consider passing a larger max_tokens when setting up dspy.LM. \"\n                f\"You may also consider increasing the temperature (currently {self.kwargs['temperature']}) \"\n                \" if the reason for truncation is repetition.\"\n            )\n\n        if not getattr(results, \"cache_hit\", False) and dspy.settings.usage_tracker and hasattr(results, \"usage\"):\n            settings.usage_tracker.add_usage(self.model, dict(results.usage))\n        return results\n\n    async def aforward(self, prompt=None, messages=None, **kwargs):\n        # Build the request.\n        cache = kwargs.pop(\"cache\", self.cache)\n        enable_memory_cache = kwargs.pop(\"cache_in_memory\", self.cache_in_memory)\n\n        messages = messages or [{\"role\": \"user\", \"content\": prompt}]\n        kwargs = {**self.kwargs, **kwargs}\n\n        completion = alitellm_completion if self.model_type == \"chat\" else alitellm_text_completion\n        completion, litellm_cache_args = self._get_cached_completion_fn(completion, cache, enable_memory_cache)\n\n        results = await completion(\n            request=dict(model=self.model, messages=messages, **kwargs),\n            num_retries=self.num_retries,\n            cache=litellm_cache_args,\n        )\n\n        if any(c.finish_reason == \"length\" for c in results[\"choices\"]):\n            logger.warning(\n                f\"LM response was truncated due to exceeding max_tokens={self.kwargs['max_tokens']}. \"\n                \"You can inspect the latest LM interactions with `dspy.inspect_history()`. \"\n                \"To avoid truncation, consider passing a larger max_tokens when setting up dspy.LM. \"\n                f\"You may also consider increasing the temperature (currently {self.kwargs['temperature']}) \"\n                \" if the reason for truncation is repetition.\"\n            )\n\n        if not getattr(results, \"cache_hit\", False) and dspy.settings.usage_tracker and hasattr(results, \"usage\"):\n            settings.usage_tracker.add_usage(self.model, dict(results.usage))\n        return results\n\n    def launch(self, launch_kwargs: Optional[Dict[str, Any]] = None):\n        self.provider.launch(self, launch_kwargs)\n\n    def kill(self, launch_kwargs: Optional[Dict[str, Any]] = None):\n        self.provider.kill(self, launch_kwargs)\n\n    def finetune(\n        self,\n        train_data: List[Dict[str, Any]],\n        train_data_format: Optional[TrainDataFormat],\n        train_kwargs: Optional[Dict[str, Any]] = None,\n    ) -> TrainingJob:\n        from dspy import settings as settings\n\n        err = f\"Provider {self.provider} does not support fine-tuning.\"\n        assert self.provider.finetunable, err\n\n        def thread_function_wrapper():\n            return self._run_finetune_job(job)\n\n        thread = threading.Thread(target=thread_function_wrapper)\n        train_kwargs = train_kwargs or self.train_kwargs\n        model_to_finetune = self.finetuning_model or self.model\n        job = self.provider.TrainingJob(\n            thread=thread,\n            model=model_to_finetune,\n            train_data=train_data,\n            train_data_format=train_data_format,\n            train_kwargs=train_kwargs,\n        )\n        thread.start()\n\n        return job\n\n    def reinforce(self, train_kwargs) -> ReinforceJob:\n        # TODO(GRPO Team): Should we return an initialized job here?\n        from dspy import settings as settings\n\n        err = f\"Provider {self.provider} does not implement the reinforcement learning interface.\"\n        assert self.provider.reinforceable, err\n\n        job = self.provider.ReinforceJob(lm=self, train_kwargs=train_kwargs)\n        job.initialize()\n        return job\n\n    def _run_finetune_job(self, job: TrainingJob):\n        # TODO(enhance): We should listen for keyboard interrupts somewhere.\n        # Requires TrainingJob.cancel() to be implemented for each provider.\n        try:\n            model = self.provider.finetune(\n                job=job,\n                model=job.model,\n                train_data=job.train_data,\n                train_data_format=job.train_data_format,\n                train_kwargs=job.train_kwargs,\n            )\n            lm = self.copy(model=model)\n            job.set_result(lm)\n        except Exception as err:\n            logger.error(err)\n            job.set_result(err)\n\n    def infer_provider(self) -> Provider:\n        if OpenAIProvider.is_provider_model(self.model):\n            return OpenAIProvider()\n        return Provider()\n\n    def dump_state(self):\n        state_keys = [\n            \"model\",\n            \"model_type\",\n            \"cache\",\n            \"cache_in_memory\",\n            \"num_retries\",\n            \"finetuning_model\",\n            \"launch_kwargs\",\n            \"train_kwargs\",\n        ]\n        return {key: getattr(self, key) for key in state_keys} | self.kwargs\n\n\ndef _get_stream_completion_fn(\n    request: Dict[str, Any],\n    cache_kwargs: Dict[str, Any],\n    sync=True,\n):\n    stream = dspy.settings.send_stream\n    caller_predict = dspy.settings.caller_predict\n\n    if stream is None:\n        return None\n\n    # The stream is already opened, and will be closed by the caller.\n    stream = cast(MemoryObjectSendStream, stream)\n    caller_predict_id = id(caller_predict) if caller_predict else None\n\n    async def stream_completion(request: Dict[str, Any], cache_kwargs: Dict[str, Any]):\n        response = await litellm.acompletion(\n            cache=cache_kwargs,\n            stream=True,\n            **request,\n        )\n        chunks = []\n        async for chunk in response:\n            if caller_predict_id:\n                # Add the predict id to the chunk so that the stream listener can identify which predict produces it.\n                chunk.predict_id = caller_predict_id\n            chunks.append(chunk)\n            await stream.send(chunk)\n        return litellm.stream_chunk_builder(chunks)\n\n    def sync_stream_completion():\n        syncified_stream_completion = syncify(stream_completion)\n        return syncified_stream_completion(request, cache_kwargs)\n\n    async def async_stream_completion():\n        return await stream_completion(request, cache_kwargs)\n\n    if sync:\n        return sync_stream_completion\n    else:\n        return async_stream_completion\n\n\ndef litellm_completion(request: Dict[str, Any], num_retries: int, cache: Optional[Dict[str, Any]] = None):\n    cache = cache or {\"no-cache\": True, \"no-store\": True}\n    stream_completion = _get_stream_completion_fn(request, cache, sync=True)\n    if stream_completion is None:\n        return litellm.completion(\n            cache=cache,\n            num_retries=num_retries,\n            retry_strategy=\"exponential_backoff_retry\",\n            **request,\n        )\n\n    return stream_completion()\n\n\ndef litellm_text_completion(request: Dict[str, Any], num_retries: int, cache: Optional[Dict[str, Any]] = None):\n    cache = cache or {\"no-cache\": True, \"no-store\": True}\n    # Extract the provider and model from the model string.\n    # TODO: Not all the models are in the format of \"provider/model\"\n    model = request.pop(\"model\").split(\"/\", 1)\n    provider, model = model[0] if len(model) > 1 else \"openai\", model[-1]\n\n    # Use the API key and base from the request, or from the environment.\n    api_key = request.pop(\"api_key\", None) or os.getenv(f\"{provider}_API_KEY\")\n    api_base = request.pop(\"api_base\", None) or os.getenv(f\"{provider}_API_BASE\")\n\n    # Build the prompt from the messages.\n    prompt = \"\\n\\n\".join([x[\"content\"] for x in request.pop(\"messages\")] + [\"BEGIN RESPONSE:\"])\n\n    return litellm.text_completion(\n        cache=cache,\n        model=f\"text-completion-openai/{model}\",\n        api_key=api_key,\n        api_base=api_base,\n        prompt=prompt,\n        num_retries=num_retries,\n        retry_strategy=\"exponential_backoff_retry\",\n        **request,\n    )\n\n\nasync def alitellm_completion(request: Dict[str, Any], num_retries: int, cache: Optional[Dict[str, Any]] = None):\n    cache = cache or {\"no-cache\": True, \"no-store\": True}\n    stream_completion = _get_stream_completion_fn(request, cache, sync=False)\n    if stream_completion is None:\n        return await litellm.acompletion(\n            cache=cache,\n            num_retries=num_retries,\n            retry_strategy=\"exponential_backoff_retry\",\n            **request,\n        )\n\n    return await stream_completion()\n\n\nasync def alitellm_text_completion(request: Dict[str, Any], num_retries: int, cache: Optional[Dict[str, Any]] = None):\n    cache = cache or {\"no-cache\": True, \"no-store\": True}\n    model = request.pop(\"model\").split(\"/\", 1)\n    provider, model = model[0] if len(model) > 1 else \"openai\", model[-1]\n\n    # Use the API key and base from the request, or from the environment.\n    api_key = request.pop(\"api_key\", None) or os.getenv(f\"{provider}_API_KEY\")\n    api_base = request.pop(\"api_base\", None) or os.getenv(f\"{provider}_API_BASE\")\n\n    # Build the prompt from the messages.\n    prompt = \"\\n\\n\".join([x[\"content\"] for x in request.pop(\"messages\")] + [\"BEGIN RESPONSE:\"])\n\n    return await litellm.atext_completion(\n        cache=cache,\n        model=f\"text-completion-openai/{model}\",\n        api_key=api_key,\n        api_base=api_base,\n        prompt=prompt,\n        num_retries=num_retries,\n        retry_strategy=\"exponential_backoff_retry\",\n        **request,\n    )\n","numLines":376,"startLine":1,"totalLines":376}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f1937495acc24850927902a3","type":"tool_result","content":"1\timport copy\n2\timport enum\n3\tfrom datetime import datetime\n4\tfrom unittest.mock import patch\n5\t\n6\timport pydantic\n7\timport pytest\n8\timport ujson\n9\tfrom litellm import ModelResponse\n10\t\n11\timport dspy\n12\tfrom dspy import Predict, Signature\n13\tfrom dspy.utils.dummies import DummyLM\n14\t\n15\t\n16\tdef test_initialization_with_string_signature():\n17\t    signature_string = \"input1, input2 -> output\"\n18\t    predict = Predict(signature_string)\n19\t    expected_instruction = \"Given the fields `input1`, `input2`, produce the fields `output`.\"\n20\t    assert predict.signature.instructions == expected_instruction\n21\t    assert predict.signature.instructions == Signature(signature_string).instructions\n22\t\n23\t\n24\tdef test_reset_method():\n25\t    predict_instance = Predict(\"input -> output\")\n26\t    predict_instance.lm = \"modified\"\n27\t    predict_instance.traces = [\"trace\"]\n28\t    predict_instance.train = [\"train\"]\n29\t    predict_instance.demos = [\"demo\"]\n30\t    predict_instance.reset()\n31\t    assert predict_instance.lm is None\n32\t    assert predict_instance.traces == []\n33\t    assert predict_instance.train == []\n34\t    assert predict_instance.demos == []\n35\t\n36\t\n37\tdef test_lm_after_dump_and_load_state():\n38\t    predict_instance = Predict(\"input -> output\")\n39\t    lm = dspy.LM(\n40\t        model=\"openai/gpt-4o-mini\",\n41\t        model_type=\"chat\",\n42\t        temperature=1,\n43\t        max_tokens=100,\n44\t        num_retries=10,\n45\t    )\n46\t    predict_instance.lm = lm\n47\t    expected_lm_state = {\n48\t        \"model\": \"openai/gpt-4o-mini\",\n49\t        \"model_type\": \"chat\",\n50\t        \"temperature\": 1,\n51\t        \"max_tokens\": 100,\n52\t        \"num_retries\": 10,\n53\t        \"cache\": True,\n54\t        \"cache_in_memory\": True,\n55\t        \"finetuning_model\": None,\n56\t        \"launch_kwargs\": {},\n57\t        \"train_kwargs\": {},\n58\t    }\n59\t    assert lm.dump_state() == expected_lm_state\n60\t    dumped_state = predict_instance.dump_state()\n61\t    new_instance = Predict(\"input -> output\")\n62\t    new_instance.load_state(dumped_state)\n63\t    assert new_instance.lm.dump_state() == expected_lm_state\n64\t\n65\t\n66\tdef test_call_method():\n67\t    predict_instance = Predict(\"input -> output\")\n68\t    lm = DummyLM([{\"output\": \"test output\"}])\n69\t    dspy.settings.configure(lm=lm)\n70\t    result = predict_instance(input=\"test input\")\n71\t    assert result.output == \"test output\"\n72\t\n73\t\n74\tdef test_instructions_after_dump_and_load_state():\n75\t    predict_instance = Predict(Signature(\"input -> output\", \"original instructions\"))\n76\t    dumped_state = predict_instance.dump_state()\n77\t    new_instance = Predict(Signature(\"input -> output\", \"new instructions\"))\n78\t    new_instance.load_state(dumped_state)\n79\t    assert new_instance.signature.instructions == \"original instructions\"\n80\t\n81\t\n82\tdef test_demos_after_dump_and_load_state():\n83\t    class TranslateToEnglish(dspy.Signature):\n84\t        \"\"\"Translate content from a language to English.\"\"\"\n85\t\n86\t        content: str = dspy.InputField()\n87\t        language: str = dspy.InputField()\n88\t        translation: str = dspy.OutputField()\n89\t\n90\t    original_instance = Predict(TranslateToEnglish)\n91\t    original_instance.demos = [\n92\t        dspy.Example(\n93\t            content=\"¿Qué tal?\",\n94\t            language=\"SPANISH\",\n95\t            translation=\"Hello there\",\n96\t        ).with_inputs(\"content\", \"language\"),\n97\t    ]\n98\t\n99\t    dumped_state = original_instance.dump_state()\n100\t    assert len(dumped_state[\"demos\"]) == len(original_instance.demos)\n101\t    assert dumped_state[\"demos\"][0][\"content\"] == original_instance.demos[0].content\n102\t\n103\t    saved_state = ujson.dumps(dumped_state)\n104\t    loaded_state = ujson.loads(saved_state)\n105\t\n106\t    new_instance = Predict(TranslateToEnglish)\n107\t    new_instance.load_state(loaded_state)\n108\t    assert len(new_instance.demos) == len(original_instance.demos)\n109\t    # Demos don't need to keep the same types after saving and loading the state.\n110\t    assert new_instance.demos[0][\"content\"] == original_instance.demos[0].content\n111\t\n112\t\n113\tdef test_typed_demos_after_dump_and_load_state():\n114\t    class Item(pydantic.BaseModel):\n115\t        name: str\n116\t        quantity: int\n117\t\n118\t    class InventorySignature(dspy.Signature):\n119\t        \"\"\"Handle inventory items and their translations.\"\"\"\n120\t\n121\t        items: list[Item] = dspy.InputField()\n122\t        language: str = dspy.InputField()\n123\t        translated_items: list[Item] = dspy.OutputField()\n124\t        total_quantity: int = dspy.OutputField()\n125\t\n126\t    original_instance = Predict(InventorySignature)\n127\t    original_instance.demos = [\n128\t        dspy.Example(\n129\t            items=[Item(name=\"apple\", quantity=5), Item(name=\"banana\", quantity=3)],\n130\t            language=\"SPANISH\",\n131\t            translated_items=[Item(name=\"manzana\", quantity=5), Item(name=\"plátano\", quantity=3)],\n132\t            total_quantity=8,\n133\t        ).with_inputs(\"items\", \"language\"),\n134\t    ]\n135\t\n136\t    # Test dump_state\n137\t    dumped_state = original_instance.dump_state()\n138\t    assert len(dumped_state[\"demos\"]) == len(original_instance.demos)\n139\t    # Verify the input items were properly serialized\n140\t    assert isinstance(dumped_state[\"demos\"][0][\"items\"], list)\n141\t    assert len(dumped_state[\"demos\"][0][\"items\"]) == 2\n142\t    assert dumped_state[\"demos\"][0][\"items\"][0] == {\"name\": \"apple\", \"quantity\": 5}\n143\t\n144\t    # Test serialization/deserialization\n145\t    saved_state = ujson.dumps(dumped_state)\n146\t    loaded_state = ujson.loads(saved_state)\n147\t\n148\t    # Test load_state\n149\t    new_instance = Predict(InventorySignature)\n150\t    new_instance.load_state(loaded_state)\n151\t    assert len(new_instance.demos) == len(original_instance.demos)\n152\t\n153\t    # Verify the structure is maintained after loading\n154\t    loaded_demo = new_instance.demos[0]\n155\t    assert isinstance(loaded_demo[\"items\"], list)\n156\t    assert len(loaded_demo[\"items\"]) == 2\n157\t    assert loaded_demo[\"items\"][0][\"name\"] == \"apple\"\n158\t    assert loaded_demo[\"items\"][0][\"quantity\"] == 5\n159\t    assert loaded_demo[\"items\"][1][\"name\"] == \"banana\"\n160\t    assert loaded_demo[\"items\"][1][\"quantity\"] == 3\n161\t\n162\t    # Verify output items were also properly maintained\n163\t    assert isinstance(loaded_demo[\"translated_items\"], list)\n164\t    assert len(loaded_demo[\"translated_items\"]) == 2\n165\t    assert loaded_demo[\"translated_items\"][0][\"name\"] == \"manzana\"\n166\t    assert loaded_demo[\"translated_items\"][1][\"name\"] == \"plátano\"\n167\t\n168\t\n169\t# def test_typed_demos_after_dump_and_load_state():\n170\t#     class TypedTranslateToEnglish(dspy.Signature):\n171\t#         \"\"\"Translate content from a language to English.\"\"\"\n172\t\n173\t#         class Input(pydantic.BaseModel):\n174\t#             content: str\n175\t#             language: str\n176\t\n177\t#         class Output(pydantic.BaseModel):\n178\t#             translation: str\n179\t\n180\t#         input: Input = dspy.InputField()\n181\t#         output: Output = dspy.OutputField()\n182\t\n183\t#     original_instance = TypedPredictor(TypedTranslateToEnglish).predictor\n184\t#     original_instance.demos = [\n185\t#         dspy.Example(\n186\t#             input=TypedTranslateToEnglish.Input(\n187\t#                 content=\"¿Qué tal?\",\n188\t#                 language=\"SPANISH\",\n189\t#             ),\n190\t#             output=TypedTranslateToEnglish.Output(\n191\t#                 translation=\"Hello there\",\n192\t#             ),\n193\t#         ).with_inputs(\"input\"),\n194\t#     ]\n195\t\n196\t#     dumped_state = original_instance.dump_state()\n197\t#     assert len(dumped_state[\"demos\"]) == len(original_instance.demos)\n198\t#     assert dumped_state[\"demos\"][0][\"input\"] == original_instance.demos[0].input.model_dump_json()\n199\t\n200\t#     saved_state = ujson.dumps(dumped_state)\n201\t#     loaded_state = ujson.loads(saved_state)\n202\t\n203\t#     new_instance = TypedPredictor(TypedTranslateToEnglish).predictor\n204\t#     new_instance.load_state(loaded_state)\n205\t#     assert len(new_instance.demos) == len(original_instance.demos)\n206\t#     # Demos don't need to keep the same types after saving and loading the state.\n207\t#     assert new_instance.demos[0][\"input\"] == original_instance.demos[0].input.model_dump_json()\n208\t\n209\t\n210\tdef test_signature_fields_after_dump_and_load_state(tmp_path):\n211\t    class CustomSignature(dspy.Signature):\n212\t        \"\"\"I am just an instruction.\"\"\"\n213\t\n214\t        sentence = dspy.InputField(desc=\"I am an innocent input!\")\n215\t        sentiment = dspy.OutputField()\n216\t\n217\t    file_path = tmp_path / \"tmp.json\"\n218\t    original_instance = Predict(CustomSignature)\n219\t    original_instance.save(file_path)\n220\t\n221\t    class CustomSignature2(dspy.Signature):\n222\t        \"\"\"I am not a pure instruction.\"\"\"\n223\t\n224\t        sentence = dspy.InputField(desc=\"I am a malicious input!\")\n225\t        sentiment = dspy.OutputField(desc=\"I am a malicious output!\", prefix=\"I am a prefix!\")\n226\t\n227\t    new_instance = Predict(CustomSignature2)\n228\t    assert new_instance.signature.dump_state() != original_instance.signature.dump_state()\n229\t    # After loading, the fields should be the same.\n230\t    new_instance.load(file_path)\n231\t    assert new_instance.signature.dump_state() == original_instance.signature.dump_state()\n232\t\n233\t\n234\t@pytest.mark.parametrize(\"filename\", [\"model.json\", \"model.pkl\"])\n235\tdef test_lm_field_after_dump_and_load_state(tmp_path, filename):\n236\t    file_path = tmp_path / filename\n237\t    lm = dspy.LM(\n238\t        model=\"openai/gpt-4o-mini\",\n239\t        model_type=\"chat\",\n240\t        temperature=1,\n241\t        max_tokens=100,\n242\t        num_retries=10,\n243\t    )\n244\t    original_predict = dspy.Predict(\"q->a\")\n245\t    original_predict.lm = lm\n246\t\n247\t    original_predict.save(file_path)\n248\t\n249\t    assert file_path.exists()\n250\t\n251\t    loaded_predict = dspy.Predict(\"q->a\")\n252\t    loaded_predict.load(file_path)\n253\t\n254\t    assert original_predict.dump_state() == loaded_predict.dump_state()\n255\t\n256\t\n257\tdef test_forward_method():\n258\t    program = Predict(\"question -> answer\")\n259\t    dspy.settings.configure(lm=DummyLM([{\"answer\": \"No more responses\"}]))\n260\t    result = program(question=\"What is 1+1?\").answer\n261\t    assert result == \"No more responses\"\n262\t\n263\t\n264\tdef test_forward_method2():\n265\t    program = Predict(\"question -> answer1, answer2\")\n266\t    dspy.settings.configure(lm=DummyLM([{\"answer1\": \"my first answer\", \"answer2\": \"my second answer\"}]))\n267\t    result = program(question=\"What is 1+1?\")\n268\t    assert result.answer1 == \"my first answer\"\n269\t    assert result.answer2 == \"my second answer\"\n270\t\n271\t\n272\tdef test_config_management():\n273\t    predict_instance = Predict(\"input -> output\")\n274\t    predict_instance.update_config(new_key=\"value\")\n275\t    config = predict_instance.get_config()\n276\t    assert \"new_key\" in config and config[\"new_key\"] == \"value\"\n277\t\n278\t\n279\tdef test_multi_output():\n280\t    program = Predict(\"question -> answer\", n=2)\n281\t    dspy.settings.configure(lm=DummyLM([{\"answer\": \"my first answer\"}, {\"answer\": \"my second answer\"}]))\n282\t    results = program(question=\"What is 1+1?\")\n283\t    assert results.completions.answer[0] == \"my first answer\"\n284\t    assert results.completions.answer[1] == \"my second answer\"\n285\t\n286\t\n287\tdef test_multi_output2():\n288\t    program = Predict(\"question -> answer1, answer2\", n=2)\n289\t    dspy.settings.configure(\n290\t        lm=DummyLM(\n291\t            [\n292\t                {\"answer1\": \"my 0 answer\", \"answer2\": \"my 2 answer\"},\n293\t                {\"answer1\": \"my 1 answer\", \"answer2\": \"my 3 answer\"},\n294\t            ],\n295\t        )\n296\t    )\n297\t    results = program(question=\"What is 1+1?\")\n298\t    assert results.completions.answer1[0] == \"my 0 answer\"\n299\t    assert results.completions.answer1[1] == \"my 1 answer\"\n300\t    assert results.completions.answer2[0] == \"my 2 answer\"\n301\t    assert results.completions.answer2[1] == \"my 3 answer\"\n302\t\n303\t\n304\tdef test_datetime_inputs_and_outputs():\n305\t    # Define a model for datetime inputs and outputs\n306\t    class TimedEvent(pydantic.BaseModel):\n307\t        event_name: str\n308\t        event_time: datetime\n309\t\n310\t    class TimedSignature(dspy.Signature):\n311\t        events: list[TimedEvent] = dspy.InputField()\n312\t        summary: str = dspy.OutputField()\n313\t        next_event_time: datetime = dspy.OutputField()\n314\t\n315\t    program = Predict(TimedSignature)\n316\t\n317\t    lm = DummyLM(\n318\t        [\n319\t            {\n320\t                \"reasoning\": \"Processed datetime inputs\",\n321\t                \"summary\": \"All events are processed\",\n322\t                \"next_event_time\": \"2024-11-27T14:00:00\",\n323\t            }\n324\t        ]\n325\t    )\n326\t    dspy.settings.configure(lm=lm)\n327\t\n328\t    output = program(\n329\t        events=[\n330\t            TimedEvent(event_name=\"Event 1\", event_time=datetime(2024, 11, 25, 10, 0, 0)),\n331\t            TimedEvent(event_name=\"Event 2\", event_time=datetime(2024, 11, 25, 15, 30, 0)),\n332\t        ]\n333\t    )\n334\t    assert output.summary == \"All events are processed\"\n335\t    assert output.next_event_time == datetime(2024, 11, 27, 14, 0, 0)\n336\t\n337\t\n338\tdef test_explicitly_valued_enum_inputs_and_outputs():\n339\t    class Status(enum.Enum):\n340\t        PENDING = \"pending\"\n341\t        IN_PROGRESS = \"in_progress\"\n342\t        COMPLETED = \"completed\"\n343\t\n344\t    class StatusSignature(dspy.Signature):\n345\t        current_status: Status = dspy.InputField()\n346\t        next_status: Status = dspy.OutputField()\n347\t\n348\t    program = Predict(StatusSignature)\n349\t\n350\t    lm = DummyLM(\n351\t        [\n352\t            {\n353\t                \"reasoning\": \"The current status is 'PENDING', advancing to 'IN_PROGRESS'.\",\n354\t                \"next_status\": \"in_progress\",\n355\t            }\n356\t        ]\n357\t    )\n358\t    dspy.settings.configure(lm=lm)\n359\t\n360\t    output = program(current_status=Status.PENDING)\n361\t    assert output.next_status == Status.IN_PROGRESS\n362\t\n363\t\n364\tdef test_enum_inputs_and_outputs_with_shared_names_and_values():\n365\t    class TicketStatus(enum.Enum):\n366\t        OPEN = \"CLOSED\"\n367\t        CLOSED = \"RESOLVED\"\n368\t        RESOLVED = \"OPEN\"\n369\t\n370\t    class TicketStatusSignature(dspy.Signature):\n371\t        current_status: TicketStatus = dspy.InputField()\n372\t        next_status: TicketStatus = dspy.OutputField()\n373\t\n374\t    program = Predict(TicketStatusSignature)\n375\t\n376\t    # Mock reasoning and output\n377\t    lm = DummyLM(\n378\t        [\n379\t            {\n380\t                \"reasoning\": \"The ticket is currently 'OPEN', transitioning to 'CLOSED'.\",\n381\t                \"next_status\": \"RESOLVED\",  # Refers to TicketStatus.CLOSED by value\n382\t            }\n383\t        ]\n384\t    )\n385\t    dspy.settings.configure(lm=lm)\n386\t\n387\t    output = program(current_status=TicketStatus.OPEN)\n388\t    assert output.next_status == TicketStatus.CLOSED  # By value\n389\t\n390\t\n391\tdef test_auto_valued_enum_inputs_and_outputs():\n392\t    Status = enum.Enum(\"Status\", [\"PENDING\", \"IN_PROGRESS\", \"COMPLETED\"])  # noqa: N806\n393\t\n394\t    class StatusSignature(dspy.Signature):\n395\t        current_status: Status = dspy.InputField()\n396\t        next_status: Status = dspy.OutputField()\n397\t\n398\t    program = Predict(StatusSignature)\n399\t\n400\t    lm = DummyLM(\n401\t        [\n402\t            {\n403\t                \"reasoning\": \"The current status is 'PENDING', advancing to 'IN_PROGRESS'.\",\n404\t                \"next_status\": \"IN_PROGRESS\",  # Use the auto-assigned value for IN_PROGRESS\n405\t            }\n406\t        ]\n407\t    )\n408\t    dspy.settings.configure(lm=lm)\n409\t\n410\t    output = program(current_status=Status.PENDING)\n411\t    assert output.next_status == Status.IN_PROGRESS\n412\t\n413\t\n414\tdef test_named_predictors():\n415\t    class MyModule(dspy.Module):\n416\t        def __init__(self):\n417\t            super().__init__()\n418\t            self.inner = Predict(\"question -> answer\")\n419\t\n420\t    program = MyModule()\n421\t    assert program.named_predictors() == [(\"inner\", program.inner)]\n422\t\n423\t    # Check that it also works the second time.\n424\t    program2 = copy.deepcopy(program)\n425\t    assert program2.named_predictors() == [(\"inner\", program2.inner)]\n426\t\n427\t\n428\tdef test_output_only():\n429\t    class OutputOnlySignature(dspy.Signature):\n430\t        output = dspy.OutputField()\n431\t\n432\t    predictor = Predict(OutputOnlySignature)\n433\t\n434\t    lm = DummyLM([{\"output\": \"short answer\"}])\n435\t    dspy.settings.configure(lm=lm)\n436\t    assert predictor().output == \"short answer\"\n437\t\n438\t\n439\tdef test_load_state_chaining():\n440\t    \"\"\"Test that load_state returns self for chaining.\"\"\"\n441\t    original = Predict(\"question -> answer\")\n442\t    original.demos = [{\"question\": \"test\", \"answer\": \"response\"}]\n443\t    state = original.dump_state()\n444\t\n445\t    new_instance = Predict(\"question -> answer\").load_state(state)\n446\t    assert new_instance is not None\n447\t    assert new_instance.demos == original.demos\n448\t\n449\t\n450\t@pytest.mark.parametrize(\"adapter_type\", [\"chat\", \"json\"])\n451\tdef test_call_predict_with_chat_history(adapter_type):\n452\t    class SpyLM(dspy.LM):\n453\t        def __init__(self, *args, return_json=False, **kwargs):\n454\t            super().__init__(*args, **kwargs)\n455\t            self.calls = []\n456\t            self.return_json = return_json\n457\t\n458\t        def __call__(self, prompt=None, messages=None, **kwargs):\n459\t            self.calls.append({\"prompt\": prompt, \"messages\": messages, \"kwargs\": kwargs})\n460\t            if self.return_json:\n461\t                return [\"{'answer':'100%'}\"]\n462\t            return [\"[[ ## answer ## ]]\\n100%!\"]\n463\t\n464\t    class MySignature(dspy.Signature):\n465\t        question: str = dspy.InputField()\n466\t        history: dspy.History = dspy.InputField()\n467\t        answer: str = dspy.OutputField()\n468\t\n469\t    program = Predict(MySignature)\n470\t\n471\t    if adapter_type == \"chat\":\n472\t        lm = SpyLM(\"dummy_model\")\n473\t        dspy.settings.configure(adapter=dspy.ChatAdapter(), lm=lm)\n474\t    else:\n475\t        lm = SpyLM(\"dummy_model\", return_json=True)\n476\t        dspy.settings.configure(adapter=dspy.JSONAdapter(), lm=lm)\n477\t\n478\t    program(\n479\t        question=\"are you sure that's correct?\",\n480\t        history=dspy.History(messages=[{\"question\": \"what's the capital of france?\", \"answer\": \"paris\"}]),\n481\t    )\n482\t\n483\t    # Verify the LM was called with correct messages\n484\t    assert len(lm.calls) == 1\n485\t    messages = lm.calls[0][\"messages\"]\n486\t\n487\t    assert len(messages) == 4\n488\t\n489\t    assert \"what's the capital of france?\" in messages[1][\"content\"]\n490\t    assert \"paris\" in messages[2][\"content\"]\n491\t    assert \"are you sure that's correct\" in messages[3][\"content\"]\n492\t\n493\t\n494\tdef test_lm_usage():\n495\t    program = Predict(\"question -> answer\")\n496\t    dspy.settings.configure(lm=dspy.LM(\"openai/gpt-4o-mini\", cache=False), track_usage=True)\n497\t    with patch(\n498\t        \"dspy.clients.lm.litellm_completion\",\n499\t        return_value=ModelResponse(\n500\t            choices=[{\"message\": {\"content\": \"[[ ## answer ## ]]\\nParis\"}}],\n501\t            usage={\"total_tokens\": 10},\n502\t        ),\n503\t    ):\n504\t        result = program(question=\"What is the capital of France?\")\n505\t        assert result.answer == \"Paris\"\n506\t        assert result.get_lm_usage()[\"openai/gpt-4o-mini\"][\"total_tokens\"] == 10\n507\t\n508\t\n509\tdef test_positional_arguments():\n510\t    program = Predict(\"question -> answer\")\n511\t    with pytest.raises(ValueError) as e:\n512\t        program(\"What is the capital of France?\")\n513\t    assert str(e.value) == (\n514\t        \"Positional arguments are not allowed when calling `dspy.Predict`, must use keyword arguments that match \"\n515\t        \"your signature input fields: 'question'. For example: `predict(question=input_value, ...)`.\"\n516\t    )\n517\t\n518\t\n519\t@pytest.mark.parametrize(\"adapter_type\", [\"chat\", \"json\"])\n520\tdef test_field_constraints(adapter_type):\n521\t    class SpyLM(dspy.LM):\n522\t        def __init__(self, *args, return_json=False, **kwargs):\n523\t            super().__init__(*args, **kwargs)\n524\t            self.calls = []\n525\t            self.return_json = return_json\n526\t\n527\t        def __call__(self, prompt=None, messages=None, **kwargs):\n528\t            self.calls.append({\"prompt\": prompt, \"messages\": messages, \"kwargs\": kwargs})\n529\t            if self.return_json:\n530\t                return [\"{'score':'0.5', 'count':'2'}\"]\n531\t            return [\"[[ ## score ## ]]\\n0.5\\n[[ ## count ## ]]\\n2\"]\n532\t\n533\t    class ConstrainedSignature(dspy.Signature):\n534\t        \"\"\"Test signature with constrained fields.\"\"\"\n535\t\n536\t        # Input with length and value constraints\n537\t        text: str = dspy.InputField(min_length=5, max_length=100, desc=\"Input text\")\n538\t        number: int = dspy.InputField(gt=0, lt=10, desc=\"A number between 0 and 10\")\n539\t\n540\t        # Output with multiple constraints\n541\t        score: float = dspy.OutputField(ge=0.0, le=1.0, desc=\"Score between 0 and 1\")\n542\t        count: int = dspy.OutputField(multiple_of=2, desc=\"Even number count\")\n543\t\n544\t    program = Predict(ConstrainedSignature)\n545\t    lm = SpyLM(\"dummy_model\")\n546\t    if adapter_type == \"chat\":\n547\t        lm = SpyLM(\"dummy_model\")\n548\t        dspy.settings.configure(adapter=dspy.ChatAdapter(), lm=lm)\n549\t    else:\n550\t        lm = SpyLM(\"dummy_model\", return_json=True)\n551\t        dspy.settings.configure(adapter=dspy.JSONAdapter(), lm=lm)\n552\t\n553\t    # Call the predictor to trigger instruction generation\n554\t    program(text=\"hello world\", number=5)\n555\t\n556\t    # Get the system message containing the instructions\n557\t    system_message = lm.calls[0][\"messages\"][0][\"content\"]\n558\t\n559\t    # Verify constraints are included in the field descriptions\n560\t    assert \"minimum length: 5\" in system_message\n561\t    assert \"maximum length: 100\" in system_message\n562\t    assert \"greater than: 0\" in system_message\n563\t    assert \"less than: 10\" in system_message\n564\t    assert \"greater than or equal to: 0.0\" in system_message\n565\t    assert \"less than or equal to: 1.0\" in system_message\n566\t    assert \"a multiple of the given number: 2\" in system_message\n567\t\n568\t\n569\t@pytest.mark.asyncio\n570\tasync def test_async_predict():\n571\t    program = Predict(\"question -> answer\")\n572\t    dspy.settings.configure(lm=DummyLM([{\"answer\": \"Paris\"}]))\n573\t    result = await program.acall(question=\"What is the capital of France?\")\n574\t    assert result.answer == \"Paris\"\n575\t"}]},"parent_tool_use_id":null,"session_id":"daf4bd95-90eb-4bd5-a8b2-615c44312155","uuid":"54e06ac9-f5d8-44f4-9ae6-113057bcbd8f","timestamp":"2026-09-03T17:45:51.323Z","tool_use_result":{"type":"text","file":{"filePath":"/testbed/tests/predict/test_predict.py","content":"import copy\nimport enum\nfrom datetime import datetime\nfrom unittest.mock import patch\n\nimport pydantic\nimport pytest\nimport ujson\nfrom litellm import ModelResponse\n\nimport dspy\nfrom dspy import Predict, Signature\nfrom dspy.utils.dummies import DummyLM\n\n\ndef test_initialization_with_string_signature():\n    signature_string = \"input1, input2 -> output\"\n    predict = Predict(signature_string)\n    expected_instruction = \"Given the fields `input1`, `input2`, produce the fields `output`.\"\n    assert predict.signature.instructions == expected_instruction\n    assert predict.signature.instructions == Signature(signature_string).instructions\n\n\ndef test_reset_method():\n    predict_instance = Predict(\"input -> output\")\n    predict_instance.lm = \"modified\"\n    predict_instance.traces = [\"trace\"]\n    predict_instance.train = [\"train\"]\n    predict_instance.demos = [\"demo\"]\n    predict_instance.reset()\n    assert predict_instance.lm is None\n    assert predict_instance.traces == []\n    assert predict_instance.train == []\n    assert predict_instance.demos == []\n\n\ndef test_lm_after_dump_and_load_state():\n    predict_instance = Predict(\"input -> output\")\n    lm = dspy.LM(\n        model=\"openai/gpt-4o-mini\",\n        model_type=\"chat\",\n        temperature=1,\n        max_tokens=100,\n        num_retries=10,\n    )\n    predict_instance.lm = lm\n    expected_lm_state = {\n        \"model\": \"openai/gpt-4o-mini\",\n        \"model_type\": \"chat\",\n        \"temperature\": 1,\n        \"max_tokens\": 100,\n        \"num_retries\": 10,\n        \"cache\": True,\n        \"cache_in_memory\": True,\n        \"finetuning_model\": None,\n        \"launch_kwargs\": {},\n        \"train_kwargs\": {},\n    }\n    assert lm.dump_state() == expected_lm_state\n    dumped_state = predict_instance.dump_state()\n    new_instance = Predict(\"input -> output\")\n    new_instance.load_state(dumped_state)\n    assert new_instance.lm.dump_state() == expected_lm_state\n\n\ndef test_call_method():\n    predict_instance = Predict(\"input -> output\")\n    lm = DummyLM([{\"output\": \"test output\"}])\n    dspy.settings.configure(lm=lm)\n    result = predict_instance(input=\"test input\")\n    assert result.output == \"test output\"\n\n\ndef test_instructions_after_dump_and_load_state():\n    predict_instance = Predict(Signature(\"input -> output\", \"original instructions\"))\n    dumped_state = predict_instance.dump_state()\n    new_instance = Predict(Signature(\"input -> output\", \"new instructions\"))\n    new_instance.load_state(dumped_state)\n    assert new_instance.signature.instructions == \"original instructions\"\n\n\ndef test_demos_after_dump_and_load_state():\n    class TranslateToEnglish(dspy.Signature):\n        \"\"\"Translate content from a language to English.\"\"\"\n\n        content: str = dspy.InputField()\n        language: str = dspy.InputField()\n        translation: str = dspy.OutputField()\n\n    original_instance = Predict(TranslateToEnglish)\n    original_instance.demos = [\n        dspy.Example(\n            content=\"¿Qué tal?\",\n            language=\"SPANISH\",\n            translation=\"Hello there\",\n        ).with_inputs(\"content\", \"language\"),\n    ]\n\n    dumped_state = original_instance.dump_state()\n    assert len(dumped_state[\"demos\"]) == len(original_instance.demos)\n    assert dumped_state[\"demos\"][0][\"content\"] == original_instance.demos[0].content\n\n    saved_state = ujson.dumps(dumped_state)\n    loaded_state = ujson.loads(saved_state)\n\n    new_instance = Predict(TranslateToEnglish)\n    new_instance.load_state(loaded_state)\n    assert len(new_instance.demos) == len(original_instance.demos)\n    # Demos don't need to keep the same types after saving and loading the state.\n    assert new_instance.demos[0][\"content\"] == original_instance.demos[0].content\n\n\ndef test_typed_demos_after_dump_and_load_state():\n    class Item(pydantic.BaseModel):\n        name: str\n        quantity: int\n\n    class InventorySignature(dspy.Signature):\n        \"\"\"Handle inventory items and their translations.\"\"\"\n\n        items: list[Item] = dspy.InputField()\n        language: str = dspy.InputField()\n        translated_items: list[Item] = dspy.OutputField()\n        total_quantity: int = dspy.OutputField()\n\n    original_instance = Predict(InventorySignature)\n    original_instance.demos = [\n        dspy.Example(\n            items=[Item(name=\"apple\", quantity=5), Item(name=\"banana\", quantity=3)],\n            language=\"SPANISH\",\n            translated_items=[Item(name=\"manzana\", quantity=5), Item(name=\"plátano\", quantity=3)],\n            total_quantity=8,\n        ).with_inputs(\"items\", \"language\"),\n    ]\n\n    # Test dump_state\n    dumped_state = original_instance.dump_state()\n    assert len(dumped_state[\"demos\"]) == len(original_instance.demos)\n    # Verify the input items were properly serialized\n    assert isinstance(dumped_state[\"demos\"][0][\"items\"], list)\n    assert len(dumped_state[\"demos\"][0][\"items\"]) == 2\n    assert dumped_state[\"demos\"][0][\"items\"][0] == {\"name\": \"apple\", \"quantity\": 5}\n\n    # Test serialization/deserialization\n    saved_state = ujson.dumps(dumped_state)\n    loaded_state = ujson.loads(saved_state)\n\n    # Test load_state\n    new_instance = Predict(InventorySignature)\n    new_instance.load_state(loaded_state)\n    assert len(new_instance.demos) == len(original_instance.demos)\n\n    # Verify the structure is maintained after loading\n    loaded_demo = new_instance.demos[0]\n    assert isinstance(loaded_demo[\"items\"], list)\n    assert len(loaded_demo[\"items\"]) == 2\n    assert loaded_demo[\"items\"][0][\"name\"] == \"apple\"\n    assert loaded_demo[\"items\"][0][\"quantity\"] == 5\n    assert loaded_demo[\"items\"][1][\"name\"] == \"banana\"\n    assert loaded_demo[\"items\"][1][\"quantity\"] == 3\n\n    # Verify output items were also properly maintained\n    assert isinstance(loaded_demo[\"translated_items\"], list)\n    assert len(loaded_demo[\"translated_items\"]) == 2\n    assert loaded_demo[\"translated_items\"][0][\"name\"] == \"manzana\"\n    assert loaded_demo[\"translated_items\"][1][\"name\"] == \"plátano\"\n\n\n# def test_typed_demos_after_dump_and_load_state():\n#     class TypedTranslateToEnglish(dspy.Signature):\n#         \"\"\"Translate content from a language to English.\"\"\"\n\n#         class Input(pydantic.BaseModel):\n#             content: str\n#             language: str\n\n#         class Output(pydantic.BaseModel):\n#             translation: str\n\n#         input: Input = dspy.InputField()\n#         output: Output = dspy.OutputField()\n\n#     original_instance = TypedPredictor(TypedTranslateToEnglish).predictor\n#     original_instance.demos = [\n#         dspy.Example(\n#             input=TypedTranslateToEnglish.Input(\n#                 content=\"¿Qué tal?\",\n#                 language=\"SPANISH\",\n#             ),\n#             output=TypedTranslateToEnglish.Output(\n#                 translation=\"Hello there\",\n#             ),\n#         ).with_inputs(\"input\"),\n#     ]\n\n#     dumped_state = original_instance.dump_state()\n#     assert len(dumped_state[\"demos\"]) == len(original_instance.demos)\n#     assert dumped_state[\"demos\"][0][\"input\"] == original_instance.demos[0].input.model_dump_json()\n\n#     saved_state = ujson.dumps(dumped_state)\n#     loaded_state = ujson.loads(saved_state)\n\n#     new_instance = TypedPredictor(TypedTranslateToEnglish).predictor\n#     new_instance.load_state(loaded_state)\n#     assert len(new_instance.demos) == len(original_instance.demos)\n#     # Demos don't need to keep the same types after saving and loading the state.\n#     assert new_instance.demos[0][\"input\"] == original_instance.demos[0].input.model_dump_json()\n\n\ndef test_signature_fields_after_dump_and_load_state(tmp_path):\n    class CustomSignature(dspy.Signature):\n        \"\"\"I am just an instruction.\"\"\"\n\n        sentence = dspy.InputField(desc=\"I am an innocent input!\")\n        sentiment = dspy.OutputField()\n\n    file_path = tmp_path / \"tmp.json\"\n    original_instance = Predict(CustomSignature)\n    original_instance.save(file_path)\n\n    class CustomSignature2(dspy.Signature):\n        \"\"\"I am not a pure instruction.\"\"\"\n\n        sentence = dspy.InputField(desc=\"I am a malicious input!\")\n        sentiment = dspy.OutputField(desc=\"I am a malicious output!\", prefix=\"I am a prefix!\")\n\n    new_instance = Predict(CustomSignature2)\n    assert new_instance.signature.dump_state() != original_instance.signature.dump_state()\n    # After loading, the fields should be the same.\n    new_instance.load(file_path)\n    assert new_instance.signature.dump_state() == original_instance.signature.dump_state()\n\n\n@pytest.mark.parametrize(\"filename\", [\"model.json\", \"model.pkl\"])\ndef test_lm_field_after_dump_and_load_state(tmp_path, filename):\n    file_path = tmp_path / filename\n    lm = dspy.LM(\n        model=\"openai/gpt-4o-mini\",\n        model_type=\"chat\",\n        temperature=1,\n        max_tokens=100,\n        num_retries=10,\n    )\n    original_predict = dspy.Predict(\"q->a\")\n    original_predict.lm = lm\n\n    original_predict.save(file_path)\n\n    assert file_path.exists()\n\n    loaded_predict = dspy.Predict(\"q->a\")\n    loaded_predict.load(file_path)\n\n    assert original_predict.dump_state() == loaded_predict.dump_state()\n\n\ndef test_forward_method():\n    program = Predict(\"question -> answer\")\n    dspy.settings.configure(lm=DummyLM([{\"answer\": \"No more responses\"}]))\n    result = program(question=\"What is 1+1?\").answer\n    assert result == \"No more responses\"\n\n\ndef test_forward_method2():\n    program = Predict(\"question -> answer1, answer2\")\n    dspy.settings.configure(lm=DummyLM([{\"answer1\": \"my first answer\", \"answer2\": \"my second answer\"}]))\n    result = program(question=\"What is 1+1?\")\n    assert result.answer1 == \"my first answer\"\n    assert result.answer2 == \"my second answer\"\n\n\ndef test_config_management():\n    predict_instance = Predict(\"input -> output\")\n    predict_instance.update_config(new_key=\"value\")\n    config = predict_instance.get_config()\n    assert \"new_key\" in config and config[\"new_key\"] == \"value\"\n\n\ndef test_multi_output():\n    program = Predict(\"question -> answer\", n=2)\n    dspy.settings.configure(lm=DummyLM([{\"answer\": \"my first answer\"}, {\"answer\": \"my second answer\"}]))\n    results = program(question=\"What is 1+1?\")\n    assert results.completions.answer[0] == \"my first answer\"\n    assert results.completions.answer[1] == \"my second answer\"\n\n\ndef test_multi_output2():\n    program = Predict(\"question -> answer1, answer2\", n=2)\n    dspy.settings.configure(\n        lm=DummyLM(\n            [\n                {\"answer1\": \"my 0 answer\", \"answer2\": \"my 2 answer\"},\n                {\"answer1\": \"my 1 answer\", \"answer2\": \"my 3 answer\"},\n            ],\n        )\n    )\n    results = program(question=\"What is 1+1?\")\n    assert results.completions.answer1[0] == \"my 0 answer\"\n    assert results.completions.answer1[1] == \"my 1 answer\"\n    assert results.completions.answer2[0] == \"my 2 answer\"\n    assert results.completions.answer2[1] == \"my 3 answer\"\n\n\ndef test_datetime_inputs_and_outputs():\n    # Define a model for datetime inputs and outputs\n    class TimedEvent(pydantic.BaseModel):\n        event_name: str\n        event_time: datetime\n\n    class TimedSignature(dspy.Signature):\n        events: list[TimedEvent] = dspy.InputField()\n        summary: str = dspy.OutputField()\n        next_event_time: datetime = dspy.OutputField()\n\n    program = Predict(TimedSignature)\n\n    lm = DummyLM(\n        [\n            {\n                \"reasoning\": \"Processed datetime inputs\",\n                \"summary\": \"All events are processed\",\n                \"next_event_time\": \"2024-11-27T14:00:00\",\n            }\n        ]\n    )\n    dspy.settings.configure(lm=lm)\n\n    output = program(\n        events=[\n            TimedEvent(event_name=\"Event 1\", event_time=datetime(2024, 11, 25, 10, 0, 0)),\n            TimedEvent(event_name=\"Event 2\", event_time=datetime(2024, 11, 25, 15, 30, 0)),\n        ]\n    )\n    assert output.summary == \"All events are processed\"\n    assert output.next_event_time == datetime(2024, 11, 27, 14, 0, 0)\n\n\ndef test_explicitly_valued_enum_inputs_and_outputs():\n    class Status(enum.Enum):\n        PENDING = \"pending\"\n        IN_PROGRESS = \"in_progress\"\n        COMPLETED = \"completed\"\n\n    class StatusSignature(dspy.Signature):\n        current_status: Status = dspy.InputField()\n        next_status: Status = dspy.OutputField()\n\n    program = Predict(StatusSignature)\n\n    lm = DummyLM(\n        [\n            {\n                \"reasoning\": \"The current status is 'PENDING', advancing to 'IN_PROGRESS'.\",\n                \"next_status\": \"in_progress\",\n            }\n        ]\n    )\n    dspy.settings.configure(lm=lm)\n\n    output = program(current_status=Status.PENDING)\n    assert output.next_status == Status.IN_PROGRESS\n\n\ndef test_enum_inputs_and_outputs_with_shared_names_and_values():\n    class TicketStatus(enum.Enum):\n        OPEN = \"CLOSED\"\n        CLOSED = \"RESOLVED\"\n        RESOLVED = \"OPEN\"\n\n    class TicketStatusSignature(dspy.Signature):\n        current_status: TicketStatus = dspy.InputField()\n        next_status: TicketStatus = dspy.OutputField()\n\n    program = Predict(TicketStatusSignature)\n\n    # Mock reasoning and output\n    lm = DummyLM(\n        [\n            {\n                \"reasoning\": \"The ticket is currently 'OPEN', transitioning to 'CLOSED'.\",\n                \"next_status\": \"RESOLVED\",  # Refers to TicketStatus.CLOSED by value\n            }\n        ]\n    )\n    dspy.settings.configure(lm=lm)\n\n    output = program(current_status=TicketStatus.OPEN)\n    assert output.next_status == TicketStatus.CLOSED  # By value\n\n\ndef test_auto_valued_enum_inputs_and_outputs():\n    Status = enum.Enum(\"Status\", [\"PENDING\", \"IN_PROGRESS\", \"COMPLETED\"])  # noqa: N806\n\n    class StatusSignature(dspy.Signature):\n        current_status: Status = dspy.InputField()\n        next_status: Status = dspy.OutputField()\n\n    program = Predict(StatusSignature)\n\n    lm = DummyLM(\n        [\n            {\n                \"reasoning\": \"The current status is 'PENDING', advancing to 'IN_PROGRESS'.\",\n                \"next_status\": \"IN_PROGRESS\",  # Use the auto-assigned value for IN_PROGRESS\n            }\n        ]\n    )\n    dspy.settings.configure(lm=lm)\n\n    output = program(current_status=Status.PENDING)\n    assert output.next_status == Status.IN_PROGRESS\n\n\ndef test_named_predictors():\n    class MyModule(dspy.Module):\n        def __init__(self):\n            super().__init__()\n            self.inner = Predict(\"question -> answer\")\n\n    program = MyModule()\n    assert program.named_predictors() == [(\"inner\", program.inner)]\n\n    # Check that it also works the second time.\n    program2 = copy.deepcopy(program)\n    assert program2.named_predictors() == [(\"inner\", program2.inner)]\n\n\ndef test_output_only():\n    class OutputOnlySignature(dspy.Signature):\n        output = dspy.OutputField()\n\n    predictor = Predict(OutputOnlySignature)\n\n    lm = DummyLM([{\"output\": \"short answer\"}])\n    dspy.settings.configure(lm=lm)\n    assert predictor().output == \"short answer\"\n\n\ndef test_load_state_chaining():\n    \"\"\"Test that load_state returns self for chaining.\"\"\"\n    original = Predict(\"question -> answer\")\n    original.demos = [{\"question\": \"test\", \"answer\": \"response\"}]\n    state = original.dump_state()\n\n    new_instance = Predict(\"question -> answer\").load_state(state)\n    assert new_instance is not None\n    assert new_instance.demos == original.demos\n\n\n@pytest.mark.parametrize(\"adapter_type\", [\"chat\", \"json\"])\ndef test_call_predict_with_chat_history(adapter_type):\n    class SpyLM(dspy.LM):\n        def __init__(self, *args, return_json=False, **kwargs):\n            super().__init__(*args, **kwargs)\n            self.calls = []\n            self.return_json = return_json\n\n        def __call__(self, prompt=None, messages=None, **kwargs):\n            self.calls.append({\"prompt\": prompt, \"messages\": messages, \"kwargs\": kwargs})\n            if self.return_json:\n                return [\"{'answer':'100%'}\"]\n            return [\"[[ ## answer ## ]]\\n100%!\"]\n\n    class MySignature(dspy.Signature):\n        question: str = dspy.InputField()\n        history: dspy.History = dspy.InputField()\n        answer: str = dspy.OutputField()\n\n    program = Predict(MySignature)\n\n    if adapter_type == \"chat\":\n        lm = SpyLM(\"dummy_model\")\n        dspy.settings.configure(adapter=dspy.ChatAdapter(), lm=lm)\n    else:\n        lm = SpyLM(\"dummy_model\", return_json=True)\n        dspy.settings.configure(adapter=dspy.JSONAdapter(), lm=lm)\n\n    program(\n        question=\"are you sure that's correct?\",\n        history=dspy.History(messages=[{\"question\": \"what's the capital of france?\", \"answer\": \"paris\"}]),\n    )\n\n    # Verify the LM was called with correct messages\n    assert len(lm.calls) == 1\n    messages = lm.calls[0][\"messages\"]\n\n    assert len(messages) == 4\n\n    assert \"what's the capital of france?\" in messages[1][\"content\"]\n    assert \"paris\" in messages[2][\"content\"]\n    assert \"are you sure that's correct\" in messages[3][\"content\"]\n\n\ndef test_lm_usage():\n    program = Predict(\"question -> answer\")\n    dspy.settings.configure(lm=dspy.LM(\"openai/gpt-4o-mini\", cache=False), track_usage=True)\n    with patch(\n        \"dspy.clients.lm.litellm_completion\",\n        return_value=ModelResponse(\n            choices=[{\"message\": {\"content\": \"[[ ## answer ## ]]\\nParis\"}}],\n            usage={\"total_tokens\": 10},\n        ),\n    ):\n        result = program(question=\"What is the capital of France?\")\n        assert result.answer == \"Paris\"\n        assert result.get_lm_usage()[\"openai/gpt-4o-mini\"][\"total_tokens\"] == 10\n\n\ndef test_positional_arguments():\n    program = Predict(\"question -> answer\")\n    with pytest.raises(ValueError) as e:\n        program(\"What is the capital of France?\")\n    assert str(e.value) == (\n        \"Positional arguments are not allowed when calling `dspy.Predict`, must use keyword arguments that match \"\n        \"your signature input fields: 'question'. For example: `predict(question=input_value, ...)`.\"\n    )\n\n\n@pytest.mark.parametrize(\"adapter_type\", [\"chat\", \"json\"])\ndef test_field_constraints(adapter_type):\n    class SpyLM(dspy.LM):\n        def __init__(self, *args, return_json=False, **kwargs):\n            super().__init__(*args, **kwargs)\n            self.calls = []\n            self.return_json = return_json\n\n        def __call__(self, prompt=None, messages=None, **kwargs):\n            self.calls.append({\"prompt\": prompt, \"messages\": messages, \"kwargs\": kwargs})\n            if self.return_json:\n                return [\"{'score':'0.5', 'count':'2'}\"]\n            return [\"[[ ## score ## ]]\\n0.5\\n[[ ## count ## ]]\\n2\"]\n\n    class ConstrainedSignature(dspy.Signature):\n        \"\"\"Test signature with constrained fields.\"\"\"\n\n        # Input with length and value constraints\n        text: str = dspy.InputField(min_length=5, max_length=100, desc=\"Input text\")\n        number: int = dspy.InputField(gt=0, lt=10, desc=\"A number between 0 and 10\")\n\n        # Output with multiple constraints\n        score: float = dspy.OutputField(ge=0.0, le=1.0, desc=\"Score between 0 and 1\")\n        count: int = dspy.OutputField(multiple_of=2, desc=\"Even number count\")\n\n    program = Predict(ConstrainedSignature)\n    lm = SpyLM(\"dummy_model\")\n    if adapter_type == \"chat\":\n        lm = SpyLM(\"dummy_model\")\n        dspy.settings.configure(adapter=dspy.ChatAdapter(), lm=lm)\n    else:\n        lm = SpyLM(\"dummy_model\", return_json=True)\n        dspy.settings.configure(adapter=dspy.JSONAdapter(), lm=lm)\n\n    # Call the predictor to trigger instruction generation\n    program(text=\"hello world\", number=5)\n\n    # Get the system message containing the instructions\n    system_message = lm.calls[0][\"messages\"][0][\"content\"]\n\n    # Verify constraints are included in the field descriptions\n    assert \"minimum length: 5\" in system_message\n    assert \"maximum length: 100\" in system_message\n    assert \"greater than: 0\" in system_message\n    assert \"less than: 10\" in system_message\n    assert \"greater than or equal to: 0.0\" in system_message\n    assert \"less than or equal to: 1.0\" in system_message\n    assert \"a multiple of the given number: 2\" in system_message\n\n\n@pytest.mark.asyncio\nasync def test_async_predict():\n    program = Predict(\"question -> answer\")\n    dspy.settings.configure(lm=DummyLM([{\"answer\": \"Paris\"}]))\n    result = await program.acall(question=\"What is the capital of France?\")\n    assert result.answer == \"Paris\"\n","numLines":575,"startLine":1,"totalLines":575}}}
