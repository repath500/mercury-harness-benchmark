   state (dict): The saved state of a `Predict` object.\n55\t\n56\t        Returns:\n57\t            self: Returns self to allow method chaining\n58\t        \"\"\"\n59\t        excluded_keys = [\"signature\", \"extended_signature\", \"lm\"]\n60\t        for name, value in state.items():\n61\t            # `excluded_keys` are fields that go through special handling.\n62\t            if name not in excluded_keys:\n63\t                setattr(self, name, value)\n64\t\n65\t        self.signature = self.signature.load_state(state[\"signature\"])\n66\t        self.lm = LM(**state[\"lm\"]) if state[\"lm\"] else None\n67\t\n68\t        if \"extended_signature\" in state:  # legacy, up to and including 2.5, for CoT.\n69\t            raise NotImplementedError(\"Loading extended_signature is no longer supported in DSPy 2.6+\")\n70\t\n71\t        return self\n72\t\n73\t    def _get_positional_args_error_message(self):\n74\t        input_fields = list(self.signature.input_fields.keys())\n75\t        return (\n76\t            \"Positional arguments are not allowed when calling `dspy.Predict`, must use keyword arguments \"\n77\t            f\"that match your signature input fields: '{', '.join(input_fields)}'. For example: \"\n78\t            f\"`predict({input_fields[0]}=input_value, ...)`.\"\n79\t        )\n80\t\n81\t    def __call__(self, *args, **kwargs):\n82\t        if args:\n83\t            raise ValueError(self._get_positional_args_error_message())\n84\t\n85\t        return super().__call__(**kwargs)\n86\t\n87\t    async def acall(self, *args, **kwargs):\n88\t        if args:\n89\t            raise ValueError(self._get_positional_args_error_message())\n90\t\n91\t        return await super().acall(**kwargs)\n92\t\n93\t    def _forward_preprocess(self, **kwargs):\n94\t        # Extract the three privileged keyword arguments.\n95\t        assert \"new_signature\" not in kwargs, \"new_signature is no longer a valid keyword argument.\"\n96\t        signature = ensure_signature(kwargs.pop(\"signature\", self.signature))\n97\t        demos = kwargs.pop(\"demos\", self.demos)\n98\t        config = dict(**self.config, **kwargs.pop(\"config\", {}))\n99\t\n100\t        # Get the right LM to use.\n101\t        lm = kwargs.pop(\"lm\", self.lm) or settings.lm\n102\t        assert isinstance(lm, BaseLM), \"No LM is loaded.\"\n103\t\n104\t        # If temperature is unset or <=0.15, and n > 1, set temperature to 0.7 to keep randomness.\n105\t        temperature = config.get(\"temperature\") or lm.kwargs.get(\"temperature\")\n106\t        num_generations = config.get(\"n\") or lm.kwargs.get(\"n\") or lm.kwargs.get(\"num_generations\") or 1\n107\t\n108\t        if (temperature is None or temperature <= 0.15) and num_generations > 1:\n109\t            config[\"temperature\"] = 0.7\n110\t\n111\t        if not all(k in kwargs for k in signature.input_fields):\n112\t            present = [k for k in signature.input_fields if k in kwargs]\n113\t            missing = [k for k in signature.input_fields if k not in kwargs]\n114\t            logger.warning(\n115\t                \"Not all input fields were provided to module. Present: %s. Missing: %s.\",\n116\t                present,\n117\t                missing,\n118\t            )\n119\t        return lm, config, signature, demos, kwargs\n120\t\n121\t    def _forward_postprocess(self, completions, signature, **kwargs):\n122\t        pred = Prediction.from_completions(completions, signature=signature)\n123\t        if kwargs.pop(\"_trace\", True) and settings.trace is not None:\n124\t            trace = settings.trace\n125\t            trace.append((self, {**kwargs}, pred))\n126\t        return pred\n127\t\n128\t    def _should_stream(self):\n129\t        stream_listeners = settings.stream_listeners or []\n130\t        should_stream = settings.send_stream is not None\n131\t        if should_stream and len(stream_listeners) > 0:\n132\t            should_stream = any(stream_listener.predict == self for stream_listener in stream_listeners)\n133\t\n134\t        return should_stream\n135\t\n136\t    def forward(self, **kwargs):\n137\t        lm, config, signature, demos, kwargs = self._forward_preprocess(**kwargs)\n138\t\n139\t        adapter = settings.adapter or ChatAdapter()\n140\t\n141\t        if self._should_stream():\n142\t            with settings.context(caller_predict=self):\n143\t                completions = adapter(lm, lm_kwargs=config, signature=signature, demos=demos, inputs=kwargs)\n144\t        else:\n145\t            with settings.context(send_stream=None):\n146\t                completions = adapter(lm, lm_kwargs=config, signature=signature, demos=demos, inputs=kwargs)\n147\t\n148\t        return self._forward_postprocess(completions, signature, **kwargs)\n149\t\n150\t    async def aforward(self, **kwargs):\n151\t        lm, config, signature, demos, kwargs = self._forward_preprocess(**kwargs)\n152\t\n153\t        adapter = settings.adapter or ChatAdapter()\n154\t        if self._should_stream():\n155\t            with settings.context(caller_predict=self):\n156\t                completions = await adapter.acall(lm, lm_kwargs=config, signature=signature, demos=demos, inputs=kwargs)\n157\t        else:\n158\t            with settings.context(send_stream=None):\n159\t                completions = await adapter.acall(lm, lm_kwargs=config, signature=signature, demos=demos, inputs=kwargs)\n160\t\n161\t        return self._forward_postprocess(completions, signature, **kwargs)\n162\t\n163\t    def update_config(self, **kwargs):\n164\t        self.config = {**self.config, **kwargs}\n165\t\n166\t    def get_config(self):\n167\t        return self.config\n168\t\n169\t    def __repr__(self):\n170\t        return f\"{self.__class__.__name__}({self.signature})\"\n171\t\n172\t\n173\tdef serialize_object(obj):\n174\t    \"\"\"\n175\t    Recursively serialize a given object into a JSON-compatible format.\n176\t    Supports Pydantic models, lists, dicts, and primitive types.\n177\t    \"\"\"\n178\t    if isinstance(obj, BaseModel):\n179\t        # Use model_dump to convert the model into a JSON-serializable dict\n180\t        return obj.model_dump()\n181\t    elif isinstance(obj, list):\n182\t        return [serialize_object(item) for item in obj]\n183\t    elif isinstance(obj, tuple):\n184\t        return tuple(serialize_object(item) for item in obj)\n185\t    elif isinstance(obj, dict):\n186\t        return {key: serialize_object(value) for key, value in obj.items()}\n187\t    else:\n188\t        return obj\n189\t\n190\t\n191\t# # TODO: FIXME: Hmm, I guess expected behavior is that contexts can\n192\t# affect execution. Well, we need to determine whether context dominates, __init__ demoninates, or forward dominates.\n193\t# Generally, unless overwritten, we'd see n=None, temperature=None.\n194\t# That will eventually mean we have to learn them.\n195\t"}]},"parent_tool_use_id":null,"session_id":"daf4bd95-90eb-4bd5-a8b2-615c44312155","uuid":"d65469de-6086-4a12-aae3-6ccc6d610908","timestamp":"2026-09-03T17:41:11.453Z","tool_use_result":{"type":"text","file":{"filePath":"/testbed/dspy/predict/predict.py","content":"import logging\nimport random\n\nfrom pydantic import BaseModel\n\nfrom dspy.adapters.chat_adapter import ChatAdapter\nfrom dspy.clients.base_lm import BaseLM\nfrom dspy.clients.lm import LM\nfrom dspy.dsp.utils.settings import settings\nfrom dspy.predict.parameter import Parameter\nfrom dspy.primitives.prediction import Prediction\nfrom dspy.primitives.program import Module\nfrom dspy.signatures.signature import ensure_signature\n\nlogger = logging.getLogger(__name__)\n\n\nclass Predict(Module, Parameter):\n    def __init__(self, signature, callbacks=None, **config):\n        self.stage = random.randbytes(8).hex()\n        self.signature = ensure_signature(signature)\n        self.config = config\n        self.callbacks = callbacks or []\n        self.reset()\n\n    def reset(self):\n        self.lm = None\n        self.traces = []\n        self.train = []\n        self.demos = []\n\n    def dump_state(self):\n        state_keys = [\"traces\", \"train\"]\n        state = {k: getattr(self, k) for k in state_keys}\n\n        state[\"demos\"] = []\n        for demo in self.demos:\n            demo = demo.copy()\n\n            for field in demo:\n                # FIXME: Saving BaseModels as strings in examples doesn't matter because you never re-access as an object\n                demo[field] = serialize_object(demo[field])\n\n            state[\"demos\"].append(demo)\n\n        state[\"signature\"] = self.signature.dump_state()\n        state[\"lm\"] = self.lm.dump_state() if self.lm else None\n        return state\n\n    def load_state(self, state):\n        \"\"\"Load the saved state of a `Predict` object.\n\n        Args:\n            state (dict): The saved state of a `Predict` object.\n\n        Returns:\n            self: Returns self to allow method chaining\n        \"\"\"\n        excluded_keys = [\"signature\", \"extended_signature\", \"lm\"]\n        for name, value in state.items():\n            # `excluded_keys` are fields that go through special handling.\n            if name not in excluded_keys:\n                setattr(self, name, value)\n\n        self.signature = self.signature.load_state(state[\"signature\"])\n        self.lm = LM(**state[\"lm\"]) if state[\"lm\"] else None\n\n        if \"extended_signature\" in state:  # legacy, up to and including 2.5, for CoT.\n            raise NotImplementedError(\"Loading extended_signature is no longer supported in DSPy 2.6+\")\n\n        return self\n\n    def _get_positional_args_error_message(self):\n        input_fields = list(self.signature.input_fields.keys())\n        return (\n            \"Positional arguments are not allowed when calling `dspy.Predict`, must use keyword arguments \"\n            f\"that match your signature input fields: '{', '.join(input_fields)}'. For example: \"\n            f\"`predict({input_fields[0]}=input_value, ...)`.\"\n        )\n\n    def __call__(self, *args, **kwargs):\n        if args:\n            raise ValueError(self._get_positional_args_error_message())\n\n        return super().__call__(**kwargs)\n\n    async def acall(self, *args, **kwargs):\n        if args:\n            raise ValueError(self._get_positional_args_error_message())\n\n        return await super().acall(**kwargs)\n\n    def _forward_preprocess(self, **kwargs):\n        # Extract the three privileged keyword arguments.\n        assert \"new_signature\" not in kwargs, \"new_signature is no longer a valid keyword argument.\"\n        signature = ensure_signature(kwargs.pop(\"signature\", self.signature))\n        demos = kwargs.pop(\"demos\", self.demos)\n        config = dict(**self.config, **kwargs.pop(\"config\", {}))\n\n        # Get the right LM to use.\n        lm = kwargs.pop(\"lm\", self.lm) or settings.lm\n        assert isinstance(lm, BaseLM), \"No LM is loaded.\"\n\n        # If temperature is unset or <=0.15, and n > 1, set temperature to 0.7 to keep randomness.\n        temperature = config.get(\"temperature\") or lm.kwargs.get(\"temperature\")\n        num_generations = config.get(\"n\") or lm.kwargs.get(\"n\") or lm.kwargs.get(\"num_generations\") or 1\n\n        if (temperature is None or temperature <= 0.15) and num_generations > 1:\n            config[\"temperature\"] = 0.7\n\n        if not all(k in kwargs for k in signature.input_fields):\n            present = [k for k in signature.input_fields if k in kwargs]\n            missing = [k for k in signature.input_fields if k not in kwargs]\n            logger.warning(\n                \"Not all input fields were provided to module. Present: %s. Missing: %s.\",\n                present,\n                missing,\n            )\n        return lm, config, signature, demos, kwargs\n\n    def _forward_postprocess(self, completions, signature, **kwargs):\n        pred = Prediction.from_completions(completions, signature=signature)\n        if kwargs.pop(\"_trace\", True) and settings.trace is not None:\n            trace = settings.trace\n            trace.append((self, {**kwargs}, pred))\n        return pred\n\n    def _should_stream(self):\n        stream_listeners = settings.stream_listeners or []\n        should_stream = settings.send_stream is not None\n        if should_stream and len(stream_listeners) > 0:\n            should_stream = any(stream_listener.predict == self for stream_listener in stream_listeners)\n\n        return should_stream\n\n    def forward(self, **kwargs):\n        lm, config, signature, demos, kwargs = self._forward_preprocess(**kwargs)\n\n        adapter = settings.adapter or ChatAdapter()\n\n        if self._should_stream():\n            with settings.context(caller_predict=self):\n                completions = adapter(lm, lm_kwargs=config, signature=signature, demos=demos, inputs=kwargs)\n        else:\n            with settings.context(send_stream=None):\n                completions = adapter(lm, lm_kwargs=config, signature=signature, demos=demos, inputs=kwargs)\n\n        return self._forward_postprocess(completions, signature, **kwargs)\n\n    async def aforward(self, **kwargs):\n        lm, config, signature, demos, kwargs = self._forward_preprocess(**kwargs)\n\n        adapter = settings.adapter or ChatAdapter()\n        if self._should_stream():\n            with settings.context(caller_predict=self):\n                completions = await adapter.acall(lm, lm_kwargs=config, signature=signature, demos=demos, inputs=kwargs)\n        else:\n            with settings.context(send_stream=None):\n                completions = await adapter.acall(lm, lm_kwargs=config, signature=signature, demos=demos, inputs=kwargs)\n\n        return self._forward_postprocess(completions, signature, **kwargs)\n\n    def update_config(self, **kwargs):\n        self.config = {**self.config, **kwargs}\n\n    def get_config(self):\n        return self.config\n\n    def __repr__(self):\n        return f\"{self.__class__.__name__}({self.signature})\"\n\n\ndef serialize_object(obj):\n    \"\"\"\n    Recursively serialize a given object into a JSON-compatible format.\n    Supports Pydantic models, lists, dicts, and primitive types.\n    \"\"\"\n    if isinstance(obj, BaseModel):\n        # Use model_dump to convert the model into a JSON-serializable dict\n        return obj.model_dump()\n    elif isinstance(obj, list):\n        return [serialize_object(item) for item in obj]\n    elif isinstance(obj, tuple):\n        return tuple(serialize_object(item) for item in obj)\n    elif isinstance(obj, dict):\n        return {key: serialize_object(value) for key, value in obj.items()}\n    else:\n        return obj\n\n\n# # TODO: FIXME: Hmm, I guess expected behavior is that contexts can\n# affect execution. Well, we need to determine whether context dominates, __init__ demoninates, or forward dominates.\n# Generally, unless overwritten, we'd see n=None, temperature=None.\n# That will eventually mean we have to learn them.\n","numLines":195,"startLine":1,"totalLines":195}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_303f9c47226a45a9bc9494f1","type":"tool_result","content":"1\timport datetime\n2\timport uuid\n3\t\n4\tfrom dspy.dsp.utils import settings\n5\tfrom dspy.utils.callback import with_callbacks\n6\t\n7\tMAX_HISTORY_SIZE = 10_000\n8\tGLOBAL_HISTORY = []\n9\t\n10\t\n11\tclass BaseLM:\n12\t    \"\"\"Base class for handling LLM calls.\n13\t\n14\t    Most users can directly use the `dspy.LM` class, which is a subclass of `BaseLM`. Users can also implement their\n15\t    own subclasses of `BaseLM` to support custom LLM providers and inject custom logic. To do so, simply override the\n16\t    `forward` method and make sure the return format is identical to the\n17\t    [OpenAI response format](https://platform.openai.com/docs/api-reference/responses/object).\n18\t\n19\t    Example:\n20\t\n21\t    ```python\n22\t    from openai import OpenAI\n23\t\n24\t    import dspy\n25\t\n26\t\n27\t    class MyLM(dspy.BaseLM):\n28\t        def forward(self, prompt, messages=None, **kwargs):\n29\t            client = OpenAI()\n30\t            return client.chat.completions.create(\n31\t                model=self.model,\n32\t                messages=messages or [{\"role\": \"user\", \"content\": prompt}],\n33\t                **self.kwargs,\n34\t            )\n35\t\n36\t\n37\t    lm = MyLM(model=\"gpt-4o-mini\")\n38\t    dspy.configure(lm=lm)\n39\t    print(dspy.Predict(\"q->a\")(q=\"Why did the chicken cross the kitchen?\"))\n40\t    ```\n41\t    \"\"\"\n42\t\n43\t    def __init__(self, model, model_type=\"chat\", temperature=0.0, max_tokens=1000, cache=True, **kwargs):\n44\t        self.model = model\n45\t        self.model_type = model_type\n46\t        self.cache = cache\n47\t        self.kwargs = dict(temperature=temperature, max_tokens=max_tokens, **kwargs)\n48\t        self.history = []\n49\t\n50\t    def _process_lm_response(self, response, prompt, messages, **kwargs):\n51\t        merged_kwargs = {**self.kwargs, **kwargs}\n52\t        if merged_kwargs.get(\"logprobs\"):\n53\t            outputs = [\n54\t                {\n55\t                    \"text\": c.message.content if hasattr(c, \"message\") else c[\"text\"],\n56\t                    \"logprobs\": c.logprobs if hasattr(c, \"logprobs\") else c[\"logprobs\"],\n57\t                }\n58\t                for c in response.choices\n59\t            ]\n60\t        else:\n61\t            outputs = [c.message.content if hasattr(c, \"message\") else c[\"text\"] for c in response.choices]\n62\t\n63\t        if settings.disable_history:\n64\t            return outputs\n65\t\n66\t        # Logging, with removed api key & where `cost` is None on cache hit.\n67\t        kwargs = {k: v for k, v in kwargs.items() if not k.startswith(\"api_\")}\n68\t        entry = {\n69\t            \"prompt\": prompt,\n70\t            \"messages\": messages,\n71\t            \"kwargs\": kwargs,\n72\t            \"response\": response,\n73\t            \"outputs\": outputs,\n74\t            \"usage\": dict(response.usage),\n75\t            \"cost\": getattr(response, \"_hidden_params\", {}).get(\"response_cost\"),\n76\t            \"timestamp\": datetime.datetime.now().isoformat(),\n77\t            \"uuid\": str(uuid.uuid4()),\n78\t            \"model\": self.model,\n79\t            \"response_model\": response.model,\n80\t            \"model_type\": self.model_type,\n81\t        }\n82\t        self.history.append(entry)\n83\t        self.update_global_history(entry)\n84\t        return outputs\n85\t\n86\t    @with_callbacks\n87\t    def __call__(self, prompt=None, messages=None, **kwargs):\n88\t        response = self.forward(prompt=prompt, messages=messages, **kwargs)\n89\t        outputs = self._process_lm_response(response, prompt, messages, **kwargs)\n90\t\n91\t        return outputs\n92\t\n93\t    @with_callbacks\n94\t    async def acall(self, prompt=None, messages=None, **kwargs):\n95\t        response = await self.aforward(prompt=prompt, messages=messages, **kwargs)\n96\t        outputs = self._process_lm_response(response, prompt, messages, **kwargs)\n97\t        return outputs\n98\t\n99\t    def forward(self, prompt=None, messages=None, **kwargs):\n100\t        \"\"\"Forward pass for the language model.\n101\t\n102\t        Subclasses must implement this method, and the response should be identical to\n103\t        [OpenAI response format](https://platform.openai.com/docs/api-reference/responses/object).\n104\t        \"\"\"\n105\t        raise NotImplementedError(\"Subclasses must implement this method.\")\n106\t\n107\t    async def aforward(self, prompt=None, messages=None, **kwargs):\n108\t        \"\"\"Async forward pass for the language model.\n109\t\n110\t        Subclasses that support async should implement this method, and the response should be identical to\n111\t        [OpenAI response format](https://platform.openai.com/docs/api-reference/responses/object).\n112\t        \"\"\"\n113\t        raise NotImplementedError(\"Subclasses must implement this method.\")\n114\t\n115\t    def copy(self, **kwargs):\n116\t        \"\"\"Returns a copy of the language model with possibly updated parameters.\"\"\"\n117\t\n118\t        import copy\n119\t\n120\t        new_instance = copy.deepcopy(self)\n121\t        new_instance.history = []\n122\t\n123\t        for key, value in kwargs.items():\n124\t            if hasattr(self, key):\n125\t                setattr(new_instance, key, value)\n126\t            if (key in self.kwargs) or (not hasattr(self, key)):\n127\t                new_instance.kwargs[key] = value\n128\t\n129\t        return new_instance\n130\t\n131\t    def inspect_history(self, n: int = 1):\n132\t        _inspect_history(self.history, n)\n133\t\n134\t    def update_global_history(self, entry):\n135\t        if settings.disable_history:\n136\t            return\n137\t\n138\t        if len(GLOBAL_HISTORY) >= MAX_HISTORY_SIZE:\n139\t            GLOBAL_HISTORY.pop(0)\n140\t\n141\t        GLOB