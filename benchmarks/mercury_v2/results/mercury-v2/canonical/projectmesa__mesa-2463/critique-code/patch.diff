diff --git a/tests/test_solara_viz.py b/tests/test_solara_viz.py
index 68057757..d1fa5d7d 100644
--- a/tests/test_solara_viz.py
+++ b/tests/test_solara_viz.py
@@ -203,3 +203,17 @@ def test_model_param_checks():  # noqa: D103
     # Test empty params dict raises ValueError if required params
     with pytest.raises(ValueError, match="Missing required model parameter"):
         _check_model_params(ModelWithOnlyRequired.__init__, {})
+
+
+def test_model_param_checks_with_kwargs():  # noqa: D103
+    class ModelWithKwargs:
+        def __init__(self, required_param, **kwargs):
+            pass
+
+    # kwargs itself should not be flagged as a missing required parameter
+    _check_model_params(ModelWithKwargs.__init__, {"required_param": 1})
+
+    # extra params should be allowed when the constructor accepts **kwargs
+    _check_model_params(
+        ModelWithKwargs.__init__, {"required_param": 1, "extra_param": 2}
+    )
