e\": \"InputText\", \"value\": \"hello\"},\n            },\n        ),\n        handle_error=False,\n    )\nhook_warnings = [x for x in w if \"conditional\" in str(x.message) or \"use_reactive\" in str(x.message)]\nprint(\"hook-related warnings:\", hook_warnings if hook_warnings else \"NONE ✓\")\n\n# 1. Simulate a user changing a parameter through the UI -> on_change path\nmodel_rc = rc.find(KwargsModel)\n# find the reactive model parameters state via a step/reset simulation\nfrom mesa.visualization.solara_viz import ModelCreator, ModelController\n\n# 2. Verify reset works (do_reset uses model_parameters.value)\nwith warnings.catch_warnings(record=True) as w:\n    warnings.simplefilter(\"always\")\n    rc2 = solara.render(\n        SolaraViz(KwargsModel(num_agents=7), components=[lambda m: solara.Text(\"x\")],\n                  model_params={\"num_agents\": Slider(\"agents\", 10, 1, 50, 1)}),\n        handle_error=False,\n    )\n    hook_w = [x for x in w if \"conditional\" in str(x.message)]\n    print(\"initial-params render hook warnings:\", hook_w if hook_w else \"NONE ✓\")\n\nprint(\"ALL CHECKS DONE\")\nEOF"}}],"api":"openai-completions","provider":"harbor-endpoint","model":"z-ai/glm-5.3-flash","usage":{"input":516,"output":574,"cacheRead":20608,"cacheWrite":0,"reasoning":75,"totalTokens":21698,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1788464366075,"responseId":"gen-1788464366-V6dAPadmf6KRHrtYahw7","rawStopReason":"tool_calls"}}
