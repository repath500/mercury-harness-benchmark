'EOF'\nimport warnings\nimport solara\nimport mesa\nfrom mesa.visualization.solara_viz import SolaraViz, Slider, ModelController, ModelCreator\n\nclass KwargsModel(mesa.Model):\n    def __init__(self, num_agents=10, **kwargs):\n        super().__init__(seed=None)\n        self.num_agents = num_agents\n        self.running = True\n    def step(self):\n        self.steps += 1\n\ndef dummy(model):\n    return solara.Text(\"x\")\n\n@solara.component\ndef InteractiveHarness(initial_model, params):\n    \"\"\"Simulate SolaraViz wiring: shared reactive model_parameters + controller + creator.\"\"\"\n    if not isinstance(initial_model, solara.Reactive):\n        model = solara.use_reactive(initial_model)\n    reactive_model_parameters = solara.use_reactive({})\n    ModelController(model, model_parameters=reactive_model_parameters)\n    ModelCreator(model, params, model_parameters=reactive_model_parameters)\n    return solara.Text(\"harness\")\n\nslider = Slider(\"agents\", 10, 1, 50, 1)\nwith warnings.catch_warnings(record=True) as w:\n    warnings.simplefilter(\"always\")\n    rc = solara.render(InteractiveHarness(KwargsModel(), {\"num_agents\": slider}), handle_error=False)\nhook_w = [x for x in w if \"conditional\" in str(x.message)]\nprint(\"wiring render hook warnings:\", hook_w or \"NONE ✓\")\n\n# check that model_parameters were populated with defaults from user_params\nfrom solara.reactive import Reactive\n# find reactive params by simulating on_change: change slider value\nslider_widgets = rc.find(slider_class := __import__(\"ipyvuetify\").Slider)\nw_ = slider_widgets.widget\nw_.v_model = 25   # triggers on_value -> change_handler -> on_change\nprint(\"slider change dispatched without error ✓\")\n\n# Verify do_reset path: ModelController.do_reset uses model_parameters.value to reinstantiate\nclass RequiredModel(mesa.Model):\n    def __init__(self, p1, p2):\n        super().__init__(seed=None)\n        self.p1, self.p2 = p1, p2\n        self.running = True\n    def step(self):\n        self.steps += 1\n\nfrom mesa.visualization.solara_viz import _check_model_params\nimport pytest\n\n# kwargs model: any params valid, none required\n_check_model_params(KwargsModel.__init__, {\"anything\": 1, \"other\": 2})\n_check_model_params(KwargsModel.__init__, {})\nprint(\"kwargs model: extra params accepted, no false errors ✓\")\n\n# non-kwargs model: errors still raised properly\nwith pytest.raises(ValueError, match=\"Missing required model parameter: p2\"):\n    _check_model_params(RequiredModel.__init__, {\"p1\": 1})\nwith pytest.raises(ValueError, match=\"Invalid model parameter: bogus\"):\n    _check_model_params(RequiredModel.__init__, {\"p1\": 1, \"p2\": 2, \"bogus\": 3})\nprint(\"non-kwargs model: genuine errors still raised ✓\")\n\n# model with required params AND **kwargs: kwargs satisfies missing, extras allowed\nclass MixedModel(mesa.Model):\n    def __init__(self, p1, **kwargs):\n        super().__init__(seed=None)\n_check_model_params(MixedModel.__init__, {\"p1\": 1, \"extra\": 5})\nprint(\"mixed model (required + **kwargs): extras allowed, required enforced ✓\")\nEOF"}}],"api":"openai-completions","provider":"harbor-endpoint","model":"z-ai/glm-5.3-flash","usage":{"input":1391,"output":863,"cacheRead":22080,"cacheWrite":0,"reasoning":80,"totalTokens":24334,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1788464406537,"responseId":"gen-1788464406-3B0i25sNcJf5V0xSs1AF","rawStopReason":"tool_calls"},{"role":"toolResult","toolCallId":"call_e888cd6d728148aeacfaddb0","toolName":"bash","content":[{"type":"text","text":"/usr/local/lib/python3.11/site-packages/solara/core.py:33: UserWarning: Failed to validate hooks for component InteractiveHarness: could not get source code\n  warnings.warn(f\"Failed to validate hooks for component {obj.__qualname__}: {e}\")\nwiring render hook warnings: NONE ✓\nTraceback (most recent call last):\n  File \"<stdin>\", line 37, in <module>\nAttr