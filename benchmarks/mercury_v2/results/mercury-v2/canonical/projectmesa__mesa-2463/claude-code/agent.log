ass MixedModel(mesa.Model):\n    \"\"\"Model with a required param plus **kwargs.\"\"\"\n\n    def __init__(self, required, optional=5, **kwargs):\n        super().__init__()\n        self.required = required\n        self.optional = optional\n\n\nclass PlainModel(mesa.Model):\n    def __init__(self, num_agents=10):\n        super().__init__()\n        self.num_agents = num_agents\n\n\nclass TwoRequired:\n    def __init__(self, param1, param2):\n        pass\n\n\n# ---------------------------------------------------------------- validation\ndef test_kwargs_not_flagged_missing():\n    # **kwargs must not be treated as a missing required parameter\n    _check_model_params(KwargsModel.__init__, {\"num_agents\": 3})\n    _check_model_params(KwargsModel.__init__, {})  # kwargs-only, no params given\n    _check_model_params(MixedModel.__init__, {\"required\": 1})\n\n\ndef test_extra_params_allowed_with_kwargs():\n    # additional params must be accepted when signature has **kwargs\n    _check_model_params(KwargsModel.__init__, {\"num_agents\": 3, \"anything\": 99})\n    _check_model_params(MixedModel.__init__, {\"required\": 1, \"anything\": 99})\n\n\ndef test_genuine_errors_still_raised():\n    with pytest.raises(ValueError, match=\"Missing required model parameter: required\"):\n        _check_model_params(MixedModel.__init__, {})\n    with pytest.raises(ValueError, match=\"Invalid model parameter: bad\"):\n        _check_model_params(PlainModel.__init__, {\"num_agents\": 1, \"bad\": 2})\n    with pytest.raises(ValueError, match=\"Missing required model parameter: param2\"):\n        _check_model_params(TwoRequired.__init__, {\"param1\": 1})\n\n\n# ---------------------------------------------------------------- rendering\ndef _conditional_warnings(record):\n    return [\n        w\n        for w in record\n        if \"conditional\" in str(w.message).lower() or \"rules of hooks\" in str(w.message)\n    ]\n\n\ndef test_render_kwargs_model_no_conditional_warning():\n    \"\"\"SolaraViz must render **kwargs models without the conditional-hook warning.\"\"\"\n    for model_params in (\n        None,  # no initial params provided\n        {},  # empty params\n        {\"num_agents\": {\"type\": \"SliderInt\", \"value\": 10, \"min\": 1, \"max\": 20}},\n        {\"num_agents\": Slider(\"Agent density\", 5, 1, 20, 1), \"fixed\": 42},\n    ):\n        model = KwargsModel()\n        with warnings.catch_warnings(record=True) as record:\n            warnings.simplefilter(\"always\")\n            solara.render(SolaraViz(model, model_params=model_params), handle_error=False)\n        cond = _conditional_warnings(record)\n        assert not cond, f\"conditional-hook warning for model_params={model_params}: {cond}\"\n\n\ndef _click(widget, label):\n    dispatcher = widget._event_handlers_map.get(label)\n    assert dispatcher is not None, f\"no {label} handler on {widget}\"\n    dispatcher(widget, {})\n\n\ndef test_controller_reset_and_step_with_kwargs_model():\n    \"\"\"Reset must rebuild the model from tracked params; step works.\"\"\"\n    reactive_model = solara.reactive(KwargsModel(num_agents=7))\n    reactive_params = solara.reactive({\"num_agents\": 7})\n\n    @solara.component\n    def Harness():\n        ModelController(reactive_model, model_parameters=reactive_params)\n        ModelCreator(reactive_model, {}, model_parameters=reactive_params)\n\n    with warnings.catch_warnings(record=True) as record:\n        warnings.simplefilter(\"always\")\n        _, rc = solara.render(Harness(), handle_error=False)\n    assert not _conditional_warnings(record), _conditional_warnings(record)\n\n    # ModelCreator populated the shared reactive params from defaults\n    assert reactive_params.value == {\"num_agents\": 10}, reactive_params.value\n\n    # model stepping via \"Step\" button\n    steps = {\"n\": 0}\n    original_step = reactive_model.value.step\n\n    def counting_step():\n        original_step()\n        steps[\"n\"] += 1\n\n    reactive_model.value.step = counting_step\n\n    buttons = {}\n    for b in rc.find(vw.Btn).widgets:\n        buttons[b.children[0]] = b\n    assert set(buttons) == {\"Reset\", \"▶\", \"Step\"}, buttons.keys()\n\n    steps_before = reactive_model.value.steps\n    buttons[\"Step\"]._event_handlers_map[\"click\"](buttons[\"Step\"], {}, None)\n    assert reactive_model.value.steps == steps_before + 1, steps\n\n    # update shared params, then \"Reset\" -> model rebuilt from tracked params\n    reactive_params.value = {\"num_agents\": 13}\n    buttons[\"Reset\"]._event_handlers_map[\"click\"](buttons[\"Reset\"], {}, None)\n    assert isinstance(reactive_model.value, KwargsModel)\n    assert reactive_model.value.num_agents == 13, reactive_model.value.num_agents\n\n\ndef test_creator_with_initial_params_dict():\n    \"\"\"ModelCreator accepts a plain dict of initial model_parameters too.\"\"\"\n    reactive_model = solara.reactive(KwargsModel())\n\n    @solara.component\n    def Harness():\n        ModelCreator(\n            reactive_model,\n            {\"num_agents\": Slider(\"Num agents\", 4, 1, 20, 1)},\n            model_parameters={\"num_agents\": 4},\n        )\n\n    with warnings.catch_warnings(record=True) as record:\n        warnings.simplefilter(\"always\")\n        _, rc = solara.render(Harness(), handle_error=False)\n    assert not _conditional_warnings(record), _conditional_warnings(record)\n    assert rc.find(vw.Slider)\n\n\ndef test_solara_viz_stepping_end_to_end():\n    \"\"\"Full SolaraViz: model with **kwargs renders with parameter inputs.\"\"\"\n    with warnings.catch_warnings(record=True) as record:\n        warnings.simplefilter(\"always\")\n        _, rc = solara.render(\n            SolaraViz(\n                KwargsModel(),\n                model_params={\n                    \"num_agents\": {\"type\": \"SliderInt\", \"value\": 3, \"min\": 1, \"max\": 10}\n                },\n            ),\n            handle_error=False,\n        )\n    assert not _conditional_warnings(record), _conditional_warnings(record)\n    assert rc.find(vw.Slider)\n","userModified":false}}
