--- a/slack_bolt/middleware/authorization/internals.py
+++ b/slack_bolt/middleware/authorization/internals.py
@@ -1,4 +1,4 @@
-from typing import Optional, Union
+from typing import List, Optional, Union
 
 from slack_sdk.web import SlackResponse
 
@@ -62,18 +62,37 @@ def _is_bot_token(token: Optional[str]) -> bool:
     return token is not None and token.startswith("xoxb-")
 
 
+def _extract_scopes(auth_test_result: Union[SlackResponse, "AsyncSlackResponse"]) -> Optional[List[str]]:
+    headers = auth_test_result.get("headers") or getattr(auth_test_result, "headers", None)
+    if headers is None:
+        return None
+
+    scope_header = headers.get("x-oauth-scopes")
+    if scope_header is None:
+        return None
+    if isinstance(scope_header, (list, tuple)):
+        scope_header = scope_header[0] if len(scope_header) > 0 else None
+    if scope_header is None:
+        return None
+
+    return [scope.strip() for scope in scope_header.split(",") if scope.strip()]
+
+
 def _to_authorize_result(  # type: ignore
     auth_test_result: Union[SlackResponse, "AsyncSlackResponse"],
     token: Optional[str],
     request_user_id: Optional[str],
 ) -> AuthorizeResult:
     user_id = auth_test_result.get("user_id")
+    scopes = _extract_scopes(auth_test_result)
     return AuthorizeResult(
         enterprise_id=auth_test_result.get("enterprise_id"),
         team_id=auth_test_result.get("team_id"),
         bot_id=auth_test_result.get("bot_id"),
         bot_user_id=user_id if _is_bot_token(token) else None,
         bot_token=token if _is_bot_token(token) else None,
+        bot_scopes=scopes if _is_bot_token(token) else None,
         user_id=request_user_id or (user_id if not _is_bot_token(token) else None),
         user_token=token if not _is_bot_token(token) else None,
+        user_scopes=None if _is_bot_token(token) else scopes,
     )
