ab8d1390f6","name":"bash","arguments":{"command":"cd /testbed && python - <<'EOF'\nfrom slack_sdk import WebClient\nfrom slack_bolt.middleware import SingleTeamAuthorization\nfrom slack_bolt.request import BoltRequest\nfrom slack_bolt.response import BoltResponse\nfrom tests.mock_web_api_server import setup_mock_web_api_server, cleanup_mock_web_api_server\n\ndef next():\n    return BoltResponse(status=200)\n\nsetup = setup_mock_web_api_server(self=None) if False else None\nimport unittest\nclass T(unittest.TestCase):\n    def runTest(self):\n        pass\nt = T()\nsetup_mock_web_api_server(t)\n\n# Bot token: x-oauth-scopes -> bot_scopes\nauth = SingleTeamAuthorization()\nreq = BoltRequest(body=\"payload={}\", headers={})\nreq.context[\"client\"] = WebClient(base_url=\"http://localhost:8888\", token=\"xoxb-valid\")\nresp = auth.process(req=req, resp=BoltResponse(status=404), next=next)\nar = req.context.authorize_result\nprint(\"bot token  -> bot_scopes:\", ar.bot_scopes, \"| user_scopes:\", ar.user_scopes)\nassert ar.bot_scopes == [\"chat:write\", \"commands\"] and ar.user_scopes is None\n\n# User token: x-oauth-scopes -> user_scopes\nauth = SingleTeamAuthorization()\nreq = BoltRequest(body=\"payload={}\", headers={})\nreq.context[\"client\"] = WebClient(base_url=\"http://localhost:8888\", token=\"xoxp-valid\")\nresp = auth.process(req=req, resp=BoltResponse(status=404), next=next)\nar = req.context.authorize_result\nprint(\"user token -> bot_scopes:\", ar.bot_scopes, \"| user_scopes:\", ar.user_scopes)\nassert ar.user_scopes == [\"chat:write\", \"search:read\"] and ar.bot_scopes is None\ncleanup_mock_web_api_server(t)\nprint(\"OK\")\nEOF"}}],"api":"openai-completions","provider":"harbor-endpoint","model":"z-ai/glm-5.3-flash","usage":{"input":149,"output":557,"cacheRead":37376,"cacheWrite":0,"reasoning":127,"totalTokens":38082,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1788491254150,"responseId":"gen-1788