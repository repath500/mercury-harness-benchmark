{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-abb0c06329b8c939","type":"tool_result","content":"1\tfrom typing import Optional, Union\n2\t\n3\tfrom slack_sdk.web import SlackResponse\n4\t\n5\tfrom slack_bolt.authorization import AuthorizeResult\n6\tfrom slack_bolt.request.request import BoltRequest\n7\tfrom slack_bolt.response import BoltResponse\n8\t\n9\t#\n10\t# NOTE: this source file intentionally avoids having a reference to\n11\t# AsyncBoltRequest, AsyncSlackResponse, and whatever Async-prefixed.\n12\t#\n13\t# The reason why we do so is to enable developers use sync version of Bolt\n14\t# without installing aiohttp library (or any others we may use for async things)\n15\t#\n16\t\n17\t\n18\tdef _is_url_verification(req: Union[BoltRequest, \"AsyncBoltRequest\"]) -> bool:  # type: ignore\n19\t    return req is not None and req.body is not None and req.body.get(\"type\") == \"url_verification\"\n20\t\n21\t\n22\tdef _is_ssl_check(req: Union[BoltRequest, \"AsyncBoltRequest\"]) -> bool:  # type: ignore\n23\t    return req is not None and req.body is not None and req.body.get(\"type\") == \"ssl_check\"\n24\t\n25\t\n26\tno_auth_test_events = [\"app_uninstalled\", \"tokens_revoked\", \"team_access_revoked\"]\n27\t\n28\t\n29\tdef _is_no_auth_test_events(req: Union[BoltRequest, \"AsyncBoltRequest\"]) -> bool:  # type: ignore\n30\t    return (\n31\t        req is not None\n32\t        and req.body is not None\n33\t        and req.body.get(\"type\") == \"event_callback\"\n34\t        and req.body.get(\"event\", {}).get(\"type\") in no_auth_test_events\n35\t    )\n36\t\n37\t\n38\tdef _is_no_auth_required(req: Union[BoltRequest, \"AsyncBoltRequest\"]) -> bool:  # type: ignore\n39\t    return _is_url_verification(req) or _is_ssl_check(req)\n40\t\n41\t\n42\tdef _is_no_auth_test_call_required(req: Union[BoltRequest, \"AsyncBoltRequest\"]) -> bool:  # type: ignore\n43\t    return _is_no_auth_test_events(req)\n44\t\n45\t\n46\tdef _build_user_facing_authorize_error_message() -> str:\n47\t    return (\n48\t        \":warning: We apologize, but for some unknown reason, your installation with this app is no longer available. \"\n49\t        \"Please reinstall this app into your workspace :bow:\"\n50\t    )\n51\t\n52\t\n53\tdef _build_user_facing_error_response(message: str) -> BoltResponse:\n54\t    # show an ephemeral message to the end-user\n55\t    return BoltResponse(\n56\t        status=200,\n57\t        body=message,\n58\t    )\n59\t\n60\t\n61\tdef _is_bot_token(token: Optional[str]) -> bool:\n62\t    return token is not None and token.startswith(\"xoxb-\")\n63\t\n64\t\n65\tdef _to_authorize_result(  # type: ignore\n66\t    auth_test_result: Union[SlackResponse, \"AsyncSlackResponse\"],\n67\t    token: Optional[str],\n68\t    request_user_id: Optional[str],\n69\t) -> AuthorizeResult:\n70\t    user_id = auth_test_result.get(\"user_id\")\n71\t    return AuthorizeResult(\n72\t        enterprise_id=auth_test_result.get(\"enterprise_id\"),\n73\t        team_id=auth_test_result.get(\"team_id\"),\n74\t        bot_id=auth_test_result.get(\"bot_id\"),\n75\t        bot_user_id=user_id if _is_bot_token(token) else None,\n76\t        bot_token=token if _is_bot_token(token) else None,\n77\t        user_id=request_user_id or (user_id if not _is_bot_token(token) else None),\n78\t        user_token=token if not _is_bot_token(token) else None,\n79\t    )\n80\t"}]},"parent_tool_use_id":null,"session_id":"02e22cc0-e01a-43f1-b698-3e20536e0a1c","uuid":"24918ba8-2172-4781-b66a-edfe523d0356","timestamp":"2026-09-03T22:21:53.251Z","tool_use_result":{"type":"text","file":{"filePath":"/testbed/slack_bolt/middleware/authorization/internals.py","content":"from typing import Optional, Union\n\nfrom slack_sdk.web import SlackResponse\n\nfrom slack_bolt.authorization import AuthorizeResult\nfrom slack_bolt.request.request import BoltRequest\nfrom slack_bolt.response import BoltResponse\n\n#\n# NOTE: this source file intentionally avoids