{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"nl -ba conan/api/subapi/workspace.py | sed -n 160,290p; printf '\\\\n--- cli 1-240 ---\\\\n'; nl -ba conan/cli/commands/workspace.py | sed -n 1,240p; printf '\\\\n--- tests 1-460 ---\\\\n'; nl -ba test/integration/workspace/test_workspace.py | sed -n 1,460p\"","aggregated_output":"   160\t    def add(self, path, name=None, version=None, user=None, channel=None, cwd=None,\n   161\t            output_folder=None, remotes=None):\n   162\t        \"\"\"\n   163\t        Add a new editable package to the current workspace (the current workspace must exist)\n   164\t        @param path: The path to the folder containing the conanfile.py that defines the package\n   165\t        @param name: (optional) The name of the package to be added if not defined in recipe\n   166\t        @param version:\n   167\t        @param user:\n   168\t        @param channel:\n   169\t        @param cwd:\n   170\t        @param output_folder:\n   171\t        @param remotes:\n   172\t        @return: The reference of the added package\n   173\t        \"\"\"\n   174\t        self._check_ws()\n   175\t        full_path = self._conan_api.local.get_conanfile_path(path, cwd, py=True)\n   176\t        app = ConanApp(self._conan_api)\n   177\t        conanfile = app.loader.load_named(full_path, name, version, user, channel, remotes=remotes)\n   178\t        if conanfile.name is None or conanfile.version is None:\n   179\t            raise ConanException(\"Editable package recipe should declare its name and version\")\n   180\t        ref = RecipeReference(conanfile.name, conanfile.version, conanfile.user, conanfile.channel)\n   181\t        ref.validate_ref()\n   182\t        output_folder = make_abs_path(output_folder) if output_folder else None\n   183\t        # Check the conanfile is there, and name/version matches\n   184\t        self._ws.add(ref, full_path, output_folder)\n   185\t        return ref\n   186\t\n   187\t    @staticmethod\n   188\t    def init(path):\n   189\t        abs_path = make_abs_path(path)\n   190\t        os.makedirs(abs_path, exist_ok=True)\n   191\t        ws_yml_file = Path(abs_path, WORKSPACE_YML)\n   192\t        ws_py_file = Path(abs_path, WORKSPACE_PY)\n   193\t        if not ws_yml_file.exists():\n   194\t            ConanOutput().success(f\"Created empty {WORKSPACE_YML} in {path}\")\n   195\t            save(ws_yml_file, \"\")\n   196\t        if not ws_py_file.exists():\n   197\t            ConanOutput().success(f\"Created minimal {WORKSPACE_PY} in {path}\")\n   198\t            ws_name = os.path.basename(abs_path)\n   199\t            save(ws_py_file, textwrap.dedent(f'''\\\n   200\t            from conan import Workspace\n   201\t\n   202\t            class MyWorkspace(Workspace):\n   203\t               \"\"\"\n   204\t               Minimal Workspace class definition.\n   205\t               More info: https://docs.conan.io/2/incubating.html#workspaces\n   206\t               \"\"\"\n   207\t               def name(self):\n   208\t                  return \"{ws_name}\"\n   209\t            '''))\n   210\t\n   211\t    def remove(self, path):\n   212\t        self._check_ws()\n   213\t        return self._ws.remove(path)\n   214\t\n   215\t    def clean(self):\n   216\t        self._check_ws()\n   217\t        return self._ws.clean()\n   218\t\n   219\t    def info(self):\n   220\t        self._check_ws()\n   221\t        return {\"name\": self.name,\n   222\t                \"folder\": self._folder,\n   223\t                \"packages\": self._ws.packages()}\n   224\t\n   225\t    def super_build_graph(self, deps_graph, profile_host, profile_build):\n   226\t        ConanOutput().title(\"Collapsing workspace packages\")\n   227\t\n   228\t        root_class = self._ws.root_conanfile()\n   229\t        if root_class is not None:\n   230\t            conanfile = root_class(f\"{WORKSPACE_PY} base project Conanfile\")\n   231\t            consumer_definer(conanfile, profile_host, profile_build)\n   232\t            root = Node(None, conanfile, context=CONTEXT_HOST, recipe=RECIPE_CONSUMER,\n   233\t                        path=self._folder)  # path lets use the conanws.py folder\n   234\t            root.should_build = True  # It is a consumer, this is something we are building\n   235\t            for field in (\"requires\", \"build_requires\", \"test_requires\", \"requirements\", \"build\",\n   236\t                          \"source\", \"package\"):\n   237\t                if getattr(conanfile, field, None):\n   238\t                    raise ConanException(f\"Conanfile in conanws.py shouldn't have '{field}'\")\n   239\t        else:\n   240\t            ConanOutput().info(f\"Workspace {WORKSPACE_PY} not found in the workspace folder, \"\n   241\t                               \"using default behavior\")\n   242\t            conanfile = ConanFile(display_name=\"cli\")\n   243\t            consumer_definer(conanfile, profile_host, profile_build)\n   244\t            root = Node(ref=None, conanfile=conanfile, context=CONTEXT_HOST, recipe=RECIPE_VIRTUAL)\n   245\t\n   246\t        result = DepsGraph()  # TODO: We might need to copy more information from the original graph\n   247\t        result.add_node(root)\n   248\t        for node in deps_graph.nodes[1:]:  # Exclude the current root\n   249\t            if node.recipe != RECIPE_EDITABLE:\n   250\t                result.add_node(node)\n   251\t                continue\n   252\t            for r, t in node.transitive_deps.items():\n   253\t                if t.node.recipe == RECIPE_EDITABLE:\n   254\t                    continue\n   255\t                existing = root.transitive_deps.pop(r, None)\n   256\t                if existing is None:\n   257\t                    root.transitive_deps[r] = t\n   258\t                else:\n   259\t                    require = existing.require\n   260\t                    require.aggregate(r)\n   261\t                    root.transitive_deps[require] = TransitiveRequirement(require, t.node)\n   262\t\n   263\t        # The graph edges must be defined too\n   264\t        for r, t in root.transitive_deps.items():\n   265\t            result.add_edge(root, t.node, r)\n   266\t\n   267\t        return result\n   268\t\n   269\t    def export(self, lockfile=None, remotes=None):\n   270\t        self._check_ws()\n   271\t        exported = []\n   272\t        for ref, info in self.packages().items():\n   273\t            exported_ref = self._conan_api.export.export(info[\"path\"], ref.name, str(ref.version),\n   274\t                                                         ref.user, ref.channel,\n   275\t                                                         lockfile=lockfile, remotes=remotes)\n   276\t            ref, _ = exported_ref\n   277\t            exported.append(ref)\n   278\t        return exported\n   279\t\n   280\t\n   281\t    def select_packages(self, packages):\n   282\t        self._check_ws()\n   283\t        editable = self.packages()\n   284\t        packages = packages or []\n   285\t        selected_editables = {}\n   286\t        for ref, info in editable.items():\n   287\t            if packages and not any(ref.matches(p, False) for p in packages):\n   288\t                continue\n   289\t            selected_editables[ref] = info\n   290\t        if not selected_editables:\n\n--- cli 1-240 ---\n     1\timport json\n     2\timport os\n     3\t\n     4\tfrom conan.api.conan_api import ConanAPI\n     5\tfrom conan.api.model import RecipeReference\n     6\tfrom conan.api.output import ConanOutput, cli_out_write\n     7\tfrom conan.api.subapi.workspace import WorkspaceAPI\n     8\tfrom conan.cli import make_abs_path\n     9\tfrom conan.cli.args import add_reference_args, add_common_install_arguments, add_lockfile_args\n    10\tfrom conan.cli.command import conan_command, conan_subcommand\n    11\tfrom conan.cli.commands.list import print_serial\n    12\tfrom conan.cli.printers import print_profiles\n    13\tfrom conan.cli.printers.graph import print_graph_packages, print_graph_basic\n    14\tfrom conan.errors import ConanException\n    15\tfrom conan.internal.graph.install_graph import ProfileArgs\n    16\t\n    17\t\n    18\t@conan_subcommand(formatters={\"text\": cli_out_write})\n    19\tdef workspace_root(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n    20\t    \"\"\"\n    21\t    Return the folder containing the conanws.py/conanws.yml workspace file\n    22\t    \"\"\"\n    23\t    parser.parse_args(*args)\n    24\t    ws = conan_api.workspace\n    25\t    return ws.folder()\n    26\t\n    27\t\n    28\t@conan_subcommand()\n    29\tdef workspace_open(conan_api: ConanAPI, parser, subparser, *args):\n    30\t    \"\"\"\n    31\t    Open specific references\n    32\t    \"\"\"\n    33\t    subparser.add_argument(\"reference\",\n    34\t                           help=\"Open this package source repository\")\n    35\t    group = subparser.add_mutually_exclusive_group()\n    36\t    group.add_argument(\"-r\", \"--remote\", action=\"append\", default=None,\n    37\t                       help='Look in the specified remote or remotes server')\n    38\t    group.add_argument(\"-nr\", \"--no-remote\", action=\"store_true\",\n    39\t                       help='Do not use remote, resolve exclusively in the cache')\n    40\t    args = parser.parse_args(*args)\n    41\t    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n    42\t    cwd = os.getcwd()\n    43\t    conan_api.workspace.open(args.reference, remotes=remotes, cwd=cwd)\n    44\t\n    45\t\n    46\t@conan_subcommand()\n    47\tdef workspace_add(conan_api: ConanAPI, parser, subparser, *args):\n    48\t    \"\"\"\n    49\t    Add packages to current workspace\n    50\t    \"\"\"\n    51\t    subparser.add_argument('path',  nargs=\"?\",\n    52\t                           help='Path to the package folder in the user workspace')\n    53\t    add_reference_args(subparser)\n    54\t    subparser.add_argument(\"--ref\", help=\"Open and add this reference\")\n    55\t    subparser.add_argument(\"-of\", \"--output-folder\",\n    56\t                           help='The root output folder for generated and build files')\n    57\t    group = subparser.add_mutually_exclusive_group()\n    58\t    group.add_argument(\"-r\", \"--remote\", action=\"append\", default=None,\n    59\t                       help='Look in the specified remote or remotes server')\n    60\t    group.add_argument(\"-nr\", \"--no-remote\", action=\"store_true\",\n    61\t                       help='Do not use remote, resolve exclusively in the cache')\n    62\t    args = parser.parse_args(*args)\n    63\t    if args.path and args.ref:\n    64\t        raise ConanException(\"Do not use both 'path' and '--ref' argument\")\n    65\t    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n    66\t    cwd = os.getcwd()\n    67\t    path = args.path\n    68\t    if args.ref:\n    69\t        # TODO: Use path here to open in this path\n    70\t        path = conan_api.workspace.open(args.ref, remotes, cwd=cwd)\n    71\t    ref = conan_api.workspace.add(path,\n    72\t                                  args.name, args.version, args.user, args.channel,\n    73\t                                  cwd, args.output_folder, remotes=remotes)\n    74\t    ConanOutput().success(\"Reference '{}' added to workspace\".format(ref))\n    75\t\n    76\t\n    77\t@conan_subcommand()\n    78\tdef workspace_remove(conan_api: ConanAPI, parser, subparser, *args):\n    79\t    \"\"\"\n    80\t    Remove packages from the current workspace\n    81\t    \"\"\"\n    82\t    subparser.add_argument('path',\n    83\t                           help='Path to the package folder in the user workspace')\n    84\t    args = parser.parse_args(*args)\n    85\t    removed = conan_api.workspace.remove(make_abs_path(args.path))\n    86\t    ConanOutput().info(f\"Removed from workspace: {removed}\")\n    87\t\n    88\t\n    89\tdef print_json(data):\n    90\t    results = data[\"info\"]\n    91\t    myjson = json.dumps(results, indent=4)\n    92\t    cli_out_write(myjson)\n    93\t\n    94\t\n    95\tdef _print_workspace_info(data):\n    96\t    print_serial(data[\"info\"])\n    97\t\n    98\t\n    99\t@conan_subcommand(formatters={\"text\": _print_workspace_info, \"json\": print_json})\n   100\tdef workspace_info(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n   101\t    \"\"\"\n   102\t    Display info for current workspace\n   103\t    \"\"\"\n   104\t    parser.parse_args(*args)\n   105\t    return {\"info\": conan_api.workspace.info()}\n   106\t\n   107\t\n   108\t@conan_subcommand()\n   109\tdef workspace_build(conan_api: ConanAPI, parser, subparser, *args):\n   110\t    \"\"\"\n   111\t    Call \"conan build\" for packages in the workspace, in the right order\n   112\t    \"\"\"\n   113\t    _install_build(conan_api, parser, subparser, True, *args)\n   114\t\n   115\t\n   116\t@conan_subcommand()\n   117\tdef workspace_install(conan_api: ConanAPI, parser, subparser, *args):\n   118\t    \"\"\"\n   119\t    Call \"conan install\" for packages in the workspace, in the right order\n   120\t    \"\"\"\n   121\t    _install_build(conan_api, parser, subparser, False, *args)\n   122\t\n   123\t\n   124\tdef _install_build(conan_api: ConanAPI, parser, subparser, build, *args):\n   125\t    subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n   126\t    add_common_install_arguments(subparser)\n   127\t    add_lockfile_args(subparser)\n   128\t    args = parser.parse_args(*args)\n   129\t    # Basic collaborators: remotes, lockfile, profiles\n   130\t    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n   131\t    overrides = eval(args.lockfile_overrides) if args.lockfile_overrides else None\n   132\t    # The lockfile by default if not defined will be read from the root workspace folder\n   133\t    ws_folder = conan_api.workspace.folder()\n   134\t    lockfile = conan_api.lockfile.get_lockfile(lockfile=args.lockfile, conanfile_path=ws_folder,\n   135\t                                               cwd=None, partial=args.lockfile_partial,\n   136\t                                               overrides=overrides)\n   137\t    profile_host, profile_build = conan_api.profiles.get_profiles_from_args(args)\n   138\t    print_profiles(profile_host, profile_build)\n   139\t\n   140\t    buildmode = args.build\n   141\t    if build and (not buildmode or \"editable\" not in buildmode):\n   142\t        ConanOutput().info(\"Adding '--build=editable' as build mode\")\n   143\t        buildmode = buildmode or []\n   144\t        buildmode.append(\"editable\")\n   145\t\n   146\t    all_editables = conan_api.workspace.packages()\n   147\t    packages = conan_api.workspace.select_packages(args.pkg)\n   148\t    ConanOutput().box(\"Workspace computing the build order\")\n   149\t    install_order = conan_api.workspace.build_order(packages, profile_host, profile_build, buildmode,\n   150\t                                                    lockfile, remotes, args, update=args.update)\n   151\t\n   152\t    msg = \"build\" if build else \"install\"\n   153\t    ConanOutput().box(f\"Workspace {msg}ing each package\")\n   154\t    order = install_order.install_build_order()\n   155\t\n   156\t    profile_args = ProfileArgs.from_args(args)\n   157\t    for level in order[\"order\"]:\n   158\t        for elem in level:\n   159\t            ref = RecipeReference.loads(elem[\"ref\"])\n   160\t            for package_level in elem[\"packages\"]:\n   161\t                for package in package_level:\n   162\t                    if package[\"binary\"] == \"Build\":  # Build external to Workspace\n   163\t                        cmd = f'install {package[\"build_args\"]} {profile_args}'\n   164\t                        ConanOutput().box(f\"Workspace building external {ref}\")\n   165\t                        ConanOutput().info(f\"Command: {cmd}\\n\")\n   166\t                        conan_api.command.run(cmd)\n   167\t                    elif package[\"binary\"] in (\"Editable\", \"EditableBuild\"):\n   168\t                        path = all_editables[ref][\"path\"]\n   169\t                        output_folder = all_editables[ref].get(\"output_folder\")\n   170\t                        build_arg = \"--build-require\" if package[\"context\"] == \"build\" else \"\"\n   171\t                        ref_args = \" \".join(f\"--{k}={getattr(ref, k)}\"\n   172\t                                            for k in (\"name\", \"version\", \"user\", \"channel\")\n   173\t                                            if getattr(ref, k, None))\n   174\t                        of_arg = f'-of=\"{output_folder}\"' if output_folder else \"\"\n   175\t                        # TODO: Missing --lockfile-overrides arg here\n   176\t                        command = \"build\" if build else \"install\"\n   177\t                        cmd = f'{command} \"{path}\" {profile_args} {build_arg} {ref_args} {of_arg}'\n   178\t                        ConanOutput().box(f\"Workspace {command}: {ref}\")\n   179\t                        ConanOutput().info(f\"Command: {cmd}\\n\")\n   180\t                        conan_api.command.run(cmd)\n   181\t\n   182\t\n   183\t@conan_subcommand()\n   184\tdef workspace_super_install(conan_api: ConanAPI, parser, subparser, *args):\n   185\t    \"\"\"\n   186\t    Install the workspace as a monolith, installing only external dependencies to the workspace,\n   187\t    generating a single result (generators, etc) for the whole workspace.\n   188\t    \"\"\"\n   189\t    subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n   190\t    subparser.add_argument(\"-g\", \"--generator\", action=\"append\", help='Generators to use')\n   191\t    subparser.add_argument(\"-of\", \"--output-folder\",\n   192\t                           help='The root output folder for generated and build files')\n   193\t    subparser.add_argument(\"--envs-generation\", default=None, choices=[\"false\"],\n   194\t                           help=\"Generation strategy for virtual environment files for the root\")\n   195\t    add_common_install_arguments(subparser)\n   196\t    add_lockfile_args(subparser)\n   197\t    args = parser.parse_args(*args)\n   198\t    # Basic collaborators: remotes, lockfile, profiles\n   199\t    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n   200\t    overrides = eval(args.lockfile_overrides) if args.lockfile_overrides else None\n   201\t    # The lockfile by default if not defined will be read from the root workspace folder\n   202\t    ws_folder = conan_api.workspace.folder()\n   203\t    lockfile = conan_api.lockfile.get_lockfile(lockfile=args.lockfile, conanfile_path=ws_folder,\n   204\t                                               cwd=None,\n   205\t                                               partial=args.lockfile_partial, overrides=overrides)\n   206\t    profile_host, profile_build = conan_api.profiles.get_profiles_from_args(args)\n   207\t    print_profiles(profile_host, profile_build)\n   208\t\n   209\t    # Build a dependency graph with all editables as requirements\n   210\t    requires = conan_api.workspace.select_packages(args.pkg)\n   211\t    deps_graph = conan_api.graph.load_graph_requires(requires, [],\n   212\t                                                     profile_host, profile_build, lockfile,\n   213\t                                                     remotes, args.build, args.update)\n   214\t    deps_graph.report_graph_error()\n   215\t    print_graph_basic(deps_graph)\n   216\t\n   217\t    # Collapsing the graph\n   218\t    ws_graph = conan_api.workspace.super_build_graph(deps_graph, profile_host, profile_build)\n   219\t    ConanOutput().subtitle(\"Collapsed graph\")\n   220\t    print_graph_basic(ws_graph)\n   221\t\n   222\t    conan_api.graph.analyze_binaries(ws_graph, args.build, remotes=remotes, update=args.update,\n   223\t                                     lockfile=lockfile)\n   224\t    print_graph_packages(ws_graph)\n   225\t    conan_api.install.install_binaries(deps_graph=ws_graph, remotes=remotes)\n   226\t    output_folder = make_abs_path(args.output_folder) if args.output_folder else None\n   227\t    conan_api.install.install_consumer(ws_graph, args.generator, ws_folder, output_folder,\n   228\t                                       envs_generation=args.envs_generation)\n   229\t\n   230\t\n   231\t@conan_subcommand()\n   232\tdef workspace_clean(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n   233\t    \"\"\"\n   234\t    Clean the temporary build folders when possible\n   235\t    \"\"\"\n   236\t    parser.parse_args(*args)\n   237\t    conan_api.workspace.clean()\n   238\t\n   239\t\n   240\t@conan_subcommand()\n\n--- tests 1-460 ---\n     1\timport json\n     2\timport os\n     3\timport shutil\n     4\timport textwrap\n     5\t\n     6\timport pytest\n     7\t\n     8\tfrom conan.api.subapi.workspace import WorkspaceAPI\n     9\tfrom conan.test.assets.genconanfile import GenConanfile\n    10\tfrom conan.test.utils.scm import create_local_git_repo\n    11\tfrom conan.test.utils.test_files import temp_folder\n    12\tfrom conan.test.utils.tools import TestClient\n    13\tfrom conan.internal.util.files import save_files\n    14\t\n    15\tWorkspaceAPI.TEST_ENABLED = \"will_break_next\"\n    16\t\n    17\t\n    18\tclass TestWorkspaceRoot:\n    19\t\n    20\t    def test_workspace_root(self):\n    21\t        c = TestClient(light=True)\n    22\t        # Just check the root command works\n    23\t        c.run(\"workspace root\", assert_error=True)\n    24\t        assert \"ERROR: Workspace not defined, please create\" in c.out\n    25\t\n    26\t        # error, conanws/ folder does not contain conanws.[py | yml]\n    27\t        c.save({\"conanws/test.txt\": \"\"})\n    28\t        with c.chdir(\"conanws\"):\n    29\t            c.run(\"workspace root\", assert_error=True)\n    30\t            assert \"ERROR: Workspace not defined, please create\" in c.out\n    31\t            c.save({\"conanws.yml\": \"\"})\n    32\t            c.run(\"workspace root\")\n    33\t            assert c.current_folder in c.stdout\n    34\t\n    35\t        # error, empty .py\n    36\t        c.save({\"conanws.py\": \"\"}, clean_first=True)\n    37\t        c.run(\"workspace root\", assert_error=True)\n    38\t        assert \"Error loading conanws.py\" in c.out\n    39\t        assert \"No subclass of Workspace\" in c.out\n    40\t\n    41\t        c.save({\"conanws.yml\": \"\"}, clean_first=True)\n    42\t        c.run(\"workspace root\")\n    43\t        assert c.current_folder in c.stdout\n    44\t\n    45\t\n    46\tclass TestAddRemove:\n    47\t\n    48\t    def test_add(self):\n    49\t        c = TestClient(light=True)\n    50\t        c.save({\"conanws.yml\": \"\",\n    51\t                \"dep1/conanfile.py\": GenConanfile(\"dep1\", \"0.1\"),\n    52\t                \"dep2/conanfile.py\": GenConanfile(\"dep2\", \"0.1\"),\n    53\t                \"dep3/conanfile.py\": GenConanfile(\"dep3\", \"0.1\")})\n    54\t        c.run(\"workspace add dep1\")\n    55\t        assert \"Reference 'dep1/0.1' added to workspace\" in c.out\n    56\t        c.run(\"workspace info\")\n    57\t        assert \"dep1/0.1\" in c.out\n    58\t        assert \"dep2\" not in c.out\n    59\t        c.run(\"editable list\")  # No editables in global\n    60\t        assert \"dep1\" not in c.out\n    61\t        assert \"dep2\" not in c.out\n    62\t        c.run(\"workspace add dep2\")\n    63\t        assert \"Reference 'dep2/0.1' added to workspace\" in c.out\n    64\t        c.run(\"workspace info\")\n    65\t        assert \"dep1/0.1\" in c.out\n    66\t        assert \"dep2/0.1\" in c.out\n    67\t\n    68\t        with c.chdir(temp_folder()):  # If we move to another folder, outside WS, no editables\n    69\t            c.run(\"editable list\")\n    70\t            assert \"dep1\" not in c.out\n    71\t            assert \"dep2\" not in c.out\n    72\t\n    73\t        c.run(\"workspace info\")\n    74\t        assert \"dep1/0.1\" in c.out\n    75\t        assert \"dep2/0.1\" in c.out\n    76\t\n    77\t        c.run(\"workspace remove dep1\")\n    78\t        c.run(\"workspace info\")\n    79\t        assert \"dep1/0.1\" not in c.out\n    80\t        assert \"dep2/0.1\" in c.out\n    81\t\n    82\t        c.run(\"workspace remove dep2\")\n    83\t        c.run(\"workspace info\")\n    84\t        assert \"dep1/0.1\" not in c.out\n    85\t        assert \"dep2/0.1\" not in c.out\n    86\t\n    87\t    def test_add_from_outside(self):\n    88\t        c = TestClient(light=True)\n    89\t        c.save({\"sub/conanws.yml\": \"\",\n    90\t                \"sub/dep1/conanfile.py\": GenConanfile(\"dep1\", \"0.1\"),\n    91\t                \"sub/dep2/conanfile.py\": GenConanfile(\"dep2\", \"0.1\")})\n    92\t        with c.chdir(\"sub\"):\n    93\t            c.run(\"workspace add dep1\")\n    94\t            assert \"Reference 'dep1/0.1' added to workspace\" in c.out\n    95\t            c.run(\"workspace add dep2\")\n    96\t            assert \"Reference 'dep2/0.1' added to workspace\" in c.out\n    97\t            c.run(\"workspace info\")\n    98\t            assert \"dep1/0.1\" in c.out\n    99\t            assert \"dep2/0.1\" in c.out\n   100\t        assert c.load_home(\"editable_packages.json\") is None\n   101\t\n   102\t        c.run(\"editable list\")\n   103\t        assert \"dep1\" not in c.out\n   104\t        assert \"dep2\" not in c.out\n   105\t        assert c.load_home(\"editable_packages.json\") is None\n   106\t        with c.chdir(\"sub\"):\n   107\t            c.run(\"editable add dep1\")\n   108\t            assert c.load_home(\"editable_packages.json\") is not None\n   109\t            c.run(\"editable list\")\n   110\t            assert \"dep1/0.1\" in c.out\n   111\t            assert \"dep2/0.1\" not in c.out\n   112\t            c.run(\"workspace info\")\n   113\t            assert \"dep1\" in c.out\n   114\t            assert \"dep2\" in c.out\n   115\t\n   116\t        c.run(\"editable list\")\n   117\t        assert \"dep1/0.1\" in c.out\n   118\t        assert \"dep2\" not in c.out\n   119\t\n   120\t    @pytest.mark.parametrize(\"api\", [False, True])\n   121\t    def test_dynamic_editables(self, api):\n   122\t        c = TestClient(light=True)\n   123\t        conanfile = textwrap.dedent(\"\"\"\n   124\t            import os\n   125\t            from conan import ConanFile\n   126\t            from conan.tools.files import load\n   127\t            class Lib(ConanFile):\n   128\t                def set_name(self):\n   129\t                    self.name = load(self, os.path.join(self.recipe_folder, \"name.txt\"))\n   130\t                def set_version(self):\n   131\t                    self.version = load(self, os.path.join(self.recipe_folder, \"version.txt\"))\n   132\t            \"\"\")\n   133\t        if not api:\n   134\t            workspace = textwrap.dedent(\"\"\"\\\n   135\t                import os\n   136\t                from conan import Workspace\n   137\t\n   138\t                class MyWorkspace(Workspace):\n   139\t                    def packages(self):\n   140\t                        result = {}\n   141\t                        for f in os.listdir(self.folder):\n   142\t                            if os.path.isdir(os.path.join(self.folder, f)):\n   143\t                                full_path = os.path.join(self.folder, f, \"name.txt\")\n   144\t                                name = open(full_path).read().strip()\n   145\t                                version = open(os.path.join(self.folder, f,\n   146\t                                                            \"version.txt\")).read().strip()\n   147\t                                result[f\"{name}/{version}\"] = {\"path\": f}\n   148\t                        return result\n   149\t                \"\"\")\n   150\t        else:\n   151\t            workspace = textwrap.dedent(\"\"\"\\\n   152\t                import os\n   153\t                from conan import Workspace\n   154\t\n   155\t                class MyWorkspace(Workspace):\n   156\t                    def packages(self):\n   157\t                        result = {}\n   158\t                        for f in os.listdir(self.folder):\n   159\t                            if os.path.isdir(os.path.join(self.folder, f)):\n   160\t                                conanfile = self.load_conanfile(f)\n   161\t                                result[f\"{conanfile.name}/{conanfile.version}\"] = {\"path\": f}\n   162\t                        return result\n   163\t               \"\"\")\n   164\t\n   165\t        c.save({\"conanws.py\": workspace,\n   166\t                \"dep1/conanfile.py\": conanfile,\n   167\t                \"dep1/name.txt\": \"pkg\",\n   168\t                \"dep1/version.txt\": \"2.1\"})\n   169\t        c.run(\"workspace info --format=json\")\n   170\t        info = json.loads(c.stdout)\n   171\t        assert info[\"packages\"] == {\"pkg/2.1\": {\"path\": \"dep1\"}}\n   172\t        c.save({\"dep1/name.txt\": \"other\",\n   173\t                \"dep1/version.txt\": \"14.5\"})\n   174\t        c.run(\"workspace info --format=json\")\n   175\t        info = json.loads(c.stdout)\n   176\t        assert info[\"packages\"] == {\"other/14.5\": {\"path\": \"dep1\"}}\n   177\t        c.run(\"install --requires=other/14.5\")\n   178\t        # Doesn't fail\n   179\t        assert \"other/14.5 - Editable\" in c.out\n   180\t        with c.chdir(\"dep1\"):\n   181\t            c.run(\"install --requires=other/14.5\")\n   182\t            # Doesn't fail\n   183\t            assert \"other/14.5 - Editable\" in c.out\n   184\t\n   185\t    def test_api_dynamic_version_run(self):\n   186\t        # https://github.com/conan-io/conan/issues/17306\n   187\t        c = TestClient(light=True)\n   188\t        conanfile = textwrap.dedent(\"\"\"\n   189\t            from io import StringIO\n   190\t            from conan import ConanFile\n   191\t            class Lib(ConanFile):\n   192\t                name= \"pkg\"\n   193\t                def set_version(self):\n   194\t                    my_buf = StringIO()\n   195\t                    self.run('echo 2.1', stdout=my_buf)\n   196\t                    self.version = my_buf.getvalue().strip()\n   197\t            \"\"\")\n   198\t\n   199\t        workspace = textwrap.dedent(\"\"\"\\\n   200\t            import os\n   201\t            from conan import Workspace\n   202\t\n   203\t            class MyWorkspace(Workspace):\n   204\t                def packages(self):\n   205\t                    conanfile = self.load_conanfile(\"dep1\")\n   206\t                    return {f\"{conanfile.name}/{conanfile.version}\": {\"path\": \"dep1\"}}\n   207\t            \"\"\")\n   208\t\n   209\t        c.save({\"conanws.py\": workspace,\n   210\t                \"dep1/conanfile.py\": conanfile})\n   211\t        c.run(\"workspace info --format=json\")\n   212\t        info = json.loads(c.stdout)\n   213\t        assert info[\"packages\"] == {\"pkg/2.1\": {\"path\": \"dep1\"}}\n   214\t        c.run(\"install --requires=pkg/2.1\")\n   215\t        # it will not fail\n   216\t\n   217\t    def test_error_uppercase(self):\n   218\t        c = TestClient(light=True)\n   219\t        c.save({\"conanws.yml\": \"\",\n   220\t                \"conanfile.py\": GenConanfile(\"Pkg\", \"0.1\")})\n   221\t        c.run(\"workspace add .\", assert_error=True)\n   222\t        assert \"ERROR: Conan packages names 'Pkg/0.1' must be all lowercase\" in c.out\n   223\t        c.save({\"conanfile.py\": GenConanfile()})\n   224\t        c.run(\"workspace add . --name=Pkg --version=0.1\", assert_error=True)\n   225\t        assert \"ERROR: Conan packages names 'Pkg/0.1' must be all lowercase\" in c.out\n   226\t\n   227\t    def test_add_open_error(self):\n   228\t        c = TestClient(light=True)\n   229\t        c.save({\"conanws.yml\": \"\",\n   230\t                \"dep/conanfile.py\": GenConanfile(\"dep\", \"0.1\")})\n   231\t        c.run(\"workspace add dep\")\n   232\t        c.run(\"workspace open dep/0.1\", assert_error=True)\n   233\t        assert \"ERROR: Can't open a dependency that is already an editable: dep/0.1\" in c.out\n   234\t\n   235\t    def test_remove_product(self):\n   236\t        c = TestClient(light=True)\n   237\t        c.save({\"conanws.yml\": \"\",\n   238\t                \"mydeppkg/conanfile.py\": GenConanfile(\"mydeppkg\", \"0.1\")})\n   239\t        c.run(\"workspace add mydeppkg\")\n   240\t        c.run(\"workspace remove mydeppkg\")\n   241\t        c.run(\"workspace info\")\n   242\t        assert \"mydeppkg\" not in c.out\n   243\t\n   244\t    def test_remove_removed_folder(self):\n   245\t        c = TestClient(light=True)\n   246\t        c.save({\"conanws.yml\": \"\",\n   247\t                \"mydeppkg/conanfile.py\": GenConanfile(\"mydeppkg\", \"0.1\")})\n   248\t        c.run(\"workspace add mydeppkg\")\n   249\t        # If we now remove the folder\n   250\t        shutil.rmtree(os.path.join(c.current_folder, \"mydeppkg\"))\n   251\t        # It can still be removed by path, even if the path doesn't exist\n   252\t        c.run(\"workspace remove mydeppkg\")\n   253\t        assert \"Removed from workspace: mydeppkg/0.1\" in c.out\n   254\t        c.run(\"workspace info\")\n   255\t        assert \"mydeppkg\" not in c.out\n   256\t\n   257\t    def test_custom_add_remove(self):\n   258\t        c = TestClient(light=True)\n   259\t\n   260\t        workspace = textwrap.dedent(\"\"\"\\\n   261\t            import os\n   262\t            from conan import Workspace\n   263\t\n   264\t            class MyWorkspace(Workspace):\n   265\t                def name(self):\n   266\t                    return \"myws\"\n   267\t\n   268\t                def add(self, ref, path, *args, **kwargs):\n   269\t                    self.output.info(f\"Adding {ref} at {path}\")\n   270\t                    super().add(ref, path, *args, **kwargs)\n   271\t\n   272\t                def remove(self, path, *args, **kwargs):\n   273\t                    self.output.info(f\"Removing {path}\")\n   274\t                    return super().remove(path, *args, **kwargs)\n   275\t            \"\"\")\n   276\t\n   277\t        c.save({\"conanws.py\": workspace,\n   278\t                \"dep/conanfile.py\": GenConanfile(\"dep\", \"0.1\")})\n   279\t        c.run(\"workspace add dep\")\n   280\t        assert \"myws: Adding dep/0.1\" in c.out\n   281\t        c.run(\"workspace info\")\n   282\t        assert \"dep/0.1\" in c.out\n   283\t        c.run(\"workspace remove dep\")\n   284\t        assert \"myws: Removing\" in c.out\n   285\t        c.run(\"workspace info\")\n   286\t        assert \"dep/0.1\" not in c.out\n   287\t\n   288\t\n   289\tclass TestOpenAdd:\n   290\t    def test_without_git(self):\n   291\t        t = TestClient(default_server_user=True, light=True)\n   292\t        t.save({\"conanfile.py\": GenConanfile(\"pkg\", \"0.1\")})\n   293\t        t.run(\"create .\")\n   294\t        t.run(\"upload * -r=default -c\")\n   295\t\n   296\t        c = TestClient(servers=t.servers, light=True)\n   297\t        c.run(f\"workspace open pkg/0.1\")\n   298\t        assert \"name = 'pkg'\" in c.load(\"pkg/conanfile.py\")\n   299\t\n   300\t        # The add should work the same\n   301\t        c2 = TestClient(servers=t.servers, light=True)\n   302\t        c2.save({\"conanws.yml\": \"\"})\n   303\t        c2.run(f\"workspace add --ref=pkg/0.1\")\n   304\t        assert \"name = 'pkg'\" in c2.load(\"pkg/conanfile.py\")\n   305\t        c2.run(\"workspace info\")\n   306\t        assert \"pkg/0.1\" in c2.out\n   307\t\n   308\t    def test_without_git_export_sources(self):\n   309\t        t = TestClient(default_server_user=True, light=True)\n   310\t        t.save({\"conanfile.py\": GenConanfile(\"pkg\", \"0.1\").with_exports_sources(\"*.txt\"),\n   311\t                \"CMakeLists.txt\": \"mycmake\"})\n   312\t        t.run(\"create .\")\n   313\t        t.run(\"upload * -r=default -c\")\n   314\t\n   315\t        c = TestClient(servers=t.servers)\n   316\t        c.run(\"workspace open pkg/0.1\")\n   317\t        assert \"name = 'pkg'\" in c.load(\"pkg/conanfile.py\")\n   318\t        assert \"mycmake\" in c.load(\"pkg/CMakeLists.txt\")\n   319\t\n   320\t    def test_workspace_git_scm(self):\n   321\t        folder = temp_folder()\n   322\t        conanfile = textwrap.dedent(\"\"\"\n   323\t            from conan import ConanFile\n   324\t            from conan.tools.scm import Git\n   325\t\n   326\t            class Pkg(ConanFile):\n   327\t                name = \"pkg\"\n   328\t                version = \"0.1\"\n   329\t                def export(self):\n   330\t                    git = Git(self)\n   331\t                    git.coordinates_to_conandata()\n   332\t            \"\"\")\n   333\t        url, commit = create_local_git_repo(files={\"conanfile.py\": conanfile}, folder=folder,\n   334\t                                            branch=\"mybranch\")\n   335\t        t1 = TestClient(default_server_user=True, light=True)\n   336\t        t1.run_command('git clone \"file://{}\" .'.format(url))\n   337\t        t1.run(\"create .\")\n   338\t        t1.run(\"upload * -r=default -c\")\n   339\t\n   340\t        c = TestClient(servers=t1.servers, light=True)\n   341\t        c.run(\"workspace open pkg/0.1\")\n   342\t        assert c.load(\"pkg/conanfile.py\") == conanfile\n   343\t\n   344\t        c2 = TestClient(servers=t1.servers, light=True)\n   345\t        c2.save({\"conanws.yml\": \"\"})\n   346\t        c2.run(f\"workspace add --ref=pkg/0.1\")\n   347\t        assert 'name = \"pkg\"' in c2.load(\"pkg/conanfile.py\")\n   348\t        c2.run(\"workspace info\")\n   349\t        assert \"pkg/0.1\" in c2.out\n   350\t\n   351\t    def test_workspace_build_editables(self):\n   352\t        c = TestClient(light=True)\n   353\t        c.save({\"conanws.yml\": \"\"})\n   354\t\n   355\t        c.save({\"pkga/conanfile.py\": GenConanfile(\"pkga\", \"0.1\").with_build_msg(\"BUILD PKGA!\"),\n   356\t                \"pkgb/conanfile.py\": GenConanfile(\"pkgb\", \"0.1\").with_build_msg(\"BUILD PKGB!\")\n   357\t                                                                .with_requires(\"pkga/0.1\")})\n   358\t        c.run(\"workspace add pkga\")\n   359\t        c.run(\"workspace add pkgb\")\n   360\t\n   361\t        c.run(\"install --requires=pkgb/0.1 --build=editable\")\n   362\t        c.assert_listed_binary({\"pkga/0.1\": (\"da39a3ee5e6b4b0d3255bfef95601890afd80709\",\n   363\t                                             \"EditableBuild\"),\n   364\t                                \"pkgb/0.1\": (\"47a5f20ec8fb480e1c5794462089b01a3548fdc5\",\n   365\t                                             \"EditableBuild\")})\n   366\t        assert \"pkga/0.1: WARN: BUILD PKGA!\" in c.out\n   367\t        assert \"pkgb/0.1: WARN: BUILD PKGB!\" in c.out\n   368\t\n   369\t\n   370\tclass TestWorkspaceBuild:\n   371\t\n   372\t    def test_build(self):\n   373\t        c = TestClient(light=True)\n   374\t        c.save({\"conanws.yml\": \"\"})\n   375\t\n   376\t        c.save({\"pkga/conanfile.py\": GenConanfile(\"pkga\", \"0.1\").with_build_msg(\"BUILD PKGA!\"),\n   377\t                \"pkgb/conanfile.py\": GenConanfile(\"pkgb\", \"0.1\").with_build_msg(\"BUILD PKGB!\")\n   378\t               .with_requires(\"pkga/0.1\")})\n   379\t        c.run(\"workspace add pkga\")\n   380\t        c.run(\"workspace add pkgb\")\n   381\t        c.run(\"workspace build\")\n   382\t        c.assert_listed_binary({\"pkga/0.1\": (\"da39a3ee5e6b4b0d3255bfef95601890afd80709\",\n   383\t                                             \"EditableBuild\")})\n   384\t        assert \"conanfile.py (pkga/0.1): WARN: BUILD PKGA!\" in c.out\n   385\t        assert \"conanfile.py (pkgb/0.1): WARN: BUILD PKGB!\" in c.out\n   386\t\n   387\t        # It is also possible to build a specific package by path\n   388\t        # equivalent to ``conan build <path> --build=editable``\n   389\t        # This can be done even if it is not a product\n   390\t        c.run(\"workspace build --pkg=pkgc/*\", assert_error=True)\n   391\t        assert \"ERROR: There are no selected packages defined in the workspace\" in c.out\n   392\t        c.run(\"workspace build --pkg=pkgb/*\")\n   393\t        c.assert_listed_binary({\"pkga/0.1\": (\"da39a3ee5e6b4b0d3255bfef95601890afd80709\",\n   394\t                                             \"EditableBuild\")})\n   395\t        assert \"conanfile.py (pkga/0.1): WARN: BUILD PKGA!\" in c.out\n   396\t        assert \"conanfile.py (pkgb/0.1): WARN: BUILD PKGB!\" in c.out\n   397\t\n   398\t        c.run(\"workspace build --pkg=pkga/*\")\n   399\t        assert \"conanfile.py (pkga/0.1): Calling build()\" in c.out\n   400\t        assert \"conanfile.py (pkga/0.1): WARN: BUILD PKGA!\" in c.out\n   401\t\n   402\t    def test_error_if_no_products(self):\n   403\t        c = TestClient(light=True)\n   404\t        c.save({\"conanws.yml\": \"\"})\n   405\t        c.run(\"workspace build\", assert_error=True)\n   406\t        assert \"ERROR: There are no selected packages defined in the workspace\" in c.out\n   407\t\n   408\t    def test_build_external_missing(self):\n   409\t        c = TestClient(light=True)\n   410\t        c.save({\"conanws.yml\": \"\"})\n   411\t\n   412\t        c.save({\"mymath/conanfile.py\": GenConanfile(\"mymath\", \"0.1\").with_build_msg(\"MyMATH!!\"),\n   413\t                \"pkga/conanfile.py\": GenConanfile(\"pkga\", \"0.1\").with_build_msg(\"BUILD PKGA!\")\n   414\t                                                                .with_requires(\"mymath/0.1\"),\n   415\t                \"pkgb/conanfile.py\": GenConanfile(\"pkgb\", \"0.1\").with_build_msg(\"BUILD PKGB!\")\n   416\t               .with_requires(\"pkga/0.1\")})\n   417\t        c.run(\"export mymath\")\n   418\t        c.run(\"workspace add pkga\")\n   419\t        c.run(\"workspace add pkgb\")\n   420\t        c.run(\"workspace build\", assert_error=True)\n   421\t        assert \"ERROR: Missing prebuilt package for 'mymath/0.1'\" in c.out\n   422\t        c.run(\"workspace build --build=missing\")\n   423\t        assert \"Workspace building external mymath/0.1\" in c.out\n   424\t\n   425\t    def test_build_dynamic_name_version(self):\n   426\t        conanfile = textwrap.dedent(\"\"\"\\\n   427\t            from conan import ConanFile\n   428\t            class MyConan(ConanFile):\n   429\t                def build(self):\n   430\t                    self.output.info(f\"Building {self.name} AND {self.version}!!!\")\n   431\t            \"\"\")\n   432\t        workspace = textwrap.dedent(\"\"\"\\\n   433\t            import os\n   434\t            from conan import Workspace\n   435\t\n   436\t            class MyWorkspace(Workspace):\n   437\t                def packages(self):\n   438\t                    result = {}\n   439\t                    for f in os.listdir(self.folder):\n   440\t                        if os.path.isdir(os.path.join(self.folder, f)):\n   441\t                            result[f\"{f}/0.1\"] = {\"path\": f}\n   442\t                    return result\n   443\t           \"\"\")\n   444\t        c = TestClient(light=True)\n   445\t        c.save({\"conanws.py\": workspace,\n   446\t                \"pkga/conanfile.py\": conanfile})\n   447\t        c.run(\"workspace info\")\n   448\t        assert \"pkga/0.1\" in c.out\n   449\t        c.run(\"workspace build\")\n   450\t        assert \"conanfile.py (pkga/0.1): Building pkga AND 0.1!!!\" in c.out\n   451\t\n   452\t\n   453\tclass TestNew:\n   454\t    def test_new(self):\n   455\t        # Very basic workspace for testing\n   456\t        c = TestClient(light=True)\n   457\t        c.run(\"new workspace\")\n   458\t        assert 'name = \"liba\"' in c.load(\"liba/conanfile.py\")\n   459\t        c.run(\"workspace info\")\n   460\t        assert \"liba/0.1\" in c.out\n","exit_code":0,"status":"completed"}}
