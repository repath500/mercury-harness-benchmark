{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"nl -ba conan/api/subapi/workspace.py | sed -n 1,330p; printf '\\\\n--- CLI ---\\\\n'; nl -ba conan/cli/commands/workspace.py | sed -n 1,150p; printf '\\\\n--- tests relevant ---\\\\n'; sed -n 1,260p test/integration/workspace/test_workspace.py\"","aggregated_output":"     1\timport inspect\n     2\timport os\n     3\timport shutil\n     4\timport textwrap\n     5\tfrom pathlib import Path\n     6\t\n     7\tfrom conan import ConanFile\n     8\tfrom conan.api.model import RecipeReference\n     9\tfrom conan.api.output import ConanOutput\n    10\tfrom conan.cli import make_abs_path\n    11\tfrom conan.cli.printers.graph import print_graph_basic, print_graph_packages\n    12\tfrom conan.errors import ConanException\n    13\tfrom conan.internal.conan_app import ConanApp\n    14\tfrom conan.internal.graph.install_graph import ProfileArgs\n    15\tfrom conan.internal.model.workspace import Workspace, WORKSPACE_YML, WORKSPACE_PY, WORKSPACE_FOLDER\n    16\tfrom conan.tools.scm import Git\n    17\tfrom conan.internal.graph.graph import RECIPE_EDITABLE, DepsGraph, CONTEXT_HOST, RECIPE_VIRTUAL, Node, \\\n    18\t    RECIPE_CONSUMER\n    19\tfrom conan.internal.graph.graph import TransitiveRequirement\n    20\tfrom conan.internal.graph.profile_node_definer import consumer_definer\n    21\tfrom conan.internal.loader import load_python_file\n    22\tfrom conan.internal.source import retrieve_exports_sources\n    23\tfrom conan.internal.util.files import merge_directories, save\n    24\t\n    25\t\n    26\tdef _find_ws_folder():\n    27\t    path = Path(os.getcwd())\n    28\t    while path.is_dir() and len(path.parts) > 1:  # finish at '/' or 'conanws/'\n    29\t        if path.name == WORKSPACE_FOLDER:\n    30\t            if (path / WORKSPACE_YML).is_file() or (path / WORKSPACE_PY).is_file():\n    31\t                return str(path)\n    32\t        if (path / WORKSPACE_YML).is_file() or (path / WORKSPACE_PY).is_file():\n    33\t            return str(path)\n    34\t        else:\n    35\t            path = path.parent\n    36\t\n    37\t\n    38\tdef _load_workspace(ws_folder, conan_api):\n    39\t    \"\"\" loads a conanfile basic object without evaluating anything, returns the module too\n    40\t    \"\"\"\n    41\t    wspy = os.path.join(ws_folder, WORKSPACE_PY)\n    42\t    if not os.path.isfile(wspy):\n    43\t        ConanOutput().info(f\"{WORKSPACE_PY} doesn't exist in {ws_folder}, using default behavior\")\n    44\t        assert os.path.exists(os.path.join(ws_folder, WORKSPACE_YML))\n    45\t        ws = Workspace(ws_folder, conan_api)\n    46\t    else:\n    47\t        try:\n    48\t            module, module_id = load_python_file(wspy)\n    49\t            ws = _parse_module(module, module_id)\n    50\t            ws = ws(ws_folder, conan_api)\n    51\t        except ConanException as e:\n    52\t            raise ConanException(f\"Error loading {WORKSPACE_PY} at '{wspy}': {e}\")\n    53\t    return ws\n    54\t\n    55\t\n    56\tdef _parse_module(conanfile_module, module_id):\n    57\t    result = None\n    58\t    for name, attr in conanfile_module.__dict__.items():\n    59\t        if (name.startswith(\"_\") or not inspect.isclass(attr) or\n    60\t                attr.__dict__.get(\"__module__\") != module_id):\n    61\t            continue\n    62\t\n    63\t        if issubclass(attr, Workspace) and attr != Workspace:\n    64\t            if result is None:\n    65\t                result = attr\n    66\t            else:\n    67\t                raise ConanException(\"More than 1 Workspace in the file\")\n    68\t\n    69\t    if result is None:\n    70\t        raise ConanException(\"No subclass of Workspace\")\n    71\t\n    72\t    return result\n    73\t\n    74\t\n    75\tclass WorkspaceAPI:\n    76\t    TEST_ENABLED = False\n    77\t\n    78\t    def __init__(self, conan_api):\n    79\t        self._enabled = True\n    80\t        self._conan_api = conan_api\n    81\t        self._folder = _find_ws_folder()\n    82\t        if self._folder:\n    83\t            ConanOutput().warning(f\"Workspace found: {self._folder}\")\n    84\t            if (WorkspaceAPI.TEST_ENABLED or os.getenv(\"CONAN_WORKSPACE_ENABLE\")) != \"will_break_next\":\n    85\t                ConanOutput().warning(\"Workspace ignored as CONAN_WORKSPACE_ENABLE is not set\")\n    86\t                self._folder = None\n    87\t            else:\n    88\t                ConanOutput().warning(f\"Workspace is a dev-only feature, exclusively for testing\")\n    89\t                self._ws = _load_workspace(self._folder, conan_api)  # Error if not loading\n    90\t\n    91\t    def enable(self, value):\n    92\t        self._enabled = value\n    93\t\n    94\t    @property\n    95\t    def name(self):\n    96\t        self._check_ws()\n    97\t        return self._ws.name()\n    98\t\n    99\t    def folder(self):\n   100\t        \"\"\"\n   101\t        @return: the current workspace folder where the conanws.yml or conanws.py is located\n   102\t        \"\"\"\n   103\t        self._check_ws()\n   104\t        return self._folder\n   105\t\n   106\t    def packages(self):\n   107\t        \"\"\"\n   108\t        @return: Returns {RecipeReference: {\"path\": full abs-path, \"output_folder\": abs-path}}\n   109\t        \"\"\"\n   110\t        if not self._folder or not self._enabled:\n   111\t            return\n   112\t        editables = self._ws.packages()\n   113\t        editables = {RecipeReference.loads(r): v.copy() for r, v in editables.items()}\n   114\t        for v in editables.values():\n   115\t            path = os.path.normpath(os.path.join(self._folder, v[\"path\"], \"conanfile.py\"))\n   116\t            if not os.path.isfile(path):\n   117\t                raise ConanException(f\"Workspace editable not found: {path}\")\n   118\t            v[\"path\"] = path\n   119\t            if v.get(\"output_folder\"):\n   120\t                v[\"output_folder\"] = os.path.normpath(os.path.join(self._folder,\n   121\t                                                                   v[\"output_folder\"]))\n   122\t        return editables\n   123\t\n   124\t    def open(self, require, remotes, cwd=None):\n   125\t        app = ConanApp(self._conan_api)\n   126\t        ref = RecipeReference.loads(require)\n   127\t        recipe = app.proxy.get_recipe(ref, remotes, update=False, check_update=False)\n   128\t\n   129\t        layout, recipe_status, remote = recipe\n   130\t        if recipe_status == RECIPE_EDITABLE:\n   131\t            raise ConanException(f\"Can't open a dependency that is already an editable: {ref}\")\n   132\t        ref = layout.reference\n   133\t        conanfile_path = layout.conanfile()\n   134\t        conanfile, module = app.loader.load_basic_module(conanfile_path, remotes=remotes)\n   135\t\n   136\t        scm = conanfile.conan_data.get(\"scm\") if conanfile.conan_data else None\n   137\t        dst_path = os.path.join(cwd or os.getcwd(), ref.name)\n   138\t        if scm is None:\n   139\t            conanfile.output.warning(\"conandata doesn't contain 'scm' information\\n\"\n   140\t                                     \"doing a local copy!!!\")\n   141\t            shutil.copytree(layout.export(), dst_path)\n   142\t            retrieve_exports_sources(app.remote_manager, layout, conanfile, ref, remotes)\n   143\t            export_sources = layout.export_sources()\n   144\t            if os.path.exists(export_sources):\n   145\t                conanfile.output.warning(\"There are export-sources, copying them, but the location\"\n   146\t                                         \" might be incorrect, use 'scm' approach\")\n   147\t                merge_directories(export_sources, dst_path)\n   148\t        else:\n   149\t            git = Git(conanfile, folder=cwd)\n   150\t            git.clone(url=scm[\"url\"], target=ref.name)\n   151\t            git.folder = ref.name  # change to the cloned folder\n   152\t            git.checkout(commit=scm[\"commit\"])\n   153\t        return dst_path\n   154\t\n   155\t    def _check_ws(self):\n   156\t        if not self._folder:\n   157\t            raise ConanException(f\"Workspace not defined, please create a \"\n   158\t                                 f\"'{WORKSPACE_PY}' or '{WORKSPACE_YML}' file\")\n   159\t\n   160\t    def add(self, path, name=None, version=None, user=None, channel=None, cwd=None,\n   161\t            output_folder=None, remotes=None):\n   162\t        \"\"\"\n   163\t        Add a new editable package to the current workspace (the current workspace must exist)\n   164\t        @param path: The path to the folder containing the conanfile.py that defines the package\n   165\t        @param name: (optional) The name of the package to be added if not defined in recipe\n   166\t        @param version:\n   167\t        @param user:\n   168\t        @param channel:\n   169\t        @param cwd:\n   170\t        @param output_folder:\n   171\t        @param remotes:\n   172\t        @return: The reference of the added package\n   173\t        \"\"\"\n   174\t        self._check_ws()\n   175\t        full_path = self._conan_api.local.get_conanfile_path(path, cwd, py=True)\n   176\t        app = ConanApp(self._conan_api)\n   177\t        conanfile = app.loader.load_named(full_path, name, version, user, channel, remotes=remotes)\n   178\t        if conanfile.name is None or conanfile.version is None:\n   179\t            raise ConanException(\"Editable package recipe should declare its name and version\")\n   180\t        ref = RecipeReference(conanfile.name, conanfile.version, conanfile.user, conanfile.channel)\n   181\t        ref.validate_ref()\n   182\t        output_folder = make_abs_path(output_folder) if output_folder else None\n   183\t        # Check the conanfile is there, and name/version matches\n   184\t        self._ws.add(ref, full_path, output_folder)\n   185\t        return ref\n   186\t\n   187\t    @staticmethod\n   188\t    def init(path):\n   189\t        abs_path = make_abs_path(path)\n   190\t        os.makedirs(abs_path, exist_ok=True)\n   191\t        ws_yml_file = Path(abs_path, WORKSPACE_YML)\n   192\t        ws_py_file = Path(abs_path, WORKSPACE_PY)\n   193\t        if not ws_yml_file.exists():\n   194\t            ConanOutput().success(f\"Created empty {WORKSPACE_YML} in {path}\")\n   195\t            save(ws_yml_file, \"\")\n   196\t        if not ws_py_file.exists():\n   197\t            ConanOutput().success(f\"Created minimal {WORKSPACE_PY} in {path}\")\n   198\t            ws_name = os.path.basename(abs_path)\n   199\t            save(ws_py_file, textwrap.dedent(f'''\\\n   200\t            from conan import Workspace\n   201\t\n   202\t            class MyWorkspace(Workspace):\n   203\t               \"\"\"\n   204\t               Minimal Workspace class definition.\n   205\t               More info: https://docs.conan.io/2/incubating.html#workspaces\n   206\t               \"\"\"\n   207\t               def name(self):\n   208\t                  return \"{ws_name}\"\n   209\t            '''))\n   210\t\n   211\t    def remove(self, path):\n   212\t        self._check_ws()\n   213\t        return self._ws.remove(path)\n   214\t\n   215\t    def clean(self):\n   216\t        self._check_ws()\n   217\t        return self._ws.clean()\n   218\t\n   219\t    def info(self):\n   220\t        self._check_ws()\n   221\t        return {\"name\": self.name,\n   222\t                \"folder\": self._folder,\n   223\t                \"packages\": self._ws.packages()}\n   224\t\n   225\t    def super_build_graph(self, deps_graph, profile_host, profile_build):\n   226\t        ConanOutput().title(\"Collapsing workspace packages\")\n   227\t\n   228\t        root_class = self._ws.root_conanfile()\n   229\t        if root_class is not None:\n   230\t            conanfile = root_class(f\"{WORKSPACE_PY} base project Conanfile\")\n   231\t            consumer_definer(conanfile, profile_host, profile_build)\n   232\t            root = Node(None, conanfile, context=CONTEXT_HOST, recipe=RECIPE_CONSUMER,\n   233\t                        path=self._folder)  # path lets use the conanws.py folder\n   234\t            root.should_build = True  # It is a consumer, this is something we are building\n   235\t            for field in (\"requires\", \"build_requires\", \"test_requires\", \"requirements\", \"build\",\n   236\t                          \"source\", \"package\"):\n   237\t                if getattr(conanfile, field, None):\n   238\t                    raise ConanException(f\"Conanfile in conanws.py shouldn't have '{field}'\")\n   239\t        else:\n   240\t            ConanOutput().info(f\"Workspace {WORKSPACE_PY} not found in the workspace folder, \"\n   241\t                               \"using default behavior\")\n   242\t            conanfile = ConanFile(display_name=\"cli\")\n   243\t            consumer_definer(conanfile, profile_host, profile_build)\n   244\t            root = Node(ref=None, conanfile=conanfile, context=CONTEXT_HOST, recipe=RECIPE_VIRTUAL)\n   245\t\n   246\t        result = DepsGraph()  # TODO: We might need to copy more information from the original graph\n   247\t        result.add_node(root)\n   248\t        for node in deps_graph.nodes[1:]:  # Exclude the current root\n   249\t            if node.recipe != RECIPE_EDITABLE:\n   250\t                result.add_node(node)\n   251\t                continue\n   252\t            for r, t in node.transitive_deps.items():\n   253\t                if t.node.recipe == RECIPE_EDITABLE:\n   254\t                    continue\n   255\t                existing = root.transitive_deps.pop(r, None)\n   256\t                if existing is None:\n   257\t                    root.transitive_deps[r] = t\n   258\t                else:\n   259\t                    require = existing.require\n   260\t                    require.aggregate(r)\n   261\t                    root.transitive_deps[require] = TransitiveRequirement(require, t.node)\n   262\t\n   263\t        # The graph edges must be defined too\n   264\t        for r, t in root.transitive_deps.items():\n   265\t            result.add_edge(root, t.node, r)\n   266\t\n   267\t        return result\n   268\t\n   269\t    def export(self, lockfile=None, remotes=None):\n   270\t        self._check_ws()\n   271\t        exported = []\n   272\t        for ref, info in self.packages().items():\n   273\t            exported_ref = self._conan_api.export.export(info[\"path\"], ref.name, str(ref.version),\n   274\t                                                         ref.user, ref.channel,\n   275\t                                                         lockfile=lockfile, remotes=remotes)\n   276\t            ref, _ = exported_ref\n   277\t            exported.append(ref)\n   278\t        return exported\n   279\t\n   280\t\n   281\t    def select_packages(self, packages):\n   282\t        self._check_ws()\n   283\t        editable = self.packages()\n   284\t        packages = packages or []\n   285\t        selected_editables = {}\n   286\t        for ref, info in editable.items():\n   287\t            if packages and not any(ref.matches(p, False) for p in packages):\n   288\t                continue\n   289\t            selected_editables[ref] = info\n   290\t        if not selected_editables:\n   291\t            raise ConanException(\"There are no selected packages defined in the workspace\")\n   292\t\n   293\t        return selected_editables\n   294\t\n   295\t    def build_order(self, packages, profile_host, profile_build, build_mode, lockfile, remotes,\n   296\t                    profile_args, update=False):\n   297\t        ConanOutput().title(f\"Computing dependency graph for each package\")\n   298\t        conan_api = self._conan_api\n   299\t        from conan.internal.graph.install_graph import InstallGraph\n   300\t        install_order = InstallGraph(None)\n   301\t\n   302\t        for ref, info in packages.items():\n   303\t            ConanOutput().title(f\"Computing the dependency graph for package: {ref}\")\n   304\t\n   305\t            deps_graph = conan_api.graph.load_graph_requires([ref], None,\n   306\t                                                             profile_host, profile_build, lockfile,\n   307\t                                                             remotes, update)\n   308\t            deps_graph.report_graph_error()\n   309\t            print_graph_basic(deps_graph)\n   310\t            conan_api.graph.analyze_binaries(deps_graph, build_mode, remotes=remotes, update=update,\n   311\t                                             lockfile=lockfile)\n   312\t            print_graph_packages(deps_graph)\n   313\t\n   314\t            ConanOutput().success(f\"\\nAggregating build-order for package: {ref}\")\n   315\t            install_graph = InstallGraph(deps_graph, order_by=\"recipe\",\n   316\t                                         profile_args=ProfileArgs.from_args(profile_args))\n   317\t            install_graph.raise_errors()\n   318\t            install_order.merge(install_graph)\n   319\t\n   320\t        return install_order\n\n--- CLI ---\n     1\timport json\n     2\timport os\n     3\t\n     4\tfrom conan.api.conan_api import ConanAPI\n     5\tfrom conan.api.model import RecipeReference\n     6\tfrom conan.api.output import ConanOutput, cli_out_write\n     7\tfrom conan.api.subapi.workspace import WorkspaceAPI\n     8\tfrom conan.cli import make_abs_path\n     9\tfrom conan.cli.args import add_reference_args, add_common_install_arguments, add_lockfile_args\n    10\tfrom conan.cli.command import conan_command, conan_subcommand\n    11\tfrom conan.cli.commands.list import print_serial\n    12\tfrom conan.cli.printers import print_profiles\n    13\tfrom conan.cli.printers.graph import print_graph_packages, print_graph_basic\n    14\tfrom conan.errors import ConanException\n    15\tfrom conan.internal.graph.install_graph import ProfileArgs\n    16\t\n    17\t\n    18\t@conan_subcommand(formatters={\"text\": cli_out_write})\n    19\tdef workspace_root(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n    20\t    \"\"\"\n    21\t    Return the folder containing the conanws.py/conanws.yml workspace file\n    22\t    \"\"\"\n    23\t    parser.parse_args(*args)\n    24\t    ws = conan_api.workspace\n    25\t    return ws.folder()\n    26\t\n    27\t\n    28\t@conan_subcommand()\n    29\tdef workspace_open(conan_api: ConanAPI, parser, subparser, *args):\n    30\t    \"\"\"\n    31\t    Open specific references\n    32\t    \"\"\"\n    33\t    subparser.add_argument(\"reference\",\n    34\t                           help=\"Open this package source repository\")\n    35\t    group = subparser.add_mutually_exclusive_group()\n    36\t    group.add_argument(\"-r\", \"--remote\", action=\"append\", default=None,\n    37\t                       help='Look in the specified remote or remotes server')\n    38\t    group.add_argument(\"-nr\", \"--no-remote\", action=\"store_true\",\n    39\t                       help='Do not use remote, resolve exclusively in the cache')\n    40\t    args = parser.parse_args(*args)\n    41\t    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n    42\t    cwd = os.getcwd()\n    43\t    conan_api.workspace.open(args.reference, remotes=remotes, cwd=cwd)\n    44\t\n    45\t\n    46\t@conan_subcommand()\n    47\tdef workspace_add(conan_api: ConanAPI, parser, subparser, *args):\n    48\t    \"\"\"\n    49\t    Add packages to current workspace\n    50\t    \"\"\"\n    51\t    subparser.add_argument('path',  nargs=\"?\",\n    52\t                           help='Path to the package folder in the user workspace')\n    53\t    add_reference_args(subparser)\n    54\t    subparser.add_argument(\"--ref\", help=\"Open and add this reference\")\n    55\t    subparser.add_argument(\"-of\", \"--output-folder\",\n    56\t                           help='The root output folder for generated and build files')\n    57\t    group = subparser.add_mutually_exclusive_group()\n    58\t    group.add_argument(\"-r\", \"--remote\", action=\"append\", default=None,\n    59\t                       help='Look in the specified remote or remotes server')\n    60\t    group.add_argument(\"-nr\", \"--no-remote\", action=\"store_true\",\n    61\t                       help='Do not use remote, resolve exclusively in the cache')\n    62\t    args = parser.parse_args(*args)\n    63\t    if args.path and args.ref:\n    64\t        raise ConanException(\"Do not use both 'path' and '--ref' argument\")\n    65\t    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n    66\t    cwd = os.getcwd()\n    67\t    path = args.path\n    68\t    if args.ref:\n    69\t        # TODO: Use path here to open in this path\n    70\t        path = conan_api.workspace.open(args.ref, remotes, cwd=cwd)\n    71\t    ref = conan_api.workspace.add(path,\n    72\t                                  args.name, args.version, args.user, args.channel,\n    73\t                                  cwd, args.output_folder, remotes=remotes)\n    74\t    ConanOutput().success(\"Reference '{}' added to workspace\".format(ref))\n    75\t\n    76\t\n    77\t@conan_subcommand()\n    78\tdef workspace_remove(conan_api: ConanAPI, parser, subparser, *args):\n    79\t    \"\"\"\n    80\t    Remove packages from the current workspace\n    81\t    \"\"\"\n    82\t    subparser.add_argument('path',\n    83\t                           help='Path to the package folder in the user workspace')\n    84\t    args = parser.parse_args(*args)\n    85\t    removed = conan_api.workspace.remove(make_abs_path(args.path))\n    86\t    ConanOutput().info(f\"Removed from workspace: {removed}\")\n    87\t\n    88\t\n    89\tdef print_json(data):\n    90\t    results = data[\"info\"]\n    91\t    myjson = json.dumps(results, indent=4)\n    92\t    cli_out_write(myjson)\n    93\t\n    94\t\n    95\tdef _print_workspace_info(data):\n    96\t    print_serial(data[\"info\"])\n    97\t\n    98\t\n    99\t@conan_subcommand(formatters={\"text\": _print_workspace_info, \"json\": print_json})\n   100\tdef workspace_info(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n   101\t    \"\"\"\n   102\t    Display info for current workspace\n   103\t    \"\"\"\n   104\t    parser.parse_args(*args)\n   105\t    return {\"info\": conan_api.workspace.info()}\n   106\t\n   107\t\n   108\t@conan_subcommand()\n   109\tdef workspace_build(conan_api: ConanAPI, parser, subparser, *args):\n   110\t    \"\"\"\n   111\t    Call \"conan build\" for packages in the workspace, in the right order\n   112\t    \"\"\"\n   113\t    _install_build(conan_api, parser, subparser, True, *args)\n   114\t\n   115\t\n   116\t@conan_subcommand()\n   117\tdef workspace_install(conan_api: ConanAPI, parser, subparser, *args):\n   118\t    \"\"\"\n   119\t    Call \"conan install\" for packages in the workspace, in the right order\n   120\t    \"\"\"\n   121\t    _install_build(conan_api, parser, subparser, False, *args)\n   122\t\n   123\t\n   124\tdef _install_build(conan_api: ConanAPI, parser, subparser, build, *args):\n   125\t    subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n   126\t    add_common_install_arguments(subparser)\n   127\t    add_lockfile_args(subparser)\n   128\t    args = parser.parse_args(*args)\n   129\t    # Basic collaborators: remotes, lockfile, profiles\n   130\t    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n   131\t    overrides = eval(args.lockfile_overrides) if args.lockfile_overrides else None\n   132\t    # The lockfile by default if not defined will be read from the root workspace folder\n   133\t    ws_folder = conan_api.workspace.folder()\n   134\t    lockfile = conan_api.lockfile.get_lockfile(lockfile=args.lockfile, conanfile_path=ws_folder,\n   135\t                                               cwd=None, partial=args.lockfile_partial,\n   136\t                                               overrides=overrides)\n   137\t    profile_host, profile_build = conan_api.profiles.get_profiles_from_args(args)\n   138\t    print_profiles(profile_host, profile_build)\n   139\t\n   140\t    buildmode = args.build\n   141\t    if build and (not buildmode or \"editable\" not in buildmode):\n   142\t        ConanOutput().info(\"Adding '--build=editable' as build mode\")\n   143\t        buildmode = buildmode or []\n   144\t        buildmode.append(\"editable\")\n   145\t\n   146\t    all_editables = conan_api.workspace.packages()\n   147\t    packages = conan_api.workspace.select_packages(args.pkg)\n   148\t    ConanOutput().box(\"Workspace computing the build order\")\n   149\t    install_order = conan_api.workspace.build_order(packages, profile_host, profile_build, buildmode,\n   150\t                                                    lockfile, remotes, args, update=args.update)\n\n--- tests relevant ---\nimport json\nimport os\nimport shutil\nimport textwrap\n\nimport pytest\n\nfrom conan.api.subapi.workspace import WorkspaceAPI\nfrom conan.test.assets.genconanfile import GenConanfile\nfrom conan.test.utils.scm import create_local_git_repo\nfrom conan.test.utils.test_files import temp_folder\nfrom conan.test.utils.tools import TestClient\nfrom conan.internal.util.files import save_files\n\nWorkspaceAPI.TEST_ENABLED = \"will_break_next\"\n\n\nclass TestWorkspaceRoot:\n\n    def test_workspace_root(self):\n        c = TestClient(light=True)\n        # Just check the root command works\n        c.run(\"workspace root\", assert_error=True)\n        assert \"ERROR: Workspace not defined, please create\" in c.out\n\n        # error, conanws/ folder does not contain conanws.[py | yml]\n        c.save({\"conanws/test.txt\": \"\"})\n        with c.chdir(\"conanws\"):\n            c.run(\"workspace root\", assert_error=True)\n            assert \"ERROR: Workspace not defined, please create\" in c.out\n            c.save({\"conanws.yml\": \"\"})\n            c.run(\"workspace root\")\n            assert c.current_folder in c.stdout\n\n        # error, empty .py\n        c.save({\"conanws.py\": \"\"}, clean_first=True)\n        c.run(\"workspace root\", assert_error=True)\n        assert \"Error loading conanws.py\" in c.out\n        assert \"No subclass of Workspace\" in c.out\n\n        c.save({\"conanws.yml\": \"\"}, clean_first=True)\n        c.run(\"workspace root\")\n        assert c.current_folder in c.stdout\n\n\nclass TestAddRemove:\n\n    def test_add(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\",\n                \"dep1/conanfile.py\": GenConanfile(\"dep1\", \"0.1\"),\n                \"dep2/conanfile.py\": GenConanfile(\"dep2\", \"0.1\"),\n                \"dep3/conanfile.py\": GenConanfile(\"dep3\", \"0.1\")})\n        c.run(\"workspace add dep1\")\n        assert \"Reference 'dep1/0.1' added to workspace\" in c.out\n        c.run(\"workspace info\")\n        assert \"dep1/0.1\" in c.out\n        assert \"dep2\" not in c.out\n        c.run(\"editable list\")  # No editables in global\n        assert \"dep1\" not in c.out\n        assert \"dep2\" not in c.out\n        c.run(\"workspace add dep2\")\n        assert \"Reference 'dep2/0.1' added to workspace\" in c.out\n        c.run(\"workspace info\")\n        assert \"dep1/0.1\" in c.out\n        assert \"dep2/0.1\" in c.out\n\n        with c.chdir(temp_folder()):  # If we move to another folder, outside WS, no editables\n            c.run(\"editable list\")\n            assert \"dep1\" not in c.out\n            assert \"dep2\" not in c.out\n\n        c.run(\"workspace info\")\n        assert \"dep1/0.1\" in c.out\n        assert \"dep2/0.1\" in c.out\n\n        c.run(\"workspace remove dep1\")\n        c.run(\"workspace info\")\n        assert \"dep1/0.1\" not in c.out\n        assert \"dep2/0.1\" in c.out\n\n        c.run(\"workspace remove dep2\")\n        c.run(\"workspace info\")\n        assert \"dep1/0.1\" not in c.out\n        assert \"dep2/0.1\" not in c.out\n\n    def test_add_from_outside(self):\n        c = TestClient(light=True)\n        c.save({\"sub/conanws.yml\": \"\",\n                \"sub/dep1/conanfile.py\": GenConanfile(\"dep1\", \"0.1\"),\n                \"sub/dep2/conanfile.py\": GenConanfile(\"dep2\", \"0.1\")})\n        with c.chdir(\"sub\"):\n            c.run(\"workspace add dep1\")\n            assert \"Reference 'dep1/0.1' added to workspace\" in c.out\n            c.run(\"workspace add dep2\")\n            assert \"Reference 'dep2/0.1' added to workspace\" in c.out\n            c.run(\"workspace info\")\n            assert \"dep1/0.1\" in c.out\n            assert \"dep2/0.1\" in c.out\n        assert c.load_home(\"editable_packages.json\") is None\n\n        c.run(\"editable list\")\n        assert \"dep1\" not in c.out\n        assert \"dep2\" not in c.out\n        assert c.load_home(\"editable_packages.json\") is None\n        with c.chdir(\"sub\"):\n            c.run(\"editable add dep1\")\n            assert c.load_home(\"editable_packages.json\") is not None\n            c.run(\"editable list\")\n            assert \"dep1/0.1\" in c.out\n            assert \"dep2/0.1\" not in c.out\n            c.run(\"workspace info\")\n            assert \"dep1\" in c.out\n            assert \"dep2\" in c.out\n\n        c.run(\"editable list\")\n        assert \"dep1/0.1\" in c.out\n        assert \"dep2\" not in c.out\n\n    @pytest.mark.parametrize(\"api\", [False, True])\n    def test_dynamic_editables(self, api):\n        c = TestClient(light=True)\n        conanfile = textwrap.dedent(\"\"\"\n            import os\n            from conan import ConanFile\n            from conan.tools.files import load\n            class Lib(ConanFile):\n                def set_name(self):\n                    self.name = load(self, os.path.join(self.recipe_folder, \"name.txt\"))\n                def set_version(self):\n                    self.version = load(self, os.path.join(self.recipe_folder, \"version.txt\"))\n            \"\"\")\n        if not api:\n            workspace = textwrap.dedent(\"\"\"\\\n                import os\n                from conan import Workspace\n\n                class MyWorkspace(Workspace):\n                    def packages(self):\n                        result = {}\n                        for f in os.listdir(self.folder):\n                            if os.path.isdir(os.path.join(self.folder, f)):\n                                full_path = os.path.join(self.folder, f, \"name.txt\")\n                                name = open(full_path).read().strip()\n                                version = open(os.path.join(self.folder, f,\n                                                            \"version.txt\")).read().strip()\n                                result[f\"{name}/{version}\"] = {\"path\": f}\n                        return result\n                \"\"\")\n        else:\n            workspace = textwrap.dedent(\"\"\"\\\n                import os\n                from conan import Workspace\n\n                class MyWorkspace(Workspace):\n                    def packages(self):\n                        result = {}\n                        for f in os.listdir(self.folder):\n                            if os.path.isdir(os.path.join(self.folder, f)):\n                                conanfile = self.load_conanfile(f)\n                                result[f\"{conanfile.name}/{conanfile.version}\"] = {\"path\": f}\n                        return result\n               \"\"\")\n\n        c.save({\"conanws.py\": workspace,\n                \"dep1/conanfile.py\": conanfile,\n                \"dep1/name.txt\": \"pkg\",\n                \"dep1/version.txt\": \"2.1\"})\n        c.run(\"workspace info --format=json\")\n        info = json.loads(c.stdout)\n        assert info[\"packages\"] == {\"pkg/2.1\": {\"path\": \"dep1\"}}\n        c.save({\"dep1/name.txt\": \"other\",\n                \"dep1/version.txt\": \"14.5\"})\n        c.run(\"workspace info --format=json\")\n        info = json.loads(c.stdout)\n        assert info[\"packages\"] == {\"other/14.5\": {\"path\": \"dep1\"}}\n        c.run(\"install --requires=other/14.5\")\n        # Doesn't fail\n        assert \"other/14.5 - Editable\" in c.out\n        with c.chdir(\"dep1\"):\n            c.run(\"install --requires=other/14.5\")\n            # Doesn't fail\n            assert \"other/14.5 - Editable\" in c.out\n\n    def test_api_dynamic_version_run(self):\n        # https://github.com/conan-io/conan/issues/17306\n        c = TestClient(light=True)\n        conanfile = textwrap.dedent(\"\"\"\n            from io import StringIO\n            from conan import ConanFile\n            class Lib(ConanFile):\n                name= \"pkg\"\n                def set_version(self):\n                    my_buf = StringIO()\n                    self.run('echo 2.1', stdout=my_buf)\n                    self.version = my_buf.getvalue().strip()\n            \"\"\")\n\n        workspace = textwrap.dedent(\"\"\"\\\n            import os\n            from conan import Workspace\n\n            class MyWorkspace(Workspace):\n                def packages(self):\n                    conanfile = self.load_conanfile(\"dep1\")\n                    return {f\"{conanfile.name}/{conanfile.version}\": {\"path\": \"dep1\"}}\n            \"\"\")\n\n        c.save({\"conanws.py\": workspace,\n                \"dep1/conanfile.py\": conanfile})\n        c.run(\"workspace info --format=json\")\n        info = json.loads(c.stdout)\n        assert info[\"packages\"] == {\"pkg/2.1\": {\"path\": \"dep1\"}}\n        c.run(\"install --requires=pkg/2.1\")\n        # it will not fail\n\n    def test_error_uppercase(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\",\n                \"conanfile.py\": GenConanfile(\"Pkg\", \"0.1\")})\n        c.run(\"workspace add .\", assert_error=True)\n        assert \"ERROR: Conan packages names 'Pkg/0.1' must be all lowercase\" in c.out\n        c.save({\"conanfile.py\": GenConanfile()})\n        c.run(\"workspace add . --name=Pkg --version=0.1\", assert_error=True)\n        assert \"ERROR: Conan packages names 'Pkg/0.1' must be all lowercase\" in c.out\n\n    def test_add_open_error(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\",\n                \"dep/conanfile.py\": GenConanfile(\"dep\", \"0.1\")})\n        c.run(\"workspace add dep\")\n        c.run(\"workspace open dep/0.1\", assert_error=True)\n        assert \"ERROR: Can't open a dependency that is already an editable: dep/0.1\" in c.out\n\n    def test_remove_product(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\",\n                \"mydeppkg/conanfile.py\": GenConanfile(\"mydeppkg\", \"0.1\")})\n        c.run(\"workspace add mydeppkg\")\n        c.run(\"workspace remove mydeppkg\")\n        c.run(\"workspace info\")\n        assert \"mydeppkg\" not in c.out\n\n    def test_remove_removed_folder(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\",\n                \"mydeppkg/conanfile.py\": GenConanfile(\"mydeppkg\", \"0.1\")})\n        c.run(\"workspace add mydeppkg\")\n        # If we now remove the folder\n        shutil.rmtree(os.path.join(c.current_folder, \"mydeppkg\"))\n        # It can still be removed by path, even if the path doesn't exist\n        c.run(\"workspace remove mydeppkg\")\n        assert \"Removed from workspace: mydeppkg/0.1\" in c.out\n        c.run(\"workspace info\")\n        assert \"mydeppkg\" not in c.out\n\n    def test_custom_add_remove(self):\n        c = TestClient(light=True)\n\n        workspace = textwrap.dedent(\"\"\"\\\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"nl -ba conan/api/subapi/workspace.py | sed -n 100,330p; printf '\\\\n--- cli complete ---\\\\n'; nl -ba conan/cli/commands/workspace.py | sed -n 1,430p\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"nl -ba conan/api/subapi/workspace.py | sed -n 100,330p; printf '\\\\n--- cli complete ---\\\\n'; nl -ba conan/cli/commands/workspace.py | sed -n 1,430p\"","aggregated_output":"   100\t        \"\"\"\n   101\t        @return: the current workspace folder where the conanws.yml or conanws.py is located\n   102\t        \"\"\"\n   103\t        self._check_ws()\n   104\t        return self._folder\n   105\t\n   106\t    def packages(self):\n   107\t        \"\"\"\n   108\t        @return: Returns {RecipeReference: {\"path\": full abs-path, \"output_folder\": abs-path}}\n   109\t        \"\"\"\n   110\t        if not self._folder or not self._enabled:\n   111\t            return\n   112\t        editables = self._ws.packages()\n   113\t        editables = {RecipeReference.loads(r): v.copy() for r, v in editables.items()}\n   114\t        for v in editables.values():\n   115\t            path = os.path.normpath(os.path.join(self._folder, v[\"path\"], \"conanfile.py\"))\n   116\t            if not os.path.isfile(path):\n   117\t                raise ConanException(f\"Workspace editable not found: {path}\")\n   118\t            v[\"path\"] = path\n   119\t            if v.get(\"output_folder\"):\n   120\t                v[\"output_folder\"] = os.path.normpath(os.path.join(self._folder,\n   121\t                                                                   v[\"output_folder\"]))\n   122\t        return editables\n   123\t\n   124\t    def open(self, require, remotes, cwd=None):\n   125\t        app = ConanApp(self._conan_api)\n   126\t        ref = RecipeReference.loads(require)\n   127\t        recipe = app.proxy.get_recipe(ref, remotes, update=False, check_update=False)\n   128\t\n   129\t        layout, recipe_status, remote = recipe\n   130\t        if recipe_status == RECIPE_EDITABLE:\n   131\t            raise ConanException(f\"Can't open a dependency that is already an editable: {ref}\")\n   132\t        ref = layout.reference\n   133\t        conanfile_path = layout.conanfile()\n   134\t        conanfile, module = app.loader.load_basic_module(conanfile_path, remotes=remotes)\n   135\t\n   136\t        scm = conanfile.conan_data.get(\"scm\") if conanfile.conan_data else None\n   137\t        dst_path = os.path.join(cwd or os.getcwd(), ref.name)\n   138\t        if scm is None:\n   139\t            conanfile.output.warning(\"conandata doesn't contain 'scm' information\\n\"\n   140\t                                     \"doing a local copy!!!\")\n   141\t            shutil.copytree(layout.export(), dst_path)\n   142\t            retrieve_exports_sources(app.remote_manager, layout, conanfile, ref, remotes)\n   143\t            export_sources = layout.export_sources()\n   144\t            if os.path.exists(export_sources):\n   145\t                conanfile.output.warning(\"There are export-sources, copying them, but the location\"\n   146\t                                         \" might be incorrect, use 'scm' approach\")\n   147\t                merge_directories(export_sources, dst_path)\n   148\t        else:\n   149\t            git = Git(conanfile, folder=cwd)\n   150\t            git.clone(url=scm[\"url\"], target=ref.name)\n   151\t            git.folder = ref.name  # change to the cloned folder\n   152\t            git.checkout(commit=scm[\"commit\"])\n   153\t        return dst_path\n   154\t\n   155\t    def _check_ws(self):\n   156\t        if not self._folder:\n   157\t            raise ConanException(f\"Workspace not defined, please create a \"\n   158\t                                 f\"'{WORKSPACE_PY}' or '{WORKSPACE_YML}' file\")\n   159\t\n   160\t    def add(self, path, name=None, version=None, user=None, channel=None, cwd=None,\n   161\t            output_folder=None, remotes=None):\n   162\t        \"\"\"\n   163\t        Add a new editable package to the current workspace (the current workspace must exist)\n   164\t        @param path: The path to the folder containing the conanfile.py that defines the package\n   165\t        @param name: (optional) The name of the package to be added if not defined in recipe\n   166\t        @param version:\n   167\t        @param user:\n   168\t        @param channel:\n   169\t        @param cwd:\n   170\t        @param output_folder:\n   171\t        @param remotes:\n   172\t        @return: The reference of the added package\n   173\t        \"\"\"\n   174\t        self._check_ws()\n   175\t        full_path = self._conan_api.local.get_conanfile_path(path, cwd, py=True)\n   176\t        app = ConanApp(self._conan_api)\n   177\t        conanfile = app.loader.load_named(full_path, name, version, user, channel, remotes=remotes)\n   178\t        if conanfile.name is None or conanfile.version is None:\n   179\t            raise ConanException(\"Editable package recipe should declare its name and version\")\n   180\t        ref = RecipeReference(conanfile.name, conanfile.version, conanfile.user, conanfile.channel)\n   181\t        ref.validate_ref()\n   182\t        output_folder = make_abs_path(output_folder) if output_folder else None\n   183\t        # Check the conanfile is there, and name/version matches\n   184\t        self._ws.add(ref, full_path, output_folder)\n   185\t        return ref\n   186\t\n   187\t    @staticmethod\n   188\t    def init(path):\n   189\t        abs_path = make_abs_path(path)\n   190\t        os.makedirs(abs_path, exist_ok=True)\n   191\t        ws_yml_file = Path(abs_path, WORKSPACE_YML)\n   192\t        ws_py_file = Path(abs_path, WORKSPACE_PY)\n   193\t        if not ws_yml_file.exists():\n   194\t            ConanOutput().success(f\"Created empty {WORKSPACE_YML} in {path}\")\n   195\t            save(ws_yml_file, \"\")\n   196\t        if not ws_py_file.exists():\n   197\t            ConanOutput().success(f\"Created minimal {WORKSPACE_PY} in {path}\")\n   198\t            ws_name = os.path.basename(abs_path)\n   199\t            save(ws_py_file, textwrap.dedent(f'''\\\n   200\t            from conan import Workspace\n   201\t\n   202\t            class MyWorkspace(Workspace):\n   203\t               \"\"\"\n   204\t               Minimal Workspace class definition.\n   205\t               More info: https://docs.conan.io/2/incubating.html#workspaces\n   206\t               \"\"\"\n   207\t               def name(self):\n   208\t                  return \"{ws_name}\"\n   209\t            '''))\n   210\t\n   211\t    def remove(self, path):\n   212\t        self._check_ws()\n   213\t        return self._ws.remove(path)\n   214\t\n   215\t    def clean(self):\n   216\t        self._check_ws()\n   217\t        return self._ws.clean()\n   218\t\n   219\t    def info(self):\n   220\t        self._check_ws()\n   221\t        return {\"name\": self.name,\n   222\t                \"folder\": self._folder,\n   223\t                \"packages\": self._ws.packages()}\n   224\t\n   225\t    def super_build_graph(self, deps_graph, profile_host, profile_build):\n   226\t        ConanOutput().title(\"Collapsing workspace packages\")\n   227\t\n   228\t        root_class = self._ws.root_conanfile()\n   229\t        if root_class is not None:\n   230\t            conanfile = root_class(f\"{WORKSPACE_PY} base project Conanfile\")\n   231\t            consumer_definer(conanfile, profile_host, profile_build)\n   232\t            root = Node(None, conanfile, context=CONTEXT_HOST, recipe=RECIPE_CONSUMER,\n   233\t                        path=self._folder)  # path lets use the conanws.py folder\n   234\t            root.should_build = True  # It is a consumer, this is something we are building\n   235\t            for field in (\"requires\", \"build_requires\", \"test_requires\", \"requirements\", \"build\",\n   236\t                          \"source\", \"package\"):\n   237\t                if getattr(conanfile, field, None):\n   238\t                    raise ConanException(f\"Conanfile in conanws.py shouldn't have '{field}'\")\n   239\t        else:\n   240\t            ConanOutput().info(f\"Workspace {WORKSPACE_PY} not found in the workspace folder, \"\n   241\t                               \"using default behavior\")\n   242\t            conanfile = ConanFile(display_name=\"cli\")\n   243\t            consumer_definer(conanfile, profile_host, profile_build)\n   244\t            root = Node(ref=None, conanfile=conanfile, context=CONTEXT_HOST, recipe=RECIPE_VIRTUAL)\n   245\t\n   246\t        result = DepsGraph()  # TODO: We might need to copy more information from the original graph\n   247\t        result.add_node(root)\n   248\t        for node in deps_graph.nodes[1:]:  # Exclude the current root\n   249\t            if node.recipe != RECIPE_EDITABLE:\n   250\t                result.add_node(node)\n   251\t                continue\n   252\t            for r, t in node.transitive_deps.items():\n   253\t                if t.node.recipe == RECIPE_EDITABLE:\n   254\t                    continue\n   255\t                existing = root.transitive_deps.pop(r, None)\n   256\t                if existing is None:\n   257\t                    root.transitive_deps[r] = t\n   258\t                else:\n   259\t                    require = existing.require\n   260\t                    require.aggregate(r)\n   261\t                    root.transitive_deps[require] = TransitiveRequirement(require, t.node)\n   262\t\n   263\t        # The graph edges must be defined too\n   264\t        for r, t in root.transitive_deps.items():\n   265\t            result.add_edge(root, t.node, r)\n   266\t\n   267\t        return result\n   268\t\n   269\t    def export(self, lockfile=None, remotes=None):\n   270\t        self._check_ws()\n   271\t        exported = []\n   272\t        for ref, info in self.packages().items():\n   273\t            exported_ref = self._conan_api.export.export(info[\"path\"], ref.name, str(ref.version),\n   274\t                                                         ref.user, ref.channel,\n   275\t                                                         lockfile=lockfile, remotes=remotes)\n   276\t            ref, _ = exported_ref\n   277\t            exported.append(ref)\n   278\t        return exported\n   279\t\n   280\t\n   281\t    def select_packages(self, packages):\n   282\t        self._check_ws()\n   283\t        editable = self.packages()\n   284\t        packages = packages or []\n   285\t        selected_editables = {}\n   286\t        for ref, info in editable.items():\n   287\t            if packages and not any(ref.matches(p, False) for p in packages):\n   288\t                continue\n   289\t            selected_editables[ref] = info\n   290\t        if not selected_editables:\n   291\t            raise ConanException(\"There are no selected packages defined in the workspace\")\n   292\t\n   293\t        return selected_editables\n   294\t\n   295\t    def build_order(self, packages, profile_host, profile_build, build_mode, lockfile, remotes,\n   296\t                    profile_args, update=False):\n   297\t        ConanOutput().title(f\"Computing dependency graph for each package\")\n   298\t        conan_api = self._conan_api\n   299\t        from conan.internal.graph.install_graph import InstallGraph\n   300\t        install_order = InstallGraph(None)\n   301\t\n   302\t        for ref, info in packages.items():\n   303\t            ConanOutput().title(f\"Computing the dependency graph for package: {ref}\")\n   304\t\n   305\t            deps_graph = conan_api.graph.load_graph_requires([ref], None,\n   306\t                                                             profile_host, profile_build, lockfile,\n   307\t                                                             remotes, update)\n   308\t            deps_graph.report_graph_error()\n   309\t            print_graph_basic(deps_graph)\n   310\t            conan_api.graph.analyze_binaries(deps_graph, build_mode, remotes=remotes, update=update,\n   311\t                                             lockfile=lockfile)\n   312\t            print_graph_packages(deps_graph)\n   313\t\n   314\t            ConanOutput().success(f\"\\nAggregating build-order for package: {ref}\")\n   315\t            install_graph = InstallGraph(deps_graph, order_by=\"recipe\",\n   316\t                                         profile_args=ProfileArgs.from_args(profile_args))\n   317\t            install_graph.raise_errors()\n   318\t            install_order.merge(install_graph)\n   319\t\n   320\t        return install_order\n\n--- cli complete ---\n     1\timport json\n     2\timport os\n     3\t\n     4\tfrom conan.api.conan_api import ConanAPI\n     5\tfrom conan.api.model import RecipeReference\n     6\tfrom conan.api.output import ConanOutput, cli_out_write\n     7\tfrom conan.api.subapi.workspace import WorkspaceAPI\n     8\tfrom conan.cli import make_abs_path\n     9\tfrom conan.cli.args import add_reference_args, add_common_install_arguments, add_lockfile_args\n    10\tfrom conan.cli.command import conan_command, conan_subcommand\n    11\tfrom conan.cli.commands.list import print_serial\n    12\tfrom conan.cli.printers import print_profiles\n    13\tfrom conan.cli.printers.graph import print_graph_packages, print_graph_basic\n    14\tfrom conan.errors import ConanException\n    15\tfrom conan.internal.graph.install_graph import ProfileArgs\n    16\t\n    17\t\n    18\t@conan_subcommand(formatters={\"text\": cli_out_write})\n    19\tdef workspace_root(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n    20\t    \"\"\"\n    21\t    Return the folder containing the conanws.py/conanws.yml workspace file\n    22\t    \"\"\"\n    23\t    parser.parse_args(*args)\n    24\t    ws = conan_api.workspace\n    25\t    return ws.folder()\n    26\t\n    27\t\n    28\t@conan_subcommand()\n    29\tdef workspace_open(conan_api: ConanAPI, parser, subparser, *args):\n    30\t    \"\"\"\n    31\t    Open specific references\n    32\t    \"\"\"\n    33\t    subparser.add_argument(\"reference\",\n    34\t                           help=\"Open this package source repository\")\n    35\t    group = subparser.add_mutually_exclusive_group()\n    36\t    group.add_argument(\"-r\", \"--remote\", action=\"append\", default=None,\n    37\t                       help='Look in the specified remote or remotes server')\n    38\t    group.add_argument(\"-nr\", \"--no-remote\", action=\"store_true\",\n    39\t                       help='Do not use remote, resolve exclusively in the cache')\n    40\t    args = parser.parse_args(*args)\n    41\t    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n    42\t    cwd = os.getcwd()\n    43\t    conan_api.workspace.open(args.reference, remotes=remotes, cwd=cwd)\n    44\t\n    45\t\n    46\t@conan_subcommand()\n    47\tdef workspace_add(conan_api: ConanAPI, parser, subparser, *args):\n    48\t    \"\"\"\n    49\t    Add packages to current workspace\n    50\t    \"\"\"\n    51\t    subparser.add_argument('path',  nargs=\"?\",\n    52\t                           help='Path to the package folder in the user workspace')\n    53\t    add_reference_args(subparser)\n    54\t    subparser.add_argument(\"--ref\", help=\"Open and add this reference\")\n    55\t    subparser.add_argument(\"-of\", \"--output-folder\",\n    56\t                           help='The root output folder for generated and build files')\n    57\t    group = subparser.add_mutually_exclusive_group()\n    58\t    group.add_argument(\"-r\", \"--remote\", action=\"append\", default=None,\n    59\t                       help='Look in the specified remote or remotes server')\n    60\t    group.add_argument(\"-nr\", \"--no-remote\", action=\"store_true\",\n    61\t                       help='Do not use remote, resolve exclusively in the cache')\n    62\t    args = parser.parse_args(*args)\n    63\t    if args.path and args.ref:\n    64\t        raise ConanException(\"Do not use both 'path' and '--ref' argument\")\n    65\t    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n    66\t    cwd = os.getcwd()\n    67\t    path = args.path\n    68\t    if args.ref:\n    69\t        # TODO: Use path here to open in this path\n    70\t        path = conan_api.workspace.open(args.ref, remotes, cwd=cwd)\n    71\t    ref = conan_api.workspace.add(path,\n    72\t                                  args.name, args.version, args.user, args.channel,\n    73\t                                  cwd, args.output_folder, remotes=remotes)\n    74\t    ConanOutput().success(\"Reference '{}' added to workspace\".format(ref))\n    75\t\n    76\t\n    77\t@conan_subcommand()\n    78\tdef workspace_remove(conan_api: ConanAPI, parser, subparser, *args):\n    79\t    \"\"\"\n    80\t    Remove packages from the current workspace\n    81\t    \"\"\"\n    82\t    subparser.add_argument('path',\n    83\t                           help='Path to the package folder in the user workspace')\n    84\t    args = parser.parse_args(*args)\n    85\t    removed = conan_api.workspace.remove(make_abs_path(args.path))\n    86\t    ConanOutput().info(f\"Removed from workspace: {removed}\")\n    87\t\n    88\t\n    89\tdef print_json(data):\n    90\t    results = data[\"info\"]\n    91\t    myjson = json.dumps(results, indent=4)\n    92\t    cli_out_write(myjson)\n    93\t\n    94\t\n    95\tdef _print_workspace_info(data):\n    96\t    print_serial(data[\"info\"])\n    97\t\n    98\t\n    99\t@conan_subcommand(formatters={\"text\": _print_workspace_info, \"json\": print_json})\n   100\tdef workspace_info(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n   101\t    \"\"\"\n   102\t    Display info for current workspace\n   103\t    \"\"\"\n   104\t    parser.parse_args(*args)\n   105\t    return {\"info\": conan_api.workspace.info()}\n   106\t\n   107\t\n   108\t@conan_subcommand()\n   109\tdef workspace_build(conan_api: ConanAPI, parser, subparser, *args):\n   110\t    \"\"\"\n   111\t    Call \"conan build\" for packages in the workspace, in the right order\n   112\t    \"\"\"\n   113\t    _install_build(conan_api, parser, subparser, True, *args)\n   114\t\n   115\t\n   116\t@conan_subcommand()\n   117\tdef workspace_install(conan_api: ConanAPI, parser, subparser, *args):\n   118\t    \"\"\"\n   119\t    Call \"conan install\" for packages in the workspace, in the right order\n   120\t    \"\"\"\n   121\t    _install_build(conan_api, parser, subparser, False, *args)\n   122\t\n   123\t\n   124\tdef _install_build(conan_api: ConanAPI, parser, subparser, build, *args):\n   125\t    subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n   126\t    add_common_install_arguments(subparser)\n   127\t    add_lockfile_args(subparser)\n   128\t    args = parser.parse_args(*args)\n   129\t    # Basic collaborators: remotes, lockfile, profiles\n   130\t    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n   131\t    overrides = eval(args.lockfile_overrides) if args.lockfile_overrides else None\n   132\t    # The lockfile by default if not defined will be read from the root workspace folder\n   133\t    ws_folder = conan_api.workspace.folder()\n   134\t    lockfile = conan_api.lockfile.get_lockfile(lockfile=args.lockfile, conanfile_path=ws_folder,\n   135\t                                               cwd=None, partial=args.lockfile_partial,\n   136\t                                               overrides=overrides)\n   137\t    profile_host, profile_build = conan_api.profiles.get_profiles_from_args(args)\n   138\t    print_profiles(profile_host, profile_build)\n   139\t\n   140\t    buildmode = args.build\n   141\t    if build and (not buildmode or \"editable\" not in buildmode):\n   142\t        ConanOutput().info(\"Adding '--build=editable' as build mode\")\n   143\t        buildmode = buildmode or []\n   144\t        buildmode.append(\"editable\")\n   145\t\n   146\t    all_editables = conan_api.workspace.packages()\n   147\t    packages = conan_api.workspace.select_packages(args.pkg)\n   148\t    ConanOutput().box(\"Workspace computing the build order\")\n   149\t    install_order = conan_api.workspace.build_order(packages, profile_host, profile_build, buildmode,\n   150\t                                                    lockfile, remotes, args, update=args.update)\n   151\t\n   152\t    msg = \"build\" if build else \"install\"\n   153\t    ConanOutput().box(f\"Workspace {msg}ing each package\")\n   154\t    order = install_order.install_build_order()\n   155\t\n   156\t    profile_args = ProfileArgs.from_args(args)\n   157\t    for level in order[\"order\"]:\n   158\t        for elem in level:\n   159\t            ref = RecipeReference.loads(elem[\"ref\"])\n   160\t            for package_level in elem[\"packages\"]:\n   161\t                for package in package_level:\n   162\t                    if package[\"binary\"] == \"Build\":  # Build external to Workspace\n   163\t                        cmd = f'install {package[\"build_args\"]} {profile_args}'\n   164\t                        ConanOutput().box(f\"Workspace building external {ref}\")\n   165\t                        ConanOutput().info(f\"Command: {cmd}\\n\")\n   166\t                        conan_api.command.run(cmd)\n   167\t                    elif package[\"binary\"] in (\"Editable\", \"EditableBuild\"):\n   168\t                        path = all_editables[ref][\"path\"]\n   169\t                        output_folder = all_editables[ref].get(\"output_folder\")\n   170\t                        build_arg = \"--build-require\" if package[\"context\"] == \"build\" else \"\"\n   171\t                        ref_args = \" \".join(f\"--{k}={getattr(ref, k)}\"\n   172\t                                            for k in (\"name\", \"version\", \"user\", \"channel\")\n   173\t                                            if getattr(ref, k, None))\n   174\t                        of_arg = f'-of=\"{output_folder}\"' if output_folder else \"\"\n   175\t                        # TODO: Missing --lockfile-overrides arg here\n   176\t                        command = \"build\" if build else \"install\"\n   177\t                        cmd = f'{command} \"{path}\" {profile_args} {build_arg} {ref_args} {of_arg}'\n   178\t                        ConanOutput().box(f\"Workspace {command}: {ref}\")\n   179\t                        ConanOutput().info(f\"Command: {cmd}\\n\")\n   180\t                        conan_api.command.run(cmd)\n   181\t\n   182\t\n   183\t@conan_subcommand()\n   184\tdef workspace_super_install(conan_api: ConanAPI, parser, subparser, *args):\n   185\t    \"\"\"\n   186\t    Install the workspace as a monolith, installing only external dependencies to the workspace,\n   187\t    generating a single result (generators, etc) for the whole workspace.\n   188\t    \"\"\"\n   189\t    subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n   190\t    subparser.add_argument(\"-g\", \"--generator\", action=\"append\", help='Generators to use')\n   191\t    subparser.add_argument(\"-of\", \"--output-folder\",\n   192\t                           help='The root output folder for generated and build files')\n   193\t    subparser.add_argument(\"--envs-generation\", default=None, choices=[\"false\"],\n   194\t                           help=\"Generation strategy for virtual environment files for the root\")\n   195\t    add_common_install_arguments(subparser)\n   196\t    add_lockfile_args(subparser)\n   197\t    args = parser.parse_args(*args)\n   198\t    # Basic collaborators: remotes, lockfile, profiles\n   199\t    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n   200\t    overrides = eval(args.lockfile_overrides) if args.lockfile_overrides else None\n   201\t    # The lockfile by default if not defined will be read from the root workspace folder\n   202\t    ws_folder = conan_api.workspace.folder()\n   203\t    lockfile = conan_api.lockfile.get_lockfile(lockfile=args.lockfile, conanfile_path=ws_folder,\n   204\t                                               cwd=None,\n   205\t                                               partial=args.lockfile_partial, overrides=overrides)\n   206\t    profile_host, profile_build = conan_api.profiles.get_profiles_from_args(args)\n   207\t    print_profiles(profile_host, profile_build)\n   208\t\n   209\t    # Build a dependency graph with all editables as requirements\n   210\t    requires = conan_api.workspace.select_packages(args.pkg)\n   211\t    deps_graph = conan_api.graph.load_graph_requires(requires, [],\n   212\t                                                     profile_host, profile_build, lockfile,\n   213\t                                                     remotes, args.build, args.update)\n   214\t    deps_graph.report_graph_error()\n   215\t    print_graph_basic(deps_graph)\n   216\t\n   217\t    # Collapsing the graph\n   218\t    ws_graph = conan_api.workspace.super_build_graph(deps_graph, profile_host, profile_build)\n   219\t    ConanOutput().subtitle(\"Collapsed graph\")\n   220\t    print_graph_basic(ws_graph)\n   221\t\n   222\t    conan_api.graph.analyze_binaries(ws_graph, args.build, remotes=remotes, update=args.update,\n   223\t                                     lockfile=lockfile)\n   224\t    print_graph_packages(ws_graph)\n   225\t    conan_api.install.install_binaries(deps_graph=ws_graph, remotes=remotes)\n   226\t    output_folder = make_abs_path(args.output_folder) if args.output_folder else None\n   227\t    conan_api.install.install_consumer(ws_graph, args.generator, ws_folder, output_folder,\n   228\t                                       envs_generation=args.envs_generation)\n   229\t\n   230\t\n   231\t@conan_subcommand()\n   232\tdef workspace_clean(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n   233\t    \"\"\"\n   234\t    Clean the temporary build folders when possible\n   235\t    \"\"\"\n   236\t    parser.parse_args(*args)\n   237\t    conan_api.workspace.clean()\n   238\t\n   239\t\n   240\t@conan_subcommand()\n   241\tdef workspace_init(conan_api: ConanAPI, parser, subparser, *args):\n   242\t    \"\"\"\n   243\t    Clean the temporary build folders when possible\n   244\t    \"\"\"\n   245\t    subparser.add_argument(\"path\", nargs=\"?\", default=os.getcwd(),\n   246\t                        help=\"Path to a folder where the workspace will be initialized. \"\n   247\t                             \"If  does not exist\")\n   248\t    args = parser.parse_args(*args)\n   249\t    conan_api.workspace.init(args.path)\n   250\t\n   251\t\n   252\t@conan_subcommand()\n   253\tdef workspace_create(conan_api: ConanAPI, parser, subparser, *args):\n   254\t    \"\"\"\n   255\t    Call \"conan create\" for packages in the workspace, in the correct order.\n   256\t    Packages will be created in the Conan cache, not locally\n   257\t    \"\"\"\n   258\t    subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n   259\t    add_common_install_arguments(subparser)\n   260\t    add_lockfile_args(subparser)\n   261\t    args = parser.parse_args(*args)\n   262\t    # Basic collaborators: remotes, lockfile, profiles\n   263\t    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n   264\t    overrides = eval(args.lockfile_overrides) if args.lockfile_overrides else None\n   265\t    # The lockfile by default if not defined will be read from the root workspace folder\n   266\t    ws_folder = conan_api.workspace.folder()\n   267\t    lockfile = conan_api.lockfile.get_lockfile(lockfile=args.lockfile, conanfile_path=ws_folder,\n   268\t                                               cwd=None,\n   269\t                                               partial=args.lockfile_partial, overrides=overrides)\n   270\t    profile_host, profile_build = conan_api.profiles.get_profiles_from_args(args)\n   271\t    print_profiles(profile_host, profile_build)\n   272\t\n   273\t    build_mode = args.build if args.build else []\n   274\t    ConanOutput().box(\"Exporting workspace recipes to Conan cache\")\n   275\t    exported_refs = conan_api.workspace.export()\n   276\t    build_mode.extend(f\"missing:{r}\" for r in exported_refs)\n   277\t\n   278\t    all_packages = conan_api.workspace.packages()\n   279\t    packages = conan_api.workspace.select_packages(args.pkg)\n   280\t\n   281\t    # If we don't disable the workspace, then, the packages are not created in the Conan cache,\n   282\t    # but locally in the user folders, are they are intercepted as editables\n   283\t    conan_api.workspace.enable(False)\n   284\t\n   285\t    install_order = conan_api.workspace.build_order(packages, profile_host, profile_build,\n   286\t                                                    build_mode, lockfile, remotes, args,\n   287\t                                                    update=args.update)\n   288\t\n   289\t    ConanOutput().box(\"Workspace creating each package\")\n   290\t    order = install_order.install_build_order()\n   291\t\n   292\t    profile_args = ProfileArgs.from_args(args)\n   293\t    for level in order[\"order\"]:\n   294\t        for elem in level:\n   295\t            ref = RecipeReference.loads(elem[\"ref\"])\n   296\t            for package_level in elem[\"packages\"]:\n   297\t                for package in package_level:\n   298\t                    if package[\"binary\"] not in (\"Build\", \"EditableBuild\"):\n   299\t                        ConanOutput().info(f\"Skip build for {ref} binary: {package['binary']}\")\n   300\t                        continue\n   301\t\n   302\t                    if ref not in all_packages:\n   303\t                        # Build external to Workspace\n   304\t                        cmd = f'install {package[\"build_args\"]} {profile_args}'\n   305\t                        ConanOutput().box(f\"Workspace building external {ref}\")\n   306\t                        ConanOutput().info(f\"Build command: {cmd}\\n\")\n   307\t                        conan_api.command.run(cmd)\n   308\t                    else:  # Package in workspace\n   309\t                        path = packages[ref][\"path\"]\n   310\t                        # TODO: Missing --lockfile-overrides arg here\n   311\t                        build = \"--build-require\" if package[\"context\"] == \"build\" else \"\"\n   312\t                        ref_args = \" \".join(f\"--{k}={getattr(ref, k)}\"\n   313\t                                            for k in (\"name\", \"version\", \"user\", \"channel\")\n   314\t                                            if getattr(ref, k, None))\n   315\t                        cmd = f'create \"{path}\" {profile_args} {build} {ref_args}'\n   316\t                        ConanOutput().box(f\"Workspace create {ref}\")\n   317\t                        ConanOutput().info(f\"Conan create command: {cmd}\\n\")\n   318\t                        conan_api.command.run(cmd)\n   319\t\n   320\t\n   321\t@conan_subcommand()\n   322\tdef workspace_source(conan_api: ConanAPI, parser, subparser, *args):\n   323\t    \"\"\"\n   324\t    Call the source() method of packages in the workspace\n   325\t    \"\"\"\n   326\t    subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n   327\t    args = parser.parse_args(*args)\n   328\t\n   329\t    remotes = conan_api.remotes.list()  # In case \"python_requires\" are needed\n   330\t    packages = conan_api.workspace.select_packages(args.pkg)\n   331\t\n   332\t    ConanOutput().box(\"Workspace getting sources\")\n   333\t    for pkg, info in packages.items():\n   334\t        conan_api.local.source(info[\"path\"], name=pkg.name, version=str(pkg.version),\n   335\t                               user=pkg.user, channel=pkg.channel, remotes=remotes)\n   336\t\n   337\t\n   338\t@conan_command(group=\"Consumer\")\n   339\tdef workspace(conan_api, parser, *args):  # noqa\n   340\t    \"\"\"\n   341\t    Manage Conan workspaces (group of packages in editable mode)\n   342\t    \"\"\"\n   343\t    if (WorkspaceAPI.TEST_ENABLED or os.getenv(\"CONAN_WORKSPACE_ENABLE\")) != \"will_break_next\":\n   344\t        raise ConanException(\"Workspace command disabled without CONAN_WORKSPACE_ENABLE env var,\"\n   345\t                             \"please read the docs about this 'incubating' feature\")\n","exit_code":0,"status":"completed"}}
