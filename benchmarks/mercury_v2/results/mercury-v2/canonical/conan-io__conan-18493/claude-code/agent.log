{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-9e8d37ab84e0cf0f","type":"tool_result","content":"1\timport json\n2\timport os\n3\t\n4\tfrom conan.api.conan_api import ConanAPI\n5\tfrom conan.api.model import RecipeReference\n6\tfrom conan.api.output import ConanOutput, cli_out_write\n7\tfrom conan.api.subapi.workspace import WorkspaceAPI\n8\tfrom conan.cli import make_abs_path\n9\tfrom conan.cli.args import add_reference_args, add_common_install_arguments, add_lockfile_args\n10\tfrom conan.cli.command import conan_command, conan_subcommand\n11\tfrom conan.cli.commands.list import print_serial\n12\tfrom conan.cli.printers import print_profiles\n13\tfrom conan.cli.printers.graph import print_graph_packages, print_graph_basic\n14\tfrom conan.errors import ConanException\n15\tfrom conan.internal.graph.install_graph import ProfileArgs\n16\t\n17\t\n18\t@conan_subcommand(formatters={\"text\": cli_out_write})\n19\tdef workspace_root(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n20\t    \"\"\"\n21\t    Return the folder containing the conanws.py/conanws.yml workspace file\n22\t    \"\"\"\n23\t    parser.parse_args(*args)\n24\t    ws = conan_api.workspace\n25\t    return ws.folder()\n26\t\n27\t\n28\t@conan_subcommand()\n29\tdef workspace_open(conan_api: ConanAPI, parser, subparser, *args):\n30\t    \"\"\"\n31\t    Open specific references\n32\t    \"\"\"\n33\t    subparser.add_argument(\"reference\",\n34\t                           help=\"Open this package source repository\")\n35\t    group = subparser.add_mutually_exclusive_group()\n36\t    group.add_argument(\"-r\", \"--remote\", action=\"append\", default=None,\n37\t                       help='Look in the specified remote or remotes server')\n38\t    group.add_argument(\"-nr\", \"--no-remote\", action=\"store_true\",\n39\t                       help='Do not use remote, resolve exclusively in the cache')\n40\t    args = parser.parse_args(*args)\n41\t    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n42\t    cwd = os.getcwd()\n43\t    conan_api.workspace.open(args.reference, remotes=remotes, cwd=cwd)\n44\t\n45\t\n46\t@conan_subcommand()\n47\tdef workspace_add(conan_api: ConanAPI, parser, subparser, *args):\n48\t    \"\"\"\n49\t    Add packages to current workspace\n50\t    \"\"\"\n51\t    subparser.add_argument('path',  nargs=\"?\",\n52\t                           help='Path to the package folder in the user workspace')\n53\t    add_reference_args(subparser)\n54\t    subparser.add_argument(\"--ref\", help=\"Open and add this reference\")\n55\t    subparser.add_argument(\"-of\", \"--output-folder\",\n56\t                           help='The root output folder for generated and build files')\n57\t    group = subparser.add_mutually_exclusive_group()\n58\t    group.add_argument(\"-r\", \"--remote\", action=\"append\", default=None,\n59\t                       help='Look in the specified remote or remotes server')\n60\t    group.add_argument(\"-nr\", \"--no-remote\", action=\"store_true\",\n61\t                       help='Do not use remote, resolve exclusively in the cache')\n62\t    args = parser.parse_args(*args)\n63\t    if args.path and args.ref:\n64\t        raise ConanException(\"Do not use both 'path' and '--ref' argument\")\n65\t    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n66\t    cwd = os.getcwd()\n67\t    path = args.path\n68\t    if args.ref:\n69\t        # TODO: Use path here to open in this path\n70\t        path = conan_api.workspace.open(args.ref, remotes, cwd=cwd)\n71\t    ref = conan_api.workspace.add(path,\n72\t                                  args.name, args.version, args.user, args.channel,\n73\t                                  cwd, args.output_folder, remotes=remotes)\n74\t    ConanOutput().success(\"Reference '{}' added to workspace\".format(ref))\n75\t\n76\t\n77\t@conan_subcommand()\n78\tdef workspace_remove(conan_api: ConanAPI, parser, subparser, *args):\n79\t    \"\"\"\n80\t    Remove packages from the current workspace\n81\t    \"\"\"\n82\t    subparser.add_argument('path',\n83\t                           help='Path to the package folder in the user workspace')\n84\t    args = parser.parse_args(*args)\n85\t    removed = conan_api.workspace.remove(make_abs_path(args.path))\n86\t    ConanOutput().info(f\"Removed from workspace: {removed}\")\n87\t\n88\t\n89\tdef print_json(data):\n90\t    results = data[\"info\"]\n91\t    myjson = json.dumps(results, indent=4)\n92\t    cli_out_write(myjson)\n93\t\n94\t\n95\tdef _print_workspace_info(data):\n96\t    print_serial(data[\"info\"])\n97\t\n98\t\n99\t@conan_subcommand(formatters={\"text\": _print_workspace_info, \"json\": print_json})\n100\tdef workspace_info(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n101\t    \"\"\"\n102\t    Display info for current workspace\n103\t    \"\"\"\n104\t    parser.parse_args(*args)\n105\t    return {\"info\": conan_api.workspace.info()}\n106\t\n107\t\n108\t@conan_subcommand()\n109\tdef workspace_build(conan_api: ConanAPI, parser, subparser, *args):\n110\t    \"\"\"\n111\t    Call \"conan build\" for packages in the workspace, in the right order\n112\t    \"\"\"\n113\t    _install_build(conan_api, parser, subparser, True, *args)\n114\t\n115\t\n116\t@conan_subcommand()\n117\tdef workspace_install(conan_api: ConanAPI, parser, subparser, *args):\n118\t    \"\"\"\n119\t    Call \"conan install\" for packages in the workspace, in the right order\n120\t    \"\"\"\n121\t    _install_build(conan_api, parser, subparser, False, *args)\n122\t\n123\t\n124\tdef _install_build(conan_api: ConanAPI, parser, subparser, build, *args):\n125\t    subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n126\t    add_common_install_arguments(subparser)\n127\t    add_lockfile_args(subparser)\n128\t    args = parser.parse_args(*args)\n129\t    # Basic collaborators: remotes, lockfile, profiles\n130\t    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n131\t    overrides = eval(args.lockfile_overrides) if args.lockfile_overrides else None\n132\t    # The lockfile by default if not defined will be read from the root workspace folder\n133\t    ws_folder = conan_api.workspace.folder()\n134\t    lockfile = conan_api.lockfile.get_lockfile(lockfile=args.lockfile, conanfile_path=ws_folder,\n135\t                                               cwd=None, partial=args.lockfile_partial,\n136\t                                               overrides=overrides)\n137\t    profile_host, profile_build = conan_api.profiles.get_profiles_from_args(args)\n138\t    print_profiles(profile_host, profile_build)\n139\t\n140\t    buildmode = args.build\n141\t    if build and (not buildmode or \"editable\" not in buildmode):\n142\t        ConanOutput().info(\"Adding '--build=editable' as build mode\")\n143\t        buildmode = buildmode or []\n144\t        buildmode.append(\"editable\")\n145\t\n146\t    all_editables = conan_api.workspace.packages()\n147\t    packages = conan_api.workspace.select_packages(args.pkg)\n148\t    ConanOutput().box(\"Workspace computing the build order\")\n149\t    install_order = conan_api.workspace.build_order(packages, profile_host, profile_build, buildmode,\n150\t                                                    lockfile, remotes, args, update=args.update)\n151\t\n152\t    msg = \"build\" if build else \"install\"\n153\t    ConanOutput().box(f\"Workspace {msg}ing each package\")\n154\t    order = install_order.install_build_order()\n155\t\n156\t    profile_args = ProfileArgs.from_args(args)\n157\t    for level in order[\"order\"]:\n158\t        for elem in level:\n159\t            ref = RecipeReference.loads(elem[\"ref\"])\n160\t            for package_level in elem[\"packages\"]:\n161\t                for package in package_level:\n162\t                    if package[\"binary\"] == \"Build\":  # Build external to Workspace\n163\t                        cmd = f'install {package[\"build_args\"]} {profile_args}'\n164\t                        ConanOutput().box(f\"Workspace building external {ref}\")\n165\t                        ConanOutput().info(f\"Command: {cmd}\\n\")\n166\t                        conan_api.command.run(cmd)\n167\t                    elif package[\"binary\"] in (\"Editable\", \"EditableBuild\"):\n168\t                        path = all_editables[ref][\"path\"]\n169\t                        output_folder = all_editables[ref].get(\"output_folder\")\n170\t                        build_arg = \"--build-require\" if package[\"context\"] == \"build\" else \"\"\n171\t                        ref_args = \" \".join(f\"--{k}={getattr(ref, k)}\"\n172\t                                            for k in (\"name\", \"version\", \"user\", \"channel\")\n173\t                                            if getattr(ref, k, None))\n174\t                        of_arg = f'-of=\"{output_folder}\"' if output_folder else \"\"\n175\t                        # TODO: Missing --lockfile-overrides arg here\n176\t                        command = \"build\" if build else \"install\"\n177\t                        cmd = f'{command} \"{path}\" {profile_args} {build_arg} {ref_args} {of_arg}'\n178\t                        ConanOutput().box(f\"Workspace {command}: {ref}\")\n179\t                        ConanOutput().info(f\"Command: {cmd}\\n\")\n180\t                        conan_api.command.run(cmd)\n181\t\n182\t\n183\t@conan_subcommand()\n184\tdef workspace_super_install(conan_api: ConanAPI, parser, subparser, *args):\n185\t    \"\"\"\n186\t    Install the workspace as a monolith, installing only external dependencies to the workspace,\n187\t    generating a single result (generators, etc) for the whole workspace.\n188\t    \"\"\"\n189\t    subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n190\t    subparser.add_argument(\"-g\", \"--generator\", action=\"append\", help='Generators to use')\n191\t    subparser.add_argument(\"-of\", \"--output-folder\",\n192\t                           help='The root output folder for generated and build files')\n193\t    subparser.add_argument(\"--envs-generation\", default=None, choices=[\"false\"],\n194\t                           help=\"Generation strategy for virtual environment files for the root\")\n195\t    add_common_install_arguments(subparser)\n196\t    add_lockfile_args(subparser)\n197\t    args = parser.parse_args(*args)\n198\t    # Basic collaborators: remotes, lockfile, profiles\n199\t    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n200\t    overrides = eval(args.lockfile_overrides) if args.lockfile_overrides else None\n201\t    # The lockfile by default if not defined will be read from the root workspace folder\n202\t    ws_folder = conan_api.workspace.folder()\n203\t    lockfile = conan_api.lockfile.get_lockfile(lockfile=args.lockfile, conanfile_path=ws_folder,\n204\t                                               cwd=None,\n205\t                                               partial=args.lockfile_partial, overrides=overrides)\n206\t    profile_host, profile_build = conan_api.profiles.get_profiles_from_args(args)\n207\t    print_profiles(profile_host, profile_build)\n208\t\n209\t    # Build a dependency graph with all editables as requirements\n210\t    requires = conan_api.workspace.select_packages(args.pkg)\n211\t    deps_graph = conan_api.graph.load_graph_requires(requires, [],\n212\t                                                     profile_host, profile_build, lockfile,\n213\t                                                     remotes, args.build, args.update)\n214\t    deps_graph.report_graph_error()\n215\t    print_graph_basic(deps_graph)\n216\t\n217\t    # Collapsing the graph\n218\t    ws_graph = conan_api.workspace.super_build_graph(deps_graph, profile_host, profile_build)\n219\t    ConanOutput().subtitle(\"Collapsed graph\")\n220\t    print_graph_basic(ws_graph)\n221\t\n222\t    conan_api.graph.analyze_binaries(ws_graph, args.build, remotes=remotes, update=args.update,\n223\t                                     lockfile=lockfile)\n224\t    print_graph_packages(ws_graph)\n225\t    conan_api.install.install_binaries(deps_graph=ws_graph, remotes=remotes)\n226\t    output_folder = make_abs_path(args.output_folder) if args.output_folder else None\n227\t    conan_api.install.install_consumer(ws_graph, args.generator, ws_folder, output_folder,\n228\t                                       envs_generation=args.envs_generation)\n229\t\n230\t\n231\t@conan_subcommand()\n232\tdef workspace_clean(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n233\t    \"\"\"\n234\t    Clean the temporary build folders when possible\n235\t    \"\"\"\n236\t    parser.parse_args(*args)\n237\t    conan_api.workspace.clean()\n238\t\n239\t\n240\t@conan_subcommand()\n241\tdef workspace_init(conan_api: ConanAPI, parser, subparser, *args):\n242\t    \"\"\"\n243\t    Clean the temporary build folders when possible\n244\t    \"\"\"\n245\t    subparser.add_argument(\"path\", nargs=\"?\", default=os.getcwd(),\n246\t                        help=\"Path to a folder where the workspace will be initialized. \"\n247\t                             \"If  does not exist\")\n248\t    args = parser.parse_args(*args)\n249\t    conan_api.workspace.init(args.path)\n250\t\n251\t\n252\t@conan_subcommand()\n253\tdef workspace_create(conan_api: ConanAPI, parser, subparser, *args):\n254\t    \"\"\"\n255\t    Call \"conan create\" for packages in the workspace, in the correct order.\n256\t    Packages will be created in the Conan cache, not locally\n257\t    \"\"\"\n258\t    subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n259\t    add_common_install_arguments(subparser)\n260\t    add_lockfile_args(subparser)\n261\t    args = parser.parse_args(*args)\n262\t    # Basic collaborators: remotes, lockfile, profiles\n263\t    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n264\t    overrides = eval(args.lockfile_overrides) if args.lockfile_overrides else None\n265\t    # The lockfile by default if not defined will be read from the root workspace folder\n266\t    ws_folder = conan_api.workspace.folder()\n267\t    lockfile = conan_api.lockfile.get_lockfile(lockfile=args.lockfile, conanfile_path=ws_folder,\n268\t                                               cwd=None,\n269\t                                               partial=args.lockfile_partial, overrides=overrides)\n270\t    profile_host, profile_build = conan_api.profiles.get_profiles_from_args(args)\n271\t    print_profiles(profile_host, profile_build)\n272\t\n273\t    build_mode = args.build if args.build else []\n274\t    ConanOutput().box(\"Exporting workspace recipes to Conan cache\")\n275\t    exported_refs = conan_api.workspace.export()\n276\t    build_mode.extend(f\"missing:{r}\" for r in exported_refs)\n277\t\n278\t    all_packages = conan_api.workspace.packages()\n279\t    packages = conan_api.workspace.select_packages(args.pkg)\n280\t\n281\t    # If we don't disable the workspace, then, the packages are not created in the Conan cache,\n282\t    # but locally in the user folders, are they are intercepted as editables\n283\t    conan_api.workspace.enable(False)\n284\t\n285\t    install_order = conan_api.workspace.build_order(packages, profile_host, profile_build,\n286\t                                                    build_mode, lockfile, remotes, args,\n287\t                                                    update=args.update)\n288\t\n289\t    ConanOutput().box(\"Workspace creating each package\")\n290\t    order = install_order.install_build_order()\n291\t\n292\t    profile_args = ProfileArgs.from_args(args)\n293\t    for level in order[\"order\"]:\n294\t        for elem in level:\n295\t            ref = RecipeReference.loads(elem[\"ref\"])\n296\t            for package_level in elem[\"packages\"]:\n297\t                for package in package_level:\n298\t                    if package[\"binary\"] not in (\"Build\", \"EditableBuild\"):\n299\t                        ConanOutput().info(f\"Skip build for {ref} binary: {package['binary']}\")\n300\t                        continue\n301\t\n302\t                    if ref not in all_packages:\n303\t                        # Build external to Workspace\n304\t                        cmd = f'install {package[\"build_args\"]} {profile_args}'\n305\t                        ConanOutput().box(f\"Workspace building external {ref}\")\n306\t                        ConanOutput().info(f\"Build command: {cmd}\\n\")\n307\t                        conan_api.command.run(cmd)\n308\t                    else:  # Package in workspace\n309\t                        path = packages[ref][\"path\"]\n310\t                        # TODO: Missing --lockfile-overrides arg here\n311\t                        build = \"--build-require\" if package[\"context\"] == \"build\" else \"\"\n312\t                        ref_args = \" \".join(f\"--{k}={getattr(ref, k)}\"\n313\t                                            for k in (\"name\", \"version\", \"user\", \"channel\")\n314\t                                            if getattr(ref, k, None))\n315\t                        cmd = f'create \"{path}\" {profile_args} {build} {ref_args}'\n316\t                        ConanOutput().box(f\"Workspace create {ref}\")\n317\t                        ConanOutput().info(f\"Conan create command: {cmd}\\n\")\n318\t                        conan_api.command.run(cmd)\n319\t\n320\t\n321\t@conan_subcommand()\n322\tdef workspace_source(conan_api: ConanAPI, parser, subparser, *args):\n323\t    \"\"\"\n324\t    Call the source() method of packages in the workspace\n325\t    \"\"\"\n326\t    subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n327\t    args = parser.parse_args(*args)\n328\t\n329\t    remotes = conan_api.remotes.list()  # In case \"python_requires\" are needed\n330\t    packages = conan_api.workspace.select_packages(args.pkg)\n331\t\n332\t    ConanOutput().box(\"Workspace getting sources\")\n333\t    for pkg, info in packages.items():\n334\t        conan_api.local.source(info[\"path\"], name=pkg.name, version=str(pkg.version),\n335\t                               user=pkg.user, channel=pkg.channel, remotes=remotes)\n336\t\n337\t\n338\t@conan_command(group=\"Consumer\")\n339\tdef workspace(conan_api, parser, *args):  # noqa\n340\t    \"\"\"\n341\t    Manage Conan workspaces (group of packages in editable mode)\n342\t    \"\"\"\n343\t    if (WorkspaceAPI.TEST_ENABLED or os.getenv(\"CONAN_WORKSPACE_ENABLE\")) != \"will_break_next\":\n344\t        raise ConanException(\"Workspace command disabled without CONAN_WORKSPACE_ENABLE env var,\"\n345\t                             \"please read the docs about this 'incubating' feature\")\n346\t"}]},"parent_tool_use_id":null,"session_id":"a035cbe5-8923-4731-8824-502460b30912","uuid":"a35a4f79-e95c-42ad-86aa-70b673f3b40b","timestamp":"2026-09-04T09:08:41.765Z","tool_use_result":{"type":"text","file":{"filePath":"/testbed/conan/cli/commands/workspace.py","content":"import json\nimport os\n\nfrom conan.api.conan_api import ConanAPI\nfrom conan.api.model import RecipeReference\nfrom conan.api.output import ConanOutput, cli_out_write\nfrom conan.api.subapi.workspace import WorkspaceAPI\nfrom conan.cli import make_abs_path\nfrom conan.cli.args import add_reference_args, add_common_install_arguments, add_lockfile_args\nfrom conan.cli.command import conan_command, conan_subcommand\nfrom conan.cli.commands.list import print_serial\nfrom conan.cli.printers import print_profiles\nfrom conan.cli.printers.graph import print_graph_packages, print_graph_basic\nfrom conan.errors import ConanException\nfrom conan.internal.graph.install_graph import ProfileArgs\n\n\n@conan_subcommand(formatters={\"text\": cli_out_write})\ndef workspace_root(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n    \"\"\"\n    Return the folder containing the conanws.py/conanws.yml workspace file\n    \"\"\"\n    parser.parse_args(*args)\n    ws = conan_api.workspace\n    return ws.folder()\n\n\n@conan_subcommand()\ndef workspace_open(conan_api: ConanAPI, parser, subparser, *args):\n    \"\"\"\n    Open specific references\n    \"\"\"\n    subparser.add_argument(\"reference\",\n                           help=\"Open this package source repository\")\n    group = subparser.add_mutually_exclusive_group()\n    group.add_argument(\"-r\", \"--remote\", action=\"append\", default=None,\n                       help='Look in the specified remote or remotes server')\n    group.add_argument(\"-nr\", \"--no-remote\", action=\"store_true\",\n                       help='Do not use remote, resolve exclusively in the cache')\n    args = parser.parse_args(*args)\n    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n    cwd = os.getcwd()\n    conan_api.workspace.open(args.reference, remotes=remotes, cwd=cwd)\n\n\n@conan_subcommand()\ndef workspace_add(conan_api: ConanAPI, parser, subparser, *args):\n    \"\"\"\n    Add packages to current workspace\n    \"\"\"\n    subparser.add_argument('path',  nargs=\"?\",\n                           help='Path to the package folder in the user workspace')\n    add_reference_args(subparser)\n    subparser.add_argument(\"--ref\", help=\"Open and add this reference\")\n    subparser.add_argument(\"-of\", \"--output-folder\",\n                           help='The root output folder for generated and build files')\n    group = subparser.add_mutually_exclusive_group()\n    group.add_argument(\"-r\", \"--remote\", action=\"append\", default=None,\n                       help='Look in the specified remote or remotes server')\n    group.add_argument(\"-nr\", \"--no-remote\", action=\"store_true\",\n                       help='Do not use remote, resolve exclusively in the cache')\n    args = parser.parse_args(*args)\n    if args.path and args.ref:\n        raise ConanException(\"Do not use both 'path' and '--ref' argument\")\n    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n    cwd = os.getcwd()\n    path = args.path\n    if args.ref:\n        # TODO: Use path here to open in this path\n        path = conan_api.workspace.open(args.ref, remotes, cwd=cwd)\n    ref = conan_api.workspace.add(path,\n                                  args.name, args.version, args.user, args.channel,\n                                  cwd, args.output_folder, remotes=remotes)\n    ConanOutput().success(\"Reference '{}' added to workspace\".format(ref))\n\n\n@conan_subcommand()\ndef workspace_remove(conan_api: ConanAPI, parser, subparser, *args):\n    \"\"\"\n    Remove packages from the current workspace\n    \"\"\"\n    subparser.add_argument('path',\n                           help='Path to the package folder in the user workspace')\n    args = parser.parse_args(*args)\n    removed = conan_api.workspace.remove(make_abs_path(args.path))\n    ConanOutput().info(f\"Removed from workspace: {removed}\")\n\n\ndef print_json(data):\n    results = data[\"info\"]\n    myjson = json.dumps(results, indent=4)\n    cli_out_write(myjson)\n\n\ndef _print_workspace_info(data):\n    print_serial(data[\"info\"])\n\n\n@conan_subcommand(formatters={\"text\": _print_workspace_info, \"json\": print_json})\ndef workspace_info(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n    \"\"\"\n    Display info for current workspace\n    \"\"\"\n    parser.parse_args(*args)\n    return {\"info\": conan_api.workspace.info()}\n\n\n@conan_subcommand()\ndef workspace_build(conan_api: ConanAPI, parser, subparser, *args):\n    \"\"\"\n    Call \"conan build\" for packages in the workspace, in the right order\n    \"\"\"\n    _install_build(conan_api, parser, subparser, True, *args)\n\n\n@conan_subcommand()\ndef workspace_install(conan_api: ConanAPI, parser, subparser, *args):\n    \"\"\"\n    Call \"conan install\" for packages in the workspace, in the right order\n    \"\"\"\n    _install_build(conan_api, parser, subparser, False, *args)\n\n\ndef _install_build(conan_api: ConanAPI, parser, subparser, build, *args):\n    subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n    add_common_install_arguments(subparser)\n    add_lockfile_args(subparser)\n    args = parser.parse_args(*args)\n    # Basic collaborators: remotes, lockfile, profiles\n    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n    overrides = eval(args.lockfile_overrides) if args.lockfile_overrides else None\n    # The lockfile by default if not defined will be read from the root workspace folder\n    ws_folder = conan_api.workspace.folder()\n    lockfile = conan_api.lockfile.get_lockfile(lockfile=args.lockfile, conanfile_path=ws_folder,\n                                               cwd=None, partial=args.lockfile_partial,\n                                               overrides=overrides)\n    profile_host, profile_build = conan_api.profiles.get_profiles_from_args(args)\n    print_profiles(profile_host, profile_build)\n\n    buildmode = args.build\n    if build and (not buildmode or \"editable\" not in buildmode):\n        ConanOutput().info(\"Adding '--build=editable' as build mode\")\n        buildmode = buildmode or []\n        buildmode.append(\"editable\")\n\n    all_editables = conan_api.workspace.packages()\n    packages = conan_api.workspace.select_packages(args.pkg)\n    ConanOutput().box(\"Workspace computing the build order\")\n    install_order = conan_api.workspace.build_order(packages, profile_host, profile_build, buildmode,\n                                                    lockfile, remotes, args, update=args.update)\n\n    msg = \"build\" if build else \"install\"\n    ConanOutput().box(f\"Workspace {msg}ing each package\")\n    order = install_order.install_build_order()\n\n    profile_args = ProfileArgs.from_args(args)\n    for level in order[\"order\"]:\n        for elem in level:\n            ref = RecipeReference.loads(elem[\"ref\"])\n            for package_level in elem[\"packages\"]:\n                for package in package_level:\n                    if package[\"binary\"] == \"Build\":  # Build external to Workspace\n                        cmd = f'install {package[\"build_args\"]} {profile_args}'\n                        ConanOutput().box(f\"Workspace building external {ref}\")\n                        ConanOutput().info(f\"Command: {cmd}\\n\")\n                        conan_api.command.run(cmd)\n                    elif package[\"binary\"] in (\"Editable\", \"EditableBuild\"):\n                        path = all_editables[ref][\"path\"]\n                        output_folder = all_editables[ref].get(\"output_folder\")\n                        build_arg = \"--build-require\" if package[\"context\"] == \"build\" else \"\"\n                        ref_args = \" \".join(f\"--{k}={getattr(ref, k)}\"\n                                            for k in (\"name\", \"version\", \"user\", \"channel\")\n                                            if getattr(ref, k, None))\n                        of_arg = f'-of=\"{output_folder}\"' if output_folder else \"\"\n                        # TODO: Missing --lockfile-overrides arg here\n                        command = \"build\" if build else \"install\"\n                        cmd = f'{command} \"{path}\" {profile_args} {build_arg} {ref_args} {of_arg}'\n                        ConanOutput().box(f\"Workspace {command}: {ref}\")\n                        ConanOutput().info(f\"Command: {cmd}\\n\")\n                        conan_api.command.run(cmd)\n\n\n@conan_subcommand()\ndef workspace_super_install(conan_api: ConanAPI, parser, subparser, *args):\n    \"\"\"\n    Install the workspace as a monolith, installing only external dependencies to the workspace,\n    generating a single result (generators, etc) for the whole workspace.\n    \"\"\"\n    subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n    subparser.add_argument(\"-g\", \"--generator\", action=\"append\", help='Generators to use')\n    subparser.add_argument(\"-of\", \"--output-folder\",\n                           help='The root output folder for generated and build files')\n    subparser.add_argument(\"--envs-generation\", default=None, choices=[\"false\"],\n                           help=\"Generation strategy for virtual environment files for the root\")\n    add_common_install_arguments(subparser)\n    add_lockfile_args(subparser)\n    args = parser.parse_args(*args)\n    # Basic collaborators: remotes, lockfile, profiles\n    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n    overrides = eval(args.lockfile_overrides) if args.lockfile_overrides else None\n    # The lockfile by default if not defined will be read from the root workspace folder\n    ws_folder = conan_api.workspace.folder()\n    lockfile = conan_api.lockfile.get_lockfile(lockfile=args.lockfile, conanfile_path=ws_folder,\n                                               cwd=None,\n                                               partial=args.lockfile_partial, overrides=overrides)\n    profile_host, profile_build = conan_api.profiles.get_profiles_from_args(args)\n    print_profiles(profile_host, profile_build)\n\n    # Build a dependency graph with all editables as requirements\n    requires = conan_api.workspace.select_packages(args.pkg)\n    deps_graph = conan_api.graph.load_graph_requires(requires, [],\n                                                     profile_host, profile_build, lockfile,\n                                                     remotes, args.build, args.update)\n    deps_graph.report_graph_error()\n    print_graph_basic(deps_graph)\n\n    # Collapsing the graph\n    ws_graph = conan_api.workspace.super_build_graph(deps_graph, profile_host, profile_build)\n    ConanOutput().subtitle(\"Collapsed graph\")\n    print_graph_basic(ws_graph)\n\n    conan_api.graph.analyze_binaries(ws_graph, args.build, remotes=remotes, update=args.update,\n                                     lockfile=lockfile)\n    print_graph_packages(ws_graph)\n    conan_api.install.install_binaries(deps_graph=ws_graph, remotes=remotes)\n    output_folder = make_abs_path(args.output_folder) if args.output_folder else None\n    conan_api.install.install_consumer(ws_graph, args.generator, ws_folder, output_folder,\n                                       envs_generation=args.envs_generation)\n\n\n@conan_subcommand()\ndef workspace_clean(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n    \"\"\"\n    Clean the temporary build folders when possible\n    \"\"\"\n    parser.parse_args(*args)\n    conan_api.workspace.clean()\n\n\n@conan_subcommand()\ndef workspace_init(conan_api: ConanAPI, parser, subparser, *args):\n    \"\"\"\n    Clean the temporary build folders when possible\n    \"\"\"\n    subparser.add_argument(\"path\", nargs=\"?\", default=os.getcwd(),\n                        help=\"Path to a folder where the workspace will be initialized. \"\n                             \"If  does not exist\")\n    args = parser.parse_args(*args)\n    conan_api.workspace.init(args.path)\n\n\n@conan_subcommand()\ndef workspace_create(conan_api: ConanAPI, parser, subparser, *args):\n    \"\"\"\n    Call \"conan create\" for packages in the workspace, in the correct order.\n    Packages will be created in the Conan cache, not locally\n    \"\"\"\n    subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n    add_common_install_arguments(subparser)\n    add_lockfile_args(subparser)\n    args = parser.parse_args(*args)\n    # Basic collaborators: remotes, lockfile, profiles\n    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n    overrides = eval(args.lockfile_overrides) if args.lockfile_overrides else None\n    # The lockfile by default if not defined will be read from the root workspace folder\n    ws_folder = conan_api.workspace.folder()\n    lockfile = conan_api.lockfile.get_lockfile(lockfile=args.lockfile, conanfile_path=ws_folder,\n                                               cwd=None,\n                                               partial=args.lockfile_partial, overrides=overrides)\n    profile_host, profile_build = conan_api.profiles.get_profiles_from_args(args)\n    print_profiles(profile_host, profile_build)\n\n    build_mode = args.build if args.build else []\n    ConanOutput().box(\"Exporting workspace recipes to Conan cache\")\n    exported_refs = conan_api.workspace.export()\n    build_mode.extend(f\"missing:{r}\" for r in exported_refs)\n\n    all_packages = conan_api.workspace.packages()\n    packages = conan_api.workspace.select_packages(args.pkg)\n\n    # If we don't disable the workspace, then, the packages are not created in the Conan cache,\n    # but locally in the user folders, are they are intercepted as editables\n    conan_api.workspace.enable(False)\n\n    install_order = conan_api.workspace.build_order(packages, profile_host, profile_build,\n                                                    build_mode, lockfile, remotes, args,\n                                                    update=args.update)\n\n    ConanOutput().box(\"Workspace creating each package\")\n    order = install_order.install_build_order()\n\n    profile_args = ProfileArgs.from_args(args)\n    for level in order[\"order\"]:\n        for elem in level:\n            ref = RecipeReference.loads(elem[\"ref\"])\n            for package_level in elem[\"packages\"]:\n                for package in package_level:\n                    if package[\"binary\"] not in (\"Build\", \"EditableBuild\"):\n                        ConanOutput().info(f\"Skip build for {ref} binary: {package['binary']}\")\n                        continue\n\n                    if ref not in all_packages:\n                        # Build external to Workspace\n                        cmd = f'install {package[\"build_args\"]} {profile_args}'\n                        ConanOutput().box(f\"Workspace building external {ref}\")\n                        ConanOutput().info(f\"Build command: {cmd}\\n\")\n                        conan_api.command.run(cmd)\n                    else:  # Package in workspace\n                        path = packages[ref][\"path\"]\n                        # TODO: Missing --lockfile-overrides arg here\n                        build = \"--build-require\" if package[\"context\"] == \"build\" else \"\"\n                        ref_args = \" \".join(f\"--{k}={getattr(ref, k)}\"\n                                            for k in (\"name\", \"version\", \"user\", \"channel\")\n                                            if getattr(ref, k, None))\n                        cmd = f'create \"{path}\" {profile_args} {build} {ref_args}'\n                        ConanOutput().box(f\"Workspace create {ref}\")\n                        ConanOutput().info(f\"Conan create command: {cmd}\\n\")\n                        conan_api.command.run(cmd)\n\n\n@conan_subcommand()\ndef workspace_source(conan_api: ConanAPI, parser, subparser, *args):\n    \"\"\"\n    Call the source() method of packages in the workspace\n    \"\"\"\n    subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n    args = parser.parse_args(*args)\n\n    remotes = conan_api.remotes.list()  # In case \"python_requires\" are needed\n    packages = conan_api.workspace.select_packages(args.pkg)\n\n    ConanOutput().box(\"Workspace getting sources\")\n    for pkg, info in packages.items():\n        conan_api.local.source(info[\"path\"], name=pkg.name, version=str(pkg.version),\n                               user=pkg.user, channel=pkg.channel, remotes=remotes)\n\n\n@conan_command(group=\"Consumer\")\ndef workspace(conan_api, parser, *args):  # noqa\n    \"\"\"\n    Manage Conan workspaces (group of packages in editable mode)\n    \"\"\"\n    if (WorkspaceAPI.TEST_ENABLED or os.getenv(\"CONAN_WORKSPACE_ENABLE\")) != \"will_break_next\":\n        raise ConanException(\"Workspace command disabled without CONAN_WORKSPACE_ENABLE env var,\"\n                             \"please read the docs about this 'incubating' feature\")\n","numLines":346,"startLine":1,"totalLines":346}}}
