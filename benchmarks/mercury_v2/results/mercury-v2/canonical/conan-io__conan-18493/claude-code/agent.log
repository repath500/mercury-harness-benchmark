{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-b8b0e2fa0701438d","type":"tool_result","content":"1\tfrom conan.api.subapi.new import NewAPI\n2\tfrom conan.internal.api.new.cmake_exe import cmake_exe_files\n3\tfrom conan.internal.api.new.cmake_lib import cmake_lib_files\n4\t\n5\t\n6\tconanws_yml = \"\"\"\\\n7\tpackages:\n8\t  liba/0.1:\n9\t    path: liba\n10\t  libb/0.1:\n11\t    path: libb\n12\t  app1/0.1:\n13\t    path: app1\n14\t\"\"\"\n15\t\n16\tcmake = \"\"\"\\\n17\tcmake_minimum_required(VERSION 3.25)\n18\tproject(monorepo CXX)\n19\t\n20\tinclude(FetchContent)\n21\t\n22\tfunction(add_project SUBFOLDER)\n23\t    message(STATUS \"Adding project ${SUBFOLDER}\")\n24\t    FetchContent_Declare(\n25\t        ${SUBFOLDER}\n26\t        SOURCE_DIR ${CMAKE_CURRENT_LIST_DIR}/${SUBFOLDER}\n27\t        SYSTEM\n28\t        OVERRIDE_FIND_PACKAGE\n29\t    )\n30\t    FetchContent_MakeAvailable(${SUBFOLDER})\n31\tendfunction()\n32\t\n33\tadd_project(liba)\n34\t# They should be defined in the liba/CMakeLists.txt, but we can fix it here\n35\tadd_library(liba::liba ALIAS liba)\n36\tadd_project(libb)\n37\tadd_library(libb::libb ALIAS libb)\n38\tadd_project(app1)\n39\t\"\"\"\n40\t\n41\tconanfile = '''\\\n42\tfrom conan import Workspace\n43\tfrom conan import ConanFile\n44\tfrom conan.tools.cmake import CMakeDeps, CMakeToolchain, cmake_layout\n45\t\n46\t\n47\tclass MyWs(ConanFile):\n48\t    \"\"\" This is a special conanfile, used only for workspace definition of layout\n49\t    and generators. It shouldn't have requirements, tool_requirements. It shouldn't have\n50\t    build() or package() methods\n51\t    \"\"\"\n52\t    settings = \"os\", \"compiler\", \"build_type\", \"arch\"\n53\t\n54\t    def generate(self):\n55\t        deps = CMakeDeps(self)\n56\t        deps.generate()\n57\t        tc = CMakeToolchain(self)\n58\t        tc.generate()\n59\t\n60\t    def layout(self):\n61\t        cmake_layout(self)\n62\t\n63\t\n64\tclass Ws(Workspace):\n65\t    def root_conanfile(self):\n66\t        return MyWs\n67\t'''\n68\t\n69\tworkspace_files = {\"conanws.yml\": conanws_yml,\n70\t                   \"CMakeLists.txt\": cmake,\n71\t                   \"conanws.py\": conanfile,\n72\t                   \".gitignore\": \"build\"}\n73\t# liba\n74\tfiles = {f\"liba/{k}\": v for k, v in cmake_lib_files.items()}\n75\tworkspace_files.update(files)\n76\t# libb\n77\tfiles = NewAPI.render(cmake_lib_files, {\"requires\": [\"liba/0.1\"], \"name\": \"libb\"})\n78\tfiles = {f\"libb/{k}\": v for k, v in files.items()}\n79\tworkspace_files.update(files)\n80\t# app\n81\tfiles = NewAPI.render(cmake_exe_files, definitions={\"name\": \"app1\", \"requires\": [\"libb/0.1\"]})\n82\tfiles = {f\"app1/{k}\": v for k, v in files.items()}\n83\tworkspace_files.update(files)\n84\t"}]},"parent_tool_use_id":null,"session_id":"a035cbe5-8923-4731-8824-502460b30912","uuid":"e0807606-4818-46cc-9992-71d3cb846b1b","timestamp":"2026-09-04T09:08:43.134Z","tool_use_result":{"type":"text","file":{"filePath":"/testbed/conan/internal/api/new/workspace.py","content":"from conan.api.subapi.new import NewAPI\nfrom conan.internal.api.new.cmake_exe import cmake_exe_files\nfrom conan.internal.api.new.cmake_lib import cmake_lib_files\n\n\nconanws_yml = \"\"\"\\\npackages:\n  liba/0.1:\n    path: liba\n  libb/0.1:\n    path: libb\n  app1/0.1:\n    path: app1\n\"\"\"\n\ncmake = \"\"\"\\\ncmake_minimum_required(VERSION 3.25)\nproject(monorepo CXX)\n\ninclude(FetchContent)\n\nfunction(add_project SUBFOLDER)\n    message(STATUS \"Adding project ${SUBFOLDER}\")\n    FetchContent_Declare(\n        ${SUBFOLDER}\n        SOURCE_DIR ${CMAKE_CURRENT_LIST_DIR}/${SUBFOLDER}\n        SYSTEM\n        OVERRIDE_FIND_PACKAGE\n    )\n    FetchContent_MakeAvailable(${SUBFOLDER})\nendfunction()\n\nadd_project(liba)\n# They should be defined in the liba/CMakeLists.txt, but we can fix it here\nadd_library(liba::liba ALIAS liba)\nadd_project(libb)\nadd_library(libb::libb ALIAS libb)\nadd_project(app1)\n\"\"\"\n\nconanfile = '''\\\nfrom conan import Workspace\nfrom conan import ConanFile\nfrom conan.tools.cmake import CMakeDeps, CMakeToolchain, cmake_layout\n\n\nclass MyWs(ConanFile):\n    \"\"\" This is a special conanfile, used only for workspace definition of layout\n    and generators. It shouldn't have requirements, tool_requirements. It shouldn't have\n    build() or package() methods\n    \"\"\"\n    settings = \"os\", \"compiler\", \"build_type\", \"arch\"\n\n    def generate(self):\n        deps = CMakeDeps(self)\n        deps.generate()\n        tc = CMakeToolchain(self)\n        tc.generate()\n\n    def layout(self):\n        cmake_layout(self)\n\n\nclass Ws(Workspace):\n    def root_conanfile(self):\n        return MyWs\n'''\n\nworkspace_files = {\"conanws.yml\": conanws_yml,\n                   \"CMakeLists.txt\": cmake,\n                   \"conanws.py\": conanfile,\n                   \".gitignore\": \"build\"}\n# liba\nfiles = {f\"liba/{k}\": v for k, v in cmake_lib_files.items()}\nworkspace_files.update(files)\n# libb\nfiles = NewAPI.render(cmake_lib_files, {\"requires\": [\"liba/0.1\"], \"name\": \"libb\"})\nfiles = {f\"libb/{k}\": v for k, v in files.items()}\nworkspace_files.update(files)\n# app\nfiles = NewAPI.render(cmake_exe_files, definitions={\"name\": \"app1\", \"requires\": [\"libb/0.1\"]})\nfiles = {f\"app1/{k}\": v for k, v in files.items()}\nworkspace_files.update(files)\n","numLines":84,"startLine":1,"totalLines":84}}}
