{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-8bb2994a782ef4d9","type":"tool_result","content":"1\timport json\n2\timport os\n3\timport shutil\n4\timport textwrap\n5\t\n6\timport pytest\n7\t\n8\tfrom conan.api.subapi.workspace import WorkspaceAPI\n9\tfrom conan.test.assets.genconanfile import GenConanfile\n10\tfrom conan.test.utils.scm import create_local_git_repo\n11\tfrom conan.test.utils.test_files import temp_folder\n12\tfrom conan.test.utils.tools import TestClient\n13\tfrom conan.internal.util.files import save_files\n14\t\n15\tWorkspaceAPI.TEST_ENABLED = \"will_break_next\"\n16\t\n17\t\n18\tclass TestWorkspaceRoot:\n19\t\n20\t    def test_workspace_root(self):\n21\t        c = TestClient(light=True)\n22\t        # Just check the root command works\n23\t        c.run(\"workspace root\", assert_error=True)\n24\t        assert \"ERROR: Workspace not defined, please create\" in c.out\n25\t\n26\t        # error, conanws/ folder does not contain conanws.[py | yml]\n27\t        c.save({\"conanws/test.txt\": \"\"})\n28\t        with c.chdir(\"conanws\"):\n29\t            c.run(\"workspace root\", assert_error=True)\n30\t            assert \"ERROR: Workspace not defined, please create\" in c.out\n31\t            c.save({\"conanws.yml\": \"\"})\n32\t            c.run(\"workspace root\")\n33\t            assert c.current_folder in c.stdout\n34\t\n35\t        # error, empty .py\n36\t        c.save({\"conanws.py\": \"\"}, clean_first=True)\n37\t        c.run(\"workspace root\", assert_error=True)\n38\t        assert \"Error loading conanws.py\" in c.out\n39\t        assert \"No subclass of Workspace\" in c.out\n40\t\n41\t        c.save({\"conanws.yml\": \"\"}, clean_first=True)\n42\t        c.run(\"workspace root\")\n43\t        assert c.current_folder in c.stdout\n44\t\n45\t\n46\tclass TestAddRemove:\n47\t\n48\t    def test_add(self):\n49\t        c = TestClient(light=True)\n50\t        c.save({\"conanws.yml\": \"\",\n51\t                \"dep1/conanfile.py\": GenConanfile(\"dep1\", \"0.1\"),\n52\t                \"dep2/conanfile.py\": GenConanfile(\"dep2\", \"0.1\"),\n53\t                \"dep3/conanfile.py\": GenConanfile(\"dep3\", \"0.1\")})\n54\t        c.run(\"workspace add dep1\")\n55\t        assert \"Reference 'dep1/0.1' added to workspace\" in c.out\n56\t        c.run(\"workspace info\")\n57\t        assert \"dep1/0.1\" in c.out\n58\t        assert \"dep2\" not in c.out\n59\t        c.run(\"editable list\")  # No editables in global\n60\t        assert \"dep1\" not in c.out\n61\t        assert \"dep2\" not in c.out\n62\t        c.run(\"workspace add dep2\")\n63\t        assert \"Reference 'dep2/0.1' added to workspace\" in c.out\n64\t        c.run(\"workspace info\")\n65\t        assert \"dep1/0.1\" in c.out\n66\t        assert \"dep2/0.1\" in c.out\n67\t\n68\t        with c.chdir(temp_folder()):  # If we move to another folder, outside WS, no editables\n69\t            c.run(\"editable list\")\n70\t            assert \"dep1\" not in c.out\n71\t            assert \"dep2\" not in c.out\n72\t\n73\t        c.run(\"workspace info\")\n74\t        assert \"dep1/0.1\" in c.out\n75\t        assert \"dep2/0.1\" in c.out\n76\t\n77\t        c.run(\"workspace remove dep1\")\n78\t        c.run(\"workspace info\")\n79\t        assert \"dep1/0.1\" not in c.out\n80\t        assert \"dep2/0.1\" in c.out\n81\t\n82\t        c.run(\"workspace remove dep2\")\n83\t        c.run(\"workspace info\")\n84\t        assert \"dep1/0.1\" not in c.out\n85\t        assert \"dep2/0.1\" not in c.out\n86\t\n87\t    def test_add_from_outside(self):\n88\t        c = TestClient(light=True)\n89\t        c.save({\"sub/conanws.yml\": \"\",\n90\t                \"sub/dep1/conanfile.py\": GenConanfile(\"dep1\", \"0.1\"),\n91\t                \"sub/dep2/conanfile.py\": GenConanfile(\"dep2\", \"0.1\")})\n92\t        with c.chdir(\"sub\"):\n93\t            c.run(\"workspace add dep1\")\n94\t            assert \"Reference 'dep1/0.1' added to workspace\" in c.out\n95\t            c.run(\"workspace add dep2\")\n96\t            assert \"Reference 'dep2/0.1' added to workspace\" in c.out\n97\t            c.run(\"workspace info\")\n98\t            assert \"dep1/0.1\" in c.out\n99\t            assert \"dep2/0.1\" in c.out\n100\t        assert c.load_home(\"editable_packages.json\") is None\n101\t\n102\t        c.run(\"editable list\")\n103\t        assert \"dep1\" not in c.out\n104\t        assert \"dep2\" not in c.out\n105\t        assert c.load_home(\"editable_packages.json\") is None\n106\t        with c.chdir(\"sub\"):\n107\t            c.run(\"editable add dep1\")\n108\t            assert c.load_home(\"editable_packages.json\") is not None\n109\t            c.run(\"editable list\")\n110\t            assert \"dep1/0.1\" in c.out\n111\t            assert \"dep2/0.1\" not in c.out\n112\t            c.run(\"workspace info\")\n113\t            assert \"dep1\" in c.out\n114\t            assert \"dep2\" in c.out\n115\t\n116\t        c.run(\"editable list\")\n117\t        assert \"dep1/0.1\" in c.out\n118\t        assert \"dep2\" not in c.out\n119\t\n120\t    @pytest.mark.parametrize(\"api\", [False, True])\n121\t    def test_dynamic_editables(self, api):\n122\t        c = TestClient(light=True)\n123\t        conanfile = textwrap.dedent(\"\"\"\n124\t            import os\n125\t            from conan import ConanFile\n126\t            from conan.tools.files import load\n127\t            class Lib(ConanFile):\n128\t                def set_name(self):\n129\t                    self.name = load(self, os.path.join(self.recipe_folder, \"name.txt\"))\n130\t                def set_version(self):\n131\t                    self.version = load(self, os.path.join(self.recipe_folder, \"version.txt\"))\n132\t            \"\"\")\n133\t        if not api:\n134\t            workspace = textwrap.dedent(\"\"\"\\\n135\t                import os\n136\t                from conan import Workspace\n137\t\n138\t                class MyWorkspace(Workspace):\n139\t                    def packages(self):\n140\t                        result = {}\n141\t                        for f in os.listdir(self.folder):\n142\t                            if os.path.isdir(os.path.join(self.folder, f)):\n143\t                                full_path = os.path.join(self.folder, f, \"name.txt\")\n144\t                                name = open(full_path).read().strip()\n145\t                                version = open(os.path.join(self.folder, f,\n146\t                                                            \"version.txt\")).read().strip()\n147\t                                result[f\"{name}/{version}\"] = {\"path\": f}\n148\t                        return result\n149\t                \"\"\")\n150\t        else:\n151\t            workspace = textwrap.dedent(\"\"\"\\\n152\t                import os\n153\t                from conan import Workspace\n154\t\n155\t                class MyWorkspace(Workspace):\n156\t                    def packages(self):\n157\t                        result = {}\n158\t                        for f in os.listdir(self.folder):\n159\t                            if os.path.isdir(os.path.join(self.folder, f)):\n160\t                                conanfile = self.load_conanfile(f)\n161\t                                result[f\"{conanfile.name}/{conanfile.version}\"] = {\"path\": f}\n162\t                        return result\n163\t               \"\"\")\n164\t\n165\t        c.save({\"conanws.py\": workspace,\n166\t                \"dep1/conanfile.py\": conanfile,\n167\t                \"dep1/name.txt\": \"pkg\",\n168\t                \"dep1/version.txt\": \"2.1\"})\n169\t        c.run(\"workspace info --format=json\")\n170\t        info = json.loads(c.stdout)\n171\t        assert info[\"packages\"] == {\"pkg/2.1\": {\"path\": \"dep1\"}}\n172\t        c.save({\"dep1/name.txt\": \"other\",\n173\t                \"dep1/version.txt\": \"14.5\"})\n174\t        c.run(\"workspace info --format=json\")\n175\t        info = json.loads(c.stdout)\n176\t        assert info[\"packages\"] == {\"other/14.5\": {\"path\": \"dep1\"}}\n177\t        c.run(\"install --requires=other/14.5\")\n178\t        # Doesn't fail\n179\t        assert \"other/14.5 - Editable\" in c.out\n180\t        with c.chdir(\"dep1\"):\n181\t            c.run(\"install --requires=other/14.5\")\n182\t            # Doesn't fail\n183\t            assert \"other/14.5 - Editable\" in c.out\n184\t\n185\t    def test_api_dynamic_version_run(self):\n186\t        # https://github.com/conan-io/conan/issues/17306\n187\t        c = TestClient(light=True)\n188\t        conanfile = textwrap.dedent(\"\"\"\n189\t            from io import StringIO\n190\t            from conan import ConanFile\n191\t            class Lib(ConanFile):\n192\t                name= \"pkg\"\n193\t                def set_version(self):\n194\t                    my_buf = StringIO()\n195\t                    self.run('echo 2.1', stdout=my_buf)\n196\t                    self.version = my_buf.getvalue().strip()\n197\t            \"\"\")\n198\t\n199\t        workspace = textwrap.dedent(\"\"\"\\\n200\t            import os\n201\t            from conan import Workspace\n202\t\n203\t            class MyWorkspace(Workspace):\n204\t                def packages(self):\n205\t                    conanfile = self.load_conanfile(\"dep1\")\n206\t                    return {f\"{conanfile.name}/{conanfile.version}\": {\"path\": \"dep1\"}}\n207\t            \"\"\")\n208\t\n209\t        c.save({\"conanws.py\": workspace,\n210\t                \"dep1/conanfile.py\": conanfile})\n211\t        c.run(\"workspace info --format=json\")\n212\t        info = json.loads(c.stdout)\n213\t        assert info[\"packages\"] == {\"pkg/2.1\": {\"path\": \"dep1\"}}\n214\t        c.run(\"install --requires=pkg/2.1\")\n215\t        # it will not fail\n216\t\n217\t    def test_error_uppercase(self):\n218\t        c = TestClient(light=True)\n219\t        c.save({\"conanws.yml\": \"\",\n220\t                \"conanfile.py\": GenConanfile(\"Pkg\", \"0.1\")})\n221\t        c.run(\"workspace add .\", assert_error=True)\n222\t        assert \"ERROR: Conan packages names 'Pkg/0.1' must be all lowercase\" in c.out\n223\t        c.save({\"conanfile.py\": GenConanfile()})\n224\t        c.run(\"workspace add . --name=Pkg --version=0.1\", assert_error=True)\n225\t        assert \"ERROR: Conan packages names 'Pkg/0.1' must be all lowercase\" in c.out\n226\t\n227\t    def test_add_open_error(self):\n228\t        c = TestClient(light=True)\n229\t        c.save({\"conanws.yml\": \"\",\n230\t                \"dep/conanfile.py\": GenConanfile(\"dep\", \"0.1\")})\n231\t        c.run(\"workspace add dep\")\n232\t        c.run(\"workspace open dep/0.1\", assert_error=True)\n233\t        assert \"ERROR: Can't open a dependency that is already an editable: dep/0.1\" in c.out\n234\t\n235\t    def test_remove_product(self):\n236\t        c = TestClient(light=True)\n237\t        c.save({\"conanws.yml\": \"\",\n238\t                \"mydeppkg/conanfile.py\": GenConanfile(\"mydeppkg\", \"0.1\")})\n239\t        c.run(\"workspace add mydeppkg\")\n240\t        c.run(\"workspace remove mydeppkg\")\n241\t        c.run(\"workspace info\")\n242\t        assert \"mydeppkg\" not in c.out\n243\t\n244\t    def test_remove_removed_folder(self):\n245\t        c = TestClient(light=True)\n246\t        c.save({\"conanws.yml\": \"\",\n247\t                \"mydeppkg/conanfile.py\": GenConanfile(\"mydeppkg\", \"0.1\")})\n248\t        c.run(\"workspace add mydeppkg\")\n249\t        # If we now remove the folder\n250\t        shutil.rmtree(os.path.join(c.current_folder, \"mydeppkg\"))\n251\t        # It can still be removed by path, even if the path doesn't exist\n252\t        c.run(\"workspace remove mydeppkg\")\n253\t        assert \"Removed from workspace: mydeppkg/0.1\" in c.out\n254\t        c.run(\"workspace info\")\n255\t        assert \"mydeppkg\" not in c.out\n256\t\n257\t    def test_custom_add_remove(self):\n258\t        c = TestClient(light=True)\n259\t\n260\t        workspace = textwrap.dedent(\"\"\"\\\n261\t            import os\n262\t            from conan import Workspace\n263\t\n264\t            class MyWorkspace(Workspace):\n265\t                def name(self):\n266\t                    return \"myws\"\n267\t\n268\t                def add(self, ref, path, *args, **kwargs):\n269\t                    self.output.info(f\"Adding {ref} at {path}\")\n270\t                    super().add(ref, path, *args, **kwargs)\n271\t\n272\t                def remove(self, path, *args, **kwargs):\n273\t                    self.output.info(f\"Removing {path}\")\n274\t                    return super().remove(path, *args, **kwargs)\n275\t            \"\"\")\n276\t\n277\t        c.save({\"conanws.py\": workspace,\n278\t                \"dep/conanfile.py\": GenConanfile(\"dep\", \"0.1\")})\n279\t        c.run(\"workspace add dep\")\n280\t        assert \"myws: Adding dep/0.1\" in c.out\n281\t        c.run(\"workspace info\")\n282\t        assert \"dep/0.1\" in c.out\n283\t        c.run(\"workspace remove dep\")\n284\t        assert \"myws: Removing\" in c.out\n285\t        c.run(\"workspace info\")\n286\t        assert \"dep/0.1\" not in c.out\n287\t\n288\t\n289\tclass TestOpenAdd:\n290\t    def test_without_git(self):\n291\t        t = TestClient(default_server_user=True, light=True)\n292\t        t.save({\"conanfile.py\": GenConanfile(\"pkg\", \"0.1\")})\n293\t        t.run(\"create .\")\n294\t        t.run(\"upload * -r=default -c\")\n295\t\n296\t        c = TestClient(servers=t.servers, light=True)\n297\t        c.run(f\"workspace open pkg/0.1\")\n298\t        assert \"name = 'pkg'\" in c.load(\"pkg/conanfile.py\")\n299\t\n300\t        # The add should work the same\n301\t        c2 = TestClient(servers=t.servers, light=True)\n302\t        c2.save({\"conanws.yml\": \"\"})\n303\t        c2.run(f\"workspace add --ref=pkg/0.1\")\n304\t        assert \"name = 'pkg'\" in c2.load(\"pkg/conanfile.py\")\n305\t        c2.run(\"workspace info\")\n306\t        assert \"pkg/0.1\" in c2.out\n307\t\n308\t    def test_without_git_export_sources(self):\n309\t        t = TestClient(default_server_user=True, light=True)\n310\t        t.save({\"conanfile.py\": GenConanfile(\"pkg\", \"0.1\").with_exports_sources(\"*.txt\"),\n311\t                \"CMakeLists.txt\": \"mycmake\"})\n312\t        t.run(\"create .\")\n313\t        t.run(\"upload * -r=default -c\")\n314\t\n315\t        c = TestClient(servers=t.servers)\n316\t        c.run(\"workspace open pkg/0.1\")\n317\t        assert \"name = 'pkg'\" in c.load(\"pkg/conanfile.py\")\n318\t        assert \"mycmake\" in c.load(\"pkg/CMakeLists.txt\")\n319\t\n320\t    def test_workspace_git_scm(self):\n321\t        folder = temp_folder()\n322\t        conanfile = textwrap.dedent(\"\"\"\n323\t            from conan import ConanFile\n324\t            from conan.tools.scm import Git\n325\t\n326\t            class Pkg(ConanFile):\n327\t                name = \"pkg\"\n328\t                version = \"0.1\"\n329\t                def export(self):\n330\t                    git = Git(self)\n331\t                    git.coordinates_to_conandata()\n332\t            \"\"\")\n333\t        url, commit = create_local_git_repo(files={\"conanfile.py\": conanfile}, folder=folder,\n334\t                                            branch=\"mybranch\")\n335\t        t1 = TestClient(default_server_user=True, light=True)\n336\t        t1.run_command('git clone \"file://{}\" .'.format(url))\n337\t        t1.run(\"create .\")\n338\t        t1.run(\"upload * -r=default -c\")\n339\t\n340\t        c = TestClient(servers=t1.servers, light=True)\n341\t        c.run(\"workspace open pkg/0.1\")\n342\t        assert c.load(\"pkg/conanfile.py\") == conanfile\n343\t\n344\t        c2 = TestClient(servers=t1.servers, light=True)\n345\t        c2.save({\"conanws.yml\": \"\"})\n346\t        c2.run(f\"workspace add --ref=pkg/0.1\")\n347\t        assert 'name = \"pkg\"' in c2.load(\"pkg/conanfile.py\")\n348\t        c2.run(\"workspace info\")\n349\t        assert \"pkg/0.1\" in c2.out\n350\t\n351\t    def test_workspace_build_editables(self):\n352\t        c = TestClient(light=True)\n353\t        c.save({\"conanws.yml\": \"\"})\n354\t\n355\t        c.save({\"pkga/conanfile.py\": GenConanfile(\"pkga\", \"0.1\").with_build_msg(\"BUILD PKGA!\"),\n356\t                \"pkgb/conanfile.py\": GenConanfile(\"pkgb\", \"0.1\").with_build_msg(\"BUILD PKGB!\")\n357\t                                                                .with_requires(\"pkga/0.1\")})\n358\t        c.run(\"workspace add pkga\")\n359\t        c.run(\"workspace add pkgb\")\n360\t\n361\t        c.run(\"install --requires=pkgb/0.1 --build=editable\")\n362\t        c.assert_listed_binary({\"pkga/0.1\": (\"da39a3ee5e6b4b0d3255bfef95601890afd80709\",\n363\t                                             \"EditableBuild\"),\n364\t                                \"pkgb/0.1\": (\"47a5f20ec8fb480e1c5794462089b01a3548fdc5\",\n365\t                                             \"EditableBuild\")})\n366\t        assert \"pkga/0.1: WARN: BUILD PKGA!\" in c.out\n367\t        assert \"pkgb/0.1: WARN: BUILD PKGB!\" in c.out\n368\t\n369\t\n370\tclass TestWorkspaceBuild:\n371\t\n372\t    def test_build(self):\n373\t        c = TestClient(light=True)\n374\t        c.save({\"conanws.yml\": \"\"})\n375\t\n376\t        c.save({\"pkga/conanfile.py\": GenConanfile(\"pkga\", \"0.1\").with_build_msg(\"BUILD PKGA!\"),\n377\t                \"pkgb/conanfile.py\": GenConanfile(\"pkgb\", \"0.1\").with_build_msg(\"BUILD PKGB!\")\n378\t               .with_requires(\"pkga/0.1\")})\n379\t        c.run(\"workspace add pkga\")\n380\t        c.run(\"workspace add pkgb\")\n381\t        c.run(\"workspace build\")\n382\t        c.assert_listed_binary({\"pkga/0.1\": (\"da39a3ee5e6b4b0d3255bfef95601890afd80709\",\n383\t                                             \"EditableBuild\")})\n384\t        assert \"conanfile.py (pkga/0.1): WARN: BUILD PKGA!\" in c.out\n385\t        assert \"conanfile.py (pkgb/0.1): WARN: BUILD PKGB!\" in c.out\n386\t\n387\t        # It is also possible to build a specific package by path\n388\t        # equivalent to ``conan build <path> --build=editable``\n389\t        # This can be done even if it is not a product\n390\t        c.run(\"workspace build --pkg=pkgc/*\", assert_error=True)\n391\t        assert \"ERROR: There are no selected packages defined in the workspace\" in c.out\n392\t        c.run(\"workspace build --pkg=pkgb/*\")\n393\t        c.assert_listed_binary({\"pkga/0.1\": (\"da39a3ee5e6b4b0d3255bfef95601890afd80709\",\n394\t                                             \"EditableBuild\")})\n395\t        assert \"conanfile.py (pkga/0.1): WARN: BUILD PKGA!\" in c.out\n396\t        assert \"conanfile.py (pkgb/0.1): WARN: BUILD PKGB!\" in c.out\n397\t\n398\t        c.run(\"workspace build --pkg=pkga/*\")\n399\t        assert \"conanfile.py (pkga/0.1): Calling build()\" in c.out\n400\t        assert \"conanfile.py (pkga/0.1): WARN: BUILD PKGA!\" in c.out\n401\t\n402\t    def test_error_if_no_products(self):\n403\t        c = TestClient(light=True)\n404\t        c.save({\"conanws.yml\": \"\"})\n405\t        c.run(\"workspace build\", assert_error=True)\n406\t        assert \"ERROR: There are no selected packages defined in the workspace\" in c.out\n407\t\n408\t    def test_build_external_missing(self):\n409\t        c = TestClient(light=True)\n410\t        c.save({\"conanws.yml\": \"\"})\n411\t\n412\t        c.save({\"mymath/conanfile.py\": GenConanfile(\"mymath\", \"0.1\").with_build_msg(\"MyMATH!!\"),\n413\t                \"pkga/conanfile.py\": GenConanfile(\"pkga\", \"0.1\").with_build_msg(\"BUILD PKGA!\")\n414\t                                                                .with_requires(\"mymath/0.1\"),\n415\t                \"pkgb/conanfile.py\": GenConanfile(\"pkgb\", \"0.1\").with_build_msg(\"BUILD PKGB!\")\n416\t               .with_requires(\"pkga/0.1\")})\n417\t        c.run(\"export mymath\")\n418\t        c.run(\"workspace add pkga\")\n419\t        c.run(\"workspace add pkgb\")\n420\t        c.run(\"workspace build\", assert_error=True)\n421\t        assert \"ERROR: Missing prebuilt package for 'mymath/0.1'\" in c.out\n422\t        c.run(\"workspace build --build=missing\")\n423\t        assert \"Workspace building external mymath/0.1\" in c.out\n424\t\n425\t    def test_build_dynamic_name_version(self):\n426\t        conanfile = textwrap.dedent(\"\"\"\\\n427\t            from conan import ConanFile\n428\t            class MyConan(ConanFile):\n429\t                def build(self):\n430\t                    self.output.info(f\"Building {self.name} AND {self.version}!!!\")\n431\t            \"\"\")\n432\t        workspace = textwrap.dedent(\"\"\"\\\n433\t            import os\n434\t            from conan import Workspace\n435\t\n436\t            class MyWorkspace(Workspace):\n437\t                def packages(self):\n438\t                    result = {}\n439\t                    for f in os.listdir(self.folder):\n440\t                        if os.path.isdir(os.path.join(self.folder, f)):\n441\t                            result[f\"{f}/0.1\"] = {\"path\": f}\n442\t                    return result\n443\t           \"\"\")\n444\t        c = TestClient(light=True)\n445\t        c.save({\"conanws.py\": workspace,\n446\t                \"pkga/conanfile.py\": conanfile})\n447\t        c.run(\"workspace info\")\n448\t        assert \"pkga/0.1\" in c.out\n449\t        c.run(\"workspace build\")\n450\t        assert \"conanfile.py (pkga/0.1): Building pkga AND 0.1!!!\" in c.out\n451\t\n452\t\n453\tclass TestNew:\n454\t    def test_new(self):\n455\t        # Very basic workspace for testing\n456\t        c = TestClient(light=True)\n457\t        c.run(\"new workspace\")\n458\t        assert 'name = \"liba\"' in c.load(\"liba/conanfile.py\")\n459\t        c.run(\"workspace info\")\n460\t        assert \"liba/0.1\" in c.out\n461\t        assert \"libb/0.1\" in c.out\n462\t        assert \"app1/0.1\" in c.out\n463\t\n464\t    def test_new_dep(self):\n465\t        c = TestClient(light=True)\n466\t        c.run(\"new workspace -d requires=dep/0.1\")\n467\t        assert 'self.requires(\"dep/0.1\")' in c.load(\"liba/conanfile.py\")\n468\t        assert 'name = \"liba\"' in c.load(\"liba/conanfile.py\")\n469\t        c.run(\"workspace info\")\n470\t        assert \"liba/0.1\" in c.out\n471\t        assert \"libb/0.1\" in c.out\n472\t        assert \"app1/0.1\" in c.out\n473\t\n474\t\n475\tclass TestMeta:\n476\t    def test_install(self):\n477\t        c = TestClient()\n478\t        c.save({\"dep/conanfile.py\": GenConanfile()})\n479\t        c.run(\"create dep --name=dep1 --version=0.1\")\n480\t        c.run(\"create dep --name=dep2 --version=0.1\")\n481\t        c.save({\"conanws.yml\": \"\",\n482\t                \"liba/conanfile.py\": GenConanfile(\"liba\", \"0.1\").with_requires(\"dep1/0.1\",\n483\t                                                                               \"dep2/0.1\"),\n484\t                \"libb/conanfile.py\": GenConanfile(\"libb\", \"0.1\").with_requires(\"liba/0.1\",\n485\t                                                                               \"dep1/0.1\")},\n486\t               clean_first=True)\n487\t        c.run(\"workspace add liba\")\n488\t        c.run(\"workspace add libb\")\n489\t        c.run(\"workspace super-install -g CMakeDeps -g CMakeToolchain -of=build --envs-generation=false\")\n490\t        assert \"Workspace conanws.py not found in the workspace folder, using default\" in c.out\n491\t        files = os.listdir(os.path.join(c.current_folder, \"build\"))\n492\t        assert \"conan_toolchain.cmake\" in files\n493\t        assert \"dep1-config.cmake\" in files\n494\t        assert \"dep2-config.cmake\" in files\n495\t        assert \"liba-config.cmake\" not in files\n496\t        assert \"libb-config.cmake\" not in files\n497\t        assert \"conanbuild.bat\" not in files\n498\t        assert \"conanbuild.sh\" not in files\n499\t\n500\t    def test_conanfilews_custom(self):\n501\t        c = TestClient()\n502\t        conanfilews = textwrap.dedent(\"\"\"\n503\t            from conan import ConanFile\n504\t            from conan import Workspace\n505\t\n506\t            class MyWs(ConanFile):\n507\t                settings = \"arch\", \"build_type\"\n508\t                generators = \"MSBuildDeps\"\n509\t\n510\t            class Ws(Workspace):\n511\t                def root_conanfile(self):\n512\t                    return MyWs\n513\t            \"\"\")\n514\t\n515\t        c.save({\"dep/conanfile.py\": GenConanfile(\"dep\", \"0.1\"),\n516\t                \"conanws.py\": conanfilews})\n517\t        c.run(\"workspace add dep\")\n518\t        c.run(\"workspace super-install -of=build\")\n519\t        files = os.listdir(os.path.join(c.current_folder, \"build\"))\n520\t        assert \"conandeps.props\" in files\n521\t\n522\t    def test_conanfilews_errors(self):\n523\t        c = TestClient()\n524\t        conanfilews = textwrap.dedent(\"\"\"\n525\t            from conan import ConanFile\n526\t            from conan import Workspace\n527\t            class MyWs(ConanFile):\n528\t                requires = \"dep/0.1\"\n529\t\n530\t            class Ws(Workspace):\n531\t                def root_conanfile(self):\n532\t                    return MyWs\n533\t            \"\"\")\n534\t\n535\t        c.save({\"conanws.yml\": \"conanfilews: myconanfilews.py\",\n536\t                \"dep/conanfile.py\": GenConanfile(\"dep\", \"0.1\"),\n537\t                \"conanws.py\": conanfilews})\n538\t        c.run(\"workspace super-install\", assert_error=True)\n539\t        assert \"ERROR: There are no selected packages defined in the workspace\" in c.out\n540\t        c.run(\"workspace add dep\")\n541\t        c.run(\"workspace super-install\", assert_error=True)\n542\t        assert \"ERROR: Conanfile in conanws.py shouldn't have 'requires'\" in c.out\n543\t\n544\t    def test_install_partial(self):\n545\t        # If we want to install only some part of the workspace\n546\t        c = TestClient()\n547\t        c.save({\"dep/conanfile.py\": GenConanfile()})\n548\t        c.run(\"create dep --name=dep1 --version=0.1\")\n549\t        c.run(\"create dep --name=dep2 --version=0.1\")\n550\t        c.save({\"conanws.yml\": \"\",\n551\t                \"liba/conanfile.py\": GenConanfile(\"liba\", \"0.1\").with_requires(\"dep1/0.1\"),\n552\t                \"libb/conanfile.py\": GenConanfile(\"libb\", \"0.1\").with_requires(\"liba/0.1\"),\n553\t                \"libc/conanfile.py\": GenConanfile(\"libc\", \"0.1\").with_requires(\"libb/0.1\",\n554\t                                                                               \"dep2/0.1\")},\n555\t               clean_first=True)\n556\t        c.run(\"workspace add liba\")\n557\t        c.run(\"workspace add libb\")\n558\t        c.run(\"workspace add libc\")\n559\t        for arg in (\"--pkg=libb/*\", \"--pkg=libb/* --pkg=liba/*\"):\n560\t            c.run(f\"workspace super-install {arg} -g CMakeDeps -of=build\")\n561\t            assert \"dep1/0.1\" in c.out\n562\t            assert \"dep2/0.1\" not in c.out\n563\t            assert \"libc/0.1\" not in c.out\n564\t            files = os.listdir(os.path.join(c.current_folder, \"build\"))\n565\t            assert \"dep1-config.cmake\" in files\n566\t            assert \"dep2-config.cmake\" not in files\n567\t\n568\t\n569\tdef test_workspace_with_local_recipes_index():\n570\t    c3i_folder = temp_folder()\n571\t    recipes_folder = os.path.join(c3i_folder, \"recipes\")\n572\t    zlib_config = textwrap.dedent(\"\"\"\n573\t       versions:\n574\t         \"1.2.11\":\n575\t           folder: all\n576\t       \"\"\")\n577\t    save_files(recipes_folder, {\"zlib/config.yml\": zlib_config,\n578\t                                \"zlib/all/conanfile.py\": str(GenConanfile(\"zlib\")),\n579\t                                \"zlib/all/conandata.yml\": \"\"})\n580\t\n581\t    c = TestClient(light=True)\n582\t    c.save({\".conanrc\": 'conan_home=deps\\n'})\n583\t    c.run(f'remote add local \"{c3i_folder}\"')\n584\t\n585\t    c.run(\"list zlib/1.2.11#* -r=local\")\n586\t    assert \"zlib/1.2.11\" in c.out  # It doesn't crash\n587\t    c.run(\"list zlib/1.2.11#*\")\n588\t    assert \"zlib/1.2.11\" not in c.out\n589\t\n590\t\n591\tclass TestClean:\n592\t    def test_clean(self):\n593\t        # Using cmake_layout, we can clean the build folders\n594\t        c = TestClient()\n595\t        c.save({\"conanws.yml\": \"name: my_workspace\"})\n596\t        pkga = GenConanfile(\"pkga\", \"0.1\").with_settings(\"build_type\")\n597\t        pkgb = GenConanfile(\"pkgb\", \"0.1\").with_requires(\"pkga/0.1\").with_settings(\"build_type\")\n598\t        c.save({\"pkga/conanfile.py\": pkga ,\n599\t                \"pkgb/conanfile.py\": pkgb,\n600\t                \"pkgc/conanfile.py\": GenConanfile(\"pkgc\", \"0.1\").with_requires(\"pkgb/0.1\")})\n601\t        c.run(\"workspace add pkga -of=build/pkga\")\n602\t        c.run(\"workspace add pkgb -of=build/pkgb\")\n603\t        c.run(\"workspace add pkgc\")\n604\t        c.run(\"workspace build\")\n605\t        assert os.path.exists(os.path.join(c.current_folder, \"build\", \"pkga\"))\n606\t        assert os.path.exists(os.path.join(c.current_folder, \"build\", \"pkgb\"))\n607\t        c.run(\"workspace clean\")\n608\t        assert \"my_workspace: Removing pkga/0.1 output folder\" in c.out\n609\t        assert \"my_workspace: Removing pkgb/0.1 output folder\" in c.out\n610\t        assert \"Editable pkgc/0.1 doesn't have an output_folder defined\" in c.out\n611\t        assert not os.path.exists(os.path.join(c.current_folder, \"build\", \"pkga\"))\n612\t        assert not os.path.exists(os.path.join(c.current_folder, \"build\", \"pkgb\"))\n613\t\n614\t    def test_custom_clean(self):\n615\t        conanfilews = textwrap.dedent(\"\"\"\n616\t            from conan import Workspace\n617\t\n618\t            class Ws(Workspace):\n619\t                def name(self):\n620\t                    return \"my_workspace\"\n621\t                def clean(self):\n622\t                    self.output.info(\"MY CLEAN!!!!\")\n623\t            \"\"\")\n624\t        c = TestClient()\n625\t        c.save({\"conanws.py\": conanfilews})\n626\t        c.run(\"workspace clean\")\n627\t        assert \"my_workspace: MY CLEAN!!!\" in c.out\n628\t\n629\t\n630\tdef test_relative_paths():\n631\t    # This is using the meta-project\n632\t    c = TestClient()\n633\t    c.run(\"new cmake_lib -d name=liba --output=liba\")\n634\t    c.run(\"new cmake_exe -d name=app1 -d requires=liba/0.1 --output=app1\")\n635\t    c.run(\"new cmake_lib -d name=libb --output=other/libb\")\n636\t    c.run(\"new cmake_exe -d name=app2 -d requires=libb/0.1 --output=other/app2\")\n637\t    c.run(\"workspace init mywks\")\n638\t    c.run(\"workspace init otherwks\")\n639\t    # cd mywks\n640\t    with c.chdir(\"mywks\"):\n641\t        c.run(\"workspace add ../liba\")\n642\t        c.run(\"workspace add ../app1\")\n643\t        c.run(\"workspace info\")\n644\t        expected = textwrap.dedent(\"\"\"\\\n645\t            packages\n646\t              app1/0.1\n647\t                path: ../app1\n648\t              liba/0.1\n649\t                path: ../liba\n650\t            \"\"\")\n651\t        assert expected in c.out\n652\t        c.run(\"graph info --requires=app1/0.1\")\n653\t        c.assert_listed_require({\"app1/0.1\": \"Editable\", \"liba/0.1\": \"Editable\"})\n654\t    # cd otherwks\n655\t    with c.chdir(\"otherwks\"):\n656\t        c.run(\"workspace add ../other/libb\")\n657\t        c.run(\"workspace add ../other/app2\")\n658\t        c.run(\"workspace info\")\n659\t        expected = textwrap.dedent(\"\"\"\\\n660\t            packages\n661\t              app2/0.1\n662\t                path: ../other/app2\n663\t              libb/0.1\n664\t                path: ../other/libb\n665\t            \"\"\")\n666\t        assert expected in c.out\n667\t        c.run(\"graph info --requires=app2/0.1\")\n668\t        c.assert_listed_require({\"app2/0.1\": \"Editable\", \"libb/0.1\": \"Editable\"})\n669\t\n670\t\n671\tdef test_host_build_require():\n672\t    c = TestClient()\n673\t    protobuf = textwrap.dedent(\"\"\"\\\n674\t        from conan import ConanFile\n675\t        from conan.tools.files import save, copy\n676\t        class Protobuf(ConanFile):\n677\t            name = \"protobuf\"\n678\t            version = \"0.1\"\n679\t            settings = \"os\"\n680\t\n681\t            def layout(self):\n682\t                self.folders.build = f\"mybuild/folder_{self.settings.os}\"\n683\t                self.cpp.build.bindirs = [\".\"]\n684\t\n685\t            def build(self):\n686\t                save(self, \"myprotobuf.txt\", f\"MYOS={self.settings.os}!!!\")\n687\t\n688\t            def package(self):\n689\t                copy(self, \"myprotobuf.txt\", src=self.build_folder, dst=self.package_folder)\n690\t\n691\t            def package_info(self):\n692\t                self.cpp_info.bindirs = [\".\"]\n693\t        \"\"\")\n694\t    app = textwrap.dedent(\"\"\"\\\n695\t        import os\n696\t        from conan import ConanFile\n697\t        from conan.tools.files import load\n698\t        class Protobuf(ConanFile):\n699\t            name = \"app\"\n700\t            version = \"0.1\"\n701\t            requires = \"protobuf/0.1\"\n702\t            tool_requires = \"protobuf/0.1\"\n703\t\n704\t            def build(self):\n705\t                binhost = self.dependencies.host[\"protobuf\"].cpp_info.bindir\n706\t                binbuild = self.dependencies.build[\"protobuf\"].cpp_info.bindir\n707\t                host = load(self, os.path.join(binhost, \"myprotobuf.txt\"))\n708\t                build = load(self, os.path.join(binbuild, \"myprotobuf.txt\"))\n709\t                self.output.info(f\"BUILDING WITH BINHOST: {host}\")\n710\t                self.output.info(f\"BUILDING WITH BINBUILD: {build}\")\n711\t        \"\"\")\n712\t    c.save({\"protobuf/conanfile.py\": protobuf,\n713\t            \"app/conanfile.py\": app})\n714\t    c.run(\"workspace init .\")\n715\t    c.run(\"workspace add protobuf\")\n716\t    c.run(\"workspace add app\")\n717\t    c.run(\"install app --build=editable -s:b os=Linux -s:h os=Windows\")\n718\t\n719\t    assert c.load(\"protobuf/mybuild/folder_Linux/myprotobuf.txt\") == \"MYOS=Linux!!!\"\n720\t    assert c.load(\"protobuf/mybuild/folder_Windows/myprotobuf.txt\") == \"MYOS=Windows!!!\"\n721\t\n722\t    shutil.rmtree(os.path.join(c.current_folder, \"protobuf\", \"mybuild\"))\n723\t    assert not os.path.exists(os.path.join(c.current_folder, \"protobuf\", \"mybuild\"))\n724\t    c.run(\"workspace build -s:b os=Linux -s:h os=Windows\")\n725\t    assert \"conanfile.py (app/0.1): BUILDING WITH BINHOST: MYOS=Windows!!!\" in c.out\n726\t    assert \"conanfile.py (app/0.1): BUILDING WITH BINBUILD: MYOS=Linux!!!\" in c.out\n727\t    assert c.load(\"protobuf/mybuild/folder_Linux/myprotobuf.txt\") == \"MYOS=Linux!!!\"\n728\t    assert c.load(\"protobuf/mybuild/folder_Windows/myprotobuf.txt\") == \"MYOS=Windows!!!\"\n729\t\n730\t    shutil.rmtree(os.path.join(c.current_folder, \"protobuf\", \"mybuild\"))\n731\t    assert not os.path.exists(os.path.join(c.current_folder, \"protobuf\", \"mybuild\"))\n732\t    c.run(\"workspace create -s:b os=Linux -s:h os=Windows\")\n733\t    assert \"app/0.1: BUILDING WITH BINHOST: MYOS=Windows!!!\" in c.out\n734\t    assert \"app/0.1: BUILDING WITH BINBUILD: MYOS=Linux!!!\" in c.out\n735\t\n736\t\n737\tclass TestCreate:\n738\t    def test_create(self):\n739\t        c = TestClient(light=True, default_server_user=True)\n740\t        c.save({\"conanfile.py\": GenConanfile(\"zlib\", \"0.1\").with_build_msg(\"BUILD ZLIB!\")})\n741\t        c.run(\"export .\")\n742\t        c.save({\"conanws.yml\": \"\"}, clean_first=True)\n743\t        c.save({\"pkga/conanfile.py\": GenConanfile(\"pkga\", \"0.1\").with_requires(\"zlib/0.1\")\n744\t                                                                .with_build_msg(\"BUILD PKGA!\"),\n745\t                \"pkga/test_package/conanfile.py\": GenConanfile().with_test(\"pass\"),\n746\t                \"pkgb/conanfile.py\": GenConanfile(\"pkgb\", \"0.1\").with_build_msg(\"BUILD PKGB!\")\n747\t               .with_requires(\"pkga/0.1\"),\n748\t                \"pkgb/test_package/conanfile.py\": GenConanfile().with_test(\"pass\"),\n749\t                \"pkgc/conanfile.py\": GenConanfile(\"pkgc\", \"0.1\").with_build_msg(\"BUILD PKGC!\")\n750\t               .with_requires(\"pkgb/0.1\"),\n751\t                \"pkgc/test_package/conanfile.py\": GenConanfile().with_test(\"pass\"),\n752\t                })\n753\t        c.run(\"workspace add pkga\")\n754\t        c.run(\"workspace add pkgb\")\n755\t        c.run(\"workspace add pkgc\")\n756\t        c.run(\"workspace create --build=zlib/*\")\n757\t        assert str(c.out).count(\"zlib/0.1: WARN: BUILD ZLIB!\") == 1\n758\t        assert str(c.out).count(\"pkga/0.1: WARN: BUILD PKGA!\") == 1\n759\t        assert str(c.out).count(\"pkgb/0.1: WARN: BUILD PKGB!\") == 1\n760\t        assert str(c.out).count(\"pkgc/0.1: WARN: BUILD PKGC!\") == 1\n761\t        assert \"pkga/0.1 (test package): Running test()\" in c.out\n762\t        assert \"pkgb/0.1 (test package): Running test()\" in c.out\n763\t        assert \"pkgc/0.1 (test package): Running test()\" in c.out\n764\t\n765\t        # A second conan workspace create will not re-build\n766\t        c.run(\"workspace create\")\n767\t        assert \"WARN: BUILD ZLIB!\" not in c.out\n768\t        assert \"WARN: BUILD PKGA!\" not in c.out\n769\t        assert \"WARN: BUILD PKGB!\" not in c.out\n770\t        assert \"WARN: BUILD PKBC!\" not in c.out\n771\t        assert \"pkga/0.1 (test package): Running test()\" not in c.out\n772\t        assert \"pkgb/0.1 (test package): Running test()\" not in c.out\n773\t        assert \"pkgc/0.1 (test package): Running test()\" not in c.out\n774\t\n775\t        c.run(\"upload zlib/* -r=default -c\")\n776\t        c.run(\"remove zlib/* -c\")\n777\t        c.run(\"remove pkgc/* -c\")\n778\t        c.run(\"workspace create\")\n779\t        assert \"WARN: BUILD ZLIB!\" not in c.out\n780\t        assert \"pkgc/0.1: WARN: BUILD PKGC!\" in c.out\n781\t\n782\t\n783\t    def test_create_dynamic_name(self):\n784\t        workspace = textwrap.dedent(\"\"\"\\\n785\t            import os\n786\t            from conan import Workspace\n787\t\n788\t            class MyWorkspace(Workspace):\n789\t                def packages(self):\n790\t                    result = {}\n791\t                    for f in os.listdir(self.folder):\n792\t                        if os.path.isdir(os.path.join(self.folder, f)):\n793\t                            result[f\"{f}/0.1\"] = {\"path\": f}\n794\t                    return result\n795\t           \"\"\")\n796\t        c = TestClient(light=True)\n797\t        c.save({\"conanws.py\": workspace,\n798\t                \"pkga/conanfile.py\": GenConanfile()})\n799\t        c.run(\"workspace info\")\n800\t        assert \"pkga/0.1\" in c.out\n801\t        c.run(\"workspace create\")\n802\t        assert \"Workspace create pkga/0.1\" in c.out\n803\t\n804\t\n805\t    def test_host_build_require(self):\n806\t        c = TestClient()\n807\t        protobuf = textwrap.dedent(\"\"\"\\\n808\t            from conan import ConanFile\n809\t            class Protobuf(ConanFile):\n810\t                name = \"protobuf\"\n811\t                version = \"0.1\"\n812\t                settings = \"os\"\n813\t\n814\t                def build(self):\n815\t                    self.output.info(f\"Building for: {self.settings.os}!!!\")\n816\t            \"\"\")\n817\t        app = textwrap.dedent(\"\"\"\\\n818\t            from conan import ConanFile\n819\t            class Protobuf(ConanFile):\n820\t                name = \"app\"\n821\t                version = \"0.1\"\n822\t                requires = \"protobuf/0.1\"\n823\t                tool_requires = \"protobuf/0.1\"\n824\t            \"\"\")\n825\t        c.save({\"protobuf/conanfile.py\": protobuf,\n826\t                \"app/conanfile.py\": app})\n827\t        c.run(\"workspace init .\")\n828\t        c.run(\"workspace add protobuf\")\n829\t        c.run(\"workspace add app\")\n830\t\n831\t        c.run(\"workspace create -s:b os=Linux -s:h os=Windows\")\n832\t\n833\t        assert \"protobuf/0.1: Building for: Windows!!!\" in c.out\n834\t        assert \"protobuf/0.1: Building for: Linux!!!\" in c.out\n835\t\n836\t\n837\tclass TestSource:\n838\t    def test_source(self):\n839\t        c = TestClient(light=True)\n840\t        c.save({\"conanws.yml\": \"\"})\n841\t\n842\t        pkga = textwrap.dedent(\"\"\"\\\n843\t            from conan import ConanFile\n844\t            class TestPackage(ConanFile):\n845\t                name = \"pkga\"\n846\t                version = \"0.1\"\n847\t                def source(self):\n848\t                    self.output.info(\"Executing SOURCE!!!\")\n849\t            \"\"\")\n850\t        pkgb = textwrap.dedent(\"\"\"\\\n851\t            from conan import ConanFile\n852\t            class TestPackage(ConanFile):\n853\t                name = \"pkgb\"\n854\t                version = \"0.1\"\n855\t                requires = \"pkga/0.1\"\n856\t                def source(self):\n857\t                    self.output.info(\"Executing SOURCE!!!\")\n858\t            \"\"\")\n859\t        pkgc = textwrap.dedent(\"\"\"\\\n860\t            from conan import ConanFile\n861\t            class TestPackage(ConanFile):\n862\t                name = \"pkgc\"\n863\t                version = \"0.1\"\n864\t                requires = \"pkgb/0.1\"\n865\t                def source(self):\n866\t                    self.output.info(\"Executing SOURCE!!!\")\n867\t            \"\"\")\n868\t        c.save({\"pkga/conanfile.py\": pkga,\n869\t                \"pkgb/conanfile.py\": pkgb,\n870\t                \"pkgc/conanfile.py\": pkgc})\n871\t        c.run(\"workspace add pkga\")\n872\t        c.run(\"workspace add pkgb\")\n873\t        c.run(\"workspace add pkgc\")\n874\t        c.run(\"workspace source\")\n875\t        assert \"conanfile.py (pkga/0.1): Executing SOURCE!!!\" in c.out\n876\t        assert \"conanfile.py (pkgb/0.1): Executing SOURCE!!!\" in c.out\n877\t        assert \"conanfile.py (pkgc/0.1): Executing SOURCE!!!\" in c.out\n878\t\n879\t\n880\tclass TestInstall:\n881\t    def test_install(self):\n882\t        c = TestClient()\n883\t        c.save({\"conanws.yml\": \"\"})\n884\t\n885\t        pkg = textwrap.dedent(\"\"\"\\\n886\t            from conan import ConanFile\n887\t            class Package(ConanFile):\n888\t                name = \"{}\"\n889\t                version = \"0.1\"\n890\t                settings = \"os\", \"build_type\"\n891\t                {}\n892\t                generators = \"CMakeToolchain\"\n893\t            \"\"\")\n894\t\n895\t        c.save({\"pkga/conanfile.py\": pkg.format(\"pkga\", ''),\n896\t                \"pkgb/conanfile.py\": pkg.format(\"pkgb\", 'requires=\"pkga/0.1\"'),\n897\t                \"pkgc/conanfile.py\": pkg.format(\"pkgc\", 'requires=\"pkgb/0.1\"')})\n898\t        c.run(\"workspace add pkga\")\n899\t        c.run(\"workspace add pkgb\")\n900\t        c.run(\"workspace add pkgc\")\n901\t        c.run(\"workspace install\")\n902\t        assert \"conanfile.py (pkga/0.1): CMakeToolchain generated\" in c.out\n903\t        assert \"conanfile.py (pkgb/0.1): CMakeToolchain generated\" in c.out\n904\t        assert \"conanfile.py (pkgc/0.1): CMakeToolchain generated\" in c.out\n905\t\n906\t\n907\tdef test_keep_core_conf():\n908\t    c = TestClient()\n909\t    myprofile = textwrap.dedent(\"\"\"\\\n910\t        [settings]\n911\t        os=FreeBSD\n912\t        arch=armv7\n913\t        \"\"\")\n914\t    conanfile = textwrap.dedent(\"\"\"\\\n915\t        from conan import ConanFile\n916\t\n917\t        class Pkg(ConanFile):\n918\t            name = \"pkga\"\n919\t            version = \"0.1\"\n920\t            settings = \"os\", \"arch\"\n921\t\n922\t            def generate(self):\n923\t                self.output.info(f\"Generating!: {self.settings.os}-{self.settings.arch}!!!!\")\n924\t        \"\"\")\n925\t    c.save_home({\"profiles/myprofile\": myprofile})\n926\t    c.run(\"profile show \")\n927\t    c.save({\"conanws.yml\": \"\",\n928\t            \"pkga/conanfile.py\": conanfile})\n929\t    c.run(\"workspace add pkga\")\n930\t    # The injected -cc is still applied to every \"conan install\"\n931\t    c.run(\"workspace install -cc core:default_profile=myprofile\")\n932\t    assert \"conanfile.py (pkga/0.1): Generating!: FreeBSD-armv7!!!!\" in c.out\n933\t    # also the global.conf\n934\t    c.save_home({\"global.conf\": \"core:default_profile=myprofile\"})\n935\t    c.run(\"workspace install\")\n936\t    assert \"conanfile.py (pkga/0.1): Generating!: FreeBSD-armv7!!!!\" in c.out\n937\t"}]},"parent_tool_use_id":null,"session_id":"a035cbe5-8923-4731-8824-502460b30912","uuid":"91082d1a-0052-4d6b-8d57-f9547ac01d0a","timestamp":"2026-09-04T09:08:52.030Z","tool_use_result":{"type":"text","file":{"filePath":"/testbed/test/integration/workspace/test_workspace.py","content":"import json\nimport os\nimport shutil\nimport textwrap\n\nimport pytest\n\nfrom conan.api.subapi.workspace import WorkspaceAPI\nfrom conan.test.assets.genconanfile import GenConanfile\nfrom conan.test.utils.scm import create_local_git_repo\nfrom conan.test.utils.test_files import temp_folder\nfrom conan.test.utils.tools import TestClient\nfrom conan.internal.util.files import save_files\n\nWorkspaceAPI.TEST_ENABLED = \"will_break_next\"\n\n\nclass TestWorkspaceRoot:\n\n    def test_workspace_root(self):\n        c = TestClient(light=True)\n        # Just check the root command works\n        c.run(\"workspace root\", assert_error=True)\n        assert \"ERROR: Workspace not defined, please create\" in c.out\n\n        # error, conanws/ folder does not contain conanws.[py | yml]\n        c.save({\"conanws/test.txt\": \"\"})\n        with c.chdir(\"conanws\"):\n            c.run(\"workspace root\", assert_error=True)\n            assert \"ERROR: Workspace not defined, please create\" in c.out\n            c.save({\"conanws.yml\": \"\"})\n            c.run(\"workspace root\")\n            assert c.current_folder in c.stdout\n\n        # error, empty .py\n        c.save({\"conanws.py\": \"\"}, clean_first=True)\n        c.run(\"workspace root\", assert_error=True)\n        assert \"Error loading conanws.py\" in c.out\n        assert \"No subclass of Workspace\" in c.out\n\n        c.save({\"conanws.yml\": \"\"}, clean_first=True)\n        c.run(\"workspace root\")\n        assert c.current_folder in c.stdout\n\n\nclass TestAddRemove:\n\n    def test_add(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\",\n                \"dep1/conanfile.py\": GenConanfile(\"dep1\", \"0.1\"),\n                \"dep2/conanfile.py\": GenConanfile(\"dep2\", \"0.1\"),\n                \"dep3/conanfile.py\": GenConanfile(\"dep3\", \"0.1\")})\n        c.run(\"workspace add dep1\")\n        assert \"Reference 'dep1/0.1' added to workspace\" in c.out\n        c.run(\"workspace info\")\n        assert \"dep1/0.1\" in c.out\n        assert \"dep2\" not in c.out\n        c.run(\"editable list\")  # No editables in global\n        assert \"dep1\" not in c.out\n        assert \"dep2\" not in c.out\n        c.run(\"workspace add dep2\")\n        assert \"Reference 'dep2/0.1' added to workspace\" in c.out\n        c.run(\"workspace info\")\n        assert \"dep1/0.1\" in c.out\n        assert \"dep2/0.1\" in c.out\n\n        with c.chdir(temp_folder()):  # If we move to another folder, outside WS, no editables\n            c.run(\"editable list\")\n            assert \"dep1\" not in c.out\n            assert \"dep2\" not in c.out\n\n        c.run(\"workspace info\")\n        assert \"dep1/0.1\" in c.out\n        assert \"dep2/0.1\" in c.out\n\n        c.run(\"workspace remove dep1\")\n        c.run(\"workspace info\")\n        assert \"dep1/0.1\" not in c.out\n        assert \"dep2/0.1\" in c.out\n\n        c.run(\"workspace remove dep2\")\n        c.run(\"workspace info\")\n        assert \"dep1/0.1\" not in c.out\n        assert \"dep2/0.1\" not in c.out\n\n    def test_add_from_outside(self):\n        c = TestClient(light=True)\n        c.save({\"sub/conanws.yml\": \"\",\n                \"sub/dep1/conanfile.py\": GenConanfile(\"dep1\", \"0.1\"),\n                \"sub/dep2/conanfile.py\": GenConanfile(\"dep2\", \"0.1\")})\n        with c.chdir(\"sub\"):\n            c.run(\"workspace add dep1\")\n            assert \"Reference 'dep1/0.1' added to workspace\" in c.out\n            c.run(\"workspace add dep2\")\n            assert \"Reference 'dep2/0.1' added to workspace\" in c.out\n            c.run(\"workspace info\")\n            assert \"dep1/0.1\" in c.out\n            assert \"dep2/0.1\" in c.out\n        assert c.load_home(\"editable_packages.json\") is None\n\n        c.run(\"editable list\")\n        assert \"dep1\" not in c.out\n        assert \"dep2\" not in c.out\n        assert c.load_home(\"editable_packages.json\") is None\n        with c.chdir(\"sub\"):\n            c.run(\"editable add dep1\")\n            assert c.load_home(\"editable_packages.json\") is not None\n            c.run(\"editable list\")\n            assert \"dep1/0.1\" in c.out\n            assert \"dep2/0.1\" not in c.out\n            c.run(\"workspace info\")\n            assert \"dep1\" in c.out\n            assert \"dep2\" in c.out\n\n        c.run(\"editable list\")\n        assert \"dep1/0.1\" in c.out\n        assert \"dep2\" not in c.out\n\n    @pytest.mark.parametrize(\"api\", [False, True])\n    def test_dynamic_editables(self, api):\n        c = TestClient(light=True)\n        conanfile = textwrap.dedent(\"\"\"\n            import os\n            from conan import ConanFile\n            from conan.tools.files import load\n            class Lib(ConanFile):\n                def set_name(self):\n                    self.name = load(self, os.path.join(self.recipe_folder, \"name.txt\"))\n                def set_version(self):\n                    self.version = load(self, os.path.join(self.recipe_folder, \"version.txt\"))\n            \"\"\")\n        if not api:\n            workspace = textwrap.dedent(\"\"\"\\\n                import os\n                from conan import Workspace\n\n                class MyWorkspace(Workspace):\n                    def packages(self):\n                        result = {}\n                        for f in os.listdir(self.folder):\n                            if os.path.isdir(os.path.join(self.folder, f)):\n                                full_path = os.path.join(self.folder, f, \"name.txt\")\n                                name = open(full_path).read().strip()\n                                version = open(os.path.join(self.folder, f,\n                                                            \"version.txt\")).read().strip()\n                                result[f\"{name}/{version}\"] = {\"path\": f}\n                        return result\n                \"\"\")\n        else:\n            workspace = textwrap.dedent(\"\"\"\\\n                import os\n                from conan import Workspace\n\n                class MyWorkspace(Workspace):\n                    def packages(self):\n                        result = {}\n                        for f in os.listdir(self.folder):\n                            if os.path.isdir(os.path.join(self.folder, f)):\n                                conanfile = self.load_conanfile(f)\n                                result[f\"{conanfile.name}/{conanfile.version}\"] = {\"path\": f}\n                        return result\n               \"\"\")\n\n        c.save({\"conanws.py\": workspace,\n                \"dep1/conanfile.py\": conanfile,\n                \"dep1/name.txt\": \"pkg\",\n                \"dep1/version.txt\": \"2.1\"})\n        c.run(\"workspace info --format=json\")\n        info = json.loads(c.stdout)\n        assert info[\"packages\"] == {\"pkg/2.1\": {\"path\": \"dep1\"}}\n        c.save({\"dep1/name.txt\": \"other\",\n                \"dep1/version.txt\": \"14.5\"})\n        c.run(\"workspace info --format=json\")\n        info = json.loads(c.stdout)\n        assert info[\"packages\"] == {\"other/14.5\": {\"path\": \"dep1\"}}\n        c.run(\"install --requires=other/14.5\")\n        # Doesn't fail\n        assert \"other/14.5 - Editable\" in c.out\n        with c.chdir(\"dep1\"):\n            c.run(\"install --requires=other/14.5\")\n            # Doesn't fail\n            assert \"other/14.5 - Editable\" in c.out\n\n    def test_api_dynamic_version_run(self):\n        # https://github.com/conan-io/conan/issues/17306\n        c = TestClient(light=True)\n        conanfile = textwrap.dedent(\"\"\"\n            from io import StringIO\n            from conan import ConanFile\n            class Lib(ConanFile):\n                name= \"pkg\"\n                def set_version(self):\n                    my_buf = StringIO()\n                    self.run('echo 2.1', stdout=my_buf)\n                    self.version = my_buf.getvalue().strip()\n            \"\"\")\n\n        workspace = textwrap.dedent(\"\"\"\\\n            import os\n            from conan import Workspace\n\n            class MyWorkspace(Workspace):\n                def packages(self):\n                    conanfile = self.load_conanfile(\"dep1\")\n                    return {f\"{conanfile.name}/{conanfile.version}\": {\"path\": \"dep1\"}}\n            \"\"\")\n\n        c.save({\"conanws.py\": workspace,\n                \"dep1/conanfile.py\": conanfile})\n        c.run(\"workspace info --format=json\")\n        info = json.loads(c.stdout)\n        assert info[\"packages\"] == {\"pkg/2.1\": {\"path\": \"dep1\"}}\n        c.run(\"install --requires=pkg/2.1\")\n        # it will not fail\n\n    def test_error_uppercase(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\",\n                \"conanfile.py\": GenConanfile(\"Pkg\", \"0.1\")})\n        c.run(\"workspace add .\", assert_error=True)\n        assert \"ERROR: Conan packages names 'Pkg/0.1' must be all lowercase\" in c.out\n        c.save({\"conanfile.py\": GenConanfile()})\n        c.run(\"workspace add . --name=Pkg --version=0.1\", assert_error=True)\n        assert \"ERROR: Conan packages names 'Pkg/0.1' must be all lowercase\" in c.out\n\n    def test_add_open_error(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\",\n                \"dep/conanfile.py\": GenConanfile(\"dep\", \"0.1\")})\n        c.run(\"workspace add dep\")\n        c.run(\"workspace open dep/0.1\", assert_error=True)\n        assert \"ERROR: Can't open a dependency that is already an editable: dep/0.1\" in c.out\n\n    def test_remove_product(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\",\n                \"mydeppkg/conanfile.py\": GenConanfile(\"mydeppkg\", \"0.1\")})\n        c.run(\"workspace add mydeppkg\")\n        c.run(\"workspace remove mydeppkg\")\n        c.run(\"workspace info\")\n        assert \"mydeppkg\" not in c.out\n\n    def test_remove_removed_folder(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\",\n                \"mydeppkg/conanfile.py\": GenConanfile(\"mydeppkg\", \"0.1\")})\n        c.run(\"workspace add mydeppkg\")\n        # If we now remove the folder\n        shutil.rmtree(os.path.join(c.current_folder, \"mydeppkg\"))\n        # It can still be removed by path, even if the path doesn't exist\n        c.run(\"workspace remove mydeppkg\")\n        assert \"Removed from workspace: mydeppkg/0.1\" in c.out\n        c.run(\"workspace info\")\n        assert \"mydeppkg\" not in c.out\n\n    def test_custom_add_remove(self):\n        c = TestClient(light=True)\n\n        workspace = textwrap.dedent(\"\"\"\\\n            import os\n            from conan import Workspace\n\n            class MyWorkspace(Workspace):\n                def name(self):\n                    return \"myws\"\n\n                def add(self, ref, path, *args, **kwargs):\n                    self.output.info(f\"Adding {ref} at {path}\")\n                    super().add(ref, path, *args, **kwargs)\n\n                def remove(self, path, *args, **kwargs):\n                    self.output.info(f\"Removing {path}\")\n                    return super().remove(path, *args, **kwargs)\n            \"\"\")\n\n        c.save({\"conanws.py\": workspace,\n                \"dep/conanfile.py\": GenConanfile(\"dep\", \"0.1\")})\n        c.run(\"workspace add dep\")\n        assert \"myws: Adding dep/0.1\" in c.out\n        c.run(\"workspace info\")\n        assert \"dep/0.1\" in c.out\n        c.run(\"workspace remove dep\")\n        assert \"myws: Removing\" in c.out\n        c.run(\"workspace info\")\n        assert \"dep/0.1\" not in c.out\n\n\nclass TestOpenAdd:\n    def test_without_git(self):\n        t = TestClient(default_server_user=True, light=True)\n        t.save({\"conanfile.py\": GenConanfile(\"pkg\", \"0.1\")})\n        t.run(\"create .\")\n        t.run(\"upload * -r=default -c\")\n\n        c = TestClient(servers=t.servers, light=True)\n        c.run(f\"workspace open pkg/0.1\")\n        assert \"name = 'pkg'\" in c.load(\"pkg/conanfile.py\")\n\n        # The add should work the same\n        c2 = TestClient(servers=t.servers, light=True)\n        c2.save({\"conanws.yml\": \"\"})\n        c2.run(f\"workspace add --ref=pkg/0.1\")\n        assert \"name = 'pkg'\" in c2.load(\"pkg/conanfile.py\")\n        c2.run(\"workspace info\")\n        assert \"pkg/0.1\" in c2.out\n\n    def test_without_git_export_sources(self):\n        t = TestClient(default_server_user=True, light=True)\n        t.save({\"conanfile.py\": GenConanfile(\"pkg\", \"0.1\").with_exports_sources(\"*.txt\"),\n                \"CMakeLists.txt\": \"mycmake\"})\n        t.run(\"create .\")\n        t.run(\"upload * -r=default -c\")\n\n        c = TestClient(servers=t.servers)\n        c.run(\"workspace open pkg/0.1\")\n        assert \"name = 'pkg'\" in c.load(\"pkg/conanfile.py\")\n        assert \"mycmake\" in c.load(\"pkg/CMakeLists.txt\")\n\n    def test_workspace_git_scm(self):\n        folder = temp_folder()\n        conanfile = textwrap.dedent(\"\"\"\n            from conan import ConanFile\n            from conan.tools.scm import Git\n\n            class Pkg(ConanFile):\n                name = \"pkg\"\n                version = \"0.1\"\n                def export(self):\n                    git = Git(self)\n                    git.coordinates_to_conandata()\n            \"\"\")\n        url, commit = create_local_git_repo(files={\"conanfile.py\": conanfile}, folder=folder,\n                                            branch=\"mybranch\")\n        t1 = TestClient(default_server_user=True, light=True)\n        t1.run_command('git clone \"file://{}\" .'.format(url))\n        t1.run(\"create .\")\n        t1.run(\"upload * -r=default -c\")\n\n        c = TestClient(servers=t1.servers, light=True)\n        c.run(\"workspace open pkg/0.1\")\n        assert c.load(\"pkg/conanfile.py\") == conanfile\n\n        c2 = TestClient(servers=t1.servers, light=True)\n        c2.save({\"conanws.yml\": \"\"})\n        c2.run(f\"workspace add --ref=pkg/0.1\")\n        assert 'name = \"pkg\"' in c2.load(\"pkg/conanfile.py\")\n        c2.run(\"workspace info\")\n        assert \"pkg/0.1\" in c2.out\n\n    def test_workspace_build_editables(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\"})\n\n        c.save({\"pkga/conanfile.py\": GenConanfile(\"pkga\", \"0.1\").with_build_msg(\"BUILD PKGA!\"),\n                \"pkgb/conanfile.py\": GenConanfile(\"pkgb\", \"0.1\").with_build_msg(\"BUILD PKGB!\")\n                                                                .with_requires(\"pkga/0.1\")})\n        c.run(\"workspace add pkga\")\n        c.run(\"workspace add pkgb\")\n\n        c.run(\"install --requires=pkgb/0.1 --build=editable\")\n        c.assert_listed_binary({\"pkga/0.1\": (\"da39a3ee5e6b4b0d3255bfef95601890afd80709\",\n                                             \"EditableBuild\"),\n                                \"pkgb/0.1\": (\"47a5f20ec8fb480e1c5794462089b01a3548fdc5\",\n                                             \"EditableBuild\")})\n        assert \"pkga/0.1: WARN: BUILD PKGA!\" in c.out\n        assert \"pkgb/0.1: WARN: BUILD PKGB!\" in c.out\n\n\nclass TestWorkspaceBuild:\n\n    def test_build(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\"})\n\n        c.save({\"pkga/conanfile.py\": GenConanfile(\"pkga\", \"0.1\").with_build_msg(\"BUILD PKGA!\"),\n                \"pkgb/conanfile.py\": GenConanfile(\"pkgb\", \"0.1\").with_build_msg(\"BUILD PKGB!\")\n               .with_requires(\"pkga/0.1\")})\n        c.run(\"workspace add pkga\")\n        c.run(\"workspace add pkgb\")\n        c.run(\"workspace build\")\n        c.assert_listed_binary({\"pkga/0.1\": (\"da39a3ee5e6b4b0d3255bfef95601890afd80709\",\n                                             \"EditableBuild\")})\n        assert \"conanfile.py (pkga/0.1): WARN: BUILD PKGA!\" in c.out\n        assert \"conanfile.py (pkgb/0.1): WARN: BUILD PKGB!\" in c.out\n\n        # It is also possible to build a specific package by path\n        # equivalent to ``conan build <path> --build=editable``\n        # This can be done even if it is not a product\n        c.run(\"workspace build --pkg=pkgc/*\", assert_error=True)\n        assert \"ERROR: There are no selected packages defined in the workspace\" in c.out\n        c.run(\"workspace build --pkg=pkgb/*\")\n        c.assert_listed_binary({\"pkga/0.1\": (\"da39a3ee5e6b4b0d3255bfef95601890afd80709\",\n                                             \"EditableBuild\")})\n        assert \"conanfile.py (pkga/0.1): WARN: BUILD PKGA!\" in c.out\n        assert \"conanfile.py (pkgb/0.1): WARN: BUILD PKGB!\" in c.out\n\n        c.run(\"workspace build --pkg=pkga/*\")\n        assert \"conanfile.py (pkga/0.1): Calling build()\" in c.out\n        assert \"conanfile.py (pkga/0.1): WARN: BUILD PKGA!\" in c.out\n\n    def test_error_if_no_products(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\"})\n        c.run(\"workspace build\", assert_error=True)\n        assert \"ERROR: There are no selected packages defined in the workspace\" in c.out\n\n    def test_build_external_missing(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\"})\n\n        c.save({\"mymath/conanfile.py\": GenConanfile(\"mymath\", \"0.1\").with_build_msg(\"MyMATH!!\"),\n                \"pkga/conanfile.py\": GenConanfile(\"pkga\", \"0.1\").with_build_msg(\"BUILD PKGA!\")\n                                                                .with_requires(\"mymath/0.1\"),\n                \"pkgb/conanfile.py\": GenConanfile(\"pkgb\", \"0.1\").with_build_msg(\"BUILD PKGB!\")\n               .with_requires(\"pkga/0.1\")})\n        c.run(\"export mymath\")\n        c.run(\"workspace add pkga\")\n        c.run(\"workspace add pkgb\")\n        c.run(\"workspace build\", assert_error=True)\n        assert \"ERROR: Missing prebuilt package for 'mymath/0.1'\" in c.out\n        c.run(\"workspace build --build=missing\")\n        assert \"Workspace building external mymath/0.1\" in c.out\n\n    def test_build_dynamic_name_version(self):\n        conanfile = textwrap.dedent(\"\"\"\\\n            from conan import ConanFile\n            class MyConan(ConanFile):\n                def build(self):\n                    self.output.info(f\"Building {self.name} AND {self.version}!!!\")\n            \"\"\")\n        workspace = textwrap.dedent(\"\"\"\\\n            import os\n            from conan import Workspace\n\n            class MyWorkspace(Workspace):\n                def packages(self):\n                    result = {}\n                    for f in os.listdir(self.folder):\n                        if os.path.isdir(os.path.join(self.folder, f)):\n                            result[f\"{f}/0.1\"] = {\"path\": f}\n                    return result\n           \"\"\")\n        c = TestClient(light=True)\n        c.save({\"conanws.py\": workspace,\n                \"pkga/conanfile.py\": conanfile})\n        c.run(\"workspace info\")\n        assert \"pkga/0.1\" in c.out\n        c.run(\"workspace build\")\n        assert \"conanfile.py (pkga/0.1): Building pkga AND 0.1!!!\" in c.out\n\n\nclass TestNew:\n    def test_new(self):\n        # Very basic workspace for testing\n        c = TestClient(light=True)\n        c.run(\"new workspace\")\n        assert 'name = \"liba\"' in c.load(\"liba/conanfile.py\")\n        c.run(\"workspace info\")\n        assert \"liba/0.1\" in c.out\n        assert \"libb/0.1\" in c.out\n        assert \"app1/0.1\" in c.out\n\n    def test_new_dep(self):\n        c = TestClient(light=True)\n        c.run(\"new workspace -d requires=dep/0.1\")\n        assert 'self.requires(\"dep/0.1\")' in c.load(\"liba/conanfile.py\")\n        assert 'name = \"liba\"' in c.load(\"liba/conanfile.py\")\n        c.run(\"workspace info\")\n        assert \"liba/0.1\" in c.out\n        assert \"libb/0.1\" in c.out\n        assert \"app1/0.1\" in c.out\n\n\nclass TestMeta:\n    def test_install(self):\n        c = TestClient()\n        c.save({\"dep/conanfile.py\": GenConanfile()})\n        c.run(\"create dep --name=dep1 --version=0.1\")\n        c.run(\"create dep --name=dep2 --version=0.1\")\n        c.save({\"conanws.yml\": \"\",\n                \"liba/conanfile.py\": GenConanfile(\"liba\", \"0.1\").with_requires(\"dep1/0.1\",\n                                                                               \"dep2/0.1\"),\n                \"libb/conanfile.py\": GenConanfile(\"libb\", \"0.1\").with_requires(\"liba/0.1\",\n                                                                               \"dep1/0.1\")},\n               clean_first=True)\n        c.run(\"workspace add liba\")\n        c.run(\"workspace add libb\")\n        c.run(\"workspace super-install -g CMakeDeps -g CMakeToolchain -of=build --envs-generation=false\")\n        assert \"Workspace conanws.py not found in the workspace folder, using default\" in c.out\n        files = os.listdir(os.path.join(c.current_folder, \"build\"))\n        assert \"conan_toolchain.cmake\" in files\n        assert \"dep1-config.cmake\" in files\n        assert \"dep2-config.cmake\" in files\n        assert \"liba-config.cmake\" not in files\n        assert \"libb-config.cmake\" not in files\n        assert \"conanbuild.bat\" not in files\n        assert \"conanbuild.sh\" not in files\n\n    def test_conanfilews_custom(self):\n        c = TestClient()\n        conanfilews = textwrap.dedent(\"\"\"\n            from conan import ConanFile\n            from conan import Workspace\n\n            class MyWs(ConanFile):\n                settings = \"arch\", \"build_type\"\n                generators = \"MSBuildDeps\"\n\n            class Ws(Workspace):\n                def root_conanfile(self):\n                    return MyWs\n            \"\"\")\n\n        c.save({\"dep/conanfile.py\": GenConanfile(\"dep\", \"0.1\"),\n                \"conanws.py\": conanfilews})\n        c.run(\"workspace add dep\")\n        c.run(\"workspace super-install -of=build\")\n        files = os.listdir(os.path.join(c.current_folder, \"build\"))\n        assert \"conandeps.props\" in files\n\n    def test_conanfilews_errors(self):\n        c = TestClient()\n        conanfilews = textwrap.dedent(\"\"\"\n            from conan import ConanFile\n            from conan import Workspace\n            class MyWs(ConanFile):\n                requires = \"dep/0.1\"\n\n            class Ws(Workspace):\n                def root_conanfile(self):\n                    return MyWs\n            \"\"\")\n\n        c.save({\"conanws.yml\": \"conanfilews: myconanfilews.py\",\n                \"dep/conanfile.py\": GenConanfile(\"dep\", \"0.1\"),\n                \"conanws.py\": conanfilews})\n        c.run(\"workspace super-install\", assert_error=True)\n        assert \"ERROR: There are no selected packages defined in the workspace\" in c.out\n        c.run(\"workspace add dep\")\n        c.run(\"workspace super-install\", assert_error=True)\n        assert \"ERROR: Conanfile in conanws.py shouldn't have 'requires'\" in c.out\n\n    def test_install_partial(self):\n        # If we want to install only some part of the workspace\n        c = TestClient()\n        c.save({\"dep/conanfile.py\": GenConanfile()})\n        c.run(\"create dep --name=dep1 --version=0.1\")\n        c.run(\"create dep --name=dep2 --version=0.1\")\n        c.save({\"conanws.yml\": \"\",\n                \"liba/conanfile.py\": GenConanfile(\"liba\", \"0.1\").with_requires(\"dep1/0.1\"),\n                \"libb/conanfile.py\": GenConanfile(\"libb\", \"0.1\").with_requires(\"liba/0.1\"),\n                \"libc/conanfile.py\": GenConanfile(\"libc\", \"0.1\").with_requires(\"libb/0.1\",\n                                                                               \"dep2/0.1\")},\n               clean_first=True)\n        c.run(\"workspace add liba\")\n        c.run(\"workspace add libb\")\n        c.run(\"workspace add libc\")\n        for arg in (\"--pkg=libb/*\", \"--pkg=libb/* --pkg=liba/*\"):\n            c.run(f\"workspace super-install {arg} -g CMakeDeps -of=build\")\n            assert \"dep1/0.1\" in c.out\n            assert \"dep2/0.1\" not in c.out\n            assert \"libc/0.1\" not in c.out\n            files = os.listdir(os.path.join(c.current_folder, \"build\"))\n            assert \"dep1-config.cmake\" in files\n            assert \"dep2-config.cmake\" not in files\n\n\ndef test_workspace_with_local_recipes_index():\n    c3i_folder = temp_folder()\n    recipes_folder = os.path.join(c3i_folder, \"recipes\")\n    zlib_config = textwrap.dedent(\"\"\"\n       versions:\n         \"1.2.11\":\n           folder: all\n       \"\"\")\n    save_files(recipes_folder, {\"zlib/config.yml\": zlib_config,\n                                \"zlib/all/conanfile.py\": str(GenConanfile(\"zlib\")),\n                                \"zlib/all/conandata.yml\": \"\"})\n\n    c = TestClient(light=True)\n    c.save({\".conanrc\": 'conan_home=deps\\n'})\n    c.run(f'remote add local \"{c3i_folder}\"')\n\n    c.run(\"list zlib/1.2.11#* -r=local\")\n    assert \"zlib/1.2.11\" in c.out  # It doesn't crash\n    c.run(\"list zlib/1.2.11#*\")\n    assert \"zlib/1.2.11\" not in c.out\n\n\nclass TestClean:\n    def test_clean(self):\n        # Using cmake_layout, we can clean the build folders\n        c = TestClient()\n        c.save({\"conanws.yml\": \"name: my_workspace\"})\n        pkga = GenConanfile(\"pkga\", \"0.1\").with_settings(\"build_type\")\n        pkgb = GenConanfile(\"pkgb\", \"0.1\").with_requires(\"pkga/0.1\").with_settings(\"build_type\")\n        c.save({\"pkga/conanfile.py\": pkga ,\n                \"pkgb/conanfile.py\": pkgb,\n                \"pkgc/conanfile.py\": GenConanfile(\"pkgc\", \"0.1\").with_requires(\"pkgb/0.1\")})\n        c.run(\"workspace add pkga -of=build/pkga\")\n        c.run(\"workspace add pkgb -of=build/pkgb\")\n        c.run(\"workspace add pkgc\")\n        c.run(\"workspace build\")\n        assert os.path.exists(os.path.join(c.current_folder, \"build\", \"pkga\"))\n        assert os.path.exists(os.path.join(c.current_folder, \"build\", \"pkgb\"))\n        c.run(\"workspace clean\")\n        assert \"my_workspace: Removing pkga/0.1 output folder\" in c.out\n        assert \"my_workspace: Removing pkgb/0.1 output folder\" in c.out\n        assert \"Editable pkgc/0.1 doesn't have an output_folder defined\" in c.out\n        assert not os.path.exists(os.path.join(c.current_folder, \"build\", \"pkga\"))\n        assert not os.path.exists(os.path.join(c.current_folder, \"build\", \"pkgb\"))\n\n    def test_custom_clean(self):\n        conanfilews = textwrap.dedent(\"\"\"\n            from conan import Workspace\n\n            class Ws(Workspace):\n                def name(self):\n                    return \"my_workspace\"\n                def clean(self):\n                    self.output.info(\"MY CLEAN!!!!\")\n            \"\"\")\n        c = TestClient()\n        c.save({\"conanws.py\": conanfilews})\n        c.run(\"workspace clean\")\n        assert \"my_workspace: MY CLEAN!!!\" in c.out\n\n\ndef test_relative_paths():\n    # This is using the meta-project\n    c = TestClient()\n    c.run(\"new cmake_lib -d name=liba --output=liba\")\n    c.run(\"new cmake_exe -d name=app1 -d requires=liba/0.1 --output=app1\")\n    c.run(\"new cmake_lib -d name=libb --output=other/libb\")\n    c.run(\"new cmake_exe -d name=app2 -d requires=libb/0.1 --output=other/app2\")\n    c.run(\"workspace init mywks\")\n    c.run(\"workspace init otherwks\")\n    # cd mywks\n    with c.chdir(\"mywks\"):\n        c.run(\"workspace add ../liba\")\n        c.run(\"workspace add ../app1\")\n        c.run(\"workspace info\")\n        expected = textwrap.dedent(\"\"\"\\\n            packages\n              app1/0.1\n                path: ../app1\n              liba/0.1\n                path: ../liba\n            \"\"\")\n        assert expected in c.out\n        c.run(\"graph info --requires=app1/0.1\")\n        c.assert_listed_require({\"app1/0.1\": \"Editable\", \"liba/0.1\": \"Editable\"})\n    # cd otherwks\n    with c.chdir(\"otherwks\"):\n        c.run(\"workspace add ../other/libb\")\n        c.run(\"workspace add ../other/app2\")\n        c.run(\"workspace info\")\n        expected = textwrap.dedent(\"\"\"\\\n            packages\n              app2/0.1\n                path: ../other/app2\n              libb/0.1\n                path: ../other/libb\n            \"\"\")\n        assert expected in c.out\n        c.run(\"graph info --requires=app2/0.1\")\n        c.assert_listed_require({\"app2/0.1\": \"Editable\", \"libb/0.1\": \"Editable\"})\n\n\ndef test_host_build_require():\n    c = TestClient()\n    protobuf = textwrap.dedent(\"\"\"\\\n        from conan import ConanFile\n        from conan.tools.files import save, copy\n        class Protobuf(ConanFile):\n            name = \"protobuf\"\n            version = \"0.1\"\n            settings = \"os\"\n\n            def layout(self):\n                self.folders.build = f\"mybuild/folder_{self.settings.os}\"\n                self.cpp.build.bindirs = [\".\"]\n\n            def build(self):\n                save(self, \"myprotobuf.txt\", f\"MYOS={self.settings.os}!!!\")\n\n            def package(self):\n                copy(self, \"myprotobuf.txt\", src=self.build_folder, dst=self.package_folder)\n\n            def package_info(self):\n                self.cpp_info.bindirs = [\".\"]\n        \"\"\")\n    app = textwrap.dedent(\"\"\"\\\n        import os\n        from conan import ConanFile\n        from conan.tools.files import load\n        class Protobuf(ConanFile):\n            name = \"app\"\n            version = \"0.1\"\n            requires = \"protobuf/0.1\"\n            tool_requires = \"protobuf/0.1\"\n\n            def build(self):\n                binhost = self.dependencies.host[\"protobuf\"].cpp_info.bindir\n                binbuild = self.dependencies.build[\"protobuf\"].cpp_info.bindir\n                host = load(self, os.path.join(binhost, \"myprotobuf.txt\"))\n                build = load(self, os.path.join(binbuild, \"myprotobuf.txt\"))\n                self.output.info(f\"BUILDING WITH BINHOST: {host}\")\n                self.output.info(f\"BUILDING WITH BINBUILD: {build}\")\n        \"\"\")\n    c.save({\"protobuf/conanfile.py\": protobuf,\n            \"app/conanfile.py\": app})\n    c.run(\"workspace init .\")\n    c.run(\"workspace add protobuf\")\n    c.run(\"workspace add app\")\n    c.run(\"install app --build=editable -s:b os=Linux -s:h os=Windows\")\n\n    assert c.load(\"protobuf/mybuild/folder_Linux/myprotobuf.txt\") == \"MYOS=Linux!!!\"\n    assert c.load(\"protobuf/mybuild/folder_Windows/myprotobuf.txt\") == \"MYOS=Windows!!!\"\n\n    shutil.rmtree(os.path.join(c.current_folder, \"protobuf\", \"mybuild\"))\n    assert not os.path.exists(os.path.join(c.current_folder, \"protobuf\", \"mybuild\"))\n    c.run(\"workspace build -s:b os=Linux -s:h os=Windows\")\n    assert \"conanfile.py (app/0.1): BUILDING WITH BINHOST: MYOS=Windows!!!\" in c.out\n    assert \"conanfile.py (app/0.1): BUILDING WITH BINBUILD: MYOS=Linux!!!\" in c.out\n    assert c.load(\"protobuf/mybuild/folder_Linux/myprotobuf.txt\") == \"MYOS=Linux!!!\"\n    assert c.load(\"protobuf/mybuild/folder_Windows/myprotobuf.txt\") == \"MYOS=Windows!!!\"\n\n    shutil.rmtree(os.path.join(c.current_folder, \"protobuf\", \"mybuild\"))\n    assert not os.path.exists(os.path.join(c.current_folder, \"protobuf\", \"mybuild\"))\n    c.run(\"workspace create -s:b os=Linux -s:h os=Windows\")\n    assert \"app/0.1: BUILDING WITH BINHOST: MYOS=Windows!!!\" in c.out\n    assert \"app/0.1: BUILDING WITH BINBUILD: MYOS=Linux!!!\" in c.out\n\n\nclass TestCreate:\n    def test_create(self):\n        c = TestClient(light=True, default_server_user=True)\n        c.save({\"conanfile.py\": GenConanfile(\"zlib\", \"0.1\").with_build_msg(\"BUILD ZLIB!\")})\n        c.run(\"export .\")\n        c.save({\"conanws.yml\": \"\"}, clean_first=True)\n        c.save({\"pkga/conanfile.py\": GenConanfile(\"pkga\", \"0.1\").with_requires(\"zlib/0.1\")\n                                                                .with_build_msg(\"BUILD PKGA!\"),\n                \"pkga/test_package/conanfile.py\": GenConanfile().with_test(\"pass\"),\n                \"pkgb/conanfile.py\": GenConanfile(\"pkgb\", \"0.1\").with_build_msg(\"BUILD PKGB!\")\n               .with_requires(\"pkga/0.1\"),\n                \"pkgb/test_package/conanfile.py\": GenConanfile().with_test(\"pass\"),\n                \"pkgc/conanfile.py\": GenConanfile(\"pkgc\", \"0.1\").with_build_msg(\"BUILD PKGC!\")\n               .with_requires(\"pkgb/0.1\"),\n                \"pkgc/test_package/conanfile.py\": GenConanfile().with_test(\"pass\"),\n                })\n        c.run(\"workspace add pkga\")\n        c.run(\"workspace add pkgb\")\n        c.run(\"workspace add pkgc\")\n        c.run(\"workspace create --build=zlib/*\")\n        assert str(c.out).count(\"zlib/0.1: WARN: BUILD ZLIB!\") == 1\n        assert str(c.out).count(\"pkga/0.1: WARN: BUILD PKGA!\") == 1\n        assert str(c.out).count(\"pkgb/0.1: WARN: BUILD PKGB!\") == 1\n        assert str(c.out).count(\"pkgc/0.1: WARN: BUILD PKGC!\") == 1\n        assert \"pkga/0.1 (test package): Running test()\" in c.out\n        assert \"pkgb/0.1 (test package): Running test()\" in c.out\n        assert \"pkgc/0.1 (test package): Running test()\" in c.out\n\n        # A second conan workspace create will not re-build\n        c.run(\"workspace create\")\n        assert \"WARN: BUILD ZLIB!\" not in c.out\n        assert \"WARN: BUILD PKGA!\" not in c.out\n        assert \"WARN: BUILD PKGB!\" not in c.out\n        assert \"WARN: BUILD PKBC!\" not in c.out\n        assert \"pkga/0.1 (test package): Running test()\" not in c.out\n        assert \"pkgb/0.1 (test package): Running test()\" not in c.out\n        assert \"pkgc/0.1 (test package): Running test()\" not in c.out\n\n        c.run(\"upload zlib/* -r=default -c\")\n        c.run(\"remove zlib/* -c\")\n        c.run(\"remove pkgc/* -c\")\n        c.run(\"workspace create\")\n        assert \"WARN: BUILD ZLIB!\" not in c.out\n        assert \"pkgc/0.1: WARN: BUILD PKGC!\" in c.out\n\n\n    def test_create_dynamic_name(self):\n        workspace = textwrap.dedent(\"\"\"\\\n            import os\n            from conan import Workspace\n\n            class MyWorkspace(Workspace):\n                def packages(self):\n                    result = {}\n                    for f in os.listdir(self.folder):\n                        if os.path.isdir(os.path.join(self.folder, f)):\n                            result[f\"{f}/0.1\"] = {\"path\": f}\n                    return result\n           \"\"\")\n        c = TestClient(light=True)\n        c.save({\"conanws.py\": workspace,\n                \"pkga/conanfile.py\": GenConanfile()})\n        c.run(\"workspace info\")\n        assert \"pkga/0.1\" in c.out\n        c.run(\"workspace create\")\n        assert \"Workspace create pkga/0.1\" in c.out\n\n\n    def test_host_build_require(self):\n        c = TestClient()\n        protobuf = textwrap.dedent(\"\"\"\\\n            from conan import ConanFile\n            class Protobuf(ConanFile):\n                name = \"protobuf\"\n                version = \"0.1\"\n                settings = \"os\"\n\n                def build(self):\n                    self.output.info(f\"Building for: {self.settings.os}!!!\")\n            \"\"\")\n        app = textwrap.dedent(\"\"\"\\\n            from conan import ConanFile\n            class Protobuf(ConanFile):\n                name = \"app\"\n                version = \"0.1\"\n                requires = \"protobuf/0.1\"\n                tool_requires = \"protobuf/0.1\"\n            \"\"\")\n        c.save({\"protobuf/conanfile.py\": protobuf,\n                \"app/conanfile.py\": app})\n        c.run(\"workspace init .\")\n        c.run(\"workspace add protobuf\")\n        c.run(\"workspace add app\")\n\n        c.run(\"workspace create -s:b os=Linux -s:h os=Windows\")\n\n        assert \"protobuf/0.1: Building for: Windows!!!\" in c.out\n        assert \"protobuf/0.1: Building for: Linux!!!\" in c.out\n\n\nclass TestSource:\n    def test_source(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\"})\n\n        pkga = textwrap.dedent(\"\"\"\\\n            from conan import ConanFile\n            class TestPackage(ConanFile):\n                name = \"pkga\"\n                version = \"0.1\"\n                def source(self):\n                    self.output.info(\"Executing SOURCE!!!\")\n            \"\"\")\n        pkgb = textwrap.dedent(\"\"\"\\\n            from conan import ConanFile\n            class TestPackage(ConanFile):\n                name = \"pkgb\"\n                version = \"0.1\"\n                requires = \"pkga/0.1\"\n                def source(self):\n                    self.output.info(\"Executing SOURCE!!!\")\n            \"\"\")\n        pkgc = textwrap.dedent(\"\"\"\\\n            from conan import ConanFile\n            class TestPackage(ConanFile):\n                name = \"pkgc\"\n                version = \"0.1\"\n                requires = \"pkgb/0.1\"\n                def source(self):\n                    self.output.info(\"Executing SOURCE!!!\")\n            \"\"\")\n        c.save({\"pkga/conanfile.py\": pkga,\n                \"pkgb/conanfile.py\": pkgb,\n                \"pkgc/conanfile.py\": pkgc})\n        c.run(\"workspace add pkga\")\n        c.run(\"workspace add pkgb\")\n        c.run(\"workspace add pkgc\")\n        c.run(\"workspace source\")\n        assert \"conanfile.py (pkga/0.1): Executing SOURCE!!!\" in c.out\n        assert \"conanfile.py (pkgb/0.1): Executing SOURCE!!!\" in c.out\n        assert \"conanfile.py (pkgc/0.1): Executing SOURCE!!!\" in c.out\n\n\nclass TestInstall:\n    def test_install(self):\n        c = TestClient()\n        c.save({\"conanws.yml\": \"\"})\n\n        pkg = textwrap.dedent(\"\"\"\\\n            from conan import ConanFile\n            class Package(ConanFile):\n                name = \"{}\"\n                version = \"0.1\"\n                settings = \"os\", \"build_type\"\n                {}\n                generators = \"CMakeToolchain\"\n            \"\"\")\n\n        c.save({\"pkga/conanfile.py\": pkg.format(\"pkga\", ''),\n                \"pkgb/conanfile.py\": pkg.format(\"pkgb\", 'requires=\"pkga/0.1\"'),\n                \"pkgc/conanfile.py\": pkg.format(\"pkgc\", 'requires=\"pkgb/0.1\"')})\n        c.run(\"workspace add pkga\")\n        c.run(\"workspace add pkgb\")\n        c.run(\"workspace add pkgc\")\n        c.run(\"workspace install\")\n        assert \"conanfile.py (pkga/0.1): CMakeToolchain generated\" in c.out\n        assert \"conanfile.py (pkgb/0.1): CMakeToolchain generated\" in c.out\n        assert \"conanfile.py (pkgc/0.1): CMakeToolchain generated\" in c.out\n\n\ndef test_keep_core_conf():\n    c = TestClient()\n    myprofile = textwrap.dedent(\"\"\"\\\n        [settings]\n        os=FreeBSD\n        arch=armv7\n        \"\"\")\n    conanfile = textwrap.dedent(\"\"\"\\\n        from conan import ConanFile\n\n        class Pkg(ConanFile):\n            name = \"pkga\"\n            version = \"0.1\"\n            settings = \"os\", \"arch\"\n\n            def generate(self):\n                self.output.info(f\"Generating!: {self.settings.os}-{self.settings.arch}!!!!\")\n        \"\"\")\n    c.save_home({\"profiles/myprofile\": myprofile})\n    c.run(\"profile show \")\n    c.save({\"conanws.yml\": \"\",\n            \"pkga/conanfile.py\": conanfile})\n    c.run(\"workspace add pkga\")\n    # The injected -cc is still applied to every \"conan install\"\n    c.run(\"workspace install -cc core:default_profile=myprofile\")\n    assert \"conanfile.py (pkga/0.1): Generating!: FreeBSD-armv7!!!!\" in c.out\n    # also the global.conf\n    c.save_home({\"global.conf\": \"core:default_profile=myprofile\"})\n    c.run(\"workspace install\")\n    assert \"conanfile.py (pkga/0.1): Generating!: FreeBSD-armv7!!!!\" in c.out\n","numLines":937,"startLine":1,"totalLines":937}}}
