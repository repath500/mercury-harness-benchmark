+class TestListFormat:
+    def test_new_format_parse(self):
+        # New list-based format, ref explicitly defined
+        c = TestClient(light=True)
+        c.save({"conanws.yml": textwrap.dedent("""\
+                    packages:
+                      - path: dep1
+                        ref: dep1/0.1
+                      - path: dep2
+                        ref: dep2/0.1
+                        output_folder: out
+                    """),
+                "dep1/conanfile.py": GenConanfile("dep1", "0.1"),
+                "dep2/conanfile.py": GenConanfile("dep2", "0.1")})
+        c.run("workspace info --format=json")
+        info = json.loads(c.stdout)
+        assert info["packages"] == {"dep1/0.1": {"path": "dep1"},
+                                    "dep2/0.1": {"path": "dep2", "output_folder": "out"}}
+
+    def test_new_format_ref_deduced(self):
+        # No ref in the yml: deduce it from the conanfile
+        c = TestClient(light=True)
+        c.save({"conanws.yml": "packages:\n  - path: dep1\n",
+                "dep1/conanfile.py": GenConanfile("dep1", "0.1")})
+        c.run("workspace info --format=json")
+        info = json.loads(c.stdout)
+        assert info["packages"] == {"dep1/0.1": {"path": "dep1"}}
+
+    def test_new_format_missing_path_error(self):
+        c = TestClient(light=True)
+        c.save({"conanws.yml": "packages:\n  - path: nodep\n",
+                "dep1/conanfile.py": GenConanfile("dep1", "0.1")})
+        c.run("workspace info", assert_error=True)
+        assert "Workspace editable not found" in c.out
+
+    def test_new_format_ref_deduction_error(self):
+        c = TestClient(light=True)
+        c.save({"conanws.yml": "packages:\n  - path: dep1\n",
+                "dep1/conanfile.py": GenConanfile()})
+        c.run("workspace info", assert_error=True)
+        assert "Could not deduce the reference" in c.out
+
+    def test_old_format_backward_compatibility(self):
+        c = TestClient(light=True)
+        c.save({"conanws.yml": textwrap.dedent("""\
+                    packages:
+                      dep1/0.1:
+                        path: dep1
+                    """),
+                "dep1/conanfile.py": GenConanfile("dep1", "0.1")})
+        c.run("workspace info --format=json")
+        info = json.loads(c.stdout)
+        assert info["packages"] == {"dep1/0.1": {"path": "dep1"}}
+        # Adding a package keeps working and preserves the old entry
+        c.save({"dep2/conanfile.py": GenConanfile("dep2", "0.1")})
+        c.run("workspace add dep2")
+        c.run("workspace info --format=json")
+        info = json.loads(c.stdout)
+        assert set(info["packages"].keys()) == {"dep1/0.1", "dep2/0.1"}
+        data = yaml.safe_load(c.load("conanws.yml"))
+        assert data["packages"] == [{"ref": "dep1/0.1", "path": "dep1"},
+                                    {"path": "dep2", "ref": "dep2/0.1"}]
+
+    def test_add_duplicated_path_skipped(self):
