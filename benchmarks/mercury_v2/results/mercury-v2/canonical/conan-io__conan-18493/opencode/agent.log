{"type":"tool_use","timestamp":1788511596365,"sessionID":"ses_f94670cb8ffeWdbpzRFsoZCXEH","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-b02c4570a6a46f11","state":{"status":"completed","input":{"filePath":"/testbed/test/integration/workspace/test_workspace.py"},"output":"<path>/testbed/test/integration/workspace/test_workspace.py</path>\n<type>file</type>\n<content>\n1: import json\n2: import os\n3: import shutil\n4: import textwrap\n5: \n6: import pytest\n7: \n8: from conan.api.subapi.workspace import WorkspaceAPI\n9: from conan.test.assets.genconanfile import GenConanfile\n10: from conan.test.utils.scm import create_local_git_repo\n11: from conan.test.utils.test_files import temp_folder\n12: from conan.test.utils.tools import TestClient\n13: from conan.internal.util.files import save_files\n14: \n15: WorkspaceAPI.TEST_ENABLED = \"will_break_next\"\n16: \n17: \n18: class TestWorkspaceRoot:\n19: \n20:     def test_workspace_root(self):\n21:         c = TestClient(light=True)\n22:         # Just check the root command works\n23:         c.run(\"workspace root\", assert_error=True)\n24:         assert \"ERROR: Workspace not defined, please create\" in c.out\n25: \n26:         # error, conanws/ folder does not contain conanws.[py | yml]\n27:         c.save({\"conanws/test.txt\": \"\"})\n28:         with c.chdir(\"conanws\"):\n29:             c.run(\"workspace root\", assert_error=True)\n30:             assert \"ERROR: Workspace not defined, please create\" in c.out\n31:             c.save({\"conanws.yml\": \"\"})\n32:             c.run(\"workspace root\")\n33:             assert c.current_folder in c.stdout\n34: \n35:         # error, empty .py\n36:         c.save({\"conanws.py\": \"\"}, clean_first=True)\n37:         c.run(\"workspace root\", assert_error=True)\n38:         assert \"Error loading conanws.py\" in c.out\n39:         assert \"No subclass of Workspace\" in c.out\n40: \n41:         c.save({\"conanws.yml\": \"\"}, clean_first=True)\n42:         c.run(\"workspace root\")\n43:         assert c.current_folder in c.stdout\n44: \n45: \n46: class TestAddRemove:\n47: \n48:     def test_add(self):\n49:         c = TestClient(light=True)\n50:         c.save({\"conanws.yml\": \"\",\n51:                 \"dep1/conanfile.py\": GenConanfile(\"dep1\", \"0.1\"),\n52:                 \"dep2/conanfile.py\": GenConanfile(\"dep2\", \"0.1\"),\n53:                 \"dep3/conanfile.py\": GenConanfile(\"dep3\", \"0.1\")})\n54:         c.run(\"workspace add dep1\")\n55:         assert \"Reference 'dep1/0.1' added to workspace\" in c.out\n56:         c.run(\"workspace info\")\n57:         assert \"dep1/0.1\" in c.out\n58:         assert \"dep2\" not in c.out\n59:         c.run(\"editable list\")  # No editables in global\n60:         assert \"dep1\" not in c.out\n61:         assert \"dep2\" not in c.out\n62:         c.run(\"workspace add dep2\")\n63:         assert \"Reference 'dep2/0.1' added to workspace\" in c.out\n64:         c.run(\"workspace info\")\n65:         assert \"dep1/0.1\" in c.out\n66:         assert \"dep2/0.1\" in c.out\n67: \n68:         with c.chdir(temp_folder()):  # If we move to another folder, outside WS, no editables\n69:             c.run(\"editable list\")\n70:             assert \"dep1\" not in c.out\n71:             assert \"dep2\" not in c.out\n72: \n73:         c.run(\"workspace info\")\n74:         assert \"dep1/0.1\" in c.out\n75:         assert \"dep2/0.1\" in c.out\n76: \n77:         c.run(\"workspace remove dep1\")\n78:         c.run(\"workspace info\")\n79:         assert \"dep1/0.1\" not in c.out\n80:         assert \"dep2/0.1\" in c.out\n81: \n82:         c.run(\"workspace remove dep2\")\n83:         c.run(\"workspace info\")\n84:         assert \"dep1/0.1\" not in c.out\n85:         assert \"dep2/0.1\" not in c.out\n86: \n87:     def test_add_from_outside(self):\n88:         c = TestClient(light=True)\n89:         c.save({\"sub/conanws.yml\": \"\",\n90:                 \"sub/dep1/conanfile.py\": GenConanfile(\"dep1\", \"0.1\"),\n91:                 \"sub/dep2/conanfile.py\": GenConanfile(\"dep2\", \"0.1\")})\n92:         with c.chdir(\"sub\"):\n93:             c.run(\"workspace add dep1\")\n94:             assert \"Reference 'dep1/0.1' added to workspace\" in c.out\n95:             c.run(\"workspace add dep2\")\n96:             assert \"Reference 'dep2/0.1' added to workspace\" in c.out\n97:             c.run(\"workspace info\")\n98:             assert \"dep1/0.1\" in c.out\n99:             assert \"dep2/0.1\" in c.out\n100:         assert c.load_home(\"editable_packages.json\") is None\n101: \n102:         c.run(\"editable list\")\n103:         assert \"dep1\" not in c.out\n104:         assert \"dep2\" not in c.out\n105:         assert c.load_home(\"editable_packages.json\") is None\n106:         with c.chdir(\"sub\"):\n107:             c.run(\"editable add dep1\")\n108:             assert c.load_home(\"editable_packages.json\") is not None\n109:             c.run(\"editable list\")\n110:             assert \"dep1/0.1\" in c.out\n111:             assert \"dep2/0.1\" not in c.out\n112:             c.run(\"workspace info\")\n113:             assert \"dep1\" in c.out\n114:             assert \"dep2\" in c.out\n115: \n116:         c.run(\"editable list\")\n117:         assert \"dep1/0.1\" in c.out\n118:         assert \"dep2\" not in c.out\n119: \n120:     @pytest.mark.parametrize(\"api\", [False, True])\n121:     def test_dynamic_editables(self, api):\n122:         c = TestClient(light=True)\n123:         conanfile = textwrap.dedent(\"\"\"\n124:             import os\n125:             from conan import ConanFile\n126:             from conan.tools.files import load\n127:             class Lib(ConanFile):\n128:                 def set_name(self):\n129:                     self.name = load(self, os.path.join(self.recipe_folder, \"name.txt\"))\n130:                 def set_version(self):\n131:                     self.version = load(self, os.path.join(self.recipe_folder, \"version.txt\"))\n132:             \"\"\")\n133:         if not api:\n134:             workspace = textwrap.dedent(\"\"\"\\\n135:                 import os\n136:                 from conan import Workspace\n137: \n138:                 class MyWorkspace(Workspace):\n139:                     def packages(self):\n140:                         result = {}\n141:                         for f in os.listdir(self.folder):\n142:                             if os.path.isdir(os.path.join(self.folder, f)):\n143:                                 full_path = os.path.join(self.folder, f, \"name.txt\")\n144:                                 name = open(full_path).read().strip()\n145:                                 version = open(os.path.join(self.folder, f,\n146:                                                             \"version.txt\")).read().strip()\n147:                                 result[f\"{name}/{version}\"] = {\"path\": f}\n148:                         return result\n149:                 \"\"\")\n150:         else:\n151:             workspace = textwrap.dedent(\"\"\"\\\n152:                 import os\n153:                 from conan import Workspace\n154: \n155:                 class MyWorkspace(Workspace):\n156:                     def packages(self):\n157:                         result = {}\n158:                         for f in os.listdir(self.folder):\n159:                             if os.path.isdir(os.path.join(self.folder, f)):\n160:                                 conanfile = self.load_conanfile(f)\n161:                                 result[f\"{conanfile.name}/{conanfile.version}\"] = {\"path\": f}\n162:                         return result\n163:                \"\"\")\n164: \n165:         c.save({\"conanws.py\": workspace,\n166:                 \"dep1/conanfile.py\": conanfile,\n167:                 \"dep1/name.txt\": \"pkg\",\n168:                 \"dep1/version.txt\": \"2.1\"})\n169:         c.run(\"workspace info --format=json\")\n170:         info = json.loads(c.stdout)\n171:         assert info[\"packages\"] == {\"pkg/2.1\": {\"path\": \"dep1\"}}\n172:         c.save({\"dep1/name.txt\": \"other\",\n173:                 \"dep1/version.txt\": \"14.5\"})\n174:         c.run(\"workspace info --format=json\")\n175:         info = json.loads(c.stdout)\n176:         assert info[\"packages\"] == {\"other/14.5\": {\"path\": \"dep1\"}}\n177:         c.run(\"install --requires=other/14.5\")\n178:         # Doesn't fail\n179:         assert \"other/14.5 - Editable\" in c.out\n180:         with c.chdir(\"dep1\"):\n181:             c.run(\"install --requires=other/14.5\")\n182:             # Doesn't fail\n183:             assert \"other/14.5 - Editable\" in c.out\n184: \n185:     def test_api_dynamic_version_run(self):\n186:         # https://github.com/conan-io/conan/issues/17306\n187:         c = TestClient(light=True)\n188:         conanfile = textwrap.dedent(\"\"\"\n189:             from io import StringIO\n190:             from conan import ConanFile\n191:             class Lib(ConanFile):\n192:                 name= \"pkg\"\n193:                 def set_version(self):\n194:                     my_buf = StringIO()\n195:                     self.run('echo 2.1', stdout=my_buf)\n196:                     self.version = my_buf.getvalue().strip()\n197:             \"\"\")\n198: \n199:         workspace = textwrap.dedent(\"\"\"\\\n200:             import os\n201:             from conan import Workspace\n202: \n203:             class MyWorkspace(Workspace):\n204:                 def packages(self):\n205:                     conanfile = self.load_conanfile(\"dep1\")\n206:                     return {f\"{conanfile.name}/{conanfile.version}\": {\"path\": \"dep1\"}}\n207:             \"\"\")\n208: \n209:         c.save({\"conanws.py\": workspace,\n210:                 \"dep1/conanfile.py\": conanfile})\n211:         c.run(\"workspace info --format=json\")\n212:         info = json.loads(c.stdout)\n213:         assert info[\"packages\"] == {\"pkg/2.1\": {\"path\": \"dep1\"}}\n214:         c.run(\"install --requires=pkg/2.1\")\n215:         # it will not fail\n216: \n217:     def test_error_uppercase(self):\n218:         c = TestClient(light=True)\n219:         c.save({\"conanws.yml\": \"\",\n220:                 \"conanfile.py\": GenConanfile(\"Pkg\", \"0.1\")})\n221:         c.run(\"workspace add .\", assert_error=True)\n222:         assert \"ERROR: Conan packages names 'Pkg/0.1' must be all lowercase\" in c.out\n223:         c.save({\"conanfile.py\": GenConanfile()})\n224:         c.run(\"workspace add . --name=Pkg --version=0.1\", assert_error=True)\n225:         assert \"ERROR: Conan packages names 'Pkg/0.1' must be all lowercase\" in c.out\n226: \n227:     def test_add_open_error(self):\n228:         c = TestClient(light=True)\n229:         c.save({\"conanws.yml\": \"\",\n230:                 \"dep/conanfile.py\": GenConanfile(\"dep\", \"0.1\")})\n231:         c.run(\"workspace add dep\")\n232:         c.run(\"workspace open dep/0.1\", assert_error=True)\n233:         assert \"ERROR: Can't open a dependency that is already an editable: dep/0.1\" in c.out\n234: \n235:     def test_remove_product(self):\n236:         c = TestClient(light=True)\n237:         c.save({\"conanws.yml\": \"\",\n238:                 \"mydeppkg/conanfile.py\": GenConanfile(\"mydeppkg\", \"0.1\")})\n239:         c.run(\"workspace add mydeppkg\")\n240:         c.run(\"workspace remove mydeppkg\")\n241:         c.run(\"workspace info\")\n242:         assert \"mydeppkg\" not in c.out\n243: \n244:     def test_remove_removed_folder(self):\n245:         c = TestClient(light=True)\n246:         c.save({\"conanws.yml\": \"\",\n247:                 \"mydeppkg/conanfile.py\": GenConanfile(\"mydeppkg\", \"0.1\")})\n248:         c.run(\"workspace add mydeppkg\")\n249:         # If we now remove the folder\n250:         shutil.rmtree(os.path.join(c.current_folder, \"mydeppkg\"))\n251:         # It can still be removed by path, even if the path doesn't exist\n252:         c.run(\"workspace remove mydeppkg\")\n253:         assert \"Removed from workspace: mydeppkg/0.1\" in c.out\n254:         c.run(\"workspace info\")\n255:         assert \"mydeppkg\" not in c.out\n256: \n257:     def test_custom_add_remove(self):\n258:         c = TestClient(light=True)\n259: \n260:         workspace = textwrap.dedent(\"\"\"\\\n261:             import os\n262:             from conan import Workspace\n263: \n264:             class MyWorkspace(Workspace):\n265:                 def name(self):\n266:                     return \"myws\"\n267: \n268:                 def add(self, ref, path, *args, **kwargs):\n269:                     self.output.info(f\"Adding {ref} at {path}\")\n270:                     super().add(ref, path, *args, **kwargs)\n271: \n272:                 def remove(self, path, *args, **kwargs):\n273:                     self.output.info(f\"Removing {path}\")\n274:                     return super().remove(path, *args, **kwargs)\n275:             \"\"\")\n276: \n277:         c.save({\"conanws.py\": workspace,\n278:                 \"dep/conanfile.py\": GenConanfile(\"dep\", \"0.1\")})\n279:         c.run(\"workspace add dep\")\n280:         assert \"myws: Adding dep/0.1\" in c.out\n281:         c.run(\"workspace info\")\n282:         assert \"dep/0.1\" in c.out\n283:         c.run(\"workspace remove dep\")\n284:         assert \"myws: Removing\" in c.out\n285:         c.run(\"workspace info\")\n286:         assert \"dep/0.1\" not in c.out\n287: \n288: \n289: class TestOpenAdd:\n290:     def test_without_git(self):\n291:         t = TestClient(default_server_user=True, light=True)\n292:         t.save({\"conanfile.py\": GenConanfile(\"pkg\", \"0.1\")})\n293:         t.run(\"create .\")\n294:         t.run(\"upload * -r=default -c\")\n295: \n296:         c = TestClient(servers=t.servers, light=True)\n297:         c.run(f\"workspace open pkg/0.1\")\n298:         assert \"name = 'pkg'\" in c.load(\"pkg/conanfile.py\")\n299: \n300:         # The add should work the same\n301:         c2 = TestClient(servers=t.servers, light=True)\n302:         c2.save({\"conanws.yml\": \"\"})\n303:         c2.run(f\"workspace add --ref=pkg/0.1\")\n304:         assert \"name = 'pkg'\" in c2.load(\"pkg/conanfile.py\")\n305:         c2.run(\"workspace info\")\n306:         assert \"pkg/0.1\" in c2.out\n307: \n308:     def test_without_git_export_sources(self):\n309:         t = TestClient(default_server_user=True, light=True)\n310:         t.save({\"conanfile.py\": GenConanfile(\"pkg\", \"0.1\").with_exports_sources(\"*.txt\"),\n311:                 \"CMakeLists.txt\": \"mycmake\"})\n312:         t.run(\"create .\")\n313:         t.run(\"upload * -r=default -c\")\n314: \n315:         c = TestClient(servers=t.servers)\n316:         c.run(\"workspace open pkg/0.1\")\n317:         assert \"name = 'pkg'\" in c.load(\"pkg/conanfile.py\")\n318:         assert \"mycmake\" in c.load(\"pkg/CMakeLists.txt\")\n319: \n320:     def test_workspace_git_scm(self):\n321:         folder = temp_folder()\n322:         conanfile = textwrap.dedent(\"\"\"\n323:             from conan import ConanFile\n324:             from conan.tools.scm import Git\n325: \n326:             class Pkg(ConanFile):\n327:                 name = \"pkg\"\n328:                 version = \"0.1\"\n329:                 def export(self):\n330:                     git = Git(self)\n331:                     git.coordinates_to_conandata()\n332:             \"\"\")\n333:         url, commit = create_local_git_repo(files={\"conanfile.py\": conanfile}, folder=folder,\n334:                                             branch=\"mybranch\")\n335:         t1 = TestClient(default_server_user=True, light=True)\n336:         t1.run_command('git clone \"file://{}\" .'.format(url))\n337:         t1.run(\"create .\")\n338:         t1.run(\"upload * -r=default -c\")\n339: \n340:         c = TestClient(servers=t1.servers, light=True)\n341:         c.run(\"workspace open pkg/0.1\")\n342:         assert c.load(\"pkg/conanfile.py\") == conanfile\n343: \n344:         c2 = TestClient(servers=t1.servers, light=True)\n345:         c2.save({\"conanws.yml\": \"\"})\n346:         c2.run(f\"workspace add --ref=pkg/0.1\")\n347:         assert 'name = \"pkg\"' in c2.load(\"pkg/conanfile.py\")\n348:         c2.run(\"workspace info\")\n349:         assert \"pkg/0.1\" in c2.out\n350: \n351:     def test_workspace_build_editables(self):\n352:         c = TestClient(light=True)\n353:         c.save({\"conanws.yml\": \"\"})\n354: \n355:         c.save({\"pkga/conanfile.py\": GenConanfile(\"pkga\", \"0.1\").with_build_msg(\"BUILD PKGA!\"),\n356:                 \"pkgb/conanfile.py\": GenConanfile(\"pkgb\", \"0.1\").with_build_msg(\"BUILD PKGB!\")\n357:                                                                 .with_requires(\"pkga/0.1\")})\n358:         c.run(\"workspace add pkga\")\n359:         c.run(\"workspace add pkgb\")\n360: \n361:         c.run(\"install --requires=pkgb/0.1 --build=editable\")\n362:         c.assert_listed_binary({\"pkga/0.1\": (\"da39a3ee5e6b4b0d3255bfef95601890afd80709\",\n363:                                              \"EditableBuild\"),\n364:                                 \"pkgb/0.1\": (\"47a5f20ec8fb480e1c5794462089b01a3548fdc5\",\n365:                                              \"EditableBuild\")})\n366:         assert \"pkga/0.1: WARN: BUILD PKGA!\" in c.out\n367:         assert \"pkgb/0.1: WARN: BUILD PKGB!\" in c.out\n368: \n369: \n370: class TestWorkspaceBuild:\n371: \n372:     def test_build(self):\n373:         c = TestClient(light=True)\n374:         c.save({\"conanws.yml\": \"\"})\n375: \n376:         c.save({\"pkga/conanfile.py\": GenConanfile(\"pkga\", \"0.1\").with_build_msg(\"BUILD PKGA!\"),\n377:                 \"pkgb/conanfile.py\": GenConanfile(\"pkgb\", \"0.1\").with_build_msg(\"BUILD PKGB!\")\n378:                .with_requires(\"pkga/0.1\")})\n379:         c.run(\"workspace add pkga\")\n380:         c.run(\"workspace add pkgb\")\n381:         c.run(\"workspace build\")\n382:         c.assert_listed_binary({\"pkga/0.1\": (\"da39a3ee5e6b4b0d3255bfef95601890afd80709\",\n383:                                              \"EditableBuild\")})\n384:         assert \"conanfile.py (pkga/0.1): WARN: BUILD PKGA!\" in c.out\n385:         assert \"conanfile.py (pkgb/0.1): WARN: BUILD PKGB!\" in c.out\n386: \n387:         # It is also possible to build a specific package by path\n388:         # equivalent to ``conan build <path> --build=editable``\n389:         # This can be done even if it is not a product\n390:         c.run(\"workspace build --pkg=pkgc/*\", assert_error=True)\n391:         assert \"ERROR: There are no selected packages defined in the workspace\" in c.out\n392:         c.run(\"workspace build --pkg=pkgb/*\")\n393:         c.assert_listed_binary({\"pkga/0.1\": (\"da39a3ee5e6b4b0d3255bfef95601890afd80709\",\n394:                                              \"EditableBuild\")})\n395:         assert \"conanfile.py (pkga/0.1): WARN: BUILD PKGA!\" in c.out\n396:         assert \"conanfile.py (pkgb/0.1): WARN: BUILD PKGB!\" in c.out\n397: \n398:         c.run(\"workspace build --pkg=pkga/*\")\n399:         assert \"conanfile.py (pkga/0.1): Calling build()\" in c.out\n400:         assert \"conanfile.py (pkga/0.1): WARN: BUILD PKGA!\" in c.out\n401: \n402:     def test_error_if_no_products(self):\n403:         c = TestClient(light=True)\n404:         c.save({\"conanws.yml\": \"\"})\n405:         c.run(\"workspace build\", assert_error=True)\n406:         assert \"ERROR: There are no selected packages defined in the workspace\" in c.out\n407: \n408:     def test_build_external_missing(self):\n409:         c = TestClient(light=True)\n410:         c.save({\"conanws.yml\": \"\"})\n411: \n412:         c.save({\"mymath/conanfile.py\": GenConanfile(\"mymath\", \"0.1\").with_build_msg(\"MyMATH!!\"),\n413:                 \"pkga/conanfile.py\": GenConanfile(\"pkga\", \"0.1\").with_build_msg(\"BUILD PKGA!\")\n414:                                                                 .with_requires(\"mymath/0.1\"),\n415:                 \"pkgb/conanfile.py\": GenConanfile(\"pkgb\", \"0.1\").with_build_msg(\"BUILD PKGB!\")\n416:                .with_requires(\"pkga/0.1\")})\n417:         c.run(\"export mymath\")\n418:         c.run(\"workspace add pkga\")\n419:         c.run(\"workspace add pkgb\")\n420:         c.run(\"workspace build\", assert_error=True)\n421:         assert \"ERROR: Missing prebuilt package for 'mymath/0.1'\" in c.out\n422:         c.run(\"workspace build --build=missing\")\n423:         assert \"Workspace building external mymath/0.1\" in c.out\n424: \n425:     def test_build_dynamic_name_version(self):\n426:         conanfile = textwrap.dedent(\"\"\"\\\n427:             from conan import ConanFile\n428:             class MyConan(ConanFile):\n429:                 def build(self):\n430:                     self.output.info(f\"Building {self.name} AND {self.version}!!!\")\n431:             \"\"\")\n432:         workspace = textwrap.dedent(\"\"\"\\\n433:             import os\n434:             from conan import Workspace\n435: \n436:             class MyWorkspace(Workspace):\n437:                 def packages(self):\n438:                     result = {}\n439:                     for f in os.listdir(self.folder):\n440:                         if os.path.isdir(os.path.join(self.folder, f)):\n441:                             result[f\"{f}/0.1\"] = {\"path\": f}\n442:                     return result\n443:            \"\"\")\n444:         c = TestClient(light=True)\n445:         c.save({\"conanws.py\": workspace,\n446:                 \"pkga/conanfile.py\": conanfile})\n447:         c.run(\"workspace info\")\n448:         assert \"pkga/0.1\" in c.out\n449:         c.run(\"workspace build\")\n450:         assert \"conanfile.py (pkga/0.1): Building pkga AND 0.1!!!\" in c.out\n451: \n452: \n453: class TestNew:\n454:     def test_new(self):\n455:         # Very basic workspace for testing\n456:         c = TestClient(light=True)\n457:         c.run(\"new workspace\")\n458:         assert 'name = \"liba\"' in c.load(\"liba/conanfile.py\")\n459:         c.run(\"workspace info\")\n460:         assert \"liba/0.1\" in c.out\n461:         assert \"libb/0.1\" in c.out\n462:         assert \"app1/0.1\" in c.out\n463: \n464:     def test_new_dep(self):\n465:         c = TestClient(light=True)\n466:         c.run(\"new workspace -d requires=dep/0.1\")\n467:         assert 'self.requires(\"dep/0.1\")' in c.load(\"liba/conanfile.py\")\n468:         assert 'name = \"liba\"' in c.load(\"liba/conanfile.py\")\n469:         c.run(\"workspace info\")\n470:         assert \"liba/0.1\" in c.out\n471:         assert \"libb/0.1\" in c.out\n472:         assert \"app1/0.1\" in c.out\n473: \n474: \n475: class TestMeta:\n476:     def test_install(self):\n477:         c = TestClient()\n478:         c.save({\"dep/conanfile.py\": GenConanfile()})\n479:         c.run(\"create dep --name=dep1 --version=0.1\")\n480:         c.run(\"create dep --name=dep2 --version=0.1\")\n481:         c.save({\"conanws.yml\": \"\",\n482:                 \"liba/conanfile.py\": GenConanfile(\"liba\", \"0.1\").with_requires(\"dep1/0.1\",\n483:                                                                                \"dep2/0.1\"),\n484:                 \"libb/conanfile.py\": GenConanfile(\"libb\", \"0.1\").with_requires(\"liba/0.1\",\n485:                                                                                \"dep1/0.1\")},\n486:                clean_first=True)\n487:         c.run(\"workspace add liba\")\n488:         c.run(\"workspace add libb\")\n489:         c.run(\"workspace super-install -g CMakeDeps -g CMakeToolchain -of=build --envs-generation=false\")\n490:         assert \"Workspace conanws.py not found in the workspace folder, using default\" in c.out\n491:         files = os.listdir(os.path.join(c.current_folder, \"build\"))\n492:         assert \"conan_toolchain.cmake\" in files\n493:         assert \"dep1-config.cmake\" in files\n494:         assert \"dep2-config.cmake\" in files\n495:         assert \"liba-config.cmake\" not in files\n496:         assert \"libb-config.cmake\" not in files\n497:         assert \"conanbuild.bat\" not in files\n498:         assert \"conanbuild.sh\" not in files\n499: \n500:     def test_conanfilews_custom(self):\n501:         c = TestClient()\n502:         conanfilews = textwrap.dedent(\"\"\"\n503:             from conan import ConanFile\n504:             from conan import Workspace\n505: \n506:             class MyWs(ConanFile):\n507:                 settings = \"arch\", \"build_type\"\n508:                 generators = \"MSBuildDeps\"\n509: \n510:             class Ws(Workspace):\n511:                 def root_conanfile(self):\n512:                     return MyWs\n513:             \"\"\")\n514: \n515:         c.save({\"dep/conanfile.py\": GenConanfile(\"dep\", \"0.1\"),\n516:                 \"conanws.py\": conanfilews})\n517:         c.run(\"workspace add dep\")\n518:         c.run(\"workspace super-install -of=build\")\n519:         files = os.listdir(os.path.join(c.current_folder, \"build\"))\n520:         assert \"conandeps.props\" in files\n521: \n522:     def test_conanfilews_errors(self):\n523:         c = TestClient()\n524:         conanfilews = textwrap.dedent(\"\"\"\n525:             from conan import ConanFile\n526:             from conan import Workspace\n527:             class MyWs(ConanFile):\n528:                 requires = \"dep/0.1\"\n529: \n530:             class Ws(Workspace):\n531:                 def root_conanfile(self):\n532:                     return MyWs\n533:             \"\"\")\n534: \n535:         c.save({\"conanws.yml\": \"conanfilews: myconanfilews.py\",\n536:                 \"dep/conanfile.py\": GenConanfile(\"dep\", \"0.1\"),\n537:                 \"conanws.py\": conanfilews})\n538:         c.run(\"workspace super-install\", assert_error=True)\n539:         assert \"ERROR: There are no selected packages defined in the workspace\" in c.out\n540:         c.run(\"workspace add dep\")\n541:         c.run(\"workspace super-install\", assert_error=True)\n542:         assert \"ERROR: Conanfile in conanws.py shouldn't have 'requires'\" in c.out\n543: \n544:     def test_install_partial(self):\n545:         # If we want to install only some part of the workspace\n546:         c = TestClient()\n547:         c.save({\"dep/conanfile.py\": GenConanfile()})\n548:         c.run(\"create dep --name=dep1 --version=0.1\")\n549:         c.run(\"create dep --name=dep2 --version=0.1\")\n550:         c.save({\"conanws.yml\": \"\",\n551:                 \"liba/conanfile.py\": GenConanfile(\"liba\", \"0.1\").with_requires(\"dep1/0.1\"),\n552:                 \"libb/conanfile.py\": GenConanfile(\"libb\", \"0.1\").with_requires(\"liba/0.1\"),\n553:                 \"libc/conanfile.py\": GenConanfile(\"libc\", \"0.1\").with_requires(\"libb/0.1\",\n554:                                                                                \"dep2/0.1\")},\n555:                clean_first=True)\n556:         c.run(\"workspace add liba\")\n557:         c.run(\"workspace add libb\")\n558:         c.run(\"workspace add libc\")\n559:         for arg in (\"--pkg=libb/*\", \"--pkg=libb/* --pkg=liba/*\"):\n560:             c.run(f\"workspace super-install {arg} -g CMakeDeps -of=build\")\n561:             assert \"dep1/0.1\" in c.out\n562:             assert \"dep2/0.1\" not in c.out\n563:             assert \"libc/0.1\" not in c.out\n564:             files = os.listdir(os.path.join(c.current_folder, \"build\"))\n565:             assert \"dep1-config.cmake\" in files\n566:             assert \"dep2-config.cmake\" not in files\n567: \n568: \n569: def test_workspace_with_local_recipes_index():\n570:     c3i_folder = temp_folder()\n571:     recipes_folder = os.path.join(c3i_folder, \"recipes\")\n572:     zlib_config = textwrap.dedent(\"\"\"\n573:        versions:\n574:          \"1.2.11\":\n575:            folder: all\n576:        \"\"\")\n577:     save_files(recipes_folder, {\"zlib/config.yml\": zlib_config,\n578:                                 \"zlib/all/conanfile.py\": str(GenConanfile(\"zlib\")),\n579:                                 \"zlib/all/conandata.yml\": \"\"})\n580: \n581:     c = TestClient(light=True)\n582:     c.save({\".conanrc\": 'conan_home=deps\\n'})\n583:     c.run(f'remote add local \"{c3i_folder}\"')\n584: \n585:     c.run(\"list zlib/1.2.11#* -r=local\")\n586:     assert \"zlib/1.2.11\" in c.out  # It doesn't crash\n587:     c.run(\"list zlib/1.2.11#*\")\n588:     assert \"zlib/1.2.11\" not in c.out\n589: \n590: \n591: class TestClean:\n592:     def test_clean(self):\n593:         # Using cmake_layout, we can clean the build folders\n594:         c = TestClient()\n595:         c.save({\"conanws.yml\": \"name: my_workspace\"})\n596:         pkga = GenConanfile(\"pkga\", \"0.1\").with_settings(\"build_type\")\n597:         pkgb = GenConanfile(\"pkgb\", \"0.1\").with_requires(\"pkga/0.1\").with_settings(\"build_type\")\n598:         c.save({\"pkga/conanfile.py\": pkga ,\n599:                 \"pkgb/conanfile.py\": pkgb,\n600:                 \"pkgc/conanfile.py\": GenConanfile(\"pkgc\", \"0.1\").with_requires(\"pkgb/0.1\")})\n601:         c.run(\"workspace add pkga -of=build/pkga\")\n602:         c.run(\"workspace add pkgb -of=build/pkgb\")\n603:         c.run(\"workspace add pkgc\")\n604:         c.run(\"workspace build\")\n605:         assert os.path.exists(os.path.join(c.current_folder, \"build\", \"pkga\"))\n606:         assert os.path.exists(os.path.join(c.current_folder, \"build\", \"pkgb\"))\n607:         c.run(\"workspace clean\")\n608:         assert \"my_workspace: Removing pkga/0.1 output folder\" in c.out\n609:         assert \"my_workspace: Removing pkgb/0.1 output folder\" in c.out\n610:         assert \"Editable pkgc/0.1 doesn't have an output_folder defined\" in c.out\n611:         assert not os.path.exists(os.path.join(c.current_folder, \"build\", \"pkga\"))\n612:         assert not os.path.exists(os.path.join(c.current_folder, \"build\", \"pkgb\"))\n613: \n614:     def test_custom_clean(self):\n615:         conanfilews = textwrap.dedent(\"\"\"\n616:             from conan import Workspace\n617: \n618:             class Ws(Workspace):\n619:                 def name(self):\n620:                     return \"my_workspace\"\n621:                 def clean(self):\n622:                     self.output.info(\"MY CLEAN!!!!\")\n623:             \"\"\")\n624:         c = TestClient()\n625:         c.save({\"conanws.py\": conanfilews})\n626:         c.run(\"workspace clean\")\n627:         assert \"my_workspace: MY CLEAN!!!\" in c.out\n628: \n629: \n630: def test_relative_paths():\n631:     # This is using the meta-project\n632:     c = TestClient()\n633:     c.run(\"new cmake_lib -d name=liba --output=liba\")\n634:     c.run(\"new cmake_exe -d name=app1 -d requires=liba/0.1 --output=app1\")\n635:     c.run(\"new cmake_lib -d name=libb --output=other/libb\")\n636:     c.run(\"new cmake_exe -d name=app2 -d requires=libb/0.1 --output=other/app2\")\n637:     c.run(\"workspace init mywks\")\n638:     c.run(\"workspace init otherwks\")\n639:     # cd mywks\n640:     with c.chdir(\"mywks\"):\n641:         c.run(\"workspace add ../liba\")\n642:         c.run(\"workspace add ../app1\")\n643:         c.run(\"workspace info\")\n644:         expected = textwrap.dedent(\"\"\"\\\n645:             packages\n646:               app1/0.1\n647:                 path: ../app1\n648:               liba/0.1\n649:                 path: ../liba\n650:             \"\"\")\n651:         assert expected in c.out\n652:         c.run(\"graph info --requires=app1/0.1\")\n653:         c.assert_listed_require({\"app1/0.1\": \"Editable\", \"liba/0.1\": \"Editable\"})\n654:     # cd otherwks\n655:     with c.chdir(\"otherwks\"):\n656:         c.run(\"workspace add ../other/libb\")\n657:         c.run(\"workspace add ../other/app2\")\n658:         c.run(\"workspace info\")\n659:         expected = textwrap.dedent(\"\"\"\\\n660:             packages\n661:               app2/0.1\n662:                 path: ../other/app2\n663:               libb/0.1\n664:                 path: ../other/libb\n665:             \"\"\")\n666:         assert expected in c.out\n667:         c.run(\"graph info --requires=app2/0.1\")\n668:         c.assert_listed_require({\"app2/0.1\": \"Editable\", \"libb/0.1\": \"Editable\"})\n669: \n670: \n671: def test_host_build_require():\n672:     c = TestClient()\n673:     protobuf = textwrap.dedent(\"\"\"\\\n674:         from conan import ConanFile\n675:         from conan.tools.files import save, copy\n676:         class Protobuf(ConanFile):\n677:             name = \"protobuf\"\n678:             version = \"0.1\"\n679:             settings = \"os\"\n680: \n681:             def layout(self):\n682:                 self.folders.build = f\"mybuild/folder_{self.settings.os}\"\n683:                 self.cpp.build.bindirs = [\".\"]\n684: \n685:             def build(self):\n686:                 save(self, \"myprotobuf.txt\", f\"MYOS={self.settings.os}!!!\")\n687: \n688:             def package(self):\n689:                 copy(self, \"myprotobuf.txt\", src=self.build_folder, dst=self.package_folder)\n690: \n691:             def package_info(self):\n692:                 self.cpp_info.bindirs = [\".\"]\n693:         \"\"\")\n694:     app = textwrap.dedent(\"\"\"\\\n695:         import os\n696:         from conan import ConanFile\n697:         from conan.tools.files import load\n698:         class Protobuf(ConanFile):\n699:             name = \"app\"\n700:             version = \"0.1\"\n701:             requires = \"protobuf/0.1\"\n702:             tool_requires = \"protobuf/0.1\"\n703: \n704:             def build(self):\n705:                 binhost = self.dependencies.host[\"protobuf\"].cpp_info.bindir\n706:                 binbuild = self.dependencies.build[\"protobuf\"].cpp_info.bindir\n707:                 host = load(self, os.path.join(binhost, \"myprotobuf.txt\"))\n708:                 build = load(self, os.path.join(binbuild, \"myprotobuf.txt\"))\n709:                 self.output.info(f\"BUILDING WITH BINHOST: {host}\")\n710:                 self.output.info(f\"BUILDING WITH BINBUILD: {build}\")\n711:         \"\"\")\n712:     c.save({\"protobuf/conanfile.py\": protobuf,\n713:             \"app/conanfile.py\": app})\n714:     c.run(\"workspace init .\")\n715:     c.run(\"workspace add protobuf\")\n716:     c.run(\"workspace add app\")\n717:     c.run(\"install app --build=editable -s:b os=Linux -s:h os=Windows\")\n718: \n719:     assert c.load(\"protobuf/mybuild/folder_Linux/myprotobuf.txt\") == \"MYOS=Linux!!!\"\n720:     assert c.load(\"protobuf/mybuild/folder_Windows/myprotobuf.txt\") == \"MYOS=Windows!!!\"\n721: \n722:     shutil.rmtree(os.path.join(c.current_folder, \"protobuf\", \"mybuild\"))\n723:     assert not os.path.exists(os.path.join(c.current_folder, \"protobuf\", \"mybuild\"))\n724:     c.run(\"workspace build -s:b os=Linux -s:h os=Windows\")\n725:     assert \"conanfile.py (app/0.1): BUILDING WITH BINHOST: MYOS=Windows!!!\" in c.out\n726:     assert \"conanfile.py (app/0.1): BUILDING WITH BINBUILD: MYOS=Linux!!!\" in c.out\n727:     assert c.load(\"protobuf/mybuild/folder_Linux/myprotobuf.txt\") == \"MYOS=Linux!!!\"\n728:     assert c.load(\"protobuf/mybuild/folder_Windows/myprotobuf.txt\") == \"MYOS=Windows!!!\"\n729: \n730:     shutil.rmtree(os.path.join(c.current_folder, \"protobuf\", \"mybuild\"))\n731:     assert not os.path.exists(os.path.join(c.current_folder, \"protobuf\", \"mybuild\"))\n732:     c.run(\"workspace create -s:b os=Linux -s:h os=Windows\")\n733:     assert \"app/0.1: BUILDING WITH BINHOST: MYOS=Windows!!!\" in c.out\n734:     assert \"app/0.1: BUILDING WITH BINBUILD: MYOS=Linux!!!\" in c.out\n735: \n736: \n737: class TestCreate:\n738:     def test_create(self):\n739:         c = TestClient(light=True, default_server_user=True)\n740:         c.save({\"conanfile.py\": GenConanfile(\"zlib\", \"0.1\").with_build_msg(\"BUILD ZLIB!\")})\n741:         c.run(\"export .\")\n742:         c.save({\"conanws.yml\": \"\"}, clean_first=True)\n743:         c.save({\"pkga/conanfile.py\": GenConanfile(\"pkga\", \"0.1\").with_requires(\"zlib/0.1\")\n744:                                                                 .with_build_msg(\"BUILD PKGA!\"),\n745:                 \"pkga/test_package/conanfile.py\": GenConanfile().with_test(\"pass\"),\n746:                 \"pkgb/conanfile.py\": GenConanfile(\"pkgb\", \"0.1\").with_build_msg(\"BUILD PKGB!\")\n747:                .with_requires(\"pkga/0.1\"),\n748:                 \"pkgb/test_package/conanfile.py\": GenConanfile().with_test(\"pass\"),\n749:                 \"pkgc/conanfile.py\": GenConanfile(\"pkgc\", \"0.1\").with_build_msg(\"BUILD PKGC!\")\n750:                .with_requires(\"pkgb/0.1\"),\n751:                 \"pkgc/test_package/conanfile.py\": GenConanfile().with_test(\"pass\"),\n752:                 })\n753:         c.run(\"workspace add pkga\")\n754:         c.run(\"workspace add pkgb\")\n755:         c.run(\"workspace add pkgc\")\n756:         c.run(\"workspace create --build=zlib/*\")\n757:         assert str(c.out).count(\"zlib/0.1: WARN: BUILD ZLIB!\") == 1\n758:         assert str(c.out).count(\"pkga/0.1: WARN: BUILD PKGA!\") == 1\n759:         assert str(c.out).count(\"pkgb/0.1: WARN: BUILD PKGB!\") == 1\n760:         assert str(c.out).count(\"pkgc/0.1: WARN: BUILD PKGC!\") == 1\n761:         assert \"pkga/0.1 (test package): Running test()\" in c.out\n762:         assert \"pkgb/0.1 (test package): Running test()\" in c.out\n763:         assert \"pkgc/0.1 (test package): Running test()\" in c.out\n764: \n765:         # A second conan workspace create will not re-build\n766:         c.run(\"workspace create\")\n767:         assert \"WARN: BUILD ZLIB!\" not in c.out\n768:         assert \"WARN: BUILD PKGA!\" not in c.out\n769:         assert \"WARN: BUILD PKGB!\" not in c.out\n770:         assert \"WARN: BUILD PKBC!\" not in c.out\n771:         assert \"pkga/0.1 (test package): Running test()\" not in c.out\n772:         assert \"pkgb/0.1 (test package): Running test()\" not in c.out\n773:         assert \"pkgc/0.1 (test package): Running test()\" not in c.out\n774: \n775:         c.run(\"upload zlib/* -r=default -c\")\n776:         c.run(\"remove zlib/* -c\")\n777:         c.run(\"remove pkgc/* -c\")\n778:         c.run(\"workspace create\")\n779:         assert \"WARN: BUILD ZLIB!\" not in c.out\n780:         assert \"pkgc/0.1: WARN: BUILD PKGC!\" in c.out\n781: \n782: \n783:     def test_create_dynamic_name(self):\n784:         workspace = textwrap.dedent(\"\"\"\\\n785:             import os\n786:             from conan import Workspace\n787: \n788:             class MyWorkspace(Workspace):\n789:                 def packages(self):\n790:                     result = {}\n791:                     for f in os.listdir(self.folder):\n792:                         if os.path.isdir(os.path.join(self.folder, f)):\n793:                             result[f\"{f}/0.1\"] = {\"path\": f}\n794:                     return result\n795:            \"\"\")\n796:         c = TestClient(light=True)\n797:         c.save({\"conanws.py\": workspace,\n798:                 \"pkga/conanfile.py\": GenConanfile()})\n799:         c.run(\"workspace info\")\n800:         assert \"pkga/0.1\" in c.out\n801:         c.run(\"workspace create\")\n802:         assert \"Workspace create pkga/0.1\" in c.out\n803: \n804: \n805:     def test_host_build_require(self):\n806:         c = TestClient()\n807:         protobuf = textwrap.dedent(\"\"\"\\\n808:             from conan import ConanFile\n809:             class Protobuf(ConanFile):\n810:                 name = \"protobuf\"\n811:                 version = \"0.1\"\n812:                 settings = \"os\"\n813: \n814:                 def build(self):\n815:                     self.output.info(f\"Building for: {self.settings.os}!!!\")\n816:             \"\"\")\n817:         app = textwrap.dedent(\"\"\"\\\n818:             from conan import ConanFile\n819:             class Protobuf(ConanFile):\n820:                 name = \"app\"\n821:                 version = \"0.1\"\n822:                 requires = \"protobuf/0.1\"\n823:                 tool_requires = \"protobuf/0.1\"\n824:             \"\"\")\n825:         c.save({\"protobuf/conanfile.py\": protobuf,\n826:                 \"app/conanfile.py\": app})\n827:         c.run(\"workspace init .\")\n828:         c.run(\"workspace add protobuf\")\n829:         c.run(\"workspace add app\")\n830: \n831:         c.run(\"workspace create -s:b os=Linux -s:h os=Windows\")\n832: \n833:         assert \"protobuf/0.1: Building for: Windows!!!\" in c.out\n834:         assert \"protobuf/0.1: Building for: Linux!!!\" in c.out\n835: \n836: \n837: class TestSource:\n838:     def test_source(self):\n839:         c = TestClient(light=True)\n840:         c.save({\"conanws.yml\": \"\"})\n841: \n842:         pkga = textwrap.dedent(\"\"\"\\\n843:             from conan import ConanFile\n844:             class TestPackage(ConanFile):\n845:                 name = \"pkga\"\n846:                 version = \"0.1\"\n847:                 def source(self):\n848:                     self.output.info(\"Executing SOURCE!!!\")\n849:             \"\"\")\n850:         pkgb = textwrap.dedent(\"\"\"\\\n851:             from conan import ConanFile\n852:             class TestPackage(ConanFile):\n853:                 name = \"pkgb\"\n854:                 version = \"0.1\"\n855:                 requires = \"pkga/0.1\"\n856:                 def source(self):\n857:                     self.output.info(\"Executing SOURCE!!!\")\n858:             \"\"\")\n859:         pkgc = textwrap.dedent(\"\"\"\\\n860:             from conan import ConanFile\n861:             class TestPackage(ConanFile):\n862:                 name = \"pkgc\"\n863:                 version = \"0.1\"\n864:                 requires = \"pkgb/0.1\"\n865:                 def source(self):\n866:                     self.output.info(\"Executing SOURCE!!!\")\n867:             \"\"\")\n868:         c.save({\"pkga/conanfile.py\": pkga,\n869:                 \"pkgb/conanfile.py\": pkgb,\n870:                 \"pkgc/conanfile.py\": pkgc})\n871:         c.run(\"workspace add pkga\")\n872:         c.run(\"workspace add pkgb\")\n873:         c.run(\"workspace add pkgc\")\n874:         c.run(\"workspace source\")\n875:         assert \"conanfile.py (pkga/0.1): Executing SOURCE!!!\" in c.out\n876:         assert \"conanfile.py (pkgb/0.1): Executing SOURCE!!!\" in c.out\n877:         assert \"conanfile.py (pkgc/0.1): Executing SOURCE!!!\" in c.out\n878: \n879: \n880: class TestInstall:\n881:     def test_install(self):\n882:         c = TestClient()\n883:         c.save({\"conanws.yml\": \"\"})\n884: \n885:         pkg = textwrap.dedent(\"\"\"\\\n886:             from conan import ConanFile\n887:             class Package(ConanFile):\n888:                 name = \"{}\"\n889:                 version = \"0.1\"\n890:                 settings = \"os\", \"build_type\"\n891:                 {}\n892:                 generators = \"CMakeToolchain\"\n893:             \"\"\")\n894: \n895:         c.save({\"pkga/conanfile.py\": pkg.format(\"pkga\", ''),\n896:                 \"pkgb/conanfile.py\": pkg.format(\"pkgb\", 'requires=\"pkga/0.1\"'),\n897:                 \"pkgc/conanfile.py\": pkg.format(\"pkgc\", 'requires=\"pkgb/0.1\"')})\n898:         c.run(\"workspace add pkga\")\n899:         c.run(\"workspace add pkgb\")\n900:         c.run(\"workspace add pkgc\")\n901:         c.run(\"workspace install\")\n902:         assert \"conanfile.py (pkga/0.1): CMakeToolchain generated\" in c.out\n903:         assert \"conanfile.py (pkgb/0.1): CMakeToolchain generated\" in c.out\n904:         assert \"conanfile.py (pkgc/0.1): CMakeToolchain generated\" in c.out\n905: \n906: \n907: def test_keep_core_conf():\n908:     c = TestClient()\n909:     myprofile = textwrap.dedent(\"\"\"\\\n910:         [settings]\n911:         os=FreeBSD\n912:         arch=armv7\n913:         \"\"\")\n914:     conanfile = textwrap.dedent(\"\"\"\\\n915:         from conan import ConanFile\n916: \n917:         class Pkg(ConanFile):\n918:             name = \"pkga\"\n919:             version = \"0.1\"\n920:             settings = \"os\", \"arch\"\n921: \n922:             def generate(self):\n923:                 self.output.info(f\"Generating!: {self.settings.os}-{self.settings.arch}!!!!\")\n924:         \"\"\")\n925:     c.save_home({\"profiles/myprofile\": myprofile})\n926:     c.run(\"profile show \")\n927:     c.save({\"conanws.yml\": \"\",\n928:             \"pkga/conanfile.py\": conanfile})\n929:     c.run(\"workspace add pkga\")\n930:     # The injected -cc is still applied to every \"conan install\"\n931:     c.run(\"workspace install -cc core:default_profile=myprofile\")\n932:     assert \"conanfile.py (pkga/0.1): Generating!: FreeBSD-armv7!!!!\" in c.out\n933:     # also the global.conf\n934:     c.save_home({\"global.conf\": \"core:default_profile=myprofile\"})\n935:     c.run(\"workspace install\")\n936:     assert \"conanfile.py (pkga/0.1): Generating!: FreeBSD-armv7!!!!\" in c.out\n\n(End of file - total 936 lines)\n</content>","metadata":{"preview":"import json\nimport os\nimport shutil\nimport textwrap\n\nimport pytest\n\nfrom conan.api.subapi.workspace import WorkspaceAPI\nfrom conan.test.assets.genconanfile import GenConanfile\nfrom conan.test.utils.scm import create_local_git_repo\nfrom conan.test.utils.test_files import temp_folder\nfrom conan.test.utils.tools import TestClient\nfrom conan.internal.util.files import save_files\n\nWorkspaceAPI.TEST_ENABLED = \"will_break_next\"\n\n\nclass TestWorkspaceRoot:\n\n    def test_workspace_root(self):","truncated":false,"loaded":[],"display":{"type":"file","path":"/testbed/test/integration/workspace/test_workspace.py","text":"import json\nimport os\nimport shutil\nimport textwrap\n\nimport pytest\n\nfrom conan.api.subapi.workspace import WorkspaceAPI\nfrom conan.test.assets.genconanfile import GenConanfile\nfrom conan.test.utils.scm import create_local_git_repo\nfrom conan.test.utils.test_files import temp_folder\nfrom conan.test.utils.tools import TestClient\nfrom conan.internal.util.files import save_files\n\nWorkspaceAPI.TEST_ENABLED = \"will_break_next\"\n\n\nclass TestWorkspaceRoot:\n\n    def test_workspace_root(self):\n        c = TestClient(light=True)\n        # Just check the root command works\n        c.run(\"workspace root\", assert_error=True)\n        assert \"ERROR: Workspace not defined, please create\" in c.out\n\n        # error, conanws/ folder does not contain conanws.[py | yml]\n        c.save({\"conanws/test.txt\": \"\"})\n        with c.chdir(\"conanws\"):\n            c.run(\"workspace root\", assert_error=True)\n            assert \"ERROR: Workspace not defined, please create\" in c.out\n            c.save({\"conanws.yml\": \"\"})\n            c.run(\"workspace root\")\n            assert c.current_folder in c.stdout\n\n        # error, empty .py\n        c.save({\"conanws.py\": \"\"}, clean_first=True)\n        c.run(\"workspace root\", assert_error=True)\n        assert \"Error loading conanws.py\" in c.out\n        assert \"No subclass of Workspace\" in c.out\n\n        c.save({\"conanws.yml\": \"\"}, clean_first=True)\n        c.run(\"workspace root\")\n        assert c.current_folder in c.stdout\n\n\nclass TestAddRemove:\n\n    def test_add(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\",\n                \"dep1/conanfile.py\": GenConanfile(\"dep1\", \"0.1\"),\n                \"dep2/conanfile.py\": GenConanfile(\"dep2\", \"0.1\"),\n                \"dep3/conanfile.py\": GenConanfile(\"dep3\", \"0.1\")})\n        c.run(\"workspace add dep1\")\n        assert \"Reference 'dep1/0.1' added to workspace\" in c.out\n        c.run(\"workspace info\")\n        assert \"dep1/0.1\" in c.out\n        assert \"dep2\" not in c.out\n        c.run(\"editable list\")  # No editables in global\n        assert \"dep1\" not in c.out\n        assert \"dep2\" not in c.out\n        c.run(\"workspace add dep2\")\n        assert \"Reference 'dep2/0.1' added to workspace\" in c.out\n        c.run(\"workspace info\")\n        assert \"dep1/0.1\" in c.out\n        assert \"dep2/0.1\" in c.out\n\n        with c.chdir(temp_folder()):  # If we move to another folder, outside WS, no editables\n            c.run(\"editable list\")\n            assert \"dep1\" not in c.out\n            assert \"dep2\" not in c.out\n\n        c.run(\"workspace info\")\n        assert \"dep1/0.1\" in c.out\n        assert \"dep2/0.1\" in c.out\n\n        c.run(\"workspace remove dep1\")\n        c.run(\"workspace info\")\n        assert \"dep1/0.1\" not in c.out\n        assert \"dep2/0.1\" in c.out\n\n        c.run(\"workspace remove dep2\")\n        c.run(\"workspace info\")\n        assert \"dep1/0.1\" not in c.out\n        assert \"dep2/0.1\" not in c.out\n\n    def test_add_from_outside(self):\n        c = TestClient(light=True)\n        c.save({\"sub/conanws.yml\": \"\",\n                \"sub/dep1/conanfile.py\": GenConanfile(\"dep1\", \"0.1\"),\n                \"sub/dep2/conanfile.py\": GenConanfile(\"dep2\", \"0.1\")})\n        with c.chdir(\"sub\"):\n            c.run(\"workspace add dep1\")\n            assert \"Reference 'dep1/0.1' added to workspace\" in c.out\n            c.run(\"workspace add dep2\")\n            assert \"Reference 'dep2/0.1' added to workspace\" in c.out\n            c.run(\"workspace info\")\n            assert \"dep1/0.1\" in c.out\n            assert \"dep2/0.1\" in c.out\n        assert c.load_home(\"editable_packages.json\") is None\n\n        c.run(\"editable list\")\n        assert \"dep1\" not in c.out\n        assert \"dep2\" not in c.out\n        assert c.load_home(\"editable_packages.json\") is None\n        with c.chdir(\"sub\"):\n            c.run(\"editable add dep1\")\n            assert c.load_home(\"editable_packages.json\") is not None\n            c.run(\"editable list\")\n            assert \"dep1/0.1\" in c.out\n            assert \"dep2/0.1\" not in c.out\n            c.run(\"workspace info\")\n            assert \"dep1\" in c.out\n            assert \"dep2\" in c.out\n\n        c.run(\"editable list\")\n        assert \"dep1/0.1\" in c.out\n        assert \"dep2\" not in c.out\n\n    @pytest.mark.parametrize(\"api\", [False, True])\n    def test_dynamic_editables(self, api):\n        c = TestClient(light=True)\n        conanfile = textwrap.dedent(\"\"\"\n            import os\n            from conan import ConanFile\n            from conan.tools.files import load\n            class Lib(ConanFile):\n                def set_name(self):\n                    self.name = load(self, os.path.join(self.recipe_folder, \"name.txt\"))\n                def set_version(self):\n                    self.version = load(self, os.path.join(self.recipe_folder, \"version.txt\"))\n            \"\"\")\n        if not api:\n            workspace = textwrap.dedent(\"\"\"\\\n                import os\n                from conan import Workspace\n\n                class MyWorkspace(Workspace):\n                    def packages(self):\n                        result = {}\n                        for f in os.listdir(self.folder):\n                            if os.path.isdir(os.path.join(self.folder, f)):\n                                full_path = os.path.join(self.folder, f, \"name.txt\")\n                                name = open(full_path).read().strip()\n                                version = open(os.path.join(self.folder, f,\n                                                            \"version.txt\")).read().strip()\n                                result[f\"{name}/{version}\"] = {\"path\": f}\n                        return result\n                \"\"\")\n        else:\n            workspace = textwrap.dedent(\"\"\"\\\n                import os\n                from conan import Workspace\n\n                class MyWorkspace(Workspace):\n                    def packages(self):\n                        result = {}\n                        for f in os.listdir(self.folder):\n                            if os.path.isdir(os.path.join(self.folder, f)):\n                                conanfile = self.load_conanfile(f)\n                                result[f\"{conanfile.name}/{conanfile.version}\"] = {\"path\": f}\n                        return result\n               \"\"\")\n\n        c.save({\"conanws.py\": workspace,\n                \"dep1/conanfile.py\": conanfile,\n                \"dep1/name.txt\": \"pkg\",\n                \"dep1/version.txt\": \"2.1\"})\n        c.run(\"workspace info --format=json\")\n        info = json.loads(c.stdout)\n        assert info[\"packages\"] == {\"pkg/2.1\": {\"path\": \"dep1\"}}\n        c.save({\"dep1/name.txt\": \"other\",\n                \"dep1/version.txt\": \"14.5\"})\n        c.run(\"workspace info --format=json\")\n        info = json.loads(c.stdout)\n        assert info[\"packages\"] == {\"other/14.5\": {\"path\": \"dep1\"}}\n        c.run(\"install --requires=other/14.5\")\n        # Doesn't fail\n        assert \"other/14.5 - Editable\" in c.out\n        with c.chdir(\"dep1\"):\n            c.run(\"install --requires=other/14.5\")\n            # Doesn't fail\n            assert \"other/14.5 - Editable\" in c.out\n\n    def test_api_dynamic_version_run(self):\n        # https://github.com/conan-io/conan/issues/17306\n        c = TestClient(light=True)\n        conanfile = textwrap.dedent(\"\"\"\n            from io import StringIO\n            from conan import ConanFile\n            class Lib(ConanFile):\n                name= \"pkg\"\n                def set_version(self):\n                    my_buf = StringIO()\n                    self.run('echo 2.1', stdout=my_buf)\n                    self.version = my_buf.getvalue().strip()\n            \"\"\")\n\n        workspace = textwrap.dedent(\"\"\"\\\n            import os\n            from conan import Workspace\n\n            class MyWorkspace(Workspace):\n                def packages(self):\n                    conanfile = self.load_conanfile(\"dep1\")\n                    return {f\"{conanfile.name}/{conanfile.version}\": {\"path\": \"dep1\"}}\n            \"\"\")\n\n        c.save({\"conanws.py\": workspace,\n                \"dep1/conanfile.py\": conanfile})\n        c.run(\"workspace info --format=json\")\n        info = json.loads(c.stdout)\n        assert info[\"packages\"] == {\"pkg/2.1\": {\"path\": \"dep1\"}}\n        c.run(\"install --requires=pkg/2.1\")\n        # it will not fail\n\n    def test_error_uppercase(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\",\n                \"conanfile.py\": GenConanfile(\"Pkg\", \"0.1\")})\n        c.run(\"workspace add .\", assert_error=True)\n        assert \"ERROR: Conan packages names 'Pkg/0.1' must be all lowercase\" in c.out\n        c.save({\"conanfile.py\": GenConanfile()})\n        c.run(\"workspace add . --name=Pkg --version=0.1\", assert_error=True)\n        assert \"ERROR: Conan packages names 'Pkg/0.1' must be all lowercase\" in c.out\n\n    def test_add_open_error(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\",\n                \"dep/conanfile.py\": GenConanfile(\"dep\", \"0.1\")})\n        c.run(\"workspace add dep\")\n        c.run(\"workspace open dep/0.1\", assert_error=True)\n        assert \"ERROR: Can't open a dependency that is already an editable: dep/0.1\" in c.out\n\n    def test_remove_product(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\",\n                \"mydeppkg/conanfile.py\": GenConanfile(\"mydeppkg\", \"0.1\")})\n        c.run(\"workspace add mydeppkg\")\n        c.run(\"workspace remove mydeppkg\")\n        c.run(\"workspace info\")\n        assert \"mydeppkg\" not in c.out\n\n    def test_remove_removed_folder(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\",\n                \"mydeppkg/conanfile.py\": GenConanfile(\"mydeppkg\", \"0.1\")})\n        c.run(\"workspace add mydeppkg\")\n        # If we now remove the folder\n        shutil.rmtree(os.path.join(c.current_folder, \"mydeppkg\"))\n        # It can still be removed by path, even if the path doesn't exist\n        c.run(\"workspace remove mydeppkg\")\n        assert \"Removed from workspace: mydeppkg/0.1\" in c.out\n        c.run(\"workspace info\")\n        assert \"mydeppkg\" not in c.out\n\n    def test_custom_add_remove(self):\n        c = TestClient(light=True)\n\n        workspace = textwrap.dedent(\"\"\"\\\n            import os\n            from conan import Workspace\n\n            class MyWorkspace(Workspace):\n                def name(self):\n                    return \"myws\"\n\n                def add(self, ref, path, *args, **kwargs):\n                    self.output.info(f\"Adding {ref} at {path}\")\n                    super().add(ref, path, *args, **kwargs)\n\n                def remove(self, path, *args, **kwargs):\n                    self.output.info(f\"Removing {path}\")\n                    return super().remove(path, *args, **kwargs)\n            \"\"\")\n\n        c.save({\"conanws.py\": workspace,\n                \"dep/conanfile.py\": GenConanfile(\"dep\", \"0.1\")})\n        c.run(\"workspace add dep\")\n        assert \"myws: Adding dep/0.1\" in c.out\n        c.run(\"workspace info\")\n        assert \"dep/0.1\" in c.out\n        c.run(\"workspace remove dep\")\n        assert \"myws: Removing\" in c.out\n        c.run(\"workspace info\")\n        assert \"dep/0.1\" not in c.out\n\n\nclass TestOpenAdd:\n    def test_without_git(self):\n        t = TestClient(default_server_user=True, light=True)\n        t.save({\"conanfile.py\": GenConanfile(\"pkg\", \"0.1\")})\n        t.run(\"create .\")\n        t.run(\"upload * -r=default -c\")\n\n        c = TestClient(servers=t.servers, light=True)\n        c.run(f\"workspace open pkg/0.1\")\n        assert \"name = 'pkg'\" in c.load(\"pkg/conanfile.py\")\n\n        # The add should work the same\n        c2 = TestClient(servers=t.servers, light=True)\n        c2.save({\"conanws.yml\": \"\"})\n        c2.run(f\"workspace add --ref=pkg/0.1\")\n        assert \"name = 'pkg'\" in c2.load(\"pkg/conanfile.py\")\n        c2.run(\"workspace info\")\n        assert \"pkg/0.1\" in c2.out\n\n    def test_without_git_export_sources(self):\n        t = TestClient(default_server_user=True, light=True)\n        t.save({\"conanfile.py\": GenConanfile(\"pkg\", \"0.1\").with_exports_sources(\"*.txt\"),\n                \"CMakeLists.txt\": \"mycmake\"})\n        t.run(\"create .\")\n        t.run(\"upload * -r=default -c\")\n\n        c = TestClient(servers=t.servers)\n        c.run(\"workspace open pkg/0.1\")\n        assert \"name = 'pkg'\" in c.load(\"pkg/conanfile.py\")\n        assert \"mycmake\" in c.load(\"pkg/CMakeLists.txt\")\n\n    def test_workspace_git_scm(self):\n        folder = temp_folder()\n        conanfile = textwrap.dedent(\"\"\"\n            from conan import ConanFile\n            from conan.tools.scm import Git\n\n            class Pkg(ConanFile):\n                name = \"pkg\"\n                version = \"0.1\"\n                def export(self):\n                    git = Git(self)\n                    git.coordinates_to_conandata()\n            \"\"\")\n        url, commit = create_local_git_repo(files={\"conanfile.py\": conanfile}, folder=folder,\n                                            branch=\"mybranch\")\n        t1 = TestClient(default_server_user=True, light=True)\n        t1.run_command('git clone \"file://{}\" .'.format(url))\n        t1.run(\"create .\")\n        t1.run(\"upload * -r=default -c\")\n\n        c = TestClient(servers=t1.servers, light=True)\n        c.run(\"workspace open pkg/0.1\")\n        assert c.load(\"pkg/conanfile.py\") == conanfile\n\n        c2 = TestClient(servers=t1.servers, light=True)\n        c2.save({\"conanws.yml\": \"\"})\n        c2.run(f\"workspace add --ref=pkg/0.1\")\n        assert 'name = \"pkg\"' in c2.load(\"pkg/conanfile.py\")\n        c2.run(\"workspace info\")\n        assert \"pkg/0.1\" in c2.out\n\n    def test_workspace_build_editables(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\"})\n\n        c.save({\"pkga/conanfile.py\": GenConanfile(\"pkga\", \"0.1\").with_build_msg(\"BUILD PKGA!\"),\n                \"pkgb/conanfile.py\": GenConanfile(\"pkgb\", \"0.1\").with_build_msg(\"BUILD PKGB!\")\n                                                                .with_requires(\"pkga/0.1\")})\n        c.run(\"workspace add pkga\")\n        c.run(\"workspace add pkgb\")\n\n        c.run(\"install --requires=pkgb/0.1 --build=editable\")\n        c.assert_listed_binary({\"pkga/0.1\": (\"da39a3ee5e6b4b0d3255bfef95601890afd80709\",\n                                             \"EditableBuild\"),\n                                \"pkgb/0.1\": (\"47a5f20ec8fb480e1c5794462089b01a3548fdc5\",\n                                             \"EditableBuild\")})\n        assert \"pkga/0.1: WARN: BUILD PKGA!\" in c.out\n        assert \"pkgb/0.1: WARN: BUILD PKGB!\" in c.out\n\n\nclass TestWorkspaceBuild:\n\n    def test_build(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\"})\n\n        c.save({\"pkga/conanfile.py\": GenConanfile(\"pkga\", \"0.1\").with_build_msg(\"BUILD PKGA!\"),\n                \"pkgb/conanfile.py\": GenConanfile(\"pkgb\", \"0.1\").with_build_msg(\"BUILD PKGB!\")\n               .with_requires(\"pkga/0.1\")})\n        c.run(\"workspace add pkga\")\n        c.run(\"workspace add pkgb\")\n        c.run(\"workspace build\")\n        c.assert_listed_binary({\"pkga/0.1\": (\"da39a3ee5e6b4b0d3255bfef95601890afd80709\",\n                                             \"EditableBuild\")})\n        assert \"conanfile.py (pkga/0.1): WARN: BUILD PKGA!\" in c.out\n        assert \"conanfile.py (pkgb/0.1): WARN: BUILD PKGB!\" in c.out\n\n        # It is also possible to build a specific package by path\n        # equivalent to ``conan build <path> --build=editable``\n        # This can be done even if it is not a product\n        c.run(\"workspace build --pkg=pkgc/*\", assert_error=True)\n        assert \"ERROR: There are no selected packages defined in the workspace\" in c.out\n        c.run(\"workspace build --pkg=pkgb/*\")\n        c.assert_listed_binary({\"pkga/0.1\": (\"da39a3ee5e6b4b0d3255bfef95601890afd80709\",\n                                             \"EditableBuild\")})\n        assert \"conanfile.py (pkga/0.1): WARN: BUILD PKGA!\" in c.out\n        assert \"conanfile.py (pkgb/0.1): WARN: BUILD PKGB!\" in c.out\n\n        c.run(\"workspace build --pkg=pkga/*\")\n        assert \"conanfile.py (pkga/0.1): Calling build()\" in c.out\n        assert \"conanfile.py (pkga/0.1): WARN: BUILD PKGA!\" in c.out\n\n    def test_error_if_no_products(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\"})\n        c.run(\"workspace build\", assert_error=True)\n        assert \"ERROR: There are no selected packages defined in the workspace\" in c.out\n\n    def test_build_external_missing(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\"})\n\n        c.save({\"mymath/conanfile.py\": GenConanfile(\"mymath\", \"0.1\").with_build_msg(\"MyMATH!!\"),\n                \"pkga/conanfile.py\": GenConanfile(\"pkga\", \"0.1\").with_build_msg(\"BUILD PKGA!\")\n                                                                .with_requires(\"mymath/0.1\"),\n                \"pkgb/conanfile.py\": GenConanfile(\"pkgb\", \"0.1\").with_build_msg(\"BUILD PKGB!\")\n               .with_requires(\"pkga/0.1\")})\n        c.run(\"export mymath\")\n        c.run(\"workspace add pkga\")\n        c.run(\"workspace add pkgb\")\n        c.run(\"workspace build\", assert_error=True)\n        assert \"ERROR: Missing prebuilt package for 'mymath/0.1'\" in c.out\n        c.run(\"workspace build --build=missing\")\n        assert \"Workspace building external mymath/0.1\" in c.out\n\n    def test_build_dynamic_name_version(self):\n        conanfile = textwrap.dedent(\"\"\"\\\n            from conan import ConanFile\n            class MyConan(ConanFile):\n                def build(self):\n                    self.output.info(f\"Building {self.name} AND {self.version}!!!\")\n            \"\"\")\n        workspace = textwrap.dedent(\"\"\"\\\n            import os\n            from conan import Workspace\n\n            class MyWorkspace(Workspace):\n                def packages(self):\n                    result = {}\n                    for f in os.listdir(self.folder):\n                        if os.path.isdir(os.path.join(self.folder, f)):\n                            result[f\"{f}/0.1\"] = {\"path\": f}\n                    return result\n           \"\"\")\n        c = TestClient(light=True)\n        c.save({\"conanws.py\": workspace,\n                \"pkga/conanfile.py\": conanfile})\n        c.run(\"workspace info\")\n        assert \"pkga/0.1\" in c.out\n        c.run(\"workspace build\")\n        assert \"conanfile.py (pkga/0.1): Building pkga AND 0.1!!!\" in c.out\n\n\nclass TestNew:\n    def test_new(self):\n        # Very basic workspace for testing\n        c = TestClient(light=True)\n        c.run(\"new workspace\")\n        assert 'name = \"liba\"' in c.load(\"liba/conanfile.py\")\n        c.run(\"workspace info\")\n        assert \"liba/0.1\" in c.out\n        assert \"libb/0.1\" in c.out\n        assert \"app1/0.1\" in c.out\n\n    def test_new_dep(self):\n        c = TestClient(light=True)\n        c.run(\"new workspace -d requires=dep/0.1\")\n        assert 'self.requires(\"dep/0.1\")' in c.load(\"liba/conanfile.py\")\n        assert 'name = \"liba\"' in c.load(\"liba/conanfile.py\")\n        c.run(\"workspace info\")\n        assert \"liba/0.1\" in c.out\n        assert \"libb/0.1\" in c.out\n        assert \"app1/0.1\" in c.out\n\n\nclass TestMeta:\n    def test_install(self):\n        c = TestClient()\n        c.save({\"dep/conanfile.py\": GenConanfile()})\n        c.run(\"create dep --name=dep1 --version=0.1\")\n        c.run(\"create dep --name=dep2 --version=0.1\")\n        c.save({\"conanws.yml\": \"\",\n                \"liba/conanfile.py\": GenConanfile(\"liba\", \"0.1\").with_requires(\"dep1/0.1\",\n                                                                               \"dep2/0.1\"),\n                \"libb/conanfile.py\": GenConanfile(\"libb\", \"0.1\").with_requires(\"liba/0.1\",\n                                                                               \"dep1/0.1\")},\n               clean_first=True)\n        c.run(\"workspace add liba\")\n        c.run(\"workspace add libb\")\n        c.run(\"workspace super-install -g CMakeDeps -g CMakeToolchain -of=build --envs-generation=false\")\n        assert \"Workspace conanws.py not found in the workspace folder, using default\" in c.out\n        files = os.listdir(os.path.join(c.current_folder, \"build\"))\n        assert \"conan_toolchain.cmake\" in files\n        assert \"dep1-config.cmake\" in files\n        assert \"dep2-config.cmake\" in files\n        assert \"liba-config.cmake\" not in files\n        assert \"libb-config.cmake\" not in files\n        assert \"conanbuild.bat\" not in files\n        assert \"conanbuild.sh\" not in files\n\n    def test_conanfilews_custom(self):\n        c = TestClient()\n        conanfilews = textwrap.dedent(\"\"\"\n            from conan import ConanFile\n            from conan import Workspace\n\n            class MyWs(ConanFile):\n                settings = \"arch\", \"build_type\"\n                generators = \"MSBuildDeps\"\n\n            class Ws(Workspace):\n                def root_conanfile(self):\n                    return MyWs\n            \"\"\")\n\n        c.save({\"dep/conanfile.py\": GenConanfile(\"dep\", \"0.1\"),\n                \"conanws.py\": conanfilews})\n        c.run(\"workspace add dep\")\n        c.run(\"workspace super-install -of=build\")\n        files = os.listdir(os.path.join(c.current_folder, \"build\"))\n        assert \"conandeps.props\" in files\n\n    def test_conanfilews_errors(self):\n        c = TestClient()\n        conanfilews = textwrap.dedent(\"\"\"\n            from conan import ConanFile\n            from conan import Workspace\n            class MyWs(ConanFile):\n                requires = \"dep/0.1\"\n\n            class Ws(Workspace):\n                def root_conanfile(self):\n                    return MyWs\n            \"\"\")\n\n        c.save({\"conanws.yml\": \"conanfilews: myconanfilews.py\",\n                \"dep/conanfile.py\": GenConanfile(\"dep\", \"0.1\"),\n                \"conanws.py\": conanfilews})\n        c.run(\"workspace super-install\", assert_error=True)\n        assert \"ERROR: There are no selected packages defined in the workspace\" in c.out\n        c.run(\"workspace add dep\")\n        c.run(\"workspace super-install\", assert_error=True)\n        assert \"ERROR: Conanfile in conanws.py shouldn't have 'requires'\" in c.out\n\n    def test_install_partial(self):\n        # If we want to install only some part of the workspace\n        c = TestClient()\n        c.save({\"dep/conanfile.py\": GenConanfile()})\n        c.run(\"create dep --name=dep1 --version=0.1\")\n        c.run(\"create dep --name=dep2 --version=0.1\")\n        c.save({\"conanws.yml\": \"\",\n                \"liba/conanfile.py\": GenConanfile(\"liba\", \"0.1\").with_requires(\"dep1/0.1\"),\n                \"libb/conanfile.py\": GenConanfile(\"libb\", \"0.1\").with_requires(\"liba/0.1\"),\n                \"libc/conanfile.py\": GenConanfile(\"libc\", \"0.1\").with_requires(\"libb/0.1\",\n                                                                               \"dep2/0.1\")},\n               clean_first=True)\n        c.run(\"workspace add liba\")\n        c.run(\"workspace add libb\")\n        c.run(\"workspace add libc\")\n        for arg in (\"--pkg=libb/*\", \"--pkg=libb/* --pkg=liba/*\"):\n            c.run(f\"workspace super-install {arg} -g CMakeDeps -of=build\")\n            assert \"dep1/0.1\" in c.out\n            assert \"dep2/0.1\" not in c.out\n            assert \"libc/0.1\" not in c.out\n            files = os.listdir(os.path.join(c.current_folder, \"build\"))\n            assert \"dep1-config.cmake\" in files\n            assert \"dep2-config.cmake\" not in files\n\n\ndef test_workspace_with_local_recipes_index():\n    c3i_folder = temp_folder()\n    recipes_folder = os.path.join(c3i_folder, \"recipes\")\n    zlib_config = textwrap.dedent(\"\"\"\n       versions:\n         \"1.2.11\":\n           folder: all\n       \"\"\")\n    save_files(recipes_folder, {\"zlib/config.yml\": zlib_config,\n                                \"zlib/all/conanfile.py\": str(GenConanfile(\"zlib\")),\n                                \"zlib/all/conandata.yml\": \"\"})\n\n    c = TestClient(light=True)\n    c.save({\".conanrc\": 'conan_home=deps\\n'})\n    c.run(f'remote add local \"{c3i_folder}\"')\n\n    c.run(\"list zlib/1.2.11#* -r=local\")\n    assert \"zlib/1.2.11\" in c.out  # It doesn't crash\n    c.run(\"list zlib/1.2.11#*\")\n    assert \"zlib/1.2.11\" not in c.out\n\n\nclass TestClean:\n    def test_clean(self):\n        # Using cmake_layout, we can clean the build folders\n        c = TestClient()\n        c.save({\"conanws.yml\": \"name: my_workspace\"})\n        pkga = GenConanfile(\"pkga\", \"0.1\").with_settings(\"build_type\")\n        pkgb = GenConanfile(\"pkgb\", \"0.1\").with_requires(\"pkga/0.1\").with_settings(\"build_type\")\n        c.save({\"pkga/conanfile.py\": pkga ,\n                \"pkgb/conanfile.py\": pkgb,\n                \"pkgc/conanfile.py\": GenConanfile(\"pkgc\", \"0.1\").with_requires(\"pkgb/0.1\")})\n        c.run(\"workspace add pkga -of=build/pkga\")\n        c.run(\"workspace add pkgb -of=build/pkgb\")\n        c.run(\"workspace add pkgc\")\n        c.run(\"workspace build\")\n        assert os.path.exists(os.path.join(c.current_folder, \"build\", \"pkga\"))\n        assert os.path.exists(os.path.join(c.current_folder, \"build\", \"pkgb\"))\n        c.run(\"workspace clean\")\n        assert \"my_workspace: Removing pkga/0.1 output folder\" in c.out\n        assert \"my_workspace: Removing pkgb/0.1 output folder\" in c.out\n        assert \"Editable pkgc/0.1 doesn't have an output_folder defined\" in c.out\n        assert not os.path.exists(os.path.join(c.current_folder, \"build\", \"pkga\"))\n        assert not os.path.exists(os.path.join(c.current_folder, \"build\", \"pkgb\"))\n\n    def test_custom_clean(self):\n        conanfilews = textwrap.dedent(\"\"\"\n            from conan import Workspace\n\n            class Ws(Workspace):\n                def name(self):\n                    return \"my_workspace\"\n                def clean(self):\n                    self.output.info(\"MY CLEAN!!!!\")\n            \"\"\")\n        c = TestClient()\n        c.save({\"conanws.py\": conanfilews})\n        c.run(\"workspace clean\")\n        assert \"my_workspace: MY CLEAN!!!\" in c.out\n\n\ndef test_relative_paths():\n    # This is using the meta-project\n    c = TestClient()\n    c.run(\"new cmake_lib -d name=liba --output=liba\")\n    c.run(\"new cmake_exe -d name=app1 -d requires=liba/0.1 --output=app1\")\n    c.run(\"new cmake_lib -d name=libb --output=other/libb\")\n    c.run(\"new cmake_exe -d name=app2 -d requires=libb/0.1 --output=other/app2\")\n    c.run(\"workspace init mywks\")\n    c.run(\"workspace init otherwks\")\n    # cd mywks\n    with c.chdir(\"mywks\"):\n        c.run(\"workspace add ../liba\")\n        c.run(\"workspace add ../app1\")\n        c.run(\"workspace info\")\n        expected = textwrap.dedent(\"\"\"\\\n            packages\n              app1/0.1\n                path: ../app1\n              liba/0.1\n                path: ../liba\n            \"\"\")\n        assert expected in c.out\n        c.run(\"graph info --requires=app1/0.1\")\n        c.assert_listed_require({\"app1/0.1\": \"Editable\", \"liba/0.1\": \"Editable\"})\n    # cd otherwks\n    with c.chdir(\"otherwks\"):\n        c.run(\"workspace add ../other/libb\")\n        c.run(\"workspace add ../other/app2\")\n        c.run(\"workspace info\")\n        expected = textwrap.dedent(\"\"\"\\\n            packages\n              app2/0.1\n                path: ../other/app2\n              libb/0.1\n                path: ../other/libb\n            \"\"\")\n        assert expected in c.out\n        c.run(\"graph info --requires=app2/0.1\")\n        c.assert_listed_require({\"app2/0.1\": \"Editable\", \"libb/0.1\": \"Editable\"})\n\n\ndef test_host_build_require():\n    c = TestClient()\n    protobuf = textwrap.dedent(\"\"\"\\\n        from conan import ConanFile\n        from conan.tools.files import save, copy\n        class Protobuf(ConanFile):\n            name = \"protobuf\"\n            version = \"0.1\"\n            settings = \"os\"\n\n            def layout(self):\n                self.folders.build = f\"mybuild/folder_{self.settings.os}\"\n                self.cpp.build.bindirs = [\".\"]\n\n            def build(self):\n                save(self, \"myprotobuf.txt\", f\"MYOS={self.settings.os}!!!\")\n\n            def package(self):\n                copy(self, \"myprotobuf.txt\", src=self.build_folder, dst=self.package_folder)\n\n            def package_info(self):\n                self.cpp_info.bindirs = [\".\"]\n        \"\"\")\n    app = textwrap.dedent(\"\"\"\\\n        import os\n        from conan import ConanFile\n        from conan.tools.files import load\n        class Protobuf(ConanFile):\n            name = \"app\"\n            version = \"0.1\"\n            requires = \"protobuf/0.1\"\n            tool_requires = \"protobuf/0.1\"\n\n            def build(self):\n                binhost = self.dependencies.host[\"protobuf\"].cpp_info.bindir\n                binbuild = self.dependencies.build[\"protobuf\"].cpp_info.bindir\n                host = load(self, os.path.join(binhost, \"myprotobuf.txt\"))\n                build = load(self, os.path.join(binbuild, \"myprotobuf.txt\"))\n                self.output.info(f\"BUILDING WITH BINHOST: {host}\")\n                self.output.info(f\"BUILDING WITH BINBUILD: {build}\")\n        \"\"\")\n    c.save({\"protobuf/conanfile.py\": protobuf,\n            \"app/conanfile.py\": app})\n    c.run(\"workspace init .\")\n    c.run(\"workspace add protobuf\")\n    c.run(\"workspace add app\")\n    c.run(\"install app --build=editable -s:b os=Linux -s:h os=Windows\")\n\n    assert c.load(\"protobuf/mybuild/folder_Linux/myprotobuf.txt\") == \"MYOS=Linux!!!\"\n    assert c.load(\"protobuf/mybuild/folder_Windows/myprotobuf.txt\") == \"MYOS=Windows!!!\"\n\n    shutil.rmtree(os.path.join(c.current_folder, \"protobuf\", \"mybuild\"))\n    assert not os.path.exists(os.path.join(c.current_folder, \"protobuf\", \"mybuild\"))\n    c.run(\"workspace build -s:b os=Linux -s:h os=Windows\")\n    assert \"conanfile.py (app/0.1): BUILDING WITH BINHOST: MYOS=Windows!!!\" in c.out\n    assert \"conanfile.py (app/0.1): BUILDING WITH BINBUILD: MYOS=Linux!!!\" in c.out\n    assert c.load(\"protobuf/mybuild/folder_Linux/myprotobuf.txt\") == \"MYOS=Linux!!!\"\n    assert c.load(\"protobuf/mybuild/folder_Windows/myprotobuf.txt\") == \"MYOS=Windows!!!\"\n\n    shutil.rmtree(os.path.join(c.current_folder, \"protobuf\", \"mybuild\"))\n    assert not os.path.exists(os.path.join(c.current_folder, \"protobuf\", \"mybuild\"))\n    c.run(\"workspace create -s:b os=Linux -s:h os=Windows\")\n    assert \"app/0.1: BUILDING WITH BINHOST: MYOS=Windows!!!\" in c.out\n    assert \"app/0.1: BUILDING WITH BINBUILD: MYOS=Linux!!!\" in c.out\n\n\nclass TestCreate:\n    def test_create(self):\n        c = TestClient(light=True, default_server_user=True)\n        c.save({\"conanfile.py\": GenConanfile(\"zlib\", \"0.1\").with_build_msg(\"BUILD ZLIB!\")})\n        c.run(\"export .\")\n        c.save({\"conanws.yml\": \"\"}, clean_first=True)\n        c.save({\"pkga/conanfile.py\": GenConanfile(\"pkga\", \"0.1\").with_requires(\"zlib/0.1\")\n                                                                .with_build_msg(\"BUILD PKGA!\"),\n                \"pkga/test_package/conanfile.py\": GenConanfile().with_test(\"pass\"),\n                \"pkgb/conanfile.py\": GenConanfile(\"pkgb\", \"0.1\").with_build_msg(\"BUILD PKGB!\")\n               .with_requires(\"pkga/0.1\"),\n                \"pkgb/test_package/conanfile.py\": GenConanfile().with_test(\"pass\"),\n                \"pkgc/conanfile.py\": GenConanfile(\"pkgc\", \"0.1\").with_build_msg(\"BUILD PKGC!\")\n               .with_requires(\"pkgb/0.1\"),\n                \"pkgc/test_package/conanfile.py\": GenConanfile().with_test(\"pass\"),\n                })\n        c.run(\"workspace add pkga\")\n        c.run(\"workspace add pkgb\")\n        c.run(\"workspace add pkgc\")\n        c.run(\"workspace create --build=zlib/*\")\n        assert str(c.out).count(\"zlib/0.1: WARN: BUILD ZLIB!\") == 1\n        assert str(c.out).count(\"pkga/0.1: WARN: BUILD PKGA!\") == 1\n        assert str(c.out).count(\"pkgb/0.1: WARN: BUILD PKGB!\") == 1\n        assert str(c.out).count(\"pkgc/0.1: WARN: BUILD PKGC!\") == 1\n        assert \"pkga/0.1 (test package): Running test()\" in c.out\n        assert \"pkgb/0.1 (test package): Running test()\" in c.out\n        assert \"pkgc/0.1 (test package): Running test()\" in c.out\n\n        # A second conan workspace create will not re-build\n        c.run(\"workspace create\")\n        assert \"WARN: BUILD ZLIB!\" not in c.out\n        assert \"WARN: BUILD PKGA!\" not in c.out\n        assert \"WARN: BUILD PKGB!\" not in c.out\n        assert \"WARN: BUILD PKBC!\" not in c.out\n        assert \"pkga/0.1 (test package): Running test()\" not in c.out\n        assert \"pkgb/0.1 (test package): Running test()\" not in c.out\n        assert \"pkgc/0.1 (test package): Running test()\" not in c.out\n\n        c.run(\"upload zlib/* -r=default -c\")\n        c.run(\"remove zlib/* -c\")\n        c.run(\"remove pkgc/* -c\")\n        c.run(\"workspace create\")\n        assert \"WARN: BUILD ZLIB!\" not in c.out\n        assert \"pkgc/0.1: WARN: BUILD PKGC!\" in c.out\n\n\n    def test_create_dynamic_name(self):\n        workspace = textwrap.dedent(\"\"\"\\\n            import os\n            from conan import Workspace\n\n            class MyWorkspace(Workspace):\n                def packages(self):\n                    result = {}\n                    for f in os.listdir(self.folder):\n                        if os.path.isdir(os.path.join(self.folder, f)):\n                            result[f\"{f}/0.1\"] = {\"path\": f}\n                    return result\n           \"\"\")\n        c = TestClient(light=True)\n        c.save({\"conanws.py\": workspace,\n                \"pkga/conanfile.py\": GenConanfile()})\n        c.run(\"workspace info\")\n        assert \"pkga/0.1\" in c.out\n        c.run(\"workspace create\")\n        assert \"Workspace create pkga/0.1\" in c.out\n\n\n    def test_host_build_require(self):\n        c = TestClient()\n        protobuf = textwrap.dedent(\"\"\"\\\n            from conan import ConanFile\n            class Protobuf(ConanFile):\n                name = \"protobuf\"\n                version = \"0.1\"\n                settings = \"os\"\n\n                def build(self):\n                    self.output.info(f\"Building for: {self.settings.os}!!!\")\n            \"\"\")\n        app = textwrap.dedent(\"\"\"\\\n            from conan import ConanFile\n            class Protobuf(ConanFile):\n                name = \"app\"\n                version = \"0.1\"\n                requires = \"protobuf/0.1\"\n                tool_requires = \"protobuf/0.1\"\n            \"\"\")\n        c.save({\"protobuf/conanfile.py\": protobuf,\n                \"app/conanfile.py\": app})\n        c.run(\"workspace init .\")\n        c.run(\"workspace add protobuf\")\n        c.run(\"workspace add app\")\n\n        c.run(\"workspace create -s:b os=Linux -s:h os=Windows\")\n\n        assert \"protobuf/0.1: Building for: Windows!!!\" in c.out\n        assert \"protobuf/0.1: Building for: Linux!!!\" in c.out\n\n\nclass TestSource:\n    def test_source(self):\n        c = TestClient(light=True)\n        c.save({\"conanws.yml\": \"\"})\n\n        pkga = textwrap.dedent(\"\"\"\\\n            from conan import ConanFile\n            class TestPackage(ConanFile):\n                name = \"pkga\"\n                version = \"0.1\"\n                def source(self):\n                    self.output.info(\"Executing SOURCE!!!\")\n            \"\"\")\n        pkgb = textwrap.dedent(\"\"\"\\\n            from conan import ConanFile\n            class TestPackage(ConanFile):\n                name = \"pkgb\"\n                version = \"0.1\"\n                requires = \"pkga/0.1\"\n                def source(self):\n                    self.output.info(\"Executing SOURCE!!!\")\n            \"\"\")\n        pkgc = textwrap.dedent(\"\"\"\\\n            from conan import ConanFile\n            class TestPackage(ConanFile):\n                name = \"pkgc\"\n                version = \"0.1\"\n                requires = \"pkgb/0.1\"\n                def source(self):\n                    self.output.info(\"Executing SOURCE!!!\")\n            \"\"\")\n        c.save({\"pkga/conanfile.py\": pkga,\n                \"pkgb/conanfile.py\": pkgb,\n                \"pkgc/conanfile.py\": pkgc})\n        c.run(\"workspace add pkga\")\n        c.run(\"workspace add pkgb\")\n        c.run(\"workspace add pkgc\")\n        c.run(\"workspace source\")\n        assert \"conanfile.py (pkga/0.1): Executing SOURCE!!!\" in c.out\n        assert \"conanfile.py (pkgb/0.1): Executing SOURCE!!!\" in c.out\n        assert \"conanfile.py (pkgc/0.1): Executing SOURCE!!!\" in c.out\n\n\nclass TestInstall:\n    def test_install(self):\n        c = TestClient()\n        c.save({\"conanws.yml\": \"\"})\n\n        pkg = textwrap.dedent(\"\"\"\\\n            from conan import ConanFile\n            class Package(ConanFile):\n                name = \"{}\"\n                version = \"0.1\"\n                settings = \"os\", \"build_type\"\n                {}\n                generators = \"CMakeToolchain\"\n            \"\"\")\n\n        c.save({\"pkga/conanfile.py\": pkg.format(\"pkga\", ''),\n                \"pkgb/conanfile.py\": pkg.format(\"pkgb\", 'requires=\"pkga/0.1\"'),\n                \"pkgc/conanfile.py\": pkg.format(\"pkgc\", 'requires=\"pkgb/0.1\"')})\n        c.run(\"workspace add pkga\")\n        c.run(\"workspace add pkgb\")\n        c.run(\"workspace add pkgc\")\n        c.run(\"workspace install\")\n        assert \"conanfile.py (pkga/0.1): CMakeToolchain generated\" in c.out\n        assert \"conanfile.py (pkgb/0.1): CMakeToolchain generated\" in c.out\n        assert \"conanfile.py (pkgc/0.1): CMakeToolchain generated\" in c.out\n\n\ndef test_keep_core_conf():\n    c = TestClient()\n    myprofile = textwrap.dedent(\"\"\"\\\n        [settings]\n        os=FreeBSD\n        arch=armv7\n        \"\"\")\n    conanfile = textwrap.dedent(\"\"\"\\\n        from conan import ConanFile\n\n        class Pkg(ConanFile):\n            name = \"pkga\"\n            version = \"0.1\"\n            settings = \"os\", \"arch\"\n\n            def generate(self):\n                self.output.info(f\"Generating!: {self.settings.os}-{self.settings.arch}!!!!\")\n        \"\"\")\n    c.save_home({\"profiles/myprofile\": myprofile})\n    c.run(\"profile show \")\n    c.save({\"conanws.yml\": \"\",\n            \"pkga/conanfile.py\": conanfile})\n    c.run(\"workspace add pkga\")\n    # The injected -cc is still applied to every \"conan install\"\n    c.run(\"workspace install -cc core:default_profile=myprofile\")\n    assert \"conanfile.py (pkga/0.1): Generating!: FreeBSD-armv7!!!!\" in c.out\n    # also the global.conf\n    c.save_home({\"global.conf\": \"core:default_profile=myprofile\"})\n    c.run(\"workspace install\")\n    assert \"conanfile.py (pkga/0.1): Generating!: FreeBSD-armv7!!!!\" in c.out","lineStart":1,"lineEnd":936,"totalLines":936,"truncated":false}},"title":"test/integration/workspace/test_workspace.py","time":{"start":1788511596340,"end":1788511596358}},"metadata":{"openrouter":{"reasoning_details":[{"type":"reasoning.text","text":"Now let me look at the tests to understand the expected behavior:\n\n1. `test/functional/workspace/test_workspace.py`\n2. `test/integration/workspace/test_workspace.py`\n\nLet me also check the `print_serial` function used in workspace info.","format":"unknown","index":0}]}},"id":"prt_06b992f04001anQCVJbVk6311V","sessionID":"ses_f94670cb8ffeWdbpzRFsoZCXEH","messageID":"msg_06b992743001ROM5i8MLpbNEod"}}
