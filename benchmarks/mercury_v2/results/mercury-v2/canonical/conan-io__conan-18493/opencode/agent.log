{"type":"tool_use","timestamp":1788511593670,"sessionID":"ses_f94670cb8ffeWdbpzRFsoZCXEH","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-81bb250055366b99","state":{"status":"completed","input":{"filePath":"/testbed/conan/internal/model/workspace.py"},"output":"<path>/testbed/conan/internal/model/workspace.py</path>\n<type>file</type>\n<content>\n1: import os\n2: import shutil\n3: \n4: import yaml\n5: \n6: from conan.api.output import ConanOutput\n7: from conan.errors import ConanException\n8: from conan.internal.util.files import load, save\n9: \n10: # Related folder\n11: WORKSPACE_FOLDER = \"conanws\"\n12: # Related files\n13: WORKSPACE_YML = \"conanws.yml\"\n14: WORKSPACE_PY = \"conanws.py\"\n15: \n16: \n17: class Workspace:\n18:     \"\"\"\n19:     The base class for all workspaces\n20:     \"\"\"\n21: \n22:     def __init__(self, folder, conan_api):\n23:         self.folder = folder\n24:         self.conan_data = self._conan_load_data()\n25:         self._conan_api = conan_api\n26:         self.output = ConanOutput(scope=self.name())\n27: \n28:     def name(self):\n29:         return self.conan_data.get(\"name\") or os.path.basename(self.folder)\n30: \n31:     def _conan_load_data(self):\n32:         data_path = os.path.join(self.folder, WORKSPACE_YML)\n33:         if not os.path.exists(data_path):\n34:             return {}\n35:         try:\n36:             data = yaml.safe_load(load(data_path))\n37:         except Exception as e:\n38:             raise ConanException(\"Invalid yml format at {}: {}\".format(WORKSPACE_YML, e))\n39:         return data or {}\n40: \n41:     def add(self, ref, path, output_folder):\n42:         assert os.path.isfile(path)\n43:         path = self._conan_rel_path(os.path.dirname(path))\n44:         editable = {\"path\": path}\n45:         if output_folder:\n46:             editable[\"output_folder\"] = self._conan_rel_path(output_folder)\n47:         self.conan_data.setdefault(\"packages\", {})[str(ref)] = editable\n48:         save(os.path.join(self.folder, WORKSPACE_YML), yaml.dump(self.conan_data))\n49: \n50:     def remove(self, path):\n51:         found_ref = None\n52:         path = self._conan_rel_path(path)\n53:         for ref, info in self.conan_data.get(\"packages\", {}).items():\n54:             if info[\"path\"].replace(\"\\\\\", \"/\") == path:\n55:                 found_ref = ref\n56:                 break\n57:         if not found_ref:\n58:             raise ConanException(f\"No editable package to remove from this path: {path}\")\n59:         self.conan_data[\"packages\"].pop(found_ref)\n60:         save(os.path.join(self.folder, WORKSPACE_YML), yaml.dump(self.conan_data))\n61:         return found_ref\n62: \n63:     def clean(self):\n64:         self.output.info(\"Default workspace clean: Removing the output-folder of each editable\")\n65:         for ref, info in self.conan_data.get(\"packages\", {}).items():\n66:             if not info.get(\"output_folder\"):\n67:                 self.output.info(f\"Editable {ref} doesn't have an output_folder defined\")\n68:                 continue\n69:             of = os.path.join(self.folder, info[\"output_folder\"])\n70:             try:\n71:                 self.output.info(f\"Removing {ref} output folder: {of}\")\n72:                 shutil.rmtree(of)\n73:             except OSError as e:\n74:                 self.output.warning(f\"Error removing {ref} output folder: {str(e)}\")\n75: \n76:     def _conan_rel_path(self, path):\n77:         if path is None:\n78:             return None\n79:         if not os.path.isabs(path):\n80:             raise ConanException(f\"Editable path must be absolute: {path}\")\n81:         path = os.path.relpath(path, self.folder)\n82:         return path.replace(\"\\\\\", \"/\")  # Normalize to unix path\n83: \n84:     def packages(self):\n85:         return self.conan_data.get(\"packages\", {})\n86: \n87:     def load_conanfile(self, conanfile_path):\n88:         conanfile_path = os.path.join(self.folder, conanfile_path, \"conanfile.py\")\n89:         from conan.internal.loader import ConanFileLoader\n90:         from conan.internal.cache.home_paths import HomePaths\n91:         from conan.internal.conan_app import ConanFileHelpers, CmdWrapper\n92:         cmd_wrap = CmdWrapper(HomePaths(self._conan_api.home_folder).wrapper_path)\n93:         helpers = ConanFileHelpers(None, cmd_wrap, self._conan_api.config.global_conf,\n94:                                    cache=None, home_folder=self._conan_api.home_folder)\n95:         loader = ConanFileLoader(pyreq_loader=None, conanfile_helpers=helpers)\n96:         conanfile = loader.load_named(conanfile_path, name=None, version=None, user=None,\n97:                                       channel=None, remotes=None, graph_lock=None)\n98:         return conanfile\n99: \n100:     def root_conanfile(self):  # noqa\n101:         return None\n\n(End of file - total 101 lines)\n</content>","metadata":{"preview":"import os\nimport shutil\n\nimport yaml\n\nfrom conan.api.output import ConanOutput\nfrom conan.errors import ConanException\nfrom conan.internal.util.files import load, save\n\n# Related folder\nWORKSPACE_FOLDER = \"conanws\"\n# Related files\nWORKSPACE_YML = \"conanws.yml\"\nWORKSPACE_PY = \"conanws.py\"\n\n\nclass Workspace:\n    \"\"\"\n    The base class for all workspaces\n    \"\"\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/testbed/conan/internal/model/workspace.py","text":"import os\nimport shutil\n\nimport yaml\n\nfrom conan.api.output import ConanOutput\nfrom conan.errors import ConanException\nfrom conan.internal.util.files import load, save\n\n# Related folder\nWORKSPACE_FOLDER = \"conanws\"\n# Related files\nWORKSPACE_YML = \"conanws.yml\"\nWORKSPACE_PY = \"conanws.py\"\n\n\nclass Workspace:\n    \"\"\"\n    The base class for all workspaces\n    \"\"\"\n\n    def __init__(self, folder, conan_api):\n        self.folder = folder\n        self.conan_data = self._conan_load_data()\n        self._conan_api = conan_api\n        self.output = ConanOutput(scope=self.name())\n\n    def name(self):\n        return self.conan_data.get(\"name\") or os.path.basename(self.folder)\n\n    def _conan_load_data(self):\n        data_path = os.path.join(self.folder, WORKSPACE_YML)\n        if not os.path.exists(data_path):\n            return {}\n        try:\n            data = yaml.safe_load(load(data_path))\n        except Exception as e:\n            raise ConanException(\"Invalid yml format at {}: {}\".format(WORKSPACE_YML, e))\n        return data or {}\n\n    def add(self, ref, path, output_folder):\n        assert os.path.isfile(path)\n        path = self._conan_rel_path(os.path.dirname(path))\n        editable = {\"path\": path}\n        if output_folder:\n            editable[\"output_folder\"] = self._conan_rel_path(output_folder)\n        self.conan_data.setdefault(\"packages\", {})[str(ref)] = editable\n        save(os.path.join(self.folder, WORKSPACE_YML), yaml.dump(self.conan_data))\n\n    def remove(self, path):\n        found_ref = None\n        path = self._conan_rel_path(path)\n        for ref, info in self.conan_data.get(\"packages\", {}).items():\n            if info[\"path\"].replace(\"\\\\\", \"/\") == path:\n                found_ref = ref\n                break\n        if not found_ref:\n            raise ConanException(f\"No editable package to remove from this path: {path}\")\n        self.conan_data[\"packages\"].pop(found_ref)\n        save(os.path.join(self.folder, WORKSPACE_YML), yaml.dump(self.conan_data))\n        return found_ref\n\n    def clean(self):\n        self.output.info(\"Default workspace clean: Removing the output-folder of each editable\")\n        for ref, info in self.conan_data.get(\"packages\", {}).items():\n            if not info.get(\"output_folder\"):\n                self.output.info(f\"Editable {ref} doesn't have an output_folder defined\")\n                continue\n            of = os.path.join(self.folder, info[\"output_folder\"])\n            try:\n                self.output.info(f\"Removing {ref} output folder: {of}\")\n                shutil.rmtree(of)\n            except OSError as e:\n                self.output.warning(f\"Error removing {ref} output folder: {str(e)}\")\n\n    def _conan_rel_path(self, path):\n        if path is None:\n            return None\n        if not os.path.isabs(path):\n            raise ConanException(f\"Editable path must be absolute: {path}\")\n        path = os.path.relpath(path, self.folder)\n        return path.replace(\"\\\\\", \"/\")  # Normalize to unix path\n\n    def packages(self):\n        return self.conan_data.get(\"packages\", {})\n\n    def load_conanfile(self, conanfile_path):\n        conanfile_path = os.path.join(self.folder, conanfile_path, \"conanfile.py\")\n        from conan.internal.loader import ConanFileLoader\n        from conan.internal.cache.home_paths import HomePaths\n        from conan.internal.conan_app import ConanFileHelpers, CmdWrapper\n        cmd_wrap = CmdWrapper(HomePaths(self._conan_api.home_folder).wrapper_path)\n        helpers = ConanFileHelpers(None, cmd_wrap, self._conan_api.config.global_conf,\n                                   cache=None, home_folder=self._conan_api.home_folder)\n        loader = ConanFileLoader(pyreq_loader=None, conanfile_helpers=helpers)\n        conanfile = loader.load_named(conanfile_path, name=None, version=None, user=None,\n                                      channel=None, remotes=None, graph_lock=None)\n        return conanfile\n\n    def root_conanfile(self):  # noqa\n        return None","lineStart":1,"lineEnd":101,"totalLines":101,"truncated":false}},"title":"conan/internal/model/workspace.py","time":{"start":1788511593644,"end":1788511593666}},"metadata":{"openrouter":{"reasoning_details":[]}},"id":"prt_06b99247a0015D3tMUJ5BEBHtB","sessionID":"ses_f94670cb8ffeWdbpzRFsoZCXEH","messageID":"msg_06b99158a001ReWQgEt55c396q"}}
{"type":"tool_use","timestamp":1788511593780,"sessionID":"ses_f94670cb8ffeWdbpzRFsoZCXEH","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-a5a83ce680ac26f9","state":{"status":"completed","input":{"filePath":"/testbed/conan/cli/commands/workspace.py"},"output":"<path>/testbed/conan/cli/commands/workspace.py</path>\n<type>file</type>\n<content>\n1: import json\n2: import os\n3: \n4: from conan.api.conan_api import ConanAPI\n5: from conan.api.model import RecipeReference\n6: from conan.api.output import ConanOutput, cli_out_write\n7: from conan.api.subapi.workspace import WorkspaceAPI\n8: from conan.cli import make_abs_path\n9: from conan.cli.args import add_reference_args, add_common_install_arguments, add_lockfile_args\n10: from conan.cli.command import conan_command, conan_subcommand\n11: from conan.cli.commands.list import print_serial\n12: from conan.cli.printers import print_profiles\n13: from conan.cli.printers.graph import print_graph_packages, print_graph_basic\n14: from conan.errors import ConanException\n15: from conan.internal.graph.install_graph import ProfileArgs\n16: \n17: \n18: @conan_subcommand(formatters={\"text\": cli_out_write})\n19: def workspace_root(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n20:     \"\"\"\n21:     Return the folder containing the conanws.py/conanws.yml workspace file\n22:     \"\"\"\n23:     parser.parse_args(*args)\n24:     ws = conan_api.workspace\n25:     return ws.folder()\n26: \n27: \n28: @conan_subcommand()\n29: def workspace_open(conan_api: ConanAPI, parser, subparser, *args):\n30:     \"\"\"\n31:     Open specific references\n32:     \"\"\"\n33:     subparser.add_argument(\"reference\",\n34:                            help=\"Open this package source repository\")\n35:     group = subparser.add_mutually_exclusive_group()\n36:     group.add_argument(\"-r\", \"--remote\", action=\"append\", default=None,\n37:                        help='Look in the specified remote or remotes server')\n38:     group.add_argument(\"-nr\", \"--no-remote\", action=\"store_true\",\n39:                        help='Do not use remote, resolve exclusively in the cache')\n40:     args = parser.parse_args(*args)\n41:     remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n42:     cwd = os.getcwd()\n43:     conan_api.workspace.open(args.reference, remotes=remotes, cwd=cwd)\n44: \n45: \n46: @conan_subcommand()\n47: def workspace_add(conan_api: ConanAPI, parser, subparser, *args):\n48:     \"\"\"\n49:     Add packages to current workspace\n50:     \"\"\"\n51:     subparser.add_argument('path',  nargs=\"?\",\n52:                            help='Path to the package folder in the user workspace')\n53:     add_reference_args(subparser)\n54:     subparser.add_argument(\"--ref\", help=\"Open and add this reference\")\n55:     subparser.add_argument(\"-of\", \"--output-folder\",\n56:                            help='The root output folder for generated and build files')\n57:     group = subparser.add_mutually_exclusive_group()\n58:     group.add_argument(\"-r\", \"--remote\", action=\"append\", default=None,\n59:                        help='Look in the specified remote or remotes server')\n60:     group.add_argument(\"-nr\", \"--no-remote\", action=\"store_true\",\n61:                        help='Do not use remote, resolve exclusively in the cache')\n62:     args = parser.parse_args(*args)\n63:     if args.path and args.ref:\n64:         raise ConanException(\"Do not use both 'path' and '--ref' argument\")\n65:     remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n66:     cwd = os.getcwd()\n67:     path = args.path\n68:     if args.ref:\n69:         # TODO: Use path here to open in this path\n70:         path = conan_api.workspace.open(args.ref, remotes, cwd=cwd)\n71:     ref = conan_api.workspace.add(path,\n72:                                   args.name, args.version, args.user, args.channel,\n73:                                   cwd, args.output_folder, remotes=remotes)\n74:     ConanOutput().success(\"Reference '{}' added to workspace\".format(ref))\n75: \n76: \n77: @conan_subcommand()\n78: def workspace_remove(conan_api: ConanAPI, parser, subparser, *args):\n79:     \"\"\"\n80:     Remove packages from the current workspace\n81:     \"\"\"\n82:     subparser.add_argument('path',\n83:                            help='Path to the package folder in the user workspace')\n84:     args = parser.parse_args(*args)\n85:     removed = conan_api.workspace.remove(make_abs_path(args.path))\n86:     ConanOutput().info(f\"Removed from workspace: {removed}\")\n87: \n88: \n89: def print_json(data):\n90:     results = data[\"info\"]\n91:     myjson = json.dumps(results, indent=4)\n92:     cli_out_write(myjson)\n93: \n94: \n95: def _print_workspace_info(data):\n96:     print_serial(data[\"info\"])\n97: \n98: \n99: @conan_subcommand(formatters={\"text\": _print_workspace_info, \"json\": print_json})\n100: def workspace_info(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n101:     \"\"\"\n102:     Display info for current workspace\n103:     \"\"\"\n104:     parser.parse_args(*args)\n105:     return {\"info\": conan_api.workspace.info()}\n106: \n107: \n108: @conan_subcommand()\n109: def workspace_build(conan_api: ConanAPI, parser, subparser, *args):\n110:     \"\"\"\n111:     Call \"conan build\" for packages in the workspace, in the right order\n112:     \"\"\"\n113:     _install_build(conan_api, parser, subparser, True, *args)\n114: \n115: \n116: @conan_subcommand()\n117: def workspace_install(conan_api: ConanAPI, parser, subparser, *args):\n118:     \"\"\"\n119:     Call \"conan install\" for packages in the workspace, in the right order\n120:     \"\"\"\n121:     _install_build(conan_api, parser, subparser, False, *args)\n122: \n123: \n124: def _install_build(conan_api: ConanAPI, parser, subparser, build, *args):\n125:     subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n126:     add_common_install_arguments(subparser)\n127:     add_lockfile_args(subparser)\n128:     args = parser.parse_args(*args)\n129:     # Basic collaborators: remotes, lockfile, profiles\n130:     remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n131:     overrides = eval(args.lockfile_overrides) if args.lockfile_overrides else None\n132:     # The lockfile by default if not defined will be read from the root workspace folder\n133:     ws_folder = conan_api.workspace.folder()\n134:     lockfile = conan_api.lockfile.get_lockfile(lockfile=args.lockfile, conanfile_path=ws_folder,\n135:                                                cwd=None, partial=args.lockfile_partial,\n136:                                                overrides=overrides)\n137:     profile_host, profile_build = conan_api.profiles.get_profiles_from_args(args)\n138:     print_profiles(profile_host, profile_build)\n139: \n140:     buildmode = args.build\n141:     if build and (not buildmode or \"editable\" not in buildmode):\n142:         ConanOutput().info(\"Adding '--build=editable' as build mode\")\n143:         buildmode = buildmode or []\n144:         buildmode.append(\"editable\")\n145: \n146:     all_editables = conan_api.workspace.packages()\n147:     packages = conan_api.workspace.select_packages(args.pkg)\n148:     ConanOutput().box(\"Workspace computing the build order\")\n149:     install_order = conan_api.workspace.build_order(packages, profile_host, profile_build, buildmode,\n150:                                                     lockfile, remotes, args, update=args.update)\n151: \n152:     msg = \"build\" if build else \"install\"\n153:     ConanOutput().box(f\"Workspace {msg}ing each package\")\n154:     order = install_order.install_build_order()\n155: \n156:     profile_args = ProfileArgs.from_args(args)\n157:     for level in order[\"order\"]:\n158:         for elem in level:\n159:             ref = RecipeReference.loads(elem[\"ref\"])\n160:             for package_level in elem[\"packages\"]:\n161:                 for package in package_level:\n162:                     if package[\"binary\"] == \"Build\":  # Build external to Workspace\n163:                         cmd = f'install {package[\"build_args\"]} {profile_args}'\n164:                         ConanOutput().box(f\"Workspace building external {ref}\")\n165:                         ConanOutput().info(f\"Command: {cmd}\\n\")\n166:                         conan_api.command.run(cmd)\n167:                     elif package[\"binary\"] in (\"Editable\", \"EditableBuild\"):\n168:                         path = all_editables[ref][\"path\"]\n169:                         output_folder = all_editables[ref].get(\"output_folder\")\n170:                         build_arg = \"--build-require\" if package[\"context\"] == \"build\" else \"\"\n171:                         ref_args = \" \".join(f\"--{k}={getattr(ref, k)}\"\n172:                                             for k in (\"name\", \"version\", \"user\", \"channel\")\n173:                                             if getattr(ref, k, None))\n174:                         of_arg = f'-of=\"{output_folder}\"' if output_folder else \"\"\n175:                         # TODO: Missing --lockfile-overrides arg here\n176:                         command = \"build\" if build else \"install\"\n177:                         cmd = f'{command} \"{path}\" {profile_args} {build_arg} {ref_args} {of_arg}'\n178:                         ConanOutput().box(f\"Workspace {command}: {ref}\")\n179:                         ConanOutput().info(f\"Command: {cmd}\\n\")\n180:                         conan_api.command.run(cmd)\n181: \n182: \n183: @conan_subcommand()\n184: def workspace_super_install(conan_api: ConanAPI, parser, subparser, *args):\n185:     \"\"\"\n186:     Install the workspace as a monolith, installing only external dependencies to the workspace,\n187:     generating a single result (generators, etc) for the whole workspace.\n188:     \"\"\"\n189:     subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n190:     subparser.add_argument(\"-g\", \"--generator\", action=\"append\", help='Generators to use')\n191:     subparser.add_argument(\"-of\", \"--output-folder\",\n192:                            help='The root output folder for generated and build files')\n193:     subparser.add_argument(\"--envs-generation\", default=None, choices=[\"false\"],\n194:                            help=\"Generation strategy for virtual environment files for the root\")\n195:     add_common_install_arguments(subparser)\n196:     add_lockfile_args(subparser)\n197:     args = parser.parse_args(*args)\n198:     # Basic collaborators: remotes, lockfile, profiles\n199:     remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n200:     overrides = eval(args.lockfile_overrides) if args.lockfile_overrides else None\n201:     # The lockfile by default if not defined will be read from the root workspace folder\n202:     ws_folder = conan_api.workspace.folder()\n203:     lockfile = conan_api.lockfile.get_lockfile(lockfile=args.lockfile, conanfile_path=ws_folder,\n204:                                                cwd=None,\n205:                                                partial=args.lockfile_partial, overrides=overrides)\n206:     profile_host, profile_build = conan_api.profiles.get_profiles_from_args(args)\n207:     print_profiles(profile_host, profile_build)\n208: \n209:     # Build a dependency graph with all editables as requirements\n210:     requires = conan_api.workspace.select_packages(args.pkg)\n211:     deps_graph = conan_api.graph.load_graph_requires(requires, [],\n212:                                                      profile_host, profile_build, lockfile,\n213:                                                      remotes, args.build, args.update)\n214:     deps_graph.report_graph_error()\n215:     print_graph_basic(deps_graph)\n216: \n217:     # Collapsing the graph\n218:     ws_graph = conan_api.workspace.super_build_graph(deps_graph, profile_host, profile_build)\n219:     ConanOutput().subtitle(\"Collapsed graph\")\n220:     print_graph_basic(ws_graph)\n221: \n222:     conan_api.graph.analyze_binaries(ws_graph, args.build, remotes=remotes, update=args.update,\n223:                                      lockfile=lockfile)\n224:     print_graph_packages(ws_graph)\n225:     conan_api.install.install_binaries(deps_graph=ws_graph, remotes=remotes)\n226:     output_folder = make_abs_path(args.output_folder) if args.output_folder else None\n227:     conan_api.install.install_consumer(ws_graph, args.generator, ws_folder, output_folder,\n228:                                        envs_generation=args.envs_generation)\n229: \n230: \n231: @conan_subcommand()\n232: def workspace_clean(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n233:     \"\"\"\n234:     Clean the temporary build folders when possible\n235:     \"\"\"\n236:     parser.parse_args(*args)\n237:     conan_api.workspace.clean()\n238: \n239: \n240: @conan_subcommand()\n241: def workspace_init(conan_api: ConanAPI, parser, subparser, *args):\n242:     \"\"\"\n243:     Clean the temporary build folders when possible\n244:     \"\"\"\n245:     subparser.add_argument(\"path\", nargs=\"?\", default=os.getcwd(),\n246:                         help=\"Path to a folder where the workspace will be initialized. \"\n247:                              \"If  does not exist\")\n248:     args = parser.parse_args(*args)\n249:     conan_api.workspace.init(args.path)\n250: \n251: \n252: @conan_subcommand()\n253: def workspace_create(conan_api: ConanAPI, parser, subparser, *args):\n254:     \"\"\"\n255:     Call \"conan create\" for packages in the workspace, in the correct order.\n256:     Packages will be created in the Conan cache, not locally\n257:     \"\"\"\n258:     subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n259:     add_common_install_arguments(subparser)\n260:     add_lockfile_args(subparser)\n261:     args = parser.parse_args(*args)\n262:     # Basic collaborators: remotes, lockfile, profiles\n263:     remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n264:     overrides = eval(args.lockfile_overrides) if args.lockfile_overrides else None\n265:     # The lockfile by default if not defined will be read from the root workspace folder\n266:     ws_folder = conan_api.workspace.folder()\n267:     lockfile = conan_api.lockfile.get_lockfile(lockfile=args.lockfile, conanfile_path=ws_folder,\n268:                                                cwd=None,\n269:                                                partial=args.lockfile_partial, overrides=overrides)\n270:     profile_host, profile_build = conan_api.profiles.get_profiles_from_args(args)\n271:     print_profiles(profile_host, profile_build)\n272: \n273:     build_mode = args.build if args.build else []\n274:     ConanOutput().box(\"Exporting workspace recipes to Conan cache\")\n275:     exported_refs = conan_api.workspace.export()\n276:     build_mode.extend(f\"missing:{r}\" for r in exported_refs)\n277: \n278:     all_packages = conan_api.workspace.packages()\n279:     packages = conan_api.workspace.select_packages(args.pkg)\n280: \n281:     # If we don't disable the workspace, then, the packages are not created in the Conan cache,\n282:     # but locally in the user folders, are they are intercepted as editables\n283:     conan_api.workspace.enable(False)\n284: \n285:     install_order = conan_api.workspace.build_order(packages, profile_host, profile_build,\n286:                                                     build_mode, lockfile, remotes, args,\n287:                                                     update=args.update)\n288: \n289:     ConanOutput().box(\"Workspace creating each package\")\n290:     order = install_order.install_build_order()\n291: \n292:     profile_args = ProfileArgs.from_args(args)\n293:     for level in order[\"order\"]:\n294:         for elem in level:\n295:             ref = RecipeReference.loads(elem[\"ref\"])\n296:             for package_level in elem[\"packages\"]:\n297:                 for package in package_level:\n298:                     if package[\"binary\"] not in (\"Build\", \"EditableBuild\"):\n299:                         ConanOutput().info(f\"Skip build for {ref} binary: {package['binary']}\")\n300:                         continue\n301: \n302:                     if ref not in all_packages:\n303:                         # Build external to Workspace\n304:                         cmd = f'install {package[\"build_args\"]} {profile_args}'\n305:                         ConanOutput().box(f\"Workspace building external {ref}\")\n306:                         ConanOutput().info(f\"Build command: {cmd}\\n\")\n307:                         conan_api.command.run(cmd)\n308:                     else:  # Package in workspace\n309:                         path = packages[ref][\"path\"]\n310:                         # TODO: Missing --lockfile-overrides arg here\n311:                         build = \"--build-require\" if package[\"context\"] == \"build\" else \"\"\n312:                         ref_args = \" \".join(f\"--{k}={getattr(ref, k)}\"\n313:                                             for k in (\"name\", \"version\", \"user\", \"channel\")\n314:                                             if getattr(ref, k, None))\n315:                         cmd = f'create \"{path}\" {profile_args} {build} {ref_args}'\n316:                         ConanOutput().box(f\"Workspace create {ref}\")\n317:                         ConanOutput().info(f\"Conan create command: {cmd}\\n\")\n318:                         conan_api.command.run(cmd)\n319: \n320: \n321: @conan_subcommand()\n322: def workspace_source(conan_api: ConanAPI, parser, subparser, *args):\n323:     \"\"\"\n324:     Call the source() method of packages in the workspace\n325:     \"\"\"\n326:     subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n327:     args = parser.parse_args(*args)\n328: \n329:     remotes = conan_api.remotes.list()  # In case \"python_requires\" are needed\n330:     packages = conan_api.workspace.select_packages(args.pkg)\n331: \n332:     ConanOutput().box(\"Workspace getting sources\")\n333:     for pkg, info in packages.items():\n334:         conan_api.local.source(info[\"path\"], name=pkg.name, version=str(pkg.version),\n335:                                user=pkg.user, channel=pkg.channel, remotes=remotes)\n336: \n337: \n338: @conan_command(group=\"Consumer\")\n339: def workspace(conan_api, parser, *args):  # noqa\n340:     \"\"\"\n341:     Manage Conan workspaces (group of packages in editable mode)\n342:     \"\"\"\n343:     if (WorkspaceAPI.TEST_ENABLED or os.getenv(\"CONAN_WORKSPACE_ENABLE\")) != \"will_break_next\":\n344:         raise ConanException(\"Workspace command disabled without CONAN_WORKSPACE_ENABLE env var,\"\n345:                              \"please read the docs about this 'incubating' feature\")\n\n(End of file - total 345 lines)\n</content>","metadata":{"preview":"import json\nimport os\n\nfrom conan.api.conan_api import ConanAPI\nfrom conan.api.model import RecipeReference\nfrom conan.api.output import ConanOutput, cli_out_write\nfrom conan.api.subapi.workspace import WorkspaceAPI\nfrom conan.cli import make_abs_path\nfrom conan.cli.args import add_reference_args, add_common_install_arguments, add_lockfile_args\nfrom conan.cli.command import conan_command, conan_subcommand\nfrom conan.cli.commands.list import print_serial\nfrom conan.cli.printers import print_profiles\nfrom conan.cli.printers.graph import print_graph_packages, print_graph_basic\nfrom conan.errors import ConanException\nfrom conan.internal.graph.install_graph import ProfileArgs\n\n\n@conan_subcommand(formatters={\"text\": cli_out_write})\ndef workspace_root(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n    \"\"\"","truncated":false,"loaded":[],"display":{"type":"file","path":"/testbed/conan/cli/commands/workspace.py","text":"import json\nimport os\n\nfrom conan.api.conan_api import ConanAPI\nfrom conan.api.model import RecipeReference\nfrom conan.api.output import ConanOutput, cli_out_write\nfrom conan.api.subapi.workspace import WorkspaceAPI\nfrom conan.cli import make_abs_path\nfrom conan.cli.args import add_reference_args, add_common_install_arguments, add_lockfile_args\nfrom conan.cli.command import conan_command, conan_subcommand\nfrom conan.cli.commands.list import print_serial\nfrom conan.cli.printers import print_profiles\nfrom conan.cli.printers.graph import print_graph_packages, print_graph_basic\nfrom conan.errors import ConanException\nfrom conan.internal.graph.install_graph import ProfileArgs\n\n\n@conan_subcommand(formatters={\"text\": cli_out_write})\ndef workspace_root(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n    \"\"\"\n    Return the folder containing the conanws.py/conanws.yml workspace file\n    \"\"\"\n    parser.parse_args(*args)\n    ws = conan_api.workspace\n    return ws.folder()\n\n\n@conan_subcommand()\ndef workspace_open(conan_api: ConanAPI, parser, subparser, *args):\n    \"\"\"\n    Open specific references\n    \"\"\"\n    subparser.add_argument(\"reference\",\n                           help=\"Open this package source repository\")\n    group = subparser.add_mutually_exclusive_group()\n    group.add_argument(\"-r\", \"--remote\", action=\"append\", default=None,\n                       help='Look in the specified remote or remotes server')\n    group.add_argument(\"-nr\", \"--no-remote\", action=\"store_true\",\n                       help='Do not use remote, resolve exclusively in the cache')\n    args = parser.parse_args(*args)\n    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n    cwd = os.getcwd()\n    conan_api.workspace.open(args.reference, remotes=remotes, cwd=cwd)\n\n\n@conan_subcommand()\ndef workspace_add(conan_api: ConanAPI, parser, subparser, *args):\n    \"\"\"\n    Add packages to current workspace\n    \"\"\"\n    subparser.add_argument('path',  nargs=\"?\",\n                           help='Path to the package folder in the user workspace')\n    add_reference_args(subparser)\n    subparser.add_argument(\"--ref\", help=\"Open and add this reference\")\n    subparser.add_argument(\"-of\", \"--output-folder\",\n                           help='The root output folder for generated and build files')\n    group = subparser.add_mutually_exclusive_group()\n    group.add_argument(\"-r\", \"--remote\", action=\"append\", default=None,\n                       help='Look in the specified remote or remotes server')\n    group.add_argument(\"-nr\", \"--no-remote\", action=\"store_true\",\n                       help='Do not use remote, resolve exclusively in the cache')\n    args = parser.parse_args(*args)\n    if args.path and args.ref:\n        raise ConanException(\"Do not use both 'path' and '--ref' argument\")\n    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n    cwd = os.getcwd()\n    path = args.path\n    if args.ref:\n        # TODO: Use path here to open in this path\n        path = conan_api.workspace.open(args.ref, remotes, cwd=cwd)\n    ref = conan_api.workspace.add(path,\n                                  args.name, args.version, args.user, args.channel,\n                                  cwd, args.output_folder, remotes=remotes)\n    ConanOutput().success(\"Reference '{}' added to workspace\".format(ref))\n\n\n@conan_subcommand()\ndef workspace_remove(conan_api: ConanAPI, parser, subparser, *args):\n    \"\"\"\n    Remove packages from the current workspace\n    \"\"\"\n    subparser.add_argument('path',\n                           help='Path to the package folder in the user workspace')\n    args = parser.parse_args(*args)\n    removed = conan_api.workspace.remove(make_abs_path(args.path))\n    ConanOutput().info(f\"Removed from workspace: {removed}\")\n\n\ndef print_json(data):\n    results = data[\"info\"]\n    myjson = json.dumps(results, indent=4)\n    cli_out_write(myjson)\n\n\ndef _print_workspace_info(data):\n    print_serial(data[\"info\"])\n\n\n@conan_subcommand(formatters={\"text\": _print_workspace_info, \"json\": print_json})\ndef workspace_info(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n    \"\"\"\n    Display info for current workspace\n    \"\"\"\n    parser.parse_args(*args)\n    return {\"info\": conan_api.workspace.info()}\n\n\n@conan_subcommand()\ndef workspace_build(conan_api: ConanAPI, parser, subparser, *args):\n    \"\"\"\n    Call \"conan build\" for packages in the workspace, in the right order\n    \"\"\"\n    _install_build(conan_api, parser, subparser, True, *args)\n\n\n@conan_subcommand()\ndef workspace_install(conan_api: ConanAPI, parser, subparser, *args):\n    \"\"\"\n    Call \"conan install\" for packages in the workspace, in the right order\n    \"\"\"\n    _install_build(conan_api, parser, subparser, False, *args)\n\n\ndef _install_build(conan_api: ConanAPI, parser, subparser, build, *args):\n    subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n    add_common_install_arguments(subparser)\n    add_lockfile_args(subparser)\n    args = parser.parse_args(*args)\n    # Basic collaborators: remotes, lockfile, profiles\n    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n    overrides = eval(args.lockfile_overrides) if args.lockfile_overrides else None\n    # The lockfile by default if not defined will be read from the root workspace folder\n    ws_folder = conan_api.workspace.folder()\n    lockfile = conan_api.lockfile.get_lockfile(lockfile=args.lockfile, conanfile_path=ws_folder,\n                                               cwd=None, partial=args.lockfile_partial,\n                                               overrides=overrides)\n    profile_host, profile_build = conan_api.profiles.get_profiles_from_args(args)\n    print_profiles(profile_host, profile_build)\n\n    buildmode = args.build\n    if build and (not buildmode or \"editable\" not in buildmode):\n        ConanOutput().info(\"Adding '--build=editable' as build mode\")\n        buildmode = buildmode or []\n        buildmode.append(\"editable\")\n\n    all_editables = conan_api.workspace.packages()\n    packages = conan_api.workspace.select_packages(args.pkg)\n    ConanOutput().box(\"Workspace computing the build order\")\n    install_order = conan_api.workspace.build_order(packages, profile_host, profile_build, buildmode,\n                                                    lockfile, remotes, args, update=args.update)\n\n    msg = \"build\" if build else \"install\"\n    ConanOutput().box(f\"Workspace {msg}ing each package\")\n    order = install_order.install_build_order()\n\n    profile_args = ProfileArgs.from_args(args)\n    for level in order[\"order\"]:\n        for elem in level:\n            ref = RecipeReference.loads(elem[\"ref\"])\n            for package_level in elem[\"packages\"]:\n                for package in package_level:\n                    if package[\"binary\"] == \"Build\":  # Build external to Workspace\n                        cmd = f'install {package[\"build_args\"]} {profile_args}'\n                        ConanOutput().box(f\"Workspace building external {ref}\")\n                        ConanOutput().info(f\"Command: {cmd}\\n\")\n                        conan_api.command.run(cmd)\n                    elif package[\"binary\"] in (\"Editable\", \"EditableBuild\"):\n                        path = all_editables[ref][\"path\"]\n                        output_folder = all_editables[ref].get(\"output_folder\")\n                        build_arg = \"--build-require\" if package[\"context\"] == \"build\" else \"\"\n                        ref_args = \" \".join(f\"--{k}={getattr(ref, k)}\"\n                                            for k in (\"name\", \"version\", \"user\", \"channel\")\n                                            if getattr(ref, k, None))\n                        of_arg = f'-of=\"{output_folder}\"' if output_folder else \"\"\n                        # TODO: Missing --lockfile-overrides arg here\n                        command = \"build\" if build else \"install\"\n                        cmd = f'{command} \"{path}\" {profile_args} {build_arg} {ref_args} {of_arg}'\n                        ConanOutput().box(f\"Workspace {command}: {ref}\")\n                        ConanOutput().info(f\"Command: {cmd}\\n\")\n                        conan_api.command.run(cmd)\n\n\n@conan_subcommand()\ndef workspace_super_install(conan_api: ConanAPI, parser, subparser, *args):\n    \"\"\"\n    Install the workspace as a monolith, installing only external dependencies to the workspace,\n    generating a single result (generators, etc) for the whole workspace.\n    \"\"\"\n    subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n    subparser.add_argument(\"-g\", \"--generator\", action=\"append\", help='Generators to use')\n    subparser.add_argument(\"-of\", \"--output-folder\",\n                           help='The root output folder for generated and build files')\n    subparser.add_argument(\"--envs-generation\", default=None, choices=[\"false\"],\n                           help=\"Generation strategy for virtual environment files for the root\")\n    add_common_install_arguments(subparser)\n    add_lockfile_args(subparser)\n    args = parser.parse_args(*args)\n    # Basic collaborators: remotes, lockfile, profiles\n    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n    overrides = eval(args.lockfile_overrides) if args.lockfile_overrides else None\n    # The lockfile by default if not defined will be read from the root workspace folder\n    ws_folder = conan_api.workspace.folder()\n    lockfile = conan_api.lockfile.get_lockfile(lockfile=args.lockfile, conanfile_path=ws_folder,\n                                               cwd=None,\n                                               partial=args.lockfile_partial, overrides=overrides)\n    profile_host, profile_build = conan_api.profiles.get_profiles_from_args(args)\n    print_profiles(profile_host, profile_build)\n\n    # Build a dependency graph with all editables as requirements\n    requires = conan_api.workspace.select_packages(args.pkg)\n    deps_graph = conan_api.graph.load_graph_requires(requires, [],\n                                                     profile_host, profile_build, lockfile,\n                                                     remotes, args.build, args.update)\n    deps_graph.report_graph_error()\n    print_graph_basic(deps_graph)\n\n    # Collapsing the graph\n    ws_graph = conan_api.workspace.super_build_graph(deps_graph, profile_host, profile_build)\n    ConanOutput().subtitle(\"Collapsed graph\")\n    print_graph_basic(ws_graph)\n\n    conan_api.graph.analyze_binaries(ws_graph, args.build, remotes=remotes, update=args.update,\n                                     lockfile=lockfile)\n    print_graph_packages(ws_graph)\n    conan_api.install.install_binaries(deps_graph=ws_graph, remotes=remotes)\n    output_folder = make_abs_path(args.output_folder) if args.output_folder else None\n    conan_api.install.install_consumer(ws_graph, args.generator, ws_folder, output_folder,\n                                       envs_generation=args.envs_generation)\n\n\n@conan_subcommand()\ndef workspace_clean(conan_api: ConanAPI, parser, subparser, *args):  # noqa\n    \"\"\"\n    Clean the temporary build folders when possible\n    \"\"\"\n    parser.parse_args(*args)\n    conan_api.workspace.clean()\n\n\n@conan_subcommand()\ndef workspace_init(conan_api: ConanAPI, parser, subparser, *args):\n    \"\"\"\n    Clean the temporary build folders when possible\n    \"\"\"\n    subparser.add_argument(\"path\", nargs=\"?\", default=os.getcwd(),\n                        help=\"Path to a folder where the workspace will be initialized. \"\n                             \"If  does not exist\")\n    args = parser.parse_args(*args)\n    conan_api.workspace.init(args.path)\n\n\n@conan_subcommand()\ndef workspace_create(conan_api: ConanAPI, parser, subparser, *args):\n    \"\"\"\n    Call \"conan create\" for packages in the workspace, in the correct order.\n    Packages will be created in the Conan cache, not locally\n    \"\"\"\n    subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n    add_common_install_arguments(subparser)\n    add_lockfile_args(subparser)\n    args = parser.parse_args(*args)\n    # Basic collaborators: remotes, lockfile, profiles\n    remotes = conan_api.remotes.list(args.remote) if not args.no_remote else []\n    overrides = eval(args.lockfile_overrides) if args.lockfile_overrides else None\n    # The lockfile by default if not defined will be read from the root workspace folder\n    ws_folder = conan_api.workspace.folder()\n    lockfile = conan_api.lockfile.get_lockfile(lockfile=args.lockfile, conanfile_path=ws_folder,\n                                               cwd=None,\n                                               partial=args.lockfile_partial, overrides=overrides)\n    profile_host, profile_build = conan_api.profiles.get_profiles_from_args(args)\n    print_profiles(profile_host, profile_build)\n\n    build_mode = args.build if args.build else []\n    ConanOutput().box(\"Exporting workspace recipes to Conan cache\")\n    exported_refs = conan_api.workspace.export()\n    build_mode.extend(f\"missing:{r}\" for r in exported_refs)\n\n    all_packages = conan_api.workspace.packages()\n    packages = conan_api.workspace.select_packages(args.pkg)\n\n    # If we don't disable the workspace, then, the packages are not created in the Conan cache,\n    # but locally in the user folders, are they are intercepted as editables\n    conan_api.workspace.enable(False)\n\n    install_order = conan_api.workspace.build_order(packages, profile_host, profile_build,\n                                                    build_mode, lockfile, remotes, args,\n                                                    update=args.update)\n\n    ConanOutput().box(\"Workspace creating each package\")\n    order = install_order.install_build_order()\n\n    profile_args = ProfileArgs.from_args(args)\n    for level in order[\"order\"]:\n        for elem in level:\n            ref = RecipeReference.loads(elem[\"ref\"])\n            for package_level in elem[\"packages\"]:\n                for package in package_level:\n                    if package[\"binary\"] not in (\"Build\", \"EditableBuild\"):\n                        ConanOutput().info(f\"Skip build for {ref} binary: {package['binary']}\")\n                        continue\n\n                    if ref not in all_packages:\n                        # Build external to Workspace\n                        cmd = f'install {package[\"build_args\"]} {profile_args}'\n                        ConanOutput().box(f\"Workspace building external {ref}\")\n                        ConanOutput().info(f\"Build command: {cmd}\\n\")\n                        conan_api.command.run(cmd)\n                    else:  # Package in workspace\n                        path = packages[ref][\"path\"]\n                        # TODO: Missing --lockfile-overrides arg here\n                        build = \"--build-require\" if package[\"context\"] == \"build\" else \"\"\n                        ref_args = \" \".join(f\"--{k}={getattr(ref, k)}\"\n                                            for k in (\"name\", \"version\", \"user\", \"channel\")\n                                            if getattr(ref, k, None))\n                        cmd = f'create \"{path}\" {profile_args} {build} {ref_args}'\n                        ConanOutput().box(f\"Workspace create {ref}\")\n                        ConanOutput().info(f\"Conan create command: {cmd}\\n\")\n                        conan_api.command.run(cmd)\n\n\n@conan_subcommand()\ndef workspace_source(conan_api: ConanAPI, parser, subparser, *args):\n    \"\"\"\n    Call the source() method of packages in the workspace\n    \"\"\"\n    subparser.add_argument(\"--pkg\", action=\"append\", help='Define specific packages')\n    args = parser.parse_args(*args)\n\n    remotes = conan_api.remotes.list()  # In case \"python_requires\" are needed\n    packages = conan_api.workspace.select_packages(args.pkg)\n\n    ConanOutput().box(\"Workspace getting sources\")\n    for pkg, info in packages.items():\n        conan_api.local.source(info[\"path\"], name=pkg.name, version=str(pkg.version),\n                               user=pkg.user, channel=pkg.channel, remotes=remotes)\n\n\n@conan_command(group=\"Consumer\")\ndef workspace(conan_api, parser, *args):  # noqa\n    \"\"\"\n    Manage Conan workspaces (group of packages in editable mode)\n    \"\"\"\n    if (WorkspaceAPI.TEST_ENABLED or os.getenv(\"CONAN_WORKSPACE_ENABLE\")) != \"will_break_next\":\n        raise ConanException(\"Workspace command disabled without CONAN_WORKSPACE_ENABLE env var,\"\n                             \"please read the docs about this 'incubating' feature\")","lineStart":1,"lineEnd":345,"totalLines":345,"truncated":false}},"title":"conan/cli/commands/workspace.py","time":{"start":1788511593754,"end":1788511593772}},"id":"prt_06b9924d0001bGVr9QC8c2QmPP","sessionID":"ses_f94670cb8ffeWdbpzRFsoZCXEH","messageID":"msg_06b99158a001ReWQgEt55c396q"}}
{"type":"tool_use","timestamp":1788511593869,"sessionID":"ses_f94670cb8ffeWdbpzRFsoZCXEH","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-a0f451bf4141f59c","state":{"status":"completed","input":{"filePath":"/testbed/conan/api/subapi/workspace.py"},"output":"<path>/testbed/conan/api/subapi/workspace.py</path>\n<type>file</type>\n<content>\n1: import inspect\n2: import os\n3: import shutil\n4: import textwrap\n5: from pathlib import Path\n6: \n7: from conan import ConanFile\n8: from conan.api.model import RecipeReference\n9: from conan.api.output import ConanOutput\n10: from conan.cli import make_abs_path\n11: from conan.cli.printers.graph import print_graph_basic, print_graph_packages\n12: from conan.errors import ConanException\n13: from conan.internal.conan_app import ConanApp\n14: from conan.internal.graph.install_graph import ProfileArgs\n15: from conan.internal.model.workspace import Workspace, WORKSPACE_YML, WORKSPACE_PY, WORKSPACE_FOLDER\n16: from conan.tools.scm import Git\n17: from conan.internal.graph.graph import RECIPE_EDITABLE, DepsGraph, CONTEXT_HOST, RECIPE_VIRTUAL, Node, \\\n18:     RECIPE_CONSUMER\n19: from conan.internal.graph.graph import TransitiveRequirement\n20: from conan.internal.graph.profile_node_definer import consumer_definer\n21: from conan.internal.loader import load_python_file\n22: from conan.internal.source import retrieve_exports_sources\n23: from conan.internal.util.files import merge_directories, save\n24: \n25: \n26: def _find_ws_folder():\n27:     path = Path(os.getcwd())\n28:     while path.is_dir() and len(path.parts) > 1:  # finish at '/' or 'conanws/'\n29:         if path.name == WORKSPACE_FOLDER:\n30:             if (path / WORKSPACE_YML).is_file() or (path / WORKSPACE_PY).is_file():\n31:                 return str(path)\n32:         if (path / WORKSPACE_YML).is_file() or (path / WORKSPACE_PY).is_file():\n33:             return str(path)\n34:         else:\n35:             path = path.parent\n36: \n37: \n38: def _load_workspace(ws_folder, conan_api):\n39:     \"\"\" loads a conanfile basic object without evaluating anything, returns the module too\n40:     \"\"\"\n41:     wspy = os.path.join(ws_folder, WORKSPACE_PY)\n42:     if not os.path.isfile(wspy):\n43:         ConanOutput().info(f\"{WORKSPACE_PY} doesn't exist in {ws_folder}, using default behavior\")\n44:         assert os.path.exists(os.path.join(ws_folder, WORKSPACE_YML))\n45:         ws = Workspace(ws_folder, conan_api)\n46:     else:\n47:         try:\n48:             module, module_id = load_python_file(wspy)\n49:             ws = _parse_module(module, module_id)\n50:             ws = ws(ws_folder, conan_api)\n51:         except ConanException as e:\n52:             raise ConanException(f\"Error loading {WORKSPACE_PY} at '{wspy}': {e}\")\n53:     return ws\n54: \n55: \n56: def _parse_module(conanfile_module, module_id):\n57:     result = None\n58:     for name, attr in conanfile_module.__dict__.items():\n59:         if (name.startswith(\"_\") or not inspect.isclass(attr) or\n60:                 attr.__dict__.get(\"__module__\") != module_id):\n61:             continue\n62: \n63:         if issubclass(attr, Workspace) and attr != Workspace:\n64:             if result is None:\n65:                 result = attr\n66:             else:\n67:                 raise ConanException(\"More than 1 Workspace in the file\")\n68: \n69:     if result is None:\n70:         raise ConanException(\"No subclass of Workspace\")\n71: \n72:     return result\n73: \n74: \n75: class WorkspaceAPI:\n76:     TEST_ENABLED = False\n77: \n78:     def __init__(self, conan_api):\n79:         self._enabled = True\n80:         self._conan_api = conan_api\n81:         self._folder = _find_ws_folder()\n82:         if self._folder:\n83:             ConanOutput().warning(f\"Workspace found: {self._folder}\")\n84:             if (WorkspaceAPI.TEST_ENABLED or os.getenv(\"CONAN_WORKSPACE_ENABLE\")) != \"will_break_next\":\n85:                 ConanOutput().warning(\"Workspace ignored as CONAN_WORKSPACE_ENABLE is not set\")\n86:                 self._folder = None\n87:             else:\n88:                 ConanOutput().warning(f\"Workspace is a dev-only feature, exclusively for testing\")\n89:                 self._ws = _load_workspace(self._folder, conan_api)  # Error if not loading\n90: \n91:     def enable(self, value):\n92:         self._enabled = value\n93: \n94:     @property\n95:     def name(self):\n96:         self._check_ws()\n97:         return self._ws.name()\n98: \n99:     def folder(self):\n100:         \"\"\"\n101:         @return: the current workspace folder where the conanws.yml or conanws.py is located\n102:         \"\"\"\n103:         self._check_ws()\n104:         return self._folder\n105: \n106:     def packages(self):\n107:         \"\"\"\n108:         @return: Returns {RecipeReference: {\"path\": full abs-path, \"output_folder\": abs-path}}\n109:         \"\"\"\n110:         if not self._folder or not self._enabled:\n111:             return\n112:         editables = self._ws.packages()\n113:         editables = {RecipeReference.loads(r): v.copy() for r, v in editables.items()}\n114:         for v in editables.values():\n115:             path = os.path.normpath(os.path.join(self._folder, v[\"path\"], \"conanfile.py\"))\n116:             if not os.path.isfile(path):\n117:                 raise ConanException(f\"Workspace editable not found: {path}\")\n118:             v[\"path\"] = path\n119:             if v.get(\"output_folder\"):\n120:                 v[\"output_folder\"] = os.path.normpath(os.path.join(self._folder,\n121:                                                                    v[\"output_folder\"]))\n122:         return editables\n123: \n124:     def open(self, require, remotes, cwd=None):\n125:         app = ConanApp(self._conan_api)\n126:         ref = RecipeReference.loads(require)\n127:         recipe = app.proxy.get_recipe(ref, remotes, update=False, check_update=False)\n128: \n129:         layout, recipe_status, remote = recipe\n130:         if recipe_status == RECIPE_EDITABLE:\n131:             raise ConanException(f\"Can't open a dependency that is already an editable: {ref}\")\n132:         ref = layout.reference\n133:         conanfile_path = layout.conanfile()\n134:         conanfile, module = app.loader.load_basic_module(conanfile_path, remotes=remotes)\n135: \n136:         scm = conanfile.conan_data.get(\"scm\") if conanfile.conan_data else None\n137:         dst_path = os.path.join(cwd or os.getcwd(), ref.name)\n138:         if scm is None:\n139:             conanfile.output.warning(\"conandata doesn't contain 'scm' information\\n\"\n140:                                      \"doing a local copy!!!\")\n141:             shutil.copytree(layout.export(), dst_path)\n142:             retrieve_exports_sources(app.remote_manager, layout, conanfile, ref, remotes)\n143:             export_sources = layout.export_sources()\n144:             if os.path.exists(export_sources):\n145:                 conanfile.output.warning(\"There are export-sources, copying them, but the location\"\n146:                                          \" might be incorrect, use 'scm' approach\")\n147:                 merge_directories(export_sources, dst_path)\n148:         else:\n149:             git = Git(conanfile, folder=cwd)\n150:             git.clone(url=scm[\"url\"], target=ref.name)\n151:             git.folder = ref.name  # change to the cloned folder\n152:             git.checkout(commit=scm[\"commit\"])\n153:         return dst_path\n154: \n155:     def _check_ws(self):\n156:         if not self._folder:\n157:             raise ConanException(f\"Workspace not defined, please create a \"\n158:                                  f\"'{WORKSPACE_PY}' or '{WORKSPACE_YML}' file\")\n159: \n160:     def add(self, path, name=None, version=None, user=None, channel=None, cwd=None,\n161:             output_folder=None, remotes=None):\n162:         \"\"\"\n163:         Add a new editable package to the current workspace (the current workspace must exist)\n164:         @param path: The path to the folder containing the conanfile.py that defines the package\n165:         @param name: (optional) The name of the package to be added if not defined in recipe\n166:         @param version:\n167:         @param user:\n168:         @param channel:\n169:         @param cwd:\n170:         @param output_folder:\n171:         @param remotes:\n172:         @return: The reference of the added package\n173:         \"\"\"\n174:         self._check_ws()\n175:         full_path = self._conan_api.local.get_conanfile_path(path, cwd, py=True)\n176:         app = ConanApp(self._conan_api)\n177:         conanfile = app.loader.load_named(full_path, name, version, user, channel, remotes=remotes)\n178:         if conanfile.name is None or conanfile.version is None:\n179:             raise ConanException(\"Editable package recipe should declare its name and version\")\n180:         ref = RecipeReference(conanfile.name, conanfile.version, conanfile.user, conanfile.channel)\n181:         ref.validate_ref()\n182:         output_folder = make_abs_path(output_folder) if output_folder else None\n183:         # Check the conanfile is there, and name/version matches\n184:         self._ws.add(ref, full_path, output_folder)\n185:         return ref\n186: \n187:     @staticmethod\n188:     def init(path):\n189:         abs_path = make_abs_path(path)\n190:         os.makedirs(abs_path, exist_ok=True)\n191:         ws_yml_file = Path(abs_path, WORKSPACE_YML)\n192:         ws_py_file = Path(abs_path, WORKSPACE_PY)\n193:         if not ws_yml_file.exists():\n194:             ConanOutput().success(f\"Created empty {WORKSPACE_YML} in {path}\")\n195:             save(ws_yml_file, \"\")\n196:         if not ws_py_file.exists():\n197:             ConanOutput().success(f\"Created minimal {WORKSPACE_PY} in {path}\")\n198:             ws_name = os.path.basename(abs_path)\n199:             save(ws_py_file, textwrap.dedent(f'''\\\n200:             from conan import Workspace\n201: \n202:             class MyWorkspace(Workspace):\n203:                \"\"\"\n204:                Minimal Workspace class definition.\n205:                More info: https://docs.conan.io/2/incubating.html#workspaces\n206:                \"\"\"\n207:                def name(self):\n208:                   return \"{ws_name}\"\n209:             '''))\n210: \n211:     def remove(self, path):\n212:         self._check_ws()\n213:         return self._ws.remove(path)\n214: \n215:     def clean(self):\n216:         self._check_ws()\n217:         return self._ws.clean()\n218: \n219:     def info(self):\n220:         self._check_ws()\n221:         return {\"name\": self.name,\n222:                 \"folder\": self._folder,\n223:                 \"packages\": self._ws.packages()}\n224: \n225:     def super_build_graph(self, deps_graph, profile_host, profile_build):\n226:         ConanOutput().title(\"Collapsing workspace packages\")\n227: \n228:         root_class = self._ws.root_conanfile()\n229:         if root_class is not None:\n230:             conanfile = root_class(f\"{WORKSPACE_PY} base project Conanfile\")\n231:             consumer_definer(conanfile, profile_host, profile_build)\n232:             root = Node(None, conanfile, context=CONTEXT_HOST, recipe=RECIPE_CONSUMER,\n233:                         path=self._folder)  # path lets use the conanws.py folder\n234:             root.should_build = True  # It is a consumer, this is something we are building\n235:             for field in (\"requires\", \"build_requires\", \"test_requires\", \"requirements\", \"build\",\n236:                           \"source\", \"package\"):\n237:                 if getattr(conanfile, field, None):\n238:                     raise ConanException(f\"Conanfile in conanws.py shouldn't have '{field}'\")\n239:         else:\n240:             ConanOutput().info(f\"Workspace {WORKSPACE_PY} not found in the workspace folder, \"\n241:                                \"using default behavior\")\n242:             conanfile = ConanFile(display_name=\"cli\")\n243:             consumer_definer(conanfile, profile_host, profile_build)\n244:             root = Node(ref=None, conanfile=conanfile, context=CONTEXT_HOST, recipe=RECIPE_VIRTUAL)\n245: \n246:         result = DepsGraph()  # TODO: We might need to copy more information from the original graph\n247:         result.add_node(root)\n248:         for node in deps_graph.nodes[1:]:  # Exclude the current root\n249:             if node.recipe != RECIPE_EDITABLE:\n250:                 result.add_node(node)\n251:                 continue\n252:             for r, t in node.transitive_deps.items():\n253:                 if t.node.recipe == RECIPE_EDITABLE:\n254:                     continue\n255:                 existing = root.transitive_deps.pop(r, None)\n256:                 if existing is None:\n257:                     root.transitive_deps[r] = t\n258:                 else:\n259:                     require = existing.require\n260:                     require.aggregate(r)\n261:                     root.transitive_deps[require] = TransitiveRequirement(require, t.node)\n262: \n263:         # The graph edges must be defined too\n264:         for r, t in root.transitive_deps.items():\n265:             result.add_edge(root, t.node, r)\n266: \n267:         return result\n268: \n269:     def export(self, lockfile=None, remotes=None):\n270:         self._check_ws()\n271:         exported = []\n272:         for ref, info in self.packages().items():\n273:             exported_ref = self._conan_api.export.export(info[\"path\"], ref.name, str(ref.version),\n274:                                                          ref.user, ref.channel,\n275:                                                          lockfile=lockfile, remotes=remotes)\n276:             ref, _ = exported_ref\n277:             exported.append(ref)\n278:         return exported\n279: \n280: \n281:     def select_packages(self, packages):\n282:         self._check_ws()\n283:         editable = self.packages()\n284:         packages = packages or []\n285:         selected_editables = {}\n286:         for ref, info in editable.items():\n287:             if packages and not any(ref.matches(p, False) for p in packages):\n288:                 continue\n289:             selected_editables[ref] = info\n290:         if not selected_editables:\n291:             raise ConanException(\"There are no selected packages defined in the workspace\")\n292: \n293:         return selected_editables\n294: \n295:     def build_order(self, packages, profile_host, profile_build, build_mode, lockfile, remotes,\n296:                     profile_args, update=False):\n297:         ConanOutput().title(f\"Computing dependency graph for each package\")\n298:         conan_api = self._conan_api\n299:         from conan.internal.graph.install_graph import InstallGraph\n300:         install_order = InstallGraph(None)\n301: \n302:         for ref, info in packages.items():\n303:             ConanOutput().title(f\"Computing the dependency graph for package: {ref}\")\n304: \n305:             deps_graph = conan_api.graph.load_graph_requires([ref], None,\n306:                                                              profile_host, profile_build, lockfile,\n307:                                                              remotes, update)\n308:             deps_graph.report_graph_error()\n309:             print_graph_basic(deps_graph)\n310:             conan_api.graph.analyze_binaries(deps_graph, build_mode, remotes=remotes, update=update,\n311:                                              lockfile=lockfile)\n312:             print_graph_packages(deps_graph)\n313: \n314:             ConanOutput().success(f\"\\nAggregating build-order for package: {ref}\")\n315:             install_graph = InstallGraph(deps_graph, order_by=\"recipe\",\n316:                                          profile_args=ProfileArgs.from_args(profile_args))\n317:             install_graph.raise_errors()\n318:             install_order.merge(install_graph)\n319: \n320:         return install_order\n\n(End of file - total 320 lines)\n</content>","metadata":{"preview":"import inspect\nimport os\nimport shutil\nimport textwrap\nfrom pathlib import Path\n\nfrom conan import ConanFile\nfrom conan.api.model import RecipeReference\nfrom conan.api.output import ConanOutput\nfrom conan.cli import make_abs_path\nfrom conan.cli.printers.graph import print_graph_basic, print_graph_packages\nfrom conan.errors import ConanException\nfrom conan.internal.conan_app import ConanApp\nfrom conan.internal.graph.install_graph import ProfileArgs\nfrom conan.internal.model.workspace import Workspace, WORKSPACE_YML, WORKSPACE_PY, WORKSPACE_FOLDER\nfrom conan.tools.scm import Git\nfrom conan.internal.graph.graph import RECIPE_EDITABLE, DepsGraph, CONTEXT_HOST, RECIPE_VIRTUAL, Node, \\\n    RECIPE_CONSUMER\nfrom conan.internal.graph.graph import TransitiveRequirement\nfrom conan.internal.graph.profile_node_definer import consumer_definer","truncated":false,"loaded":[],"display":{"type":"file","path":"/testbed/conan/api/subapi/workspace.py","text":"import inspect\nimport os\nimport shutil\nimport textwrap\nfrom pathlib import Path\n\nfrom conan import ConanFile\nfrom conan.api.model import RecipeReference\nfrom conan.api.output import ConanOutput\nfrom conan.cli import make_abs_path\nfrom conan.cli.printers.graph import print_graph_basic, print_graph_packages\nfrom conan.errors import ConanException\nfrom conan.internal.conan_app import ConanApp\nfrom conan.internal.graph.install_graph import ProfileArgs\nfrom conan.internal.model.workspace import Workspace, WORKSPACE_YML, WORKSPACE_PY, WORKSPACE_FOLDER\nfrom conan.tools.scm import Git\nfrom conan.internal.graph.graph import RECIPE_EDITABLE, DepsGraph, CONTEXT_HOST, RECIPE_VIRTUAL, Node, \\\n    RECIPE_CONSUMER\nfrom conan.internal.graph.graph import TransitiveRequirement\nfrom conan.internal.graph.profile_node_definer import consumer_definer\nfrom conan.internal.loader import load_python_file\nfrom conan.internal.source import retrieve_exports_sources\nfrom conan.internal.util.files import merge_directories, save\n\n\ndef _find_ws_folder():\n    path = Path(os.getcwd())\n    while path.is_dir() and len(path.parts) > 1:  # finish at '/' or 'conanws/'\n        if path.name == WORKSPACE_FOLDER:\n            if (path / WORKSPACE_YML).is_file() or (path / WORKSPACE_PY).is_file():\n                return str(path)\n        if (path / WORKSPACE_YML).is_file() or (path / WORKSPACE_PY).is_file():\n            return str(path)\n        else:\n            path = path.parent\n\n\ndef _load_workspace(ws_folder, conan_api):\n    \"\"\" loads a conanfile basic object without evaluating anything, returns the module too\n    \"\"\"\n    wspy = os.path.join(ws_folder, WORKSPACE_PY)\n    if not os.path.isfile(wspy):\n        ConanOutput().info(f\"{WORKSPACE_PY} doesn't exist in {ws_folder}, using default behavior\")\n        assert os.path.exists(os.path.join(ws_folder, WORKSPACE_YML))\n        ws = Workspace(ws_folder, conan_api)\n    else:\n        try:\n            module, module_id = load_python_file(wspy)\n            ws = _parse_module(module, module_id)\n            ws = ws(ws_folder, conan_api)\n        except ConanException as e:\n            raise ConanException(f\"Error loading {WORKSPACE_PY} at '{wspy}': {e}\")\n    return ws\n\n\ndef _parse_module(conanfile_module, module_id):\n    result = None\n    for name, attr in conanfile_module.__dict__.items():\n        if (name.startswith(\"_\") or not inspect.isclass(attr) or\n                attr.__dict__.get(\"__module__\") != module_id):\n            continue\n\n        if issubclass(attr, Workspace) and attr != Workspace:\n            if result is None:\n                result = attr\n            else:\n                raise ConanException(\"More than 1 Workspace in the file\")\n\n    if result is None:\n        raise ConanException(\"No subclass of Workspace\")\n\n    return result\n\n\nclass WorkspaceAPI:\n    TEST_ENABLED = False\n\n    def __init__(self, conan_api):\n        self._enabled = True\n        self._conan_api = conan_api\n        self._folder = _find_ws_folder()\n        if self._folder:\n            ConanOutput().warning(f\"Workspace found: {self._folder}\")\n            if (WorkspaceAPI.TEST_ENABLED or os.getenv(\"CONAN_WORKSPACE_ENABLE\")) != \"will_break_next\":\n                ConanOutput().warning(\"Workspace ignored as CONAN_WORKSPACE_ENABLE is not set\")\n                self._folder = None\n            else:\n                ConanOutput().warning(f\"Workspace is a dev-only feature, exclusively for testing\")\n                self._ws = _load_workspace(self._folder, conan_api)  # Error if not loading\n\n    def enable(self, value):\n        self._enabled = value\n\n    @property\n    def name(self):\n        self._check_ws()\n        return self._ws.name()\n\n    def folder(self):\n        \"\"\"\n        @return: the current workspace folder where the conanws.yml or conanws.py is located\n        \"\"\"\n        self._check_ws()\n        return self._folder\n\n    def packages(self):\n        \"\"\"\n        @return: Returns {RecipeReference: {\"path\": full abs-path, \"output_folder\": abs-path}}\n        \"\"\"\n        if not self._folder or not self._enabled:\n            return\n        editables = self._ws.packages()\n        editables = {RecipeReference.loads(r): v.copy() for r, v in editables.items()}\n        for v in editables.values():\n            path = os.path.normpath(os.path.join(self._folder, v[\"path\"], \"conanfile.py\"))\n            if not os.path.isfile(path):\n                raise ConanException(f\"Workspace editable not found: {path}\")\n            v[\"path\"] = path\n            if v.get(\"output_folder\"):\n                v[\"output_folder\"] = os.path.normpath(os.path.join(self._folder,\n                                                                   v[\"output_folder\"]))\n        return editables\n\n    def open(self, require, remotes, cwd=None):\n        app = ConanApp(self._conan_api)\n        ref = RecipeReference.loads(require)\n        recipe = app.proxy.get_recipe(ref, remotes, update=False, check_update=False)\n\n        layout, recipe_status, remote = recipe\n        if recipe_status == RECIPE_EDITABLE:\n            raise ConanException(f\"Can't open a dependency that is already an editable: {ref}\")\n        ref = layout.reference\n        conanfile_path = layout.conanfile()\n        conanfile, module = app.loader.load_basic_module(conanfile_path, remotes=remotes)\n\n        scm = conanfile.conan_data.get(\"scm\") if conanfile.conan_data else None\n        dst_path = os.path.join(cwd or os.getcwd(), ref.name)\n        if scm is None:\n            conanfile.output.warning(\"conandata doesn't contain 'scm' information\\n\"\n                                     \"doing a local copy!!!\")\n            shutil.copytree(layout.export(), dst_path)\n            retrieve_exports_sources(app.remote_manager, layout, conanfile, ref, remotes)\n            export_sources = layout.export_sources()\n            if os.path.exists(export_sources):\n                conanfile.output.warning(\"There are export-sources, copying them, but the location\"\n                                         \" might be incorrect, use 'scm' approach\")\n                merge_directories(export_sources, dst_path)\n        else:\n            git = Git(conanfile, folder=cwd)\n            git.clone(url=scm[\"url\"], target=ref.name)\n            git.folder = ref.name  # change to the cloned folder\n            git.checkout(commit=scm[\"commit\"])\n        return dst_path\n\n    def _check_ws(self):\n        if not self._folder:\n            raise ConanException(f\"Workspace not defined, please create a \"\n                                 f\"'{WORKSPACE_PY}' or '{WORKSPACE_YML}' file\")\n\n    def add(self, path, name=None, version=None, user=None, channel=None, cwd=None,\n            output_folder=None, remotes=None):\n        \"\"\"\n        Add a new editable package to the current workspace (the current workspace must exist)\n        @param path: The path to the folder containing the conanfile.py that defines the package\n        @param name: (optional) The name of the package to be added if not defined in recipe\n        @param version:\n        @param user:\n        @param channel:\n        @param cwd:\n        @param output_folder:\n        @param remotes:\n        @return: The reference of the added package\n        \"\"\"\n        self._check_ws()\n        full_path = self._conan_api.local.get_conanfile_path(path, cwd, py=True)\n        app = ConanApp(self._conan_api)\n        conanfile = app.loader.load_named(full_path, name, version, user, channel, remotes=remotes)\n        if conanfile.name is None or conanfile.version is None:\n            raise ConanException(\"Editable package recipe should declare its name and version\")\n        ref = RecipeReference(conanfile.name, conanfile.version, conanfile.user, conanfile.channel)\n        ref.validate_ref()\n        output_folder = make_abs_path(output_folder) if output_folder else None\n        # Check the conanfile is there, and name/version matches\n        self._ws.add(ref, full_path, output_folder)\n        return ref\n\n    @staticmethod\n    def init(path):\n        abs_path = make_abs_path(path)\n        os.makedirs(abs_path, exist_ok=True)\n        ws_yml_file = Path(abs_path, WORKSPACE_YML)\n        ws_py_file = Path(abs_path, WORKSPACE_PY)\n        if not ws_yml_file.exists():\n            ConanOutput().success(f\"Created empty {WORKSPACE_YML} in {path}\")\n            save(ws_yml_file, \"\")\n        if not ws_py_file.exists():\n            ConanOutput().success(f\"Created minimal {WORKSPACE_PY} in {path}\")\n            ws_name = os.path.basename(abs_path)\n            save(ws_py_file, textwrap.dedent(f'''\\\n            from conan import Workspace\n\n            class MyWorkspace(Workspace):\n               \"\"\"\n               Minimal Workspace class definition.\n               More info: https://docs.conan.io/2/incubating.html#workspaces\n               \"\"\"\n               def name(self):\n                  return \"{ws_name}\"\n            '''))\n\n    def remove(self, path):\n        self._check_ws()\n        return self._ws.remove(path)\n\n    def clean(self):\n        self._check_ws()\n        return self._ws.clean()\n\n    def info(self):\n        self._check_ws()\n        return {\"name\": self.name,\n                \"folder\": self._folder,\n                \"packages\": self._ws.packages()}\n\n    def super_build_graph(self, deps_graph, profile_host, profile_build):\n        ConanOutput().title(\"Collapsing workspace packages\")\n\n        root_class = self._ws.root_conanfile()\n        if root_class is not None:\n            conanfile = root_class(f\"{WORKSPACE_PY} base project Conanfile\")\n            consumer_definer(conanfile, profile_host, profile_build)\n            root = Node(None, conanfile, context=CONTEXT_HOST, recipe=RECIPE_CONSUMER,\n                        path=self._folder)  # path lets use the conanws.py folder\n            root.should_build = True  # It is a consumer, this is something we are building\n            for field in (\"requires\", \"build_requires\", \"test_requires\", \"requirements\", \"build\",\n                          \"source\", \"package\"):\n                if getattr(conanfile, field, None):\n                    raise ConanException(f\"Conanfile in conanws.py shouldn't have '{field}'\")\n        else:\n            ConanOutput().info(f\"Workspace {WORKSPACE_PY} not found in the workspace folder, \"\n                               \"using default behavior\")\n            conanfile = ConanFile(display_name=\"cli\")\n            consumer_definer(conanfile, profile_host, profile_build)\n            root = Node(ref=None, conanfile=conanfile, context=CONTEXT_HOST, recipe=RECIPE_VIRTUAL)\n\n        result = DepsGraph()  # TODO: We might need to copy more information from the original graph\n        result.add_node(root)\n        for node in deps_graph.nodes[1:]:  # Exclude the current root\n            if node.recipe != RECIPE_EDITABLE:\n                result.add_node(node)\n                continue\n            for r, t in node.transitive_deps.items():\n                if t.node.recipe == RECIPE_EDITABLE:\n                    continue\n                existing = root.transitive_deps.pop(r, None)\n                if existing is None:\n                    root.transitive_deps[r] = t\n                else:\n                    require = existing.require\n                    require.aggregate(r)\n                    root.transitive_deps[require] = TransitiveRequirement(require, t.node)\n\n        # The graph edges must be defined too\n        for r, t in root.transitive_deps.items():\n            result.add_edge(root, t.node, r)\n\n        return result\n\n    def export(self, lockfile=None, remotes=None):\n        self._check_ws()\n        exported = []\n        for ref, info in self.packages().items():\n            exported_ref = self._conan_api.export.export(info[\"path\"], ref.name, str(ref.version),\n                                                         ref.user, ref.channel,\n                                                         lockfile=lockfile, remotes=remotes)\n            ref, _ = exported_ref\n            exported.append(ref)\n        return exported\n\n\n    def select_packages(self, packages):\n        self._check_ws()\n        editable = self.packages()\n        packages = packages or []\n        selected_editables = {}\n        for ref, info in editable.items():\n            if packages and not any(ref.matches(p, False) for p in packages):\n                continue\n            selected_editables[ref] = info\n        if not selected_editables:\n            raise ConanException(\"There are no selected packages defined in the workspace\")\n\n        return selected_editables\n\n    def build_order(self, packages, profile_host, profile_build, build_mode, lockfile, remotes,\n                    profile_args, update=False):\n        ConanOutput().title(f\"Computing dependency graph for each package\")\n        conan_api = self._conan_api\n        from conan.internal.graph.install_graph import InstallGraph\n        install_order = InstallGraph(None)\n\n        for ref, info in packages.items():\n            ConanOutput().title(f\"Computing the dependency graph for package: {ref}\")\n\n            deps_graph = conan_api.graph.load_graph_requires([ref], None,\n                                                             profile_host, profile_build, lockfile,\n                                                             remotes, update)\n            deps_graph.report_graph_error()\n            print_graph_basic(deps_graph)\n            conan_api.graph.analyze_binaries(deps_graph, build_mode, remotes=remotes, update=update,\n                                             lockfile=lockfile)\n            print_graph_packages(deps_graph)\n\n            ConanOutput().success(f\"\\nAggregating build-order for package: {ref}\")\n            install_graph = InstallGraph(deps_graph, order_by=\"recipe\",\n                                         profile_args=ProfileArgs.from_args(profile_args))\n            install_graph.raise_errors()\n            install_order.merge(install_graph)\n\n        return install_order","lineStart":1,"lineEnd":320,"totalLines":320,"truncated":false}},"title":"conan/api/subapi/workspace.py","time":{"start":1788511593849,"end":1788511593864}},"id":"prt_06b9925300017G7oYgSPdOh1IT","sessionID":"ses_f94670cb8ffeWdbpzRFsoZCXEH","messageID":"msg_06b99158a001ReWQgEt55c396q"}}
{"type":"tool_use","timestamp":1788511593968,"sessionID":"ses_f94670cb8ffeWdbpzRFsoZCXEH","part":{"type":"tool","tool":"read","callID":"chatcmpl-tool-b95a99edc47e5a6c","state":{"status":"completed","input":{"filePath":"/testbed/conan/internal/api/new/workspace.py"},"output":"<path>/testbed/conan/internal/api/new/workspace.py</path>\n<type>file</type>\n<content>\n1: from conan.api.subapi.new import NewAPI\n2: from conan.internal.api.new.cmake_exe import cmake_exe_files\n3: from conan.internal.api.new.cmake_lib import cmake_lib_files\n4: \n5: \n6: conanws_yml = \"\"\"\\\n7: packages:\n8:   liba/0.1:\n9:     path: liba\n10:   libb/0.1:\n11:     path: libb\n12:   app1/0.1:\n13:     path: app1\n14: \"\"\"\n15: \n16: cmake = \"\"\"\\\n17: cmake_minimum_required(VERSION 3.25)\n18: project(monorepo CXX)\n19: \n20: include(FetchContent)\n21: \n22: function(add_project SUBFOLDER)\n23:     message(STATUS \"Adding project ${SUBFOLDER}\")\n24:     FetchContent_Declare(\n25:         ${SUBFOLDER}\n26:         SOURCE_DIR ${CMAKE_CURRENT_LIST_DIR}/${SUBFOLDER}\n27:         SYSTEM\n28:         OVERRIDE_FIND_PACKAGE\n29:     )\n30:     FetchContent_MakeAvailable(${SUBFOLDER})\n31: endfunction()\n32: \n33: add_project(liba)\n34: # They should be defined in the liba/CMakeLists.txt, but we can fix it here\n35: add_library(liba::liba ALIAS liba)\n36: add_project(libb)\n37: add_library(libb::libb ALIAS libb)\n38: add_project(app1)\n39: \"\"\"\n40: \n41: conanfile = '''\\\n42: from conan import Workspace\n43: from conan import ConanFile\n44: from conan.tools.cmake import CMakeDeps, CMakeToolchain, cmake_layout\n45: \n46: \n47: class MyWs(ConanFile):\n48:     \"\"\" This is a special conanfile, used only for workspace definition of layout\n49:     and generators. It shouldn't have requirements, tool_requirements. It shouldn't have\n50:     build() or package() methods\n51:     \"\"\"\n52:     settings = \"os\", \"compiler\", \"build_type\", \"arch\"\n53: \n54:     def generate(self):\n55:         deps = CMakeDeps(self)\n56:         deps.generate()\n57:         tc = CMakeToolchain(self)\n58:         tc.generate()\n59: \n60:     def layout(self):\n61:         cmake_layout(self)\n62: \n63: \n64: class Ws(Workspace):\n65:     def root_conanfile(self):\n66:         return MyWs\n67: '''\n68: \n69: workspace_files = {\"conanws.yml\": conanws_yml,\n70:                    \"CMakeLists.txt\": cmake,\n71:                    \"conanws.py\": conanfile,\n72:                    \".gitignore\": \"build\"}\n73: # liba\n74: files = {f\"liba/{k}\": v for k, v in cmake_lib_files.items()}\n75: workspace_files.update(files)\n76: # libb\n77: files = NewAPI.render(cmake_lib_files, {\"requires\": [\"liba/0.1\"], \"name\": \"libb\"})\n78: files = {f\"libb/{k}\": v for k, v in files.items()}\n79: workspace_files.update(files)\n80: # app\n81: files = NewAPI.render(cmake_exe_files, definitions={\"name\": \"app1\", \"requires\": [\"libb/0.1\"]})\n82: files = {f\"app1/{k}\": v for k, v in files.items()}\n83: workspace_files.update(files)\n\n(End of file - total 83 lines)\n</content>","metadata":{"preview":"from conan.api.subapi.new import NewAPI\nfrom conan.internal.api.new.cmake_exe import cmake_exe_files\nfrom conan.internal.api.new.cmake_lib import cmake_lib_files\n\n\nconanws_yml = \"\"\"\\\npackages:\n  liba/0.1:\n    path: liba\n  libb/0.1:\n    path: libb\n  app1/0.1:\n    path: app1\n\"\"\"\n\ncmake = \"\"\"\\\ncmake_minimum_required(VERSION 3.25)\nproject(monorepo CXX)\n\ninclude(FetchContent)","truncated":false,"loaded":[],"display":{"type":"file","path":"/testbed/conan/internal/api/new/workspace.py","text":"from conan.api.subapi.new import NewAPI\nfrom conan.internal.api.new.cmake_exe import cmake_exe_files\nfrom conan.internal.api.new.cmake_lib import cmake_lib_files\n\n\nconanws_yml = \"\"\"\\\npackages:\n  liba/0.1:\n    path: liba\n  libb/0.1:\n    path: libb\n  app1/0.1:\n    path: app1\n\"\"\"\n\ncmake = \"\"\"\\\ncmake_minimum_required(VERSION 3.25)\nproject(monorepo CXX)\n\ninclude(FetchContent)\n\nfunction(add_project SUBFOLDER)\n    message(STATUS \"Adding project ${SUBFOLDER}\")\n    FetchContent_Declare(\n        ${SUBFOLDER}\n        SOURCE_DIR ${CMAKE_CURRENT_LIST_DIR}/${SUBFOLDER}\n        SYSTEM\n        OVERRIDE_FIND_PACKAGE\n    )\n    FetchContent_MakeAvailable(${SUBFOLDER})\nendfunction()\n\nadd_project(liba)\n# They should be defined in the liba/CMakeLists.txt, but we can fix it here\nadd_library(liba::liba ALIAS liba)\nadd_project(libb)\nadd_library(libb::libb ALIAS libb)\nadd_project(app1)\n\"\"\"\n\nconanfile = '''\\\nfrom conan import Workspace\nfrom conan import ConanFile\nfrom conan.tools.cmake import CMakeDeps, CMakeToolchain, cmake_layout\n\n\nclass MyWs(ConanFile):\n    \"\"\" This is a special conanfile, used only for workspace definition of layout\n    and generators. It shouldn't have requirements, tool_requirements. It shouldn't have\n    build() or package() methods\n    \"\"\"\n    settings = \"os\", \"compiler\", \"build_type\", \"arch\"\n\n    def generate(self):\n        deps = CMakeDeps(self)\n        deps.generate()\n        tc = CMakeToolchain(self)\n        tc.generate()\n\n    def layout(self):\n        cmake_layout(self)\n\n\nclass Ws(Workspace):\n    def root_conanfile(self):\n        return MyWs\n'''\n\nworkspace_files = {\"conanws.yml\": conanws_yml,\n                   \"CMakeLists.txt\": cmake,\n                   \"conanws.py\": conanfile,\n                   \".gitignore\": \"build\"}\n# liba\nfiles = {f\"liba/{k}\": v for k, v in cmake_lib_files.items()}\nworkspace_files.update(files)\n# libb\nfiles = NewAPI.render(cmake_lib_files, {\"requires\": [\"liba/0.1\"], \"name\": \"libb\"})\nfiles = {f\"libb/{k}\": v for k, v in files.items()}\nworkspace_files.update(files)\n# app\nfiles = NewAPI.render(cmake_exe_files, definitions={\"name\": \"app1\", \"requires\": [\"libb/0.1\"]})\nfiles = {f\"app1/{k}\": v for k, v in files.items()}\nworkspace_files.update(files)","lineStart":1,"lineEnd":83,"totalLines":83,"truncated":false}},"title":"conan/internal/api/new/workspace.py","time":{"start":1788511593949,"end":1788511593965}},"id":"prt_06b9925ad001B96zp5V9XS1Vdl","sessionID":"ses_f94670cb8ffeWdbpzRFsoZCXEH","messageID":"msg_06b99158a001ReWQgEt55c396q"}}
